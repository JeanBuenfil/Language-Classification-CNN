        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Pos kwali tikitaskeh, ke:mansá: tik..., tikpa:taskeh wa:n</ANNOTATION_VALUE>
