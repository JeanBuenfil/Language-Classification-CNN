        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Mahyá: chi:l..., se: tet ihkó:n 'kwiah [kikwiah] *que** nijó:n,</ANNOTATION_VALUE>
