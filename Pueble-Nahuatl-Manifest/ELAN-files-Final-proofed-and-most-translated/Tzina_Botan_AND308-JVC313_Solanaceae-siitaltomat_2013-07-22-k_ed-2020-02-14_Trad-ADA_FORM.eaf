        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Wa:n yo:n semi we:lik para ne: xi:tomachi:l,</ANNOTATION_VALUE>
