        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>A:mo tikmatih ki:ní:n ti..., timoskaltihkeh *o** ki:ní:n ti...,</ANNOTATION_VALUE>
