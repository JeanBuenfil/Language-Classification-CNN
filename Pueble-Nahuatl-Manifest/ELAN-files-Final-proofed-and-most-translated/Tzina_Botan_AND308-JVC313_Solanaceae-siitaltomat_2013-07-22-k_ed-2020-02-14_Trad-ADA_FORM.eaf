        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Pero de yo:n tomat nimitsilia neh moye:kwi:wila:na wehka.</ANNOTATION_VALUE>
