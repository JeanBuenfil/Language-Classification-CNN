        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>timolihkeh nijí:n si..., si:taltomat, timolihkeh wa:n teh no: t...,</ANNOTATION_VALUE>
