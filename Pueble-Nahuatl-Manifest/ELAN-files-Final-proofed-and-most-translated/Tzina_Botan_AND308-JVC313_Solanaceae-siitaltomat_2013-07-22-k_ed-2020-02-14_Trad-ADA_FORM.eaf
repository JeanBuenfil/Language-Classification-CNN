        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>[I]ka ne:n chi:l, chi:ltamo:ltak ki..., kichi:wayah.</ANNOTATION_VALUE>
