        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Sayoh *que** kintsi:n pos nochi, ne:n, a:mo tikmatih.</ANNOTATION_VALUE>
