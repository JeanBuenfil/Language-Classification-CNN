        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>Nika:n tehwa:n ti..., timowelitah tikowah tein yo:n ika *racimo** ki..., ki..., kwa:lkwih.</ANNOTATION_VALUE>
