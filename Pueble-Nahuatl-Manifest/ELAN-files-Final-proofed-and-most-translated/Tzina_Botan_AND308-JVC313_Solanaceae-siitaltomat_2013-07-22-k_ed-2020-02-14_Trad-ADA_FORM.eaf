        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Wa:n telmiak n' ta:ki, ika taolo:ch, ika *racimo** n' ta:ki telmiak, ta:ki pero pisi:ltsi:n.</ANNOTATION_VALUE>
