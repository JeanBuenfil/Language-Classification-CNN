        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>pos *mismo** yeh 'kwiah n' a:tsí:n de n' ka:mpa molo:nia.</ANNOTATION_VALUE>
