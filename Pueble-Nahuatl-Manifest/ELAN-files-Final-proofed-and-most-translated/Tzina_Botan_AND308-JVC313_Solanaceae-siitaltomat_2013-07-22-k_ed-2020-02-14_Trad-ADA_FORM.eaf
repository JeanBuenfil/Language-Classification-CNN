        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>no: taman ne:n tomat, *mismo** tehwa:n si:si:ltomat no: *igual** ki:sa, *mismo** yehwa.</ANNOTATION_VALUE>
