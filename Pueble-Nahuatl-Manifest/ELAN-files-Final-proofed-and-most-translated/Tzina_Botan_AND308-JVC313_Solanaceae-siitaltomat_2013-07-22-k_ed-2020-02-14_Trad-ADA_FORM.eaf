        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>nijó:n, pos *[raci]mitos** ihkó:n mopihpilowa wa:n pos ompa ya se: kiteki.</ANNOTATION_VALUE>
