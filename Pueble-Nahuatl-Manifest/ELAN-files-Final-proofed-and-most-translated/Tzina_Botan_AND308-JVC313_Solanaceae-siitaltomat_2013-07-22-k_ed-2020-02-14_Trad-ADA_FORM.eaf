        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>kaxit, itech kaxit kima:nelowa:yah, *antes** ihkó:n nochi tikwiah.</ANNOTATION_VALUE>
