        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Pero nijó:n para a:mo 'ki:xtiliah n' ahwiya:kka:yo:t, ne:n ahwiya:k,</ANNOTATION_VALUE>
