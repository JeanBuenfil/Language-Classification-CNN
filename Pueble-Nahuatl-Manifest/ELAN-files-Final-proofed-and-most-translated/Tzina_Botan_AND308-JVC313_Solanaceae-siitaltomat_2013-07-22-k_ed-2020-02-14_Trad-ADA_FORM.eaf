        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>Pero ke:meh kintsi:n tine:chilihtok pos no:, no: kwaltia itech, i..., ne:n, to:tomo:ch,</ANNOTATION_VALUE>
