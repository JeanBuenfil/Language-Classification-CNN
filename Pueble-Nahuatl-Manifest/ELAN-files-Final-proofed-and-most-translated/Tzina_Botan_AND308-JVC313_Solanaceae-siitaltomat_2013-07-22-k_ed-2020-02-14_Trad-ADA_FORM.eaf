        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>yo:n a:mo moso:sowa, yo:n mokehketsa wa:n tepitsi:n sah mochi:wa, achi mone:neki.</ANNOTATION_VALUE>
