            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Porque dicen que algunas mujeres toman la masa más de lo normal</ANNOTATION_VALUE>
