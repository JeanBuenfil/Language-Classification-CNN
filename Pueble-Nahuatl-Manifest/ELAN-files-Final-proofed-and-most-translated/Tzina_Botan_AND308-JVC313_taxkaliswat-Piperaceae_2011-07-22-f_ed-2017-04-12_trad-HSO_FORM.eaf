        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>Son para remedio también.</ANNOTATION_VALUE>
