        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a263" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>y de que no se curan antes con las hojas de tax..., taxkaliswat,</ANNOTATION_VALUE>
