    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Eleuterio Gorostiza Salazar" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="EGS Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Bueno pues, ahora platícanos sobre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>el capulín, de esos que crecen pequeños, aqui.... No se donde, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>también se da, pero yo he visto que se da aqui en</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Texa:yakatitan, toda esa parte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Por Ta:lchi:chi:l se da unos que tiene hojas con pubescencia</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>¿Cómo es el</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>fruto, la flor</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>el tronco y si se le da un uso?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>¿Acaso los frutos también son comestibles?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>¿Esa planta donde crece, solamente en el monte?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>Pero esa de por sí no tiene nombre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>Bueno pues, parece que es todo respecto a esa hierba, no lo conocemos, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>pareciera como capulín, pareciera, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>pareciera que es como el capulín que se da en los potreros. Dínos tu nombre y tu pueblo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Pues ese lo conozco, solamente lo conocen como cualquier hierba, no tiene tronco, solo crece como una planta, muy bajita, parece que, quizá alcance una altura de,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>crece como una vara de alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Y es cierto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>El tallo es un poco rojizo y la vara es muy resistente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>y con las hojas pubescentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Tiene pubescencia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>el tallo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>y todas las hojas, las más tiernas, en la envés son rojas, hasta la pubescencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Y todas las hojas que están en el cogollo tienen bastante pubescencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Esa simplemente es una planta y también produce frutos. Los </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>frutos son verdes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>Los frutos son verdes y, este, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>y los frutos que se maduran tornan a ser negros. Pero los frutos de esa planta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>también tienen pubescencia, hasta el receptáculo tiene pubescencia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>ese, (ese donde la flor se acomoda, la base), ya el receptáculo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>todo tiene pubescencia, como si fuera algodonoso, con mucha pubescencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>Pero solamente es una hierba, lo vemos como un tipo de capulín pero no sé como se llama.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>simplemente es una hierba con hojas pubescentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>Pues no se sabe, esos capulines nunca nos lo hemos comido. Quien sabe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>Si, quiza, los pájaros se comen los frutos o quien sabe. Pero no da muchos frutos, son muy poquitos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>Simplemente es una hierba, no tiene tronco, solo es hierba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>así como el xo:no:ochpa:wa:s, así crece esta hierba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>En el monte, crece en Atekohkomol, a orilla de camino y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>en Texa:yakatitan, si uno va por Texa:yakatitampa, por ahí abunda mucho,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>ahí donde le llaman Ta:lkohkomo:ni, en el terreno de Arrieta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>Al llegar a la loma para luego empezar a bajar a Tozán, de esta hierba, hay bastante a orilla de camino y en el potrero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>Ahí hay bastante de esta hierba. En ese potrero hay bastante, ahí crece,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>No, no sabemos cómo se llama, simplemente es una hierba, pareciera que es un tipo de teswat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>se parece al teswat pero no se cómo se llama. Yo veo que simplente es una hierba. Aha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>Pues yo me Ernesto Vázquez, de,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>vengo de San Miguel Tzinacaapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
