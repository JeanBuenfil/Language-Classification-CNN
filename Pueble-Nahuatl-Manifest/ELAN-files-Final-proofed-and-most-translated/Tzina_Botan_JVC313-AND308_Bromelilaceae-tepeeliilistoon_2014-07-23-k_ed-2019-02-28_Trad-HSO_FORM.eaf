        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Es una hierba que ahì, ahì se..., A:i, ahì se..., ahì se hecha a perder, nadie la corta, nadie la busca.</ANNOTATION_VALUE>
