        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Entonces, eso también se necesita que no, que no se coma mucho, ese es sabroso pero las semilas no se deben comer.</ANNOTATION_VALUE>
