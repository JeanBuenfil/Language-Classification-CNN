        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Wa:n yo..., a..., yo:n ok, yo:n kostik i:pa iwki sah, a:mo, a:mo chi:chi:le:wi *más**, i:pa kostik sah wa:n iwki chika:waya ya.</ANNOTATION_VALUE>
