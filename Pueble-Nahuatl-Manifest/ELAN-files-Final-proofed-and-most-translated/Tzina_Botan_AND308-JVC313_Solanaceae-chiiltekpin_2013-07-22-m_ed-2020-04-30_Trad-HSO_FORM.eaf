        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>De t'paya:ntilihkeh pe:wak ixwa n' chi:ltekpintsi:n wa:n t..., tika:wtia:yah 'tame:wayah pos moka:wak miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>A:, iihtik kwa:lkwi wa:nkikalawiah ya ompa moka:wa ya ne:n iteyo. E..., ke:mah, moka..., mokalawiah, ompa m..., ompa ixwa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
