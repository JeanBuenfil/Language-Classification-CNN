        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Oh..., ohtat t'tahtapa:nayah wa:n in..., kwe:chtik tikta:lilia:yah, moki:tskihtok para a:mo panowa n' chi:ltekpin. Wa:n t..., wa:n t'ta:liliah se: a:mat tiksowiliah wa:n ke:mah tikte:mah n' chi:ltekpin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts246">
