                <ANNOTATION_VALUE>A:chá: no: seki mitskowiliah de yo:n, de n ahwiya:k de m' pisi:ltik wa:n ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797" TIME_SLOT_REF1="ts1067" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>Pos,</ANNOTATION_VALUE>
