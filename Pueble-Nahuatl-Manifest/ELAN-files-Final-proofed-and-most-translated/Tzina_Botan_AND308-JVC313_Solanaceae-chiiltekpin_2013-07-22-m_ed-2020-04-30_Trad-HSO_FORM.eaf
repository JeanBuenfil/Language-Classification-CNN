        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>Ika taolo:ch mochi:wa, ka:mpa e:wa ima:tsa:la:n pero ata ika taolo:ch niman x..., ne: mochi:wa, ne:n, *chilito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Ke:mah, a:mo te:kwah pero yo:n onkak pahti no: *que** semi onkak yo:n pahti yo:n *polvo, ormisán** kiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>Ka:mpa se: kita a:skayowa mah se: kipoto:nili wa:n mikih n' a:skameh wa:n mihkwaniah.</ANNOTATION_VALUE>
