        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a821" TIME_SLOT_REF1="ts1115" TIME_SLOT_REF2="ts1116">
                <ANNOTATION_VALUE>timahsih ne:wí:n ki:ní:n we:lik chi:ltekpin, ki:n se: kito:ka, ki:n se: *'cuida:ros** nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a823" TIME_SLOT_REF1="ts1119" TIME_SLOT_REF2="ts1121">
                <ANNOTATION_VALUE>*Mero** ki:ní:n se: kichipa:was, ke:meh teh tikmattok we:ika tikpiaya nijó:n chi:ltekpin *o de ver...**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a825" TIME_SLOT_REF1="ts1123" TIME_SLOT_REF2="ts1124">
                <ANNOTATION_VALUE>pos tikmattok ki:ní:n para ixwa *o** ki:ní:n tikita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a827" TIME_SLOT_REF1="ts1127" TIME_SLOT_REF2="ts1128">
                <ANNOTATION_VALUE>*o** tikinki:xtilia yo:n okwilimeh, yo:n a:skameh *porque** ki..., ki..., kwa:tsah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a829" TIME_SLOT_REF1="ts1131" TIME_SLOT_REF2="ts1133">
                <ANNOTATION_VALUE>Wa:n de a:mo se: kimati, pos se: kitas ne:ne:ntok ne:n a:skat se: kinka:was mah ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a831" TIME_SLOT_REF1="ts1135" TIME_SLOT_REF2="ts1137">
                <ANNOTATION_VALUE>mah kitsi:ntehtekika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a833" TIME_SLOT_REF1="ts1139" TIME_SLOT_REF2="ts1140">
                <ANNOTATION_VALUE>Pero ke:meh kintsi:n pos no: teh no: kwali tikchi:wtok, nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a834" TIME_SLOT_REF1="ts1141" TIME_SLOT_REF2="ts1142">
                <ANNOTATION_VALUE>chi:walis de nijó:n chi:ltekpin pos kwaltsi:n no:.</ANNOTATION_VALUE>
