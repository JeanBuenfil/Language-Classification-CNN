        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>Ka:skawiah, pero a:mo no:ya:n ka:skawiah, pero mah ..., ka:skawi:skeh pero koma:mo se: kipia *cuidado**, komo se: ki..., se: tachia,</ANNOTATION_VALUE>
