                <ANNOTATION_VALUE>Ne: kwowtah mo..., komo katka kowtah pos ompa mo..., moka:wah n' chiktehtsitsi:n pos ompa kitepe:wah, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
