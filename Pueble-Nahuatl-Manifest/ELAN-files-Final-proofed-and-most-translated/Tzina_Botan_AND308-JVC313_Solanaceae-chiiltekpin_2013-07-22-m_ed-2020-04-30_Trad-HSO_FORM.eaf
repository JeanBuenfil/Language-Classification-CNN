                <ANNOTATION_VALUE>pos pané: yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808" TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>Pos kwaltsi:n ke:meh nika:n timona:mikkeh wa:n nochi tine:chilih ki:ní:n tiki:xmati nijó:n chi:ltekpin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a810" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
                <ANNOTATION_VALUE>Pos nijó:n a:mo *mal**, ta:ká:n se: kinemilia pos ihkó:n se: kitachihchi:wia se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1096">
                <ANNOTATION_VALUE>se: yewalika pos kwali se: kito:kas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812" TIME_SLOT_REF1="ts1097" TIME_SLOT_REF2="ts1099">
                <ANNOTATION_VALUE>Kwali se: kito:kas *o** kwali se: momakas ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814" TIME_SLOT_REF1="ts1101" TIME_SLOT_REF2="ts1103">
                <ANNOTATION_VALUE>*matita**, ne:n *semillita**, pos ta:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a816" TIME_SLOT_REF1="ts1105" TIME_SLOT_REF2="ts1106">
                <ANNOTATION_VALUE>kwaltsi:n no: nik..., nikaki, ne:n, wa:n neh no: nikmattok *que**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a817" TIME_SLOT_REF1="ts1107" TIME_SLOT_REF2="ts1108">
                <ANNOTATION_VALUE>yo:n pisi:ltik semi telahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819" TIME_SLOT_REF1="ts1111" TIME_SLOT_REF2="ts1112">
                <ANNOTATION_VALUE>Pos no: kwali a ke:meh ekintsi:n nika:wí:n ay tine:ntinemih, timona:miktinemih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820" TIME_SLOT_REF1="ts1113" TIME_SLOT_REF2="ts1114">
                <ANNOTATION_VALUE>pos semi kwaltsi:n ika ne:n ti..., timonohno:tsah ke:meh i:n</ANNOTATION_VALUE>
