        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>sepa a:mat tiksowiliah m' paniá:n para a:m..., a:mo mah kalwi:chowa, a:mo mah tewyowa. Ihkó:n t'chi:wah n' chi:ltekpin.</ANNOTATION_VALUE>
