        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>Ka:n wa:ki, ka:n wa:ki, *matita** a:mo wa:ki.</ANNOTATION_VALUE>
