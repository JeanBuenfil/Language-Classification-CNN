        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Pero yo:n mah se: kiteki, komo se: kipia mah se: kiteki ne:, komo teh t'teki chi:ltekpin wa:n t'mattok tikonkaltihtok ne: o:me, e:yi *mata**,</ANNOTATION_VALUE>
