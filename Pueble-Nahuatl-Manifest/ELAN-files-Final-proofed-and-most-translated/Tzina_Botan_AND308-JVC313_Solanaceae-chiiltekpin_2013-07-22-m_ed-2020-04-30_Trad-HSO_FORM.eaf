        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Ke:mah, iwki yo:n kichi:wah ne:n chi:ltekpin. Wa:n neli ka:skawiah.</ANNOTATION_VALUE>
