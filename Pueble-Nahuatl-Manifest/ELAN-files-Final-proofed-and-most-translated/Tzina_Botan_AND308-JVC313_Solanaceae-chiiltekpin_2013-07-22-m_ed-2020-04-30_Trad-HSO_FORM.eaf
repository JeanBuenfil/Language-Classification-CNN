        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Ke:mah. Koko:yaskia mah 'kwahkwa:skiah, ke:meh kitohtolowa sah, a:mo kimati ox koko:k.</ANNOTATION_VALUE>
