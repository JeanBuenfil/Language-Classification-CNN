        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Ke:mah, iwki yo:n. N' tehwa:n tikitayah *porque** tikonkaltia:yah yo:n chi:ltekpin. Wa:n onkak miak taman neli, a:mo sayoh se: taman</ANNOTATION_VALUE>
