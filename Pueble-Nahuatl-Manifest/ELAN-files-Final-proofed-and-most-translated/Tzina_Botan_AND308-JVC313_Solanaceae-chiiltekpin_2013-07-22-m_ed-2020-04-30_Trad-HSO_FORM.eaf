        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>Kita:liah n..., n..., kalakih ne: tatsi:ntan wa:n ihkó:n i:n tehko[h]*hasta** ahko n' itech i:n a:skameh. Kita:lte:miah nochi, mahyá: incha:n wa:n pa:panowah, wa:n kwa:tsah yo:n iwki kichi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>Ke:mah, *porque** tak, tak 'kehkehtsomah, ox toto:nkeh yo:n a:skameh, kwa:tsah. Takehketsoma eski, por eso ne: kwa:tsah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Wa:n ompa ke:mah de, de w..., de yo:n mowe:ichi:wah ya n' okwilimeh, a:mo tikimiktih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
