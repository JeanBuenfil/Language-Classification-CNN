            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>wa:n mo..., [ko]mohkó:n teh tikis..., tik..., tikwiti wa:n tikmikti:ti ika moma:y [timo]ma:kalakili:s wa:n a:mo tikmikti:s *porque** [te:]kehtsoma</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>Se: ima:ko kalaki n' iwitsio. Nika:n ikwahkwa:ko witsiohkeh, kwa:wihwitsiohkeh, ihkwí:n yetok witsti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>Yo:n a:mo wel se: kima:xakwalowa, yo:n *mejor** se: kite:mili n' *ormisán** wa:n mikih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts448">
