        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>A:mo wa:ki. Yo:n nexi:kolmeh sah, itsi:ntan motahpo:tstiah, koma:mo</ANNOTATION_VALUE>
