        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>*caño** kichi:wah taihtik, tatampa m..., kita:liah mahyá: se: koyok n...,</ANNOTATION_VALUE>
