        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>wa:n ke:masá: ne:chnawatiah mah t'tekika:n xoxowik pos t'tekiah. Telowih n' se: kiteki yo:n xoxowik wa:n t'tekiah nochi [ika]n' ikowyo, imetskowyo.</ANNOTATION_VALUE>
