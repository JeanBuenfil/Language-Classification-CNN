        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>N' ta: kwa:lkwih chiktehmeh de wehka, a:t ka:ni 'kwitih wa:n ke:meh pata:nih.</ANNOTATION_VALUE>
