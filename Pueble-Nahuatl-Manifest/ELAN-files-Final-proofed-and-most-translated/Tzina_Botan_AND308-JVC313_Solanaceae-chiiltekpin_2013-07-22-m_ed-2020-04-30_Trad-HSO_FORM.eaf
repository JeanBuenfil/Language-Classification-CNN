        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>pero wila:ntok mahyá: komekatsí:n *o** iihtik panowah n' a:skameh ihkó:n tachihchi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>Wa:n yehwa yo.... o.... Ke:mah, kita:lte:miah ata mochi:wa se:, mahyá: se: *túnel** kiliah.</ANNOTATION_VALUE>
