    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a846" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>Entonces quieres saber ahora que aquí nos encon tramos otra vez en este camino, y aquí nos, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a847" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>andamos. Aquí nos...,  encontramos y también quieres</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a848" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>preguntarme si conozco, si conozco el chiltepín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a849" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>Pues yo conozco un tipo de chiltepín que tiene frutos boludos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a850" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>un segundo tipo que tiene frutos pequeños y el tercero tiene frutos alargados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a851" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>Esos le..., algunas personas le llaman pico de pájaro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a859" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>Entonces son así alargados y otros son pequeños</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a852" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>los frutos del chilptepín, este,    </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a860" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>otros son boludos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a861" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>Esos son los que yo conozco también, el que tiene frutos alargados son muy picosos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a862" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>Y cuando ocupamos para preparar nuestra comida pues también probamos cuáles son los más sabrosos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a863" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>Entonces son muy sabrosos esos que tienen frutos pequeños, cuando los trituran también dan un olor muy agradable.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a866" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>A veces cuando los tues..., se tues..., cuando lo secan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a867" ANNOTATION_REF="a289">
                <ANNOTATION_VALUE>y lo tuestan pues tiene un buen olor y es muy sabroso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a868" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>Es igual el otro tipo, el de frutos boludos, también es sabroso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a869" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>Pero el de frutos pequeños es más aromático.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a870" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>Y pues  también</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a871" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>ahora no sé cómo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a872" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>en qué meses florece porque en algunas partes ve uno las matas que están produciendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a873" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>El de frutos pequeños también producen muy bien las matas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a874" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>Es igual el de frutos boludos, también producen bien pero son un poco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a875" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>son pocos los frutos y el otro produce los frutos en rollo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a876" ANNOTATION_REF="a300">
                <ANNOTATION_VALUE>Y el otro tipo de frutos alargados también,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a877" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>también produce los chiles alargados pero un poco escasos. Uno por uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a878" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>Y su..., sus flores son,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a879" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>son bonitas de color blanco y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a880" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>las hormigas dañan mucho a las matas, creo que se alimentan de su..., sus raíces o  su..., las flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a881" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>Esos son los que conozco to..., todos   </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a882" ANNOTATION_REF="a308">
                <ANNOTATION_VALUE>de, de tres tipos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a883" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>Conozco tres tipos de,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a884" ANNOTATION_REF="a310">
                <ANNOTATION_VALUE>chiltepín. Más no ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a885" ANNOTATION_REF="a311">
                <ANNOTATION_VALUE>He visto na...n nada más esos, ahora usted tal vez,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a886" ANNOTATION_REF="a312">
                <ANNOTATION_VALUE>tal ves conoce usted más el chiltepín, cuántos tipos, tal vez conoce tres o cuatro tipos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a887" ANNOTATION_REF="a314">
                <ANNOTATION_VALUE>Son muchos tipos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a902" ANNOTATION_REF="a326">
                <ANNOTATION_VALUE>Produce en cantidad en las ramas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a903" ANNOTATION_REF="a329">
                <ANNOTATION_VALUE>Son pocos frutos alejados entre uno y otro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a904" ANNOTATION_REF="a335">
                <ANNOTATION_VALUE>Son rojos cuando maduran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a905" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>No son aromáticos como el otro tipo de chiltepín que son muy chiquitos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a906" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>Son muy picosos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a907" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>A de pequeñas empiezan a florecer y a producir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a928" ANNOTATION_REF="a350">
                <ANNOTATION_VALUE>¿Y cuando se cosecha nada más cortan los frutos maduros?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a935" ANNOTATION_REF="a357">
                <ANNOTATION_VALUE>Aa seca a su..., a la mata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a944" ANNOTATION_REF="a364">
                <ANNOTATION_VALUE>Seca a la matita en donde se..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a945" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>Creo que siempre son así las matitas y,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a946" ANNOTATION_REF="a370">
                <ANNOTATION_VALUE>Pues eso es lo que uno no sabe, a veces vemos que se cortan dos o tres frutos, pero cuando ya es mucho pues ya no lo sabemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a947" ANNOTATION_REF="a376">
                <ANNOTATION_VALUE>Se juntaba mucho, mucho chiltepín maduro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a958" ANNOTATION_REF="a379">
                <ANNOTATION_VALUE>Y todo eso lo secaban o lo..., así como lo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a959" ANNOTATION_REF="a382">
                <ANNOTATION_VALUE>Y lo secaban en el sol o en el, en el &lt;i&gt;popo:ch&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a960" ANNOTATION_REF="a385">
                <ANNOTATION_VALUE>A lo part..., partían el ta..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a961" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>Lo amarraban con,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a962" ANNOTATION_REF="a388">
                <ANNOTATION_VALUE>o encima de...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a963" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>Por encima que lo ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a964" ANNOTATION_REF="a395">
                <ANNOTATION_VALUE>Se queda con un color rojo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a965" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>No quieren si los chiles tienen color de humo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a966" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>Es mucha la..., la..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a967" ANNOTATION_REF="a402">
                <ANNOTATION_VALUE>Cuando maduraban los chiles se veía bonito de rojo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a968" ANNOTATION_REF="a405">
                <ANNOTATION_VALUE>Dicen que los &lt;i&gt;chahkwismeh&lt;/i&gt; también se alimentan mucho de eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
