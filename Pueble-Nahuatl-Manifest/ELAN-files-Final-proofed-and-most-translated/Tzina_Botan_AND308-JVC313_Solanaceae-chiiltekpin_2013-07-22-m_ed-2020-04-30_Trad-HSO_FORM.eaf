        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Pero kwaltsi:n wa:n no: ..., ka:n no: 'ka:wah n' chiktehmeh, kie:kkwah wi:likiso:meh.</ANNOTATION_VALUE>
