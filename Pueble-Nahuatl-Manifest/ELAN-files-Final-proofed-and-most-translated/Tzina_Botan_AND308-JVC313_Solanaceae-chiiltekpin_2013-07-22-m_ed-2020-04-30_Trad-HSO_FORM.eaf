        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>Pos kanah, ta: ke:meh kipetstolowah ka:n no: kimatih ox koko:k, kipehpetstolowah.</ANNOTATION_VALUE>
