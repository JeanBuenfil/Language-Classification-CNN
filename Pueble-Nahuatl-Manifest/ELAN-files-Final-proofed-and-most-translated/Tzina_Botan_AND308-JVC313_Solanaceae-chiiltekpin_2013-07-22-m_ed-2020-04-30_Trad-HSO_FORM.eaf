            <REF_ANNOTATION ANNOTATION_ID="a894" ANNOTATION_REF="a316">
                <ANNOTATION_VALUE>Tiene frutos muy pequeñitos, muy pequeñitos, hasta cuesta mucho para cortarlos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a895" ANNOTATION_REF="a317">
                <ANNOTATION_VALUE>Son muy pequeños, esos son muy aromáticos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a896" ANNOTATION_REF="a318">
                <ANNOTATION_VALUE>Son muy aromáticos, no son muy picosos, son muy aromáticos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a897" ANNOTATION_REF="a319">
                <ANNOTATION_VALUE>Y hay otro tipo de chiltepín que tiene los frutos un poco boludos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a898" ANNOTATION_REF="a320">
                <ANNOTATION_VALUE>esos, esos este son,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a899" ANNOTATION_REF="a321">
                <ANNOTATION_VALUE>otros se..., se dan de color rojo y son boludos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a900" ANNOTATION_REF="a322">
                <ANNOTATION_VALUE>Y el otro tipo de chiltepín que tiene frutos boludos que es el mismo,   </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a901" ANNOTATION_REF="a323">
                <ANNOTATION_VALUE>sus frutos son de color amarillo, has..., un tipo que tiene los frutos de color rojo cuando maduran y el otro tipo son de color amarillo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a908" ANNOTATION_REF="a324">
                <ANNOTATION_VALUE>Y es..., a..., el de, el que tiene frutos amarillos siempre son así, no, no enrojecen más, siempre son de color amarillo cuando maduran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a909" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>Pero cuando produce no da muchos frutos, no produce mucho y del que te platico que tiene frutos muy pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a910" ANNOTATION_REF="a327">
                <ANNOTATION_VALUE>Ese tipo produce siquiera seis frutos en cada nudo, como si, como si produjera por rollos en sus ramas. Da muchos frutos, produce mucho, en cantidad lo... yo lo sé porque cuando corta uno pues hay en cantidad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a911" ANNOTATION_REF="a328">
                <ANNOTATION_VALUE>Y el de frutos boludos produce un fruto nada más entre las ramas, uno nada más. Y el de frutos amarillos también produce de un fruto nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a912" ANNOTATION_REF="a330">
                <ANNOTATION_VALUE>Sí, y al..., son frutos alejados entre uno y otro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a913" ANNOTATION_REF="a331">
                <ANNOTATION_VALUE>estamos platicando de tres tipos. Y hay otro tipo de chiltepín ,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a914" ANNOTATION_REF="a332">
                <ANNOTATION_VALUE>que son un poco más grandes los frutos, también hay de color amarillo, también son amarillos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a915" ANNOTATION_REF="a333">
                <ANNOTATION_VALUE>Y hay otro tipo d...., que son hasta así de grandes,  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a916" ANNOTATION_REF="a334">
                <ANNOTATION_VALUE>esos son de color rojo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a917" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>los frutos del chiltepín son alargados. Esos sí son muy picosos, co..., con un fruto que se tritura, ya alcanza para preparar un plato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a918" ANNOTATION_REF="a337">
                <ANNOTATION_VALUE>Sí, esos, esos son muy picosos, no..., esos no son aromáticos pero sí son muy picosos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a919" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>Esos son muy picosos, no son muy aromáticos, no son aromáticos. Esos pican muchísimo pero no son aromáticos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a920" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>Pero el chiltepín de frutos muy pequeños son muy aromáticos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a921" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>Son aromáticos y tienen la cáscara muy blandita, este se..., se pueden triturar muy bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a922" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>Pero el de frutos grandes son muy duros y muy picosos, pero de verdad muy picosos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a923" ANNOTATION_REF="a344">
                <ANNOTATION_VALUE>Así es. Y la planta se da así, empiezan a producir desde pequeñas las matas y crecen altas las matas,esas crecen grandes las matas, son altas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a924" ANNOTATION_REF="a346">
                <ANNOTATION_VALUE>Y desde pequeñas las plantas empiezan a producir. Sí, de que se ramifican florecen entre las ramas y pro..., produce los frutos de chiltepín, después</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a925" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>crecen grandes así como van creciendo, así van creciendo hasta llegar a crecer la mata.   </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a926" ANNOTATION_REF="a348">
                <ANNOTATION_VALUE>Cuando termina de crecer también se ramifica bonito y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a927" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>el chiltepín llega a crecer a la altura de una persona en donde se adapta, cuando hay buena producción se junta una buena cantidad,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a929" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>se cosecha, se cosecha siquiera un cuarto de chiltepín, pero se corta verde, nada más que no hay que dejar vencerse por la flojera porque es difícil cortarlo, los frutos son muy pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a930" ANNOTATION_REF="a352">
                <ANNOTATION_VALUE>Pues si uno quiere se puede cortar así y si uno quiere para ve..., vender los frutos de chiltepín verde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a931" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>Se corta junto con los chiles verdes, se corta todo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a932" ANNOTATION_REF="a354">
                <ANNOTATION_VALUE>Pero eso hay que cortar, si uno tiene matas hay que cortar, si tú cortas chiltepín y sabes que tienes dos o tres matas en producción,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a933" ANNOTATION_REF="a355">
                <ANNOTATION_VALUE>corta los chiltepines. Si quieres cortar verdes pero tiene que cortar con el pedúnculo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a934" ANNOTATION_REF="a356">
                <ANNOTATION_VALUE>Tienes que cortar con el pedúnculo, que no se quede en la mata porque también hace secar su..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a936" ANNOTATION_REF="a358">
                <ANNOTATION_VALUE>este su..., su..., su fru..., su..., su..., el pedúnculo seca a la mata de chiltepín porque </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a937" ANNOTATION_REF="a359">
                <ANNOTATION_VALUE>Este lo..., cuando se queda el pedúnculo es como si le estuviera quitando los nutrientes a la mata, y si se le quita ya no le molesta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a938" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>Sí, ese es así el chiltepín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a939" ANNOTATION_REF="a361">
                <ANNOTATION_VALUE>Si..., si cortas los frutos del chi:l..., chi:l..., si tú vas a vender chiltepín verde, el chiltepín verde,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a940" ANNOTATION_REF="a362">
                <ANNOTATION_VALUE>si dejas el pedúnculo, te va a dar flojera cortalo con el pedúnculo. Esos chlies son difíciles de cortar porque son muy duros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a941" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>Se van cortando igual con las manos uno por uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a942" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>Pero si tú cortas nada más su..., el chile y lo dejas el pedúnculo, lo..., lo hace secar su..., su..., la mata</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a948" ANNOTATION_REF="a366">
                <ANNOTATION_VALUE>Sí lo seca. Es mejor que cortes con todo y el pedúnculo y lo vendas así con todo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a949" ANNOTATION_REF="a367">
                <ANNOTATION_VALUE>porque lo..., lo cortas...., después se seca la mata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a950" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>Quien sabe por qué es eso. El chilito lo..., lo..., así se seca. Si lo seca. Se cortan los frutos del chile así, se debe cortar con todo y el pedúnculo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a951" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>Sí. Sí, nosotros sabemos porque producíamos chiltepín allá en el campo y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a952" ANNOTATION_REF="a372">
                <ANNOTATION_VALUE>este, teníamos muchos matas arriba de la casa de don Nato Huero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a953" ANNOTATION_REF="a373">
                <ANNOTATION_VALUE>Teníamos todo en la ladera así s..., teníamos lo de una hectárea de terreno con puras matas de chiltepín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a954" ANNOTATION_REF="a374">
                <ANNOTATION_VALUE>Y cortábamos pero de verdad es muy cansado y s..., t..., pero a uno le pican mucho las moscas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a955" ANNOTATION_REF="a375">
                <ANNOTATION_VALUE>Pero cortábamos los chiles maduros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a956" ANNOTATION_REF="a377">
                <ANNOTATION_VALUE>Cor..., cortábamos mucho chiltepín y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a957" ANNOTATION_REF="a378">
                <ANNOTATION_VALUE>y nos mandaban a cortar chiles verdes pues cortábamos. Es muy difícil cortar el chile crudo y nosotros cortábamos con todo y el pedúnculo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a972" ANNOTATION_REF="a380">
                <ANNOTATION_VALUE>Mm, nosotros secábamos el chile maduro, lo secábamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a973" ANNOTATION_REF="a381">
                <ANNOTATION_VALUE>El chile maduro lo secábamos y el chile verde crudo lo vendíamos así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a974" ANNOTATION_REF="a383">
                <ANNOTATION_VALUE>secaban en el &lt;i&gt;popo:ch&lt;/i&gt;, en el &lt;i&gt;popo:ch&lt;/i&gt;,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a975" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>porque no, como en estos meses pues no se..., no. no hace sol en época de aguaceros en el &lt;i&gt;popo:ch&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a976" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>El ta..., partíamos el tarro y lo...., acomodábamos las cintas tupidas para que no se caigan los frutos del chiltepín. Y lo..., tendíamos papel sobre la tarima para echar encima el chiltepín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a977" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>Hacíamos un &lt;i&gt;popo:ch&lt;/i&gt; así de grande siquiera lo de largo de un brazo. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a978" ANNOTATION_REF="a390">
                <ANNOTATION_VALUE>construíamos el fogón, le poníamos leña a lo ancho y se secaba muy bien el chiltepín</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a979" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>tendemos un papel para que no pasen los chiles y se caigan al suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a980" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>Sí y para que no caiga mucho polvo sobre el chile,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a981" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>tendíamos otro papel encima para que no..., no se caiga el hollín encima de los chiles, que se enpolve. Así haciamos con el chiltepín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a982" ANNOTATION_REF="a396">
                <ANNOTATION_VALUE>Se seca bien el chiltepín, adquiere buena presentación para que lo vendas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a943" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>Sí porque si tiene un color a humo no les gusta a las personas, se vuelven de color negro y no les gusta.  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a983" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>Sí, yo conozco el chilito porque nosotros producíamos allá en el campo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a984" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>Sí, o..., sé cómo cosecharlo y cómo cuidar las plantas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a985" ANNOTATION_REF="a403">
                <ANNOTATION_VALUE>Pero cuando maduraba era bonito y tam..., también dañan los pájaros, los &lt;i&gt;wi:likiso:meh&lt;/i&gt; se alimentan mucho de los chiles maduros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a986" ANNOTATION_REF="a404">
                <ANNOTATION_VALUE>Se alimentan mucho de eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a987" ANNOTATION_REF="a406">
                <ANNOTATION_VALUE>Los chahkwi..., los &lt;i&gt;chahkwismeh&lt;/i&gt; se alimentan mucho del chiltepín, tragan así completos los chiles y no dejan ni uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a988" ANNOTATION_REF="a408">
                <ANNOTATION_VALUE>Pero de veras que los pájaros no dejan que maduren bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a989" ANNOTATION_REF="a409">
                <ANNOTATION_VALUE>Pues creo que no, creo que como se tragan completo el chile no saben si es picoso o no, se tragan completos los chiles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a990" ANNOTATION_REF="a410">
                <ANNOTATION_VALUE>Sí. Si masticaran los frutos percibirían lo picoso pero los tragan así completos no saben si es picoso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a991" ANNOTATION_REF="a411">
                <ANNOTATION_VALUE>Sí, así es. Nosotros veíamos porque producíamos el chiltepín. Y es cierto que hay muchos tipos, no sólo uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a992" ANNOTATION_REF="a413">
                <ANNOTATION_VALUE>Hay muchos tipos. No, germinaban las semillas. Germinaban varios tipos de semillas como desmontábamos el bosque,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a993" ANNOTATION_REF="a414">
                <ANNOTATION_VALUE>Germinaban las semillas del chiltepín. Así es, y de veras cosechábamos mucho chiltepín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a994" ANNOTATION_REF="a415">
                <ANNOTATION_VALUE>El café todavía no producía porque apenas habíamos sembrado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a995" ANNOTATION_REF="a416">
                <ANNOTATION_VALUE>Pero como otra vez se volvió bosque se aca..., acabaron las matas de chiltepín, quedaron bajo la sombra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a996" ANNOTATION_REF="a418">
                <ANNOTATION_VALUE>Pero cuando se despeja el terreno y se tumban los árboles se da el chiltepín, y de veras, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a997" ANNOTATION_REF="a419">
                <ANNOTATION_VALUE>algunas matas las sembrábamos pues había muchas matas de chiltepín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1001" ANNOTATION_REF="a421">
                <ANNOTATION_VALUE>Las semillas las traen los pájaros de lejos, quien sabe de dónde las traen como andan volando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1002" ANNOTATION_REF="a422">
                <ANNOTATION_VALUE>Allá en el bosque se..., si antes era bosque ahí lo..., tiraban las semillas los pájaros, ahí las tiran las,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1003" ANNOTATION_REF="a423">
                <ANNOTATION_VALUE>semillas y ya germinaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1004" ANNOTATION_REF="a424">
