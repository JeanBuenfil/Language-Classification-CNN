            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Ke:mah, pero komo pohpo:ktik a:mo no: kwelitah n' tokni:wa:n, tihti:le:wi ne:n po:kyowa, a:mo no: kwelitah.</ANNOTATION_VALUE>
