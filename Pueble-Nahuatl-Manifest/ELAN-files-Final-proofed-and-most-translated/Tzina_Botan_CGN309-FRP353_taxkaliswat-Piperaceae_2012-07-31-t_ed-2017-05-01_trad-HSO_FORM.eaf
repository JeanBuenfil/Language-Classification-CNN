        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>A:mo, ta: yo:n se: kiteki ma:ski ohti sah. Mm, onkak, mochi:wa xiwtsí:n, a:mo tasohtalo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>Kanah, ka:n ke:man nikmati. Pos a:mo nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
