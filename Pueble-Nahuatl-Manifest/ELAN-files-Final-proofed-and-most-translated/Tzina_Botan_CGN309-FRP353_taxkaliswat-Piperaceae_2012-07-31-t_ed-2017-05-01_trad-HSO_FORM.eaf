        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>Sí es cierto, es cierto pero pues ...</ANNOTATION_VALUE>
