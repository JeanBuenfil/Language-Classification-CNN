            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Y pues hasta ahí me encuentras si algún día deseas buscarme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>Si algún día quieras saber po..., ta..., por esta planta medicinal de la que estamos hablando, pues ahí te espero. Aha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>Aha. No..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>Igual para mí, muchas gracias y nos vemos otro día señora, ya me voy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
