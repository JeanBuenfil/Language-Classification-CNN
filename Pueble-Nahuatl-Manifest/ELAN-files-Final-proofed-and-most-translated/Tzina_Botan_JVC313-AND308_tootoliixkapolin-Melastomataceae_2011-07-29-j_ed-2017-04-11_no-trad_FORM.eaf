        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>wa:n ompa sah ne:n o:me, e:yi n' ta:ki, a:mo ta:ki *tarea**, ikehkechtan sah.</ANNOTATION_VALUE>
