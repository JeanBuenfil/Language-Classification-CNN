            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>ne:wí:n tehwa:n tiki:xmatih xoko:kkapolinyo:n.</ANNOTATION_VALUE>
