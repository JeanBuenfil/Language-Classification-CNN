        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>yehwa yo:n *antes** te:chne:xtilia:yah tota:tahwa:n,</ANNOTATION_VALUE>
