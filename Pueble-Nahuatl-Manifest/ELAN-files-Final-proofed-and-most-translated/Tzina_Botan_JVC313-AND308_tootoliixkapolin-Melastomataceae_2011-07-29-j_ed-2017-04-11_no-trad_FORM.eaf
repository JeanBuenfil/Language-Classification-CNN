        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>Itsi:nkaxyo ne:n tihti:lih yehwa yo:n we:lik, pero yo:n,</ANNOTATION_VALUE>
