        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>Kwayo:la:n yehyewaltik semi, yehwa yo:n tikiliah to:toli:xkapolin wa:n wehwei n' ikapoltsitsi:n,</ANNOTATION_VALUE>
