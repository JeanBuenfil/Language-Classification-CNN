            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Yehwa yo:n kitekih *para carto:nkaltsí:n** kita:liliah *o para tejita** kixi:kowa yo:n tein achi i:xtohtoma:wak.</ANNOTATION_VALUE>
