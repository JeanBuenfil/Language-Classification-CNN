            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>e:yi, na:wi *vara** kite:maka, *hasta** ma:kwi:l *vara** kite:maka *compadrito**.</ANNOTATION_VALUE>
