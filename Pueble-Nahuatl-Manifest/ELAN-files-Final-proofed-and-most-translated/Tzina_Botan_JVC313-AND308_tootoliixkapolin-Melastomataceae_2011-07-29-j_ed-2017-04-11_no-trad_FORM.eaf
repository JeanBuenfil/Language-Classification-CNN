        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Ihista:k n' iteyo wa:n yo:n iteyo nijó:n achi kah...,</ANNOTATION_VALUE>
