        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>Wa:n pos yo:n kitohtokatok sepa seh se: n' oksi, a:mo oksi *tarea**, oksi sehse:tsitsi:n sah *compadrito** yo:n.</ANNOTATION_VALUE>
