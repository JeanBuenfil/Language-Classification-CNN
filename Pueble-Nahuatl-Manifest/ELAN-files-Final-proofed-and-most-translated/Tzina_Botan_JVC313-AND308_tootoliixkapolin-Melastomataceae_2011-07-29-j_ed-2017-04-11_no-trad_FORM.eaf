        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Yo:n xoko:kkapolin, yo:n we:lik kichi:wah ato:l seki n' tokni:wa:n, pero xoko:kkapolin.</ANNOTATION_VALUE>
