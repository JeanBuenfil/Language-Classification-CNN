        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>yo:n kipia:yah yo:n ika se: ko:ntsí:n kilia:yah</ANNOTATION_VALUE>
