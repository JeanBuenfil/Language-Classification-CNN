        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>O..., pata:wak ihkwí:n xo:chitsí:n wehweitsitsi:n wa:n se:h se: sah n' motekpa:na, na:wi xo:chit sah mota:lilia, na:wi *pétalos** kiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
