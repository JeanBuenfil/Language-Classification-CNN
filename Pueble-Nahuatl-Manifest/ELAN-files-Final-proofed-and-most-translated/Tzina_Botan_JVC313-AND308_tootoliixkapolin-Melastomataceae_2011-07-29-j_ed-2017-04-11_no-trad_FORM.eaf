        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Wa:n yo:n nochi kikwah no: chiktehmeh, ne:n,</ANNOTATION_VALUE>
