        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Wa:n, ika *racimito, pero** a:mo miak mochi:wa yo:n, a:ki, semi telmi:miak taolo:ch,</ANNOTATION_VALUE>
