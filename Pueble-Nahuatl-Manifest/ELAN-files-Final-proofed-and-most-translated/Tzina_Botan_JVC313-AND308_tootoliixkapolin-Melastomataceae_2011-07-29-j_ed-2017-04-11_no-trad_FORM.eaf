        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>nijó:n kwaltsi:n ne:n te:mapa no: pero ki:sa ....</ANNOTATION_VALUE>
