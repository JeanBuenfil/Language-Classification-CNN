        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>wa:n de se: 'ki:xtia ya nijó:n ke:mah moka:waki ke:meh eskia yo:n itsi:nkaxyo.</ANNOTATION_VALUE>
