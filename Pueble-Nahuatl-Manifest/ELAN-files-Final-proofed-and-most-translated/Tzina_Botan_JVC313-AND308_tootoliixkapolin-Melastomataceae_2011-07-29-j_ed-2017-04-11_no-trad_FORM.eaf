        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Yo:n tikilwiah, yo:n tiki:xmatih *que** xoko:kkapolin.</ANNOTATION_VALUE>
