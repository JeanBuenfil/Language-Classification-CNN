        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>Mochi:wa nijó:n, *siempre** ihko:kó:n se: kikwa:nahna:miktia ihkó:n,</ANNOTATION_VALUE>
