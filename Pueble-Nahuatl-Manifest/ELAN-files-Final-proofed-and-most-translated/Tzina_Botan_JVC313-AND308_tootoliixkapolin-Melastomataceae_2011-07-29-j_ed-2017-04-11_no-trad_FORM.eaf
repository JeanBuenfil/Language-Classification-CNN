        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>No: taman no: seki se:, ke:meh kihtowa, ne:n, yo:n</ANNOTATION_VALUE>
