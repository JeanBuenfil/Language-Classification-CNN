        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Yo:n tikiliah to:toli:xkapolin wa:n ye:kkwa:..., kwa:yo:la:n,</ANNOTATION_VALUE>
