        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>para nejó:n ki:sa xo:chitsí:n i..., patachtik sah ihkó:n, mahyá: se: *sombrilla** sah.</ANNOTATION_VALUE>
