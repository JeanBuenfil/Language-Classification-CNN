        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>Yo:n para ato:l, yo:n kikwah n' chi..., n' chiktehmeh.</ANNOTATION_VALUE>
