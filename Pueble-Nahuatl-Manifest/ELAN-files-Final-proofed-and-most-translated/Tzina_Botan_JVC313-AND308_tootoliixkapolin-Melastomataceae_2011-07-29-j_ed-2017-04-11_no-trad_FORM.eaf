        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Yehwa n' tikiliah to:toli:xkapolin *porque** ye:kwehwei ne:, mahyá: to:tol..., to:tolin ii:xtololo kihto:sneki yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Ne:n tikiliah iwki *compadrito** yo:n.</ANNOTATION_VALUE>
