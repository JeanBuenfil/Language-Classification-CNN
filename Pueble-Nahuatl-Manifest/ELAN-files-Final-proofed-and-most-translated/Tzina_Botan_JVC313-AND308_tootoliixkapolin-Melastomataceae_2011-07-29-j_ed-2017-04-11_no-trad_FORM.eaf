    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="Comentarios" PARTICIPANT="Comments" TIER_ID="Comments">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>{Nótese que Anastacio Damián aparentemente está hablando del chi:chi:lxokokapolin, Parathesis psychotriodes Lundell (Primulaceae), cuyos frutos se usan para atole, y no el to:toli:xkapolin,.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>{Aquí la forma usada es yehwa}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>{Aquí menciona E. Vázquez lo que el llama xoko:kkapolin, su nombre para chi:chi:lxokokapli, Parathesis psychotriodes Lundell (Primulaceae), cuyos frutos se usan para atole, y no el to:toli:xkapolin,.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>{Parece que E. Vázquez se da cuenta que Anastacio Nicolás estaba hablando del C. xalapanesis y aquí regresa a habla de to:toli:xkapolin, Conostegia icosandra}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
