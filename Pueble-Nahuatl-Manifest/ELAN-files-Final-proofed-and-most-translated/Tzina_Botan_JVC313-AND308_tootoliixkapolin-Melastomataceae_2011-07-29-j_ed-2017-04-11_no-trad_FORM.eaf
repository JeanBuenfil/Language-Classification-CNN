        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Ixwa yo:n ne:wí:n se: kitamo:ta pero yo:n pos</ANNOTATION_VALUE>
