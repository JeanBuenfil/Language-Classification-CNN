        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>¿Ox tiki:xmattok no: yo:n, yehwa yo:n nimitsilia to:toli:xkapolin?</ANNOTATION_VALUE>
