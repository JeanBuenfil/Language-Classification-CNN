        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>nijó:n no: kita:liliah tepitsi:n, *antes** kita:lilia:yah ne: ke:man,</ANNOTATION_VALUE>
