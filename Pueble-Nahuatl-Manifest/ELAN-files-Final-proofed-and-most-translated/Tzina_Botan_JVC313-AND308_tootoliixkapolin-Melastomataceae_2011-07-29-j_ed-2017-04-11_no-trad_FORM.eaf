        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Wa:n i:n tehwa:n nimitsilia yeh tikiliah to:toli:xkapolin *compadrito**,</ANNOTATION_VALUE>
