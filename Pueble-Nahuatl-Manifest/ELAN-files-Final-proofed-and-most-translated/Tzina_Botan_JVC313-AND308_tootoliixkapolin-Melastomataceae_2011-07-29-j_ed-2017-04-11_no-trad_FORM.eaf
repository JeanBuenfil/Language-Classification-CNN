        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Yo:n kwaltsi:n nijó:n mochi:wa ke:meh eskia ihkó:n de ke,</ANNOTATION_VALUE>
