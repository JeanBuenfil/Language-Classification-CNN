        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>pos no:, no: de n' kimatih ki:ní:n n' kichihchi:waskeh seki ki...,</ANNOTATION_VALUE>
