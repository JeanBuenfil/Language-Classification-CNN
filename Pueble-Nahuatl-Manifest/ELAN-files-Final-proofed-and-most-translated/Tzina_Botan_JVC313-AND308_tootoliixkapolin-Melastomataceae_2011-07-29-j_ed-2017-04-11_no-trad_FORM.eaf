                <ANNOTATION_VALUE>A:, yo:n to:toli:xkapolin yo:n no: niki:xmati *compadrito**, ekintsi:n ne: nimitsili:ti nijó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
