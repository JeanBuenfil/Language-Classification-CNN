        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Onkak ne:wí:n kowtah, ihkó:n ka:mpa ihixta:wat onkak yo:n,</ANNOTATION_VALUE>
