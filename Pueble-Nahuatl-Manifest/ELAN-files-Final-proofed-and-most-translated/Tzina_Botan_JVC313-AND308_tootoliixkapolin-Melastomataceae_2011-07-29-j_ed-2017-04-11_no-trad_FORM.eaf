        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Yo:n no: wehkapania wa:n ihkwi:kwí:n ima:yo wa:n ma:ahalaxtik.</ANNOTATION_VALUE>
