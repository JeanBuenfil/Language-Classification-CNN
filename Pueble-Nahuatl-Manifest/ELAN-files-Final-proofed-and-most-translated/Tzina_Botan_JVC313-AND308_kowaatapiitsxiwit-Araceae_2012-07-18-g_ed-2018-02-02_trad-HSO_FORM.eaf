        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>Wa:n no: nejó:n ima:kowyo, ne:n ima:xiwyo, n' ima:kowyo ya,</ANNOTATION_VALUE>
