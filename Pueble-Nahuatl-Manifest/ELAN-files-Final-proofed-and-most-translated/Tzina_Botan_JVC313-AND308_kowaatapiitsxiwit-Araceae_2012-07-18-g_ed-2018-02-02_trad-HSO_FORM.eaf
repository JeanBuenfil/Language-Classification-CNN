        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>Dicen que si uno empieza a silbar se acerca la serpiente, la serpiente le sigue al silbido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>Por eso le llaman kowa:tapi:tsxiwit. Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>Pues quien sabe, yo lo ví hace unos años, maté una víbora allá en Texa:yakatitan, lo..., lo..., ahí pasé a matarla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>Y al otro día pasaban por ahí mis tíos, ahí se encontraban tres serpientes más, eran tres que estaban al la..., lado de la víbora muerta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>Estaban todas en el mismo lugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a257">
