        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>No se ve, yo no sé cómo, yo nunca he visto que tenga flores, he visto la planta, la he visto allá en el campo donde trabajo.</ANNOTATION_VALUE>
