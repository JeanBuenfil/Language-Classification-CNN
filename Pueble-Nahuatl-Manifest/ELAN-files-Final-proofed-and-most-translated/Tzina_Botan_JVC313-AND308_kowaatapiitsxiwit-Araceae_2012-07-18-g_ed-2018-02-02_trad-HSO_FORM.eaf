    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="Comentarios" PARTICIPANT="Comments" TIER_ID="Comments">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>{Nota que solamente A. Nicolás Damián utiliza la forma ima:yo. Los demás dicen ima:y}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>{Quiso decir, probablemente, te:chitakih}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>{Canna tuerckheimii Kraenzl.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>{Es raro decir kichi:wa ixo:chio, más usual sería kipia o mochi:wa}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>{Es más común decir motachi:li, del verbo tachia.}</ANNOTATION_VALUE>
