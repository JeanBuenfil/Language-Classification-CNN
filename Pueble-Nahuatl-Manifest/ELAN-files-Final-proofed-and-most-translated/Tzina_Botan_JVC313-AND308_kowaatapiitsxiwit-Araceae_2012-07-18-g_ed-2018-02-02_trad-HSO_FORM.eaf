            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>No todas las personas conocen, algunas se...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>Dicen que tal vez no sirvan, tal vez provoquen alguna intoxicación.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Pero no lo..., no son tóxicas, si las traen y las ocupan para envolver tamales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>A mí como en algunos lugares me dicen, dicen, "Traeme esas hojitas".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>Entonces las traigo y las ocupan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Y les digo que..., que comí los tamales y no hacen daño.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>Ahá, sólo que tam..., también son diferentes</ANNOTATION_VALUE>
