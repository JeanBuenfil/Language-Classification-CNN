        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>Hay muchas plantas en la superficie de los troncos, nunca veo que tengan flores o frutos, nunca veo.</ANNOTATION_VALUE>
