        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>yehwa n' kitekiliah para kipi:tsah yo:n kihtowah i..., iw..., iwki a n' tsahtsi ke:meh kowa:t kikisi *igualito** ya n' kikisi ne:n</ANNOTATION_VALUE>
