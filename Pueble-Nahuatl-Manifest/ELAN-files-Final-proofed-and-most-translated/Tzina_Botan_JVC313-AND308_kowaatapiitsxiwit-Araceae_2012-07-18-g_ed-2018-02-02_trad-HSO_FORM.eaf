        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>Quizá también se extrañan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>Pues se le tiene miedo a la serpiente en donde,</ANNOTATION_VALUE>
