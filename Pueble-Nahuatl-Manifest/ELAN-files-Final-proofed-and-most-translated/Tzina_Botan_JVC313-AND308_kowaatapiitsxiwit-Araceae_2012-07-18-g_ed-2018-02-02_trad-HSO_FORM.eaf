        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>Ahí estaban todas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>¿Y las mataron o ahí las dejaron?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>Y la serpiente que mataste ahí se echó a perder.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>Ahí se echo a perder, nadie la tiró o se..., se lo comieron las mismas serpientes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>Ahí se...</ANNOTATION_VALUE>
