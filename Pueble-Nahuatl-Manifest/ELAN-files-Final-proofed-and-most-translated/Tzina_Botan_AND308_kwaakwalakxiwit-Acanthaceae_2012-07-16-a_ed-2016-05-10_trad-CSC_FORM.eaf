            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Nochi a:mo ye:kkwa:ltia *porque** pos ne:n, a:mo wa:ki.</ANNOTATION_VALUE>
