        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>ve a traer a tu hijo, y al  rato te espero, dice la señora, a las cinco de la tarde te espero allá en el camino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>ahí te alcanzo y te acompaño a la casa de esa señora. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>Ajá. Y yo no sabía a donde vive y de verdad..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>fui a encontrar a la señora, la esperé en el camino donde me había indicado, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>y de verdad esta señora me acompañó a la casa de la otra señora que cura, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>y este, ahí me enseñó la señora que también ocupaba </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>me dí cuenta que es la hoja santa. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>Yo..., em..., en el haz de la hoja le puso manteca y encima le puso carbonato, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>y enseguida le..., le puso a mi hijo en el abdómen, y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>lo sacudio del estómago, le hizo un llamado y me dice. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>Entonces dice, mañana lo ves, dice, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>si le hace efecto esta medicina dice, cuando llegues a la casa ya va a estar sudando tu niño. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>Y es cierto al llegar aqu..., a la hora de llegar. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>A mi casa como a las nueve de la noche, lo sentí. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>Todo el cuerpo ya estaba sudando, pensé que ya le iba a hacer efecto. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>Y al terc..., al otro día otra vez llevé a mi hijo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>Y dice, pues, debes seguir poniéndole la hoja santa, pónle todos los días. Y verás dice que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>si dice, dice este..., hierve las hojas de aguacate, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a506" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>y le lavas los píes, dice. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a507" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>Y de verdad, con la hoja santa se curó mi hijo. Es muy buena medicina. Yo sabía que la hoja santa, yo sabía</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a508" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>que mi abuela ocupaba la hoja santa para cubrirle los píes a los pacientes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a509" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>Ocupaba las hojas de hoja santa, en el haz le ponía jitomate y les cubría a los píes de los niños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>Pero dicen que cuando tenían fiebre. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a511" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>Pero yo no sabía de eso, que este, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>si se usaban para poner como emplasto, entonces me dí cuenta que también sirven. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>Pues a mí también, también, también me..., me habían platicado hace muchos años, ya tiene un buen tiempo que me platicaron también </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>de que esa planta es muy buena para curar a las personas que tienen diabetes. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a518" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>Pues puede ser. Pero dicen que es muy bueno esa hierba para </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a519" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>si apenas empiezas toma el té de hoja santa como agua de tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a520" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>Y no deben ocuparse muchas hojas,  solamente dos hojas, dos, dos hojas, hoja..., dicen que se cortan dos hojas y se hierve en un litro da agua y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a521" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>debes tomar como si fuera agua de tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a522" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>así me..., me platicaron a mí, yo no sé. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a523" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>Pues de.... A se curan con esas hojas. Debe ser cierto porque hay muchas plantas en donde vivimos pero nos..., andamos cerca de ellas, a..., a veces hasta pisoteamos las plantas pero no las conocemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a529" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>Mm, no nos enseñan. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a530" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>Sería muy bonito que todas las señoras, o todos los</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a531" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>ancianos, ancianas que nos platicaran</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>acerca de las plantas que conocen porque mañana o pasado nos..., dios nos va a llamar, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a533" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>y todo lo que sabemos de la medicina la vamos a llevar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a534" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>Y este, ya nadie queda, así van sucediendo las cosas siemre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a535" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>Si te das cuenta, hace años, era muy es..., antes, yo nací más antes, las personas vivieron  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a536" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>sabían mucho, no..., cómo curarse y ahora nosotros ya no sabemos. Ahora cuando nos enfermamos vamos corriendo con el médico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a537" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>Y a vece.... Es cierto. No, a veces regresa uno a la casa pero ya muerto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a549" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE> Tal vez viviriamos unos años más. Pero qué se puede hacer cuando ya estamos ahí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a550" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>Es cierto. Pues le agradezco mucho haberme encontrado nuevamente con usted señora en</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a551" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>ya la conozco y pensé hacerte estas preguntas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a552" ANNOTATION_REF="a306">
                <ANNOTATION_VALUE>cómo conoce usted alg..., algunas plantas porque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a553" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>es necesario platicar entre todas y buscar cómo fortalecer</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a554" ANNOTATION_REF="a308">
                <ANNOTATION_VALUE>la forma de poder trabajar unidos </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a555" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>sobre el uso de nuestra plantas medicinales que nosotras le llamamos nuestra medicina tradicional. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a556" ANNOTATION_REF="a312">
                <ANNOTATION_VALUE>Actualmente yo no nos creen. Es cierto. La flores de ésta planta son de color blanco si las conoces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a557" ANNOTATION_REF="a314">
                <ANNOTATION_VALUE>Son blancas. Ajá. Pero no recuerdo en qué tiempo florece. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a558" ANNOTATION_REF="a318">
                <ANNOTATION_VALUE>Quizá sea cierto porque yo no he puesto atención a eso, yo más me fijo en..., en..., cuando veo que..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a559" ANNOTATION_REF="a319">
                <ANNOTATION_VALUE>ahí está tirado y voy a cortarlo para leña, porque el tallo se quema muy bien en el momento que uno hace tortillas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a321">
                <ANNOTATION_VALUE>También es..., al que..., al colocar dentro del fogón cuano está seco, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a561" ANNOTATION_REF="a323">
                <ANNOTATION_VALUE>arde muy bien. Mm. Pero a veces pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a565" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>nos ayuda de varias formas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a566" ANNOTATION_REF="a326">
                <ANNOTATION_VALUE>Ajá. No sirve. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a567" ANNOTATION_REF="a328">
                <ANNOTATION_VALUE>Está chueca la madera y es muy  suave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a568" ANNOTATION_REF="a329">
                <ANNOTATION_VALUE>Es muy suave, no aguanta. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a569" ANNOTATION_REF="a331">
                <ANNOTATION_VALUE>Sí, porque si una persona  se...,  sube en el árbol y este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a572" ANNOTATION_REF="a333">
                <ANNOTATION_VALUE>es pesada, rápidamente se rompe la rama. Es muy blandita la madera. Uhuh. Pues nada más eso puedo platicar señora y este, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a573" ANNOTATION_REF="a335">
                <ANNOTATION_VALUE>me voy siempre porque este, va a llegar la noche, ya me voy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
