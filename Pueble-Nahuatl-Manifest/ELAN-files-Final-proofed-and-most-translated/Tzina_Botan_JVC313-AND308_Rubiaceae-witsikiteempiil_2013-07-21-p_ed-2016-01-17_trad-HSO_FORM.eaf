        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>pero se puede usar para curar va..., varias enfermedades, sólo hay saberlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>también cura la tos, este lo..., machacan las hojas, las exprimen y le..., dan de tomar un poco de jugo al niño, otras las..., las..., echan en un envase con refino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>y con eso lo..., le..., le mojan la cabeza y le frotan en el pecho y en la espalda,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>le frotan en las articulaciones, enseguida la abrigan con una cobija o una tela y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>lo acuestan para que duerma y así se le quita la tos o la fiebre, el wi:tsikixiwit es bueno para curar muchas enfermedades.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>Sí y, y también se puede usar para ...., para curar heridas en una cortada, ayuda a coagular la sangre,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>si uno se cortó con machete, para coagular la sangre se cortan las hojas, se machacan, se exprimen y se le echa el jugo a la herida. Las hojas de wi:tsikite:mpi:l curan igual como la planta del tsi:nich.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Se machacan las hojas, se exprimen y se le echa el jugo a la herida, entonces este..., se..., calman el dolor, no es tanto para el dolor sino que se coagula la sangre, ya no sigue sangrando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Para de sangrar. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Coagula la sangre, ya no sangra, también detienen el sangrado, ya no sangra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a152">
