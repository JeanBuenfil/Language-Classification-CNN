        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Algunas partes dejan las matas, las dejan, mm. Mm, mm.</ANNOTATION_VALUE>
