            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>Muchas gracias por haberme platicado. Este ahora dime tu nombre y de..., de donde vienes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>Pues yo también vengo de San Miguel Tzinacapan, me llamo Ernesto Vázquez.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a248" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>A también quieres saber, ahora que nos encontramos aquí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a249" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>Sí, eso es lo que yo quiero preguntarte si..., si lo conoces también. Pues qué bueno que aquí nos..., platicamos, sí lo conozco y he visto por allá la planta que le llamamos wi:tsikite:mpi:l o wi:tsikixo:chit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a250" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Esa planta también la..., hemos visto por allá y también la cortamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a251" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>se puede usar para, para curar, así es, también la cortamos algunas veces y la traemos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>otras personas también la..., la buscan, es medicinal también.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>le llaman wi:tsikite:mpi:l pero yo sólo conozco un tipo, sólo hay un tipo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>esa planta también la..., la buscan para curar a los niños que padecen de tos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>cuando los niños tienen bronquitis les ponen en el pecho,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>machacan las hojas con las manos, le echan refino y le frotan al paciente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a261" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>también les frotan en la nuca, y esas no ... algunas personas usan las hojas para bañar al paciente y le dan de tomar un poco de té,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>pero no sé qué cantidad de hojas de wi:tsikite:mpi:l usan. Esa planta le llaman wi:tsikite:mpi:l porque le..., ahí anda revoloteando el colibrí, pero uno no llega a entender muy bien. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a263" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Por eso así le llaman.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a264" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Las flores de wi:tsikite:mpi:l son de color rojo y también se ve bonito su pedúnculo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>El tallo es de color negro y crece un poco alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>Algunas matas de wi:tsikite:mpi:l crecen alto y son..., también crecen  grandes,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>la madera también se puede cortar para leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Se parece a la madera del guayabo y no podemos decir que tiene espinas, el tallo es liso y es de color negro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>Quien sabe por qué sus flores son de color rojo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>Sus..., sus flores son un poco alargadas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>Y pues eso es lo que..., lo que sabemos y es bueno platicarlo cuáles son las plantas que se usan para, para curar, dicen que el wi:tsikite:mpi:l es muy buen remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>es bueno para curar también, en algunas partes este..., dejan la mata para cortar las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>No la tumban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>No tumban la mata de wi:tsikite:mpi:l porque se usan las hojas para curar a los niños o hasta nosotros nos pueden frotar en el pecho junto con el refino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Se colocan en el pecho, lo..., lo..., no sé usted tal vez sepa más, ha de saber más..., en donde ... ha visto también.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Lo detiene la sangre, ya no, ya no sangra la herida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>las hojas son muy buenas para curar y ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>pues yo también he escuchado que también, también es buena medicina para curar la urticaria en la picadura de un borreguillo, dicen que también machacan las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Se frota uno el jugo, se frota el jugo en la mano, en el lugar donde se encuentra el dolor y empieza a calma el..., dolor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>También es bueno para eso y creo..., que he escuchado y lo he visto que cortan las hojas, las machacan, las exprimen y le echan el jugo a una cortada para..., coagular la sangre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Lo detiene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Esa planta, ése arbolito es muy bueno usar para medicamento. Por..., por eso en algunos lugares, las personas dejan la planta si se encuentra junto a la casa, y casi siempre se encuentra en varios lugares.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Algunas personas le llaman wi:tsikite:mpi:l, no..., nosotros lo llamamos wi:tsikixiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>Otros le llamamos wi:tsikite:mpi:l.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Luego retoña, donde se tumba la mata después ya se pueden cortar sus..., sus hojas tiernas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Las hojas tiernas son..., son de color rojo, las puntas en donde brotan sus..., sus flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>Pero yo no lo sé. A y sus frutos son de color negro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>Los frutos son negros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>De que..., de que maduran ya.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>Y creo que las semillas también germinan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>También germinan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>Mm, por allá se encuentran muchas matas, en algunas partes se ven muchas matas a las orillas de los caminos, en los cafetales, junto a las casas se encuentran las plantas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>Esa planta la usan en varios lugares.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>Machacan las hojas y no, no son duras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>Son suavecitas, son pubescentes y sus hojas son un poco delgadas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Es muy bonito platicar cómo se usan las plantas medicinales porque a veces nuestros hijos no se pueden curar  y finalmente las..., andamos buscando para usarlas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>Las usamos y pues esas plantas no..., no se necesitan comprar con dinero, las traemos sin ningún costo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>y a veces en la clínica lle..., llevamos a nuestros hijos para curar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>Pues no se curan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>Algunos más les hace efecto una planta medicinal, si ya sabemos cuales son las conseguimos y las usamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>Cortamos las hojas, las machacamos y las..., algunas personas dicen que al exprimirlas se puede juntar el jugo en un traste y de ahí se puede tomar para frotarle al paciente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>Y también se le puede dar de tomar unas gotas a un niño, como es poquito no hay peligro de intoxicarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>Ésa planta es buena medicina, no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>Así es, es efectiva y es bueno darlo a conocer así como andamos en varios lugares debemos de platicar cómo se usan, cuáles son las que curan y cuáles son las que no se pueden usar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>Pues también he..., he visto que sus flores se paran así y son de color rojo, sus frutos son de color negro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>y los pájaros se alimentan de ésos frutos, también se alimentan </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>se alimentan las primaveras y las flores las chupa el colibrí, eso es lo que..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>lo..., lo... chupan las flores, los frutos son de color negro y sirve de alimento para las primaveras,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>las flores son rojas y ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>Algunas matas crecen alto y otras..., casi si no se..., se..., se tumban pero retoñan, si retoñan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>Algunas matas sí crecen alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>Crecen alto y sus..., sus flores son de color rojo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>Sus flores siempre son de color rojo y los cogollos también son un poco rojos, los tallos son negros y sus..., sus hojas tiernas también son rojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>las hojas son pubescentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>Así es, eso es lo que yo sé que los cogollos son de color rojo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>A bueno pues platicamos muy bonito, ahora te voy a decir mi nombre, yo me llamo Anastacio Nicolás Damián, vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>A bueno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
