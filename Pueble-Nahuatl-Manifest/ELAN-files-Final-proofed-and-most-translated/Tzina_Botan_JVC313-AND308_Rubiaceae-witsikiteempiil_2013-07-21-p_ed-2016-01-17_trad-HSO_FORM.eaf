        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>Sí, es efectiva para la tos y las heridas, así es. Pues debemos de platicar para qué sirve.</ANNOTATION_VALUE>
