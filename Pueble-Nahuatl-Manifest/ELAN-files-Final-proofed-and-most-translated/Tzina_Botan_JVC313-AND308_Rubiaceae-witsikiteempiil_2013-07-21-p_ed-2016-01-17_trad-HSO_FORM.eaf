        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Pues también co..., conozco igual el que le llaman wi:tsikite:mpi:l o wi:tsikixiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Esa planta no crece alto, son bajitas las matas, </ANNOTATION_VALUE>
