                <ANNOTATION_VALUE>momahmaxalowa wa:n sanipa xo:chiowa, miak xo:chit kite:maka. Wa:n i:n seki a:mo, achi mone:neki. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Ixta:wat. Kowtah a:mo mochi:wa nió:n kahfe:ntah a:mo mochi:wa, *solamente** ixta:wat mochi:wa.</ANNOTATION_VALUE>
