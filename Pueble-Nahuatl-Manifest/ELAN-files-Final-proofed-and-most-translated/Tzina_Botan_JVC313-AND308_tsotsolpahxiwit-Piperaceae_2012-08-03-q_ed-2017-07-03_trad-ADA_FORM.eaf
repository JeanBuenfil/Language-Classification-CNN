                <ANNOTATION_VALUE>Wa:n nejó:n, kimetspi:kih ika xiwit wa:n ke:mah kitetekwinowah ika tilmahtsi:n wa:n ika kochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>Ika kochi, komohkó:n kina:miki, mo:stika tepitsi:n patsa:waya, tsotsoltiak a ne:n imets ki..., kitawilia yo:n tsotsoltik ne:n xiwit.</ANNOTATION_VALUE>
