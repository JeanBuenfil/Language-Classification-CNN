            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Pos nehwa nimono:tsa Anastacio Nicolás Damián, niwa:le:w no: San Miguel Tzinacapan.</ANNOTATION_VALUE>
