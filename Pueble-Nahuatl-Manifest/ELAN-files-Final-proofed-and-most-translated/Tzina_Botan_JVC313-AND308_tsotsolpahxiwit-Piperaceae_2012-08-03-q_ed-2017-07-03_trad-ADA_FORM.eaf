        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a451" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>Pues yo sé que solamente sirve para usar como emplasto para ponerle a la gente que se le hincha el cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a452" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>No ocupan para curar otro tipo de enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>Nunca he escuchado que la ocupen para curar otra enfermedad, solo para curar el hinchazón del cuerpo.</ANNOTATION_VALUE>
