    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>Puedes decirme si acaso conoces el tsotsolpahxiwit,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Donde hay. Cómo son las flores y para qué sirve?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Nunca visto si los frutos son negros o rojos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Las flores salen bien alineaditas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>Por lo menos unas tres veces hacen el emplasto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>Pues yo también voy a contarte, también sé un poco del tsotsolpahxiwit. No crece muy alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Las flores son blancas y las ramas son largas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Las ramas son largas y no se usan para leña, crece y ahí se desperdicia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Le llaman tsotsolpahxiwit porque las hojas son arrugadas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Y hace tiempo nuestros padres y madres pues la ocupaban para curar alguna enfermedad como el hinchazon del cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Esa enfermedad causaba a que se rompa la piel y para curar, ocupaban las hojas tiernas del tsotsolpahxiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Ocupaban las hojas tiernas y una más, la más ancha (recias)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>Y le ponían el a:tomat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Si, le ponían el a:tomat, le ponían como emplasto en la parte afectada, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>y a veces le ponían aceite.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>Con todo ello hacían el emplasto y envolvían los pies y lo amarraban con el bejuco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>con un bejuco. No tomaban otra cosa para amarrar. Generalmente lo amarraban con bejuco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>y luego, encima ponían una tela, un pedazo de tela, de este tamaño.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Envolvían bien los pies, de tal manera que la hoja no esté suelta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Como es un...., son así, un poco angostos pero lo ocupaban de tal manera que cubriera bien. Justo en la parte inflamodo es donde ponían el emplasto y lo amarraban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Envolvían bien los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Envolvían los dos pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>envolvían los pies con las hojas del tsotsolpahxiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>Entonces queda bien.... pero por lo menos unas tres veces se le pone al enfermo, hacen el emplasto y con ello envuelven los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>Y al siguiente dia se nota que los pies ya están desinflamados. Se nota que ya están con concavidades</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Entonces dicen, una vez más voy por las tsotsolpahxiwit y ponerle nuevamente a los pies (del enfermo).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Y una vez más van por el a:tomat, el que se produce por allá,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>pues dicen que también es comestible pero, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>pero es muy ácida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Es muy sabrosa, agregándole chiltepín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Pues eso es lo que yo sé, machacaban bien el a:tomat y lo ponían como emplasto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>y así envolvían los pies, usaban muchas hojas y quedaba un buen tamaño de grosor. El emplasto lo ponían todo hasta en la planta de los pies</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>y ahí donde terminaba, ahí mismo lo amarraban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Lo amarraban aqui, en el pie y todo en esta parte y hasta abajo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>(Para que sanara) en enfermo, por lo menos se le ponía unas tres veces el emplasto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Y hasta que se desinflama. Se desinflama.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>Pues luego, luego ya puede caminar a la persona enferma, porque es imposible caminar porque los pies quedan muy grandes por la enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Quedan muy gordos y es posible haste que se rompa la piel por el hinchazón.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>Los pies quedaba como brillosos y hasta los dedos del pies tambien se hinchaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>Una vez que se deinflama se veía como, ya no se rompe la piel, así se veía como en forma lineal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>Cuando revisaban los pies, los apachurraban y es cuando se daban cuenta que ya están desinflamándose los pies, así hacían para cerciorarse del avance de curación.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Pero cuando se inflamaban los pies, cuando los apachurraban, las manos se sumian.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>Una vez que se desinflaman, los pies va tomando el tamaño normal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>Pues a veces no se hinchaban en todo el cuerpo, solamente en los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a395" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>Si, en los pies, dicen que las personas se le hincha el cuerpo o los pies cuando aumenta la temperatura corporal al realizar un trabajo pesado o caminado y uno se baña así entonces surge la enfermedad. Se hinchan los pies o el cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a396" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>Pues es eso, como tú comentas, al estar sudando así (y uno se baña con agua fría) entonces se hincha uno del cuerpo o de los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>Se hincha uno del cuerpo, a veces también proviene del susto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>pues se hincha uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Pues usan las tsotsolpahxiw para hacer el emplasto y envolver los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>Es muy buena medicina. Le llaman tsotsolpahxiwit porque las hojas son arrugadas, y una vez que se desinflaman los pies con el efecto de las hojas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>pues se desinflaman y la piel queda arrugada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>Por lo menos, el emplasto repetian unas tres veces hasta que se desinflan los pies</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>Ya no están hinchados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>Sanaba muy bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Dicen que esas hojas son muy buenas para curar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>Las hojas del tsotsolpahxiwit es muy bueno para curar el hinchazòn del cuerpo o de los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Cuando sale algún granito en el cuerpo, con esta hoja también se puede curar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>pues también sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>También sirve</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>También se desinflama.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>Pero yo sé que estas se ocupan cuando los pies se hinchan, para que se desinflamen porque cuando alguien se le hinchan los pies, casi es imposible a que pueda caminar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>Dicen que cuando los pies se hinchan, pesan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>Diecen que se acomula agua dentro de los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>Por eso se hincha uno. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>El agua que causa la enfermedad hace que el cuerpo se hinche</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>El agua que causa la enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>(Y donde se hincha el cuerpo) no se puede perforar porque es doloroso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>Es doloroso. Las hojas del tsotsolpahxiwit hace que se desinflame la parte hinchada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>Pues cubrian bien los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Pues al enfermo le ponián las hojas por la noche, al acostarse, así las hojas permanecían por más tiempo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>se lo amarraban para que no se cayeran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>Las hojas las ponen en todo el pie, cubriéndo hasta los dedos y la planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>Envolvían bien los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>Hasta aquí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>Y al siguiente dia el enfermo observaba y decía, ¡Ya está desinflamadose mi pie!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>Esta hoja es muy buena para medicina, ve a traer más o que yo vaya para seguir ocupandola.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>Pues una ves máa, uno va por esas hojas y por lo menos unas tres o cuatro veces se le pone a la parte hinchada. El tallo es liso y un poco negruzco, como verde oscuro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>Pero las hojas no son tan rasposas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>son lisas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>Son lisas y las semillas son blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>pues parece que nunca he visto la flor de esta planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>La que conocemos como semilla, en realidad es la flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>Pues nunca he visto cómo es la semilla, si son rojas o blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Solo veía que se colgaban hacia abajo, quizá sean las flores y cuando se arecian quizá ahí mismo salián las semillas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>Y luego ahí germinaban las semillas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>Pero yo .... pues las rañices de esa planta no se entierran tan profundo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>No se entierran tan profundas, casi muy encima salen las raíces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a247">
                <ANNOTATION_VALUE>Ahí salen las plantas y pues yo ví que las raíces no van tan profundas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>Casi encima y .... yo (no) sé (si)  también sirve para leña, quizá solamente se corta y ahí se deja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>Acaso tú sabes si se usa para leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>Pues quien sabe si al estar seco, quizá arda pero generalmente solo usan las hojas para curar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>Para curar el hinchazón, solamente eso sé, con ellas enredaban los pies y no sé más, no sé si se prepara en té para tomar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>Pues también sabes que sirve para curar el hinchazón de los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>Pues es muy bueno que ahora estemos aquí,en esta..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>pues como andamos por aquí, hemos visto y platicado sobre cuáles plantas sirven para curarnos al enfermarnos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>Esa agua que se acomula en el cuerpo hace que se hinche uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>Pues eso es lo que nos hemos enterado y lo llevaremos presente, si algún dia se necesita, podemos decirle a alguien, ¡Ve a traerme las hojas de esta planta! Pues uno ya conoce la tsotsolpahxiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>Pues esa planta no puedo decir que es..., los troncos son un poco delgados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>Son un poco largos, pero es muy bueno (para curar).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>Pues yo sé que no, yo sé que no se hierve, las hojas se ocupan sin hervirlas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>Pues no sé si sirva para curar otro tipo de enfermedad, si acaso pueda curar, no sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>Pues hace tiempo mucha gente padecía de esa enfermedad, pues es una enfermedad. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>Esa enfermedad.... pero ahora casi ya no se ve esa enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a501" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>Cuando uno se le hinchaban los pies o el cuerpo dicen que es el efecto de uno se moja los pies,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a502" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>o al pasar en el roció, pues hace tiempo hacía muhco daño.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a503" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>Pues si uno era muy débil de anticuerpos, se enfermaba uno, hinchándose el cuerpo o los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a504" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>Y también si uno se asustaba también se enfermaba de esa forma, se hinchaba el cuerpo o los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>Al aplicar esas hojas (tsotsolpahxiwit) sobre la parte hinchada, se desinflamaba. Pues esa es una enfermedad y esas hojas las ocupaban para curarla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a506" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>Esa es una enfermedad y dicen que también causa dolor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a507" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>También duele porque los pies pesan o a veces se parten por el exceso de agua acomulada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a508" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>Pero con esas hojas, al ponerlas, suda en la parte afectada, quizá expulsa un poco de savia.Pero yo nunca he visto que contenga savia. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a509" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>Quizá las hojas contenga savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>No mancha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a511" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>Quiza las hojas contenga savia es la que hace el efecto de curar la enfermedad al ponerlas como emplasto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>Pues solamente tengo esa información sobre tsotsolpahxiiwit, pues es muy bueno. Hace tiempo nos curábamos así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a513" ANNOTATION_REF="a300">
                <ANNOTATION_VALUE>Pues las señoras y los señores también nos contaban que tsotsolpahxiwt es muy bueno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a514" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>Si, solamente tengo esa información, yo ví hace tiempo (cuando la gente la usaba)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>Pues si nada más eso, puedes decirme tu nombre y de dónde vienes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>Pues yo me llamo Anastasio Nicolás Damián, vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
