    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="José Ernesto Vazquez Chanico" PARTICIPANT="José Ernesto Vazquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Ah, si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Pues yo conozco al tsotsolpahxiwit</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>esa planta se da en los cafetales o en orillas de cafetales y camino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>En los terrenos abandonados, esa planta tambien crece.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>El tronco es verde y liso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Le llaman tsotsolpahxiwit porque en el haz de la hoja es arrugada (tsotsoltik). </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Y florea, las flores sn largas y blancas, se parecen a las de flores del xa:lkowit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>Las flores salen entre las ramas. La planta no crece alta, las más altas alcanza como un metro y medio de altura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>Se ramifica mucho y son erectas. En cada rama principal, salen otras ramitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>Se ramifica y al pie de cada rama, salen las hojas y al pie de la hoja </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>ahí salen los frutos (las flores), salen tupidas en ambos lados del tronco, aqui sale la hoja, aqui (ahí mismo) está otro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Así salen las flores en ambos aldos. Son blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>Y luego, no sé, no se exactamente cómo es la planta, si obtiene los frutos, solo conozco la flor, es como una lombriz, sale erecta y es blanca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Asi es, nunca he visto la semilla pero he visto que .... es blanca. Nunca le he visto los frutos, solo he visto la flor, es blanca que salen entre las ramas, salen bien formaditas, como salen las hojas de café.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>Salen como las hojas de café, pero la flor sale una por una y son alargadas, salen bien formaditas o alineadas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>Yo....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Así es la tsotsolpahxiwit</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>Y este.... Le llaman tsotsolpahxiwit porque la ocupan para medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>(sirve para curar) cuando alguien se hincha,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>(las hojas) las ocupan para envolver los pies.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Cubren los pies, envolviéndolos con las hojas, luego de desinflaman.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>Si y....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>Pero quizá le ponen algúna otra medicina, no solamente las tsotsolpahxiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>quizá le ponen, parece que le ponen jitomate, el tomate verde o el mi:ltomat, junto con ello envuelven los pies hinchados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>Y con las hojas envuelven los pies y encima le enredan una tela para sujetarlo y ahí queda toda la noche.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>El enfermo duermo con los pies envueltos con estas hojas, al siguiente dia reduce el hinchazón, el pellejo queda arrugado por el efecto de la hoja arrugada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>Si, si ven que hay mejora, pues repiten el emplasto en las noches.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>Hasta que se cure. Los pies dejan de inflamarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Si, eso es lo que yo sé, ocupan esas, las tsotsolpahxiiwt para envolver los pies hinchados de una persona. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Ya se desinflama. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a367" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Tambien se puede preparar en salsa y se frié.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>Ya se desinflama.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
