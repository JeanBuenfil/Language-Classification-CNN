        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Pero no: nejó:n tak kita:liliah teisá: pahti, iwa:n teisá: xiwit iwa:n, a:mo sayoh tamela:wa sah yo:n xiwit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>xa: kita:liah ne:, pané: tomat kita:liliah yo:n, yo:n a:tomat oso mi:ltomat para ika kita:liliah, yo:n, yo:n kimetspi:kih yehwa yo:n mets..., metste:te:mi.</ANNOTATION_VALUE>
