        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>Yo:n semi takwa:wak ko..., kapolkowit semi takwa:wak.</ANNOTATION_VALUE>
