        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Entó:s a:mo nik..., a:mo no: nikpia ok yo:n kowit ke:meskia, mm.</ANNOTATION_VALUE>
