        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Tienen un color gris como si..., son así como morados, cuando uno los come, el jugo pinta los labios y toda la boca</ANNOTATION_VALUE>
