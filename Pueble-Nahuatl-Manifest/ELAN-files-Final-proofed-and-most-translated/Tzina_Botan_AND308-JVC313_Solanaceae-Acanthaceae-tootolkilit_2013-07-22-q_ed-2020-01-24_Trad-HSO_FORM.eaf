        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>Komo se: kiposteki de se: kiteki ne:n n' i..., n' ikilyo,</ANNOTATION_VALUE>
