            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>Sayoh *que** a:mo nochi tikmatih, ekintsi:n nika:n ke:meh neh a:mo nochi nikye:kmati pero nika:n timona:mikkeh wa:n kwaltsi:n tik..., tine:chilihtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
