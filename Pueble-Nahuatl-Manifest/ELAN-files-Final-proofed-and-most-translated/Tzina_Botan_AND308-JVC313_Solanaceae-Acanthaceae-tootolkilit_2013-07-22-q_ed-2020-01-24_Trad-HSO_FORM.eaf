            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a578" ANNOTATION_REF="a323">
                <ANNOTATION_VALUE>Sí. Pues el to:tol..., &lt;i&gt;to:tolkilit&lt;/i&gt; is..., tiene las flores de color blanco su..., esas que les llaman campanitas.   </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a579" ANNOTATION_REF="a326">
