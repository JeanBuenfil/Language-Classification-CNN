    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>Pues  ahora que otra vez nos encontramos aquí en es..., andando en este camino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>nuevamente quiero preguntarte si..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>si conoces esa planta que le llaman &lt;i&gt;to:tolkilit&lt;/i&gt;, cuántos tipos hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>O sólo hay uno, o hay dos, o siquiera tres tipos, porque algunos conocemos varios tipos y otros sólo conocemos uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>Son diferentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>Sí, pues también conozco del quelite que me platicas, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>conozco el &lt;i&gt;to:tolkilit&lt;/i&gt;, nosotros lo llamamos como &lt;i&gt;to:tolkilit&lt;/i&gt;,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>el que se da en el suelo. Pero</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>pues yo sé que se llama &lt;i&gt;a:xiwit&lt;/i&gt;. Pero para que más la conozcan  las,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>como algunos pero no sé, los niños menores nos mandan a..., o somos niños menores y nos manda nuestra madre a,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>cortar el &lt;i&gt;to:tolkilit&lt;/i&gt; para saber más lo..., saber, de m..., el mero nombre que tiene es &lt;i&gt;a:xiwit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Pero sabemos más por &lt;i&gt;to:tolkilit&lt;/i&gt;, esa planta que se da en el suelo que tiene el tallo liso y las hojas lisas pues la vamos a cortar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>Esa planta es la que vamos a..., cortar para hervirla y darle a los pavipollos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Pero su..., lo..., esa planta la conocemos como &lt;i&gt;a:xiwit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>Pero para nosotros, esa planta le llaman &lt;i&gt;to:tolkilit&lt;/i&gt; pero es para que sepamos cuál es el &lt;i&gt;to:tolkilit&lt;/i&gt;, esa planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>Y hay otro &lt;i&gt; to:tolkilit&lt;/i&gt; esa que le llaman &lt;i&gt;ista:kxo:chit &lt;/i&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>esa planta dicen que también la ocupan para curar la bronquitis</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Esa también ocupan para darle de comer a los pavipollos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
