        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a611" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>Sólo se usan las hojas para los ni..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a612" ANNOTATION_REF="a348">
                <ANNOTATION_VALUE>la flor la.... Bueno la...., si las hierve uno la..., las hojas para los pavipollos, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a613" ANNOTATION_REF="a350">
