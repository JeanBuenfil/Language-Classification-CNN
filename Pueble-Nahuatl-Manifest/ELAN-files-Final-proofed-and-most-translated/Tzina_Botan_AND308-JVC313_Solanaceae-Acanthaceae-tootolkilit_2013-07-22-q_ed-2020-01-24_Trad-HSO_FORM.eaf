        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a616" ANNOTATION_REF="a359">
                <ANNOTATION_VALUE>Pues yo ve..., me llamo Anastacio NicolásDamián, vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
