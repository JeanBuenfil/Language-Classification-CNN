        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>Pos no: kwaltsi:n se: ki..., se: kimattiw ihkó:n wa:n i:n,</ANNOTATION_VALUE>
