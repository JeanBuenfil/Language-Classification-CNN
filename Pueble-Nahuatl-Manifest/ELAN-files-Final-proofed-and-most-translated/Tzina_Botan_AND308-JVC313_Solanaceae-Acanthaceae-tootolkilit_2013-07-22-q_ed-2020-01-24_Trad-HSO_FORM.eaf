            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
