            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a610" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>Tiene su..., sus ramas así y no, no sirven.</ANNOTATION_VALUE>
