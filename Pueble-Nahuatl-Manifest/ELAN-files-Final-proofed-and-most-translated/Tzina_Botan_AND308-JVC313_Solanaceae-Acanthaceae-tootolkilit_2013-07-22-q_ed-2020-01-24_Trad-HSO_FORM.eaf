        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>Así desaparece.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>Pues es bonito la forma en que aquí lo estamos pla..., platicando, al encontrarnos pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>a veces se ne..., a uno le hace falta este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>esas flores,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>pues uno puede ir a cortarlas y traerlas, si se encuentra enfermo un niño pues se restriegan </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>para no llevarlo a la clínica pues se le puede poner la flor en la garganta, lo..., le pone uno en en el pecho y en la es..., espalda. También es medicinal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>Entonces y otra vez se...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a468" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>hay que acostar en la cama y hay que abrigarlo para que sude y de esa forma se le quita. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>Sí.   </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>Casi es como si le dieran golpecitos, le</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>en su pecho y su..., aquí le dan para ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a507" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a508" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>Pues hace muchos años nuestros abuelos nos decían que con esas hojas de to:tolkilx..., xoch...,  nos curaban, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>quelite. Dicen que esas son muy buenas, las retriega uno y se le pone este.   </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a509" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>Esas hojas no puedo decir que son amargas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>Mm. También son buenas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a511" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>Sólo que no todos lo sabemos, ahora que acá nos encontramos y yo no lo sé muy bien, pero al habernos encontrarnos y me  estás platicando muy bi..., bien,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>pues también sé algunas cosas y así está muy bien</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a513" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>los pavipollos se alimentan de esas hojas hervidas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a514" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>desde hace muchos años siempre  han alimentado con esas hojas a los pavipollos. Y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>pues así si uno tiene u..., un pavipollo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>pues hay que ir a traer las hojas y hervirlas para darle de comer a los pavipollos, así  van a crecer más rápido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>Este..., son dos t..., hay dos tipos de este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a518" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>de quelite para los pavipollos. Uno es este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a519" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>&lt;i&gt;a:xiwit&lt;/i&gt; y el otro que le llamamos este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a520" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>&lt;i&gt;to:tolkilit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a533" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>Pues también es bonito sa..., ir sabiendo esto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a534" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>el otro el &lt;i&gt;ista:k to:tolkilit&lt;/i&gt; pues también tiene bonitas sus ramas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a535" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>No tienen espinas, son buenas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a536" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>También tiene las ho..., hojas gruesas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a537" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>Tiene las hojas gruesas y es mu blandito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a538" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>Son gruesas las hojas y hasta el tallo es blandito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a539" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>Si se quiebra cuando se cortan su..., las hojas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a540" ANNOTATION_REF="a279">
