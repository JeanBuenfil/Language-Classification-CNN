            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>de wehka:w ya i:pa kinmakah tak n' to:tolimeh. I:pa de wehka:w ya. Wa:n</ANNOTATION_VALUE>
