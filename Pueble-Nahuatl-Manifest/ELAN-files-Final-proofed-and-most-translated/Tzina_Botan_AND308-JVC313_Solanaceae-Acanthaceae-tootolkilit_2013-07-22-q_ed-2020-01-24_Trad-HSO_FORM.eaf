        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>i:n okseki i:n ista:k to:tolkilit pos no: kwaltsi:n ima:yo.</ANNOTATION_VALUE>
