        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>No: xohxoxoktik wa:n *cuando**, ne:n, chika:waya pos tihti:le:wi, oholo:ch.</ANNOTATION_VALUE>
