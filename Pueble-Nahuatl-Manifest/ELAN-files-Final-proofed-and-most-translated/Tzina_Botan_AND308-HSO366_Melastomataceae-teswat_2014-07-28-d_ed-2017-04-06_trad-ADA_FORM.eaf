        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>¿Wa:n ka: t'ma..., katí:n me:tsti yo:n nochi n' xo:chiowa wa:n mochi:wa n' iteyo?</ANNOTATION_VALUE>
