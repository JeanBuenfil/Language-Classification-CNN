        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Wa:n, wa:n okseki ne:n kostik pos sayoh no: moskaltia wehkapa:n</ANNOTATION_VALUE>
