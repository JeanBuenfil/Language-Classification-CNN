            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>Pos neh nikita ke:meh i:n se: ne:ntinemi pané:, ne:n,</ANNOTATION_VALUE>
