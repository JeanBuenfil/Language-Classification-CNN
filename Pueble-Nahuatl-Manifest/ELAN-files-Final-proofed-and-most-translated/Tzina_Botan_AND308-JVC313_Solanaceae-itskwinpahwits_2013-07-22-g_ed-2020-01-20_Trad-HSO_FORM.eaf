        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Wa:n xi:n[i]no: we:wehka moka:wa, sayoh ne:n it..., n' iteyo.</ANNOTATION_VALUE>
