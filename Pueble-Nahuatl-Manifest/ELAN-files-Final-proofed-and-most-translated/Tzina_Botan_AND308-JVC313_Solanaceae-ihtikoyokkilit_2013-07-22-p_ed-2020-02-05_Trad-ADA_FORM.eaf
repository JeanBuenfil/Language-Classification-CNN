        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>ka:nsika, ne:n, se: kita ompa no:, no: e:wi semi itech, ne:n,</ANNOTATION_VALUE>
