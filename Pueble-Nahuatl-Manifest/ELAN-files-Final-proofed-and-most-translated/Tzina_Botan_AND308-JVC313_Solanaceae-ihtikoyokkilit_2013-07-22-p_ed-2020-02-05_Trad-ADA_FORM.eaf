            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>koma:ltampa se: ki..., tikotah mah se: kita:li. Entó:s, wa:n neh nik..., niki:xehekowa *que**</ANNOTATION_VALUE>
