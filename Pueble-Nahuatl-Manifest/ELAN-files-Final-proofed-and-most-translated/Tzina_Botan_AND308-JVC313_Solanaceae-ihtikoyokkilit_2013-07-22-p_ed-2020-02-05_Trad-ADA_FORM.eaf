        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>*Cuando** a:mo tey koma:l pos yehwa ya ne:n itech i:n tek..., itech i:n ....</ANNOTATION_VALUE>
