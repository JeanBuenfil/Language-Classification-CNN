        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>nochi ompa moka:wa ne:to:n de yo:n mi:to:nia ke:meh eskia de ne:n mokwetowa ne:n...</ANNOTATION_VALUE>
