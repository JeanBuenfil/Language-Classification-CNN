        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Komo se: kineki se: kikwa:s, sayoh *que** se: kiekowa ox te:ka:kampi:tsa.</ANNOTATION_VALUE>
