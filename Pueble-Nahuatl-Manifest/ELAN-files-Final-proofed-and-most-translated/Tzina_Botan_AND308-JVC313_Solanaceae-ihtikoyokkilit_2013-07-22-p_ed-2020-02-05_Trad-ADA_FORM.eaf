        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>No: kohkoyoktik, mah se: kiposteki ihkó:n no: koyoktik.</ANNOTATION_VALUE>
