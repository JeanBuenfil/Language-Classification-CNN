        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>No: we:lik n' ixiwyotsi:n wa:n i..., n' iteyo no: se: ki..., se: kikwa.</ANNOTATION_VALUE>
