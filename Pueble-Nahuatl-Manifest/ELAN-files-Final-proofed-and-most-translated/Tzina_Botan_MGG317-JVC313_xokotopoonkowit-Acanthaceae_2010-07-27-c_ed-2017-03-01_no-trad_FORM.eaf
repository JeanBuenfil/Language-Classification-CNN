        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>Yehwa yo:n wa:n no: kwaltia para kola:l, ika takola:ltiah n' tokni:wa:n, selia yo:n, a:mowa:ki.</ANNOTATION_VALUE>
