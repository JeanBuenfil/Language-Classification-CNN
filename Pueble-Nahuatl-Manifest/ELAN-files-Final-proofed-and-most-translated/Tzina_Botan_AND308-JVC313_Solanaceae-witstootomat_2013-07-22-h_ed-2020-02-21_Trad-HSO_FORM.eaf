        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Wehkapania. Wa:n, wa:n pos,</ANNOTATION_VALUE>
