    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a620" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>Bueno pues ahora que otra vez nos encontramos aquí, otra vez quiero preguntarte si</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a621" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>conoces esa planta que le llaman &lt;i&gt;witsto:tomat&lt;/i&gt;, este.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a622" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>Tal vez sepas si se usa para curar, o sirve para alguna otra cosa este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a623" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>las hojas para algo, hay muchas cosas que se, muchas cosas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a625" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>se hacen con las hojas o los frutos sirven de algo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a626" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>Por eso quiero preguntarte si lo conoces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a627" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>Tiene espinas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a628" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>Sí, también lo veo a veces en el campo aquí en donde</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a629" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>en el potrero donde casi no han chapeado se dan esas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a630" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>espinas, el &lt;i&gt;witsto:tomat&lt;/i&gt; lo.... Un tipo de &lt;i&gt;witsto:tomat&lt;/i&gt; se extiende </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a631" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>este..., sobre las hierbas, en donde hay hierbas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a632" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>Y este, cuando madura, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a633" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>sus hojas to..., las hojas todas son blancas y tienen espinas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a634" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>Tiene muchas espinas en toda su..., su..., sobre las hojas, en las puntas de las hojas y el pedúnculo de las hojas todos está cubierto de espinas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a635" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>Y todo el tallo parejo se..., se cubre de espinas, tiene puras espinas el wirts..., &lt;i&gt;witsto:tomat&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a636" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>Y sus fru..., frutos son boludos su..., sus frutos como si fueran jitomates</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a637" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>y cuando maduran esos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a638" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>la planta se le caen todas las hojas y se quedan nada más los frutos que son de color amarillo este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a639" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>en donde s..., se encuentra la ma..., mata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a640" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>Y entonces creo que se seca después de que se secan las hojas, de que madura pues ya se seca la planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a641" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>Y el otro tipo de &lt;i&gt;witsto:tomat&lt;/i&gt; se da,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a642" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>esa planta crece erecta y son gran..., grandes y altas las matas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a667" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>y sus hojas son anchas co..., como las hojas de &lt;i&gt;po:chne&lt;/i&gt; pero esas son  más redondas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a668" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>Y las hojas son gruesas pero están cubiertas de puras espinas, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a669" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>se ven así como pubescentes las hojas y son muy gruesas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a643" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Y aparte de que son pubes..., pubescentes, con los pelitos que tienen las hojas se ven muy gruesas .</ANNOTATION_VALUE>
