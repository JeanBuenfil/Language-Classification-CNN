        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>No: para te:mikti:s ta: yo:n ye:k..., *ye:kfiero** te:kokoh.</ANNOTATION_VALUE>
