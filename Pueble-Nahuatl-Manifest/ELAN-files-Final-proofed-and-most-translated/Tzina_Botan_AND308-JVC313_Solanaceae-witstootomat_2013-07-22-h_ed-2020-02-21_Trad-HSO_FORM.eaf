        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts701">
                <ANNOTATION_VALUE>Te:kokoh wa:n chi:chi:le:wi ne:n</ANNOTATION_VALUE>
