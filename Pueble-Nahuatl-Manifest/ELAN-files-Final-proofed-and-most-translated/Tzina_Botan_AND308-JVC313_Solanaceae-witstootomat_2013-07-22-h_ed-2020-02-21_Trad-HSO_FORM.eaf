            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts829">
                <ANNOTATION_VALUE>Komo a:mo kitsakwiliah pos te:..., te:..., te:kwi wa:n no: ika se: i:xtayowas, ta:, pos ta: te:kokoh.</ANNOTATION_VALUE>
