        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>witsto:tomat oso n' oksé: witsti, n' o:me taman pos nochi kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>Sayoh *que** a:mo tik..., a:mo tikmatih s..., ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>kox, kox kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>Pos kihtowah *que** yo:n chi:chi:ltik kihtowah *que** no: kwali para pahti, yo:n kiliah chi:chi:lkokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>Xa: tikmati na:....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>Yo:n kihtowah *que** no: ki..., kikwiah ka:mpa yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>e:wi seki kokot, kokotsí:n ihkó:n tsikilitsi:n wa:n we:ia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>*Después** ye:kte:kokoh chi:chi:le:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Wa:n yo:n kitekiah kit wa:n kita:lilia:yah kit, ne:n, itomayo ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>Yo:n ke:meh eskia ne:n tomatet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>M..., *o sea** tomatet, ke:meh eskia yo:n xi:tomat n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>Kitapa:nayah ne: ka, kitek..., 'tapa:nayah ne: wa:n 'ki:xtilia:yah n' iteyo wa:n kita:lilia:yah ya ne: ka:mpa ne:n kokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>*Por[que]** yo:n chi:chi:lkokot, pos yo:n koma:mo kitsakwiliah pos mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts627">
                <ANNOTATION_VALUE>mowe:ita:lia, ne:nemi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>Te:ne:nemi wa:n *hasta después** pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>*fiero** se: kimati a, pero nochi mote:..., te:mpitstia, sake:ra e:yi *lado o** na:wi *lado**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>pero kihtowah *que** kita:lilia:yah, nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>yo:n witsto:tomat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>pos ke:masá: kit ki..., nijó:n kitsakwilia:ya. Pahtia ka:mpa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>hko:n patsa:wayaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>Wa:n yo:n *de que**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts653">
                <ANNOTATION_VALUE>te:kokowaya ihkó:n *hasta** titi:kaya kit, *hasta** mi:to:nihtoya de te:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts655" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>Titi:ka wa:n de yo:n titi:ka pos tsahtsaya:ni, yeh n' te:kokoh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>Pos kwaltsi:n *de que** nika:n tik..., tikitstokeh pos nochi ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>wa:n miak a:mo kimatih *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>pos ne: ke:man yehwa ne:n ika te:..., timopahtia:yah *o** te:chpahtia:yah *cuando de**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts669" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>pero kintsi:n no: kwali a *que** a:mo, a:mo teh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>nemi nijó:n kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>Yo:n no: kokolis, nijó:n, chi:chi:lkokot. Ke:masá: te:chkwia ma:ski kone:meh *o** tehwa:n te:kwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>Toto:nik no: te:kwi, no: te:kwia toto:nik, sehsekwi:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n sehsekwi:lis te:kwi pos ma:ski to:natos pero se: sehsektok.</ANNOTATION_VALUE>
