        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>yo:n tsikitsitsi:n.</ANNOTATION_VALUE>
