            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>*igual** yo:n tikihtowa ne:n yo:n tsi:tsika:s, yo:n ta:lpa:n tsi:tsika:s kiliah,</ANNOTATION_VALUE>
