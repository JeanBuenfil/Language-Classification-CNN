        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>pos no: te:metswihwitswih, *porque** ta:lpan..., ma:ski ta:lpan wetstok,</ANNOTATION_VALUE>
