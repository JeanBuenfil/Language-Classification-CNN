        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>Yo:n chi:chi:kokot semi tel....</ANNOTATION_VALUE>
