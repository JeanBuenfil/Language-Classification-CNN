        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1002" ANNOTATION_REF="a575">
                <ANNOTATION_VALUE>Pues uno veía que cuando exprimían  el grano, salía el pus y brincaba lejos.   </ANNOTATION_VALUE>
