        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1008" ANNOTATION_REF="a577">
                <ANNOTATION_VALUE>Brincaba lejos. Entonces este se des..., desinflamaba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1009" ANNOTATION_REF="a579">
                <ANNOTATION_VALUE>Ya no, no se hinchaba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1010" ANNOTATION_REF="a580">
                <ANNOTATION_VALUE>Eso es lo que..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1011" ANNOTATION_REF="a581">
                <ANNOTATION_VALUE>pues también es bonito de que también lo sabemos, usted también lo sabe cómo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1012" ANNOTATION_REF="a582">
                <ANNOTATION_VALUE>este, les..., ese es también como una enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1013" ANNOTATION_REF="a583">
                <ANNOTATION_VALUE>Ese es una enfermedad porque también le atacaba a uno, ahora parece que...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1014" ANNOTATION_REF="a585">
                <ANNOTATION_VALUE>aquí andamos y acá nos...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1015" ANNOTATION_REF="a586">
                <ANNOTATION_VALUE>nos..., nos..., así nos..., andamos encontrando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1016" ANNOTATION_REF="a587">
                <ANNOTATION_VALUE>parece que en ninguna parte se escucha que las personas padezcan esta enfremedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1028" ANNOTATION_REF="a589">
                <ANNOTATION_VALUE>Pues es muy bueno que ya no les ataca esa enfermdad porque existe el peligro de que se muera uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1029" ANNOTATION_REF="a591">
                <ANNOTATION_VALUE>Cuando es fuerte el dolor también lo..., lo hace llorar a uno la erisipela o el </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1030" ANNOTATION_REF="a593">
                <ANNOTATION_VALUE>forúnculo. Como la erisipela es igual que el forúnculo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1031" ANNOTATION_REF="a595">
                <ANNOTATION_VALUE>El forúnculo, sólo dicen que el forúnculo no se cambia de lugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1032" ANNOTATION_REF="a596">
                <ANNOTATION_VALUE>Y la erisipela si se anda cambiando de lugar en su....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1033" ANNOTATION_REF="a598">
                <ANNOTATION_VALUE>Ese sube y se va a otro lugar, anda cambiando de lugar la erisipela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1034" ANNOTATION_REF="a600">
                <ANNOTATION_VALUE>Si no lo detienen pues lo..., lo..., ataca a uno y también se puede uno morir con eso por el dolor fuerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1035" ANNOTATION_REF="a603">
                <ANNOTATION_VALUE>Mm, la fiebre, sufre uno de fiebre y se..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1036" ANNOTATION_REF="a604">
                <ANNOTATION_VALUE>aunque haga sol pero uno siente los escalofríos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1037" ANNOTATION_REF="a606">
                <ANNOTATION_VALUE>Tienen que abrigarlo a uno con la cobija para no sentir mucho el frío.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1038" ANNOTATION_REF="a610">
                <ANNOTATION_VALUE>Pues platicamos bonito en este momento, todo no..., nos dimos a conocer cómo se usa este remedio de...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1039" ANNOTATION_REF="a611">
                <ANNOTATION_VALUE>esas espinas. Pues yo este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
