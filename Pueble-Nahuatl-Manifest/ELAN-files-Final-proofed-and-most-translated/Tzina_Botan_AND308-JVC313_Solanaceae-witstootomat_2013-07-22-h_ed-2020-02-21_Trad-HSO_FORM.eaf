        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>Ekintsi:n no: tikneltokah ke:meh timoliah, pos no: ke:meh teh tikmati pos no: *igual** neh tikitstinemih yo:n ke:meh i:n</ANNOTATION_VALUE>
