        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Wa:n i:n okseki no:, no: *igual** i:n witsto:tomat pero kachi, kachi wehkapania.</ANNOTATION_VALUE>
