        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts705">
                <ANNOTATION_VALUE>*de veras** ka:mpa ne: chi:chi:le:wi nijó:n kokot, no: mote:mpitstia wa:n</ANNOTATION_VALUE>
