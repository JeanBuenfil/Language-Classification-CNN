        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Xoxoktik *cuando** selik wa:n *cuando tepitsi:n chika:wak a, kostik.</ANNOTATION_VALUE>
