        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Bueno, no lo sé, creo que he pasado varias veces en donde se encuentra pero no lo..., no .... (Este texto corresponde a Anastacio)</ANNOTATION_VALUE>
