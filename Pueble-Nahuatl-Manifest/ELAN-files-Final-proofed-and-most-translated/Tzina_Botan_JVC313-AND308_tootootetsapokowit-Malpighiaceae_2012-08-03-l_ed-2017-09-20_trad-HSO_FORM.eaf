        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>Sus flores son un poco, tienen un color amarillo bajo, no, no se ven muy bien, no tienen un color amarillo fuerte pero ni son muy blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
