        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Wa:n ne: pah..., pahpatachtik ne:n e:yi, e:yi, mota ke e:yi iteyo, pahpatachtik. Pahpatachtik wa:n nejó:n kostik yo:n, yo:n kowtet. Kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Wa:n *cuando, cuando** telkwali oksi a, chi:chile:wi a.</ANNOTATION_VALUE>
