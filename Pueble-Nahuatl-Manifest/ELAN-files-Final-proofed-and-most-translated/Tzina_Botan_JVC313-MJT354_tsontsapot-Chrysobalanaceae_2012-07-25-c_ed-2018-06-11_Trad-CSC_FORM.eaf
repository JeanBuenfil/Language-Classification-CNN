        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Se hacen árboles grandes. Pues eso es todo, este, lo..., lo que te preguntabamos y aquí nosotros de verás</ANNOTATION_VALUE>
