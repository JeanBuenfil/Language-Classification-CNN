        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>Si, es un poco amarillento. Si, yo lo conozco porque como este..., y pasamos en el camino y a veces esta floreciendo.</ANNOTATION_VALUE>
