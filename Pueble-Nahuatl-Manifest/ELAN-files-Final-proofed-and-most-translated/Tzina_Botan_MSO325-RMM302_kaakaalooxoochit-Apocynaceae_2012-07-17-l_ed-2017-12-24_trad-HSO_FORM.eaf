        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>para a:..., a:mo teh *te:pasa:rowa** o:n, nejó:n, oso komo weh..., wehka:wak a no: yo:n wa:n, nejó:n, a:mo wel pahti, yehwa yo:ni kihtowah *que** mah tai wa:n ke:mah kixiti:nia yo:n mahyá: esti mota:li:ti se: i:htik *porque de que** se: moxokolia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
