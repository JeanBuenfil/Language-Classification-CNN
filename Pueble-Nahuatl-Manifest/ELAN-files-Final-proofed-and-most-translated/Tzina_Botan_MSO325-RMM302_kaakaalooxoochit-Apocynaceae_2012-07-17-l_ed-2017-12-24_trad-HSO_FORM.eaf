        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Pané: a:mo, yo:n i..., pané: ikowyotsi:n kito:kah, ikowyotsi:n *porque** se: kita ka:mpa yo:n kite:xi:mah wa:n ka:mpa kitamo:tah ata n' ikowyotsi:n selistok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Neh nimolia *que** selias mah se: kitsi:nta:li ke:meh i:ni wa:n selias.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Ke:mah, *porque** ka:n ke:man se: kita ox mah kitati:ka:n, neh i:pa nikitani ihkó:n ka:sá: ika kito:ktokeh ke:meh yo:n neli i:pa kito:kah sah oso yo:n ka:sá: ika, ika tatsakwah no: ke:meh yo:n ka:mpa kita:liah yo:n *alambre** ata no: kita:liah seki yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>Ne:, pero nejó:n neli a:mo, a:mo teh kwaltia, tak i:pa, i:pa s..., i:pa iwki sah yo:n kowtsi:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Ke:mah, yo:n, yo:n ihkochimeh yo:n ye:kwehwei:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Ajá, ke:mah, yo:n, yo:n neli paxoxoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Ke:mah, ke:mah niki:xmattok no: yo:n nejó:n, yo:n okwiltsitsí:n niki:xmattok ta: no:, no:, nejó:n, no: te:kwa ata komo se: moahxi:ltih, no: te:kokoh, ke:mah *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>wa:n tein no: telwehwei:n ya mochi:wah ata telwe:..., *hasta** pané: kohkostiah ya n' ipanko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Wa:n tein yo:n tak no: ekin tahko moskaltihtokeh e:kpaxoxoktsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>Wa:n tein no: *más**, nejó:n, neli tak *de tanto** yetok wehka:wa ya no: nejó:n mahyá: kostik a sah ata mochi:wa n' ipayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>Ke:mah, iwki, iwki n' kilwiah. Ke:mah, ta: neli mochi:wah itech yo:n kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>Sayoh de yo:n ipayo, ke:mah, yo:n ipayo sah n' kihtowah. Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>Pos de ixo:chiotsi:n n'mattok *que** kwaltia no: para mah se: ka:ketsa ke:meh i:n ka:mpa, ne: nijó:n, se: *ixa:ntohtsitsi:n**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Ke:mah, kwaltia ompa se: ka:ketsa neh n'mattok *que** kwali se: ka:ketsa *porque** kwali kitekih ata. Metswe:weyak tepitsi:n, pos yo:n kwali se: ka:ketsa. Ke:mah. Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Pos,</ANNOTATION_VALUE>
