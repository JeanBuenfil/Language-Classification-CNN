        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Pos a:mo se: kimati *porque** nikahkwí:n tak no:, no: onkak *siempre, pero** a:mo, a:mo semi iwki, *más** onkak nehkwí:n para tanikopa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>Ompaka *más** onkak. Ke:mah, ompaka *más** onkak. Pero nikahkwí:n a:mo semi kachi se: kiita mah semi telonka nochi *parejo pero**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>ni..., nika:wí:n paratani *más** mochi:wa ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Eh. Ke:mah wa:n nika:n To:nali:xkopa no:, no: nejó:n no: onkak. Ke:mah, niki:ita n' ompa neli no: onkak, pero de nikahkwí:n pané: a:mo kachi kanah semi se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>*Bueno**. Tasohti tak, *que** no: onkak neli pos neli mah se: kito:ka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>Ke:mah mochi:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>Pos neh nikita ke:mah moskaltia, pero a:mo *tanto** wehka..., wehkapan moskaltia sayoh *que** toma:wak neli wa:n nokta momahmaxalowa kwaltsi:n. Kipia miak imaxalyotsi:n ata nikilia neh wa:n pos yehwa yo:n ixiwyotsitsi:n kwaltsi:n mochi:wa no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>Neh iwki niki:itani i:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Ke:mah, *porque** mota yo:n *que** tel niman moxohxokolia. Pos neh a:mo ke:man nikteki wa:n neli a:mo ke:man nika:ketsa ihko:ni pero nikita seki yeh..., ka:sá: ika ka:ketsah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>pero neh nimolia *que** kitekihno: ika, ika *cuidado, porque** ke:meh yo:n komo eliwis sah se: kiteki motelxohxokoli:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Ke:mah, *porque** niman, niman moxohxokolia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Ke:mah. Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>A:, neh nimono:tsa niMaría Salazar Osollo, neh niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Rubén Macario Martínez" PARTICIPANT="Rubén Macario Martínez" TIER_ID="RMM Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a206" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>Bueno discúlpame señora, yo quiero preguntarle,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>si conoces al árbol que le llaman ka:ka:lo:x..., ka:ka:lo:xo:chit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Y usted no sabe para qué se usa ese ar..., arbolito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>¿Y el té lo toman sólo o le agregan sal?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>Ajá y la flo..., esas hojas, este, la..., ¿y de ése árbol </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>cuantos tipos existen?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>Dos tipos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>Quieres decir que tienen un color bajo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>Ajá, y este yo..., bueno, yo le..., le pregunto a usted,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>yo..., yo conozco tres tipos de esa planta, ese arbolito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>Y es cierto como usted dice s...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>nosotros sabemos que es medicinal para los golpes, cuando uno se cae, se..., cuando uno se cae y se golpea en el abdomen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>Entonces hay que hervir la corteza, pero dicen que no se debe hervir para uno mismo, que..., si uno es el paciente no debe hervirlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Como que hiervan la medicina y que..., que alguien hierva pero uno no debe saber desde antes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Ajá. Ajá. Sí. Se..., Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>Sí porque a mi me platicaba mi..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>mamá que no, no este, que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>otra persona hierva la medicina para que uno se lo tome,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>porque si no, dicen que no, no le..., a uno no le..., no le..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>que a uno no le hace efecto, no le da diarrea, no se limpia uno por dentro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Ajá, uno no debe saber de antes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a231" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>No hay que saberlo con aterioridad, deben de traerlo de repente y uno se la toma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Y en donde van a traer la corteza, dicen bueno, no sé si es cierto, que allá en donde lo..., van extraer la corteza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a233" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>también existe un lugar específico en el tronco, no se hace a lo tonto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>Dicen que la corteza se saca de acuerdo a la dirección por donde sale el sol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a248" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>Ajá, para que haga efecto, para que haga efecto. Deben sacar la corteza con dirección por donde sale el sol, en el oriente, no deben extraer por el poniente, por el norte ni por el sur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a249" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>deben extraer por donde sale el sol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a250" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Eso es lo que me ha platicado mi..., mi mamá, casi así lo hacen para el uso de esa medicina, así es para que..., que..., haga efecto, para que se limpie uno por dentro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a251" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Y los tres tipos, tres tipos este de flo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>yo conozco tres tipos de hierba, flor. Conozco al que le llamamos blanco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>y el que dices que tienen un color ba..., ba..., bajo la flor,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>y hay otro que le llaman color xokoyo:ltik. ¿Por qué le llaman xokoyo:ltik?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>No sé si lo haz visto, tiene tres colores, tiene el color blanco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a257" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>y tiene, tiene me..., digamos nosotros un poco, como si fuera un color bajo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a258" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>Nunca lo haz visto. Y,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a259" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>y eso es lo que te platicaba, pero dicen que es muy buen remedio es el que tiene flores de color blanco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a260" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>Es el de color blanco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a261" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>Bueno es lo que me ha platicado mi mamá, pero yo pien..., pienso que tal vez también se podía usar el árbol</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>aunque sea ése que tiene flores de color un poc..., un poco bajo porque es la misma planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a263" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>Es el mismo. Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a264" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Todos son iguales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a265" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Y otra cosa, cómo se se siembra, como enraíza, si también lo..., no lo.., no tiene semillas, ésa planta no produce semillas, sólo da flores. Ése árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Sí retoña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Sí. Y la madera no podemos decir que se puede usar para leña o para corral.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Sino que la siembran sólo para, bueno yo creo que sólo para que haya, para,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>digamos sólo como para hornato.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>Ajá. Así es. Otra, otra pregunta que le quiero hacer si usted también lo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>lo sabe que ése arbolito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>de ése árbol nacen unos gusanos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Les llaman kopach..., kopachsipomeh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Ajá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Sí tienen color verde fuerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>¿Y ése animal es el que le llaman ka..., ka:ka:lo:xo:ch..., ka:ka:lo:kows..., ka:ka:lo:xo:chikowsipo, es el que le llaman así? Sí, parece que así lo llaman ka:ka:lo:kowxi..., ipo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Y ese es el que te platico, ah..., a..., creo que lo..., ése no muerde, creo que ése animal causa urticaria en la piel de uno</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>al tener contacto con sus pelos. Ajá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Y, bueno sólo eso sabe usted. ¿Las flores para qué se usan?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>A también se usan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>¿Y sólo para eso sirve..., sirven, no se pueden ocupar para otra cosa más digamos?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>Ajá. ¿Y la planta se da en todas partes o también sólo hay..., lugares determinados en donde se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Ahí hace más calor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Ajá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>Sí, por acá por Tepe:tzintan, acá en Anay..., por Anaytitan ya se empieza a dar de veras. Todo por To:nali:x. Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>Pues se escacean.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>Sí. Pues.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>Aa, se me olvidó preguntarte otra cosa </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>que, ¿hasta qué altura llega a crecer el árbol, si crece muy alto o se..., crece su tronco muy grueso o,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>cómo crece? Eso es lo que quiero preguntarte si también conoces como lo conozco yo, por la forma en que crece.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>Otra cosa que le quiero preguntar de sus flores, ¿cómo se cortan?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>¿Se cortan con un gancho o se sube uno para cortarlas con las manos? Porque yo pienso que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>se deben cortar con mucho cuidado, porque si se cortan como uno quiera nada más,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>se pueden caer todas las flores, yo pienso que se machucan fácilmente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>Pues está muy bien, yo..., para mí es..., es todo lo que te pregunté y quería saber porque es verdad como nosotros decimos, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>que esas florecitas son muy suaves y si uno las..., yo he visto que si las cortan con las manos o con..., o así con una garrocha,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>se pueden caer las..., las flores y quedan las puras..., varas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>Se apachurrran, esas flores se..., se..., deben cortar con mucho cui..., cuidado, hay que cortarlas con las manos para que se puedan po...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>para que también se vean..., bonitas en el florero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>pues eso es todo lo que te pregunté, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>sería bueno que usted me diga su nombre, cómo se llama usted y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>de donde viene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>Pues es muy bueno, muchas gracias. Yo me llamo Rubén Macario, ve...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>vengo de Chilcuahuta, también pertenezco acá en San Miguel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="María Salazar Osollo" PARTICIPANT="María Salazar Osollo" TIER_ID="MSO Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a209" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>Sí conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a210" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>Pues dicen que la corteza se usa para curar, como cuando una persona se cae en algun lugar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>y sufre de un golpe. Y dicen que para que la persona no le pase nada dentro de su organismo, porque dicen que con el golpe</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a235" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>a veces en el interior del aparato digestivo queda así como un moretón, entonces hay que tomar el té de la corteza de ka:ka:lo:xo:chit,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>para que..., después no sufra de alguna enfermedad la persona, o este, o si ya tar..., tardó y no se alivia la persona, dicen que el paciente debe tomar té, para que expulse afuera toda la sangre que queda por dentro por el golpe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a237" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>Pues eso es lo que yo no sé, yo sé que dicen que hierven la corteza pero no sé si le agregan sal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>Sí, pero tal vez sí, quizá le agregan poquita sal porque pues la sal sirve para darle sabor a la comida, pero también es medicinal para los golpes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a239" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>Yo pienso que tal vez le ponen un poquito de sal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>Yo sólo conozco dos tipos. Conozco el que tiene flores blancas y conozco el,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>bueno yo digo que las flores no tienen un color rojo fuerte, como que no son muy rojas sino que son como color rositas, pero pues este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>lo conocemos como de color roj .... Ajá. Sí. Le llaman de color rojo, sí, el de color blanco también lo conozco, sólo conozco esos dos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a243" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>Aa, que la..., que hiervan la corteza otro lado, no hay que hervir para uno mismo. Pues eso es lo que yo no sé, yo escuchaba a mi madre que decía que es medicinal para los golpes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>para que después nos sufra uno algún malestar si se cae de una altura y se golpea, dicen que hay que tomar el té de la corteza para que se limpie uno por dentro de los intestinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a245" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>Sí, pero no sé si otra persona debe hervirlo, yo no sé de eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>Ajá, para que haga efecto, deben hervir otro lado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a247" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Ajá, a pues es cierto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>Aa, i..., para que haga efecto la medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>Sí, eso...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>Sí, eso es lo que dicen, y es cierto como me platicas que dicen otras personas que deben extr..., extraer la corteza con dirección por donde sale el sol para</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>para que haga efecto la medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>Sí, pero este, no sabía si por ese lado deben de extraerle la corteza al árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Pero así cualquier hierba medicinal dicen así se debe de hacer, hasta alguna flor que se quiera usar para curar,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>igual hay que cortarla el que se en..., encuentra con dirección por donde sale el sol. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Nunca lo veo esa flor. Yo he visto sólo los dos tipos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>Aa, ésas son.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>Sí es el mismo, porque se ve que el de color blanco y rojo todas son iguales, son muy parecidas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>Sí, pero yo no sé si sólo se debe usar el árbol que tiene flores blancas, yo siempre escuchaba a mi madre que decía, que se puede tomar el té de la corteza de</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>ka:ka:lo:xo:chit, pero no sé exactamente cuál es, si sólo se usa el de flores blancas. Pero se ve que todos son iguales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Parece que no, esa..., parece que se siembra la estaca, porque se ve que en donde tumban la mata y tiran al suelo el tallo, ahí empieza a retoñar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Yo pienso que puede enraizar el tallo si se siembra en el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Así es, porque nunca se ve que corten para leña, yo siempre he visto que en algunas partes la siembran sólo para hornato, o en otros lugares la usan para postes en los alambrados, algunas personas también lo usan para eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>Este, pero es cierto que no, no se puede usar para otra cosa más, creo que no..., no tiene otros usos la madera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Sí, son unos gusanos grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Ajá, sí son, son de color verde por encima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>Sí, sí también conozco ese animalito, también lo conozco, si por accidente se contacta uno en la piel con los pelos que tiene, también causa urticaria y duele mucho, sí porque,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>y los que crecen más grandes si te haz fijado, son muy gra..., también hasta se ven como con color amarillo por encima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Y los que son medianos tienen un color verde fuerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Y los que ya, creo que ya tienen más tiempo, tienen un color amarillo por encima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Sí, así, así le llaman. Sí, si es cierto porque nacen en ese árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Con sus pelos, sí, dicen que causa urticaria con los pelos que tiene. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Pues las flores yo sé que también se pueden ocupar para adorno frente al altar donde están los santitos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Sí, yo sé que se pueden poner en los floreros porque se pueden cortar. Tienen los pedúnculos un poco largos y por esa razón se pueden poner en floreros para adorno. Sí. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Pues,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>las flores no sé si se pueden usar para curar alguna enfermedad, yo sé que solamente se puede usar la corteza, pero las flores se usan para adornar nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Pues no se sabe porque por acá creo que también se da pero no se da igual como por allá abajo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>Por allá se da más. Sí, allá se da más. Pero por acá no se ve que haya muchos árboles en los terrenos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>por..., por allá abajo se da más si te haz fijado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Ehe. Sí y por acá por To:nali:x también, también se da. Sí he visto que por ahí que si hay unos árboles, pero por aquí casi no se ven los árboles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>Bueno. pues creo que se escacea, creo que se daría pero hay que sembrarlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>Sí se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>Pues yo he visto que si crece, pero no tanto es muy al..., no crece muy alto, el tronco es el que crece muy grueso y se pone muchas ramas. Tiene muchas ramas y sus hojas también se ven muy bonitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Yo así lo he visto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>Sí, porque se ve que son muy blanditas y se pueden apachurrar fácilmente. Pues yo nunca las corto y nunca las uso para adornar en floreros, pero he visto que en otros..., lugares las ocupan para adornar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>pero yo pienso que las cortan con mucho cuidado, porque si uno los corta rápidamente se pueden apachurrar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>Sí, porque luego se apachurran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Sí. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>Aa, pues yo me llamo María Salazar Osollo, vengo de San Miguel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
