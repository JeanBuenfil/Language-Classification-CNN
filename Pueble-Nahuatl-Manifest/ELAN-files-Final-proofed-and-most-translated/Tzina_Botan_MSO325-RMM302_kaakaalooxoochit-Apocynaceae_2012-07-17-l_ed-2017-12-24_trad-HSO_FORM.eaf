        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Ke:mah, *mismo** yehwa, ta: se: kita *que** nochi iwki sah n' tein ke:meh ista:k wa:n tein yehwa yo:n chi:chi:ltik, nochi iwki sah se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Ke:mah, pero neh a:mo nikmati komohkó:n i:pa no: kwaltia tein para ista:k sah, neh sayoh ni:pa nika:kakilia:ya note:iskaltihka:w *que** kwali yo:ni mah se: tai yehwa yo:n kiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>ka:ka:lo:xo:chit ie:wayo, pero a:mo nikmati kati:yeh komohkó:n kwaltia para pahti, ox yehwa sah tein ista:k. Pero neli se: kita *que** nochi iwki sah.</ANNOTATION_VALUE>
