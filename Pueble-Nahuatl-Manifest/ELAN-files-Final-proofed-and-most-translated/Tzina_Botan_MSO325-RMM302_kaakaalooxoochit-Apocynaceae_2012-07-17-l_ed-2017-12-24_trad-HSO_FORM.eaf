                <ANNOTATION_VALUE>Yehwa yo:n a:mo nikmati, n'mattok kihtowah *que** taih yo:ni, kimolo:ntiah pero a:mo nikmati ox kipoye:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
