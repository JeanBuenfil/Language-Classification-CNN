    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Rubén Macario Martínez" PARTICIPANT="Rubén Macario Martínez" TIER_ID="RMM Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Perdóname doña, quiero preguntarte acerca de un árbol,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>conozco unos arbolitos, no sé si usted también lo conoce. Se llama xokotatopo:n.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>¿Y cómo son las flores?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>Quizá así sean, a lo mejor son las mismas que yo conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>No sé si también las has visto o como lo utilizan para juego, cuando algunos niños juegan con ello. Yo recuerdo que cuando yo era pequeño,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>me gustaba jugar con ello, por eso le llamamos &lt;i&gt;xokotatopo:n&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>Por eso nosotros lo conocemos como &lt;i&gt;xokotatopo:n&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>Porque nosotros jugábamos mucho con ello</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>nos gustaba porque con ello echábamos como si fueran balas pero se usa la cáscara de naranja, al empujar también truena.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>Nosotros ocupábamos. No sé si tú sepas como se elaboran las pistolitas del tronco del arbolito (&lt;i&gt;xokotatopo:nkowit&lt;/i&gt;).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>Eso es cierto, así como tú lo comentas, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>lo veíamos, eso es verdad, nosotros hacíamos un buen grupo de niños y jugábamos con el &lt;i&gt;xokotatopo:n&lt;/i&gt;, nos echábamos balas con la (cáscara de naranja) y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>yo primero, primero vi,  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>algunos niños de mi edad, jugaban con ello y después les preguntaba cómo lo elaboraban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>Ellos me decían que uno debe cortar el tronco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>y se perfora con un, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>un, un pedazo de palo </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>bambú o con un pedazo de carrizo, ¿cómo le llamamos nosotros?, bambú</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>Y se alisa bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>Se alisa bien y no se le hace la punta fina sino como chato </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>Entonces con ello se perfora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Al perforar, sale todo lo que hay por dentro del tronco (médula), es como una especie de bagazo, así mero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>Una vez que ya se perfora,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>digamos que se hace un poco de punta, se le corta un poquito para hacerle la  punta </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>pero se le saca bien, bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>podemos decir que la punta como si fuera plano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>Y se hace un poco de filo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>Se le hace un poco de filo y luego</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>se observa bien de ambos extremos porque en un extremo es más reducido que el otro </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>el extremo más amplio es donde sale </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>la cáscara de naranja, así le llamamos, corteza de naranja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>Un dia me propuse hacerlo también. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>Solamente observé y les pregunté a los otros niños de cómo lo hacían y me lo contaron, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>y me dijeron de qué palo se usaba para hacer el &lt;i&gt;xokotatopo:nkowit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>Me propuse hacerlo. Corté un padazo del tronco y alisé un pedazo de bambú.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Lo hice, alisé el bambú y (con el bambú) lo empecé a perforar (el &lt;i&gt;xokotatopo:nkowit&lt;/i&gt;). Al terminar de perforar, le hice la punta, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>y pensé cortar una naranja. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Como en esta temporada que hay naranja, en agosto, a principio del mes de septiembre,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a169" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>cortábamos la naranja y la pelábamos, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>y le insertábamos a ese tronco, con el tronco le hacíamos girar (nota: para performar la cáscara de la naranaja como si fuera con un taladro), entonces </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>ya cortaba la cáscara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Aha. Eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>Eso es lo que ocupábamos para jugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>Si. Y yo te digo, nos gustaba, como éramos niños, cuando uno es niño, nos gusta de todo, a nosotros nos gustaba eso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>andábamos tiroteandonos, ya andábamos correteándonos y nos tiroteábamos. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>Y pregunté. Entonces eso fue lo que pregunté</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>cómo es ese palo y me lo enseñaron. Entonces es cuando yo también pensé cortarlo y yo l...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>lo revisé muy bien de cómo es la flor, cómo son las hojas y como es el tallo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>Hasta no se me olvida cómo es esa planta, todavía la recuerdo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Aunque en aquéllos tiempos éramos pequeños, pero ahora aunque ya estoy grande de edad, todavía la recuerdo cómo es esa planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Y es verdad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>Es cierto, muy cierto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>Otra coso quiero preguntarte, si acaso sea el mismo que yo conozco, ¿Cómo es la flor?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>¿Y las hojas cómo son?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>Pues lo que yo te estoy contando, ciertamente así son las hojas y las flores así son como tú me dices. Si, eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a209" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>Quiero saber porqué tú lo conoces como &lt;i&gt;piokwitakowit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a210" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>&lt;i&gt;'Piokwitakowit'&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Uno lo conoce de diferentes maneras, yo lo conozco solamente como &lt;i&gt;xokotatopo:nkowit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>Quizá porque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>lo jugábamos como cerbatana con la cáscara de naranja. Si, quizá sea por eso, quizá sea por eso, por eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Gracias, yo me llamo Rubén Macario.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>Pues nada mas eso pudimos platicar. Vengo de Chilcuauhta, San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="María Salazar Osollo" PARTICIPANT="María Salazar Osollo" TIER_ID="MSO Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>Sí, también lo conozco, al que también le llaman piokwitakowit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>Yo, así lo conozco, así le llaman,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>esa la que tiene hojas redondas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>Y las hojas parecieran que están manchadas con agua de cal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>Y los troncos son un poco gruesos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>Yo he visto algunas que tiene flores amarillas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>Si, yo así las he visto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>Aha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>No sé, pero veía a los niños que jugaban con ello, pero como yo era niña nunca jugué con ello.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>Cuando era niña nunca jugué con el &lt;i&gt;xokotatopo:n&lt;/i&gt;, aún era pequeña pero veía como los niños jugaban con ello.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a186" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>Cuando uno se es niña pequeña, no se jugaba con ello.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>Como niña no se ocupa como juguete, como niña yo jugaba con otro tipo de juguetes y los niños otro tipo de juguetes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>Ese como blanco tiene adentro, como la parte interior del &lt;i&gt;po:chne&lt;/i&gt; (&lt;i&gt;Telanthophora grandifolia&lt;/i&gt; (Less.) H. Rob. &amp; Brettell</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>Mm, si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>La cáscara de naranja quedaba todo perforado. Si, eso veía, partían la naranja y, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>y la cáscara quedaba todo perforada. Pues jugaban con ello. Sí, yo también lo ví, es verdad, queda perforada, yo nunca jugué con ello pero lo vi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>Si, mm, también lo vi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a192" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>Si, pues cuando uno es pequeño de edad, yo digo que a todo tipo de juguete nos gusta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a199" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Pues uno recuerda muy bien de todo lo que ocupábamos para jugar cuando se es niño pero al crecer o cuando uno ya es adulto pues ya no jugamos porque nosotros de grandes ya no tenemos tiempo para jugar. Pero si es cierto, cuando somos pequeños jugamos mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>Si, también recuerdo haber visto todo eso, eso lo que tú mencionas también lo ví, lo ocupaban para juguete.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a204" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Pues eso lo que yo te digo, yo he visto que la flor es amarilla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a205" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Si, es la que yo conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a206" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>Pues las hojas son redondas, parecidas a la hoja santa (&lt;i&gt;a:ko:kohxiwit&lt;/i&gt;, &lt;i&gt;Critonia morifolia&lt;/i&gt; (Miller) R.M. King &amp; H. Rob.) pero la hoja santa es lisa. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>Y las hojas del, del &lt;i&gt;xokotatopo:n&lt;/i&gt; tienen una mancha con tendiencia del color del agua de nixtamal (amarillo bajo). Si, yo así las conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Si. Si, es verdad, yo le he visto. Si. Lo conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>¿Porqué? Yo le llamo así porque así escuché de mis padres, ellos así le llamaban por eso yo lo conozco así hasta el dia de hoy. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Si, yo sé que mis papás así le llamaban, así me decían de cómo se llama.	</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>Cuando lo veía, les preguntaba de cómo se llama eso con que juegan mucho los niños .</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>Y dicen que así se llama, &lt;i&gt;piokwitakowxiwit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Si, quizá sea por eso. Si, lo nombramos de distintas maneras. Si. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>No es nada, gracias, si. Yo me llamo María Salazar Osollo y vengo de San Miguel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
