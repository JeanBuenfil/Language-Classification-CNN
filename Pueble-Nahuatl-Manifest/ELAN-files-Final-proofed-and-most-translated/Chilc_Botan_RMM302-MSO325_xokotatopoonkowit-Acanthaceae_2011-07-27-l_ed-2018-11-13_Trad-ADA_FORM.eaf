        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>{Aquí dijo por error niktahtanik, debe ser nitahta:nik}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
