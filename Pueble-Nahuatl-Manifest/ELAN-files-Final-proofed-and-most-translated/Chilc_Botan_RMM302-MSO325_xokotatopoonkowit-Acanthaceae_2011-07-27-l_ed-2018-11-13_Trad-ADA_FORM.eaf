                <ANNOTATION_VALUE>Pos se: kelna:miki nikilia tein se: ka:wiltia &lt;i&gt;cuando&lt;/i&gt; se: nohne:l wa:n se: we:iaki se: ka:wiltia &lt;i&gt;porque&lt;/i&gt; tikihtowah ka:n tima:wiltiah ok &lt;i&gt;porque&lt;/i&gt; ekintsi:n tiwehwei:n ya, a:mo tike:mantih ok. Pero neli &lt;i&gt;cuando&lt;/i&gt; tinohne:lmeh neli se: ma:wiltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Ke:mah, a:mo ta: no: nikitak neli yo:ni, yehwa yo:n tikihtowa, neli no: nikitak neli ka:wiltia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Pos neh yehwa nimitsilwia n' ixo:chiotsin neh nik..., niki:ta seki yehwa yo:n kostik n' ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>Ke:mah, neh yehwa niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Pos ixiwyotsi:n yehwa yo:n ma:yehyewaltik, tamatisneki ke:meh a:ko:kohxiwit, pero a:ko:kohxiwit ma:ahalaxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>Wa:n yeh ata pané: ma:..., ma:..., ma:..., mahyá: ma:nehnexa:yo:tik mochi:wa n' ixiwyotsi:n. Ke:mah, neh iwki niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah, ta: neli, ta: niki:itani. Ke:mah. Niki:xmattok neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>¿Ke:yeh? &lt;i&gt;Porque&lt;/i&gt; neh iwki nikto:ka:ytia &lt;i&gt;porque&lt;/i&gt; iwki nikinkakilih note:iskaltihka:wa:n iwki kito:ka:ytia:yah &lt;i&gt;por eso&lt;/i&gt; neh iwki niki:xmati &lt;i&gt;hasta&lt;/i&gt; a:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>Ke:mah, neh nikmattok &lt;i&gt;que&lt;/i&gt; iwki kilia:yah ne: note:iskaltihka:wa:n, ihkó:n ne:chilia:yah ke:ní:w mono:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Nikitaya yo:ni wa:n nikintahtania:ya pos ke:ní:w mono:tsa i:n nokta ka:wiltiah ne: okichpi:pil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Wa:n kihtowah &lt;i&gt;que&lt;/i&gt; iwki yo:n mono:tsa piokwitakowixiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>Ke:mah, xa: yehwa ika. Ke:mah, e:h, ta:ta:man neli se: kito:ka:ytia. Ke:mah. Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>A:mo teihsá:, a:mo teihsá:, tasohka:matik ke:mah. Neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="Comentarios" PARTICIPANT="Comments" TIER_ID="Comments">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>{Ceferino Salgado dice timosenmiaka:kwiah}	</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>{Aquí dijo por error niktahtanik, debe ser nitahta:nik}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
