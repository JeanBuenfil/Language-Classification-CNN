        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>Alguna vez lo has comido, dicen que es bueno para comer.</ANNOTATION_VALUE>
