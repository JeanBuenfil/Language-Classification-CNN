            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>Pos kwaltsi:n no: se: moyo:lmela:wa para</ANNOTATION_VALUE>
