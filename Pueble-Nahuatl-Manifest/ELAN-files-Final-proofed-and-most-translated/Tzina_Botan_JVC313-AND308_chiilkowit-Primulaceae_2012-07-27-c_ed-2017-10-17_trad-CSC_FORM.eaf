        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>timopale:wiah ika.</ANNOTATION_VALUE>
