        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Ke:mah, *que** onkak miak taman kowtet, *porque**, yo:n, yehwa yo:n tikihtowah chi:lkowit iteyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
