        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a720" ANNOTATION_REF="a353">
                <ANNOTATION_VALUE>Solamente del otro (tepe:chi:lkowit) se puede encontrar en ele monte.</ANNOTATION_VALUE>
