        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>nejó:n neli ka:mpa yo:n moma:ytia, ka:mpa ki:sa se: imaxal, ki:sa ompa nochi, ompa sah *mismo** ki:sa ne: seko mahyá:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>mahyá: tehwa:n toma:wa:n, ke:meh nika:n toma:y, nika:n ki:sa n' toma:y se:. Wa:n *igual** no: ne: ko..., ne:n kowit moma:ytia, *siquiera** e:yi ima:y mochi:wa n' imaxal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>pero yo:n me..., mota:lilia ne: mela:wak, mo..., *que** mo..., mosowa ihkwí:n ima:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>No: taman moma:ytia, ke:meh i:n tepe:chi:l no: taman yeh moahkokehketsa, y..., yeh ki:sa n' ima:y, imaxal wa:n panki:sa ahko wa:n i:n a:mo, ne: i:n se: yeh tep..., yo:n chi:lkowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>ki:sa n' ima:y wa:n moi:xtapalta:lia ihkwí:n wa:n sepa se: ki:sa n' ihkwí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>Wa:n iwki panki:stiw ihkó:n moma:ytia *hasta** panki:sa, *hasta** we:wehti, iwki sepa ne:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Ompa ke:mah de ta:ki a wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
