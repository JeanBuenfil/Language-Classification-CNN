        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Wan i..., n' i..., n' ima:yo no: ye:ktakwa:wak n' i..., n' ixiwyo.</ANNOTATION_VALUE>
