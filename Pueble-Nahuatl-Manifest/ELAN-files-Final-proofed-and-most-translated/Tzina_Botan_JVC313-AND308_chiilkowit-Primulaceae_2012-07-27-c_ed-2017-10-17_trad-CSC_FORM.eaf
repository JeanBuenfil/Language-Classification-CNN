        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>se: ki..., se: kiteki ihkó:n wa:n kwaltia para ika se: ta..., tahtachkwa nochi.</ANNOTATION_VALUE>
