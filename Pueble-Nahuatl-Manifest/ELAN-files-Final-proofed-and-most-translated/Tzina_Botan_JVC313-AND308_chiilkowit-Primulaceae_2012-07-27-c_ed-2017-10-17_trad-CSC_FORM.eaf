        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Pos yehwa i:n ika se: tachipa:wa, se: kitila:na kopahsol.</ANNOTATION_VALUE>
