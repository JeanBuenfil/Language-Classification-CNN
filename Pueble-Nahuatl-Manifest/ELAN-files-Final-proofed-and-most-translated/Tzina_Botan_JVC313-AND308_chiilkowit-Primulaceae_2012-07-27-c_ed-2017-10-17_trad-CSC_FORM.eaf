        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts726">
                <ANNOTATION_VALUE>Pos yehwa kintsi:n nochi ti..., ti..., tim..., timolihkeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
