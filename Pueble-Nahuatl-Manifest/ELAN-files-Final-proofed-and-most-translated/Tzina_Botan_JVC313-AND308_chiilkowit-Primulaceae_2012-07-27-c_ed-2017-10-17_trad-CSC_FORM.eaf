        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Wiwiti, paniá:n moka:wa wa:n no: koma:mo niman se: kitehteki,</ANNOTATION_VALUE>
