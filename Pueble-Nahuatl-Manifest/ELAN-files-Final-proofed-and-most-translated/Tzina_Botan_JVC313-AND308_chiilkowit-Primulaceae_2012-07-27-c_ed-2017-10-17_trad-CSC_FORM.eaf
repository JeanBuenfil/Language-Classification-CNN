        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Kwaltsi:n ne:n ma:pihpitsa:wak wa:n ahalaxtik no: n' i..., ima:xiwyo.</ANNOTATION_VALUE>
