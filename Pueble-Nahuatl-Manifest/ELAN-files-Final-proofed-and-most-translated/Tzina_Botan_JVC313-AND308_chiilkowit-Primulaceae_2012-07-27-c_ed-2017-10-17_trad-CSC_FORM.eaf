        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
