        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>Takwa:wak. Komo ye:kate:neh, yo:n se: kie:kate:ntia, se: kixihxi:ma, se: kipetska:teki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts536">
