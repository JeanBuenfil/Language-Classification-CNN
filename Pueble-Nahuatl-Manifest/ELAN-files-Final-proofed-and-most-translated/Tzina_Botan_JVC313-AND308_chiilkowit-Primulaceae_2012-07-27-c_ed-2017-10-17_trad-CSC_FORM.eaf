        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>pos teihsá: hkó:n se: ki..., se: kita:lia yo:n,</ANNOTATION_VALUE>
