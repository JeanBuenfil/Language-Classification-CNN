        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts650" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>Nochi, pos yo:n ka:nsika se: kita ihkó:n paniá:n te:ntok, nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>a:mo se: kimati ka..., katí:n to:nal ne:, *bueno** ka:nachi to:nal kichi:wa para pala:ni.</ANNOTATION_VALUE>
