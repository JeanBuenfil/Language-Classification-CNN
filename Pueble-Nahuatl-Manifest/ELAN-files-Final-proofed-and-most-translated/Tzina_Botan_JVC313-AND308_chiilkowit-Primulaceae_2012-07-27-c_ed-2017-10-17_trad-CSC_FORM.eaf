                <ANNOTATION_VALUE>Wa:ki, komo a:mo a:kin kite:ntek para teihsá: kitatekiwtih pos ompa wa:ki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
