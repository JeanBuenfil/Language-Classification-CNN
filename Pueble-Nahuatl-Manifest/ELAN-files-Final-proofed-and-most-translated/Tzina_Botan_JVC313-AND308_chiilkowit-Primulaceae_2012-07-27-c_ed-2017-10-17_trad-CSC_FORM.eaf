        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>A:mo se: kichi:wa *cuenta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts666">
                <ANNOTATION_VALUE>Pero yo:n kihtowah pos no:, no:, nochi, nochi kwaltia.</ANNOTATION_VALUE>
