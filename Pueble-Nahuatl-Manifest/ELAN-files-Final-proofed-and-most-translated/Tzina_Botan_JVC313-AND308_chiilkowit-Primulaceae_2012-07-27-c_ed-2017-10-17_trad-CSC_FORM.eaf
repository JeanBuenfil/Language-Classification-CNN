        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>Eti:ya wa:n a:mo se: kima:xi:ko:sneki. Yehwa yo:n *que** de tio:taki te:kokohkeh se: ima:wa:n ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts576" TIME_SLOT_REF2="ts578">
