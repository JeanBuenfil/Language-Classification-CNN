        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>[Las semillas recias] se caen, las semillas se caen.</ANNOTATION_VALUE>
