        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>son duros como dorados y al ser movidas emiten un sonido.</ANNOTATION_VALUE>
