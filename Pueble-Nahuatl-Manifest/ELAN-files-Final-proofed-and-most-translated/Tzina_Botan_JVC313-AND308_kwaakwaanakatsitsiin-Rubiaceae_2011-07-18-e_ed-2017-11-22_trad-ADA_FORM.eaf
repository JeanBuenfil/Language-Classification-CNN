        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Mi papá decía, "aqui anda este, </ANNOTATION_VALUE>
