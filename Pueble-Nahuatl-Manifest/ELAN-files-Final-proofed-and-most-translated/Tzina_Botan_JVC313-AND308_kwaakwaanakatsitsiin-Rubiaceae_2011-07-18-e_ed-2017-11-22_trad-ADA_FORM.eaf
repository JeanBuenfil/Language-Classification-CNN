        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Y decía "pues se comió el tronco. Este..., </ANNOTATION_VALUE>
