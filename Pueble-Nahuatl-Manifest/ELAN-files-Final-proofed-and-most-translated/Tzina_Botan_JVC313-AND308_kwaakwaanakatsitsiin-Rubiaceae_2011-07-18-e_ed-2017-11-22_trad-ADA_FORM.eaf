            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Ah, pues aqui anda este, </ANNOTATION_VALUE>
