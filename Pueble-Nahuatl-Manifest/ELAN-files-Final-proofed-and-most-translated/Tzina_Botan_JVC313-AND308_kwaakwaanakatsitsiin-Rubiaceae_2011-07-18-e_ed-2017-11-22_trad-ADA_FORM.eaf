        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>los ponemos atravesados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>Y la corteza de ese árbol..., nuestros padres, antes le llamaban..., a veces íbamos,</ANNOTATION_VALUE>
