        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>la pelusa (es blanca). Unos son de color gris. A veces lo veíamos, a veces mi papá lo trae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Le decía, ¿Qué animal es ese? Dice, "este es el kowtu:san".</ANNOTATION_VALUE>
