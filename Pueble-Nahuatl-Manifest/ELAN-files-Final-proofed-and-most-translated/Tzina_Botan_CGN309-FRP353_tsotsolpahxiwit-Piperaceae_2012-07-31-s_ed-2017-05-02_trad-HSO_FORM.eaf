        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>También la conozco, a la conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>Este, ¿qué le pasa señora?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Aa tienes los pies hinchados metste:te:mi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>Aa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a186" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>Pero este, esas hojas se usan para curar los granos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>Sí sirve para eso, si tienes un grano, ve a traer las hojas si es que hay en donde vives, traelas y caliéntelas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>Y con las hojas calienta varias veces el grano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>Y des..., y después de calentarlo, luego la..., las tomas o vuelves a traer otras hojas frescas y..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>Cortas las hojas en pequeños pedazos, le echas un poco de refino y le pones al grano, encima tapas el lugar donde se encuen..., el grano, luego lo...,  con las mismas hojas que..., de las más anchas. Uhuh, de las gran..., grandes, anchas de las hojas más grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>las hojas que que cortaste en pequeños pedazos, le pones en el lugar donde se encuentra el grano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>Y lo amarras co un pedazo de tela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>No, debe ser frío, frío, frío. Aha, el refino lo revuelves con las hojas que cortaste en pe..., cor..., ho..., todas las cortas en pequeños pedazos  la..., los pedazos de hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Le echas ya el refino a las hojas que cortaste para que..., después le pongas encima como emplasto las hojas anchas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>Aha, se amarran para que no se despeguen y luego que se vaya a dor..., dormir el paciente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>pra que..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Siquiera dos, tres o cuatro veces, segun tse..., lo veas cómo va mejorando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>De acuerdo como vaya mejorando, si le hacen efecto las hojas o no. Aa.</ANNOTATION_VALUE>
