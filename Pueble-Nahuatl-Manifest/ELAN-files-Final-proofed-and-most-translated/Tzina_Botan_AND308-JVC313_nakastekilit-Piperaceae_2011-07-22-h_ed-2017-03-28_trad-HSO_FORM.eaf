        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>pos nijó:n no: mochi:wa ne:wí:n se: kita:lia ihkó:n wa:n mowila:na itech tet</ANNOTATION_VALUE>
