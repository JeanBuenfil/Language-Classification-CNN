        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>También le damos uso para nuestra comida. Así es.</ANNOTATION_VALUE>
