        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Tein kowtsí:n ya, tein ikowyo ya pos yeh kina:...,</ANNOTATION_VALUE>
