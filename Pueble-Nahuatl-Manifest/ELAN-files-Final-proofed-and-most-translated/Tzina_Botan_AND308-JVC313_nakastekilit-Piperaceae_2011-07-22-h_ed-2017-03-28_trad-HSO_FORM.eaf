        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Pos yo:n a:mo nikihto:s para teihsá: pahti, yo:n para tehwa:n tik..., tik..., tikmahse:wah yo:n para totapalo:l. Para takwal sah ne:n i:n.</ANNOTATION_VALUE>
