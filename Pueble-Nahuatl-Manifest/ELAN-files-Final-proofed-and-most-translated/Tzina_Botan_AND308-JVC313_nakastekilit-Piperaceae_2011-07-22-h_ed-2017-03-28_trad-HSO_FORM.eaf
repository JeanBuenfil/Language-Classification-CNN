        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>Así es. Pero no compadrito, también, también conozco igual como también</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>vivimos en el mismo lugar pues la comida la..., kisemo..., si preparan el xokoyo:lin con frijoles pues le ponen esas hojas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a176">
