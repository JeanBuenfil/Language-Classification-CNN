        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Wa:n *cada** ii:x ompa n' itsmoli:ni para miakia n' xiwtsí:n. Kanah, ta: yo:n a:mo mone:neki, teke:span sah ka:mpa takwecha:wtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
