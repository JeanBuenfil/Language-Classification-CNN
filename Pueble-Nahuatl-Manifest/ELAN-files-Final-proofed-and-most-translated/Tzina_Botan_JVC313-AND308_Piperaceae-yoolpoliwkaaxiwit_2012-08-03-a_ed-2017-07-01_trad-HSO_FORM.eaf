        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>Pero yo:n a:mo, a:mo nikihto:s ne: xoko:k oso chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Yo:n kwaltsi:n chipa:wak yo:n a:tsi:n.</ANNOTATION_VALUE>
