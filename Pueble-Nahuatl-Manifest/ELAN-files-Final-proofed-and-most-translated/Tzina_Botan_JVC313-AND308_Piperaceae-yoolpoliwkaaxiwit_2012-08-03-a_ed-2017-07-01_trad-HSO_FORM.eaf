            <REF_ANNOTATION ANNOTATION_ID="a632" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>que es muy buen remedio y es difícil juntar las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a633" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>No me pueden pedir un costal grande para llevar un gancho y cortar muchas hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a634" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>Esa planta no se..., se encuentra muy poquito, lo..., se encuentran muy pocas plantas, es muy..., muy escasa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a635" ANNOTATION_REF="a390">
                <ANNOTATION_VALUE>Ni siquiera se llena el morral, si lo..., es muy poquito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a636" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>Esa planta se..., no se encuentra en gran cantidad, yo he visto porque también he ido a traerlas. Eso es todo ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a637" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>Este me..., me preguntabas porque te interesaba saber, pues es todo lo que conozco. Mm. Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a638" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a639" ANNOTATION_REF="a396">
                <ANNOTATION_VALUE>Es todo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a640" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a641" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>Así es, yo me llamo Ernesto Vázquez, vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>A ver, puedes decir..., ya que nos encontramos aquí puedes platicarme acerca del que le llaman yo:lpoxiwit, quizá la conozcas, ahora vamos a platicar por si la conoces esa planta, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>si se usa para curar, para comer o cómo se usa, en donde se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Yo:lpo..., yo:l[poliw]ka:xiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a436" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>A cuando lo bañan lo hacen como si fuera confidencial.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a443" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>Son chiquitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a444" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Pues ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>Sí es efectivo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>Pues ahora que aquí no encontramos preguntamos acerca de esa hierba, como andamos en el bosque a veces alguna persona nos invita a que la vayamos a traer. Uno va a traer sólo hay que saber a donde hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a451" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>Pues yo también vi por ahí wi:is..., acá en Koyo:xo:chiko, a veces ahí la..., la vamos a buscar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a452" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Pues también, es igual como yo conozco que se da en la superficie de los riscos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>Pero las plantas son muy chiquitas, no, no crecen grandes, sus hojas son un poco delgadas y un poco rasposas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>Y en donde se da, no se da en cantidad y son muy chiquitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Y esa planta no se encuentra por allá o cerca de aquí si la busca uno cuando le dicen, "Ve a buscar por ahí en el ríio o por ahí cerca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a459" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>No se encuentra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a460" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>Este se encuentra pero muy hasta..., lejos por allá donde se encuentra un salto de agua, por allá quizás haya. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>En los..., así en los arroyos. Pero en el mero donde... Se encuentran las plantas pero muy escasas y a la orilla del río en donde corre el agua aunque haya plantas luego las arranca el agua porque sus raíces se encuentran muy encima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>Sus raíces se encuentran muy encima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>Pues algunas personas le llaman yo:lpoliwi, yo:lpoliwka:xiwit porque, pues ésa planta también la conozco que a veces es buen remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>A veces se..., uno siente dolor en el pecho o se sienten como estirones cuando se..., le dan a uno como calambres pierde uno la memoria sin saber a donde quiere ir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>Dicen algunas personas que esa hierba es buena para la enfermedad, algunos las machacamos cuando las preparamos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>otros las hervimos muy poquitas al preparar no .... Así de poquitas se buscan las hojas y al hervirlas queda muy poquito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>Una parte del té se toma y otra parte se usa para frotar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>Y al preparar queda el agua de color verde que se ve bonita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>Pero el té no tiene un sabor agrio o amargo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>El té queda así muy limpia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Pues cuando lo ivitan a uno que vaya a traer esa hierba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>Pero cuando se traen las hojas y en el momento de llegar, hay que hervirlas o machacarlas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>En un lugar escondido si se encuentran otras personas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>Se debe hacer afuera o hay que traerlas a escondidas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>si uno las trae en el morral hay que ir por otro lado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>Ni hay que llamar a la esposa porque uno sabe a donde lo va a preparar, sólo se..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>se consigue el traste para preparar y se empieza a hervir, después de enfriarse ya se le da de tomar al paciente si es niño.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>Pero no se le puede platicar a cualquier persona, que voy a traer las hierbas y se le enseña para que las vea, no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>Sólo uno debe saber.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>Ya no se encuentra y ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>Y dicen que ya no hace efecto para la enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a501" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Algunas le llaman yo:lpoliwi, nosotros le llamamos yo:lpoliwixiwit porque cuando uno se enferma hace uno como si se tor..., torciera el cuerpo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a502" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>Algunos perdemos la memoria, uno no se da cuenta aunque ande caminando por ahí, y la enfermedad llega así de repente, uno empieza a sentirse mal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a503" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>Y si uno acude a una clínica pues no se cura, no hace efecto la medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a504" ANNOTATION_REF="a247">
                <ANNOTATION_VALUE>Porque algunas personas saben que esa planta si es buen remedio para curar, así como platica uno con ellos pues lo dicen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>Pues lo platican o a veces dicen vamos a traerlas pues vamos a buscarlas aunque se encuentren lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a521" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>como usted me platica que si uno lo busca por ahí a la orilla del río o uno se va allá por Pano:lo:ya:n (en donde se atravieza) acá por Tahchikteko puede uno andar todo por ahí y no se va a encontrar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a522" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>Todo por A:tmona:miki no se encuentra, esa hierba se encuentra por allá en el bosque.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a523" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>En los arroyos, por ahí en las barrancas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a524" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>sobre los riscos nacen las plantas que tienen flores blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a525" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>Pero son muy chiquitas, no crecen grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>Son muy chiquitas y casi nunca veo cómo son sus semillas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a527" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>Si son negras o blancas, sólo he visto sus flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a528" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>Veo sus flores pero nosotros también las..., las vamos a traer pero cortamos sólo sus ho..., hojas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a529" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>N sus..., sus flores nunca las cortamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a530" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>Las deja uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a531" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>Pues ahí otra vez ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>Se acaban y pues deben ser muy caras, si uno le pide a otras personas para que las consigan y si a uno no lo conocen, van a querer que uno les pague muy caro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a533" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>Y esas plantas no se encuentran por ahí nada más, si te dicen búscalas por todo el cafetal o allá en el bosque.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a534" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>O en la barranca (arroyo) no lo vas a encontrar, (aquí se contradice Anastacio) no lo vas encontrar y no,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a535" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>no se puede encontrar fácil como otras plantas que ves por ahí, solamente se encuentran ahí en el bosque.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a536" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>Hay que ir hasta allá en el bosque pero es importante cuidarse mucho porque son lugares muy difíciles, hay espinas y las piedras están muy resbalosas en los arroyos, hay lugares que se encuentran los cerros muy altos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a537" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>Donde se encuentra el cerro así</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a538" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>pues ahí nacen las plantas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a539" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>Ahí ve uno las plantas en la superficie del cerro, luego dice uno, "Pues ahí hay plantas de yo:lpoliwka:xiwit".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a541" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>Entonces ahí se cortan las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a542" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>También si uno las arranca así pues este se..., se acaban. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a558" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>Y usted no sabe, puedes decirme si se puede traer una mata para sembrar por ahí, si se..., junto a la casa si se podría adaptar. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a559" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>Donde se encuentra una cascada y está soplando la brisa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>Pues,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a561" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>En la punta de la planta le llega la brisa(¿?).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>Eso es y ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a563" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>Siempre está fresca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a564" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>No, si se siembra no, se va a secar y se puede echar a perder la planta. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a565" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>Eso es..., quizá ahí porque está brisando y a la planta siempre le llega el aire fresco y ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a566" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>Por ahí en donde cae el agua ahí nacen las plantas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a567" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>por ahí por Koyo:xo:chiko también se da quizá usted también sabe, por ahí si se dan las plantas, uno lo..., yo he visto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a568" ANNOTATION_REF="a311">
                <ANNOTATION_VALUE>Se dan pero muy escasas, uno que otra planta se ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a593" ANNOTATION_REF="a314">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a594" ANNOTATION_REF="a315">
                <ANNOTATION_VALUE>Y hace poco, unas personas se fueron por ahí a buscar en todos los arroyos y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a595" ANNOTATION_REF="a316">
                <ANNOTATION_VALUE>No la encontraron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a596" ANNOTATION_REF="a318">
                <ANNOTATION_VALUE>No encontraron, dicen que buscaban esa planta pero no la conocen bien y ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a597" ANNOTATION_REF="a320">
                <ANNOTATION_VALUE>No les dije a donde. Porque pensé qué tal si por de malas se vayan a accidentar por ahí pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a598" ANNOTATION_REF="a322">
                <ANNOTATION_VALUE>La planta se da pero hasta allá lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a599" ANNOTATION_REF="a324">
                <ANNOTATION_VALUE>Pues nosotros sabemos porque hemos ido a ver a los arroyos o vamos a los bosques algunas veces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a600" ANNOTATION_REF="a326">
                <ANNOTATION_VALUE>Pues ahí ve..., veíamos cuando nuestros padres nos enseñaron cuáles son las plantas que se pueden usar para curar la enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a601" ANNOTATION_REF="a328">
                <ANNOTATION_VALUE>Y esa enfermedad le da a uno quizá sea natural o tal vez cuando uno hace corajes o no se sabe, quizá proviene de un golpe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a602" ANNOTATION_REF="a330">
                <ANNOTATION_VALUE>Ese...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a603" ANNOTATION_REF="a334">
                <ANNOTATION_VALUE>Y otras personas dicen que eso pasa cuando uno se cae y se golpea la cabeza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a604" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>Pues de esa forma siente uno el dolor en..., en el cuello y después avanza la enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a605" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>Sí, así es, y para eso esta hierba es muy buen remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a606" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>Es muy buena esta planta, no se da en cualquier lugar só..., sólo allá en el bosque en los arroyos, y no todas las personas conocen, nosotros la conocemos porque andamos siempre por ahí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a607" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>Pues vemos cuál es esa hierba a..., hay muchas hierbas pero no curan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a608" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE>Esa planta luego se conoce porque se da en la superficie de los riscos,  son muy chiquitas y sus flores son de color blanco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a609" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>Tiene cinco o seis hojas la mata más grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a610" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>Eso es ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a611" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>Pues eso es lo que yo he visto, nosotros como hemos buscado lo sabemos así ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a612" ANNOTATION_REF="a354">
                <ANNOTATION_VALUE>Así como andamos, le andamos cortando dos o tres hojas para juntarlas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a618" ANNOTATION_REF="a356">
                <ANNOTATION_VALUE>Para juntar un tanto así, no se puede traer mucho, porque es escasa la planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a619" ANNOTATION_REF="a358">
                <ANNOTATION_VALUE>Es muy poquito, yo sí lo creo porque se van cortando de tres o cuatro hojas y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a620" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>a la mata se le va dejando siquiera una hoja para que siga creciendo. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a621" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>Son muy chiquitas, son chiquitas y también se debe calcular bien cuando se le da de tomar al paciente, al regresar de ir a cortarlas uno machaca las hojas, se prepara y se..., se le da de tomar al niño o hasta los adultos pueden tomar. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a642" ANNOTATION_REF="a366">
                <ANNOTATION_VALUE>Actualmente esa planta, esa pla...., la buscan muchas personas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a643" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>Buscan las personas y preguntan por la planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a644" ANNOTATION_REF="a370">
                <ANNOTATION_VALUE>Preguntan las personas acerca de la planta y quieren saber a donde  se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a645" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>Pues a veces uno no sabe , como otras personas lo..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a646" ANNOTATION_REF="a372">
                <ANNOTATION_VALUE>Vienen de allá abajo y preguntan,uno no sabe si por allá haya también esas plantas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a647" ANNOTATION_REF="a373">
                <ANNOTATION_VALUE>Por ahí en Ahpa:sa:t, todo por allá en Xa:ltipan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a648" ANNOTATION_REF="a376">
                <ANNOTATION_VALUE>No hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a649" ANNOTATION_REF="a378">
                <ANNOTATION_VALUE>Pues por allá se da porque caen las brisas, como si estuviera fres..., fresco el lugar. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a650" ANNOTATION_REF="a379">
                <ANNOTATION_VALUE>En todo el tiempo está fresco porque está brisando. Las brisas salen como si fuera humo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a651" ANNOTATION_REF="a381">
                <ANNOTATION_VALUE>Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a652" ANNOTATION_REF="a382">
                <ANNOTATION_VALUE>Las brisas que caen son las que les dan vida a las plantas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a653" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>Pues eso es todo lo que yo te..., te he platicado, es lo que sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a654" ANNOTATION_REF="a388">
                <ANNOTATION_VALUE>Pues se da muy poquito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a655" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>Pues. Y pues, yo también lo..., es todo lo que conozco, ahora que nos encontramos aquí platicamos de...., como andamos en los bosques pues se buscan las plantas que curan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a656" ANNOTATION_REF="a395">
                <ANNOTATION_VALUE>Pues para mí también es todo lo que conozco, te..., te platiqué.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a657" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a658" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>Puedes decirme tu nombre y de donde vienes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a613" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>Pues yo me llamo Anastacio Nicolás Damián, también vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
