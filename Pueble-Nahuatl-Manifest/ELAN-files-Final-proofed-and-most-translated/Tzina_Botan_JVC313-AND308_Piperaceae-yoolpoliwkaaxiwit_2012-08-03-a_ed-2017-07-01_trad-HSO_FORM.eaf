    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>¿De cuál hierba me hablas, cómo le llamas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Yo:lpolihpahxiwit o cómo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>A pues ésa hierba la conozco poquito porque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>este ésa hierba se da en donde hay agua, donde hay sombra en un lugar fresco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>sobre los riscos en donde cae el agua y hay humed..., humedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Ahí se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Pero no hay, no hay en cantidad como otras hierbas. Ésa planta es muy escasa. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Y este se..., crece sobre los riscos, ahí se dan las plantas pero muy poquitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>La mata más..., más grande que se da tiene cuatro hojas, si tiene cinco hojas ya es una mata con muchas hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Pero por lo regular la mata sólo tiene tres hojas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>y muy chiquitas, son chiquitas, se parecen a las hojas de tsiwahkal, ko:..., a las hojas de kowtsiwahkal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Pero esas hojas son más grandes, así este..., son un poco más alargadas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>son más alargadas y en el..., el..., haz tienen así como nervaduras y son..., en el haz de las hojas tienen nervaduras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Y las hojas de yo:lpoliwka:xiwit se usan para curar a una persona que pierde la memoria o a una persona que..., le dan ataques</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Ee le..., le..., le..., dan de tomar en té y otra parte la usan para bañar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Pero cuando le dan de tomar al paciente no, no le dicen qué es, o qué hierbas van a hervir, no le dicen "te van a curar", no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Les dan, les..., les dan de tomar a los pacientes y no, no lo..., no dicen qué es ésa medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Y ta..., también cuando bañan al paciente no le dicen de qué planta es el agua que preparan, sólo ba..., bañan así a la persona enferma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>Pues la persona que está mal de la memoria ni siquiera sabe con qué la bañan pero las personas que tienen ataques como usted me platica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>No debe saber con qué lo están bañando, deben revolver bien las hierbas cuando las hierven pero no deben decirle al paciente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Así pa..., para que el remedio haga efe..., efecto, si porque si el paciente supo antes que lo van a curar no le hace efecto remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Eso se hace de forma confidencial. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>Debe ser confidencial, no, no se puede anticipar con qué lo van a curar al paciente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Y así como te he dicho, la planta no tiene muchas hojas, sus hojas son alargadas y un poco, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>en el haz de las hojas son lisas con pequeñas nervaduras y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>en el envés tienen rayas as..., así a lo largo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Las flores brotan al pie de las hojas que van creciendo hacia arriba, las plantas crecen a la altura como la palma de una mano (como diez centímetros). Sólo crece de este tamaño.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>Así florecen las plantas con flores pequeñas de color blanco, no tienen un color fuerte sino que también tienen un color amarillo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a435" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>Esa planta se..., se ve como si fuera un vejuquito, crece su flor hacia arriba, crece así en forma vertical.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a437" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>Ahí florece pero sus semillas son chiquitas, no, ni siquiera se pueden ver sus..., sus florecitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a438" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>No. no, no se pueden ver son chi..., muy chiquitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a439" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>Así es, no se sabe cómo son sus flores porque son muy..., muy pequeñitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a440" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>Así es, no se sabe cómo son sus flores pero creo, no conozco sus semillas, nunca veo cómo son pero sus flores las conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a441" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>Son de color un poco amarillas con blanco y son muy chiquitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
