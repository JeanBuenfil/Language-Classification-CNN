        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>Pos ne:wí:n kalan mah se: kichi:wati oso mah se:, se: mota:ti, se: kwa:lkwi ne:,</ANNOTATION_VALUE>
