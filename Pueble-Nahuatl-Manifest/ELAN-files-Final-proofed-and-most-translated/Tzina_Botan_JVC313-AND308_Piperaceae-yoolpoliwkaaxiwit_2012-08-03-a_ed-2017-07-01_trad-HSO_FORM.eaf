        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>ne: se: kwa:lkwi, se:, se: *imorra:l** wa:n ne:wí:n mah se: yowi.</ANNOTATION_VALUE>
