        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>ma:ski ke:meh ekintsi:n teh tikihtowa ampo:wi:n a:mo se: kahsis ampo:n ate:nte:n, mah se: ne:nemiti nika:wí:n, nika:wí:n Pano:lo:ya:n, nika:n Tahchikteko ihkwí:n nochi mah se: nemiti, a:mo se: kahsis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Nochi nika:wí:n Atmona:miki, a:mo se: kahsis, ta: se: kahsi, ta: yo:n se: kahsi ompa ne:wí:n kowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
