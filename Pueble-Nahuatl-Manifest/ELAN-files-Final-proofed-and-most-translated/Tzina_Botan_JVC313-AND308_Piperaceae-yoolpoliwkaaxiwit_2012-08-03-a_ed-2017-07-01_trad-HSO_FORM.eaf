        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>*Porque** yehwa nijó:n xiwtsitsí:n, seki de n' kimattokeh ne:n ke:meh i:n se: mo..., monohno:tsa se: kimattok ke i:n kwali pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Pos no: te:iliah oso tiowih tikwitih pos ma:ski wehka se:, se: 'kwiti *porque**</ANNOTATION_VALUE>
