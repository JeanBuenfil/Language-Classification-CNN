        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Nio:nó: se: kino:tsas ne:n ina:nahtsi:n ihkó:n ta: se: yehwa ne: se: kimattok ka:ni se: kichi:was, sayoh se: ki...,</ANNOTATION_VALUE>
