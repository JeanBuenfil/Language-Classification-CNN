        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Pero yo:n kinimakah a:mo, a:mo kiliah toni yo:n, toni yo:n kinimakatih, a:mo kihtowah mitspahti:tih, a:mo.</ANNOTATION_VALUE>
