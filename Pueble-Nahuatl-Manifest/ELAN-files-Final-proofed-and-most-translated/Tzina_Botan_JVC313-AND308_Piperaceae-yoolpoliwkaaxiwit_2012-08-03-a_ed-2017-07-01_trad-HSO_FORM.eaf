        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>se: 'kwiti a ne:n tonika se: kimolo:nti:s wa:n se: kipante:ma ya wa:n se:, *después** de se:wi a pos se: kinimaka ya ne:n, ne:n kone:t tein achi mokokowa.</ANNOTATION_VALUE>
