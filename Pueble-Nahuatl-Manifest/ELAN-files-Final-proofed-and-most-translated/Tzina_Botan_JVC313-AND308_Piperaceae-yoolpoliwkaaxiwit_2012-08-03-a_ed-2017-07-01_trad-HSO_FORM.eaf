            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>Yo:n kihto:sneki yo:lpoliwi, tehwa:n tikiliah yo:lpoliwixiwit *porque** yo:n eliwis se:, se: eliwis se: mo..., motehtetsi:lowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Se: kwa:talka:wa yo:n seki, a:mo se: kimati ma:ski se: nentinemi ihkó:n *cuando** se: pe:wtiki:sa ika yo:n ke:meskia kokolis pos ne:nke:n se: kimachilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n ma:ski ka:sá: ika tia:skeh, seko tapahti:lo:ya:n, pos a:mo te:na:miki.</ANNOTATION_VALUE>
