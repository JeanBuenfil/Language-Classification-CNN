        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>Yehwa nijó:n ne: te:na:miki, nijó:n kihtowah yo:n xiwit, yo:n pos no: seki tikchi:wah tikma:xakwalowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>wa:n seki, ne:n, t'manah pero yo:n tsikitsi:n a:mo .... Ihkwi:ntsi:n se: kite:mowa, ye:ktsikitsi:n moka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Wa:n yo:n, yehwa yo:n ika te:xakwalowah, seki se:, se: tai.</ANNOTATION_VALUE>
