        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Wa:n nejó:n, yo:n nejó:n kwaltia para a:kin yo:n tahtalka:wa, pos a:kin yo:n kihtowah ke m..., a:kin yo:n mihmiki no:.</ANNOTATION_VALUE>
