        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Pos yo:n *cuando** teyo:le:wah no: mah se: 'kwiti yo:n xiwtsí:n.</ANNOTATION_VALUE>
