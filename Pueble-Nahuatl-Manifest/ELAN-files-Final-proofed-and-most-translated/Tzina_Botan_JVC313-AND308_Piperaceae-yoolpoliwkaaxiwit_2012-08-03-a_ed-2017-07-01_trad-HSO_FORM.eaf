        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Wa:n pos kwaltsi:n no: xoxoktik mochi:wa n' a:tsi:n.</ANNOTATION_VALUE>
