        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Nejó:n mah a:mo kimati tonika ma:ltia, mah kwali kita:li:ka:n xiwtanelo:loh pero mah a:mo kili:ka:n ton ompa yetok seki.</ANNOTATION_VALUE>
