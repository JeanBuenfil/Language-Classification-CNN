        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>pos paniá:n de n' tet ompa mokehketsa nijó:n wa:n kwaltsi:n, ne:n, ista:k ixo:chio.</ANNOTATION_VALUE>
