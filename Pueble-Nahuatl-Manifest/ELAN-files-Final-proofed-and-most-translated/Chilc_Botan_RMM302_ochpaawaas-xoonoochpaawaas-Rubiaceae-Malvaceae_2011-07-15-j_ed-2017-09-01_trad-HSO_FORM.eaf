        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>Iwkitik, iwkitik ke:meh ne:n okseki xo:chit de n' ochapa:wa:s. Ta: yehwa, yehwa *m...**, yehwa, yehwa *casi** yehwa, *igua...**, ihkó:n, ihkó:n iwkitik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts430">
