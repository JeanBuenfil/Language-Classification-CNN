        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>Wa:n n' oksé: yehwa n' tein neh nimitsilia,</ANNOTATION_VALUE>
