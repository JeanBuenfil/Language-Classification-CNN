                <ANNOTATION_VALUE>Por..., teh tikmattok kwali, ne:n, n' ochpa:wa:s tein tikihtowah tehwa:n xo:no:ochpa:wa:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
