    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Miguel Gorostiza Gabrioto" PARTICIPANT="Miguel Gorostiza Gabrioto" TIER_ID="MGG Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Mm. El &lt;i&gt;kantsili:n&lt;i&gt; crece en el monte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
