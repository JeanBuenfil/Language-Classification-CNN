        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Ke:mah, ento:s iwa:n se: ki..., kipante:miliah ya wa:n iwa:n kimanah.</ANNOTATION_VALUE>
