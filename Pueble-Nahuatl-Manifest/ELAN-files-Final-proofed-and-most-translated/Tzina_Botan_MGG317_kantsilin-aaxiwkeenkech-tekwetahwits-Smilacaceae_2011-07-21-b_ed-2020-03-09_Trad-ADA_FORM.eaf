        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>A:xiwke:nkech, a:mo, a:mo semi se: kikwa. Ke:mah, yo:n a:mo.</ANNOTATION_VALUE>
