            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>Neh no:, neh no:, no: ompa niyow, ompakawí:n ne: nimitste:yaka:na tepitsi:n *porque**</ANNOTATION_VALUE>
