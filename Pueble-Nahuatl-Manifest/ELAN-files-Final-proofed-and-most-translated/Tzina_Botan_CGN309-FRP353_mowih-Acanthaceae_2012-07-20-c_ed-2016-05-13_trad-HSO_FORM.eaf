        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Miak ki:xmatih m' pahti katí:n para ika se: pahtis wa:n se:sepatika: n' teha:n</ANNOTATION_VALUE>
