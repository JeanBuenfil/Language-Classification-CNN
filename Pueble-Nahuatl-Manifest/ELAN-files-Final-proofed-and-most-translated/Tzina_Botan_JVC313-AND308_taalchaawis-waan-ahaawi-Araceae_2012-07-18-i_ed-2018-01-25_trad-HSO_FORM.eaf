        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a677" ANNOTATION_REF="a376">
                <ANNOTATION_VALUE>Pero el ta:lcha:wis nunca veo que tenga flores o produzca frutos, nunca lo veo. Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a678" ANNOTATION_REF="a378">
                <ANNOTATION_VALUE>Nun..., el ta:lcha:wis nunca veo que tenga sus flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a679" ANNOTATION_REF="a380">
                <ANNOTATION_VALUE>A, pero el ah..., aha:wi si he visto cómo florea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a680" ANNOTATION_REF="a382">
                <ANNOTATION_VALUE>No se..., no se le pone mucha atención.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a681" ANNOTATION_REF="a383">
                <ANNOTATION_VALUE>No se ve el hijuemala, pero si hay plantas que nunca florean.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a682" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>Hay plantas que se arrastran en el suelo y otros árboles que no florean, siempre se..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a683" ANNOTATION_REF="a385">
                <ANNOTATION_VALUE>retoña pero su..., el bejuco o el tallo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>Hay algunos ár..., mu..., muchos tipos de ár..., ár..., de cultivos que nunca dan flores y no producen frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a688" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>Y hay algunos que florean pero no producen, no dan..., dan frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a689" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>Sí, como la flor de asalea,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a690" ANNOTATION_REF="a390">
                <ANNOTATION_VALUE>brotan las flores pero nunca producen frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a691" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>No..., no..., no produce frutos, así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a692" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>Es pura flor, son puras florecitas. Son puras florecitas nada más, la flor se..., brotan las flores y se secan, se caen al suelo y ahí se acaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a693" ANNOTATION_REF="a395">
                <ANNOTATION_VALUE>No tiene nada de frutos o semillas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a699" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>No es igual, también será así</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a700" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>esa planta nunca vemos sus flores ni sus frutos, ni sus flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a701" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>Del ta:lcha:wis nunca vemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a702" ANNOTATION_REF="a402">
                <ANNOTATION_VALUE>Esa plantita es medicinal. Es medicinal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a703" ANNOTATION_REF="a404">
                <ANNOTATION_VALUE>Es todo si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a406">
                <ANNOTATION_VALUE>Yo, mi, mi..., mi nombre es Ernesto Vázquez y vengo del pueblo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
