        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>seki a:..., xo:chit sah n' kite:maka pero a:mo kite:maka iteyo.</ANNOTATION_VALUE>
