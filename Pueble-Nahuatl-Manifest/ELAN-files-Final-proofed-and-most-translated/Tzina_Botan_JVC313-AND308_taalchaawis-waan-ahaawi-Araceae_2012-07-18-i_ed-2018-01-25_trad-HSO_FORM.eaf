            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Y se..., tiene una capa delgada como las bracteas que tiene el plátano, así como se cuelga hacia abajo el racimo de plátano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a160">
