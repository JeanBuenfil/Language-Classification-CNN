        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>de nika:n timonohno:tstokeh pos timomakah *cuenta** ke:ní:w m' para</ANNOTATION_VALUE>
