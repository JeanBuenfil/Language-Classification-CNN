            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Esa si he visto cómo flor..., el aha:wi, aha:wi. Este el aha:wx..., ah..., el ah..., las flores del aha:wi, su..., sus flores son,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
