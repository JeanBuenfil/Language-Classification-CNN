            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a445" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>y el este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>el que le llaman ta:lcha:wis.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>No es i..., no tiene las hojas iguales, sus hojas se parecen a las hojas del la planta de café.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>Pero como si fueran, acorazonadas, las hojas tienen forma de corazón.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Y también es medicinal para cuando una persona tiene una herida en el pie y se infecta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Se infecta la herida por..., den..., dentro y se cierra,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>entonces le..., ponen la hoja en la herida y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a451" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>después de fermentarse por dentro se abre la herida, ahí le...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a452" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>eso le..., por la savia que tiene la hoja le hace efecto a la herida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Y al día siguiente o al tercer día empieza a salir el pus que tiene la herida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Y ya sana la herida. Ese es el que le llaman ta:lcha:wis.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Sí y, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>esa planta nunca veo cuando florea, cómo son sus flores. Nunca veo. Siempre he visto el bejuco y las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
