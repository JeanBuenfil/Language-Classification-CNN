        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>wehwetstotinemi, ke:masá: e:win' yo:n kokot wa:n,</ANNOTATION_VALUE>
