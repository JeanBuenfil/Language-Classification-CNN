            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a509" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>Eso es lo que yo no sé cómo, yo nunca veo cómo son las flores del ta:lcha:wis.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Nunca veo, porque así cuando voy alguna parte siempre he visto que nada más tiene hojas y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a511" ANNOTATION_REF="a196">
