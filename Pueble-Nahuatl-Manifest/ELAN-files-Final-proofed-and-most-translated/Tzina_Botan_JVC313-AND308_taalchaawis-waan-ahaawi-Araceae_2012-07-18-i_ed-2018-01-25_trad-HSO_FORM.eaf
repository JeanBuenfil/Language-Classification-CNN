            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Es rojo y morado y por encima de la cáscara es de color amarillo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>Y por dentro tiene sus semillas, se le saca la capa delgada que tiene adentro, se le despega,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>después ya se puede comer, también es dulce, los animales también aprovechan para alimentarse de estos frutos como</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a177">
