        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a514" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>Se extiende sobre las piedras o en el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>Sí, eso es y es bueno para curar al..., alguna,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>cuando uno se..., si uno tiene una herida en el pie, se pega un pedazo de hoja en la parte afectada y ayuda a sacar el pus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>Sí, pero lo que hace efecto es la savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a518" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>También tiene savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a519" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>Sí, es blanca la flor, es de color blanca la savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a520" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>Es blanca y la hoja se le pega a la herida, ayuda a abrir la herida para que salga el pus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a521" ANNOTATION_REF="a209">
