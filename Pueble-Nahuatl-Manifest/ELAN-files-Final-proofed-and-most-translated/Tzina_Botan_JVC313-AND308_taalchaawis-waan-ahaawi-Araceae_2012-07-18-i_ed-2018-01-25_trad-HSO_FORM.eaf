        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a674" ANNOTATION_REF="a381">
                <ANNOTATION_VALUE>Pues también son bonitas, só..., sólo que no nos fijamos pero sí han de ser bonitas.</ANNOTATION_VALUE>
