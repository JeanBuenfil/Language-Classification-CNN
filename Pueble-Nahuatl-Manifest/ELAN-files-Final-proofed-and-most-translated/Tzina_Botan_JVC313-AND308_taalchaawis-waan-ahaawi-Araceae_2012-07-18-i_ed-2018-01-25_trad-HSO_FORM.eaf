        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Kikwah ta: pos ne: iteyotsi:n kwe:l..., kwelitah, mopehpeniah.</ANNOTATION_VALUE>
