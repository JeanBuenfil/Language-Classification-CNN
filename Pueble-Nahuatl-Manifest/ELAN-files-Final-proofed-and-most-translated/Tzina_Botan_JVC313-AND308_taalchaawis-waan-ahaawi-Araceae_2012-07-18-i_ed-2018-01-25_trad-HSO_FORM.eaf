            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>Sí, eso es. No se..., se..., esa planta se da en cualquier parte, se da en la pied..., en donde sea, en el suelo o en la superficie de las piedras o </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a513" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>en la superficie de los troncos, el ta:lcha:wis se extiende.</ANNOTATION_VALUE>
