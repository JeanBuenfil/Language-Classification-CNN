        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>¿Wa:n ki:niwki n' ixo:chio ne:n aha:wi nijí:n?</ANNOTATION_VALUE>
