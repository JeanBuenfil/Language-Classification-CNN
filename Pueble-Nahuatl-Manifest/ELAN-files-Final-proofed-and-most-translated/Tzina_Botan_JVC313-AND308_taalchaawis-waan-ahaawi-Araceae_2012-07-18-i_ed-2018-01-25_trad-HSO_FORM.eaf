            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Eso es. Y por encima tiene como si fuera una cáscara,</ANNOTATION_VALUE>
