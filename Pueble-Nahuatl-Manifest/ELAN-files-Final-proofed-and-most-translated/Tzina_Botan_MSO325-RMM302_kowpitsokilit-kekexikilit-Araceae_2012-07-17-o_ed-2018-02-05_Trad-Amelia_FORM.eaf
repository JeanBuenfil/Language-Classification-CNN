        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Pos *mismo** yehwa s....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Ke:mah, *mismo** yehwa se: kita, nochi iwki, nochi iwki sah, de pisi:ltik wa:n tein wehwei nochi iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Ke:mah, pero neli nejó:n i:pa iwki neh neli no:, no: nikita neh neli yehwa tein, de yo:n tsikitsitsi:n wa:n yehwa n' tein wehwei pa:pata:wak mochi:wa neli ye:kwehwei mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>Pero neli nejó:n pos kwal..., kwaltia neli n..., mah se: kimana, we:lik ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>A:mo, ta: ikowyo, ne:n, ki:sa ne:n cho:kil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Wa:n yehwa neli yo:n kihtowah iwki te:chi:wa neli te:te:nkokoh, kihtowah a:mo no: te:te:nkoko:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>pero mah ye:k..., [ye:k]miak nejó:n, mah, mah miak nejó:n se: kita:lili, nejó:n mah koko:ya kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>Iwki kihtowah no: a:mo, a:mo teh te:chi:wili:s pero mah ye:kkoko:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Nochi iwki sah we:lik, ke:meh pisi:ltik wa:n yehwa n' tein wehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Pos neh n'mattok *que** we:..., *que** i:pa, i:pa yehwa no: para, para se: ki..., se: kikwa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Wa:n no: kwali kihtowah seki para pahti komo yo:n teihsá: se: mochi:wilih, yo:n se:, teihsá:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>te:kwik oso se: kokotsi:ni oso yo:n ye:kposo:ni kihtowah *que** kwali mah ika se: mometspi:ki wa:n no: patsa:waya ka:mpa yo:n komo se: nejó:n titi:katok se: imets te:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>wa:n mah ika se: kipi:ki nejó:n no: patsa:waya n' kihtowah *que** mah yehwa ika se: mometspi:ki, yo:n tein tsi:tsikitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Ke:mah, neh n'mattok *que** yehwa yo:ni n' kwali para pahti no:, mah ika se: mo..., mah ika se: ki..., mah se: kipanta:li se: ka:mpa yo:n titi:katok se: i..., se: imets</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>wa:n ika tilmah mah se: kipi:ki wa:n no: pachiwi. Ke:mah, neh iwki yo:n nikmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>Ke:mah, patsa:waya de yo:n poso:ni, ke:mah pero tehwa:n neli n'mattok neh i:pa nika:kakilia:ya note:iskaltihka:w *que** a:mo, tehwa:n a:mo tikwetowa:yah, iwki sah tikwiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>ke:meh yo:n neli nejó:n mah iwki se: mot..., mota:lili, iwki sah, ke:meh yo:n 'tekiti:wih wa:n mah se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>mah se: mota:lili a ka:mpa poso:ntok wa:n neli pachiwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Ke:mah, kihtowah *que** pos *de que** titika:tok kihtowa momets, a:mo pahti, *mejor** mah yeh t'ta:lili:ka:n, neli tikwiah yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Ke:mah, ke:meh yo:n teihsá: kokot oso yo:n se: mometskoko:s wa:n we:iti, ye:kposo:ni pos kwaltia ika se: mometspi:ki yehwa yo:n xiwtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>Ke:mah, yo:n neli no: kwali, ke:mah para a:okwilimeh no: kwali neli kihtowah *que** mah yehwa yo:n se: mota:lili de yo:n ikowyotsi:n, ox mah se: 'kawa:nti wa:n ke:mah mah se: kitahtati ika se: imets, yo:n no: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Ke:mah, i:pa nejó:n neli kihtowah *que** no: kwaltia yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Ke:mah, *porque** ke:meh i:pa no: ahwayoh yeh te:tamati:lih *porque** neli *cuando** yo:n te:kwih yo:n a:okwilimeh ye:kahwayowa se: imets, a:mo se: taxi:kowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Wa:n neli ata se: kitahtatia, nejó:n, te:na:miki. Ehe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>A:mo, ta: nochi, nochi kwaltia. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>Ke:mah, *porque de que** a:mo, a:mo onkaya toni n' kikwiskeh yehwa ka, yeh ka nejó:n kikwiah neli n' kihtowah yehwa yo:n xiwtsi:ni ta: neli nochi kwaltia ya para yehwa yo:ni wa:n komo a:mo yehwa ya n' ke:meh yo:n komo yo:n telto:na no: kwali se: mokwa:ta:lilia *porque** no: te:pale:wih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Ajá, ke:mah, ne: ke:man kikwiah yehwa n..., yehwa yo:n xiwit. Ke:mah, kwaltia ya n..., de nochi, ta: onkak neli ye:kwehwei mochi:wa wa:n te:pale:wih no: n' kihtowah *que** te:pale:wia:ya *porque** pos neli ne: ke:man a:mo onkaya toni se: kikwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>A:, pos ekintsi:n a:mo iwki ok ke:meh ne: ke:man katka *porque** ne: ke:man neli pos ka:n, ka:n iwki yehwa:n tota:tahwa:n *cuando** tehwa:n te:chiskaltihkeh nikilia neh a:mo iwki katka pero a:man nochi taman ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>Ke:mah. Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Sepa n..., ke:mah wa:n sepa mo:stika pos sepa se: kitekih *porque** pos a:mo se: kikowtok. Ke:mah. Ehe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Wa:n ika se: kwahkalowa ya n' a:t wa:n se: tai a ika n' a:tsí:n. Ke:mah. Ke:mah, yo:n no: nikitak ok neli, ke:mah ta: neli n' ke:meh yo:n ka:mpa onkaya oso ka:mpa se: a:me:yaltsí:n ke:meh yo:n pos kwaltsi:n ika se: kikwi:kwi *porque** yo:n tsi:tsikitsi:n, kwaltsi:n ika se: kikwi n' a:tsí:n wa:n se: ta:i a ika *mismo** yehwa xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>A:mo ke:meh a:man nochi onkak ke:meh ne: yehyetok nejó:n nochi yehwa ya mah ika se: tai a:tsí:n, ekintsi:n a:mo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>*porque** n' ekintsi:n pos, nejó:n, nochi *plástico** ya, pero ne: ke:man a:mo tei katka. Ke:mah eh, yehwa katka. Ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>A:mo teihsá:, neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
