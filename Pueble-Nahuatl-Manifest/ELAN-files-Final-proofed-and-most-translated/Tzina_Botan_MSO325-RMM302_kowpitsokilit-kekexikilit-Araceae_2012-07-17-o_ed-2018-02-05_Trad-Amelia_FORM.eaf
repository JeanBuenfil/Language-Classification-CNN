                <ANNOTATION_VALUE>Pero ekintsi:n ompa pané: a:mo tei ok, no: pané: poliwik a, pero ka:sá: ika onkak pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
