        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>porque yo sé que cuando lo limpian no tiene porque llevar los nervios de la hoja, porque si lleva esos nervios es lo que provoca el comezón en la boca.</ANNOTATION_VALUE>
