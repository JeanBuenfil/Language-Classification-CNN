        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Ke:mah, kihtowah *que** seki ne:li te:te:nahwayo:tih pero a:mo nochi *porque** neh n'mattok ka:mpa ya a:cha:wit ompa kihtowah *que** ye:kwe:lik yo:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
