        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Entó:s de pe:wa mi:..., mi:to:nia ma..., mahyá:, *este**, t..., tikihtowah n' tehwa:n ma:..., taneki:sa yo:n poso:n..., poso:ntok.</ANNOTATION_VALUE>
