        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>al que le llaman kwopitsokilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Aquí yo lo conozco como..., le llaman kwopitsokilit, yo sabía, yo sé que tiene dos nombres, como kwopitsokilit y kekexikilit,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>pero yo veo que todos son iguales, son parecidos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>Solamente dicen que,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>el kwopitsokilit uno crece (con hojas) más pequeñas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>Y otro que le llaman kekexikilit es el de las hojas anchas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>Pero yo veo que son parecidas, no sé exactamente en que se diferencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>Sí, es cierto, yo sé, allá donde</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>donde cuida el señor Miguel Loguente,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>ahí había bastante de ese quelite,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>y también había bastante aqui en A:tepoliwi, donde está la cueva, en la cueva, cerca de la entrada de la cueva, un poco arriba, nosotros ahí íbamos a cortarlas, ahí iban a traerlas mi..., </ANNOTATION_VALUE>
