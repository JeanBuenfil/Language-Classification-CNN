    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Rubén Macario Martínez" PARTICIPANT="Rubén Macario Martínez" TIER_ID="RMM Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Hay un tipo de hierba, se llama ma:talin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Ese, al que le llaman ma:talin, hay dos tipos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>Hay un blanco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>el que es de (hojas) grandes, y hay el ma:talin rojo y la flor es azul. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Pero te digo, que el que lo conocen como ista:kma:talin, al crecer, los tallos son más gruesos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>y las hojas son más grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Las hojas son alargadas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>y el tallo es más grueso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a127" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>y las flores son blancas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>son blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Ese, ese sirve, el ma:talin sirve, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>sirve para cuando uno se corta (hiere) con el machete.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Cuando uno se corta con el machete y que uno corte el tallo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>y que uno lo exprima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>En donde uno lo aplasta, sale ..., en el tallo sale como agua pegajosa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Esa (pulpa) pegajosa se le pone en la parte donde uno se ha cortado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Que se lo unte a uno en la parte que se ha cortado con el machete.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>Así también empieza a cicatrizarse, hace que cicatrice y va sanando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Poco a poco va cicatrizando, hace que se cure (la herida).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Y también es bueno para los animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Los puercos comen esta yerba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>Los pollos, los pavipollos también lo comen,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>las reses, los caballos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Todos, todos los animales comen esa yerba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>¿Porqué? Les gusta porque contiene mucha agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Y es muy bueno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>Y también, también sirve, ¿Sabes para qué? En donde es cafetal,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>a muchos les gusta porque es sueve para ..., es suave para cortar </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>y es muy ..., contiene bastante, bastante agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>En donde hay, en donde hay ese ma:talin,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>siempre hay bastante humedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>Y para el café es muy bueno, ¿Porqué? (El suelo) nunca se seca, sino que siempre está humedo, este. Entonces, este, dicen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>que (el suelo) es muy bueno para el café,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>o para siembra de maíz,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>porque, este, no, no, no, no le hace ningún daño al suelo, sino que le aporta más abono.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>Porque ese ma:talin, cuando empieza a pudrirse,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>una vez que ya se pudre el ma:talin, se convierte como abono, bueno se convierte en suelo pues.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>Y siembre hay ..., siempre hay humedad. Eso es lo que nosotros decimos ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>Otro, el que le llaman, el que le llaman, este, ma:pisi:lma:talin,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>la flor del pisi:lma:talin es azul.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>Es el mismo, es el mismo ma:talin, pero nosotros decimos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>que es diferente porque la flor es distinta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>y porque es más pequeño, por eso lo conocemos como pi:si:lma:talin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>Y ese también sirve para ..., solamente para los animales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>Para pollos, para pavipollos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>para puercos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>o para, este, las reses o caballos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>Pero que digamos que nos lo vamos a poner en una herida, en donde uno se corta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a169" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>pues en donde uno se corta que no se ..., ese no sirve porque no contiene este ..., como la hoja es muy delgada,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>pues no podemos decir que lo vamos a cortar y extraerle la savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>Nosotros le llamamos como savia por eso yo te digo, ese sale como,  como pegajosa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>Y, este, el que te digo que es blanco, ese sí tiene, pues son grandes y gruesos, entonces es como muy carnosa, por dentro contiene como carnita (pulpa de la hoja), así lo decimos, pareciera, pareciera como agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>Eso es, no sé, quizá tengas otra idea, tengas otra pregunta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>Ah, ese también es bueno para los cafetales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>Ese ma:pisi:ma:talin también sirve para los cafetales. Como en los cafetales,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>les gusta mucho porque al chapear,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>no es duro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>Y le ayuda mucho al café, al café, en nuestro cafetal, ayuda mucho, porqué?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>siempre aporta abono para el suelo, digamos, en materia orgánica, siempre hace que se desintegre la materia orgánica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>Pero eso, nosotros no lo sabemos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>ese ma:talin, el ma:talin, no podemos decir que es simplemente un ma:talin. Sabes de qué proviene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>Hay un tipo de zacate,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>Yo te lo voy a decir este saber porque yo he visto y me he dado cuenta y lo ví porque me lo había dicho mi abuelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>¡Vean! dice, les voy a decir cómo lo van a hacer, dice.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>¡Tumben! dice, ese, al que le llaman patachsakat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a186" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>Hay uno que le llaman patachsakat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>"¡Túmbenlo! dice, ¡chapeen y lo ..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>lo ponen en montón en un solo lugar. Lo ponen en un solo lugar", dice.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>"Y ahí se van a dar ..., ahí van a saber", dice, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>"qué crece, después qué tipo de hierba germina", dice.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>Ya no va a germinar el zacate, sino el ma:talin", dice.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a192" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>Y lo creí porque una vez así lo hice.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Chapeé, había bastante patachsakat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>y empecé a chapear y el zacate lo amontoné en un solo lugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Lo que pasó, lo que sucedió, lo que nació, en vez de descomponerse, en vez de que naciera el zacate,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>nació puro ma:talin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>Hasta ahí lo creí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>Pues ese ma:talin, nosotros decimos que es ma:talin, pero no es simplemente un ma:talin, crece como ma:talin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a199" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>sino que ese, se convierte. Lo que era zacate, era zacate, el patachsakat se convierte en ma:talin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Mm, y a quien, a quien uno quiera preguntarle, lo que, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>uno que ya es de mucho tiempo ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>hace tiempo, bueno un padre con edad avanzada pues.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>Es quien sabe mejor que nosotros. Porque yo ..., y lo creí, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>me lo contaba mi abuelito. Dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>Sabes qué, dice, "¡Ve el patachsakat!" dice,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>"donde hay bastante patachsakat y chapeas, dice, "y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>lo amontonas en un solo lugar" dice, "de pronto nace" dice, "el ma:talin" dice. "Y lo creí porque yo así lo hice, una vez ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>así lo hice. Dije, voy a chapear y voy a ver si acaso, acaso es cierto o no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Y lo que pasó, ciertamente, nació puro ma:talin,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>Pues fue cuando yo lo creí. El ma:talin nace del zacate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>Mm. No era ma:talin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Digamos que vamos a sembrar, este, la semilla </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>para que hagamos germinar, para que nazca el ma:talin. No es así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Ese ma:talin nace del patachsakat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>Mm. Eso es, eso es. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>¿Algúna otra idea, acaso hay otra pregunta?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>Sí, del zacate, del que le llamamos patachsakat, es el que se convierte en ma:talin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a239" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>Es el que se convierte en ma:talin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>Pero no solamente así, sino que se le chapea,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>Y ese, el patachsakat que se junte en un solo lugar, uno debe amontonarlo en un solo lugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>Tikololte:mati seko sah</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a243" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>y una vez que empieza a descomponerse el patachsakat,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>ya no crece el zacate, sino que ya nace el ma:talin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a245" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>Pero ese se convierte. Es el que te digo que el ma:talin proviene del zacate, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>del zacate. Mm, del patachsakat, eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>¿Solamente eso?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
