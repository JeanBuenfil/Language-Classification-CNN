        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>ke:meh name:chilia n' chichime:koh i..., ikowyo,</ANNOTATION_VALUE>
