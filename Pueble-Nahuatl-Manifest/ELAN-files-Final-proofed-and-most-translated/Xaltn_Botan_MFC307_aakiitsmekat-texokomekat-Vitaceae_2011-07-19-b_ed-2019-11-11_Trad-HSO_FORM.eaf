        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>Ika tamah..., ta..., tamahse:wah ya no: n' okwiltsitsí:n. Uhuh.</ANNOTATION_VALUE>
