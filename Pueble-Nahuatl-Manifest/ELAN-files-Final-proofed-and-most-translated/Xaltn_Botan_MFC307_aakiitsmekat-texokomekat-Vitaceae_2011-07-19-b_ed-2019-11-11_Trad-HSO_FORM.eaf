            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Pero ne:n xiwtsí:n yo:n a:mo teh *servi:rowa** nió:n tei.</ANNOTATION_VALUE>
