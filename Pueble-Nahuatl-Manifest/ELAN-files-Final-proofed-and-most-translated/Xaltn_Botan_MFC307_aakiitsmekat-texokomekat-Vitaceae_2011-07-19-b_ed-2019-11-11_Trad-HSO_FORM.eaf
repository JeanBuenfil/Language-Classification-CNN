            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>iwki ihkó:n mochi:wa n' iteyo, se: malakachtsí:n no:.</ANNOTATION_VALUE>
