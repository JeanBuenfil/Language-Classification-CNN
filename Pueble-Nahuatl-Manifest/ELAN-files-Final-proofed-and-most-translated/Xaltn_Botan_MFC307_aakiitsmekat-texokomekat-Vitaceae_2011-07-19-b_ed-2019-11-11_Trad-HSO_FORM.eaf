        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Pero e:..., ma:ski ixiwyo *o** ma:ski ne: ikomekayo,</ANNOTATION_VALUE>
