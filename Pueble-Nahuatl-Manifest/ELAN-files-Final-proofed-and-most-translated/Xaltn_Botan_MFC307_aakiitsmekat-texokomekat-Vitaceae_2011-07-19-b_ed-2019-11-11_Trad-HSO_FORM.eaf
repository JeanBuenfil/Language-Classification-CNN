        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>i:pa a:mo, i:pa a:mo wetsi, ne:n, xo:chitsí:n para mah, mah a:mo mochi:wa n' iteyo.</ANNOTATION_VALUE>
