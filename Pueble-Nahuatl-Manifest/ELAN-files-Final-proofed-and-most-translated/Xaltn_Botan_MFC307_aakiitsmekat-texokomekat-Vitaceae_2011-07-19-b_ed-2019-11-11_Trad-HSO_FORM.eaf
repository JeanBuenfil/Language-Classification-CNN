        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>I:pa a:mo nikihto:s wehka ne:chpolo:s.</ANNOTATION_VALUE>
