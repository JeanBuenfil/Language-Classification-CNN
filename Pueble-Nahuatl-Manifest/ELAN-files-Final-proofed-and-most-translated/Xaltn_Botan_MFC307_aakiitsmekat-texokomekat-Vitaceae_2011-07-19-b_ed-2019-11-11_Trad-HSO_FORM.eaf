        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>pero kipia *que** mitsna:mikis, *porque** ke:yeh, i:pa pahti.</ANNOTATION_VALUE>
