        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Mahyá: yo:n ne: kapolin de, ne:n, yo:n ixta:wat mochi:wa.</ANNOTATION_VALUE>
