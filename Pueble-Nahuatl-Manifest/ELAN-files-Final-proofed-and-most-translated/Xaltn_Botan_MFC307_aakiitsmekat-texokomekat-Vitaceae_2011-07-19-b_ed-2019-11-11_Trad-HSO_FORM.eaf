        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>ista:k kwitakowit iteyo, *cuando** selik ihkó:n no: n' iteyo ne:. Uhuh.</ANNOTATION_VALUE>
