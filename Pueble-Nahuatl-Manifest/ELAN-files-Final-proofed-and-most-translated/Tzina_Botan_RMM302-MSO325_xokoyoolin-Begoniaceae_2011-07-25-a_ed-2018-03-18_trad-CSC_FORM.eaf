    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Rubén Macario Martínez" PARTICIPANT="Rubén Macario Martínez" TIER_ID="RMM Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>Este disculpame señora ero te quería, quiero preguntarte cuantos tipos de xokoyo:lin conoces?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>Yo nada más conozco dos, hasta tres tipos conozco. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>Quien sabe si a lo mejor tu sabes más de cuantos tipos de xokoyo:lin hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>Y el xokoyo:lin que se come el que es comestible ¿Cuál es y si es que lo conoces?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>Teko:seh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>Takwa:wakxokoyo:lin también le decimos así el que lo venden en la plaza de Cuetzalan, el que nos lo traen de la zona alta. A ya es el mismo. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>Y el que le dicen pa:tinixokoyo:lin ¿Nunca lo has comido?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Pues ahora yo te voy a platicar, donde no hay del que dices que lo compra uno, el takwa:wakxokoyo:lin y el </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>este el teko:seh,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>si se antoja mucho, mucho,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>ese que le llaman pa:tini también, también..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>también se puede comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>Nada más que es verdad como dice usted que se deshace muy rápido, por eso le llaman pa:tini porque si se hierve mucho y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>se pasa de fuego, queda como si fuera atole, se deshace mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>Pero también sabe muy rico, nada más que hay que ponerle sus condimentos y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>es como el ajonjolí y el que le llaman tekilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>Pues igual también sabe rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Si, también sabe rico pero donde no hay pues ya es lo que te digo que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>nosotros comemos. Yo lo sé porque ya lo he comido,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>una vez fui allá por donde no se da ese xokoyo:lin del que le dices takwa:wakxokoyo:lin y el teko:seh, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>este cuando lo encontramos los cortamos, porque vimos que había y pensamos cortarlos para que nos lo preparen, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>queriamos probar si sabe rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>Pero donde nosotros nos dimos cuenta que también sabe rico porque lo comimos y también tiene aroma como el xokoyo:lin comestible.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Y es donde nosotros nos dimos cuenta que también se puede comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>También es rico. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>No pues también sabe rico con el, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>frijol negro,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>o con el frijol gordo también sabe rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Nada más que como te digo que allá donde nosotros fuimos no conocen el frijol gordo, y tampoco conocen el tekilit, no conocen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>sus condimentos pues nosotros lo comimos nada más con puro ajonjolí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Nada más le habían molido ajonjolí y un poco de chile..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>eso le molieron y es lo que nosotros comimos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>Y también sabe rico frito. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Si, prepararlo frito. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Si, pues nosotros pensamos que como no había condimentos, entonces pues pensamos..,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>pedir que nos lo prepararan frito con aceite y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
