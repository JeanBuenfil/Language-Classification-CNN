        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Yo:n a:mo ke:man nikmahse:wak neh, ke:mah, tein i:pa tikmahse:wah yehwa, ne:n, teko:seh wa:n yehwa de, ne:n, seki xokoyo:lin.</ANNOTATION_VALUE>
