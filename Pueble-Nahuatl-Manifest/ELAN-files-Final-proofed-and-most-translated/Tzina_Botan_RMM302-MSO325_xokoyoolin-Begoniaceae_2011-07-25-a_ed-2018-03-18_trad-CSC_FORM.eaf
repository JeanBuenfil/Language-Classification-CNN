                <ANNOTATION_VALUE>Ta:taman, ta:taman se: kito:ka:ytia, ne:n, nejó:n xiwtsí:n tein se: kikwi pero pos neli, nejón, no: kipia ito:ka:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
