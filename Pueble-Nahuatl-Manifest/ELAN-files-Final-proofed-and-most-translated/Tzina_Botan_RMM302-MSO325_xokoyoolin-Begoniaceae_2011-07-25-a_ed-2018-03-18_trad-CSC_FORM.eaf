        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>¿Wa:n para ton pahti s..., para ton pahti kwaltia yo:n?</ANNOTATION_VALUE>
