                <ANNOTATION_VALUE>Wa:n no:, yehwa ya, ¿kita:lilihkeh no: *cebolla o** i:pa iwki sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
