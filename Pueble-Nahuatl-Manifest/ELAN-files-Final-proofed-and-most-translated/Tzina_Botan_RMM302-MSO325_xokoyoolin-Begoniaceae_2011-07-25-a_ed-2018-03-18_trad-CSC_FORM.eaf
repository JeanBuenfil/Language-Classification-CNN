        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Mm. Ke:mah, yehwa iwki neh nikilia. Ke:mah. Mm. Ke:mah.</ANNOTATION_VALUE>
