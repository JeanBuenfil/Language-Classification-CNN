        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>Pues yo solamente conozco del que le llaman teko:seh,</ANNOTATION_VALUE>
