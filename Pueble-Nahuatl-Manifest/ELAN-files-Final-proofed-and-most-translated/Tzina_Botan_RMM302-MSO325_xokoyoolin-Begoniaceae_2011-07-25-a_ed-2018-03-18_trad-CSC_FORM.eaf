                <ANNOTATION_VALUE>Ke:mah, *este** tehwa:n tiknemilihkeh de a:mo teh iahwia:kka katka pos tiknemilihkeh te:ch...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
