        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>te:kwa:nenepil tehwa:n tikihtowah. A:, yehwa yo:ni. Ajá. Ke:mah, ke:mah.</ANNOTATION_VALUE>
