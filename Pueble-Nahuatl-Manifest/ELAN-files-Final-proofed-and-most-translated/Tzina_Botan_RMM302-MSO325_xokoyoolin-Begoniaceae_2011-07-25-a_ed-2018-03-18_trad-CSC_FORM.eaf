        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>A:, no: we:lik. ¿Wa:n yo:n no: kichihchi:wah no: ke:meh i:pa se: kichi:wa iwa:n ne:n a:ko:li:n wa:n ti:ltiket *o** kati:yeski et?</ANNOTATION_VALUE>
