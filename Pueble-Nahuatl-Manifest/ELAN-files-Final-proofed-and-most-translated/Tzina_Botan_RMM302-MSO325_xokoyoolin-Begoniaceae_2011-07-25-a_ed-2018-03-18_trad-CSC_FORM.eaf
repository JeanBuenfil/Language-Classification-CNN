        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>y también del que platicábamos hace rato, del xokoyo:lin esquinado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>Y el que se da en los cafetales el que yo lo distingo que tiene mucha pubescencia,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>es ese xokoyo:lin de hojas redondas. Ese es el que también conozco. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>Y del que estaba platicando hace rato es uno que se da en el monte, también lo conozco, es de hojas chiquitas y se dan eractas en la tierra y sus tallos son negros, es del que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>nos estábamos acordando hace rato, le dicen kwitkowa:xokoyo:lin, así le llaman. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>El que se come es el tekoseh,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>y el otro, el otro, bueno, yo sé que me decía mi madre que hay otro que se llama takwa:wakxokoyo:lin,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>porque ese se puede hervir mucho y no le pasa nada, no se deshace y el teko:seh se deshace muy rápido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Si se calienta mucho el agua, se deshace muy rápido y del otro no es así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>Si, yo digo que es ese mismo. Si. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Ese nunca lo comí, si he comido del que siempre es comestible, el teko:seh y el otro xokoyo:lin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
