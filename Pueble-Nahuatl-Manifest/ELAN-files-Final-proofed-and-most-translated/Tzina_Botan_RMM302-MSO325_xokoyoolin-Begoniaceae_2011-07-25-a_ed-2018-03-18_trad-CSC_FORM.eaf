        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>A:, n' tatsoyo:n no: we:lik. A:, pos neli, pos neli para yo:n tikitas neh a:mo, yo:n a:mo ke:man tikmahse:wah pero pos</ANNOTATION_VALUE>
