        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Ke:mah wa:n onkak ata seki xokoyo:lin mokehketsa eliwis wehkapantik ata, *hasta** ih..., ihko:kó:n, wehwei, wehwei xokoyo:lin moketsa, sake:ra de...,</ANNOTATION_VALUE>
