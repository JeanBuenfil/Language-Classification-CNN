                <ANNOTATION_VALUE>A:mo ta: yehwa yo:n okseki, te:kwa:nenepi:l yo:n no: niki:xmattok i:pa iwki mono:tsa, nikihtohtok te:kwa:nenepi:l kilwiah. Eheh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
