        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>wa:n yehwa n' tein, tein seki t..., *bueno** neh n'mattok, nejó:n, ne:chilia:ya note:iskaltihka:w *que** kilia:yah seki yehwa yo:n takwa:wakxokoyo:lin,</ANNOTATION_VALUE>
