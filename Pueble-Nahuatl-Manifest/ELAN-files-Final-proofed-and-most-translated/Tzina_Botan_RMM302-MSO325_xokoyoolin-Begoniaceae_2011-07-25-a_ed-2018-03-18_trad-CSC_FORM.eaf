                <ANNOTATION_VALUE>Wa:n i:n tein tikihtowa wehkapan mokehketsa seki, neh a:mo niki:xmati kati:ni i:n iwki tikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>A: pos, a:mo, a:mo niki:xmati neh, a:mo niki:xmati. A:, pos a:mo niki:xmati neh, ke:mah, neh nik...,</ANNOTATION_VALUE>
