        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>sepa se: kichihchi:wa nikilia neh we:lik a, pos ta: tapalo:l ya mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>Ke:mah, pero neli nika:n neh nikmattok i:pa ihkó:n t'chi:wah neli yehwa yo:n nikihtowa teko:seh neli ihkó:n t'ta:liah yehwa n' a:ko:li:n wa:n iwa:n et tikmanah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>wa:n yehwa ya neli t'ta:liliah chi:l tikwe:choliah wa:n kwaltsi:n ahwia:k ki:sa de iwa:n yehwa yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>pero teh tikilia tekilit, neh ne:chkaki:ltia:ya note:iskaltihka:w nochipa kito:ka:ytia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Ne:chi:li:s, "Xikwiti ne:pa nejó:n yo:n nakasihwiyo mah mitsakaka:n", kihtowa, "¡xkowati!"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>Neh iwki ne:chilia:ya ne: note:iskaltihka:w katka, neh n'mattoya *que** iwki kito:ka:ytia:ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>pero neli seki nikakilia kito:ka:ytiah *que** nejó:n yehwa, ne:n, tekilit.</ANNOTATION_VALUE>
