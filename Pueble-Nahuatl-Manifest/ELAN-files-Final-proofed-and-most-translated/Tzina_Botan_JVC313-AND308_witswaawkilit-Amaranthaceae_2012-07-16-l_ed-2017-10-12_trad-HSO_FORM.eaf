        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>*de que** teyowa mi:xpilowa wa:n n' teyowa pampi:xowi wa:n wa:ki a de chika:waya, ne:n,</ANNOTATION_VALUE>
