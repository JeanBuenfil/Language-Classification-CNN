        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>Ka:mpa se: tato:ka, onkak kalts..., *o** kaltsi:ntan nijó:n ixwa.</ANNOTATION_VALUE>
