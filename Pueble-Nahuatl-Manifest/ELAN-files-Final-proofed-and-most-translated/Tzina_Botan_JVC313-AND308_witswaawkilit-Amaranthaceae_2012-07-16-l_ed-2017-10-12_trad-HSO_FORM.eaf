        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>*Puro** witsti.</ANNOTATION_VALUE>
