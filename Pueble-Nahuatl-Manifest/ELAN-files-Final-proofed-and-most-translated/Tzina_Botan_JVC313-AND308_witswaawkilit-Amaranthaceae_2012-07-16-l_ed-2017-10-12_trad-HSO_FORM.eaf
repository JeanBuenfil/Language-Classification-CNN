        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah, miak a m' po:le:wa.</ANNOTATION_VALUE>
