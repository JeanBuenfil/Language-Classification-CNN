            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>ne:n, kiltsí:n wa:n moka:wa, mochi:wa pahti a, de miak tanechiko:l ya,</ANNOTATION_VALUE>
