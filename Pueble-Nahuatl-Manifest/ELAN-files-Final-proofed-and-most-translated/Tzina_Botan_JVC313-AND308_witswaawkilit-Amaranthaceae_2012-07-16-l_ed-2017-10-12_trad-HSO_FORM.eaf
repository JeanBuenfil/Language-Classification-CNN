        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
