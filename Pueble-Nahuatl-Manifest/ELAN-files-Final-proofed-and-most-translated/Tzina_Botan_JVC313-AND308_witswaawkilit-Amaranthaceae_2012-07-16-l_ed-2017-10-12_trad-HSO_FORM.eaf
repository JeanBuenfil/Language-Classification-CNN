        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>pos a:mo no: kachi kika:wah kaltsi:ntan ka:mpa</ANNOTATION_VALUE>
