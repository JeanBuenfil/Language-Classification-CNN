        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Nijó:n iteyo kwaltsi:n *pisilitos**.</ANNOTATION_VALUE>
