            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>Pues se pone uno descolorido o sufre alguna otra enfermedad, no aguanta uno para caminar en una subida, </ANNOTATION_VALUE>
