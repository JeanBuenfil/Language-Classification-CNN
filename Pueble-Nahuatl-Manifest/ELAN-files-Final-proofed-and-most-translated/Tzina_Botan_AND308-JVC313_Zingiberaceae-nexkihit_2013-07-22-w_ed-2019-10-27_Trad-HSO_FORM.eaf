            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>Es caro, ahora si lo venden así aunque sea poquito es caro porque es muy, muy sabroso.</ANNOTATION_VALUE>
