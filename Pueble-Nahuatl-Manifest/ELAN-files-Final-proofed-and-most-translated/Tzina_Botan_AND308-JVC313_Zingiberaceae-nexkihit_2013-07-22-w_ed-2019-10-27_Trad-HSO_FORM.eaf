        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>porque son matas grandes las..., tengo allá en &lt;i&gt;Tamaya:n&lt;/i&gt; hay tres matas pero son muy grandes, se juntaba un costal cada vez que los cortaba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
