        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>Pos yehwa yo:n kwaltsi:n nochi se: ki..., ekintsi:n tine:chilihtok, no: tikmattok de yo:n nexkihit.</ANNOTATION_VALUE>
