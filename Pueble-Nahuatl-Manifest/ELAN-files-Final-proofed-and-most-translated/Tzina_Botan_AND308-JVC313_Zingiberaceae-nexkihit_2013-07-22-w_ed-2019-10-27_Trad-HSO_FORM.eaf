            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>a mi no me toca, para mi siquiera, como no vivimos ahí, cuando viviamos ahí nos tocaban los frutos, los..., los cortábamos</ANNOTATION_VALUE>
