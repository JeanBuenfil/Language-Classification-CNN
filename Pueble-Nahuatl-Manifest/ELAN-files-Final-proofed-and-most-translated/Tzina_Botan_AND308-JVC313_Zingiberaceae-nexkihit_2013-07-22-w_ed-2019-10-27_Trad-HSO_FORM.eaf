        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>No: ahwia:k ne:n [...]pero no: oksé: taman, no: kihtowah ke no: kwaltia para ki..., ki..., kikwih para ne:n taxkaltsi:n kit..., kitetsi:lowah, para pi:ksa pero a:mo nikma..., a:mo nikmati.</ANNOTATION_VALUE>
