        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Bueno pues, ahora que acá volvemos a vernos,  también lo..., te pregunto si conoces también el &lt;i&gt;nexkihit&lt;/i&gt;,</ANNOTATION_VALUE>
