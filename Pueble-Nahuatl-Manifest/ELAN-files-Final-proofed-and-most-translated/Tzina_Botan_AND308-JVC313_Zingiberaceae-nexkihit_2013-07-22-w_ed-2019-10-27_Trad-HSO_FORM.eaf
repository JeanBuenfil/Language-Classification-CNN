        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>Porque casi no voy y de que casi no voy pues este..., pero no se echan a perder, algunas personas lo van a traer y lo llevan a vender a Jonotla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Sí ahí la..., la venden. Ahí las van a traer, y las venden con buen precio porque este las..., las venden caro.</ANNOTATION_VALUE>
