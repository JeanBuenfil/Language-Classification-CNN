        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>Tienen un buen precio el hijo de la mala. Pues es muy sabrosa la comida preparada de esos frutos y las hojas no las comemos pero le dan un buen sabor a los tamales, salen muy sabrosos.</ANNOTATION_VALUE>
