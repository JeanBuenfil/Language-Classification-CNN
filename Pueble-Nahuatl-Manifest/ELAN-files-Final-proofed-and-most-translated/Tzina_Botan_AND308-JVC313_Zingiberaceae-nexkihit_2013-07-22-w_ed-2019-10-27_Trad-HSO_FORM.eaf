    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>A también quieres saber que acá nos encontramos otra vez.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>Pues es mu bonito andar encontrándonos porque platicamos si..., también es bonito que me preguntes si conozco esa planta de &lt;i&gt;nexkihit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>El &lt;i&gt;nexkihit&lt;/i&gt; también, también la conocemos porque se da por ahí,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>algunas matas las sembramos y otras nacen solas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>Germinan las semillas, este, algunas personas la siembran, algunas este, sus semillas son muy pequeñas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>y el &lt;i&gt;nexkihit&lt;/i&gt; es de un color rojo bonito, así se encuentra, creo que son su..., sus flores y se van produciendo los frutos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>pero los frutos cuando ya maduran se vuelven de color negro, son de color negro y se van partiendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>Y los frutos se, se, se cortan y se prepara una comida muy sabrosa, es sabrosa después de que la limpian,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>exprimen la pulpa y le van sacando las semillas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>y enseguida la hierven o..., si lo mue..., a veces muelen su..., la pulpa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>y sale muy buena la comida si lo muelen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>Y si no así lo echan dentro de la olla y la..., también sale muy sabrosa la comida. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>El &lt;i&gt;nexkihit&lt;/i&gt; es muy nutritivo y tiene un olor muy bonito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Le agregan las hojas que nosotros las llamamos pimienta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>le dan un buen olor. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Y este, hasta las ardillas y los armadillos también les gusta alimentarse de estos frutos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>Este no sé, parece que, todos se alimentan por ahí los arma..., levantan los frutos del &lt;i&gt;nexkihit&lt;/i&gt; cuando están maduros para alimentarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>Igual las ardillas y las aves &lt;i&gt;mohmotmeh&lt;/i&gt; también les gusta alimentarse de estos frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Y cuando ya maduran los frutos en todos santos en este mes y otros meses</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>pues se dan y en estos meses maduran. Maduran las semillitas del &lt;i&gt;nexkihit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Y el &lt;i&gt;nexkihit&lt;/i&gt; tiene las ho..., hojas así como paradas y son un poco anchas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>pues las hojas también se usan para envolver los tamales pintos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Así también las usan para ha..., prepararlas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>y las hojas este todas sirven. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Las hojas son muy aromáticas y las usan para envolver tamales cuando llegan los días de todos santos, dicen las personas que vienen los difuntos pues les preparan los tamales pintos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>Los envuelven y pre..., preparan los tamales que les llaman de frijol molido </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>usan las hojas para envolver los tamales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Esas hojas le dan un buen sabor a la masa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>Le dan un buen sabor, es muy sabroso el &lt;i&gt;nexkihit&lt;/i&gt; y es muy sabroso, hasta los pajaritos les gusta alimentarse de su..., de su..., de la pulpa y su..., sus semillas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>pues como actualmente hay muchas cosas, algunas personas las usan para artesanías, usan las semillas para hacer sonajas o cómo les llaman.  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>También usan las semillas para las sonajas, cuando ya están secas las semillas se escuchan muy bonito las sonajas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>Y a veces yo también lo he visto por ahí que usan las semillas para que germinen.  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>En un lugar vi que las semillas las ponen a germinar y enseguida arrancan este..., así las matitas para ir a sembrarlas a otra parte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>Las siembran en otro lugar, ahí crecen las matas y producen este.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>Producen frutos y solo en algunos meses florecen las matas, también tienen su temporada de floración.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Primero florecen las matas y luego ya van creciendo los frutos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>y después de crecer ya se dan así, este..., después de que maduran los frutos toman un color negro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Después de que se vuelven de color negro ya se cortan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Se cortan los frutos, se pelan y se va apartando la cáscara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Aunque se junten muchos frutos sus semillas son muy pequeñas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Y cuando lo..., lo..., limpian la pulpa la exprimen, lo hacen así quitándole las semillas porque si las semillas se juntan con la pulpa, a veces cuando uno come se ma..., mastica la semilla y tiene un mla olor, su..., la semilla tiene un  olor diferente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Pero este, el  &lt;i&gt;nexkihit&lt;/i&gt; es muy sabroso, las flores del &lt;i&gt;nexkihit&lt;/i&gt; no brotan en la punta de la planta, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>las flores brotan al pie de las matas, al pie de las matas brotan las flores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>y desde ahí van creciendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>Ahí ya van creciendo las flores,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>y enseguida van creciendo los frutos pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>Son pequeños su..., los frutos hasta que crecen, enseguida van madurando y van tomando un color verde, así todas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>No, no e..., son de color rojo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>y ahí crecen hasta llegar a su tamaño, cuando ya maduran, las ardillas empiezan a comer, o cuando uno va a verlos ya son de color negro, los frutos se dan por racimos. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Son bonitos así los racimitos, uno no sabe cuantos frutos tiene cada racimo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>y eso es lo que yo sé, usted tal vez sabe más acerca del &lt;i&gt;nexkihit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>A los tamales de frijol molido también.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>No las usan.</ANNOTATION_VALUE>
