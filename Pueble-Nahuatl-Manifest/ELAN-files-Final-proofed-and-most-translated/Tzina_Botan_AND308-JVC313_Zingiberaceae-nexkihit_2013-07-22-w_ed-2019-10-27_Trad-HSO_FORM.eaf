        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>A:mo, a:mo kikwa ne:n iteyo, [*por]que** tahtakwa:wak wa:n yehwa xa: no: tikmati ke:meh i:n tik[mat]toka ne: kikwih para ayakachmeh, ke:ní:w ki..., [ki]te:te:miliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Kwaltsi:n kakisti ta[k].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Pos yo:n mah se: ki:xtili nochi i:n pachti *cuando** kichipa:wa para se: 'kwa:ti nejó:n, mah se: kipa:ka kwaltsi:n wa:n mah se: kwa:tsa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>pos kikwiskeh ke:meh ekintsi:n nochi ne:n ki..., kite:mo:tih n' ekintsi:n para, ne:n, ayakachmeh kichi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Oso kikwi:kah ne:wí:n pos no: xa: te:tahtani:skeh. Mah a:mo se: ka:wilo nejó:n tet, ta: ... Miak tapale:wia wa:n yehwa yo:n tatani nejó:n nexkihit semi tel..., telwe:lik, seki kita:liliah yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>ne:n *cebolla** no: kita:liliah, kita:liliah wa:n yehwa yo:n ne:n *pimienta**, n' i..., n' ixiwyo nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>A:, kita:liliah ne:n ilamahpio,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>wa:n yo:n achto k..., kiokxitiah ne:n nakat de n' ilamahpio wa:n kite:mil..., kita:liliah itech i:n ko:mit. Pos kwaltsi:n we..., we:lik no: se: te:we:lias wa:n ompa mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>'wi:ki ne:n chi:ltamo:ltal, mah se: kite:te:kili no: taman pos se: te:we:lias.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Wa:n yehwa n' nimitsilia ne:n okseki no: tiki..., no: tikitah, no: ke:meskia no: yeh..., no: yehwa, nijó:n, no: ke:meh nexkihit. Pero yo:n kilia seki itahta:x.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>Yo:n a:mo yehwa. Uhuh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Yo:n a:m..., a:mo yehwa, no: *mis...**, no: kihtowah ke no: kikwih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>pero *más** ahwia:k i:n seki, yo:n a:mo se: kimati, ke:meh nika:wí:n tehwa:n tinemih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>ka:sika no: titekitih, timokaya:wah *porque** tikikne:liah para tikte:xi:maskeh ne:n nexkihit *porque** kwaltsi:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>Entó:s no: timokaya:wah, tika:wah, tik..., tika:wtiowih ne: seki *después** tikitati:w pos ta:lpan ne:n ki:sa ya ne:n ixo:chio pero no: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>No: taman, semi tsikitsitsi:n n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>Tsikitsitsi:n. Tsikitsitsi:n ne:n *cimarró:n**, ne:n yehwa n' tsikitsitsi:n xo:chiowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>Wa:n no: se: kimati ke a:mo yehwa nexkihit *porque** ne:n tsikitsitsi:n ne:n xo:chiowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>Pos no: kwaltsi:n de ke nika:n ti..., timoliah, nochi ti..., timomati:ltiah, pos yo:n semi kwaltsi:n, a:mo, a:mo nikihto:s ke:meh teh tikmatis no: *igual** neh tik..., timolihtokeh nika:n wa:n kwaltsi:n timonohno:tsah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>ke:meh i:n tikowtahnemih oso 'tekititih ne:wí:n pos tikitah ne:n nexkihit *o** ti..., 'tekih wa:n timowa:lkwiliah *o** tiktohto:kah *o** tikchipa:wah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>wa:n ompa ya tikwitih para, ne:n, tapalo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts390">
                <ANNOTATION_VALUE>Pos neh nimono:tsa Anastacio Nicolás Damián, niw..., niwa:le:w ne: San Miguel Tzinacapan.</ANNOTATION_VALUE>
