    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Eleuterio Gorostiza Salazar" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="EGS Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Ahora, este, Rubén, platícanos de este bejuco que crece sobre las ramas de la planta del café, le llaman a:ki:smekat, ¿Cuántos tipos conoces,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a233" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>cómo son las hojas y las semillas, las flores,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>y donde crece?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a235" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>¿Cuando florece? Todo lo que sepas del a:ki:tsmekat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>¿Espárragos?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a247" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>¿Tejocote?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>¿Y el a:ki:tsmekat es diferente?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>¿Puedes contarnos cómo son las hojas y las flores del a:ki:smekat?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>¿Cómo es el que dices que tiene las hojas verdes?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>¿Y ese cómo es la flor, lo conoces?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>El que dices que es el a:ki:smekat con hojas verdes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Dices que son dos tipos, ¿Por la flor</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>también se identifican que son diferentes?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Y sirve para algo o no sirve para algo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>Y ahora, ¿Acaso puedes decirmos como es el tallo o el bejuco del texokomekat y el a:ki:smekat, si son diferentes?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>¿Y el fruto del a:ki:smekat o del texokomekat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>es comestible, se puede comer o acaso los animales se lo comen?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>Las hojas tampoco son comestibles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>¿Cómo es el fruto cuando empieza a madurar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>Bueno, pues parece que es todo, me has platicado respecto a los dos tipos de bejuco, este, dínos tu nombre, de donde, de donde vienes y cuando naciste.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
