        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>Y ese florece solamente en el mes, este, el dia de ...,</ANNOTATION_VALUE>
