        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>Y el otro, los frutos son más pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
