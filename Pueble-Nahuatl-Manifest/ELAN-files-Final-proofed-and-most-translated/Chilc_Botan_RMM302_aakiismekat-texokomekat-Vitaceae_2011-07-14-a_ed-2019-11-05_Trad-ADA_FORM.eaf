        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>pues es así, el bejuco se parece mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Se parece, sólo que ese es rojo y hay otro que es blanco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Eso es lo que yo te digo. Son dos tipos al que yo..., yo conozco dos tipos, uno que es blanco y otro que es rojo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>Ese no sirve para nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>Ese no sirve para nada porque sabes, el bejuco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>no puedo decir..., es resistente, es resistente. Pero no puedo decir que lo vas a ocupar para</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>amarrar o cómo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>No, ese no sirve para nada. El que sí sirve es el a:ki:smekat, el a:ki:smekat si sirve para amarrar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>¿Porqué? (Porque) es resistente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>hay el que es más delgado y el grueso pues sirve para todo, para amarrar, como este, con ello ..., en aquéllos tiempos nuestros ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>nuestros abuelos pues ocupaban para amarrar, el que le llaman a:ki:smekat. Van a cortar el a:ki:smekat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>para amarrar los palos, los palos en la construcción de una casa o cualquier otra cosa. En aquéllos tiempos no lo ocupaban,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>(no lo) ocupaban como ahora se conoce el alambre, el que le llaman alambre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>Ahora, en aquéllos tiempos ocupaban mucho el bejuco, el a:ki:smekat,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>o ese, el kwitaxkolmekat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Todo eso, todo ese (bejuco) sirve, todo sirve para ..., para amarrar los palos que se usan en la construcción de una casa o para construir nuestra casa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>para amarrar los palos. Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a395" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>El texokomekat, así como yo les di..., les di..., les digo, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a396" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>ese tiene nudos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>No es liso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>Tiene nudos y el a:ki:smekat es liso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>Y ese le llaman a:ki:smekat porque cuando uno lo corta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>empieza a salir el agua. Por eso le llaman a:ki:smekat. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Pero no tiene nudos, ese es liso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>Se extiende, así como vez el ..., este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>el que le llaman, este, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>este, ese lazo pues lo ..., ese lazo, así, así, así se parece.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Ehe. En ninguna parte tienen nudos porque todo es liso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>Es el que le llaman a:ki:smekat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>Sí. Y de eso otra vez les voy a..., les voy a decir nuevamente, el a:ki:smekat, así le llaman porque lo cortan y empieza a escurrirle agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>Por eso le llaman a:ki:smekat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>Y le llaman texokomekat,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>es el que les digo que tiene nudos,ese no, ese no sirve para nada, ni para ..., bueno, yo sé que no sirve para amarrar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>Sí. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>Ese, solamente para los animalitos como los pajaritos, se alimentan de estos frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>Donde hay, los animalitos pues ya se alimentan de los frutos. Ese, solamente para los animalitos, para que se alimenten los pajaritos. Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>No, las hojas no son comestibles, solamente se comen los frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>Los frutos sí, cuando, cuando ya empiezana amadurar pues los animalitos ya se alimentan de ellos. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>Cuando empieza a madurar, este, cuando empieza a madurar el fruto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>justo donde está la hoja,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>donde está la hoja, en la orilla de la hoja sale la flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>Eh. A un lado de la hoja sale la flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>Se ensartan muy bien todas las flores y luego ahí mismo salen los frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>Mm. Una vez que salen los frutos, empiezan a madu..., se maduran los frutos, ..., este, los frutos tornan a ser como negros,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>unos y otros son un poco rojizos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Te digo que hay dos tipos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>Hay frutos del que son un poco más grandes y hay frutos de los que son un poco más pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>Unos son negros y otros frutos son un poco rojizos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>El a:ki:s..., es el que le llaman, este, este, texokomekat. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>Yo me llamo Rubén Macario Martínez.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>Yo crecí en Chilkowtah, aquí, aquí en Chilkowtah, más hacia acá de San Miguel,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
