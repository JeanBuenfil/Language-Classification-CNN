        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>Ke:mah. Yehwa yo:ni nimitsilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>O:me taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>N..., de n..., de n..., yo:n a:..., *este** n' texokomekat, texokomekat, *este**,</ANNOTATION_VALUE>
