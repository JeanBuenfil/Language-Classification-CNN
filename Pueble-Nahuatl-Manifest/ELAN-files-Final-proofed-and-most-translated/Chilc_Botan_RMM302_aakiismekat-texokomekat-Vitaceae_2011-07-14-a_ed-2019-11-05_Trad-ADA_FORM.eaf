        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>Kwaltsi:n, kwaltsi:n mote:tekpa:na nochi xo:chit wa:n ompa ke:mah pe:wa ya n' ompa n' teyowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>Mm. *Después de** teyowa ya, yo:n pe:wa oks..., oksi a n' iteyo, chi:..., *este** n' iteyo *medio** tihti:ltik,</ANNOTATION_VALUE>
