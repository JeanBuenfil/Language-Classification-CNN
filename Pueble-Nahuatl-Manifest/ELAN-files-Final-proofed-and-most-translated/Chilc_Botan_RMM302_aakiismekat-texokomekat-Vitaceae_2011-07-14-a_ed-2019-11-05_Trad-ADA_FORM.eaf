            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a367" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Hay uno que es rojo y hay otro que es blanco. El rojo se parece, se parece mucho al otro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Se parece, no cambia en nada, sólo que los frutos</ANNOTATION_VALUE>
