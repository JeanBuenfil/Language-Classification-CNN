        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a248" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>es el que llega a enterrarse en la tierra. Pero primero retoña en la parte de arriba, este,</ANNOTATION_VALUE>
