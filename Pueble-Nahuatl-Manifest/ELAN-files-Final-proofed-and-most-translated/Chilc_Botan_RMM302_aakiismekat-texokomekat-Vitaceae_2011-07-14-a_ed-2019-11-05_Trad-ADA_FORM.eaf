        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>N' iteyotsi:n *casi** ke:mah, *cuando, cuando** pe:wa yoksi a, pos yehwa ya n' ki..., ika motekipanowah n' okwiltsitsí:n. Mm.</ANNOTATION_VALUE>
