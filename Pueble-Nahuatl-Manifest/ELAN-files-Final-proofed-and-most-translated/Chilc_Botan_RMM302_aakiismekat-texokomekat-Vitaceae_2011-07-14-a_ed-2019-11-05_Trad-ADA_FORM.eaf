        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>*Cuando** pe:wa yoksi, *este, cuando** pe:wa oksi ne:n ita:kka,</ANNOTATION_VALUE>
