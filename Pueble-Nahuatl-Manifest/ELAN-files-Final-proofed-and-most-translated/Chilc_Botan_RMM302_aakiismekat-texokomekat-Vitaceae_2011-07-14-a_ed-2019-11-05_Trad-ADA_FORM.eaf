        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Te dije del texokomekat. Del a:ki:smekat no conozco la flor y tampo..., tampoco su fruto.</ANNOTATION_VALUE>
