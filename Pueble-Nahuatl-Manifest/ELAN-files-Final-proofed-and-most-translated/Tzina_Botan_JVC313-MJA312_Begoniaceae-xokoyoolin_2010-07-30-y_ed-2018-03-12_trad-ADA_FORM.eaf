            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>Pues sí. Es diferente, es diferente, tiene diferente sabor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>Como esos, como los pollitos, pero dicen esos, este, los que son pintos y los que son blan..., ese, el pollo blanco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>Aunque no sea de granja, como el pollo criollo. Pero no tiene el mismo sabor como el pollo pinto y el pollo negro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>Dicen que el pollo pinto y el pollo negro son más sabrosos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>Y si se prepara un pollo blanco, según no es tan sabroso como los otros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>Sí, también son diferentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a189">
