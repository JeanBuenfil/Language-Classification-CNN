        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Pues nosotros también ....A veces vamos de paseo allá en el monte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Este, encontramos ese tipo de xokoyo:lin pero no lo colectamos porque pensamos si acaso no se le pueda sacar lo agrio, son gruesos como la caña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
