        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Sí. Y el pa:tinixokoyo:lin crecen muy grandes y gruesos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Ese se parece a las hojas del takwa:wakxokoyo:lin, solo que las hojas son lisas, las hojas son más lisas y son muy grandes. Redondas. Y muy gruesos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Ese no, nunca lo has preparado en comida comadrita. Nunca. Sí.</ANNOTATION_VALUE>
