            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Sí, este, abunda mucho, más acá de ista:ka:t, en el monte donde hay mucho pendiente abunda mucho. Crece muy bien pero, este, nosotros nunca lo recolectamos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>lo recolectamos solamente el que se extiende sobre el suelo. Ese sí lo colectamos, ese, el kwitaxkolxokoyo:lin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>Ese, nos gusta más, porque creemos que es más sabroso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a177">
