            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>A bueno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Pues yo me llamo Anastacio Nicolás, vengo de San Miguel Tzinacapan compadrito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
