                <ANNOTATION_VALUE>Wa:n, wa:n tein selontsi:n, ne:n, kwomekat, ne: na:wi *esquina** kipia ke:meh yon eski:nah xokoyo:lih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
