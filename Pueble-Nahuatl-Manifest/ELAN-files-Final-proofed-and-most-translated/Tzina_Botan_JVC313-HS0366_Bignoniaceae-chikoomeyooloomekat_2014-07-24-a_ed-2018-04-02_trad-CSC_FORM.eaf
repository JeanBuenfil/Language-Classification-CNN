        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>wahkal se: kichihchi:was wa:n, wa:n para, pahti para *riñones** no:.</ANNOTATION_VALUE>
