        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Se: kikwi tein kwali kwawit, tein chika:wak para kixi:kos ne:n pili.</ANNOTATION_VALUE>
