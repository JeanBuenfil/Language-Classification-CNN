                <ANNOTATION_VALUE>Ke:mah tik..., tikwi..., t'ta:liliah xo:no:t, ika tikihkitiah wa:n ke:mah kwaltsi:n moka:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
