        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>Yehwa yo:n, no: se kikwiti para wahkalkowit tein toma:wak para taxi:kowa. Ke:mah.</ANNOTATION_VALUE>
