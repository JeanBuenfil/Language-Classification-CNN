    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>Pues yo conozco el tsapokoro:nah,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>íbamos a traer a ese, al que le llaman tsapokoro:nah porque,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>esos crecen grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>Todos crecen grandes, son un poco alargados y con la cáscara rasposa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>Con la cáscara rasposa como el..., como si tuviera espinas, como la</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>chirimoya, pues unos son...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>Ahí donde sale el peciolo de la chirimoya es un poco rasposo, como si estuviera rebanado, se parece a las carnitas del cachete de cerdo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>Es el que a nosotros le llamamos tsapokoro:nah y,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>y es un poco..., no es muy dulce, es un poco ácido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>Es un poco ácido, no es muy dulce como la chirimoya, éste, (la chirimoya) es dulce y el tsapokoro:nah es un poco ácido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>Es agridulce.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>Si, ese también.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>También florea, también florea pero nunca he puesto atención cómo es la flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>Quien sabe, yo no conozco la flor pero las hojas son..., no las conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>No sé cómo son las flores, solamente he visto los frutos como, cómo se desarrolla y cómo llega a madurarse y qué sabor tiene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>Crece alto, no crece tan alto, alcanza a una mediana altura, como el árbol de las anonas, así crece el árbol de tsapokoro:nah.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
