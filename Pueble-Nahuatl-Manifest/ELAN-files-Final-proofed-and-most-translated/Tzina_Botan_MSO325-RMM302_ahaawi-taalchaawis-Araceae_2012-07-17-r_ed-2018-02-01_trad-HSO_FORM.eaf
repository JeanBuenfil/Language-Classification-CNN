        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>Pos neh n'mattok kwali kihtowah no: ke:mih yo:n komohkó:n yo:n teihsá: se: mochi:wilih oso e:wak se: imetsko se: kokotsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>wa:n yo:n wehka:wak a iwki etok, ka:n pahti wa:n sayoh cha:wisa:ki:stok kihtowah *que** mah yeh se: kita:lili, mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>se: kikwi de yo:n tein seltsi:ni mah se: kiteki wa:n mah se: 'kweto wa:n mah se: kite:mpepechowili wa:n i:ksá: kihtowah kiwa:tsa ya yehwa yo:ni. Neh yehwa yo:n n'mattok kwali para pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>Tein aktok a:mo wel ki:sak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>A:, no: kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Pos neh n'mattok mochi:wa ke:meh yo:n ta:li:xko, ompa kahfe:ntah oso ke:meh yo:n ka:mpa ta:lkwa:it, yo:n ka:sá: ika *tacorraltiah** mochi:wa n' ompa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>pero nejó:n a:mo, a:mo *más** nikihto:s mowi:wila:na. Ompa sah yo:n onkak tsihtsikitsitsi:n wa:n yehwa yo:n mochi:wa yo:n i:pa tsihtsikitsitsi:n sehseltsitsi:ni nik..., kipia ya neh n'mattok *que** kwali yehwa tein yo:n seltsi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>A:mo, a:mo n..., a:mo n'mati, a:mo ke:man ta:ki *porque** ka:n ke:man nikita ox mah kipia ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Ke:mah, *sólo** yo:n okseki neli kipia ita:kka yo:n tein kowke:span panki:sa yo:n ke:mah. Pero i:n okseki a:mo ke:man nikita mah ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>A:mo, yo:n mochi:wa sah, a:mo kito:kah *porque** ka:nika eski se: kita onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Pos komo se: kwiwitak wa:n mah se: kita:li ahko wa:kis, pero komo *mismo** ompa t'tamo:t sah a:mo wa:ki, ta: yo:n a:yoh, yo:n sepa selia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>*Mismo** sepa moi:xkalakia itech n' ta:ltsi:ni wa:n sepa selia, a:mo wa:ki niman yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>*Porque** a:yoh yo:ni wa:n ye:kcho:kiloh no:. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Pos neh nikitani ne:kwí:n no:yá:n onkak, ompa ne:kwí:n kowtahpa onkak wa:n ompa nika:n i:n, ma:ski kaltsi:ntan nejó:n onkak neh nikitani, i:pa ompa mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Pero a:mo n'mati *más** ka:sá: ika ox no: onkak, pero n' ompaka ne:wí:n tehwa:n onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>A:mo, ta:pos ta:lpan sah mowi:wila:na. Ke:mah, ta:lpan sah. Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>A:mo, neh n'mattok i:pa yehwa sah yo:n para kokot oso neli yo:n se: moteki wa:n ka:n pahti yo:n iwki *como siempre** i:xseltitok, wei cha:wis a:ki:stok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Neh n'mattok *que** yehwa sah yo:n i:pa mah se: mota:lili. A:mo n'mati ox kwaltia *para más** teihsá: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Pos yeh tsikitsitsi:n wa:n kahkana:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Ke:mah, neh niki:xmattok *que** tsikitsitsi:n, a:mo wehwei mochi:wa, tsikitsitsi:n wa:n nió:n no: nikihto:s telmetswe:weyak, ta: achi tsikitsitsi:n ata n' imetskowyotsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>A:mo yehwa, yeh oksé: *porque** yeh mochi:wa kowke:span wa:n yeh ta:ki wa:n i:n okseki a:mo ke:man se: kita mah ta:ki. Neh a:mo ke:man nikita mah ta:ki, pero yo:n seki ke:mah niki:itani, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>ita:kilka kwaltsi:n ata nejó:n oksi ye:kkostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Se: kita mahyá: ke:meh yo:n eskia yo:n, ke:meh yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>*papaya** kiliah, nikilia neh kwaltsi:n ata ye:koksi, ye:kkostik, pero nejó:n yeh, yeh ta:ki pero i:n okseki ka:n ke:man nikita mah ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Ke:mah, yeh ixiwyo no: iwki tamatisneki pero ixiwyo *más** kahkakaltik yeh wa:n i:n okseki a:mo iwki. Ke:mah wa:n *más** tepitsi:n ma:we:weyak wa:n i:n seki nejó:n tsikitsitsi:n ne:n ixiwyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Ke:mah, kowke:span sah, kowke:span moskaltia, *porque** ka:n se: kita ox e:wtok ta:lpan, *solamente** i:n seki se: kita *que** ta:li:xko n' e:wa pero yo:n okseki a:mo, mahyá: itech kowit sah mochi:wa wa:n ompa iwki panki:stiw. Komo se: we:ikowit panki:stiw iwki wa:n ke:mah ompa pe:wa ta:ki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Neh a:mo nikmati, *porque** yo:n neh ka:n ke:man nikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>A:mo n'mati ox we:lik. Kihtowah *que** we:lik pero neh a:mo ke:man nejó:n nikmahse:wa yo:ni, ke:mah. I:pa ne:chii:lia:ya note:iskaltihka:w ata kihtowah kihtowa *que** te:te:nahwayo:tih ne: nak...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>nikmowilih yo:ni a:mo ke:man, a:mo ke:man nejó:n nikmahse:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>Ke:mah, ta: kihtowah *que** neli iwki te:chi:wa *por eso** neh neli ka:n, ka:n ke:man nikmahse:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>*porque** neli i:pa nikakilia:ya note:iskaltihka:w, kihtowah kihtowa *que** te:..., te:te:nkokoh pos a:mo, a:mo ke:man nik..., a:mo ke:man nikekoh neh ke:niwki neli, ne:n, nejó:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>A:mo, ta:k, ka:n ke:man teh nte:kakilia neh ox kwali para pahti, i:pa, i:pa tak i:pa iwki sah ke:meh yo:ni, a:mo teh onkak *más** yehwa sah yo:n komo s..., komo se: kikwa neli ne:n ita:kilka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Ke:mah, kihtowah *que** kwaltia neli no: ika tawi:pa:nah ke:meh yo:n ka:sá: ika komo yo:n tatsi:ntsakwah kwaltia neli n' kihtowah n' ikomekayo, kihtowah *que** ye:k..., ye:ktakwa:wak no: yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>Ke:mah, kihtowah *que** taxi:kowa wehka:wa, ke:mah, ke:meh yo:n pos ka:sá: ika tai:xwi:pa:nka:yo:t ika kichi:wah kwaltsi:n ika, nejó:n, tawi:pa:nah n' kihtowah *que** neli ye:ktakwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>Ke:mah, neli n' kihtowah *que** kwaltia. Ke:mah, yehwa kikwiah *porque** pos a:mo ke:meh a:man, a:man a:mo teh nejó:n kikwih ok yehwa, a:man nochi, nochi nejó:n mopatatok a n' ekintsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>A:mo, pos ta: se: kimowilia de kihtowah te:..., ke te:te:nkokoh. Ke:mah, a:mo se: kineki se: kikwa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
