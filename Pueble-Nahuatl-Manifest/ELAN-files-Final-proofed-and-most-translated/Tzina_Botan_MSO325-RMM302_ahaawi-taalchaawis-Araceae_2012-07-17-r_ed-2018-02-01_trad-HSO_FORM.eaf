        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>bejuco que le llaman este, ta:lcha:wis.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>esa planta que se da mucho en el cafetal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>Y quizá sepas para qué se usa esa hierbita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>Sí, eso es lo que yo he escuchado también, yo no sólo he escuchado sino que..., ya lo hice como te platicaba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>o en algún lugar en donde entra una espina, a veces en el pie,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>una espina o un pedazo de vidrio que se mete en el pie,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>hay que ocupar junto con, no sólo la hoja sino que junto con la cáscara delgadita de la cebolla, se le pega la herida en donde sale pus,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>hay que pegar la hoja en la herida o grano para que ayude a expulsar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>todo lo que tiene. Entonces de que empieza a salir el</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>pu..., el pus en el pie, empieza a salir junto con la</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>espina o t..., espina o piedra, o a ver qué es. Eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>Sí, también es bueno para eso. Eso es lo que yo sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Otra cosa que quiero preguntarte, también quiero preguntarte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>en donde se da este bejuquito, esa hierbita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>Y esa planta no produce frutos, no da frutos, o sea no tiene frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>Y esa planta la siembran o se da sóla, usted cómo lo..., que piensa usted que ha visto en los cafetales.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a186" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>Ajá. Y otra cosa que te quiero preguntar,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>si se arranca la mata se seca o</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>se acaba o se..., si..., como siempre sigue viva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>Tiene savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>¿Y se da en cualquier parte, no sólo se da por aquí, no sólo se da por acá, y por allá en donde usted vive también se da?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>Bueno y la planta no crece alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a205" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>Es..., es baja, se da en el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a206" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Pues es muy bonito y usted sabe, así como usted lo conoce, este, sólo se us..., las hojas sólo se usan para curar, no, no se pueden usar para otra cosa, así para curar otra enfermedad digamos nosotros,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>otra enfermedad que se pueda curar, como que sólo se usa para curar heridas o granos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>Otra cosa que también te quiero preguntar,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>usted que conoce esa hierbita,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>este, ¿cómo son sus hojas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>Y esa planta que le llaman ah..., yah..., nosotros la conocemos como ahaw..., yahya:wit</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>casi se parece mucho, pero no es el que le llamamos yahya:wit, este, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>¿No es el ta:lcha:wis? Este es otro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>Y sus hojas casi se parecen, so..., sólo que usted quiere decir que el yahya:wit tiene las hojas alargadas. Son más duras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>Pues ese es el que yo también conozco, si dicen que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>el que le llaman yahya:wit tiene más gruesos los pedúnculos de las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>No sé quizá sea de la planta que me estás platicando, de la planta que me estás platicando tiene los pedúnculos más gruesos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>Son un poco más gruesos y más alargadas, son más gruesas las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>Y esa, esa, esa planta crece,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>bueno yo lo he visto que, no se da en el sue..., en el suelo sino que como si fuera digamos que se da en la superficie de los troncos de los árboles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>Ahí se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>¿Y que..., qué sabor tienen los frutos del que le llaman yahya:wit?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a237" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Yo te pregunto porque yo también lo..., una vez,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>una vez me propuse a comer esa fru..., fru..., frutita,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a239" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>pelé la fruta y pensé comer las semillas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>Y lo que pasó, pues empecé a sentir comezón en la boca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>Desde ese día dejé y ya nunca pensé cortar la fruta para comer porque sentí que no, sentí que si provoca comezón en la boca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>¿Y el que le llaman yahya:wit este, no, esa planta no se usa para curar, ese es sólo un fruto nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a243" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>¿Y usted no sabe sobre el bejuco que tiene</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>quizá se pueda usar para amarrar alguna cosa o</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a245" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>diga..., digamos este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>para amarrar palos en un corral? Porque parece que me acuerdo que también se...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a247" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>también tiene su..., bejuco, digamos el bejuco de donde salen las raíces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a248" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Sí, yo te platico porque sé,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a249" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>yo sé, quizá usted también sepa, tal vez sepa, quizá sabe usted como yo sé que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a250" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>su..., me..., el bejuco de esta planta lo cortan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a251" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>y se usa para amarrar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Cuando se seca, cuando se seca ese bejuco se endurece mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Así como está duro pues es resistente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Es duro, por eso te platico porque hace muchos años yo también veía que..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>nuestros abuelos usaban mucho este bejuco, no era como actualmente usamos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>cualquier alambre de fierro para amarrar, ahora </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a257" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>todo ha cambiado. Hace muchos años usábamos eso, usaban también, también..., también..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a258" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>nuestros abuelos, mis abuelos usaban.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a259" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>Cortaban ese bejuco. Iban al campo a cortar ese bejuco, el bejuco de ésa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a260" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>me dicen que es el yahya:wit, el bejuco del yahya:wit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a261" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Usaban para amarrar los cercados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Pues se está cambiando. Pues sólo para eso sirve, no podemos decir que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>digamos nosotros este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>le vamos a dar varios usos, sino que sólo usaban el bejuco para amarrar y las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>Pues no vamos a decir que lo vamos a dar algún otro uso, sólo sirve para una cosa nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Pero el fruto de esta planta pues escuchamos lo consumen varias personas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>pero yo te platico que una vez intenté, también este..., también lo..., una vez intenté cortar para comer porque lo vi que estaba muy maduro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Pero no supe cómo consumirlo como se debe, pelé el fruto y lo llevé a la boca, entonces fue en ese omento cuando sentí comezón como te platicaba, desde ese día dejé de consumir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Ahora aunque veo que hay frutos pero no lo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>no lo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Y de veras es así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Pues muchas gracias, es todo lo que te platiqué por ahora en este lugar, ahora,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>yo me llamo Rubén Macario, vengo de Chilcuahuta, pertenezco acá en San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a169" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Pues por nada, igualmente muchas gracias por lo que platicamos. Yo me llamo María Salazar Osollo, vengo de San Miguel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="María Salazar Osollo" PARTICIPANT="María Salazar Osollo" TIER_ID="MSO Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>También la conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>Pues yo sé que dicen que se usa para curar alguna herida causada por algún accidente o cuando nace un grano en el pie</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>y ya tardó con ese problema, no sana la herida y siempre está saliendo un líquido como pus, dicen que es bueno ponerle la hoja, se</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a192" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>corta la hoja más tiernita, se marchita y se le pega a la herida o al grano, a veces dicen que ayuda a secar la pus y ya empieza a sanar. Yo sé que se puede usar la hoja para curar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>Lo que está metido adentro y no pudo salir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>A también es bueno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>Pues yo sé que se da en el suelo, en el cafetal o en donde está un bordo de tierra, en algunos lugares donde hacen un corral también se da ahí,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>pero este no, no puedo decir que se extiende la mata. Ahí se encuentran las plantas pequeñas y las matas se dan así siempre son chiquitas, muy tiernitas, lo..., y yo sé que se usan las hojas que están tiernitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>No, no n..., no sé, nunca produce frutos porque nunca veo que tenga frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>Sí, sólo la otra planta si tiene frutos, esa planta que se da en la superficie del tronco de los árboles. Pero esta otra nunca veo que tenga frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a199" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>No, esa planta se da sóla, no la siembran porque se encuentra en cualquier lugar, lo ve uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>Pues si se arranca la mata y se pone arriba se va a secar, pero si se tira en el suelo no se seca, se vuelve a enraízar porque contiene mucha agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>La misma mata se enraíza sobre la tierra y empieza a extenderse, no se seca luego esa planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>Tiene mucha savia y también tiene agua. Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>Pues yo he visto que por allá hay en todas partes, se da por allá en el campo y por acá, aunque sea junto a la casa he visto que se da, siempre se ha dado por aquí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a204" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Pero no sé si en otros lugares también se da, pero por allá en donde nosotras vivimos si se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>No, si se extiende en el suelo. Sí,se da en el suelo. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a209" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>No, pues yo sé que sólo se usan para curar granos o cuando uno se corta y la herida se sigue infectando, siempre está saliendo pus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a210" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>Yo sé que sólo se usar para curar granos. No sé si se puede usar para curar otra enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>Pues sus hojas son pequeñas y son delgaditas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>Sí, yo conozco que son chiquitas, no son grandes, son pequeñitas y tampoco puedo decir que tienen los pedúnculos largos, los pedúnculos de las hojas son cortitos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>No es, ese es otro, porque esa planta se da en la superficie de los troncos de los árboles, y el otro nunca ve uno que produzca frutos. Yo nunca veo que tenga frutos, pero la otra planta si he visto, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>cuando maduran sus frutos son de color amarillo si lo haz visto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Se ve así como si fuera, como si fuera este la</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a231" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>que le llaman papaya, digo yo que maduran muy bonito con un color amarillo, pero esta planta produce frutos y la otra nunca ve uno que tenga frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>Sí, sus hojas casi se parecen pero la otra tiene las hojas más duras y el otro no es así. Sí, y sus hojas son un poco más alargadas y el otro tiene las hojitas más pequeñas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a233" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Sí, sólo se da en la superficie de los troncos, en la superficie de los troncos, porque no se ve si nacen desde el suelo, solamente la otra planta se da en el suelo pero la otra no, sólo se da en los troncos y así va subiendo. Si se encuentra en un árbol grande va subiendo en el tronco y ahí empieza a producir los frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Yo no sé, porque yo nunca lo he probado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a235" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>No sé si es comestible. Dicen que se come pero yo nunca hago la prueba. Siempre me decía mi mamá que dicen que provoca comezón en la boca y este..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>yo le tuve miedo pues nunca, nunca lo probé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Sí, si dicen que si provoca comezón en la boca, por esa razón yo nunca comí</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a263" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>porque escuchaba a mi madre que decía, dicen que es cierto que daña la boca, pues nunca lo..., yo nunca lo probé a qué sabe el fruto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a264" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>No, creo que no, yo nunca escucho que se pueda usar para curar, creo que siempre ha sido así, no tiene alguna utilidad, sólo para co..., comer si uno quiere comer el fruto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a265" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>Sí, dicen que también se puede usar para amarrar la madera en las casas cuando en algunos lugares cierran las paredes con madera, dicen que es muy..., muy duro el bejuco para amarrar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Sí, dicen que es muy resistente y tarda, si pues como en algunas partes amarran los palos en el tai:xwi:pa:nka:yo:t pues queda bonito el corral, lo usan para amarrar y dicen que es cierto que es muy duro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Sí es cierto, dicen que sí sirve para amarrar. Sí, ese es el que usaban porque pues antes no era como ahora, actualmente ya nadie le da uso, ahora todo está cambiando. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>No pues porque le tiene uno miedo como dicen que pro..., provoca un dolor en la boca. Sí pues así a uno no le dan ganas de consumirlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
