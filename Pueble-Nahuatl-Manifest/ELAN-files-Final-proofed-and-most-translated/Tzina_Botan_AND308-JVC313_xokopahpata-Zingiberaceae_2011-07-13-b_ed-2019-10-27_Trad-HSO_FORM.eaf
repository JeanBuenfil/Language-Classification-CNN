        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>{Por el contexto de la narración, la frase correcta sería "Ompa tami yo:n"}</ANNOTATION_VALUE>
