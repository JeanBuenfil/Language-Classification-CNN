        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>{No se ha tenido referencia de un texokoch o texokochxiwit. Anastacio dice 'texokoch' y después de una pausa, 'xiwit'. Lo más cercano es texokowits o quizá texokokowit, identificado como Xylosma panamensis Turcz.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
