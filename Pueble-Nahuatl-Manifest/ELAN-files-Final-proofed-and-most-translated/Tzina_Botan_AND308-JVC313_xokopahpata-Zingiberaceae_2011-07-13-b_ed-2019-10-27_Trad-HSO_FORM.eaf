        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>{esta palabra tal vez debería de ser expresada como "mata takwik" porque esta palabra no existe o es muy rara.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
