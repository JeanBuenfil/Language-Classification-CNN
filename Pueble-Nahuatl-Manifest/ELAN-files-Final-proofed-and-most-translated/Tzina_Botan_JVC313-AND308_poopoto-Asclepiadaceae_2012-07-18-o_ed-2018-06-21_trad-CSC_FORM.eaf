    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>Si. Pues yo conozco el po:poto este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>el que se da en los cafteales,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>este, casi siempre lo veo que se sube en los cafetos o en los árboles de chalohuite, se sube hasta arriba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Se sube en las ramas del chalohuite, sus bejucos son largos y se suben hasta arriba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Y ese, este, el po:poto su...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>también es..., su bejuco también tiene savía, sus hojas  sus ramas todo tienen savía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Y, este, el que da frutos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>sabe rico, de que ahí, el, el que sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Y su frutos, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>se hacen grandes, son bolas grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>Y tienen cáscara, su cáscara también es un poco duro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>y tiene sus manos como si fueran sus orejas..., como si fuera...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>tiene como..., encima se puso negro..., ancho como un listón de ancho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>Todo lo tiene rodeado de encima hasta llegar a la punta, en su punta, empieza desde la base ahsta la punta de ese po:poto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>Siquiera unos, parece que tiene como,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>como cuatro, tiene cin co ese, ese su..., encima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>Si, eso tiene este..., encima tiene lo que lo hace verse bien, siempre es eso lo distingue el po:poto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a395" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>Como si fueran sus orejas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a396" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>Eso es lo que le decimos po:poto, pero así lo nombran porque así se forma como un poco diferente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>Y ese sabe rico con, cuando aún es tierno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>sabe rico, lo cortan y lo pelan, le sacan su cáscara de encima,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>y parece que lo hierven, como si fuera calabaza o como si fuera tsilakayoh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>Lo..., lo endulzan con azucar o panela y sabe rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Todo sabe rico hasta sus semillas, de las que le salen..., blanco que parece que es lo que vuela cuando ya está maduro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Toda su semilla sabe rico porque ya es endulzado, sabe rico para comerlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Si, y sus semillas de ese po:poto también saben rico, todo sabe rico comiendolo junto, hervido también sabe muy rico. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Lo que son sus semillas lo..., del que ya nace pero cuando es tierno. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Pero cuando son tiernas son blancas, este, las semillas del po:poto son blancas cuando están tiernas y cuando son maduras son negras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Cuando... Si lo corta uno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>cuando aún es tierno sabe rico todo hasta sus semillas, todo sus semillas que vuelan son ricas cuando se endulzan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Sabe muy rico ese..., la carnita que tiene encima el po:poto, este, el po:poto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Y el otro le dicen su doble del po:poto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>ese se da en cualquuier monte, en los campps abandonados se da ese po:poto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>pero ese no se extiende lejos, nada más se extiende poco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>Y sus frutos, este, nada más son mas largos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Son largos como de un "geme" y un poco gruesos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE> es de tallo delgado y sus hojas tienen pubescencia por el ház.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Y todo su tallo es completamente pubescente como si tuviera pubescencia espinoza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Y el otro po:poto, el otro que sabe rico,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>sus tallos son lisos, todo es liso como su bejuco, como sus ho..., sus hojas son completamente lisas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>Si, eso es sa, sabe uno que, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>que también es diferente de un po:poto porque sus frutos son largos y..., y son puntiagudos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Si. Do..., yo conozco dos, dos tipos. Si, un tipo es el que sabe rico y el otro tipo del que no sabe rico, del que, del que es su doble.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>También..., parece como se da el otro po:poto, también se ..., se parece a ese pero luego se da uno cuenta que nno es, que no es del bueno  porque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a460" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>este, sus hojas son pubescentes y sus frutos son alragados, son puntiagudos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>No es bonito. Y el otro po:poto son boludos. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Y encima tiene algo que lo caracteriza este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
