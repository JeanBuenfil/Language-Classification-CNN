        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a617" ANNOTATION_REF="a356">
                <ANNOTATION_VALUE>Pues eso es lo que ya supimos como será, este, sus flores. Como,</ANNOTATION_VALUE>
