        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>ki:ní:n n' ixo:chio nochi ne:n de n' o:me:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>Ke:mah. Pos ne:, nijó:n, kwali tine:chakas moto:ka:y ki:ní:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>timono:tsa, ka:n tiwa:le:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>A:, wa:n neh nimono:tsa Anastacio Nicolás Damián, nik..., [ni]wa:le:w ompa ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts531">
