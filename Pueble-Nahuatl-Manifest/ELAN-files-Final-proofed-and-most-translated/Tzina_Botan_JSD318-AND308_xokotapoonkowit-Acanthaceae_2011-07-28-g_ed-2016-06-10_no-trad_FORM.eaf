        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Neh nimi..., [ni]ki:xmatik ne: kilwiah xokotatopo:nkwowit,</ANNOTATION_VALUE>
