        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>sayoh kin..., kita:lilihkeh n' ito:ka:y eski xokotatopo:n, ¿a:mo *porque** ki..., a:mo *porque** ka:wiltiah m' pi:piltsitsi:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>teihsá: kine:xtia de xokotatopo:n eski?</ANNOTATION_VALUE>
