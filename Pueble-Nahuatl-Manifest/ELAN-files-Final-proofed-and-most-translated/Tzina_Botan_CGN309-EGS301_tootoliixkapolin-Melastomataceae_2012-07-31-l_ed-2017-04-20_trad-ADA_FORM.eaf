        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>Nochi se: kikwiti:w, se:, se: kwelita se: kiwa:lkwi pero neli ye:kniman i:xmiki, a:mo, a:mo taxi:kowa para wehka:wa i..., ne:n tekol.</ANNOTATION_VALUE>
