                <ANNOTATION_VALUE>Ke:mah, ta: pos i:xmiktik, ta: ika kiliah nejó:n kapolkowit sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Ke:mah nochi. Nochi iwki tein *lo que es** ne:n kapolkowit kito:ka:itiah xa:l..., xa:l..., xa:lkapolin wa:n yehwa ya ne:n, ne:n, ¿ke:ní:w kiliah seki ne:n? kapolkowit a.</ANNOTATION_VALUE>
