        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Ka:n kwaltia, ke:mah, nochi kownextsi:n sah.</ANNOTATION_VALUE>
