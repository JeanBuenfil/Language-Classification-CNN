            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts425">
                <ANNOTATION_VALUE>Ke:mah, niman kihtowah *que** ka:n, ka:n 'kwa:skeh komo yehwa n' ika se: ki..., kipihpi:kkeh yo:n. Mm. Ke:mah, ke:mah, iwki neli pero</ANNOTATION_VALUE>
