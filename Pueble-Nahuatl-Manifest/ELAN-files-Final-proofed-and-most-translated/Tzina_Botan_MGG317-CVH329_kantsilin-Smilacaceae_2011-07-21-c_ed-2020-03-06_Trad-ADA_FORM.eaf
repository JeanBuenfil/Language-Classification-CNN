        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Yehwa ya ke:meh yeh te..., yeh tek.., telkitekiti *rancho**, entó:s ne:,</ANNOTATION_VALUE>
