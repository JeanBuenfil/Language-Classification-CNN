        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Wa:n ke:mah nikta:lilia ya tomatsí:n wa:n chi:ltsí:n.</ANNOTATION_VALUE>
