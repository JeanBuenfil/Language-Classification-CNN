        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>*cachitos** wa:n ne: nik..., kwaltsi:n nikpa:ka,</ANNOTATION_VALUE>
