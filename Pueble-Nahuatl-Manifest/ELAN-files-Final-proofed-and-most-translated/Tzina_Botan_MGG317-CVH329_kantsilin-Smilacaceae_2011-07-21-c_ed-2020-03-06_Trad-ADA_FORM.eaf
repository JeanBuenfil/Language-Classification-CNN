        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Neh nikchi:wa nikteh..., ihkó:n nikpisi:lowa ya</ANNOTATION_VALUE>
