        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Ke:mah ne:, yeha ya yo:ni, ne:n,</ANNOTATION_VALUE>
