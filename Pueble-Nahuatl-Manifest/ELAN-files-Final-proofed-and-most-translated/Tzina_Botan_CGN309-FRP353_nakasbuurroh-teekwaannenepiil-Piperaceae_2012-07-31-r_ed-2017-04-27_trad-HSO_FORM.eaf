                <ANNOTATION_VALUE>Neh nikwahka..., nikwa:kwa:ni *por eso** nikihtowa.¿Wa:n no: tikto:ktok mokalihtik? ¿A:mo?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts121">
