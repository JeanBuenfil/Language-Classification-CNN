        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>Pues ahora compadrito queremos que nos platiques si</ANNOTATION_VALUE>
