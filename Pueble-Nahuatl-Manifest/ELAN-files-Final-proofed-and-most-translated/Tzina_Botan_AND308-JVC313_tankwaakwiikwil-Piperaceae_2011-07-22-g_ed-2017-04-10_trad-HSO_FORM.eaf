        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>Pues también es igual, y es todo lo que te pregunté compadrito.</ANNOTATION_VALUE>
