        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>Wa:n ka:sá: *kicorraltia** piotsitsí:n pos yehwa yo:n kita:liliah *o** tato:k kets..., kitatsakwiliah teihsá: se: *planta** yehwa ika kitatsakwiliah ika yo:n kowtsí:n.</ANNOTATION_VALUE>
