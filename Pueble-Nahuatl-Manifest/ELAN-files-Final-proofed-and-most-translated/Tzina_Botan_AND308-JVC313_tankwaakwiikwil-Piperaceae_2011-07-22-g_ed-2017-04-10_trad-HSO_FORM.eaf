        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Sí compadrito también conozco, también conozco al tankwa:kwi:kwil. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Sí. Pues también conozco al tankwa:kwi:kwil, he visto pero es cierto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>su tallo es de color verde y el retoño que está tierno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>es muy liso su tallo y es de color verde combinado con blanco como si fuera pinto. Es verde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Y también se..., no crece muy alto, de altura crece como un metro y medio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Sus tallos son puras varas delgadas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>Los tallos no se pueden usar para leña. Se pueden usar si de plano no hay leña, están secos y se traen pero, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>pero siempre, bueno la madera es un poco dura cuando se seca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>Pero por lo regular usan solamente para corral, cortan las varas delgaditas y aguanta para corral porque es duro el tallo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Algunas partes hacen corral para encerrar a las gallinas o para los cultivos la..., cierran para proteger alguna planta y usan los tallos de esa planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Les gusta esta planta porque tiene varas delgadas y muy duras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Y por otra parte retoña con facilidad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Esa es la planta que yo conozco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>el tankwa:kwi:..., tankwa:kwi:kwil compadrito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>No, sólo se usa para corral nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Pero más, para curar no se usa, no, nadie la usa para medicina, así lo he visto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Este se usa sólo para corral y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>éste es el primero, otro que también lo..., usted conoce como tankwa:kwi:kwil, es esa planta que tiene hojas pubescentes,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a160">
