            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>en algunos lugares abundan las plantas, hay muchas y crecen un poco altas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>Pero en algunos lugares hay pocas plantas </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Pero yo nunca he visto que la...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>la..., que la siembren en algun lugar. Yo he visto que germinan las semillas y ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Pues yo he visto en varios lugares así, algunas partes la consiguen para poner un co..., corral porque esa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
