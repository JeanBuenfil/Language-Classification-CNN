        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>Pues yo sé que sus raíces no se entierran hasta el fondo.</ANNOTATION_VALUE>
