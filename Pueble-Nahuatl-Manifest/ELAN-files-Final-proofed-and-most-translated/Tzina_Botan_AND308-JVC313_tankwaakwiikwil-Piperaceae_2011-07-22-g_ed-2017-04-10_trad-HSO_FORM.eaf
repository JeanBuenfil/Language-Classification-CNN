        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Por esa razón también le llaman tankwa:kwi:kwil.</ANNOTATION_VALUE>
