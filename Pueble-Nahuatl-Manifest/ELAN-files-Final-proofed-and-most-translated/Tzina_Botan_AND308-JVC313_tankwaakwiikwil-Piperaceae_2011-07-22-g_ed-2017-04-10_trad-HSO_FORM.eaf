        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>Se puede..., arran..., arrancar fácilmente por sus raíces se extienden en el suelo.</ANNOTATION_VALUE>
