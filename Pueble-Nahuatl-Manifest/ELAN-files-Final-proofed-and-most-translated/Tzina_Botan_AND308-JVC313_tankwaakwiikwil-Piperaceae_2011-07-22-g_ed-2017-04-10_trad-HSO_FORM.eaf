        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Pero sus hojas son grandes, cas..., se parecen a,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>se parecen a, también en la ho..., en el pedúnculo de la hoja, en su..., hasta en el pedúnculo se extiende, o termina la hoja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Como aquella mírala, ahí están sus hojas desde el pedúnculo donde empieza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>tiene la hoja, como si estuviera extendida la hoja hasta en el pedúnculo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Hasta a la mitad de la hoja ya es más ancha. Éstas hojas se parecen a las hojas de la planta de cuernavaca compadrito. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>Y sus ho..., sus hojas son rasposas. No, esa no es curativa, son hojas nada más. Sí, pero es cierto que sus hojas son diferentes, desde el pedúnculo está extendida la hoja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>En cada lado del pedúnculo se extiende la ho..., hoja, en los dos lados del pedúnculo está extendida la hoja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>Como si las hojas tuvieran chaparrera, en la punta de las planta tiene hojas grandes y ahí brotan las flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>Eso es. Y sus hojas también,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>son amarillas(aquí habla de sus flores) se da en racimo grande que brotan en la punta de la planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Se da igual que el iyakowit. Sólo que el i..., iyakowit tiene flores blancas y esta planta en la punta es de dos colores yo:lkwihkwi:kwiltik.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>Y esa planta no, esa tiene flores amarillas que se dan por racimo. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>Sí, pues es el que nosotros también la llamamos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>Sí, también la llamamos así, he escuchado que los ancianos la conocen esa planta como tankwa:kwi:kwil. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>Pero no sirve para nada ni para leña, ni para corral, esa planta está se..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>casi por dentro..., dentro..., dentro..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>como te diré que dentro del tallo tiene la médula como el iyakowit. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>Pero el iyakowit también se puede ocupar para corral porque luego retoña. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>también retoña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>Así es. Sí algunas retoñan, retoñan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>El que no retoña es porque el nudo de la estaca no tiene contacto con el suelo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>no enraiza la estaca, y la que hace contacto con la tierra luego salen sus raíces. Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>[...] las raíces salen en el nudo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>[...] No, no enraiza compadrito, No enraiza. Hay que cortar en donde, donde tie..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>la parte que se entierra debe tener el nu..., nudo para que de ahí broten las raíces. Y de ahí empieza a retoñar. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>Hay que ver donde tiene, luego se corta en donde ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>Sí. No enraíza compadrito, queda arriba el nudo no..., no retoña. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Debe estar enterrado el nudo para que de ahí empiece a apoyarse, primero enraíza y ya empieza a retoñar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>Sí, sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>Pues todas las plantas al no conocerlas de,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>cómo de..., deben retoñar las estacas, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a435" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>pues cortamos como podemos y de qué sirve, voy a sembrar va a retoñar porque hay humedad. No es cierto, nos engañamos, sí retoña</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a436" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>pero en los nudos. Como el bambú, han visto cómo se siembra, también se siembra pero en donde  tenga el nudo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a437" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>El nudo, el nudo, si pones en forma horizontal la estaca pues se..., luego salen dos o tres retoños para la mata, pero debe estar horizontal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a438" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>debe estar en forma horizontal en el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a439" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>Pero si lo enterraste, la estaca con un sólo nudo, retoña pero uno nada más, y el que queda arriba también puede retoñar pero no podrá enraizar por falta de tierra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a440" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>Se queda en el aire y ya no crece más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a441" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>Crece el que tiene contacto con la tierra, ése si puede quedar como semilla. Pero si pusiste la estaca en forma horizontal sobre el suelo y luego brotaron sus  raíces. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a442" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>se extienden las raíces con una mata grande. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a443" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>Así se hace como te decía que el nudo. Todas la..., las estacas retoñan en el nudo.  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a444" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Ahí retoña compadrito. Sí, hay que saber sembrar una estaca. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a445" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>Debe tener nudos para que..., que retoñe. Y si lo..., aunque tenga nu..., se queda así el nudo en el aire y la punta está enterrada </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>como si fuera a la mitad pues no retoña porque queda arriba el nudo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>Se seca. Se seca, no puede crecer en la..., no enraíza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>Ahí salen las raíces y empiezan a crecer la planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>Sí, así es compadrito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a459" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>Sí, ya se hace una mata grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a460" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>Así es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>Pues enraíza, también enraíza, esa planta enraíza, su tallo no se seca fácil pero debe estar en el suelo húmedo para que retoñe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>Esa planta no, sus raíces se extienden en la superficie del suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>Sí en la superficie del suelo se extienden sus raíces. Esa planta es igual que el tepe:xi:lo:nalwat que se extienden las raíces en el suelo, es igual al</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>le llamamos tan..., el ta..., el tankwa:kwi:kwil.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>En el suelo se..., extienden las raíces como el tepe:xi:lo:t</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>Así es..., se extienden las raíces así. Pero no llegan a la profundidad del suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>Las raíces no se entierran en forma vertical. Es todo lo que te pregunté compadrito, es todo compadrito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>Pues nada más compadrito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>las pregutnas que te hice y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>sobre el conocimento del tankwa:kwi:kwil, es todo y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>te voy a decir mi nombre, yo me llamo Ernesto Vázquez Chanico de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>Ahora usted dime su nombre compadrito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>Mm, si compadrito.</ANNOTATION_VALUE>
