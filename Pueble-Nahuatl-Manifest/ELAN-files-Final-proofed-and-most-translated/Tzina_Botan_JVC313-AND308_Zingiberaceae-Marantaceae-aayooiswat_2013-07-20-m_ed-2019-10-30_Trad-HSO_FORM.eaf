        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>Pero no crece muy alto, crece un poquito nada más de alt..., de altura tiene como un metro y medio en donde se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Y en la punta de la planta cuando termina de crecer ahí se..., deja de crecer, brotan las flo..., flores, ahí se..., brotan muy bonitas parecidas a las flores de &lt;i&gt;kokowa:tsi:n&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Y tienen una fragancia agradable las flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Sus pedúnculos son largos y si uno jala las flores se chispan, se pueden jalar las flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Sí, este, son bonitas las flores que se dan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Y otro tipo de &lt;i&gt;a:yo:iswat&lt;/i&gt; que yo conozco del que me platicas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Se pueden usar para adornar, hay que cortale el pedúnculo, hay que llevar un machete o un cuchillo para cortarlo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>pero esas no se pueden cortar con las manos porque se estrella el pedúnculo y ya no se desprende, yo sé porque los cortaba</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>se estrella el pedúnculo y ya no se desprende, una vez que se estrella ya no se desprende.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>También se pueden cortar pero con un cuchillo, se cortan y se ponen en floreros huelen muy bonito. Esas flores se ven bonitas en el florero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Nada más eso conozco yo. Y conozco el &lt;i&gt;a:yo:iswat&lt;/i&gt; del que me platicas que se da al otro lado del río,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>ahí se da pero por una temporada nada más, tiene hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Como en estos meses tiene hojas pero en los meses de fin de año</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>se secan las matas por si te haz dado cuenta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>Y se queda, no hay nada, solo bas...., se queda la basura. S..., sí porque lo demás todo se seca, se quedan otras hierbas, nacen otras, otro tipo de hierbas y el &lt;i&gt;a:yo:iswat&lt;/i&gt; se acaba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Sí  se quedan los camotes en la tierra si uno limpia con azadón, si uno chapea el terreno no salen los camotes pero con azadón se quedan encima los camotes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Y ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Se agrian solitos los camotes cuando ya tardan mucho tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Sí así  es. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Sí se extiende la mata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Pues eso es.Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>Pinta bonito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Sí. Se puede usar para pintar si uno quiere pintar algo pues hay que..., saberlo hacer nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>Sí eso es. Sí hay que hacerlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>Pues eso es lo que quise preguntarte y este, y ya lo sé que se puede usar para pintar porque es verdad que nosotros veíamos ahí en el campo pero no .... Ahí trabajábamos en lo ajeno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>No lo traíamos para pintar, nosotros excavábamos y lo tirábamos al río porque así nos había ordenado el patrón, lo tirábamos al río.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>Mm, sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>No se da en todas partes, solo en algunos lugares se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Sólo en algunos lugares. No se encuentra en todas partes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>Sí. Pues en donde se da es muy..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>Sí, se da. Acabamos con muchas matas, porque excavamos muchas matas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>Sí, lo echamos al río.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>Sí así fue, así lo..., también es dinero, sí pero actualmente se usa. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>No lo saben. Sí no lo saben. Pues.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Sí hay que cuidar la planta porque también ayuda para algo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>Ayuda, pues así es. Son todas las preguntas que te hice y ahora dime tu nombre y de donde vie..., vienes. </ANNOTATION_VALUE>
