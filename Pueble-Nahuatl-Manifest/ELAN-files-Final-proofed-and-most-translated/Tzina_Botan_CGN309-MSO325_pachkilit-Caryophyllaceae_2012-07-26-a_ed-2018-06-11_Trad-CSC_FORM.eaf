            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>Yo muy bien, este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>lo comiamos allá donde cortabamos (café o pimienta), me decía mi tio finado Anton..., Antonio Zamora, ya es finado, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
