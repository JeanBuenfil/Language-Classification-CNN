            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>Pero pues es cierto, esa hierba, no sé por qué nadie conoce su nombre, quizá no sea de acá o no se sabe por qué pero casi </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
