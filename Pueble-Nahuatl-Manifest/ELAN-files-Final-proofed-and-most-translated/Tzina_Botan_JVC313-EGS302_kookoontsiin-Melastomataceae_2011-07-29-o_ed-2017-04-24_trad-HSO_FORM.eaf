            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>No se pero creo que es por la forma de los frutos que son como pequeñas ollitas cuando se ensartan en la planta.</ANNOTATION_VALUE>
