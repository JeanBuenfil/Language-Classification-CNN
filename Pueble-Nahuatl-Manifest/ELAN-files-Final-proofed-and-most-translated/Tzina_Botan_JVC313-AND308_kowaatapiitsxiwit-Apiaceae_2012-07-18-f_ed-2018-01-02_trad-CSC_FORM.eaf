        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>Wa:n ekintsi:n a:mo se: kimati ok, ampo:wí:n ka:sika. Tak onkas nika:wí:n. Onkas. Soh *que** a:mo se:, a:mo no: se: kita.</ANNOTATION_VALUE>
