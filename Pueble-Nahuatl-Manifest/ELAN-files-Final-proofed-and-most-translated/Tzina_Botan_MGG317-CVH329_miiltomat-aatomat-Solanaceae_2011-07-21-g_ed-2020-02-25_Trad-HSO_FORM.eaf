        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>Entonces los frutos agrios los tiro dentro del corral. Crecen las matas y florecen, pero no quie..., no producen frutos.</ANNOTATION_VALUE>
