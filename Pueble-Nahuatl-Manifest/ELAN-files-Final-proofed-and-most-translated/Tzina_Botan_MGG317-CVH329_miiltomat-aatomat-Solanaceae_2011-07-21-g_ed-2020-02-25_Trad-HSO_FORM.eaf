        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Está adaptado ahí el jitomate verde.</ANNOTATION_VALUE>
