                <ANNOTATION_VALUE>ne: yo:n nejó:n semi we:lik kichi:wah tapalo:l, yo:n kiliah, tehwa:n tikiliah chi:l..., chi:lato:lemo:l, chi:lato:l..., chi:lato:lemo:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
