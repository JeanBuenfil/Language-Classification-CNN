        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a437" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>Pues yo me..., aquí en San Miguel Tzinacapan, me llamo Anastacio Nicolás Damián.</ANNOTATION_VALUE>
