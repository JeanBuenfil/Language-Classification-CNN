        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>kichi:wah iyoh se: taman sah, n' chi:lato:lemo:l sah n' kichi:wah.</ANNOTATION_VALUE>
