        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>wa:n nejó:n ixah..., sen i:xmelaktik, mahyá: i:xalaxtik semi,</ANNOTATION_VALUE>
