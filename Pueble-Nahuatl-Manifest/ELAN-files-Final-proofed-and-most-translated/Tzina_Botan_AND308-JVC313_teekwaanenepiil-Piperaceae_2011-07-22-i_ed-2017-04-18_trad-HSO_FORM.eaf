        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>wa:n ima..., wa:n metswe:weyak semi n' ima:xiwyo wa:n kwihkwi:kwiltik.</ANNOTATION_VALUE>
