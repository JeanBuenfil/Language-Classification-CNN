        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Yo:n o:me, o:me taman wa:n yehwa ya ne: kiketsayah yo:ni wa:n ki..., tsikilitsi:n a:t ne:n moka:waya wa:n ika kina:ltia:yah.</ANNOTATION_VALUE>
