            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Wa:n 'pepechowah ka:mpa ye..., itech se: amatsi:n kita:liah wa:n kipepechowah ka:mpa se: m..., se: mo..., monekwilo:s, se: mokelo:nia, kitamati:lia yo:n, yehwa yo:n, yo:n xiwit.</ANNOTATION_VALUE>
