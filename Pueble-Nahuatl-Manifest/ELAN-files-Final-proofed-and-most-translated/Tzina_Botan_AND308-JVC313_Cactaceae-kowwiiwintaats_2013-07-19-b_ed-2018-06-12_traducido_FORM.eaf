                <ANNOTATION_VALUE>Nochi kowit tein xahxakachtik, ompa mopilowa ata yo:n, tehwa:n tiki:xmatih m..., mosa:sa:lowa:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
