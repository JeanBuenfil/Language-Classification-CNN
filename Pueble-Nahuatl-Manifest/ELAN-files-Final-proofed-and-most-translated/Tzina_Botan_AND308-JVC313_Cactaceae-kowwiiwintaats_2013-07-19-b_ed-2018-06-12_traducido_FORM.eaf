        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>No: teyowa, mochi:wa weyakxtik, weyakaxtik wa:n momahmaxalowa ihkó:n, momaxalohtiw</ANNOTATION_VALUE>
