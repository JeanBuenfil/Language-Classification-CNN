        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Kixahxama:niah, kixahxama:niah. Ke:mah, mahyá: kimo:ltah wa:n ke:mah, ne:, itech a:matsi:n kita:liah wa:n kipepechowiliah ka:mpa .... Kilpiah ika se: tilmahtsi:n wa:n ompa moka:wa ya. Wa:n komo se: pahtiti a kit ahwayowa yo:n, se:, se: pahti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
