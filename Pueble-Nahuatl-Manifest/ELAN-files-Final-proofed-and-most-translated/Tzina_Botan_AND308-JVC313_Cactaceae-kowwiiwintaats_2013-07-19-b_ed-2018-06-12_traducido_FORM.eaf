        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Ekintsi:n no: se: ki..., kimatilia, ne:wí:n se: kwa:lkwis yo:n, yo:n xiwtsí:n wa:n se: ki..., se: kimanas. Ika se: kitas ox ika se: mopahti:s ke:meh i:n ka:sá: ika se: westi, se: mokokowa wa:n ika, komo semi te:na:miki, pos se: 'kwiti:w.</ANNOTATION_VALUE>
