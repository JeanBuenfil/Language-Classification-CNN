            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Ka:mpa ne:n, ka:sá: ika kisa:lowa tet oso we:i tet..., tepexit.</ANNOTATION_VALUE>
