                <ANNOTATION_VALUE>Yo:n, yo:n chi:chi:le:wi de chika:waya, pampi:xowi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>Yehwa yo:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>Ke:mah, kwa..., tata kwaltsi:n. Ke:mah pos ke:mah, kwaltsi:n tata. Pos yehwa sah yo:n nimitstahtania:ya wa:n 'ne:chilwi moto:ka:i wa:n de ka:ni tiwa:le:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Pos neh no: nimono:tsa niErnesto Vázquez wa:n no: niwa:le:w San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>Pues ahora también que nos encotramos en este camino (una vez más), pues nos encontramoes muy frecuentemente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>y también sé que el na:ntsi:nkowit nace sobre otro tronco grande, ahì se pega la semilla y germina (como una planta vividora)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>O en alguna parte, sobre una roca ahí se pega la semilla, nunca se ve que la planta nazca directamente en el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a204" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>Esa planta crece sobre una roca o en los paredones, ahí crece.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a205" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>Las hojas del na:ntsi:nkowit son un poco rojizas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a206" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Cuando ya se arecia el árbol, es un poco rojizo y sirve para leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Y hace tiempo, nuetros padres nos contaban que hace tiempo había una enfermedad conocida erisepela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>En la pierna o en el brazo salía un grano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a209" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>e iban a traer las hojas del na:ntsi:nkowit y las ocupaban para curar esa enfermedad, no sé si las hervían o las machacaban</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a210" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>y lo ocupaban como emplasto, es muy bueno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>Para la erisepela. Quizá es la picadura de un mosco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>Y esa picadura causaba dolor en el pie porque ahí salía un grabo rojo y poco a poco iba engrandeciendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>Se hacía grande, así crecía, muy grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>el emplasto lo ponían hasta el ganglio porque se inflamaba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Si, iban por esas hojas y no sé si las hervían o las machacaban </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>era muy bueno para sanar la erisepela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Pero yo nunca he visto que este árbol crezca muy grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Ese árbol siempre lo he visto que nace sobre la superficie de otro árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>Ahí crece el na:ntsi:nkowit. El árbol del na:ntsi:nkowit tiene muchas ramas, así extendidas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>Y donde está este árbol, al pasar debajo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>y ahí está el na:ntsi:nkowit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Pues uno mira que ahí hay un árbol porque los frutos se han  madurado y se están cayendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>Se caen ... las hojas son un poco rojizas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>Pero yo nunca le he visto la flor, si son rojas o blancas, nunca se las he visto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Como las semillas del koma:it, debajo del árbol yo he las bases de las semillas, pero nunca he visto que estén hacia arriba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>Ah, son blancas, entonces, exactamnete lo que he visto debajo del na:ntsi:nkowit son las bases de las flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Pues debajo del árbol ahí están tiradas las bases de las flores </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>Así yo he visto algunas veces, cuando las hojas se arrecian se caen al suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>pero nunca he visto que las flores sean erectas mientras están en las ramas </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>Yo solo veo las bases de las flores que están tiradas debajo del árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a257" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Se ven rojos ahí donde están tiradas y la madera del na:ntsi:nkowit se ocupa para leña. Al estar seco, arde muy bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a258" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Pues hace tiempo, todo eso lo ocupábamos para curarnos, ese árbol es muy bueno para medicina, sirve para curar la erisepela y solamente sé eso, para curar la erisepela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Pero quien sabe, algunas personas dicen que también es bueno para curar la mordedura de algún animal como la víbora. Pueden ser hervidas y tomar el té. Así también puede servir como curativa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Yo sé que cura la erisepela.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>En el interior de ese grano se acomula pus y esta hoja hace que el grano se reviente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Se hace pus en el interior del grano y es muy doloroso. El dolor hace que uno llore.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>Donde sale el grano, una buena superficie de la piel se pone rojizo y con la aplicación de estas hojas se detiene.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Al inicio del aparición del grano, la piel queda rojizo hasta salir el grano y va extendiéndose.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Tú también puedes contarme, quizá sepas un poco más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Qué puede curar, quizá cura otro tipo de enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Quizá cure otra enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Por ahí se da mucho y....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Se ramifica mucho, así y....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a163">
