        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>Pero yo:n a:mo no:ya:n mochi:wa, ne Tosa:nkopa mochi:wa, nika:kwí:n tasa:lolkopa nochi na:ntsi:nkowit itech te..., tehte..., wehweitetah ata ompa mochi:wa se: kita tehtekwa:ko onkak yo:n na:ntsi:nkowit, mahma:so:tok yo:n mo..., mo..., moskaltia ke:meh moso:sowa ima:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Yehwa yo:n, onkak nika:kwí:n ahkokopa, tasa:lolpan motelchi:wa ompa, ka:mpa teh..., tehteyoh oso itech kowke:span mochi:wa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Pero nika:kwí:n tahchiktekopa a:mo mochi:wa na:ntsi:nkowit, [Ta][i]tampa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>A:mo mochi:wa, momahma:itia kwaltsi:n, momahma:sowa ke:meh a:wa:kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>Wa:n nejó:n neli iteyo pampi:xowi ta:lpan wa:n chi:chi:ltik itsihtsi:nkaxyo, itsitsi:nkowyo, ni..., nikitani no: neh pero ixo:chio nikitani no: tepitsi:n aha:ista:k ne:n ixo:chiotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
