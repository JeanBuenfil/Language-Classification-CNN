        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Ahí donde está el árbol del na:ntsi:nkowit.... Pero yo he visto que nace sobre la superficie del tronco de otro árbol, quien sabé si ahí cayó la semilla.</ANNOTATION_VALUE>
