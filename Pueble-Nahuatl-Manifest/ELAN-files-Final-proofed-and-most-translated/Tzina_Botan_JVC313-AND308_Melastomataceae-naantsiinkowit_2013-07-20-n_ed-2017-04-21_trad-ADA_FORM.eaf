            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>Pues yo no sé mucho de ese árbol, solo sé que se llama na:ntsi:nkowit, así le llaman porque nace sobre las rocas y sobre otro árbol</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Pero ese árbol no crece en cualquier parte. Se da por Tozán, por Tasa:lo:lkopa, hay muchas rocas y ahí nace sobre la roca. Uno mira que están parados sobre la roca, ahí se observan con las ramas extendidas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Ese árbol hay por allá arriba, por Tasa:lo:lpan, ahí se dá en abundancia, donde hay mucha roca, se da bastante y también sobre la superfice de otro árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Pero por Tahchikteko no se da el na:ntsi:nkowit </ANNOTATION_VALUE>
