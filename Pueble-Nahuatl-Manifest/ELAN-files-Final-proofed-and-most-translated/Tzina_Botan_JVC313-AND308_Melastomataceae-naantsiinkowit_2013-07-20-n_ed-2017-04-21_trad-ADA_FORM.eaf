            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Como si fuera un nido, [solo que tiene] pero con cola, la colilla de la base son largos, ahí se caen.</ANNOTATION_VALUE>
