            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>Tein chika:wak a, *cuando, cuando** chika:wak a ne:n ixiwyotsi:n, pawetsi a, pero chi:chi:le:wi wa:n pawetsiti a. Wa:n tein selik ok, ne: xoxoktik.</ANNOTATION_VALUE>
