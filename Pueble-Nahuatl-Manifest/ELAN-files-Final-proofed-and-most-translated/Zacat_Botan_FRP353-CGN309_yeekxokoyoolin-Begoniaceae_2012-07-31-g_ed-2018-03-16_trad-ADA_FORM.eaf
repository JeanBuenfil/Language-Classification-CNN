    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Francisca Rivera Pérez" PARTICIPANT="Francisca Rivera Pérez" TIER_ID="FRP Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>Allá donde yo vivo parece que no quiere (darse) porque hace mucho calor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>Hace mucho calor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>Y ese se da muy bien donde hace un poco de frio porque lo que es caliente (quiso decir donde hace mucho calor) no se da muy bien, el xokoyo:lin, crece muy delgado. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>Aha. Y este es muy sabroso y, y el ye:kxokoyo:lin aguanta mucho porque lo hierves muy bien, lo mantienes hirviendo por mucho tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>No se desahace</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>Son largos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Y otros vienen (a vender) más pequeños, son chiquitos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>Se le quita la cáscara, mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Pues este, tiene un mejor aroma, sale con el agua de ceniza. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a233" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>Se disuelve bien el agua de cal</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>y luego lo cuelas con una coladera, con el que cuelas el agua de masa para atole para que no contenga brasas y lo pones en la lumbre a hervir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>y lo mueves, lo mueves, lo mueves, lo mueves.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a237" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>Y ve probando si es agrio o aun le falta salirsele lo agrio o ya está bien o si ya está bien, ya se se salió,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a239" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>pues lo agarras, pues vas probando el xokoyo:lin si aún está agrio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Entonces lo agarras y lo lavas y luego ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Mm, mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a243" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>Yo nunca lo hago así, yo, generalmente le pongo la coladera que ocupo para colar mi atole, lo agarro y ahí lo vierto y entonces ahí se retiene el carbón y lo pones en la lumbre junto con el agua de ceniza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>De diferente manera, aha. Y tú no conoces ... hay xokoyo:lin, solamente aqui en Cuetzalan. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>A:.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>A:, a:, donde hay agua, sí. Ahí también hay porque ahí en Tasa:lo:lpan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a257" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>También hace bastante frio, pues ese se da muy bien donde hace un poco de frio y que no, y que la tierra no esté muy seca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a258" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>También se da por aquí, se puede sembrar en cualquier parte pero es necesario que lo compre uno, este, el que ..., su ..., su raíz (rizoma), la parte que está enterrada el xokoyo:lin. Si quieres, le dices</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Todo eso, se da allá en el monte, lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>A:, ese sí, también es sabroso, también es sabroso, mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>A:.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>Yo lo prepara con tekilit y yo le pongo el ayohwach.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>Pepitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Pero es muy sabroso y la comida sale muy grasoso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Ya no sabe y si acaso lo vas a preparar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Este, si no quieres ponerle frijoles, solamente el xokoyo:lin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Mm, puedes echarle y con ajo, ya le agregas el pipián molido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>y con un poco de ajonjolín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Que se ..., que se ..., van dos (tipos).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>Y es muy sabroso y si tu quieres, con un poco de picante</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>mueles el chile verde y le agregas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Y, y tiene buen aroma, al agregarle..., este, le pones el tekilit, el verdadero tekiliy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>El verdadero xokoyo:lin y el verdadero tekilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>Porque el verdadero xokoyo:lin aguanta muy bien, se puede hervir varias veces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Y lo puedes recalentar, aunque sea recalentado tu comida de frijoles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Si no te lo acabaste, no se ..., no se bate. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Si no te acabaste tu comida de frijoles puede tardar por lo menos unos ..., al dia siguiente puedes recalentar (los frijoles con) xokoyo:lin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Pero ese no sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>No sirve. Ese, cuando lo recalientas por lo menos unos dos, tres veces, queda como atole.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Se bate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Y también es así, también es así el pa:tinixokoyo:lin, también (se hace) lo mismo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Aha. Entonces este, también comes el xokoyo:lin, el que realmente es el xokoyo:lin</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>A:, Si, es cierto, pues las personas solamente eso lo traen a venderlo. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Y traen junto con el tekilit y ya traen el que realmente xokoyo:lin. Yo nunca he ..., nunca he visto cuando florea pero ¿conoces las hojas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Ah.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>¿Y cómo son las hojas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>A:.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Mm, pero unas son más grandes, son más anchas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>Y las que son hojas ..., ¿Sabes que se puede sembrar?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>Mm, ya viene a salir, ya viene a salir la hojita otra vez para que crezca el xokoyo:lin, mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>Mm, este se hace grande la mata si uno siembra, este .... Sí, se hace grande la mata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Aha, pareciera que crecen delgados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>Y, y las hojas pareciera que están secas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>No, no le gusta el suelo, ahí donde está la mata, mm. Pero toda la parte alta de Cuetzalan hay bastante de ese, parece que se da.Se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>Pero es el mismo que van a traer al monte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Se parece mucho y algunas personas lo siembran cerca, en sus terrenos. Se da, se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>Entonces señora que, este, que me llevo el xokoyo:lin, pues este llego a preparar mi comida y aquí estamos hablando. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Mm. Pues nos vemos otra vez señora, ya me voy, porque al llegar voy a quitarle el pellejo y llego a ponerlo en la lumbre con agua de ceniza y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>todavía voy a ponerle el ajonjolín y chile y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>junto con las pepitas y con ello voy a comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>Mm. Es cierto, pues es muy sabrosa, pero a la próxima que vayas a visitarnos señora, vas a comer el xokoyo:lemol (xokoyo:lin con frijoles) si te gusta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>Entonces ya me voy señora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>Yo también, si quieres conocerme, pues yo me llamo Francisca Rivera Pérez.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>Aha. Cuando quieras me preguntas bien de cómo preparo el xokoyo:lin con frijoles. Aha, entonces ya me voy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
