        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a531" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>Pues en nuestro estómago, pues yo digo, si tuviéramos algún tipo de bicho,</ANNOTATION_VALUE>
