        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>A:mo moyekowa ok. Wa:n mah kwaltsi:n xik..., xikta:lili tepitsi:n chi:l wa:n,</ANNOTATION_VALUE>
