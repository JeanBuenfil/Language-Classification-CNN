        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Neh nikwa:ya, neh nikwa neh nikin..., metstsonkilit. Wa:n nikma:nelowa iwa:n ekexikilit.</ANNOTATION_VALUE>
