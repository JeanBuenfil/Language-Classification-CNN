        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>m..., ekexikilit wa:n mohkó:n chika:wak a telte:te:nahwayo:tih.</ANNOTATION_VALUE>
