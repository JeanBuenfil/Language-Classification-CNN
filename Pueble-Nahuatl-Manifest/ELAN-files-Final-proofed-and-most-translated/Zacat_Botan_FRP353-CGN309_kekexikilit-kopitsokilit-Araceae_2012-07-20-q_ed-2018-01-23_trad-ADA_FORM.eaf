                <ANNOTATION_VALUE>Mm. Y yo también..., también ví de quien fuera mi mamá con este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>iba a traer el metstsonkilit, iba a traer bastante.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>y lo..., al..., (al) limpiarlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>y ellá le ponía ese, ese, el ista:ket o el kwi:kwilet,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>esos ejotes largos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Le quitaba la cáscara de los frijos y lo removía muy bien y...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Eheh. Y luego..., que tenga buen picante y nos lo comiamos con (agregándole jugo de) limón.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Uno..., con limón, se le va exprimiendo al momento de estar comiendo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Pero este, el metstsonkilit es muy buendo cuando, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>cuando el tiempo, este..., se puede decir que ya se arrecian las matas que se sembraron.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Y si ya lleva mucho años la mata,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>se le puede extraer el camote, así como el ato:lkamoh,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Y de..., y..., no,nosotros nunca tomamos el atole, nosotros lo hervimos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Lo hervíamos el metstsonkilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>lo herviamos y nos lo comiamos con melaza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>Y también te satisface del hambre como si fuera,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>es más sabroso que el espinozo. Son más sabrosos porque son muy secos (no son jugosos).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Y lo comes y te satisfaces del hambre como si hubieras comido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Me lo como, me lo como. Mm. Este nos lo hervía, mi mamá nos mandaba a traerlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a176">
