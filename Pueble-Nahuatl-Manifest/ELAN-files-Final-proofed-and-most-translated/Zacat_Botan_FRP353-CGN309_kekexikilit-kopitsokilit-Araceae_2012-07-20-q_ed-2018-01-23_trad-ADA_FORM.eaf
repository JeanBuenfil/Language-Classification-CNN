        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>Tikwah wa:n t'ta:liliah ya [nimi]tsilia yo:n, tehwa:n tikiliah ne: ex..., ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>wehweiet, we:weyak. Yo:n telwe:lik no: iwa:n se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>Wa:n koma:mo tei pos iwki a, tikta:liah ma:ski iwki sah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>wa:n tsikitsi:n tixti wa:n tsikitsi:n chi:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>Entó:s no: telwe:lik, no: kwaltsi:n emo:l ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Wa:n telpa:pata:wak n' ka:mpa ta:lna:miki wa:n ka:mpa a:mo ta:lna:miki pos achi pisi:ltik.</ANNOTATION_VALUE>
