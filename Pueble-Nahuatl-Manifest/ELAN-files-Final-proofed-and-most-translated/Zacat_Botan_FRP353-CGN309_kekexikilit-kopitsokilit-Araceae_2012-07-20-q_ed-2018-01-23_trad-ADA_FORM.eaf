        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>Pero metstsonkamoh a:mo, a:mo we:lik iwa:n ato:l.</ANNOTATION_VALUE>
