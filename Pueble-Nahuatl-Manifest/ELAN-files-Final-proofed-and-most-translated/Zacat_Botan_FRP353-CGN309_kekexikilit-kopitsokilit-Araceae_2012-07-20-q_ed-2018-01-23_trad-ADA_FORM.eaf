        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>n' ikowyo ke:m..., komohkó:n yo:n i:ksá: ata. Yo:n kokopisi:lmeh kiliah te:..., panki:sah,</ANNOTATION_VALUE>
