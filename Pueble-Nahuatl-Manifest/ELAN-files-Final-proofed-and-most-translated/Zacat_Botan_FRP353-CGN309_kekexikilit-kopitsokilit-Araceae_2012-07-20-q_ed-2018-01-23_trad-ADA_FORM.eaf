        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>también se mueren, pues imaginate nada mas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a533" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>Causa comezón, pero si se lo pones pero no lo sentimos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a534" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>pues (no) nos provoca comezón en la boca porque le ponemos mucho picante</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a535" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>Y sale muy picoso, entonces no sentimos qué es lo que nos causa ardor en la boca, si acaso es el picante,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a536" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>o ..., o es el comezón que provoca ese quelite, ya no lo probamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a537" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>Ya no lo sienten.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a538" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>Quizá sea cierto, quizá sea cierto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a539" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>Pues como nosotros cada vez que lo comimos, siempre lo comimos con picante, no sabemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a540" ANNOTATION_REF="a308">
                <ANNOTATION_VALUE>Entonces también lo conoces..., florea y también sabes (que al florear), desaparece la mata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a550" ANNOTATION_REF="a310">
                <ANNOTATION_VALUE>Eso que es lo que yo pensé, si acaso sabes , quizá solamente yo sepa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a551" ANNOTATION_REF="a311">
                <ANNOTATION_VALUE>A:, bueno. Entonces este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a552" ANNOTATION_REF="a313">
                <ANNOTATION_VALUE>ya no (te pregunto) más señora, solamente eso quería preguntarte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a553" ANNOTATION_REF="a314">
                <ANNOTATION_VALUE>preguntarte porque este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a554" ANNOTATION_REF="a315">
                <ANNOTATION_VALUE>quizá..., que nos contemos que es lo que no..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a555" ANNOTATION_REF="a316">
                <ANNOTATION_VALUE>Preparamos nuestra comida. Es cierto, es cierto, porque este..., Pero ahora vamos viendo que todo ha cambiado , ahora (se consume) más el pollo criado en granjas (alimentado con alimento industrial), nos lo ponen y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a556" ANNOTATION_REF="a318">
                <ANNOTATION_VALUE>Parece que no es muy bueno, pero es mejor (alimentarse) el metstsonkilit y el kekexikilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a557" ANNOTATION_REF="a320">
                <ANNOTATION_VALUE>Y frijoles, que también lo preparemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a558" ANNOTATION_REF="a322">
                <ANNOTATION_VALUE>El wa:wkilit y el tomakilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a559" ANNOTATION_REF="a324">
                <ANNOTATION_VALUE>Sí, pues también nos fortalece.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a326">
                <ANNOTATION_VALUE>Ahah. Entonces una vez más nos despedimos señora y otra vez nos veremos en algún dia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a561" ANNOTATION_REF="a328">
                <ANNOTATION_VALUE>Cuando sepamos más sobre los alimentos que consumimos y nos sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a330">
                <ANNOTATION_VALUE>Este, bueno..., así quedamos señora, ya me voy pues.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
