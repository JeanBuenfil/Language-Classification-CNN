                <ANNOTATION_VALUE>Ompa kihtowah telwe:lik wa:n neli ka:mpa yo:n a:chia:wit onkak, a:mo kite:xi:mah, a:mo kitsontekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
