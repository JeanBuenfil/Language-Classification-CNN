        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Motso:yo:iskaltia. Yo:n kipolowa ne:n tapala:nti.</ANNOTATION_VALUE>
