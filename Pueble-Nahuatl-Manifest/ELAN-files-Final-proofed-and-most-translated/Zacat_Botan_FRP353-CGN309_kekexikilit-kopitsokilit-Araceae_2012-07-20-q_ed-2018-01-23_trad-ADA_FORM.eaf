        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Pos yo:n tikwah para mahyá: taxkal wa:n sepa ne:n ixiwyo pos kwaltsi:n we:lik de ika emo:l.</ANNOTATION_VALUE>
