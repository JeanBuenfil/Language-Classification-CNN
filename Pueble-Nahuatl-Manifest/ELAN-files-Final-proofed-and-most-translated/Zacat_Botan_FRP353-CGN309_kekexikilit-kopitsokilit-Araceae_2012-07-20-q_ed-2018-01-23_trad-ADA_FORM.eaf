        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>Axá: neli os mohkó:n, neh a:mo ke:man. Neh a:mo ke:man nitai:k yeha yo:ni.</ANNOTATION_VALUE>
