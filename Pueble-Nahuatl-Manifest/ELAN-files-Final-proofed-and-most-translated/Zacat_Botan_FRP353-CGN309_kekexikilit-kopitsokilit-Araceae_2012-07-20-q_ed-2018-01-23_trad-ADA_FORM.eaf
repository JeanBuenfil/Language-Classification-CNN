        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>'Sentanelowah wa:n ke:mah te:chtamah ika yo:n tapalo:l. A:mo, a:mo ki:sa ahwayoh, pero neli o:me taman onkak yo:n.</ANNOTATION_VALUE>
