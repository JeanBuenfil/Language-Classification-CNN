        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>metstsonkilit a wa:n iwa:n kima:nelowa ya n' ekexikilit a:mo moyekowa ok.</ANNOTATION_VALUE>
