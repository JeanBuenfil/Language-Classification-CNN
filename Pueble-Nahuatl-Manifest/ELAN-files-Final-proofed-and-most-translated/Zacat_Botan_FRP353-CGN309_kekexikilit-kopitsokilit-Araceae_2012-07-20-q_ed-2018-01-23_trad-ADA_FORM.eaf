        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Neh nitai:k *sólo** ato:lkamoh, pero no: yeha yo:n ato:l.</ANNOTATION_VALUE>
