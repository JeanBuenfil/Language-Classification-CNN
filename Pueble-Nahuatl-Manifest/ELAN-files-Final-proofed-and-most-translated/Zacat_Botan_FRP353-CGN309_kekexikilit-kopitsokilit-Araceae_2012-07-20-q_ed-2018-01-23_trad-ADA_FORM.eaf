        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>*más** we:lik *que** witsti. *Más** we:lik *porque** kwaltsi:n wahwa:kkatik.</ANNOTATION_VALUE>
