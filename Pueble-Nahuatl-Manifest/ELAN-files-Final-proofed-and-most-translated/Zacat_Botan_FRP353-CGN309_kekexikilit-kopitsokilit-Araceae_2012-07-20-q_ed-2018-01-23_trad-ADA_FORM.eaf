        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>*este**, tsikilitsi:n tixti x'ma:nelo, entó:s kwaltsi:n ki:sa n' emo:l.</ANNOTATION_VALUE>
