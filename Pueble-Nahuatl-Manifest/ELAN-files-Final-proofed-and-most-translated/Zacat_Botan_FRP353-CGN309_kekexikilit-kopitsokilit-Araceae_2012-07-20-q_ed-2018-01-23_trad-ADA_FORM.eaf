        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>komohkó:n de yo:n nik..., nimitsilia *es...**, ne: ki...,</ANNOTATION_VALUE>
