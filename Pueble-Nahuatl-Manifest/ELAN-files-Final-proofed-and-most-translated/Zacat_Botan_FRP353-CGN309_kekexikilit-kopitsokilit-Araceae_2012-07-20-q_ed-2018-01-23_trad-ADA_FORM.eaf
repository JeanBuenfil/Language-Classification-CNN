        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>Yeh kipixkiliya wa:n kwaltsi:n kima:nelowa wa:n ....</ANNOTATION_VALUE>
