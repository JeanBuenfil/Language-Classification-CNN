            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Wa:n nika:n *loma** ka:mpa *notiowa:n** onkak tepe:chi:lkowit. Pero a:mo no:ya:n onkak yo:n tepe:chi:lkowit.</ANNOTATION_VALUE>
