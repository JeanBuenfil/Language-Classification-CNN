        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>koyoltsitsí:n wa:n kikwah papa:meh no: wa:n kikwah yo:n</ANNOTATION_VALUE>
