        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>kwaltia para kale:waltsitsí:n *o para** taihtiyo:tsitsí:n de se: kali.</ANNOTATION_VALUE>
