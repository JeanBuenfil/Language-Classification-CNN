        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>*porque** ye:kma:wehwei wa:n ima:kowyo chi:chi:ltik ne:n xiwit</ANNOTATION_VALUE>
