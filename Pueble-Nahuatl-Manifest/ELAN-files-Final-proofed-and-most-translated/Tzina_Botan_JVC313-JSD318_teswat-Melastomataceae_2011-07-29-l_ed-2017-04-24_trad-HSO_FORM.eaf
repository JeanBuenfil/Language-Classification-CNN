        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>wa:n i:xahalaxtik n' ima:ko, semi i:xahalaxtik.</ANNOTATION_VALUE>
