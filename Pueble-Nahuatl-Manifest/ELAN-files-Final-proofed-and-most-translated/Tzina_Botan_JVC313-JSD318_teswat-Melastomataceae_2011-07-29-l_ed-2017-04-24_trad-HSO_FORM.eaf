            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Wa:n *cuando** oksi a, i:n n' tihti:ltik n' iteyo n' tein chika:wak ya,</ANNOTATION_VALUE>
