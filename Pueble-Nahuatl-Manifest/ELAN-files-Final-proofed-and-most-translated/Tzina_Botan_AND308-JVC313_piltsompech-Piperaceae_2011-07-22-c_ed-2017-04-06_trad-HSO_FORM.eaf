    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="Comentarios" PARTICIPANT="Comments" TIER_ID="Comments">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>{De todos los entrevistados, A. Nicolás es el único que dice "ima:yo". Los demás dicen "ima:i".}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>{A menudo se dice te:xi:ma, con la pérdida de la /n/ de la raíz /te:n/ 'labio' o 'orilla'.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts391">
