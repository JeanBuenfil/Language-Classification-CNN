        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>Pues yo conozco al tsompechyo porque, </ANNOTATION_VALUE>
