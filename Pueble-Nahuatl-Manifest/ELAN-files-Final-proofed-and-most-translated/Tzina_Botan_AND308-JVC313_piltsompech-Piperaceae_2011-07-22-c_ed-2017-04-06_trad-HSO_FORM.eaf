        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>Se enciman como si fueran tortillas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>Se enciman y ya se llevan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>Así es, o bien se llevan con algo, ka...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>Con una bol..., bolsita o algo, en un morral también se pueden llevar o,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>o algo, las mismas hojas se pueden cortar o bien se cortan las hojas de o:mekilit para envolverlas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>También se puede. También se puede para..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>Son más largas, se amarran si hay el </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>bejuco se amarran las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>Con el bejuco delgado lo amarras en medio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>el bejuco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>que hay en la milpa se corta un pedazo y se amarran las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>Se amarra el rollo y se mete en el morral.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>O también se pueden llevar con la mano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>Sí también se puede.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>Aa, yo me..., me llamo, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a501" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>Anastacio Nicolás Damián.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a502" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>Antes vivía acá en</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a503" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>el Tozán, este cerca del río.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a504" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>después vine para acá, actualmente vivo acá que se llama Xo:pana:co.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>Le llaman Xo:pana:co porque está un a:i:chkwal a bajo de donde yo vivo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a506" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>A bajito</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a507" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>No está lejos, ahí cerca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a508" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>Por eso le dicen Xo:pana:co.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a300">
                <ANNOTATION_VALUE>ahora ya pertenezco en el</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a518" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>pueblo de San Miguel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a519" ANNOTATION_REF="a303">
                <ANNOTATION_VALUE>Es San Miguel porque es el Santo Pattrón de nue...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a520" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>es nuestro salvador. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a521" ANNOTATION_REF="a306">
                <ANNOTATION_VALUE>Entonces por eso le llaman San Miguel,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a522" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>entonces ahí vivo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a523" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>Pero yo tengo este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a524" ANNOTATION_REF="a310">
                <ANNOTATION_VALUE>un poco más de sesenta y cinco años. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a525" ANNOTATION_REF="a312">
                <ANNOTATION_VALUE>Entonces ahí vivo y pues este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a313">
                <ANNOTATION_VALUE>ahora te digo cómo me llamo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a527" ANNOTATION_REF="a315">
                <ANNOTATION_VALUE>Así es, me llamo Anastacio Nicolás DAmián. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a528" ANNOTATION_REF="a317">
                <ANNOTATION_VALUE>Pues.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
