        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>llevan.No se lleva junto con sus tallos. Son las puras hojas. Se usa..., las hojas se cor..., siquiera un rollo, se cortan y luego se..., llevan. (La transcripción del nahuat no corresponde a Anastacio)</ANNOTATION_VALUE>
