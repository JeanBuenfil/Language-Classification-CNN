        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>Kichi:wa *siquiera** o:me oso e:yi xiwit. Ke:mah.</ANNOTATION_VALUE>
