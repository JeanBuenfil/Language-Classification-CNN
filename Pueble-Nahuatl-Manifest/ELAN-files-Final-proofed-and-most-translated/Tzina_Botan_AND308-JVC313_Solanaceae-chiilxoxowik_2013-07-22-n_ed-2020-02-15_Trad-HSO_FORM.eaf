            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>A:mo a:skayowa. A:mo, a:mo teh kichi:wiliah yo:n. Eh, ke:..., ke:mah.</ANNOTATION_VALUE>
