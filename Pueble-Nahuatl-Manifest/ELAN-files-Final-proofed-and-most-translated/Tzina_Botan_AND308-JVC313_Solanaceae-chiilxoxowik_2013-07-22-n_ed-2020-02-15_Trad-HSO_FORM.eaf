        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Wa:n seki ne:n chi:l yo:n *mohmorado** mopahpampilowa.</ANNOTATION_VALUE>
