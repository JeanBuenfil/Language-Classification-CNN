                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n. Yehwa niki:xmati de chi:l..., de chi:lxoxowik niki:xmattok yehwa yo:ni. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
