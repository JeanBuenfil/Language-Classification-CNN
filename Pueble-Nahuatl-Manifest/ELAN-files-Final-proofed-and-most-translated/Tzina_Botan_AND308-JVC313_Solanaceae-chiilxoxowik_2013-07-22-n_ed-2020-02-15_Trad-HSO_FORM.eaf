        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>Chihchihkoltik. [Y]o:n, yo:n a:mo, a:mo koko:k wa:n</ANNOTATION_VALUE>
