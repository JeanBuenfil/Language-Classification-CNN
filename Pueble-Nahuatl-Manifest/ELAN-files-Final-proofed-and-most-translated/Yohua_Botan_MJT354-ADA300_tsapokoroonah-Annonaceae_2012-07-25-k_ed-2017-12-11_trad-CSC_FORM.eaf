        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>A:h. Ke:mah pero i:n tsapokoro:nah a:mo nimo..., a:mo ke:man nikitani, ne:n, ....</ANNOTATION_VALUE>
