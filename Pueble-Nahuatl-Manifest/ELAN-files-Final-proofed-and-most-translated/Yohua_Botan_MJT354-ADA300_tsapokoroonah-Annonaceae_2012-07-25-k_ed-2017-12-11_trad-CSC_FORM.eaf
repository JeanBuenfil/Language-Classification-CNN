        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>Ke:mah, neh n..., neh nimitsilia pawihwitstik mahyá:.</ANNOTATION_VALUE>
