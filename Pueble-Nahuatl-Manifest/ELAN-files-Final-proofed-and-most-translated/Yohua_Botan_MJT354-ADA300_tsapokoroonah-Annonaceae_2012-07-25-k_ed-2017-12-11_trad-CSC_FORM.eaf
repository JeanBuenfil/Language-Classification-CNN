        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>Ke:mah, iwkitik mahyá: yo:n seki tsapot ata kiliah ne: *guanábana**, sayoh *que** yeh i:xtapalweyak.</ANNOTATION_VALUE>
