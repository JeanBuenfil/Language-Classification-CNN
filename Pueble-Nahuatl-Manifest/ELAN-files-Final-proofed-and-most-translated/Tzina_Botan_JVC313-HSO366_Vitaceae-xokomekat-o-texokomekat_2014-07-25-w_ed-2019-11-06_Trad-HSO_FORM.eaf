                <ANNOTATION_VALUE>Wa:n yo:n a:t pos ki:sa kachi itech i:n komekat, *más** chipa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>*Igual** n' ta:tahmeh tai:yah, tehwa:n te:chne:xtilihkeh no: 'tai:yah tehwa:n ke:meh ne: kowtah 'tekitiah, ne: a:na:l titekitiah.</ANNOTATION_VALUE>
