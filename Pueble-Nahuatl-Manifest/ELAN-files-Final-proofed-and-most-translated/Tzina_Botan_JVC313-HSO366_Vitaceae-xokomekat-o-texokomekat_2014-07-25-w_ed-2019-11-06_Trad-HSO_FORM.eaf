        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Ke:mah kwaltsi:n we:lik yo:n atsi:n, chipa:wak a:t kachi kwaltsi:n ke a:mo ne:n a:meyal *porque** a:meyal pitsotik yo:n a:t ke:meh i:n ta:taih pitsotik.</ANNOTATION_VALUE>
