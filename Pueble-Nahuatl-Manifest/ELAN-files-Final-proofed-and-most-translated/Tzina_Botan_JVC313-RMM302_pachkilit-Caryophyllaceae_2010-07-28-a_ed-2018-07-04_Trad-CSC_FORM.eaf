        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>Aja, yo soy Ernesto Vázquez</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Si ese pachkilit se da en ls cafetales o se da en cuaquier orilla de camino, ese no se chiquea. Eh, ese nace por si solo, no lo riega uno, nada más se da ese quelite.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Y sabe rico, lo ocupa uno para, eh, lo come uno hervido, lo asa uno en el comal y sabe bien rico ese...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Eso es todo, ese lo come uno..., como la hierba mora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Ellos mi..., mis padres como este... </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Como cortábamos..., en los cafetales pues ahí se da y, y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>lo cortaba mi abuela finada, lo cortaba y,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>y así lo comiamos y, si no, si no lo comíamos así solo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>cortabamos unos ste..., ibamos por hojas de plátano, esas hojas de plátano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>y echan hoj.., en las hojas y le ponen..., le riegan un poco de agua para que se moje</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>y le echan sal</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>y lo..., lo envolvián con hojas y lo echaban en el fuego, ese lo echan en el fuego, ese pachkilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Sabe muy rico, come uno bonito con eso en el monte. Quelite asado. Si, eso es. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>No lo conocen. Si y ese ihtikoyokkilit también, también..., lo comiamos también..., también lo... También, también sabe muy rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>Ka..., ka..., ya no lo conocen. Como el wehweikilit también lo..., lo..., unos ya no lo comen, se lo quieren comer, les lastima en la boca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>Este..., si y...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>El quelite ya no lo quieren, ahora ellos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>ahora ya quieren comer como gente de ciudad, este a veces se van a la ciudad a trabajar en lo ajeno y cuando ya regresan ya no comen nada ni los que lites que nosotros todavía comemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
