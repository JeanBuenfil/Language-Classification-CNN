        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>No: kwaltsi:n, *este**, ti..., nika:n timotapowi:tih tein</ANNOTATION_VALUE>
