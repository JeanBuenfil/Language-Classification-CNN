    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Rubén Macario Martínez" PARTICIPANT="Rubén Macario Martínez" TIER_ID="RMM Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>Ya est+a usted don Ernest, yo me llamo Rubén Macario</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>También es bonito, este, ti..., aquí nos vamos a platicar lo que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>venimos conociendo hace uns `días atrás, nuestros padres, nuestros  antepasados, nuestros abuelos nos habían enseñado y nos habían dicho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>como se llaman los tipos de hierbas que hay aquí en la tierra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>usted a lo mejor lo conoce, también lo conoces, este, le dicen pachkilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>Y eso usted también lo supiste porque te..., te habían enseñado tus..., tus padres, este, hace tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Lo..., quuieres decir como si fuera quelite asado, quelite asado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>Y eso, eso es, de verás sabe muy rico, ese quelite sabes como lo hacen como ese pachkilit, como el witskilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Toda esa hierba, sabe muy rico el quelite asado, este el witskilit, la hierba mora, el quiltonil, el pachkilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>Todo eso nosotros no, a:, bueno, ahora nuestros hijos ya no lo conocen pero nosotros sabemos porque nosotroa crecimos con eso. Ahora de verás ese ihtikoyokkilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Si pero ahora nuestros hijos veo que parece que como decimos nosotros, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>lo..., ya se comportan como gente de ciudad, no como nosotros crecimos. Ya no lo conocen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>Eso es, eso es lo que ya veo de verás y pues nosotros,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>como ese a lo mejor, hace, hace tiempo sufriamos mucho o no sé como pero </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>yo veía que nosotros todo..., todo lo comíamos, el quelite lo conocemos pero</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>de verás que en la actualidad nuestros hijos no..., ya no es igual como en la actalidad nosotros crecimos. Ahora ellos ya no son así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Con eso se..., se van a enseñar por allá en la ciudad. Por eso ya cuando llegan acá, cuando llegan acá yo digo que nos...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Nos ven raro cuando ven que nosotros..., comemos cualquier quelite, luego nos dicen que por qué lo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Y de verás que así dicen ellos  pero pues es porque no saben lo que dicen porque nosotros ya nos acostumbramos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>Ya nos acostumbramos. No, nos gus...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Ándale, eso de verás que no le gusta a uno y...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>Sabes nosotros es porque ya nos acostumbramos de verás, como nosotros siempre..., allá, hace tiempo con eso nos mantuvimos o con eso nos mantenían nuestros padres pues,  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>hasta en la actualidad nosotros no olvidamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Y pues has de saber que a veces </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>usted don Ernesto, a la vez es bueno porque todo lo que son las hierbas, como los quelites </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>pues nosotros decimos es más, mas este, es más nutritivo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>Hay que pensar que..., hay que pensar que mire don Ernesto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>como crece un, un animalito, un res,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>un pollito, un guajolote, un marranito, si no es con hierba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Entonces y no lo..., no vamos a ver nosotros un animalito</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>que coma como comemos nosotros, decimos que es muy grasoso y un animalito come como sea y un animal es más fuerte que nosotros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Y se les dice a nuestros hijos pero nuestros hijos solo les da risa cuando se les dice...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>no les gusta escuchar eso, no les gusta escuchar eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Pero...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Eso es, eso a lo mejor...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>No nos gusta, nosotros lo...</ANNOTATION_VALUE>
