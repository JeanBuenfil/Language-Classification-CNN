                <ANNOTATION_VALUE>nada más hay que tener salud.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>Y de verás es así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>Exactamente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>Pues sabes eso a lo mejor, es, ese también se da cuenta la que está creciendo un hijo..., unos padres tenemos la culpa y otros los hijos tienen la culpa si..., aprenden pero es ese aparato, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>el aparato este, que lo muestran en ese, este los programas de la ciudad, en la televisión.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a287">
                <ANNOTATION_VALUE>Eso es lo que ya lo..., lo ven ahí lo ven todo, todo eso que muestran de todo ahí, también los hijos. Ellos no nada más lo ven, pues ellos presionan que también lo quieren.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>Lo quieren comer, ya lo quieren comer lo de la ciu..., comida de la ciudad pero pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>de verás como dice usted, de verás esa comida de la ciudad es nada más para la enfermedad.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>Nada más para enfermedad.</ANNOTATION_VALUE>
