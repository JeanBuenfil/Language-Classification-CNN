        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>No nos gusta, pues de verás que a nos acostumbramos, nosotros ya nos acostumbramos de verás</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>Ya nos acostumbramos a nuestra comida indígena pporque la comida de ciudad sabe diferente y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>de verás como dices hace rato pues..., y..., ahora nuestro..., ahora decimos que en este tiempo parece que es muy..., es muy..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>es mucho. Ya tiene muchas cosas la comida, no es igual como hace tiempo nosotros lo comiamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
