        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Porque como ahora nosotros decimos que muchas enfermedades nos caen pero no porque, no porque siempre es así, siempe es así, este, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>el tiempo viene cino que viene por medio de que nosotros lo..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>¿Comida? Ya la comida, ya la comida, eso es. Eso, ya eso es, ya eso es, ya eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>Como nuestros frutos igual también..., ahora vemos que nuestros frutos si no le ponemos abono, si no es por el abono no va acrecer y tampoco va a dar, y pasa lo mismo con nosotros digo yo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>Nue..., nuestros hijos también, si no comen comida de ciudad</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>empiezan..., empiezan a debilitarse, empiezan, este, ton... Bueno decimos nosotros enfermedad, ya se enferman.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>Ya se enferman y nosotros estamos acostumbrados como, comemos como sea aunque sea con quelites, como sea pero pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>parece que estamos mejor digo yo, que..., que..., decimos nosotros que parece que estamos más sanos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>Ya nos acostumbramos con eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>Ándale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>Y pues ha de ser mejor pero</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>es más rico en aroma, porque de verás que ese aparato que dices que trabaja con energía electrica.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>Parece que lo..., lo..., como decimos nosotros, este, lo..., le quita el sabor. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>El sabor, porque parece que no tiene sabor aunque preparan caldo de salsa roja con eso así...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>lo comemos nosotros pero le digo yo si es que lo muelen con ese aparato le digo yo parece que no tiene sabor. Ya no le toma uno sabor. Y como el que lo muelen con metate..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>Sabes que el que lo muelen con metate también, hasta la comida también sabe rico este, tiene un olor muy rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>como este, como este, hasta como las tortillas que nos ponen, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>yo digo que si las tortillas son hechas a mano son más ricas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>Y si es como este lo..., lo compramos nosotros allá en Cuetzalan que nos traen las tortillas pues ya no saben igual de ricasw.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Ya no es lo mismo, a..., a..., aja, así, asi es de verás, así es de verás y es cierto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>Si estabamos laticando de esa hierba decimos nosotros, ese pachkilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>Y ese pachkilit yo le llamo, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>pues ahora nuestros lugares ya no les gusta y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>nosotros con eso crecimos, de verás como decimos, lo..., lo cortaban nuestros abuelos y l..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>lo envuelven con una hoja (de plátano).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>Yo me acuerdo y lo ponen en el comal y ya van a traer un chile,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>un chile verde y lo muelen un poco, le ponen un jitomate y ya comemos nosotros. Ya come uno, si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>Ándale. Eso es, eso es, eso es de verás, eso es de verás.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>Eso es de verás. Eso. Ahora ya no se conoce.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>Eso es, eso es de verás.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Eso es de verás, eso es de verás con lo que comíamos nosotros, eso todo me acuerdo yo como...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>De verás como también lo..., también ya tenemos edad nosotros, también lo..., ya sabemos como crecimos en aquel, en aquel tiempo cuando,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>cuando, este, nuestros padres nos..., nos daban el ejemplo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>Y de verás como dices tu, ellos nuestros abuelos también, nue..., nuestros padres eso según..., lo..., nuestros padres eso según lo..., lo envolvían cono hoja de mazorca esa sal</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>y lo llevaban al monte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a250">
                <ANNOTATION_VALUE>Yo me acuerdo cuando yo crecí, tenía a lo mejor, tenía como, como doce años,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a451" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>Yo trabajaba por acá en la zona baja, aquí un, un, un pueblito que se llama, este, Tenampulco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a452" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>No pues este allá, por allá trabajaba yo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>Y de verás como dices también..., también..., también..., mi madre</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>iba atra..., ya llevaba la sal y como sabíamos que allá donde trabajabamos nosotros había mucho ese chiltepin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>Ese chiltepin, el chiltepin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>Y ese tomate silvestre, ese que le llamamos si:taltomat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>Y llegaba mi..., mi madre dice, este, "no traje comida</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>pero lo..." También nosotros lo..., les decimos, les decía también..., mi madre, yo también, también, también le dice, "pero" le dice, "pero no se necesita comida" le dice, "comida aquí", le dice, "tenemos".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>De verás ya íbamos por esa hierba mora, un manojo de hierba mora,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>y de verás que ya iban a traer ese chiltepin, cortamos unos dos, un pu..., un puñado </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a468" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>y siquiera unos ese..., este jitomate, ese tomate chiquito que te digo </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>y ya hacemos un palito que cortamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>Un palito y lo..., lo cortamos bien y lo alisamos y entonces</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>ya vamos por hojas de mazorca, del más delgado lo hacemos doble, lo hacemos triple la hoja de mazorca y entonces ahí ya molemos ese, y ya molemos ese chile y el jitomate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>De ahí ya lo molíamos. Ya comiamos, de verás como dices tu. Ya comíamos y de que uno es, de que uno está creciendo digo yo uno nada más..., come uno muy bien, tiene uno mucho apetito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>Y de verás, y de verás, de verás es así, si, si ya.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>Pues ya es así de verás, como nosotros los indígenas nos mantenemos como sea y sabes a veces es mejor porque estamos mejor, de verás también más lo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
