        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>Kipia witsti. Ke:mah. Yeh witsyoh wa:n yo:n *morado** a:mo witsyoh. Mm. Ke:mah. Se: ka:wiltia, ke:mah, se: ki...</ANNOTATION_VALUE>
