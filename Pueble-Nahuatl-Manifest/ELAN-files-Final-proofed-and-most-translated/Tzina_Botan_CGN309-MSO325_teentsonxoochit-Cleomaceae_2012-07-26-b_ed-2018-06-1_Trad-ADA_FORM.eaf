                <ANNOTATION_VALUE>kitekiah yo:n sintsí:n tein oho:me sinti kwa:lkwih, kisentekih iwa:n ikowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>wa:n kichi:wayah se: *cruztsi:n** wa:n yo:n xo:tsitsí:n yehwa n' kita:lia:yah no: *cruz** wa:n ika tachihchi:wayah, kita:lilihtehkoh *santoi:xte:noh**.</ANNOTATION_VALUE>
