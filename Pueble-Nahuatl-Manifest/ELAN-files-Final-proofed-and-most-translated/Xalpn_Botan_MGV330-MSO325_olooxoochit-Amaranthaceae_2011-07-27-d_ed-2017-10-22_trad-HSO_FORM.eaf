            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>Sí, yo solo esa flor. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>Solo esas flores las uso para adornar, mm. Mm, exactamente.</ANNOTATION_VALUE>
