    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="María Guadalupe Vázquez" PARTICIPANT="María Guadalupe Vázquez" TIER_ID="MGV Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>Este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>Nosotras allá junto a la casa la..., regamos las semillas, pero como que regamos muy pocas, lo que es, lo que com...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>sino, sino se dan muchas flores,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a50">
