            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Y las flores que son..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>deben quedar al frente cuando se hace el arreglo, como que es el que le llamamos </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>sempowalxo:chit y la flor de sempiterna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Se ponen juntas. Como que se van alternando los colores, como que.</ANNOTATION_VALUE>
