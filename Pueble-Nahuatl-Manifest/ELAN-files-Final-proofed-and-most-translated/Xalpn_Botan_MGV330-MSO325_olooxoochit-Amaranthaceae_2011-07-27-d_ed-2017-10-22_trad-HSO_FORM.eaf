            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>También las compro. Y cuando se..., como te decía que cuando se secan, es igual como el sempowalxo:chit, también es igual.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>También se, también se desmoronan con las manos así, como que se..., se..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>se desmoronan y se riegan en un lugar donde</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>está despejado el terreno, yo la..., las riego en un lugar...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>despejado allá en mi cafetal, ahí como que las..., las riego. También, también se..., todo se lim...., así es también se desyerba y este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>este, de ahí se, se cuidan las plantas para que los animales no se las coman, como que, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>entonces se dan bien las flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>Son dos tipos de flores, si se riegan las semillas de esos dos tipos también se dan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>Sólo hay esos dos como que yo las..., riego las semillas de las flores blancas y de las rojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Sólo esos dos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>Claro que sí, si esas flores yo también las..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>as..., también se hace así en Todo Santos nosotras como que las usamos para adornar, las vamos alternando con el sempowalxo:chit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>Como que se adorna con los dos tipos de flores, también se..., se hace el adorno en el altar y para..., el adorno en los floreros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>Mm. Se pone el adorno con floreros junto con el sempowalxo:chit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a169" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>Pues hay una planta que le llamamos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>lo han de conocer esa planta que le llaman flor de garase:niah drasena, si haz escuchado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>Las plantas crecen erectas, tienen las hojas alargadas que le llaman garase:niah (drasena).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>También es..., una flor, hay dos tipos, el primero es blanca y segundo es roja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>Es esa planta como que se..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>como que cuando se hace el arreglo en el florero, las hojas se van acomodando detrás de las flores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a82">
