        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a210" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>No, porque algunas flores todavía están así como bolitas pequeñas. Ehe. Las flores que ya están recias. Mm. Se cortan las que ya están recias y las chiquitas se van dejando para que se</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a115">
