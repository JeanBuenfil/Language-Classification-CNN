        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Yo:n a:mo moneki semi telw..., wehwei kale:waltsitsí:n, yo:n achi kahkana:wak *porque** yo:n ye:ktakwa:wak.</ANNOTATION_VALUE>
