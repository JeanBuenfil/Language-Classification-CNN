    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Pues aquí puedes decirme</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>para qué sirve el kakatekowit</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>También.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>¿Y cómo son las hojas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>Dos hoyos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>Pues compadrito, yo también voy a contarte de lo sé de kakatekowit, sé que sirven para horcones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>Pues lo ocupan para</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>alfardas o</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>a veces lo ocupamos para tirantes y para la pieza que le llaman como tate:nilpil.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>(La pieza que va) arriba, el que le llaman como </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>cargador,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>uno que está así, todo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>todo se puede ocupar del tronco del kakate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>Entonces lo aserran y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>también sé que el tronco del kakate </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a501" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>tiene savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a502" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>Tiene savia y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a503" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>Cuando el tronco se arecia, hay unos bichos dañinos) que perforan la madera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a504" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>Lo perforan y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a505" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>..., la madera (que está puesta en la estructura) de la casa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a506" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>toda está perforada, (tiene dimunutos agujeros)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a507" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>Si,las hojas, este, son alargadas y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a508" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>las ramas también sirve para leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a509" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>Arde muy bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a510" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>Solo que es muy pesado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a511" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>Muy pesado,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>Esa madera es muy pesada. Todo el árbol se le da uso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a513" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>sirve para leña o cuando vemos que está está tirado en el monte, de ahí lo recogemos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a514" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>lo cortamos y nos lo traemos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>arde muy bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>Al estar seco, arde muy bien,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>Y pues yo veo que el tronco </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a518" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>tiene savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a519" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>Contiene savia y es cierto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a520" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>que crece muy grande el árbol y le salen muchas ramas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a521" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>Le salen muchas ramas y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a522" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>en algunas partes podemos encontrarlos muy derechitos y son los que sirven para alfardas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a523" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>También sirve</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a524" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>Cuando los árboles crecen pues ya los cortan,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a525" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>si, los cortan con la sierra y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>pues de esa madera se ocupa para construir una casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a527" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>O en algunas partes hay, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a528" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>se tumban así de delgados pues se necesita para construir la casa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a529" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>Para cargador, se ocupa el kakate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a530" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>Pero los que ya son trozos muy gruesos los parten </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a531" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>con la sierra, así lo hacen,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>previamente sacan las medidas que tanto de largo se necisitan (de acuerdo al tamaño de la casa que se va a construir) y ya los cortan con la sierra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a533" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>Para aserrar el trozo, previamente tienen que arreglar una especie de tarima para acomodar el trozo y luego partir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a534" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>la madera, pues para cortar es necesario</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a535" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>saber cuantos se necesita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a536" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>A veces alcanza un..., con un árbol casi alcanza para </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a576" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>sacar los tirantes y las alfardas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a577" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>No es necesario que sean muy grandes, pueden ser un poco delgados porque son muy resistentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a578" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>A veces yo veía...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a579" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>que la corteza se pudre y se cae</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a580" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>y solamente se queda la médula, la médula es rojo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a581" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>La médula es de color rojo y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a582" ANNOTATION_REF="a269">
                <ANNOTATION_VALUE>esa madera es muy resistente, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a583" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>ya puesto como horcón, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a584" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>puede pudrirse la parte superficial pero la médula queda,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a585" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>Se queda la médual como el ma:kankeh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a586" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>Se queda de este tamaño, (aún así) soporta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a587" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>Mm. Y los que (se tumban) aún son árboles jóvenes, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a588" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>se tumban,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a589" ANNOTATION_REF="a279">
                <ANNOTATION_VALUE>se cortan de este tamaño y se entierran</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a590" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>pues se pudren al pie y se caen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a591" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>Se caen. Cuando se cortan así, no son tan resistentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a592" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>El árbol no es tan resistente y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a593" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>el árbol que ya está maduro es el que tiene la médula rojiza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a594" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>Es rojizo y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a595" ANNOTATION_REF="a289">
                <ANNOTATION_VALUE>hasta la corteza es muy resistente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a596" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>Cuando el árbol ya es recio, la corteza es muy resistente. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a597" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>Si. Es muy resistente. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a598" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>tiene unas rayitas en la superficie del tronco</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a599" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>Y el árbol recio </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a600" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>una vez que el árbol se arecia, en la parte más alta ya no tiene tantas hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a601" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>Ya no tiene tantas hojas, se le caen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a602" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>Al areciarse, se le caen las hojas pero cuando los árboles son jovenes, tiene las hojas muy tiernas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a603" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>(Si), cuando aún está en desarrollo. Eso es lo que yo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a604" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>también he visto. Tú también sabes. También conoces el kakatekowit y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a605" ANNOTATION_REF="a306">
                <ANNOTATION_VALUE>es verdas, los frutos salen colgados así y tornan a ser de color negro</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a606" ANNOTATION_REF="a308">
                <ANNOTATION_VALUE>Así son de largos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a607" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>Y esos frutos también se comen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a608" ANNOTATION_REF="a310">
                <ANNOTATION_VALUE>Los frutos son comestibles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a609" ANNOTATION_REF="a312">
                <ANNOTATION_VALUE>Son comestibles pero yo no sé si también se comen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a610" ANNOTATION_REF="a313">
                <ANNOTATION_VALUE>los pájaros o los tejones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a611" ANNOTATION_REF="a316">
                <ANNOTATION_VALUE>Ah. Los tejones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a612" ANNOTATION_REF="a320">
                <ANNOTATION_VALUE>Ah. El kowtancho</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a613" ANNOTATION_REF="a322">
                <ANNOTATION_VALUE>El marto, es el que le llaman kowtancho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a614" ANNOTATION_REF="a324">
                <ANNOTATION_VALUE>Entoces..., yo nunca, nunca he visto eso, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a615" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>he visto los frutos ahí colgados,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a616" ANNOTATION_REF="a326">
                <ANNOTATION_VALUE>a veces los que se caen, los levantamos para comerlos, son dulces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a617" ANNOTATION_REF="a328">
                <ANNOTATION_VALUE>Son frutos al madurarse son negros y son dulces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a618" ANNOTATION_REF="a330">
                <ANNOTATION_VALUE>Aha, son verdes y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a619" ANNOTATION_REF="a332">
                <ANNOTATION_VALUE>En algunas partes, los frutos se caen y si uno va debajo del árbol, uno puede resbalarse por la descomposición de los mismos. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a620" ANNOTATION_REF="a334">
                <ANNOTATION_VALUE>se amontona y está en descomposición </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a621" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>y se van descascarando, por dentro son verdes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a622" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>Y quizá (los tejones) les gusta alimentarse de esos frutos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a623" ANNOTATION_REF="a340">
                <ANNOTATION_VALUE>a los que les llamamos tejones y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a624" ANNOTATION_REF="a342">
                <ANNOTATION_VALUE>dices que el kowtancho también se alimenta de esos frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a625" ANNOTATION_REF="a344">
                <ANNOTATION_VALUE>Porque el kowtancho se sube al árbol,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a626" ANNOTATION_REF="a346">
                <ANNOTATION_VALUE>salta de una rama a otra, trepándose con la cola. Nosotros sabemos porque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a627" ANNOTATION_REF="a348">
                <ANNOTATION_VALUE>En las noches, cuando íbamos a cazar, ahí aprovechábamos para cazarlos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a628" ANNOTATION_REF="a350">
                <ANNOTATION_VALUE>( Cuando se acerca) algunos dicen, ya se escucha el ruido de las hojas (provocado por el kowtancho),</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a629" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>Y algunos comentan, por ahí viene el kowtancho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a630" ANNOTATION_REF="a354">
                <ANNOTATION_VALUE>Se trepa con la cola,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a631" ANNOTATION_REF="a356">
                <ANNOTATION_VALUE>Se trepa con la cola y va saltando de rama en rama. Ya se sube en lo más alto del árbol y ahí está rasgándose</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a632" ANNOTATION_REF="a358">
                <ANNOTATION_VALUE>Pues también</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a633" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>Pues uno ya sabe, cuando uno va a esos lugares, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a634" ANNOTATION_REF="a361">
                <ANNOTATION_VALUE>se buscan (esos animales)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a635" ANNOTATION_REF="a363">
                <ANNOTATION_VALUE>Eso es lo que yo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a636" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>Solamente conozco al kakatekowit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a637" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a638" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>Puedes contarme</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a639" ANNOTATION_REF="a370">
                <ANNOTATION_VALUE>si florea o cómo es la flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a640" ANNOTATION_REF="a377">
                <ANNOTATION_VALUE>Y no sabes en que,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a641" ANNOTATION_REF="a379">
                <ANNOTATION_VALUE>en que tiempo florea, en qué mes,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a642" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a643" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>Pues...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a644" ANNOTATION_REF="a388">
                <ANNOTATION_VALUE>siempre los he visto colgados, en forma ensartada,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a645" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>cuando los frutos son tiernos, son pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a646" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>Cuando aún son tiernos son verdes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a647" ANNOTATION_REF="a393">
                <ANNOTATION_VALUE>Yo lo veía por allá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a648" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>lo he visto pero nunca lo he visto floreando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a649" ANNOTATION_REF="a396">
                <ANNOTATION_VALUE>Nunca lo he visto florear,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a650" ANNOTATION_REF="a397">
                <ANNOTATION_VALUE>quizá por lo alto que es el árbol, por eso nunca nos fijamos cuando florea, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a651" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>he andado y a veces veo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a652" ANNOTATION_REF="a400">
                <ANNOTATION_VALUE>(que los frutos) aún son tiernos y así de largos (quizá los racimos)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a653" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>Son tiernos. Y una vez que se maduran, la cáscara ya torna a ser negro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a654" ANNOTATION_REF="a403">
                <ANNOTATION_VALUE>Tornan a ser negros, poco a poco tornan a ser negros, porque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a655" ANNOTATION_REF="a404">
                <ANNOTATION_VALUE>(de tiernos) son verdes y posteriormente tornan a ser </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a656" ANNOTATION_REF="a406">
                <ANNOTATION_VALUE>amarillos. Después tornan a negro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a657" ANNOTATION_REF="a408">
                <ANNOTATION_VALUE>Si, al madurarse son redondos, si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a729" ANNOTATION_REF="a411">
                <ANNOTATION_VALUE>Cuando se maduran</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a730" ANNOTATION_REF="a413">
                <ANNOTATION_VALUE>Al madurarse, se hacen redondos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a731" ANNOTATION_REF="a416">
                <ANNOTATION_VALUE>Pues eso es lo que yo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a732" ANNOTATION_REF="a417">
                <ANNOTATION_VALUE>todo eso, yo no sé cuando florea y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a733" ANNOTATION_REF="a420">
                <ANNOTATION_VALUE>¿Los pájaros chupan el néctar de las flores?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a734" ANNOTATION_REF="a422">
                <ANNOTATION_VALUE>Las abejas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a735" ANNOTATION_REF="a424">
                <ANNOTATION_VALUE>Quizá los colibrís, también se chupan el néctar de las flores</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a736" ANNOTATION_REF="a428">
                <ANNOTATION_VALUE>¿Y son las abejas grandes o las pequeñas?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a737" ANNOTATION_REF="a430">
                <ANNOTATION_VALUE>Mm. Y esas abejas vienen de los montes, son las que se chupan el néctar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a738" ANNOTATION_REF="a435">
                <ANNOTATION_VALUE>hacen que se caigan las flores blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a739" ANNOTATION_REF="a437">
                <ANNOTATION_VALUE>Quien sabe si, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a740" ANNOTATION_REF="a438">
                <ANNOTATION_VALUE>hay otros tipos de insectos que chupan el néctar de estas flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a741" ANNOTATION_REF="a440">
                <ANNOTATION_VALUE>¿Y las flores son dulces (Y las flores contiene néctar)? </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a742" ANNOTATION_REF="a443">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a743" ANNOTATION_REF="a445">
                <ANNOTATION_VALUE>Pues es eso lo que yo te pregunto, quizá tú sepas más,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a744" ANNOTATION_REF="a446">
                <ANNOTATION_VALUE>cómo es la flor y cuándo florea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a745" ANNOTATION_REF="a447">
                <ANNOTATION_VALUE>Y eso es, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a746" ANNOTATION_REF="a449">
                <ANNOTATION_VALUE>Yo solamente he visto</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a747" ANNOTATION_REF="a451">
                <ANNOTATION_VALUE>(los frutos) colgados</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a748" ANNOTATION_REF="a452">
                <ANNOTATION_VALUE>los frutos tiernos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a749" ANNOTATION_REF="a454">
                <ANNOTATION_VALUE>y al areciarse, se maduran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a750" ANNOTATION_REF="a456">
                <ANNOTATION_VALUE>Si, solamente eso yo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a751" ANNOTATION_REF="a457">
                <ANNOTATION_VALUE>yo sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a752" ANNOTATION_REF="a459">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a753" ANNOTATION_REF="a460">
                <ANNOTATION_VALUE>Puedes decirme cómo te llamas.</ANNOTATION_VALUE>
