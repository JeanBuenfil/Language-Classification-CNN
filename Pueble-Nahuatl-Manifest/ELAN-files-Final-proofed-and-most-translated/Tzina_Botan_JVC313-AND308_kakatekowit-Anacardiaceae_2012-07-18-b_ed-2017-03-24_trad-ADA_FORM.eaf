        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>pos yehwa yo:n ne:, se: kita:lilia ya ne:n kaltsí:n.</ANNOTATION_VALUE>
