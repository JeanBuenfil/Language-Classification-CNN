        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>ihkó:n pihpitsa:wak pos ihkó:n se: kite:ntekiti wa:n se: kita:lilia ke:meh i:n tik..., tiketsah kaltsitsí:n de k..., de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts195">
