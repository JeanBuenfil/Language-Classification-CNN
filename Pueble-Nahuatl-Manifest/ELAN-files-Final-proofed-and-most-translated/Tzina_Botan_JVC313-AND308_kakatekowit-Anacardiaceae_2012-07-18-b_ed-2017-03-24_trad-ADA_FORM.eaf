        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>horcones. Hace tiempo lo ocupábamos para horcones de nuestra casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Iban a tumbar el árbol y el tronco (del kakate) dura mucho tiempo porque tiene la médula.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>El más qrueso, tiene la médula,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>como ahora ya no lo seguimos utilizando, la gente ha dejado de usar horcones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Antes, si la casa iba a ser grande, ocupaban los troncos del </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a164">
