            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>pos ka:nsika no: se: kita ihkó:n de n' mehmela:wak kwaltia para ne:n kale:walmeh.</ANNOTATION_VALUE>
