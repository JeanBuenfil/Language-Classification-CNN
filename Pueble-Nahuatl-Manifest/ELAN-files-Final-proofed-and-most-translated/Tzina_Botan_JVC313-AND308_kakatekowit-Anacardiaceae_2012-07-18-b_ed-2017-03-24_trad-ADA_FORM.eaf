        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Ke:masá: ahsi para se: t..., se:, ika se: kowit *cerca** ahsi, ne:n, para ne:n,</ANNOTATION_VALUE>
