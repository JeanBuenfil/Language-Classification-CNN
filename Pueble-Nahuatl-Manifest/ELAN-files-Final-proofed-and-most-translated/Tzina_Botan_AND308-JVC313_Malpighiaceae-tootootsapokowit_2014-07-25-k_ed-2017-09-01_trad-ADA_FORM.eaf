        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Pos *ya que** nika:n tine:chilia ke no:, a:cha: no: we:lik</ANNOTATION_VALUE>
