        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>i:n ita:kka wa:n nimitsilia ne:n neh a:mo no: nikmati kwalia ke tine:chilih ke..., ke we:lik ne:n ipane:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>neh sayoh nikita ya ihkó:n pi:ktok pero a:mo, a:mo nikmati, ne:n,</ANNOTATION_VALUE>
