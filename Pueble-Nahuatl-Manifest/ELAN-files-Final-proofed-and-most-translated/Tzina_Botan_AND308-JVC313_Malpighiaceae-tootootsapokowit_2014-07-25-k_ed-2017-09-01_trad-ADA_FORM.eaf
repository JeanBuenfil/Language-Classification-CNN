        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Pos neh a:mo ke:man nikita ne:wi:n kowtah ne:wí:n ni..., nitekititinemi kowtah.</ANNOTATION_VALUE>
