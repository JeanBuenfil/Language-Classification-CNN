        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>Ista:k n' ixo:chio wa:n i.... Ne:n, nikitani, ne:n,</ANNOTATION_VALUE>
