        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>pos n' ixo:chio pané: ista:k, pané: mo..., mo..., Mota:lia ihkó:n.</ANNOTATION_VALUE>
