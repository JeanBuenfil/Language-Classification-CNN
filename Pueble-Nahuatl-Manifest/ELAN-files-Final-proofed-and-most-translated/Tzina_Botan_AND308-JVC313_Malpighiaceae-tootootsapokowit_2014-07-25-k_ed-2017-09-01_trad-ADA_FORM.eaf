        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>I:n a:mo nikmati pero pos no: kwali tine:..., tine:chili:s neh no: nikitstinemi no: niki:xmattok. Mm.</ANNOTATION_VALUE>
