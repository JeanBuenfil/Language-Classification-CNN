                <ANNOTATION_VALUE>Wa:n no: iwki a, no: iwki a n' ahwia:k ke:meh yo:n okwilkowit ne: yo..., iwki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
