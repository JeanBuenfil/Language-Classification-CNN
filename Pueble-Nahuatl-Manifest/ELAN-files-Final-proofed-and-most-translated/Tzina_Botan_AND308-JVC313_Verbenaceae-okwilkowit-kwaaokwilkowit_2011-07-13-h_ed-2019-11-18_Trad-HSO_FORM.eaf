        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>Yehwa sah yo:ni, o:me, o:me taman okwilkowit onkak, tiki:xmatih o:me kwo..., o:me taman.</ANNOTATION_VALUE>
