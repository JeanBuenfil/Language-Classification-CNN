        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n. Ke:mah no: kwali pahti *compadrito**, yo:ni.</ANNOTATION_VALUE>
