        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>Pos ke:meh teh tikihtowa *compadrito de que** tikneki tikmatis.</ANNOTATION_VALUE>
