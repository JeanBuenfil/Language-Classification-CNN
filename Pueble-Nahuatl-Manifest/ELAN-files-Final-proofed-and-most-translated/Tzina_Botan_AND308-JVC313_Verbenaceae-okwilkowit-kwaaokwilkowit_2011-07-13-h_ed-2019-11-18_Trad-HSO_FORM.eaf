        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>Yo:n, yo:n kikwih para, ne:n,</ANNOTATION_VALUE>
