        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>ke okwilkowit tikiliah *porque** kipia seki okwiltsitsi:n.</ANNOTATION_VALUE>
