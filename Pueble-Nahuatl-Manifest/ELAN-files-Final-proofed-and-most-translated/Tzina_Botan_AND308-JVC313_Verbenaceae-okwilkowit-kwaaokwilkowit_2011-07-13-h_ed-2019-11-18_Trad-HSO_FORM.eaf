        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Yeh teiktik, pero yo:n kwa:okwilkowit yeh takwa:wak *compadrito** yo:n.</ANNOTATION_VALUE>
