    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Rubén Macario Martínez" PARTICIPANT="Rubén Macario Martínez" TIER_ID="RMM Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Le llaman chakaykowit es ese</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>el tronco es rojizo y pareciera que se le cae como cascarilla, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>sobre la superficie del tronco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Y las flores, las flores, este, son blancas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>las flores son un poco blancas y frutos se parecen a las de pimienta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Así como vez el fruto de la pimienta, así son los frutos del chakay, los frutos de chakay, así le llaman.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Sí, las hojas son pequeñas, las hojas son pequeñas como las</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>que le llaman, este, kwakwiteh.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Conoces al kwakwiteh, así se parecen las hojas, así quiere parecerse. Sólo que equéllas, las hojas son más lisas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>y son más verdes pero así quiere parecerse, así son de pequeñas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>Ese parece que nunca se ve que se caigan las hojas, parece que ese,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>se le va cayendo, como las de chalawih, se van cayendo y van otras hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Es muy raro, es raro que lo veas sin hojas, que solo esté el tronco. Generalmente siempre hojas. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>No sirve, ese solamente lo ocupan para cerrar como en los ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>potreros o lo siembran en los linderos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>Solamente para eso, solamente para eso sirve, no sirve para, digamos que lo ocupemos para leña,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>porque, este, parece que es muy poroso, bueno, decimos se parece al bagazo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>es muy frágil.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>Pues es bonito, bueno, sirve para horcón,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>solo que no debe cargar algo pesado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>Que digamos pueden hacer cargar el cartón (el techo debe ser de lámina de cartón), ese de papel,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>el de papel, bueno, el cartón del que de por sí se usa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>para techos de casa, casa ..., casa ..., la casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>Ese no es pesado. Pero que lo hagan cargar la teja (esto es, si para el techo se usan tejas) no sirve porque digamos, es muy frágil y vidrioso, el tronco es vidrioso. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>Se quiebra muy rápido y se quiebra. Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>Pues yo sé que solamente para eso, no puedo ..., y también sirve para el ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>cuando nos duele la cabeza (dolor de cabeza),</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>que machaquen bien las hojas con las manos, que las machaquen así</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a127" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>y con ello se lave uno la cabeza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>Yo ..., yo les digo que a veces yo veía a mi abuelito, el que era mi abuelito, pues el ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a129" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>el que era papá de ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>el papá de mi abuelito, pues el abuelito de mi papá.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>Yo he ..., aún era pequeño de edad, quizá tenía como unos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>como seis años.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a133" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>y así, cuando le dolía la cabeza, este, también ..., también ..., también ..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a134" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>mi abuelito me mandaba a traerle, que fuera yo a buscarle el chakayxiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a135" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>Le dicen chakayxiwit. Se lo voy a conseguir y le hago llegar,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a136" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>y los agarra y las machaca bien con las manos y con agua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a137" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>las machaca bien y luego con ello se lava la cabeza. Y yo le decía para qué, para que lo quiere, (porqué) lo usa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a138" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>dice "pues es cuando, a veces nos duele la cabeza,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a139" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>con ello se lave uno la cabeza porque es frio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a140" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>Nos, pareciera que hace que se enfrié nuestra cabeza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a141" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Es cuando a veces nos duele la cabeza, nos causa cuando tenemos fiebre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a142" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>Entonces, él me decía que sólo con eso se curaba,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a143" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>Con eso se lavaba la cabeza y se le quitaba el dolor, me decía. Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a144" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>Sabes, no, no sirve muy bien porque nunca crece muy, digamos muy derecho, sino que el tronco es torcido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a145" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>Las ramas, las ramas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>también son bien torcidos, no podemos decir que crezca bonito, que ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a147" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>ese arbolito crezca derechito, sino que ese arbolito siempre es torcido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>Así como te digo, que también sirve para cerrar en los potreros o para los linderos para cerrar en los linderos, ahí donde colindamos con otra persona, porque ese retoña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>Otra cosa que no te dije, se nos olvidó un poco, no te dije que retoña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>Ese, hay que hacerle un hoyo y cortar una rama,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>que uno cave un hoyo y que se entierre ahí,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>lo que sí es necesario, al sembrarlo, se requiere de mucho cuidado, que no se golpeteé, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a153" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>en la base, que se, que no se dañe la base para que retoñe bonito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>Y las semillas no se siembran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a155" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Ese siembran las ramas, las ramas del árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a156" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>Solamente eso sé, este, que sirve ese arbolito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a157" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Sí, este, solamente eso sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a158" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>Muchas gracias, yo me llamo Rubén Macario</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>Martínez, vengo de Chilcuauhta, pertenezco en San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
