        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>moye:kmela:wka:iskalti n' kowtsí:n, *sino que** nochipa ya chihchihkoltik n' kowtsí:n.</ANNOTATION_VALUE>
