        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>A:mo wel se: kikwa te:te:nkokoh a:mo se: taxi:kowa.</ANNOTATION_VALUE>
