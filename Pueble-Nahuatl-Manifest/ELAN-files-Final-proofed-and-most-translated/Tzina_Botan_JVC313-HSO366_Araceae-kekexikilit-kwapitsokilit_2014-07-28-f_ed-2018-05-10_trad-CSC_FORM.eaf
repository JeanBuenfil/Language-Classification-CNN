        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Pos a:mo n'mati ke:ní:w yo:n pero ki..., pero kihtowah ke komohkó:n, nejó:n,</ANNOTATION_VALUE>
