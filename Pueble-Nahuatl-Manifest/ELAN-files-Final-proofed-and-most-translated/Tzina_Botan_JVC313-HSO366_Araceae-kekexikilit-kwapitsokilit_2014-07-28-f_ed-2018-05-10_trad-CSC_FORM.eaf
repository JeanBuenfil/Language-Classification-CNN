            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a560" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>este..., lo toman..., lo maldicen y por eso da comezón en la boca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a561" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>Segun que ese no..., no... Que no lo maldigan para este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a562" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>para que no haga nada, es muy rico hasta como que es dulce ese quelite.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a563" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>Ese hay todo el tiempo. Todo el tiempo abunda. nada más que a veces no le toca a uno porque a veces le cortan las hojas y no cuando uno lo va aver ya no nos toca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a564" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>Y ese nada se da en lugares especiales porque yo veo que allà en Koyo:xo:chico de ahí donde</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a565" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>en lugares pantanosos donde hay agua. Se da muy bien el quelite pero tampoco lo dejan las personas porque le cortan las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a566" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>Si y es muy rico ahí es donde yo lo veo, allá en el monte grande anda uno pero como es un lugar muy frio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a567" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>Ahí, ahí, este, en todas partes es rico nada más que yo pienso que..., nada más hay que encontrarlo si hay allá se da el quelite muy blanco (las hojas) bien blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a568" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>Si y de verás que del que se da allá es rico porque es tierra húmeda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a569" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>Pues ese es rico, este, es más rico del que se da en tierras con mucha agua y en lugares con mucha agua donde esta húmedo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a570" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>por eso es muy rico ese que lite. Pero en donde es seco en los cafetales o en los potreros se da no todo es rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a571" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Sabe rico del que se da en los riachuelos en las cañadas se da este, en texa:yakatitan en esa cañada. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a580" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>Allá si es muy sabroso ese quelite (que se da allá). A veces lo vamos a traer allá y es muy sabroso ese wehweikilit. Pero se da en los arroyos. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a581" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>Pues da comezón en la boca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a582" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>Da comezón en la boca pero no le provoca a uno la muerte. Pero no aguanta uno porque da mucha comezón en la boca. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a583" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>Si, si ya lo come uno da mucha comezón en la boca y hay que rascarse los cachetes, y no, no lo come uno, mejor lo deja uno así. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a584" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a585" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>Pues no lo va a aguantar uno porque lastima mucho en la boca por su savía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a586" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>Igual si..., si lo revuelves, yo una ocasión había cortado ese wehweikilit me equivoqué...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a587" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>Yo sé que lo preparaba mi abuela finada este ese wehweikilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a588" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>Pero pues no lo hacìa así, el wehweikilit lo revolvía con flores de mala mujer, los brotes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a589" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>Junto a la casa había las flores de la mujer de los brotes y lo tumbe el árbol y le corté</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a590" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>y fui a traer el wehweikilit..., lo limpié y lo herví y pensé que ibamos a comer muy bien. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a591" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>Pues yo me equivoqué, yo sé que le ponen wehwekili pero no, pues le ponen soyokilit revuelto con la flor de la mala mujer también es rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a592" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>Le puse ese wehweikilit pues más... No lo comimos porque lastima mucho la boca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a593" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>Le lastima a uno la boca pues las flores de la mala mujer también son delicadas, lastima la boca y ese este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a594" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>la savía del wehweikilit...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a595" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>se ayudaron y lastima mucho la boca, lo quería comer ese cabrón mejor lo tiramos afuera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a607" ANNOTATION_REF="a267">
                <ANNOTATION_VALUE>No sabe rico pero es porque me equivoqué porque mi abuela nos lo preparaba con frijoles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a608" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>y flores de mala mujer pero con soyokilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a609" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>Se come con soyokilit y yo le puse wehweikilit pues no sirve. No sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a610" ANNOTATION_REF="a271">
                <ANNOTATION_VALUE>Si eso es, me equivoqué lo preparé pero no lo preparé bien, yo lo preparé pero le puse otra cosa y le tenia que poner soyokilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a611" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>Si y ese soyokilit también es muy rico donde..., del que es blanco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a612" ANNOTATION_REF="a274">
                <ANNOTATION_VALUE>También es rico ese de (hojas) rojas es de hojas largas pero es muy fuerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a613" ANNOTATION_REF="a276">
                <ANNOTATION_VALUE>Es muy fuerte. Es fuerte su olor que tiene y el del blanco no es fuerte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a614" ANNOTATION_REF="a278">
                <ANNOTATION_VALUE>Lo come uno bien bonito hijo de la mala ese es muy rico. Aja. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a615" ANNOTATION_REF="a281">
                <ANNOTATION_VALUE>Si el..., es muy rico que..., aunque </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a616" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>ya sea recio pero ese parece...., es ancho. Se..., le falta un poco para que se abra toda pero ya se puede cortar así es muy sabroso y ese</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a617" ANNOTATION_REF="a283">
                <ANNOTATION_VALUE>el que está enrollado porque hay unos como enrollados</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a618" ANNOTATION_REF="a284">
