        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>ke:mah yehwa yo:n niki:xmattok ne:n kilmeh.</ANNOTATION_VALUE>
