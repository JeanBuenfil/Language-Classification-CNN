            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>Eso es lo que le dicen wehweikilit, ista:kkilit o kwapitsokilit.</ANNOTATION_VALUE>
