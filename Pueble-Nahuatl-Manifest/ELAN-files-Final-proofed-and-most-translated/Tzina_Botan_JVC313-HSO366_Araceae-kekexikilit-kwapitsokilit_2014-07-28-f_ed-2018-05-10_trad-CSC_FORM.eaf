        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>Yo:n ke:mah komo tikchipa:w n' kalihtik *o** kichipa:wkeh kalihtik wa:n tikwa ya te:tewih kit seki:n kihihtowah seki:n de ihto:l..., kiihihtowah seki:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>komo mitsitakeh tikma:ma... tikwito n' kiltsi:n wa:n timochihchi:wilih ya</ANNOTATION_VALUE>
