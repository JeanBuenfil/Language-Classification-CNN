            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>se extiende en el suelo, se sale, sale hacia arriba, sale por la base del otro, va a salir en otro lado en la base de ese quelite</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a186">
