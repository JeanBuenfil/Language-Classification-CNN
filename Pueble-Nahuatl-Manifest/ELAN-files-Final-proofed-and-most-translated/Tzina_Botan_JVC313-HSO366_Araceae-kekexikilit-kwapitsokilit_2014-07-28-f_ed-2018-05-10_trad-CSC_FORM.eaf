                <ANNOTATION_VALUE>Sabe muy rico. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a694" ANNOTATION_REF="a355">
                <ANNOTATION_VALUE>Mafafa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a695" ANNOTATION_REF="a357">
                <ANNOTATION_VALUE>Pues..., el wehwe weikilit y el ista:kkilit,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a696" ANNOTATION_REF="a358">
                <ANNOTATION_VALUE>es un solo tipo nada más que lo nobran diferente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a697" ANNOTATION_REF="a360">
                <ANNOTATION_VALUE>Si. Lo nombran de una sola manera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a698" ANNOTATION_REF="a362">
                <ANNOTATION_VALUE>¿Cual es? ¿El kekexikilit? Pues el kekexikilit es ..., se da en los cafetales y es de hojas muy verdes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a699" ANNOTATION_REF="a364">
                <ANNOTATION_VALUE>Ese luego se da uno cuenta que es el kekexikilit porque hasta su tallo es muy verde luego lo ve uno que no es rico. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a700" ANNOTATION_REF="a365">
                <ANNOTATION_VALUE>Luego lo ve uno, l encuentra uno en el cafetal y pues se dice mismo hijole este es muy verde..., su tallo es verde y sus hojas muy verdes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a701" ANNOTATION_REF="a366">
                <ANNOTATION_VALUE>y, este, ese del que es rico hasta su tallo es transparente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a702" ANNOTATION_REF="a368">
                <ANNOTATION_VALUE>Y su..., sus hojas son bien verdes pero</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a703" ANNOTATION_REF="a369">
                <ANNOTATION_VALUE>hasta son transparentes aunque, aunque su hoja ya sea ancha pero es transparente son muy ricos, se ve que son muy ricos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a704" ANNOTATION_REF="a371">
                <ANNOTATION_VALUE>Eso se sabe luego, que es del sabroso. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a705" ANNOTATION_REF="a373">
                <ANNOTATION_VALUE>Pues unos también, unos lo ponen como ese para que, que le saque la pus que tiene un grano.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a706" ANNOTATION_REF="a374">
                <ANNOTATION_VALUE>También le ponen donde..., le ponen, se lo pegan y lo envuelven con una telita o un papel o una telita</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a707" ANNOTATION_REF="a375">
                <ANNOTATION_VALUE>para que tambié le haga remedio a  lo mejor por la savia..., lo cura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a708" ANNOTATION_REF="a377">
                <ANNOTATION_VALUE>Si lo calma si le duele mucho a uno si es que arde mucho, le pegan ese, ese..., esa hierba y entonces </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a709" ANNOTATION_REF="a378">
                <ANNOTATION_VALUE>al día siguiente otra vez..., otra vez..., ya se lo quitan y se cura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a715" ANNOTATION_REF="a380">
                <ANNOTATION_VALUE>También..., también lo pueden poner para remedio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a716" ANNOTATION_REF="a381">
                <ANNOTATION_VALUE>para cuando tiene un grano en el pie y duele o está ardiendo en temperatura eso es lo que le ponen y también hace efecto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a717" ANNOTATION_REF="a383">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a718" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>Pues el wehweikilit no se vende pero la mafafa si se vende porque yo veía que nosotros nos pedían que les vendieramos porque teniamos junto a la casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a719" ANNOTATION_REF="a386">
                <ANNOTATION_VALUE>Si se vende pero no sé a como, como nosotros no vendemos eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a720" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>Ese si se siembra. Se siembra pero si le cortas las hojas muy pronto se marchita. No, no da buenos camotes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a721" ANNOTATION_REF="a391">
                <ANNOTATION_VALUE>Se necesita que, ese no hay que cortrle las hojas pra que tenga camote porque si nada más es un camote pues </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a722" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>no hay que cortarle las hojas para que se haga bien su camote, da buenos frutos pero si le corta uno las hojas se marchita y ya no crece.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a733" ANNOTATION_REF="a394">
                <ANNOTATION_VALUE>Aja. Si está creciendo bien esa hierba...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a734" ANNOTATION_REF="a395">
                <ANNOTATION_VALUE>le cortamos una hoja tierna otro lo va a seguir..., ya no se da igual, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a735" ANNOTATION_REF="a396">
                <ANNOTATION_VALUE>se reduce y cuando va uno de nuevo ya es más pequeño si le cortas de nuevo las hojas se reduce hasta quedarse marchito esa mafafa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a736" ANNOTATION_REF="a398">
                <ANNOTATION_VALUE>Ese se marchita, si le corta unas las hojas se marchita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a737" ANNOTATION_REF="a399">
                <ANNOTATION_VALUE>Ese se necesita si, si  uno desea comer camote, pues no hay que cortarle las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a738" ANNOTATION_REF="a401">
                <ANNOTATION_VALUE>Hay que dejarle las hojas porque con sus hojas se esta fortaleciendo y,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a739" ANNOTATION_REF="a403">
                <ANNOTATION_VALUE>y se marchita si le corta uno las hojas. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a740" ANNOTATION_REF="a404">
                <ANNOTATION_VALUE>Sólo ese wehweikilit no, no da camote nada más puras hojas da ese y no pasa nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a741" ANNOTATION_REF="a406">
                <ANNOTATION_VALUE>Se le pueden cortar las hojas aunque se le cortaq cada hoja. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a742" ANNOTATION_REF="a409">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a743" ANNOTATION_REF="a411">
                <ANNOTATION_VALUE>Pero el wehweikilit no hace daño, no hace ningun daño, nada de nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a744" ANNOTATION_REF="a412">
                <ANNOTATION_VALUE>Hace daño pero si es que uno tiene tratamiento médico... con pastilla o</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a745" ANNOTATION_REF="a413">
                <ANNOTATION_VALUE>te están poniendo ampolletas o estás tomando vitaminas y comes eso,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a746" ANNOTATION_REF="a415">
                <ANNOTATION_VALUE>ese si es venenoso no... Se envenena uno. Ese si por la savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a747" ANNOTATION_REF="a417">
                <ANNOTATION_VALUE>porque he escuchado de muchas personas, "No voy a comer el wehweikilit"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a748" ANNOTATION_REF="a418">
                <ANNOTATION_VALUE>o la mafafa, no lo voy a comer porque estoy tomando medicamento.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a749" ANNOTATION_REF="a419">
                <ANNOTATION_VALUE>Ese es peligroso. No lo puedes comer como la hierba mora o el papalo, lo puedes comer pero (no debes) por la savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a752" ANNOTATION_REF="a421">
                <ANNOTATION_VALUE>Si eso es un po..., un poco..., un poco es que si estas en tratamiento no lo puedes comer porque se le tiene miedo por la savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a767" ANNOTATION_REF="a423">
                <ANNOTATION_VALUE>Con eso se empeora uno. Como si tomaras aguardiente, si estás en tratamiento y tomas aguardiente pues no no te va a hacer efecto sino que empeoras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a768" ANNOTATION_REF="a424">
                <ANNOTATION_VALUE>E igual con ese quelte, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a769" ANNOTATION_REF="a425">
                <ANNOTATION_VALUE>lo puede uno comer pero si esta uno sano, no se, si no está uno en tratamiento se puede comer ese quelite.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a770" ANNOTATION_REF="a427">
                <ANNOTATION_VALUE>Pero si está en tratamiento tomando medicina de patente no lo puede comer porque se empeora con eso. Asi es eso. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a771" ANNOTATION_REF="a430">
                <ANNOTATION_VALUE>Pues nada más eso, si es que tu concoes como se llama o si sabes algo..., para que se ocupan sus hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a772" ANNOTATION_REF="a432">
                <ANNOTATION_VALUE>También me pudes decir para saber también.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a773" ANNOTATION_REF="a438">
                <ANNOTATION_VALUE>ese no se da por si solo. No se da por si solo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a774" ANNOTATION_REF="a440">
                <ANNOTATION_VALUE>Pues..., su camote sabe rico preparándolo en atole o nada más asado. Es bonito ese</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a775" ANNOTATION_REF="a442">
                <ANNOTATION_VALUE>Se asa en el fuego. El wehweikilit no tiene camotes solamente tiene raices.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a776" ANNOTATION_REF="a444">
                <ANNOTATION_VALUE>Si lo arranca uno nada más tiene raices delgados como lombrices de tierra..., salen muchas raices.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a777" ANNOTATION_REF="a446">
                <ANNOTATION_VALUE>Pero no da camotes solamente raices.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a778" ANNOTATION_REF="a448">
                <ANNOTATION_VALUE>Si. Si y de verás que el que da camote pues..., tie..., tie..., tie..., tiene ese ..., es morado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a779" ANNOTATION_REF="a449">
                <ANNOTATION_VALUE>Este sale la raiz con el que, con el que esta sobreviviendo y además sale también el camote..., en las juntas del tallo pero luego se ven los camotes cuando salen porque son diferentes los camotes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a780" ANNOTATION_REF="a450">
                <ANNOTATION_VALUE>y las raices son diferentes. este es camote no es nada más raiz, ese camote se da o nace puntiagudo como si ya fuera a hacerse el quelite ahí..., Ahí va a nacer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a794" ANNOTATION_REF="a452">
                <ANNOTATION_VALUE>Pero si no lo corta nadie crece, crece y despuès vuelve a nacer otra vez no..., si nadie sacó el camote</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a795" ANNOTATION_REF="a453">
                <ANNOTATION_VALUE>sale por otro lado el retoño, vuelve a salir cuando ya es quelite grande esa mafafa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a796" ANNOTATION_REF="a455">
                <ANNOTATION_VALUE>Pues, así para..., para que se reproduce y abunda pero si se le saca hay que plantarlo de nuevo para que, para que se haga de nuevo el camote y ahí puede uno ir por más si es que uno quiere</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a797" ANNOTATION_REF="a457">
                <ANNOTATION_VALUE>Si así es como..., si es..., ese se siembra no se da por si solo y ese wehweikilit ese no lo va uno a arrancar ese nada más va uno a cortarle las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a798" ANNOTATION_REF="a459">
                <ANNOTATION_VALUE>Nada más va uno por sus hojas. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a799" ANNOTATION_REF="a461">
                <ANNOTATION_VALUE>Pues eso es todo lo que yo sé. Es todo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a800" ANNOTATION_REF="a463">
                <ANNOTATION_VALUE>Como no, pues yo me llamo Ernesto Vázquez Chanico y vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a801" ANNOTATION_REF="a465">
                <ANNOTATION_VALUE>¿Cömo?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a802" ANNOTATION_REF="a467">
                <ANNOTATION_VALUE>Con ajonjolí o en caldo también se puede comer, nada más en caldo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a803" ANNOTATION_REF="a469">
                <ANNOTATION_VALUE>Si no se tiene el ajonjolí, a veces no tenemos el dinero pues mejor se come nada más en caldo y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a804" ANNOTATION_REF="a470">
                <ANNOTATION_VALUE>y así lo comemos en caldo, nada más le ponemos sal y si queremos le agregamos salsa de chile y sabe bien rico acompañado con salsa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a805" ANNOTATION_REF="a472">
                <ANNOTATION_VALUE>Sal..., salsa de chile verde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a806" ANNOTATION_REF="a474">
                <ANNOTATION_VALUE>Si eso es pues no podemos acompletar para comprar ajonjolí aunque no es caro pero no todas las veces tenemos y hasta un peso hace falta y...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a807" ANNOTATION_REF="a475">
                <ANNOTATION_VALUE>Pues a veces lo hierven y así lo comemos en caldo. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a808" ANNOTATION_REF="a477">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a809" ANNOTATION_REF="a479">
                <ANNOTATION_VALUE>Bueno gracias.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
