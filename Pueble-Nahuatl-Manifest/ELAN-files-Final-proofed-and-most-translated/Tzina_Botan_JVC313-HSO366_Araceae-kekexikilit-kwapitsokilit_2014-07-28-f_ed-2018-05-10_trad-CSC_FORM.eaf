        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>yehwa yo:n kihihtowah kihtowah ke kekexikilit pos kachi *más** kitawelia te:tewih ya, te:te:nahwayo:tih.</ANNOTATION_VALUE>
