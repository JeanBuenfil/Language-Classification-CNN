            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>Ke:mah wa:n nejó:n koma:mo se: kichkwak pos ne: moskaltia wa:n komo se: kichkwak pos a:m..., ompa poliwi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Pero mah sepa se: kitsi:nto:ka para sepa kamohyowas wa:n mochi:wa sepa yo:n, yo:n metsonkilit.</ANNOTATION_VALUE>
