            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a619" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>Si se despedazan sus hojas y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a620" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>se jala con el tallo con savía</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a621" ANNOTATION_REF="a289">
                <ANNOTATION_VALUE>Si nada más hay que comer..., nada más sus hojas..., hay que limpiarlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a622" ANNOTATION_REF="a291">
                <ANNOTATION_VALUE>No. Ese, y ese se lava..., se lava..., para que..., ya va uno por el quelite y se..., Si lo pone uno en agua caliente, lo pone uno en agua caliente</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a623" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>y entonces, este, lo toma uno del agua y ya para uno la olla que esté hirviendo, que esté hirviendo bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a624" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>Y entonces..., de que ya está hirviendo bien el agua ya se echa el quelite y se bate</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a625" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>y sale bien verdecito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a626" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>Cualquier tipo de quelite..., si ya está hirviendo el agua sale bien verdecito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a627" ANNOTATION_REF="a297">
                <ANNOTATION_VALUE>Pero si este, este, ahí lo..., lo pones en la olla y luego lo pones a hervir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a628" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>se hace amarilla, después este, el quelite se hace amarillo y todo su jugo todo se hace amarillo, así se queda aunque sea la hierba mora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a658" ANNOTATION_REF="a299">
                <ANNOTATION_VALUE>Si tu..., este..., este..., vas a hervir el queli..., la hierba mora y si ya está... </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a659" ANNOTATION_REF="a300">
                <ANNOTATION_VALUE>Un poco su jugo... Bueno, el agua y echas el quelite</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a660" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>muy... Se hace muy amarillo el agua y el quelite hervido también se pone amarillo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a661" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>Y si está hirviendo el agua y que esté hirviendo bien y ya lo echas cuando está hirviendo bien hasta se hace verde el color de la hierba mora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a662" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>Hay que saber hervirlo para que salgan bien los quelites, como prepararlo, como comerl bien verdecito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a663" ANNOTATION_REF="a305">
                <ANNOTATION_VALUE>Pero si está a fuego lento y está hirviendo muy lento ahí se hace amarillo. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a664" ANNOTATION_REF="a307">
                <ANNOTATION_VALUE>Sehace amarilloo. Ya no sabe igual porque agarra un sabor a vapor caliente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a665" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>Y si se hace bien verdecito tiene un rico sabor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a666" ANNOTATION_REF="a310">
                <ANNOTATION_VALUE>Tiene un rico sabor. Asi según se prepara que, hay que enjuagarlo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a667" ANNOTATION_REF="a311">
                <ANNOTATION_VALUE>y entonces que esté hirviendo el agua y ya se agrega (el quelite) y se mueve como, como el atole primero con un..., con una madera especial.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a668" ANNOTATION_REF="a312">
                <ANNOTATION_VALUE>Y se deshace muy bien se coce y entonces... Si se le agrega ajonjolí se e puede poner y si no pues ya se come así</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a669" ANNOTATION_REF="a313">
                <ANNOTATION_VALUE>nada más le ponen sal y con salsa es muy rico en caldo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a670" ANNOTATION_REF="a315">
                <ANNOTATION_VALUE>Si, asi es. De muchas maneras es rico ese quelite nada más hay que saber prepararse la comida.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a671" ANNOTATION_REF="a317">
                <ANNOTATION_VALUE>Si es muy rico. Pues es rico con ajonjolí,es rico en caldo y,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a672" ANNOTATION_REF="a318">
                <ANNOTATION_VALUE>este, yo sé yo lo como este, a veces con ajonjolí yo lo como nada más en caldo pero con..., con salsa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a673" ANNOTATION_REF="a320">
                <ANNOTATION_VALUE>Do..., dos diferentes maneras se prepara para comerlo. Si o..., d..., dos diferentes maneras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a674" ANNOTATION_REF="a322">
                <ANNOTATION_VALUE>Pues a lo mejor también lo pueden hacer frito pero nosotros nunca lo hacen frito pero,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a675" ANNOTATION_REF="a323">
                <ANNOTATION_VALUE>pero otros tipos de quelite lo pueden hacer frito como el weh..., ese, este, quiero decir el ma:kwi:lkilit</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a676" ANNOTATION_REF="a325">
                <ANNOTATION_VALUE>también sabe rico frito y es rico con ajonjolí y también sabe rico en caldo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a677" ANNOTATION_REF="a326">
                <ANNOTATION_VALUE>También como el quelite del frijol, también es rico con ajonjolí y es rico..., nada más en caldo. Si eso es rico pero...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a678" ANNOTATION_REF="a327">
                <ANNOTATION_VALUE>Y también lo hacen frito como el kiltonil también sabe rico frito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a679" ANNOTATION_REF="a329">
                <ANNOTATION_VALUE>El kiltonil también es rico frito. Si y eso es lo que te digo, este, el wehweikilit lo conozco de,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a680" ANNOTATION_REF="a330">
                <ANNOTATION_VALUE>de que, un solo quelite lo nombran de tres diferentes maneras, wehweikilit y este ista:kkilit</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a681" ANNOTATION_REF="a331">
                <ANNOTATION_VALUE>y ya eso lo..., lo nombramos wehwei, y el otro que es morado...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a682" ANNOTATION_REF="a332">
                <ANNOTATION_VALUE>No sé como se nombra, a lo mejor mafafa morada le dicen, nosotros le decimos mafafa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a683" ANNOTATION_REF="a334">
                <ANNOTATION_VALUE>De verás que siempre asi lo nombran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a684" ANNOTATION_REF="a336">
                <ANNOTATION_VALUE>Siempre así lo nombran mafafa. Pero ese del que..., el que es rico siempre es rico se da en los cafetales, ese lo siembra uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a685" ANNOTATION_REF="a338">
                <ANNOTATION_VALUE>Es..., ese a lo mejor no es cimarrón porque tiene camotes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a686" ANNOTATION_REF="a341">
                <ANNOTATION_VALUE>Solamente lo siembra uno pero si lo anhela uno pues lo va uno a traer la semilla y lo siembra uno, ese no se chiquea, porque retoña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a687" ANNOTATION_REF="a343">
                <ANNOTATION_VALUE> con su camote pues ya se reproduce. Se reproduce. Si. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a688" ANNOTATION_REF="a345">
                <ANNOTATION_VALUE>Pues lo puede uno hacer picoso si es que puede... El que come picante pues lo puede hacer picoso y sabe rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a689" ANNOTATION_REF="a347">
                <ANNOTATION_VALUE>pero hay uno que siempre..., da un poco de comezón y no puedo comer picante pues con mayor razón no lo va uno a comer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a690" ANNOTATION_REF="a349">
                <ANNOTATION_VALUE>Si. A pues se puede comer asi. Lo puede uno comer ese.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a691" ANNOTATION_REF="a351">
                <ANNOTATION_VALUE>¿Ese no..., no... Sabe bien con el chile y pues no se va a hacer picoso si es que, este.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a692" ANNOTATION_REF="a352">
                <ANNOTATION_VALUE>Yo lo preparo allá en la casa que, con ajonjolí o nada más en caldo, y le desmorono chiltepin seco hijo de la mala sabe muy rico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
