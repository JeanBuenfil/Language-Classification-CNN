        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a542" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>Pero eso dicen que le lastima a uno la boca tam bién, también..., si tu fuiste a traer el quelite y este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a543" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>alguien te..., como que te mal dijo nombrando el kekexikilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a544" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>Eso si si lo limpias en la casa o lo limpiaron en la casa y ya lo comes, da comezón en la boca unos dicen que es porque algunos lo maldicen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a555" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>si te vieron que lo llevas cargando en la espalda..., fuiste por el quelite y ya te lo preparaste</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a556" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>eso es lo que dicen que hablan mal que es kekexikilit y le más hace mal y por eso le da a uno en la boca. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a557" ANNOTATION_REF="a218">
