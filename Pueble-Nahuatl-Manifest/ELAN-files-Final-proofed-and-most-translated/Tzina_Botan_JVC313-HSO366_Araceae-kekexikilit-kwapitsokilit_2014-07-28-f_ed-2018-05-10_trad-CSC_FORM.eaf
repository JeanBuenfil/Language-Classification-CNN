        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>a:ksá: mitsm..., mahyá: mitsihihtoh mah kitoka:yti kekexikilit.</ANNOTATION_VALUE>
