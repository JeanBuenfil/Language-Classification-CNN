        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>Sí porque yo he visto allá en el mercado de Cuetzalan que venden flores grandes y muy bonitas, yo siempre las conozco que son de color rojo.</ANNOTATION_VALUE>
