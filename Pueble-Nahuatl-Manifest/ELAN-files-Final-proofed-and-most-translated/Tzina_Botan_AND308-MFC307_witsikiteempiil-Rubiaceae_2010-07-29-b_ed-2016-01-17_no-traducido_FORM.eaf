        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1335" TIME_SLOT_REF1="ts1776" TIME_SLOT_REF2="ts1778">
                <ANNOTATION_VALUE>A:mo teh kipasa:rowa, mm, a:mo *porque** ... Ke:mah pero ...</ANNOTATION_VALUE>
