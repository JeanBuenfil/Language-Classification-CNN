                <ANNOTATION_VALUE>Ne: semi kimatik ki..., kim..., ki..., ihkón kwetaxwia wa:n sepa nika:n ihkón kichi:wa wa:n para ne:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
