        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1387" TIME_SLOT_REF1="ts1883" TIME_SLOT_REF2="ts1884">
                <ANNOTATION_VALUE>Nen..., nentikah, mm, ke:mah mopahtia:yah .Nentok wa:n yo:n, yo:n, *antes** yehwa yo:n mopahtia:yah ika yo:n xiwtsitsi:n.</ANNOTATION_VALUE>
