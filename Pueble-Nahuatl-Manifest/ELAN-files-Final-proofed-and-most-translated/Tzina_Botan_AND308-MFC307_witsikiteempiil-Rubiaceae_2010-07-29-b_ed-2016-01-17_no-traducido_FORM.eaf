        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1390" TIME_SLOT_REF1="ts1889" TIME_SLOT_REF2="ts1890">
                <ANNOTATION_VALUE>tahtatah yo:n pilimeh mopilowa mahyá pisi:ltomatsi:n nikin..., inmehmetsko *hasta** nika:n ne: nochi nemi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1391" TIME_SLOT_REF1="ts1891" TIME_SLOT_REF2="ts1892">
