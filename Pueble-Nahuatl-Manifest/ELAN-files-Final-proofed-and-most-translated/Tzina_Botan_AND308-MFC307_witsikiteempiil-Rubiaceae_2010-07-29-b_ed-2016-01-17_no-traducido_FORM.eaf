        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1339" TIME_SLOT_REF1="ts1785" TIME_SLOT_REF2="ts1786">
                <ANNOTATION_VALUE>a:man nikilia ihkwí:n x'chi:wa.</ANNOTATION_VALUE>
