        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1336" TIME_SLOT_REF1="ts1779" TIME_SLOT_REF2="ts1780">
                <ANNOTATION_VALUE>Ma:ski se: yehwa *o mismo** pili,</ANNOTATION_VALUE>
