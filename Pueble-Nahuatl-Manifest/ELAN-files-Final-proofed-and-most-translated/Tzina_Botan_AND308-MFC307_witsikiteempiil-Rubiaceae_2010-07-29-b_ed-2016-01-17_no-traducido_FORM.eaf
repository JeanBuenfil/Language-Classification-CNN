            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1407" TIME_SLOT_REF1="ts1923" TIME_SLOT_REF2="ts1924">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
