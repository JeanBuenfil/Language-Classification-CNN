                <ANNOTATION_VALUE>Yehwa yo:n okotsokowxiwit, yehwa ne:n, yehwa ochpa:wa:s inalwayo, yehwa ya n' pi:na:wits, pi:na:wits inalwayo, yehwa yo:n, yo:n tsi:tsika:s, yo:n tsikitsitsi:n, yo:n semi te:kokoh, te:kwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a859" TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts817">
                <ANNOTATION_VALUE>Yahwa ya ne:n ma:ltantsi:n, yehwa ya awakaiswat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a861" TIME_SLOT_REF1="ts819" TIME_SLOT_REF2="ts821">
                <ANNOTATION_VALUE>Yehwa ya ne:n okseki, sakapal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a863" TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>I:n sakapal no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a865" TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts829">
                <ANNOTATION_VALUE>N' sakapal no: semi kwali, nejó:n semi kwali yo:n, nejó:n okotsokowxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a867" TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts833">
                <ANNOTATION_VALUE>Wa:n nochi yo:n ti:ltik, ti:ltikkwit..., kwitakowit yo:n nochi, sekosah sentama:nelowah yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a869" TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>Wa:n yo:n kimanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a871" TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts840">
                <ANNOTATION_VALUE>Kimanah yo:n xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a873" TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>Yo:n de miak taman yo:n xiwtsitsi:n, yo:n neli yo:n name:chilihtoya ke yo:n kwali para ne:n netati:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a875" TIME_SLOT_REF1="ts847" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>Yehwa yo:n se: k..., nika:n se: mo..., ke:meskia se: tatatiw, nika:n se: tatatiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877" TIME_SLOT_REF1="ts851" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>Wa:n yo:n semi kwali wa:n yo:n se: kochisneki, se: ko:kochkamacha:lowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a878" TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts855">
                <ANNOTATION_VALUE>Wa:n semi koh..., kostia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a880" TIME_SLOT_REF1="ts857" TIME_SLOT_REF2="ts858">
                <ANNOTATION_VALUE>Yo:n teahwach ke:masá pos no:, no: kikwih yo:n teahwach.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a882" TIME_SLOT_REF1="ts861" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>Yo:n teahwach nochi kima:..., kima:nelowah wa:n pos yo:n ke:masá se: mo..., se: moyowali:to:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a884" TIME_SLOT_REF1="ts865" TIME_SLOT_REF2="ts866">
                <ANNOTATION_VALUE>Tiwa:lihsati:w pero nochi timi:to:nih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a885" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts869">
                <ANNOTATION_VALUE>Nika:n te:temo:tok mone:to:n, nochi moma:ko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a887" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts873">
                <ANNOTATION_VALUE>Nika:n *hasta** mokehketsa se: ihwitsitsi:n de nika:n i:n. Yo:n se: kie:kmattok, a: pos ne: nopili ne: kikwiti ne: cha:wis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a889" TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>Pero ton ne:, ne: eski ki..., kitapa:kihkeh ne: ka:mpa yo:n ne: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a891" TIME_SLOT_REF1="ts879" TIME_SLOT_REF2="ts881">
                <ANNOTATION_VALUE>Na:nahtsi:n motapa:kih kihto:s wa:n ompa ne: kit..., kima:nel..., kita:lihkeh itilmah, entós kihto:s ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a893" TIME_SLOT_REF1="ts883" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>A: pos nikte:mo:ti i:n xiwtsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a894" TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts887">
                <ANNOTATION_VALUE>Nikte:mo:ti, ta: yo:n nochi nikmattok ke:ní:w para ti..., ti..., nikchi:wati yo:n, nikmanati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a896" TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts891">
                <ANNOTATION_VALUE>Pos tiowih ya, tikolo..., tikwitih ne: xiwtsitsi:n, nochi tikwitih teh..., tehtsonkilit. N' tehtsonkilit no: semi kwali yo:n, yo:n tein witsioh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a898" TIME_SLOT_REF1="ts893" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>Yo:n tein witsyoh *porque** i:n tehtsonkilit no: ma:..., o:me taman onkak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a900" TIME_SLOT_REF1="ts897" TIME_SLOT_REF2="ts899">
                <ANNOTATION_VALUE>Yo:n seki we:wehka sah kipia ne:n i..., iwitsio, nika:n yo:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a902" TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts903">
                <ANNOTATION_VALUE>Iwitsio kohkostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a904" TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts907">
                <ANNOTATION_VALUE>Pero yo:n, yo:n we:wehka sah alaxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a906" TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts911">
                <ANNOTATION_VALUE>Yo:n a:mo te:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a908" TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts915">
                <ANNOTATION_VALUE>Pero yo:n, yo:n kikwih para pahti yo:n de n', de n' yo:n kipia ne:n ihwitsitsi:n wa:n yo:n ihkón tekpa:ntok, tekpa:ntok, te:kpa:ntok, komo se: mokwi:ltia semi kahkalaki nika:n wa:n a:mo se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a910" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n niman kihtowah pos nikwi:li:ti ne: ixiwtsitsi:n ne:, nikwi:kaya ne: tapahti:lo:ya:n ya, ne:pa, xola:l,pero pos a:mo kina:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a912" TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts923">
                <ANNOTATION_VALUE>Niman [...]teh na:nah xa: tikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a914" TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>*O** teh ta:tah xa: tikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a915" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts929">
                <ANNOTATION_VALUE>Kihto:s "ke:mah nikmati", kihto:s "¿katí:n xiwtsitsi:n?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a917" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts933">
                <ANNOTATION_VALUE>"Pos xine:chkwi:li:ti, nimitstaxta:wi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a919" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts936">
                <ANNOTATION_VALUE>"¿Ka:nachi tine:chakas?" A:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a920" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts939">
                <ANNOTATION_VALUE>"Tine:chakas sikie:ra tepitsi:n, sikie:ra komo weli wa:n koma:mo pos kie:ra, kiera, kie:ra mah pahti ne:n pili *porque** nikita mokokowa"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a922" TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts943">
                <ANNOTATION_VALUE>No wa:n nejó:n *cuando** tiwelis porkwali tine:chwi:kas wa:n ti..., tikwiti:wih i:n xiwtsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a924" TIME_SLOT_REF1="ts947" TIME_SLOT_REF2="ts948">
                <ANNOTATION_VALUE>Tikwiti:wih oso kwali tiktsi:nta:li:skeh sikie:ra se: *mata** nika:n kaltsi:ntan, nika:n kali:xpan *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a925" TIME_SLOT_REF1="ts949" TIME_SLOT_REF2="ts950">
                <ANNOTATION_VALUE>tikchi:wili:skeh se: ihkón kalyowal ihk...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a927" TIME_SLOT_REF1="ts953" TIME_SLOT_REF2="ts954">
                <ANNOTATION_VALUE>Se: tik..., tiktapa:nas ne:n kowtsitsi:n wa:n tikyewalowili:skeh nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a929" TIME_SLOT_REF1="ts957" TIME_SLOT_REF2="ts958">
                <ANNOTATION_VALUE>Wa:n ompa tiktsi:nketsaskeh se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a930" TIME_SLOT_REF1="ts959" TIME_SLOT_REF2="ts961">
                <ANNOTATION_VALUE>Tikwiti:wih ne:n tapala:n de ne:n chalawih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a932" TIME_SLOT_REF1="ts963" TIME_SLOT_REF2="ts965">
                <ANNOTATION_VALUE>Wa:n tikwiti:wih ne:n tapala:n, ihkón tikihichkwaskeh wa:n tikchi:waskeh tekoch wa:n ompa 'te:maskeh wa:n ompa tikpanketsaskeh yo:n *matita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a934" TIME_SLOT_REF1="ts967" TIME_SLOT_REF2="ts969">
                <ANNOTATION_VALUE>*Después** te:chservi:ro:s, ke:meh ne:n yehwa i:n nejó:n, yo:n nochi kikwih wa:n pos ika te:altiah *hasta** i:n tiwehwei:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a936" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts973">
                <ANNOTATION_VALUE>*Hasta i:n tiwehwei:n, *más** kone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a938" TIME_SLOT_REF1="ts975" TIME_SLOT_REF2="ts976">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n, yo:n teahwach, yo:n kwaltsitsi:n, ampo:wi:n no: onkas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a939" TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts979">
                <ANNOTATION_VALUE>Yo:n onkak kwaltsi:n ma:pisi:ltik, yo:n a:mo tikmatih sah, yo:n ke:meh ochpa:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a941" TIME_SLOT_REF1="ts981" TIME_SLOT_REF2="ts983">
                <ANNOTATION_VALUE>Ke:meh ochpa:wa:s, mm. Tiki:xmati no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a943" TIME_SLOT_REF1="ts985" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>Yo:n se: kini..., yo:n, a: pos i:n nopili nikitak tane:sik semi mi:to:nih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a944" TIME_SLOT_REF1="ts987" TIME_SLOT_REF2="ts988">
                <ANNOTATION_VALUE>wa:n ke:ní:w tikmatik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a945" TIME_SLOT_REF1="ts989" TIME_SLOT_REF2="ts991">
                <ANNOTATION_VALUE>Pos nikmatik *porque** itilmahtsi:n semi ye:ka:paltik i:ni, ye:ka:paltik itilmahtsi:n wa:n nochi nika:n i:xkwa:ko nochi nika:n i..., n' ikechkochi:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a947" TIME_SLOT_REF1="ts993" TIME_SLOT_REF2="ts994">
                <ANNOTATION_VALUE>Wa:n nika:n i:n iye:lpan nikmachilih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a948" TIME_SLOT_REF1="ts995" TIME_SLOT_REF2="ts997">
                <ANNOTATION_VALUE>Nochi ye:k..., nochi ye:k..., nochi nejó:n te:temo:k ine:to:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a951" TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1003">
                <ANNOTATION_VALUE>Ine:to:n, niman kihtowah "ne: nopili ..."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a955" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1013">
                <ANNOTATION_VALUE>*Casi** no: taman ahwia:k, ke:meskia ahwia:k no:, ke:meskia tamantik. A:mo, a:mo ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a957" TIME_SLOT_REF1="ts1015" TIME_SLOT_REF2="ts1017">
                <ANNOTATION_VALUE>Ke:meskia toto:nik, toto:nkahya:k, mm, toto:nkahya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a959" TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1020">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n niman kihtowah pos ne: nopili nikwi:liti yo:n teahwach.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a960" TIME_SLOT_REF1="ts1021" TIME_SLOT_REF2="ts1023">
                <ANNOTATION_VALUE>Wa:n yo:n kwitaxiwit, yo:n de n' ti:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a962" TIME_SLOT_REF1="ts1025" TIME_SLOT_REF2="ts1027">
                <ANNOTATION_VALUE>A: kilia "ox ne:kwali". "Ke:mah, ne: ta:tahtsi:n ne:chilih ke kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a964" TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1030">
                <ANNOTATION_VALUE>Wa:n ke:ní:w se: kichi:wa mitsilih",</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a965" TIME_SLOT_REF1="ts1031" TIME_SLOT_REF2="ts1032">
                <ANNOTATION_VALUE>"pos ne:chilih ihkwí:n ka:mpa kochi, ompa x'ta:lili".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a966" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1035">
                <ANNOTATION_VALUE>Ompa x'ta:lili, ompa x'ta:lili ihkón, ihkón x'ta:lilihtiw yo:n kwitaxiwit ihkón.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a968" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1039">
                <ANNOTATION_VALUE>Ompa x'ta:lilihtiw, no:, no: weli se: *cachito** se:, kie:ra se: *ramita** ne: ma:ta:nkehxiwit, kwali tikta:lilihtiw ihkón,paniá:n ya tikta:lilihtiw ihkón.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a970" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1042">
                <ANNOTATION_VALUE>Entós a:mo kimachilia ne:n pili,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a971" TIME_SLOT_REF1="ts1043" TIME_SLOT_REF2="ts1044">
                <ANNOTATION_VALUE>pos nejó:n ke:meskia yo:n kawa:ntia, wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a973" TIME_SLOT_REF1="ts1047" TIME_SLOT_REF2="ts1048">
                <ANNOTATION_VALUE>Wa:ki wa:n kihto:s nikpechtih ekintsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
