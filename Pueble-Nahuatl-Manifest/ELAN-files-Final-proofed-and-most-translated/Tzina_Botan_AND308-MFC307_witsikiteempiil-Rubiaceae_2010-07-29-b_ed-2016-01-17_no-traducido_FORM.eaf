            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1393" TIME_SLOT_REF1="ts1894" TIME_SLOT_REF2="ts1896">
                <ANNOTATION_VALUE>Olo:kowe:wat ata yo:n mochi:wa iteyotsitsi:n ihkwi:kwi:ntsi:n. Ehe, tikxihxi:ma, tikxihxi:ma wa:n t'tehteki *cachitos** wa:n t'mana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1394" TIME_SLOT_REF1="ts1897" TIME_SLOT_REF2="ts1898">
                <ANNOTATION_VALUE>Wa:n yehwa sah ika xika:lti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1395" TIME_SLOT_REF1="ts1899" TIME_SLOT_REF2="ts1900">
                <ANNOTATION_VALUE>*O** yo:n tikwi *vicio**, tikwi *vicio** semi ti..., titanemilia ke ti..., titakwa:ti pero mah yeto chi:l se:, se: p..., se: kaxit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
