        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>Sí, ése el árbol que produce, en donde ya va pudriendo el tocón</ANNOTATION_VALUE>
