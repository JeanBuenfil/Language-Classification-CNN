                <ANNOTATION_VALUE>la ropa y .... Bueno más, más a cada rato usan el agua</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>algunas les da esa enfermedad de las manos. Donde uno tiene rayas en la palma de las manos, yo veía no me acuerdo cuál de mis hermanas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
