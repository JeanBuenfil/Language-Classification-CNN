        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>Mm, si la conozco, esa, esa hierba este también le llaman &lt;i&gt;ma:tsa:tsaya:mpahxiwit&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>Y yo le..., le escuchaba a mi madre hace muchos años que este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>le llaman &lt;i&gt;ma:tsa:tsaya:mpahxiwit&lt;/i&gt; y..., y de veras dicen que tiene un olor a &lt;i&gt;xankahya:k&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>Es cierto que tiene un mal olor porque muchos tipos de hierbas algunas tienen mal olor y otras son aromáticas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>Y dicen que esa planta le..., cura cuando alguien tiene seca y cuarteada la palma de la mano, y cuando las mujeres tienen así como cuarteaduras en los pliegues de la palma de la mano</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>y les hace efecto porque tiene un mal olor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>Dicen que la enfermedad le da asco al mal olor de la planta. Aha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>Y yo lo quiero, yo lo conozco más por, por &lt;i&gt;ma:tsa:tsaya:mpah&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>Pero me acuerdo que una, una de mis hermanas, quien sabe quien lo usaba para curarse las manos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Sí porque eso, es cierto lo que dicen que las mujeres siempre ellas lavan los trastes o lavan </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
