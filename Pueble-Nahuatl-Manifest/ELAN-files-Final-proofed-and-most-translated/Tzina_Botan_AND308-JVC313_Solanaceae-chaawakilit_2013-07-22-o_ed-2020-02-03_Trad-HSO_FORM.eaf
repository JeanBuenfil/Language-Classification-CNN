        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>I:n tein nikaktok ki:ní:n tikta:lia ita:mpa itech i:n tit.</ANNOTATION_VALUE>
