        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>mote:we:liltia ya. Wa:n yehwa n' i:n</ANNOTATION_VALUE>
