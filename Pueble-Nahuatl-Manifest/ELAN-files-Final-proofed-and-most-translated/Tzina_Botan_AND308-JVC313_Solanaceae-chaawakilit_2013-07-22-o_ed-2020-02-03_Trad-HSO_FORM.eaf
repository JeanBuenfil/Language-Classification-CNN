        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>miakka:n onkak nehkwí:n ka:mpa mi:lah, pero ka:mpa ne:n kowtah a:mo tei.</ANNOTATION_VALUE>
