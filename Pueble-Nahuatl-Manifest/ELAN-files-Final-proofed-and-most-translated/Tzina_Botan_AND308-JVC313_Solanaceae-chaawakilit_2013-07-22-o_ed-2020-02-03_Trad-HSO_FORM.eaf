            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>pos ne:wí:n, ne:wí:n kowtah, a:mo nikihto:s *que** mochi:wati ne:wí:n kowtah.</ANNOTATION_VALUE>
