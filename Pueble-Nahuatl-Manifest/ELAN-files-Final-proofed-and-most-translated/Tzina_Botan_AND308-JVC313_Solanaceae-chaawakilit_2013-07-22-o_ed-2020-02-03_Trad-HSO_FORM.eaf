            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>pos ompa onkak, nijó:n, n' kiltsí:n.</ANNOTATION_VALUE>
