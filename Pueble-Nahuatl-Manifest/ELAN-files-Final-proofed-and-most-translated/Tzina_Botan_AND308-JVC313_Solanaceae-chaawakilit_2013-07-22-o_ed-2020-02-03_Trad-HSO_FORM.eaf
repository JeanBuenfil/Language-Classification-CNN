        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>Miak no: ki:xmattokeh tak nijí:n chia:wakilit ta:</ANNOTATION_VALUE>
