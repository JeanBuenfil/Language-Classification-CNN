        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Yo:n kiltsí:n seki tik..., *hasta** tika:wtiuweh *porque** we:lik.</ANNOTATION_VALUE>
