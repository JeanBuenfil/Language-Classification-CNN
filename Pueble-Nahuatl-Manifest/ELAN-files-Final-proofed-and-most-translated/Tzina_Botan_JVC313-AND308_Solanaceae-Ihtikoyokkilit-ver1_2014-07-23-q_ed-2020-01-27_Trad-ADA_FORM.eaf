        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>Yo:n a:mo poliwi ke:meh yo:n tomakilit a:mo kamohyowa pero yo:n,</ANNOTATION_VALUE>
