        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>emo:ltsí:n no: ki..., kita:lilia:yah, ke:masá: kita:lilia:yah yo:n a:ko:lin,</ANNOTATION_VALUE>
