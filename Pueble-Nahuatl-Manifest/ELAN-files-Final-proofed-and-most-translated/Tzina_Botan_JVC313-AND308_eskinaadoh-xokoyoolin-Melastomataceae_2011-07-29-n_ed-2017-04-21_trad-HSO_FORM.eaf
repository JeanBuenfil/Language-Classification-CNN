        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Semi kwe:liltia:ya yo:n, yo:n ke:meh eskia, ne:n,</ANNOTATION_VALUE>
