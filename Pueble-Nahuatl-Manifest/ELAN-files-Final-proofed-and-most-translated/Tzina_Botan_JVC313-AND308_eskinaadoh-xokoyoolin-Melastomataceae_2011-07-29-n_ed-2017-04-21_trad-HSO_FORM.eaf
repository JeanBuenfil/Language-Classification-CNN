        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>e:wia nijó:n. Yo:n, pos ka:nsika se: kitaya, ka:nsika se: kitaya ihkó:n ne:,</ANNOTATION_VALUE>
