        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>ke:meh eskia tomatsí:n. N' *antes** nochi tikwiah yehwa. Kihto:s, "Ne: xte:mo:ti ne:,</ANNOTATION_VALUE>
