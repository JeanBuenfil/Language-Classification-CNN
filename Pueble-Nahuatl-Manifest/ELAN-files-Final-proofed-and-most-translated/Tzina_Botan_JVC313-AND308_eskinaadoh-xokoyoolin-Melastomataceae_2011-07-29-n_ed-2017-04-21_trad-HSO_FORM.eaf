        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>oso te:chchi:wiliah tapalo:l, te:chchi:wilia:yah,</ANNOTATION_VALUE>
