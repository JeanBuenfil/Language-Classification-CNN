                <ANNOTATION_VALUE>*Pues**, ke:mah ne: neli, yehwa yo:n onkak, onkak nikilia neh miak pahtsitsí:n pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
