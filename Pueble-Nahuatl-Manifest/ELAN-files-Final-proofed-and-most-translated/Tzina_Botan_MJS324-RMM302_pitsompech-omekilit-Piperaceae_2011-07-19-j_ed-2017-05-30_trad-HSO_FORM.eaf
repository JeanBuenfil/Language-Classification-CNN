        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>Wa:n para a:mo yo:n eski kihtowah yehwa ya yo:n mah se: tai, mah se: tai *o** mah ika se: ma:ma:l..., mah se: ma:lti ika yo:n,</ANNOTATION_VALUE>
