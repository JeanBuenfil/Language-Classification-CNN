                <ANNOTATION_VALUE>ika te:a:ltiah *o** ke:meh i:n i:ksá:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
