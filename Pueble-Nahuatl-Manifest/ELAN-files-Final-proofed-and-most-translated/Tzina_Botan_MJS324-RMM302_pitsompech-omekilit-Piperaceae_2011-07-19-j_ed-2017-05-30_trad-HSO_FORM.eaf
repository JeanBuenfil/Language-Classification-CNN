        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Kwaltia para yehwa mikia:nalis *o** kwaltia para yo:n kilwiah, *este, reuma**.</ANNOTATION_VALUE>
