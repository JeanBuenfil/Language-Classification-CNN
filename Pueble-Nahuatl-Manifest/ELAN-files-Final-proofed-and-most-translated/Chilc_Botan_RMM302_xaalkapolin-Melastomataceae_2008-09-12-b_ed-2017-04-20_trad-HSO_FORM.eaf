        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Yehwa, yehwa n' xa:lkapolin wa:n to:toli:xkapolin.</ANNOTATION_VALUE>
