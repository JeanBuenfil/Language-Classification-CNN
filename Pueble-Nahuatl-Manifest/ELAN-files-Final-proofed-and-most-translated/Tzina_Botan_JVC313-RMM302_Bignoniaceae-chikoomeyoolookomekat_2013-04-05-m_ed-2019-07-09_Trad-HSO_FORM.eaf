                <ANNOTATION_VALUE>he..., he visto un bejuco que se llama, este bueno, yo lo..., conozco en español, de este, pero en español, pero en náhwat le llaman &lt;i&gt;chiko:me...,&lt;/i&gt; &lt;i&gt;chiko:me iyo:lo komekat&lt;/i&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>Yo no sé si usted lo conoce, dicen que es muy bueno para medicina, yo sé que es muy bueno para curar los dolores de corazón, no sé para usted, tal vez sabe que se puede usar para curar otras enfermedades.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>Mm, sí, sí, sí, son como los quelites del frijol. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Y su..., su..., cómo es el bejuco, cómo es la médula, es cierto que tiene la médula como dicen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>A las artesanías. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>No se quiebra el bejuco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Y yo quiero preguntarte si el tronco es duro, bueno si es duro igual como el tronco de un árbol o, como yo nunca lo..., yo lo conozco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Pero nunca lo corto para sa..., saber cómo es cuando ya está seco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>si, este, si salen también como unas as..., astillitas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>o tal vez es solo un bejuco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Y otra cosa discúlpame usted, otra cosa que quería preguntarte,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>y si usan para curar como dice usted este que se usa para curar el dolor de los riñones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Esos que nosotros les llamamos en español riñones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>Cuando uno tiene dolores a un lado de las piernas, yo quería saber,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>cómo lo toman, si lo hierven o toman así las hojas verdes</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>la echan en el agua o cómo le hacen para tomar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Hervido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Tienen dificultad para orinar. Problemas para orinar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Y otra cosa que quiero preguntarte el agua cambia de color o se ve así como agua simple. Entonces tal vez, quizá .... Bueno yo pienso</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Entonces yo pienso este, tengo una medicina pero no puedo de..., no puedo explicarte si ese es el mismo bejuco. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Tengo una medicina que son como unos palitos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>son como unas astillitas cortadas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>digamos nosotros son así de chiquitos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>Y ese es muy caro, ese es muy bueno para curar los riñones pero en español le llaman palo azul.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Y yo pienso que tal vez sea ese mismo, no se sabe como ve usted por ahí lejos, lejos, lejos, hay otro bejuco diferente, se dan bejucos dferentes. Se dan pero son diferentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>Y los conocemos con nombres diferentes y cuando se secan lo..., lo sabe usted cuando los cortamos así de chiquitos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>ya cambia. Ya no ves si es un bejuco ni tampoco puedes ver si es cualquier árbol sencillo, tú puedes pensar que son unas astillas que las cortaron por allá para que ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>Ahá, &lt;i&gt;poposokani&lt;/i&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>A no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>Mm, el &lt;i&gt;tata:wikmekat&lt;/i&gt; sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>A es así ese bejuco. A entonces no..., debe ser diferente del palo que yo te estoy hablando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>También es muy bueno la made..., también es madera, es sencilla la madera y es bueno para curar los riñones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>Pues es cierto como usted dice que hay muchos ar..., este hay muchas plantas medicinales por aquí, el problema es que no las conocemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>Como el que..., del que estamos platicando del bejuco que dice usted.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>Y también hay otro bejuco que se llama tsinaka..., &lt;i&gt;tsinakaahtapal..., altapalmekat&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>El &lt;i&gt;tsina:kaahtapalkwamekat&lt;/i&gt; ese también es bueno para curar los riñones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>Y yo pienso que casi nadie lo conoce si se usa como medicina porque sabrá usted casi no la ocu...., ocupamos para curar, actualmente más confiamos en las medicinas de farmacia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>Dejamos a un lado la medicina tradicional.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>Y eso es lo que, pues no es muy bueno porque algunas veces decimos nosotros que tenemos que pagar toda la medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>También..., también..., ia... Eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a429" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>Y eso es. Y nosotros lo...., lo..., lo..., no lo pensamos antes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>No lo pensamos pero por aquí, o no lo conocemos, o no lo platicamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>Pero por acá hay medicinas como del que te platico del &lt;i&gt;tsina:kaahtapalkomekat&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>Ese es muy bueno para curar la enfermedad del que te platico que en español le llaman riñones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a433" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>Ese es muy bueno tomarlo, que hiervan las hojas y hay que tomar como cuando a uno le da sed. No es amargo o que tenga un mal sabor sino que es como agua nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a434" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>Y eso es muy bueno decimos para que uno no vaya a la cirugía pues hay que tomarlo en té,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a435" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Y no lo..., para que no se aprovechen los doctores porque como ellos son especialistas pues piensan hacerle al paciente cualquier cosa, ellos le hacen varios estudios y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a436" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>y como están preparados desp..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a437" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>después lo madan al enfermo a una cirugía para que pueda curarse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a438" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>A veces sí se cura uno y a veces no. No siempre sale muy efectiva la medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a439" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>Debe ser ese bejuco, debe ser ese nada más usted sabrá que también se da en lugares despejados, en lugares despejados,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a440" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>digamos nosotros que también ahí se adapta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a441" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>entonces digamos nosotros que se..., se..., extiende sobre las ramas de otras plantas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a442" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>Yo te digo  que nosotros, nos..., nosotros una vez fuimos por ahí, fuimos a pasear por ahí</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a443" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>Y encontramos ese bejuco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a444" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>tenía su..., sus semillitas, tenía sus frutos, unos frutos como si, digamos nosotros como si fueran ese,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a445" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>como los, cómo le llaman, este, ése, ése que venden allá en Cuetza..., allá en Cuetzalan, esos ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Eh..., así mero casi se parece i..., i...., casi se parecen así las semillitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>Y nos..., él una persona con la que fui, una persona con la que yo fui,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>esa persona empieza a preguntarme. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>Dice, "¿Cómo se llama este bejuco dice?" "Yo le digo &lt;i&gt;tsina:kaahtapal...,&lt;/i&gt; &lt;i&gt;tsina:kaahtapalkomekat"&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>Dice "¿Y para qué se usa?" "yo sé" le digo "que se usa para curar los riñones"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>O sea que es medicinal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>Es buena medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>Y lo..., lo vimos y eso es lo que yo también les platico, no sé tal ves usted también lo conoce</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>o, o tal... tal..., tal vez lo conoce usted pero no sabe cómo se llama. O no sabe cómo, para qué se usa esa planta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>Mm, eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a255">
                <ANNOTATION_VALUE>Eso es, eso es lo que se hace.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a257">
                <ANNOTATION_VALUE>Pues no hay ningún problema, yo te platico y si alguna persona te pregunta para qué se usa este bejuquito,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a480" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>pues pla..., platícale y dile para que se usa, no hay que negarlo porque nosotros ya sabemos cómo se llama</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a481" ANNOTATION_REF="a259">
                <ANNOTATION_VALUE>y para qué enfermedad se puede curar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a482" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>no hay que esconderlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a483" ANNOTATION_REF="a263">
                <ANNOTATION_VALUE>Siempre es mejor platicar con otras personas porque muchas.... Acá en la tierra padecemos de muchas enfermedades.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a484" ANNOTATION_REF="a265">
                <ANNOTATION_VALUE>Y algunos de nosotros nos desesperamos cuando no nos pdemos curar, entonces acudimos con los doctores y ya no nos podemos curar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a485" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>Pero no, eso es porque nosotros no pensamos bien, porque acá nosotros en nuestros campos tenemos muchos remedios.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a486" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>Nada más no debemos de.... Eso es nos descuidamos. Como usted me platica que el bejuco que se llama chi..., chi..., este &lt;i&gt;chiko:meyolo&lt;/i&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a487" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>Ese también es muy buena medicina, es cierto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a488" ANNOTATION_REF="a272">
                <ANNOTATION_VALUE>Solo que también es cierto cuando decimos que por aquí casi no lo encontramos porque hay muchos potreros o en o..., otras partes hay matas de..., café.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a273">
                <ANNOTATION_VALUE>pues no hay plantas de ese bejuco pero yo pienso que allá en el campo si ha de haber</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a275">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a277">
                <ANNOTATION_VALUE>Dos matas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a280">
                <ANNOTATION_VALUE>Pues es muy bonito, ojalá, yo pensaría, yo quisiera que..., lo busque y,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>entonces nos avisa y si alguna persona llega a preguntarte para qué se usa ese bejuquito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>Pues platícale, explícale.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>Como yo te platico es..., nos..., que nos ven sanos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>Nos ven que estamos muy  sanos pero no saben cómo estamos en nues..., nues..., nuestro organismo o en nuestro cuerpo como lo decimos nosotros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>Algunos andamos caminando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a293">
                <ANNOTATION_VALUE>Pero pues nos..., digamos nosotros andamos caminando pero nos..., digamos nosotros solo nos esforzamos. Hacemos un esfuerzo. No es porque estamos muy sanos sino que a veces estamos haciendo un esfuerzo nada más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a295">
                <ANNOTATION_VALUE>Pues eso es todo lo que yo te quería platicar y ahora te pregunto si tiene algo más,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>este, ma..., más ideas o alguna otra cosa más que preguntar, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a524" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>pues ojalá me dijeras y si ya no hay más, si es todo lo que platicamos pues te lo agradezco mucho. Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a525" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a527" ANNOTATION_REF="a306">
                <ANNOTATION_VALUE>Pues lo veremos otro día te..., otro día te lo voy a enseñar, voy a buscarla por ahí y lo..., te mostraré ese bejuquito para que lo conozcas bien co..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a528" ANNOTATION_REF="a308">
                <ANNOTATION_VALUE>Sí eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a529" ANNOTATION_REF="a310">
                <ANNOTATION_VALUE>Pues te pido muchas disculpas, es todo lo que platicamos y ya no... A ver cuando nos volvemos a encontrar acá para platicar todo lo que usted conoce y todo lo que yo sé da las plantas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a530" ANNOTATION_REF="a312">
                <ANNOTATION_VALUE>Pues debemos platicarlo, pues es todo lo que te platiqué.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a531" ANNOTATION_REF="a314">
                <ANNOTATION_VALUE>Muchas gracias.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a532" ANNOTATION_REF="a315">
                <ANNOTATION_VALUE>Yo me llamo Rubén Macario, vengo de Chi:lkowtah y pertenezco allá en San Miguel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a543" ANNOTATION_REF="a321">
                <ANNOTATION_VALUE>Igualmente muchas gracias.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="José Ernesto Vázquez Chanico" PARTICIPANT="José Ernesto Vázquez Chanico" TIER_ID="JVC-Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>Sí, pues el bejuco yo lo conozco, conozco el bejuco, los bejucos crecen muy grandes, son gruesos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>suben muy alto, como a la altura de los árboles, suben como el kwes..., como a la altura del torre (de la iglesia) de ahí en el centro del pueblo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>llegan a extenderse hasta en la punta de los árboles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Pero nunca, nunca veo cómo son sus flores, cómo son sus semillas no las conozco cómo son.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>He visto cómo son sus hojas, sí las he visto porque en donde lo tumba uno, yo sé porque fui a tumbar y lo..., después fui otra vez y lo encontré que estaba retoñando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>tiene tres hojas, se pone tres hojas como este, no sé, no sé como cuál planta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>e..., son así de grandes como las hojas de &lt;i&gt;te:kwa:nenepi:l&lt;/i&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>así son esas hojas. Pero son puntiagudas en forma de corazón y así son como nos corazoncitos, la planta se pone tres hojas.  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Uno se pone la hoja por acá, otra por aquí y tiene un pedúnculo, otra hoja se pone por acá. ¿Sabes cómo son las hojas? Las hojas de esta planta y la forma en que se pone sus hojas, son muy parecidas como las hojas del frijol gordo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>Son como los quelites del frijol gordo, las hojas de frijol, por la forma en que tiene sus hojas son como el frijol, tiene tres hojas. No es una sola hoja. Así son sus hojas como un poco alargadas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>Sus hojas son lisas y delgadas de grosor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>En el ház de las hojas son lisas y son delgadas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Y de veras se pone se..., son muchas su..., el pedúnculo es igual aquí se..., sale una hoja acá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a367" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>con un pedúnculo y por acá tiene otro así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Sus hojas se parecen mero como a las hojas de frijol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Pero son así de grandes las hojas, son alargadas  y pun..., puntiagudas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>Eso es lo que yo co..., conozco sus hojas que son tres. El bejuco se..., si se corta a la mitad el bejuco así derecho,se corta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>su..., tiene su..., son muchos sus..., las médulas son muchos, son siete</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Aquí se ve donde tiene sus médulas, Y si se..., si crece grande el bejuco es grueso, grande, así crece de..., de grueso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>Y si este, de veras si uno lo quiere cortar, uno lo quiere cortar para ocuparlo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>el bejuco se puede partir como si fuera hule. Se le mete el machete y lo partes un poco, enseguida nada más la jalas y se va rompiendo como si fuera hule, es suave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Y se puede la..., se puede labrar, se puede labrar para que quede cilíndrico y así queda. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>para elaborar como .... Nosotros también trabajábamos, hacíamos artesanías.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>En donde, una parte del bejuco yo lo desperdicié porque lo..., después supe que es bueno para curar la enfermedad de los riñones y para el corazón, alguien que padece de riñones se puede curar con esta planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>Entonces en ese momento me di cuenta que estoy desperdiciando el bejuco y es bueno para medicina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>Por eso ya no lo seguí cortando, porque yo uso el bejuco para hacer huacales. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>A mi me gusta el bejuco porque es muy blandito, se puede..., se puede manejar como a uno le guste, se puede doblar hasta, yo ocupaba el bejuco para hacer fruteros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>No se quiebra, yo hacía, lo doblaba como a mi me gustaba como si fuera (la forma de) un incensario.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>Lo hacía puntiagudo por la base  en forma circular, lo doblaba el bejuco y quedaba bonito. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Quedaba bonito porque el beujco es suavecito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>Pero de que se, se..., quiero decir que cuando se seca se vuelve</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>de color rojo como el &lt;i&gt;kwesalmekat&lt;/i&gt;, queda de color rojo el bejuco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Es rojo como el, como el que le llaman &lt;i&gt;poposokani&lt;/i&gt;.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Es rojo por dentro pero, pero encima el be..., el bejuco tiene la corteza de color verde</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Y también tiene musgo. Así crece de grueso y tiene musgo al tardar mucho para crecer como si fuera un árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>El bejuco tiene musgo no es liso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>No lo cortas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>No este, yo no, no, he visto allá en el campo pues no se..., no tumban los bejucos porque casi no hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>Yo sé que allá en el bosque sólo hay como dos matas nada más, eso es lo que sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Pero nunca veo en otro lugar más, sólo ahí lo he visto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Sí y ahí si hay bejuco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a395" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>No,ese lo toman hervido. Hierven las hojas y este toman en la mañana, a mediodía y en la noche para que les haga efecto y se les quite el dolor de rñones. Creo que el dolor de riñones provoca la dificultad de orinar y entonces después se convierte cómo le llaman.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a396" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Ese el mal de orín, tienen dificultad para orinar y por eso se..., les duele el riñon y de ahí proviene el mal de orín.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Cuando empiezan los dolores del riñon a veces provoca</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Entonces el agua se vuelve de color rojo como si fuera agua de lluvia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Pues..., y, y son diferentes o puede ser el mismo pero lo conocemos con nombres diferentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Mm, sí, este, este también se ve que es bejuco, si se corta, digamos nosotros si cortamos así en rebanadas delgadas como le llaman los mestizos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>Este queda de color ro..., rojo la madera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>Y este no es muy duro, sino que es un poco suave como el bejuco del &lt;i&gt;poposokani&lt;/i&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>Sí como cuando se corta el &lt;i&gt;poposokani&lt;/i&gt; y sale agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>Así es mero, ése no, no, no es muy macizo el bejuco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>No es macizo sino que se ve así como muy suave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>Si ves el bejuco es as..., as..., así merito ese bejuco del que estamos platicando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Pero el &lt;i&gt;tata:wikomekat&lt;/i&gt; es diferente, ese, ese se ve luego que es duro, y ése es de color blanco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>El &lt;i&gt;tata:wikmekat&lt;/i&gt; tiene una sola médula y si es duro, muy duro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>Y aquél no, aquél se cor..., se corta pa..., es suave como te decía, es como el &lt;i&gt;poposokani&lt;/i&gt;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>Así es el bejuco del que estamos platicando. No es macizo el bejuco sino que como si fuera es..., como si tuviera algodón por dentro, mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>Mm, mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>No las conocemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
