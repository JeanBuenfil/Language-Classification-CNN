                <ANNOTATION_VALUE>Onkak ka:mpa owihka:n ka:mpa ti..., ka:mpa pahpawetstok n' a:t ompa mochi:wa n' yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
