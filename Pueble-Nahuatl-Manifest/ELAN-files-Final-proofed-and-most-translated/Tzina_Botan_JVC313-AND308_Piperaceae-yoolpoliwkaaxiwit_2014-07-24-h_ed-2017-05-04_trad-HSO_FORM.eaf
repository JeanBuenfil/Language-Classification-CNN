            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
