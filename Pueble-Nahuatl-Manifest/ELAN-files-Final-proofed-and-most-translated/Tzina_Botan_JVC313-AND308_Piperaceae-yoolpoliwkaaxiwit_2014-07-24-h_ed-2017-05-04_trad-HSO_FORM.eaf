    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>Pues aquí nos encontramos nuevamente, puedes pla..., platicarme otra vez si conoces el yo:lpoliwka:xixiwt</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>Este puedes pla..., platicarme</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>Es chiquita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Aa hervidas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>No lo deben de saber.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Pues, debe ser la misma planta que yo co..., conozco que es muy bueno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>A mí también me..., me invitan que las vaya a traer por ahí, por arriba, para acá de donde están conectados los tubos de agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Hacía abajo del arroyo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Ahí se encuentran las matas en la superficie de los riscos, luego las conoce uno porque tiene hojas alargadas como ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>De tamaño se parecen así como las hojas de owakilit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Ahí se encuentran, crecen en forma vertical y son chiquitas, no son altas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>Y en la punta de la planta brota la flor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>sólo una flor, no tiene muchas flores y son pequeñitas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>Y yo también he ido a  traerlas, ya son como cuatro personas las que me encargaron que las traiga.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>De veras como me platicas. Yo sí lo creo porque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>yo voy a traerlas y las este las..., las pongo a hervir, yo las machaco y yo les voy a dar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Consigo un traste, le..., le echo un poco de agua, enseguida echo el agua en un vasito</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Luego la pongo a colar, enseguida le..., le doy al paciente para que se la tome.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Entonces le doy para que se lo tome. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>Después machaco las hojas y le..., le..., froto el jugo en la..., en la espalda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Sí, mm, mm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Y hasta ahora no ha sentido nada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Después este también le frotamos el jugo de esta planta que quizá también la conoces, esa que le llaman cho:kilohxiwit gordolobo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>También se..., se machacan las hojas, también se machacan y el jugo se..., se les..., les frota. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Se baña al paciente y se le frota.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Esta hierba no la toman.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Ésta planta del yo:lpoliwka:xiwit, ésta..., ésta la toman, se hierven y se le da de tomar al paciente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Se la toman, se le echa agua y se la toman bien no, no es amargo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Cuando se cuela bien queda el agua de color verde y luego se..., se, se la toma uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Se la toma uno o se..., se le da de tomar al paciente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Pero debe ser en secreto no, no debes decirle a alguien que yo voy a traer porque.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>A mí..., a mí me decían mis padres que si vas a traer no le vas a decir al paciente pues allá voy a traer esta hierba, este</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a367" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>es para remedio. Me voy pero sin que nadie lo sepa, corto las hojas, las envuelvo y les..., les digo en la casa que tengan listo un traste para hervirlas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>cuando llego y luego lo..., lo pongo a hervir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>En esa misma tarde le..., espero que se enfríe y le doy, le..., voy a dejarle a su casa, le digo, si no quiere tomar le engaño que también tomo un poquito y le digo, "toma esta aguita porque se siente mucha sed".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>Pues ya se la toma el niño si es pequeño o un adulto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>Puede decir, "Es muy sabroso el aguita". "Sí es..., es sabroso".</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>Despues le digo, este, pero a nadie le digo que voy a preparar el remedio o le voy a dar para que se la tome.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>que allá fui a traer, que me invitaron, no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>Eso debe ser en secreto, dicen que si alguien le dice uno no..., no sale efectivo el remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>No hace efecto porque yo lo..., lo sé porque ya fui a traerles como dos o tres personas y lo creo porque hay que apartar el día para conseguirlas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>Pero no lo vas a encontrar una buena cantidad. Si uno lo busca lo encuentra pero un rollito muy pequeño. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>A veces sólo alcanza para hervir dos veces, sólo dos veces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>No puedo decir que te invitan, "A pues ve a traer rapidito al río y regresas luego"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>Así lo buscas varios lugares en el río y no lo vas a encontrar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Esa planta se encuentra en el agua, en donde,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>cae el agua en la superficie de los riscos. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>también en donde cae mucha agua no hay plantas por las arranca el agua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>Las plantas se encuentran en la superficie de los riscos, se ven así paradas pero muy escasas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>para juntar un rollito debe uno buscar en todo el río. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>Debe uno de andar por todos lados del arroyo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>Todo por don..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>Muy fría, luego a veces se acuestan, se abrigan bien para que duerman, así les hace efecto si uno les frota también. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>Esa planta es buena porque es fría.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>Y las hojas no son duras. Son muy suaves para que se machaquen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>Es blandita para machacarlas y se frota al paciente en la espalda, en la cabeza, todo en sus manos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>y un poco se la toman, también se les frota el jugo de la planta que tiene la savia amarilla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>Es bueno usar juntas ... También se usa, esa es diferente, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>con esa se..., se..., los baña uno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a420" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>Pero esa no se..., No se..., no se pone a..., a hervir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a421" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>Sólo las hojas de esa planta se machacan así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a422" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>Al machacar las hojas sale el jugo con espumas. De ahí se..., se em..., empieza a frotarle al paciente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a423" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>le frota uno como si lo bañara y le hace efecto junto con la otra hierba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a424" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>La planta del yo:lpliwka:xiwit es muy buena.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a425" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>Esa planta no puedo deciir, auque te digan, "Te da tiempo, ve a buscar rapidito la vas a encontrar"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a426" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>A..., A veces tarda uno siquiera dos días de andar buscando esa planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>Siquiera dos días para que juntes así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a428" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>Pues yo lo encontraba por ahí, por allá arriba donde están co..., conectados los tubos de agua hacia abajo, donde fuimos la vez pasada en el arroyo, en la superficie de los riscos se encuentran las plantas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a445" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>Por aquí abajo, hace unos años que yo fui allá en Xaltipan no encontré en ninguna parte esa plantita. Hay una que se parece pero no es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a446" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>Y eso ahora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a447" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>Está cayendo el agua y esa planta no podemos decir que va..., que los pájaros se van a comer las semillas porque ca..., caen sólas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a448" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>y no nacen en cualquier lugar, nacen sobre las piedras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a449" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>En las piedras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a450" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>En donde hay musgo sobre los riscos ahí nacen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a451" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>Pero nunca lo vas a ver en la arenilla porque ahí no se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a452" ANNOTATION_REF="a247">
                <ANNOTATION_VALUE>En la superficie de los riscos si uno lo busca por ahí se encuentra alguna planta, pero no se dan las plantas así tupidas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a453" ANNOTATION_REF="a249">
                <ANNOTATION_VALUE>No. No se da mucho, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a454" ANNOTATION_REF="a251">
                <ANNOTATION_VALUE>Se da todo por aquí, hace poco fui allá al lugar de donde es están acordando acá en Masa:owatah, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a455" ANNOTATION_REF="a252">
                <ANNOTATION_VALUE>Ahi hay un lugar donde está cayendo el agua, también se da, la vez pasada que fui a buscarla encontré. Ya..., ya tiene años.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a456" ANNOTATION_REF="a254">
                <ANNOTATION_VALUE>Actualmente voy por allá por Koyo:pol..., por allá arriba en donde m..., Aa usted ha de saber cómo se llama ése lugar Por acá de Po:chnetah, toda esa parte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a457" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>Ahí se encuentra en los arroyos. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a458" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE>Pero en donde está cayendo el agua, en el río más grande no hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a459" ANNOTATION_REF="a260">
                <ANNOTATION_VALUE>No se encuentra en, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a460" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>[...] si vas en el rio Tozán, en el río no lo vas a encontrar esa planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a461" ANNOTATION_REF="a264">
                <ANNOTATION_VALUE>Aunque andes por ahí todo el día no la vas enconntrar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a462" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>Yo voy a veces a buscar dos días para juntar esa planta pero no junto mucho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a463" ANNOTATION_REF="a268">
                <ANNOTATION_VALUE>No encuentro mucho, muy poquito porque es muy buen remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a464" ANNOTATION_REF="a270">
                <ANNOTATION_VALUE>Muchas personas saben y muchas no saben. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a465" ANNOTATION_REF="a282">
                <ANNOTATION_VALUE>Pues no todos la conocemos pero, pero aquí es..., estamos platicando bien y usted la conoce tanto como yo la conozco también.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a466" ANNOTATION_REF="a284">
                <ANNOTATION_VALUE>Pues eso le podemos platicar a una persona y podemos ir a verla. Alguien puede decir, "Pues vamos a verla al lugar donde hay."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a467" ANNOTATION_REF="a286">
                <ANNOTATION_VALUE>También nos puede platicar nosotros le platicamos. Y para que la vaya a ver si en donde se da es un lugar difícil, es fácil o quizá nace la planta en el bosque.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a468" ANNOTATION_REF="a288">
                <ANNOTATION_VALUE>Todo esto es bonito como aquí estamos platicando, usted sabe cómo se consigue esa planta, cómo se prepara, yo lo sé igual. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a469" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>Pues estamos pla..., platicando muy bien y pues así lle..., llega el día en que alguien nos invita pues podemos ir a traerla esa plantita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a470" ANNOTATION_REF="a292">
                <ANNOTATION_VALUE>La gente también sabe que yo ando en el campo. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a471" ANNOTATION_REF="a294">
                <ANNOTATION_VALUE>Saben que conozco donde se da y saben que conozco la planta pues también me..., me..., buscan por la mañana o por la tarde, dicen, "Búscala esta planta quizá la...." Sí</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a472" ANNOTATION_REF="a296">
                <ANNOTATION_VALUE>Pero salgo a escondidas, llevo alguna cosa y no le voy diciendo al que encuentro, "¿A donde vas, a donde ...? Me preguntan, "voy por ahí a pasear" </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a473" ANNOTATION_REF="a298">
                <ANNOTATION_VALUE>Pero no les digo para qué voy. Yo llego y preparo el remedio, enseguida la cuelo con una tela para sacarle los residuos de hierba y ya le..., le voy a dar al</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a474" ANNOTATION_REF="a300">
                <ANNOTATION_VALUE>Le digo "aquí traje aguita, tómala." Yo tomo un poquito para que no piense que le estoy engañando.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a475" ANNOTATION_REF="a301">
                <ANNOTATION_VALUE>Entonces primero yo tomo y le digo, "Toma un poquito." Pues sí eso es.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a476" ANNOTATION_REF="a302">
                <ANNOTATION_VALUE>Pues eso es lo que s..., sé, es todo lo que yo conozco, usted también me puede decir quizá sabe algo más ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a477" ANNOTATION_REF="a304">
                <ANNOTATION_VALUE>Sí, entonces puedes decirme tu..., tu nombre, cómo te llamas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a478" ANNOTATION_REF="a306">
                <ANNOTATION_VALUE>A bueno, yo me llamo Anastacio Nicolás Damián, vengo de allá del pueblo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Sí la conozco esa planta, este,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>se da, no se da en el cafetal, no se da en el potrero, no se da en cualquier lugar que sea en el bosque.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Se da ..., se da en un lugar específico donde cae el agua de un río.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>Se da en donde cae el agua y donde siempre están mojados los riscos por las brisas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>Porque este allá en el Ista:ka:t donde está cayendo el agua no se da, en el mero Ista:ka:t, no porque se es..., escasea, esta planta se da en un lugar que está mojado en todo el tiempo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>moja..., en donde .... Ahí se da mucho en la superficie de los riscos. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Y no se encuentran matas muy grandes que alcancen siquiera un metro de altura que esten tu..., tupidas, no.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Esa planta se encuentra pero muy escasa cuando se busca para remedio, se encuentra pero muy poquito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>Su flor brota así hacia arriba, debe ser muy grande la flor que brota como, muy grande, muy grande, muy grande, una mata grande mide sólo como seis centímetros de altura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>su florecita brota hacia arriba.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>Y luego se conoce si la flor crece así hacia arriba, si buscas las hojas las vas a cor..., vas a cortar las hojas solamente tres o cuatro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>No tiene más hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>Sí, y cuesta mucho para que juntes una pequeña bolita de hojas, uno debe de caminar mucho y no se encuentra como quiera esa planta. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Sólo hay lugares específicos en donde se da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Sí esa planta es muy buen re..., remedio para las personas que pierden la razón, los que padecen así como locura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a117">
