        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Mohmoloxtik ima:tampa, ke:mah. Iteyotsi:n ista:k nochi, ke:mah, ista:k pero xo:chit, xo:chit a:mo ke:man se: kita yo:n, se: kita iteyo tak yehwa yo:n ke:meh, ke:meh n', ke:meh yo:n,</ANNOTATION_VALUE>
