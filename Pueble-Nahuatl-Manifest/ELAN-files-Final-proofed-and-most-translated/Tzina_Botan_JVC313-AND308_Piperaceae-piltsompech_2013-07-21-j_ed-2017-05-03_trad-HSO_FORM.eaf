        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>Pues no, no le damos importancia para curar con plantas, porque sólo hay que hacer, debemos hacerlo nosotros también curando a los niños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
