        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>No hace falta comprar, se consiguen en el campo y se..., acomodan sobre la almohada para que les sirva como cabecera.</ANNOTATION_VALUE>
