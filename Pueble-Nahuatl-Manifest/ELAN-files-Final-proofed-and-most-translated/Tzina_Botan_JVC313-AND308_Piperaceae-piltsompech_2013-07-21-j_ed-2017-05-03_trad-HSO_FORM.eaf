        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>Uno ve varias plantas pero no siempre sabe uno para qué se usan.</ANNOTATION_VALUE>
