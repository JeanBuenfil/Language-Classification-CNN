        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Sí, no, no se mueren por eso pero les hace daño a los niños, es mejor que los curen a tiempo para que no sigan sufriendo así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
