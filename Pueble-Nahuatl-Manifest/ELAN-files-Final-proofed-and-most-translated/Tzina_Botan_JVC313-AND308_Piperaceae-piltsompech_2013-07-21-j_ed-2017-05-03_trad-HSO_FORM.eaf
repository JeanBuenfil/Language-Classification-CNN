    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Anastacio Nicolás Damián" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="AND Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a159" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>Aa, quie..., quieres saber aquí cómo lo...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a160" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>Pues este se..., el piltsompech se usa, este se..., decían que algunas veces las hojas acomodaban sobre la almohada de los niños para que al dormir las usaran como cabecera, cuando les salía ba..., baba. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a161" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>Esta planta tiene el tallo y las flores de color blanco, sus flores se cuelgan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a162" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>Las hojas son rasposas. Esa planta no crece muy alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>No crece muy alto, así se da, a veces uno ve la planta a la orilla del camino o en cualquier otro lugar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>También se encuentran las plantas en el cafetal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>Esa planta no crece muy alto, no cre..., el tallo no se puede usar para leña, las hojas sólo se usan para curar. Las hojas de esta planta son pubescentes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>Es pubescente pero no, no tiene espinas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>Y esa planta es la que se u..., usa para curar. Antes usaban nuestros abuelos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>Acomodaban las hojas en la almohada de los niños para usar como cebecera, no sé si algunas personas las hervían.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a169" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>Este, usted también ha de saber, tal vez se..., tal vez sepa si las hervían o las..., exprimían u otra forma, yo sólo sé que acomodaban las hojas sobre la almohada de los niños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>Almohada.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>Las hojas las usaban como cabecera, este ca..., </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Algunos niños echan mucha baba por la boca, hasta mojan la camisa y toda la cabecera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>O su ropa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Van a traer esas hojas, las..., las..., cortan las hojas de piltsompech y las acomodab en la cabecera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>Las usan como cabecera y les..., pues dicen es buen remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a186" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>Es buen remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>Dicen que es buen remedio esa planta, sus flores no. Las hojas son pubescentes, al pie de las hojas brotan sus flores. Son blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>Ahí brotan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Las flores brotan entre las ramas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>Pues yo tampoco he visto si, si xo..., nacen sus semillas, si tiene semillas grandes, yo siempre he visto que son alargadas que se..., se..., cuelgan. Pues en algunas partes se ven que son chiquititas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Y por eso uno lo..., lo..., en algunas partes dejan crecer las plantas. Quizá las usan para curar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a192" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>La vamos a buscar también y en algunas partes se ven bien las..., creo que se puede sembrar junto a la casa, porque es medicinal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Como en algunas partes piden para curar a los niños, pues nada más las corta uno. Las corta uno y se les da.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>También es bueno. Pedir, como uno anda en varios lugares y ve uno a las plantas para qué se pueden usar y, y ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>Pues muchos de nosotros no sabemos si son buenas para curar a los niños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Algunos vamos a la clínica aunque nuestro hijo se podría curar con una hierba, así una plantita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Es planta medicinal pero no, no lo sabemos pues lo llevamos a la clínica pensando que es mejor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>Hay que darle utilidad a las plantas para ver si se curan los niños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Cuando son pequeños les hace falta que..., hay que curarlos con esas plantas para que se curen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Pero si uno no los cura pues es cuando se..., tardan para curar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Tardan, no, no se curan y pues uno no sabe si se mueren por echar mucha baba, no se sabe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>Sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>Es el piltsompech ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>Se consiguen, tiene hojas redondas y su..., tallo se ve bonito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE> Y sus hojas son..., pubescentes en el envés.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>Son pubescentes y son blancas sus..., sus..., sus semillas o quizá sus flores.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Son como las..., las semillas de xa.lkowit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>Así se encorvan y las flores de piltsompech son rectas. Son rectas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Pues yo siempre he visto que son blancas, nunca veo que se cambien de color amarillo o diferente. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a243" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Pues no se sabe quizá sean sus semillas porque algunas partes se ven que nacen nuevas plantas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>Y las hojas tiernas las..., las usan. Usan las hojas tiernas, son las hojas tiernas pero tampoco,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a245" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>no podemos decir que crece y se puede ocupar para leña, es sólo..., crece poco, no crece alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Es una hierba nada más, y pues este, ....</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a247" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Pues yo me llamo Anastacio Nicolás Damián, vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a154" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Aa bueno, mm.</ANNOTATION_VALUE>
