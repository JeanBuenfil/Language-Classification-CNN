        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>a:mo n'mati ke:ní:w xo..., yehwa ixo:chio oso yehwa i..., ita:kka, a:mo n'mati ke:ní:w yo:n. Mm. Yehwa eski, yehwa eski. Ke:mah.</ANNOTATION_VALUE>
