        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Ke:mah, pos yehwa sah yo:n nimitstahtani:skia para ox no: tikmattok, wa:n no: *igual** tein nikmati, tein nikmati neh.Soh xine:chilwi moto:ka:i wa:n de ka:ni tiwa:le:wak.</ANNOTATION_VALUE>
