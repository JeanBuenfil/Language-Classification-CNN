        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>Yehwa yo:n we:weyak wa:n i:n a:mo, i:n, i:n moahkokehketsa, mehmelaktsitsi:n, tsikitsitsi:n. Yehwa yo:n iteyo tiki:xmatih.</ANNOTATION_VALUE>
