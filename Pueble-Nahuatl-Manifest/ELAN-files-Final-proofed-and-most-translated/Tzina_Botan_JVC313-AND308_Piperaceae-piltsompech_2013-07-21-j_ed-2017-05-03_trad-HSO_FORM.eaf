            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>Son de color blanco si haz visto. Mm, mm. Pues yo creo que nacen su semillas por eso se..., multiplican las plantas, sí nacen también. Sí, hay.</ANNOTATION_VALUE>
