        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>&lt;i&gt;Bueno&lt;/i&gt;, a:xka:n tehwa:tsi:n ta:tah ne:</ANNOTATION_VALUE>
