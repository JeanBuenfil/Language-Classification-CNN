        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>¿A:mo ki..., a:mo oksé: kokolis onkas para ki..., kipahti:s ok yo:n?</ANNOTATION_VALUE>
