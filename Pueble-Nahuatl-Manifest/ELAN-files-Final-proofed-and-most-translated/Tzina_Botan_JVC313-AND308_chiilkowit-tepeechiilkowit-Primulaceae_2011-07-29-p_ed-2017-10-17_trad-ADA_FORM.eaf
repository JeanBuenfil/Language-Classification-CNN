                <ANNOTATION_VALUE>Ke:mah, wa:n ixo:chio kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts300">
