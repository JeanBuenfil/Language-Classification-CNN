        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>Tsikitsitsi:n ne:n mochi:wa n' exo:tsitsí:n, ikwa:pan mota:lia ka:mpa xo:chitsí:n.</ANNOTATION_VALUE>
