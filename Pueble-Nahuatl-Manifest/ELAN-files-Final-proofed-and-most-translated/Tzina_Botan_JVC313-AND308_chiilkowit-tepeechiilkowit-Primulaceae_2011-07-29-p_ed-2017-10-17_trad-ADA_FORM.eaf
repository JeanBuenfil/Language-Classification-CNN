        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>De xo:chitsí:n moka:wa wa:n *cuando, cuando** chika:waya ya tahtapa:ni.</ANNOTATION_VALUE>
