            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>tak semi teltapala:ntok, wehwei mochi:wa n' ompa.</ANNOTATION_VALUE>
