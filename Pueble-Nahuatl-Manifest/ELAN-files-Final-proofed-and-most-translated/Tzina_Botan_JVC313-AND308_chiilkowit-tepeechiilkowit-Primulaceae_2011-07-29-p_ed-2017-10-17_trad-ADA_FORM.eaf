        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>ke:mah *de que** chika:waya ya mo..., moka:wa ya n' exo:tsitsí:n.</ANNOTATION_VALUE>
