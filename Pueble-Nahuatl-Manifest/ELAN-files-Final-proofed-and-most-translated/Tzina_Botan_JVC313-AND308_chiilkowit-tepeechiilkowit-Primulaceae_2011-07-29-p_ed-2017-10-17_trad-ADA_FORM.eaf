        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Wa:n de xo:chiowa ya pos yo:n no: kostik n' ixo:chiotsitsi:n,</ANNOTATION_VALUE>
