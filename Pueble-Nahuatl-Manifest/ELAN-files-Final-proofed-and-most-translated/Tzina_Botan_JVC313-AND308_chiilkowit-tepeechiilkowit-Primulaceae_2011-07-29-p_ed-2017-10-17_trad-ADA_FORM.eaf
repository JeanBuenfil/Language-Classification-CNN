            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>Tela:yoh yo:n, yo:n a:mo tata xoxowik, tata mah kwali wa:ki.</ANNOTATION_VALUE>
