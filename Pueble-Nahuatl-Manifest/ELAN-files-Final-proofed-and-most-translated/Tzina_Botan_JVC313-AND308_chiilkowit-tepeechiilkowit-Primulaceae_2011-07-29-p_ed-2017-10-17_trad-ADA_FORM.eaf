                <ANNOTATION_VALUE>Pos yehwa sah *compadrito** yo:n, neh nimitstahtania kox tiki:xmattok yo:n, nehwa niki:xmati no: *igual** yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
