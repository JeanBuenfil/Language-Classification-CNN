        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>Yo:n kwaltsi:n seki wehwei no: mochi:wa tepitsi:n, wa:n de n' we:ikowit a:mo kwaltia, kwaltia de n' achi ihkwi:ntsi:n para n' kalkowit. Wa:n yehwa yo:n a:mo nikmati kox kwali ki..., kitapa:nah *o** para teisá: kalkowit oso ...,</ANNOTATION_VALUE>
