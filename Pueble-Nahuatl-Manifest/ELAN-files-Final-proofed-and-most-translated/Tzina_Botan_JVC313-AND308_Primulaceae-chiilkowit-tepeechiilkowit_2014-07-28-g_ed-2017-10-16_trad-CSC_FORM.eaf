                <ANNOTATION_VALUE>Wa:n yo:n a:it ke:maniá:n, ne:n, ne:n, xo:chiowa neh a:mo no: nikmati kox neh no: nikitani sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
