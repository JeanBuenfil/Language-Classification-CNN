        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Ke:masá: ke:meh se: pano:tok ihkó:n tik.... Se: kita pan..., panxii:ntok niman se: kihtowa pos ompa yetok yo:n chi:lkowit.</ANNOTATION_VALUE>
