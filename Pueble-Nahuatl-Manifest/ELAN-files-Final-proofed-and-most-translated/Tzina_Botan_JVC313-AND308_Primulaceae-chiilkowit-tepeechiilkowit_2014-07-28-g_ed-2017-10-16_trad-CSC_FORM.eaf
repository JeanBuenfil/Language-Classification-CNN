        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>No: kwaltia wa:n pos neh a:monikmattok de ne:n, ni..., a:mo nik..., ne: sayoh ke a:mo nikmati kemaniá:n ne: xo:chiowa.</ANNOTATION_VALUE>
