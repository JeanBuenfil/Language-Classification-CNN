        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Yo:n *de, de** wehkapa:n, pos a:mo, a:mo wel nankipano:ltihkeh t..., tata:mpa nankipano:ltihkeh nijó:n kowit.</ANNOTATION_VALUE>
