        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Wa:n ke:masá: nijó:n xama:ni no: pero a:mo se: kimati wa:n i:n okseki pos kwaltsi:n yema:nik i:n *siempre** i:n chi:lkowit.</ANNOTATION_VALUE>
