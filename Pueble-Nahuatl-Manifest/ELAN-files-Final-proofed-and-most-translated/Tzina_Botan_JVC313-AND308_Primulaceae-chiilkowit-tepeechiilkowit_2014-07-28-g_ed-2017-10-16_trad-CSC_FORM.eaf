        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>Pos a:it ke:yeh nijó:n kiliah tepe:chi:lkowit ta: mochi:wa itsi:nta:n n' tepe:t. Pero seki a:mo, a:mo mochi:wa itsi:nta:n n' tepe:t ta: paniá:n mochi:wa.</ANNOTATION_VALUE>
