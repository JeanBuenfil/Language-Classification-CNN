        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>y que cuando son tiernos, son verdes y de maduros son negros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Se ponen negros. Y sus hojas son largas y angostas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>Y pues yo sé, porque he visto que los trozos gruesos se parten bien y al partirlo, en el centro del trozo es como brilloso. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>Pero unos dicen que no se puede partir pero si se parte. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>Y el otro llamdao tepe:chi:lkowit se hace grande,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>Y pues también sirve para tirantes y para alfardas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>Pero yo nunca he visto que lo asierren para vigas pero dices que también sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>A por encima, por lo alto. Y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>Pues de que está alto, las vigas no las pudieron pasar por abajo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>NO pudieron pasar por abajo. ¿Y no se partió esa madera?.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>A se parte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>No es igual como otra madera entonces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Pues sé que se parte muy bien y sirve para leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Todas sus ramas sirven y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>yo creo donde,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>tiene ramas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Y ese quien sabe en que mes florea, yo tampoco sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>En las puntas tiernas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Pues quien sabe por qué le dicen tepe:chi:lkowit pues abunda en los pies de los cerros. Pues unos no se dan al pie de los cerros sino que en las puntas de los cerros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Pues a lo mejor siempre asi es su nombre, tepe:chi:lkowit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Y ahí se corta la madera para la construcción de casas pero es muy pesado para traerlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Son rectos y</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>pues anteriormente nosotros los cortabamos porque son muy resistentes para alfardas. El machete lo mella y los clavos se doblan al clavarlo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>No se clavan porque es muy dura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>Y a veces se parte pero no se sabe porque el chi:lkowit es de madera blanda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>Se puede clavar y también sirve para ponerla atravezada como cintas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>También sirve. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>Esa madera sirve para tres cosas: para tirantes, para cargadores y para alfardas de todo sirve esa madera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>Es bonito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>Y donde hay de ese árbol, luego se da cuenta uno porque están volando los pájaros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>Están volando los pájaros como el chiwihkoyo, a lo mejor se come las semillas, también he visto los wi:likiso:meh o los tucanes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>los pe:sohchiktehmeh se lo comen rodeando el árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a191">
                <ANNOTATION_VALUE>A veces cuando uno va pasando se puede ver como están regándose las semillas y asi se puede saber que ahí hay un chi:lkowit.  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a193">
                <ANNOTATION_VALUE>Las semillas se dan un poco grandes, y los árboles grandes no sirve para la construcción de casas, sirven los que no están muy gruesos. Y es lo que yo no sé si es lo pueden aserrar o sirve para la construcción de casas...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a195">
                <ANNOTATION_VALUE>Y ese a lo mejor es vidrioso. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a197">
                <ANNOTATION_VALUE>No crecen, y quiero preguntarte si sirve para algún remedio o</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a199">
                <ANNOTATION_VALUE>No sirve para remedio, sirve para leña y como dices, las semillas se lo comen los pájaros y son árboles pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a201">
                <ANNOTATION_VALUE>Son árboles pequeños y gruesos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a203">
                <ANNOTATION_VALUE>Pues es lo que yo sé, que las hojas no sirven para remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a205">
                <ANNOTATION_VALUE>Nada más sirve para dos cosas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a367" ANNOTATION_REF="a207">
                <ANNOTATION_VALUE>Nada más para leña, y para la construcción de casas, solo para eso sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a209">
                <ANNOTATION_VALUE>Salen muy bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>Y yo vi que la corteza del chi:lkowit es rojiza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a213">
                <ANNOTATION_VALUE>Y (la corteza) del tepe:chi:lkowit es grisácea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>Es rojiza y parece que crece más alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a219">
                <ANNOTATION_VALUE>Si, crece más alto, crece muy largo. Entonces no es árbol pequeño.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a222">
                <ANNOTATION_VALUE>Ya no crece. Y a lo mejor el otro crece un poco más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a224">
                <ANNOTATION_VALUE>Es alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a397" ANNOTATION_REF="a227">
                <ANNOTATION_VALUE>Pues como allá viviamos, si veiamos como lo iban a traer, y como ese se pone arriba del fogón y se secaba en tres días, si se parte y se pone arriba del fogón se secaba muy pronto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a398" ANNOTATION_REF="a229">
                <ANNOTATION_VALUE>Ese arde bonito.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a399" ANNOTATION_REF="a231">
                <ANNOTATION_VALUE>Pues como ya se acabó ese tepe:chi:lkowit ya ocupan cualquier leña, les gustaba el tepe:chi:lkowit porque produce buenas brazas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a400" ANNOTATION_REF="a233">
                <ANNOTATION_VALUE>Ese produce buen carbón. Es duro y pesado pero produce muchas brazas. Es muy bueno para cuando se prepara la comida u otras cosas. Se cocen facilmente las cosas y así no tardan en hervir las cosas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a401" ANNOTATION_REF="a235">
                <ANNOTATION_VALUE>Si. Pues si sabes algo más de esto me puedes decir si es que falta algo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a402" ANNOTATION_REF="a238">
                <ANNOTATION_VALUE>Pues yo tampoco sé más, nada más lo que te platiqué y como me platicaste. Pues es muy bonito que nos damos a conocer como siempre andamos o cuando hacemos una casita, todo eso nos damos cuenta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a403" ANNOTATION_REF="a240">
                <ANNOTATION_VALUE>Pues que bueno como ahorita que nos encontramos en este camino, ya nos platicamos lo que sabemos en que nos sirve cada árbol.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a404" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>Si, pues es todo lo que yo sé.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a405" ANNOTATION_REF="a244">
                <ANNOTATION_VALUE>Pues si ya es todo, ahora me puedes decir como te llamas y de donde vienes?.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a406" ANNOTATION_REF="a246">
                <ANNOTATION_VALUE>Pues igual, yo me llamo Anastacio Nicolás Damián y vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a407" ANNOTATION_REF="a247">
                <ANNOTATION_VALUE>Bueno.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Ernesto Vázquez Chanico" PARTICIPANT="Ernesto Vázquez Chanico" TIER_ID="JVC Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>¿Quieres saber cuál es ese árbol?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Pues yo conozco el chi:lkowit y el tepe:chi:lkowit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>El chi:lkowit abunda por acá en los potreros y en los campos abandonados. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Son palos rectos pero no son muy largos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>Pero también es muy bueno porque los que son un poco gruesos se pueden ocupar para tirantes o alfardas en la costrucción de casas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a257" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>Y sus semillas se dan en hileras pegadas en sus ramas, no se dan en racimos, solamente se pegan en las ramas. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a258" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>Hay muchos frutos o semillas que se dan en racimos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a259" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>como el capulin se da en racimos. Pero este no, se dan en hileras pegadas a las ramas y cuando florea, sus flores son blancas, las semillas cuando estan tiernas son verdes y cuando ya maduran, se vuelven negras.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a260" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Las semillas son muy codiciadas por los pájaros como las primaveras, los papa:meh y los coyoltsitsi:n.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a261" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>Esa madera es pesada pero sirve para alfardas y otros lo ocupan para cintas cuando techan con lámina de cartón. Eso se le pone a la casa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>Los palos que son rectos sirven para cintas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a263" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>Y es muy resistente, no todas las veces se apolilla. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a264" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>Y el tepe:chi:lkowit se adapta en las colinas, abunda en las colinas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a265" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>Y se hacen muy grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>El tepe:chi:l se hace grande como de una brazada de grueso o más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>Y crece como de ocho a diez metros de altura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>Y se ramifica mucho. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>Y en las zonas abiertas se ramifica mucho pero cuando nace en el monte, nace entre los árboles, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>se hacen rectos y árboles grandes los asierran para vigas y para leña sirve mucho porque arde muy bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>Y se parte muy facil como si fuera bambu, se parten muy rectos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>Nada más que es muy pesado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>Y sus semillas son diferentes, no se dan en hileras en sus ramas, sus semillas se dan en las partes tiernas de las hojas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>Ahí se dan sus semillas erectas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>Nunca he visto sus flores, pero he visto como se abren sus semillas cuando ya estan maduros, se abren y se esparcen en el suelo. Y ahí vuelven a nacer. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>Esas no se la comen los pájaros porque son delgadas y secas, se parecen al nylon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>He visto que sus semillas se esparcen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Eso es lo que he visto, pero ese no se lo comen los pájaros, el otro chi:lkowit si se lo comen los pájaros. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>Si. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>Se lo comen también pero el árbol no crece alto, no se hacen árboles grandes. Esos no sirven para viga, pero los otros que si se hacen árboles grandes, los asierran para vigas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Si, las cortan para vigas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Pues como son árboles gruesos por eso pueden sacar tirantes, nada más que son muy pesados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>Son negros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>Si. Ese es de hojas largas, es de hojas largas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>Se parte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>Pues yo sé porque lo vi en A:te:noh...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Un señor que ahí viviá había mandado a aserrar unas vigas, el tepe:chi:l es un árbol que se hace muy grande,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>le habián aserrado unas vigas. Y yo sé porque nos había invitado a que le ayudaramos y le fuimos a traer sus vigas. Yo ví que estaban muy bien y estaban muy pesados.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Con mucho trabajo las subimos por Teko:ntitan, en ese entonces no había carretera, como ahora fácilmente se puede llevar o se lo puede llevar un camión. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Pero anteriormente lo traian las besttias y en los lugares muy feos se les ayudaba para que lo pudieran pasar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Y como las habían cortado largas entonces no las pudimos pasar por abajo en los arcos sino que las pasamos por encima.  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>Las jalamos con lazo porque las habían aserrado muy largas y el arco tiene curvas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>Por esa razón no las pudimos pasar por abajo, nos costó mucho trabajo. No se puede pasar porque está angosto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>No, no se pudo pasar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>No, no se partió, pero esa madera al aventarla se parte por mitad porque es recta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>Si, se parte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>No es como el carboncillo que no se parte porque esta madera se parte muy fácilmente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Asi, esa se parte muy bien</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>ese árbol se ramifica mucho y las ramas son rectas, arden muy bien, es muy buena leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Se ramifica mucho. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Pues tampoco he puesto atención, pero he visto cuando ya está amduro, como siempre andamos en la colina, por ahí nos encaminamos por Ta:chi:chi:l y ahí veo esparcidas sus semillas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Si, el tepe:chi:lkowit da sus frutos en las puntas de las ramas como el olo:pio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Y del que estamos hablando el chi:lkowit, ese no da sus frutos en las puntas tiernas, ese da sus frutos en hileras en sus ramas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Sus ramas son rodeados de frutos que son muy codiciados por los pájaros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Pero el tepe:chi:lkowit da sus sus flores y sus frutos en las puntas tiernas de las ramas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Quien sabe por qué. Abunda en los cerros y en las colinas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Nada más lo nombran a sí pero ese no se da en los cerros, abunda en las colinas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>Es pesado pero es bonito de que se hacen bien rectos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Son rectos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>El otro lo mella mucho el machete.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>Si, no se clavan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>Es madera dura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>El chi:lkowit es blanda para clavarla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>También sirve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>Se hace muy recta la madera. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>Sirve. Sirve para todo. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>Cuando los frutos se maduran se lo comen los pájaros. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>Si se lo comen. Se lo comen los tucanes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a194">
                <ANNOTATION_VALUE>Sirven los árboles pequeños porque los árboles grandes se hacen chuecos. Ese no sirve para aserrarlos y hacer vigas porque no se hacen grandes, esos no se engruesan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a196">
                <ANNOTATION_VALUE>no crecen mucho, son árboles pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a198">
                <ANNOTATION_VALUE>si, son árboles pequeños.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a200">
                <ANNOTATION_VALUE>no sirve pues...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a202">
                <ANNOTATION_VALUE>Pero el otro sirve para viga, asierran los árboles grandes. El tepe:chi:l se hace árbol grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a204">
                <ANNOTATION_VALUE>Si. No sirven para remedio.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a206">
                <ANNOTATION_VALUE>No. El tepe:chil sirve para leña, solo sirve para leña porque no da frutos para que los pájaros se lo coman, sólo es para leña y para vigas salen muy bien porque son árboles rectos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a208">
                <ANNOTATION_VALUE>Hay árboles. Los árboles grandes los asierran para vigas porque salen muy bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a210">
                <ANNOTATION_VALUE>Salen muy bonitas nada más que son muy pesados para acarrearlos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a212">
                <ANNOTATION_VALUE>Si, si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a214">
                <ANNOTATION_VALUE>Ese si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a215">
                <ANNOTATION_VALUE>Es un poco grisácea. Pero el otro es rojiza, si se le hace un corte con el machete es rojiza.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a217">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a218">
                <ANNOTATION_VALUE>El tepe:chi:lkowit es más alto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a220">
                <ANNOTATION_VALUE>Si es alto. Y el chi:lkowit por mucho sólo crece como seis metros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a221">
                <ANNOTATION_VALUE>Y ahí se ramifica como si fuera sombrilla, se ramifica y ahí termina. Ya no crece más.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a395" ANNOTATION_REF="a223">
                <ANNOTATION_VALUE>Ya no crece. Si, el tepe:chi:l se hace árbol grande.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a396" ANNOTATION_REF="a225">
                <ANNOTATION_VALUE>Si, crece muy alto y se hace árbol grande, en Tahchikteko donde era el terreno de Sixto, hasta así de gruesos tumban los tepe:chilkomeh para leña, echan a perder los árboles, pero como no es de ellos, pues son los vecinos los que hacen el daño.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a226">
                <ANNOTATION_VALUE>Hemos vito que tumban los árboles y se avorazan acarreando toda la leña, tu los viste por allá. Como allá creciste, bien que veias como iban a traer la leña verde del tepe:chi:l. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a409" ANNOTATION_REF="a228">
                <ANNOTATION_VALUE>Si, cuando ya se seca un poco ya se puede ocupar porque ya arde.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a230">
                <ANNOTATION_VALUE>Pues por eso les gustaba esa madera. Anteriormente los vecinos escogian la leña pero ahora ya ocupan cualquier tipo de leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a232">
                <ANNOTATION_VALUE>Si. Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a412" ANNOTATION_REF="a234">
                <ANNOTATION_VALUE>Arde muy bien y produce muy buenas brazas. Si. Produce muy buenas brazas y por eso se cocen facilmente las cosas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a413" ANNOTATION_REF="a236">
                <ANNOTATION_VALUE>Pues eso es todo. No, lo que sé ya es todo lo que te platiqué. Ya no sé nada más. No lo usan para remedio, solamente para leña, para alfardas y los árboles grandes las asierran para vigas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a414" ANNOTATION_REF="a237">
                <ANNOTATION_VALUE>El tepe:chi:l arde muy bien para leña.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a415" ANNOTATION_REF="a239">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a416" ANNOTATION_REF="a241">
                <ANNOTATION_VALUE>Si.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a417" ANNOTATION_REF="a243">
                <ANNOTATION_VALUE>Si, esta bien entonces, esta bien.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a418" ANNOTATION_REF="a245">
                <ANNOTATION_VALUE>Pues yo me llamo Ernesto Vázquez Chanico y vengo de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a419" ANNOTATION_REF="a248">
                <ANNOTATION_VALUE>Gracias.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
