        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>A: paniá:n ya, *porin** wehkapan. Wa:n,</ANNOTATION_VALUE>
