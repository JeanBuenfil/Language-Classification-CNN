        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Tsikitsitsi:n wa:n yo:n nimitstahtani:sneki a:mo, a:mo kwaltia para pahti n' ixiwyo, *o**,</ANNOTATION_VALUE>
