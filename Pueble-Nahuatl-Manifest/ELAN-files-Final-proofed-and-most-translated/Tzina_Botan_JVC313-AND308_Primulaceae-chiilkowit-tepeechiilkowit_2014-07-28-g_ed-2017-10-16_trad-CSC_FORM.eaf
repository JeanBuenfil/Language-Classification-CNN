        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Pero neh a:mo ke:man nikita ne: mah kitekika:n, tak, para teisá: *viga** ne: pero, tikihtowa ke kitekih pos no:, no: kwaltia.</ANNOTATION_VALUE>
