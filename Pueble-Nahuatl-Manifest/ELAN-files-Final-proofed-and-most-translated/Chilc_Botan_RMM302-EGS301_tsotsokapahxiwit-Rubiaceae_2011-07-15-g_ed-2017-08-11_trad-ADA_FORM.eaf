    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Eleuterio Gorostiza Salazar" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="EGS Traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>Rubén, ahora, platíquenos sobre el tstsokapahxiwit, ¿Qué...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>¿Para qué sirve y en qué parte se da?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>El tsotsokapahxiwit, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>yo conozco ese, al que habían cortado, quizá sea al que tu mencionas que se parece, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a192" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>los frutos se parecen como capulines.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a193" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>Que al madurarse tornan a ser negros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a194" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>Esos son otros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a195" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>Y unos se da en los potreros, también así los conocen,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a196" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>pero las hojas son mucho más pequeñas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a197" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>y..., pero esa parece que nunca he visto que floreé o que tenga semillas, parece que solamente tiene hojas rasposas o con pubescencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a198" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>Pero dices que ese, la de las semillas que tornan a ser negras, las hojas son un poco más grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a199" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>Y la  otra, la que te digo tiene hojas pequeñas, crece en potreros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a200" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>Yo sé, he escuchado de la gente, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a201" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>Pero no sé, como yo nunca he tenido mezquinos y nadie de mis vecinos ha tenido.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a202" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>Pero he escuchado que la que se da en potreros es la que cura los mezquinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a203" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>Pero de los capulines que tú mencionas no sé si también cura.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a204" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>esa es la que tiene efecto de medicina. Yo les escuchaba a otras personas que esa no tiene efecto de medicina, pero la que crece en los potreros es la que cura los mezquinos, y dicen que con las hojas</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>raspan los mezquinos. Y quien sabe si duele pero tú, ahora mencionas que sí duele.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>Pero todo eso (que tu mencionas) yo no sé.  Porque hay (plantas) que curan, bueno, yo he escuchado de otras personas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>pero nunca las ocupa uno. Yo nunca he usado los frutos de esa planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>Y sí la he visto, pues sí hay, en los potreros se da mucho, ahí se extiende muy bien,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>pero con hojas pequeñas y te digo que nunca he visto si tiene frutos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>Y la otra planta sí tiene frutos, son las que cuando se maduran, se parecen a los capulines.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a247" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>No, la que yo te digo que tiene frutos negros, es la que tú dices que se da en Ta:lchi:chi:l, la que se extiende y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a248" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>las frutos, cuando se maduran tornan a ser negros,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a249" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>Esa. No, la que te digo que la conozco como tsotsokpah, se da en los potreros.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a250" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>Pero nunca he visto que floreé, las hojas son verdes y muy pequeñas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a251" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>y también se extiende sobre el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>pero yo he escuchado de otras personas que se debe cortar las hojas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>y con ellas se raspa los mezquinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>No sé si sea cierto que tenga propiedades curativas para los mezquinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>Quizá sea cierto por eso la gente lo dice, pero eso es lo que yo te digo, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>se da solamente en los potreros, ahí se extiende, no es como la que tú dices, esa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a257" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>que se da por Ta:lchi:chi:l, la que tiene frutos negros ,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a258" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>cuando los frutos se maduran tornan a ser negros, como si fueran capulines,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a259" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>las hojas son un poco más pequeñas todavía.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a260" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>Pues esa, las hojas son grandes y la que yo te digo son muy pequeñas y se extienden.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a261" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>Pero no sé si florea, cómo es la planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Parece que es todo lo que hemos platicado sobre esta planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Eleuterio Gorostiza, vivo en Tzinacapan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Traducción" PARENT_REF="Rubén Macario Martínez" PARTICIPANT="Rubén Macario Martínez" TIER_ID="RMM traducción">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Yo conozco a una que le llaman</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>una planta que se llama tsotsokapahxiiwt.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>No sé si tú también la conozcas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Esa se da muy bien en la superficie de los bordos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Crece y se extiende. No crece alta, solamente se extiende sobre el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>Las hojas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>las hojas son pequeñas, no son tan grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Y los frutos..., los frutos..., las flores son blancas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Y los frutos son redondos, así de este tamaño</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>parecido a los frutos de café .</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a186" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Y son azules. Y donde..., en la parte donde uno tiene el mezquino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>que lo raspe uno,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>hasta que sangre. Y luego tomas el tsotsokapahteh (los frutos del tsotsokapahxiwit)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>al que le llaman (tsotsokapahxiwit y se lo untas. Aplastas el fruto con las manos y ponerle como emplasto sobre el mezquino raspado</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a205" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Pues ese no tiene..., las semillas no las tiene grandes, pues eso, nosotros decimos que las semillas de este fruto se parecen a la semilla del wa:wkilit</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a206" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Se deshace.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a207" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Machácalas con las manos y se desahace , no puedes decir, pues no podemos decir</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a208" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>que vamos a sacarle y tirarle las semillas o la cáscara. Pues es la cáscara la que hace el efecto de medicina </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a209" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>y dentro del fruto tiene las semillas pero son muy finitas, muy pequeñas. No son grandes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a210" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Entonces eso es lo que yo te digo, sirve para curar los mezquinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>Los deshaces con las manos, raspas un poco los mezquinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Y luego ya agarras los frutos de esa planta</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>y las machacas y se las untas, frotándolas muy fuerte sobre el mezquino, hasta que sientas el dolor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>Si, es la que nosotros le llamamos tsotsokapahxiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>No sé si tú también la conoces o no lo conoces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>No, no hay en todas partes, por aquí cerca también hay.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>Allá por Ta:lchi:chil, por A:tekohkomol, aquí,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>esa planta hay mucha aqui, donde nosotros vivimos, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>Quizá tu me estás platicando de esa..., tú me hablas de esa, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>la que tiene savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>Porque también es bueno para curar los mezquinos, dicen que tiene savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>Yo nunca..., para qué voy a engañarte, solo me han contado, he escuchado de otras personas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>que esa planta es muy buena, tiene savia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Esa tiene savia, las semillas de esa planta vuelan, (se salen de la planta y son levantadas por el aire).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a231" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>Dicen que esa también es muy buena (para los mezquinos). Yo nunca te voy a decir que sí es cierto porque nunca lo ocupamos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>Lo que si sé es de lo que yo te platico es la que se extiende en el suelo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a233" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>Esa se extiende en el suelo, yo te digo que es muy bueno porque la hemos usado (para los mezquinos).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>Los hemos usado.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a235" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>No lo he escuchado de otras personas, si no que lo hemos ocupado por eso lo conocemos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>es bueno para curar los mezquinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a237" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>Esa se extiende en el suelo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>y las hojas son verdes y no son tan grandes, las hojas son pequeñas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a239" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>Con hojas pequeñas y tienen un poco de pubescencia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>Y las semillas salen,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>ahí en el tallo, el tallo es como si fuera un bejuco, podemos llamarle así, se extiende.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>Y las flores son blancas y los frutos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a243" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>los frutos tornan a ser azules.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>Los frutos son azules, es la que conocemos como tsotsokapahxiwit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a245" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>No sé de cual planta tú me platicas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Es muy bueno, es muy bueno que nos hayamos ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>que hayamos platicado sobre esta planta, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a263" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Quiero saber bien, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a264" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>cual, cual es, cómo es la planta de la que tú me platicas, cómo son los frutos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a265" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>es un árbol o solamente es una planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>Eso quiero que me platiques bien, pues dices que tiene </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>hojas pubescentes y </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>dices, dices que tiene frutos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>eso es lo que..., los frutos son negros, yo quiero saber,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>quizá sea, quizá tambien la conozca, quiero que me platiques cómo es, cómo crece esa planta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>para que yo pueda decirte, quizá también la conozca.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>Eso es lo que yo quiero saber.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>Pues de la que yo te digo, no iremos muy lejos, aquí luego, aqui por donde</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>caminamos, aquí donde está la capilla, ahí donde está la capilla, sobre la superficie del bordo, ahí puedes encontrar esa planta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>Aqui muy cerca de donde vivimos lo hay. Aquí muy cerca, muy cerca la tenemos, no muy lejos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>Y eso es lo que yo te digo, pero pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>quizá sea por, digamos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>cada enfermedad, cada grano, se cura de distinta manera.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>pero no lo sabemos de todo, por decirlo así.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Quizá sea así, así como estamos platicando sobre los mezquinos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>no solamente hay un tipo de medicina, si no que hay varias formas de curar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Hasta animalitos y otros más, hay unos animalitos que pueden curar los mezquinos, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>como el tomakilokwilin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>Ese también cura los mezquinos (desapareciédolos).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>pero da miedo el tinte que arroja, manchando la piel, decimos que es muy bueno para los mezquinos, pero da miedo porque al ponerle sale como ampolla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>(ese animalito) al ponerlo sobre los mezquinos</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>ese animalito, es muy buenos para (desaparecer) los mezquinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>Agarras el animalito y lo machacas,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>y lo pones sobre el mezquino,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>pero eso sí, lo extermina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>Pero después de eso, sale una ampolla.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>Entonces una vez que sale la ampolla,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>y cuando se revienta la ampolla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>cuando se revienta la ampolla que sale, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>empeora, empeora el mezquino??</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>Yo te digo porque nosotros lo vimos, ya lo habiamos hecho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>Tengo una hija,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>en su pie, tenía un mezquino, aquí, aquí en el pie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>Y porque nosotros le dijimos, le digo, este grano, este mezquino tiene cura, le digo. Dice "qué",</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>Tomó ese animalito. Le digo, es tomakilokwilin, machacalo y úntaselo sobre el mezquino.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>Pero lo que hizo fue raspar el mezquino</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>y agarró el tomakilokwlin y se lo untó.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>A la tarde, al atardecer, a nosotros también nos asustó porque esa tarde cuando la vimos,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>se colgó como una bolsa con agua, le salieron ampollas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>Si es cierto, el mezquino desapareció. Pero te digo que después empeoró.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>Se hizo grande el grano, se le hizo ampolla</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a143">
                <ANNOTATION_VALUE>Por eso yo te digo, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>Para desaparecer los mezquinos, hay diferentes medicinas, no solamente un tipo de planta, si no que hay varios tipos </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>como en plantas y en animalitos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>Eso es lo que yo te digo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Es muy bueno que me hayas dicho, quiesiera conocer la planta que tú me platicas, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>de la planta que tú dices que sirve para desaparecer los mezquinos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Que también la conozca,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>o quizá también la conozco, quizá la he visto. Pero lo que sí es cierto,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>no sé cómo se llama.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>La que sí sé como se llama es la que te he platicado,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>cuál es y cómo es,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>y cómo crece.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>No, no crece alta como un árbol sino que solamente se extiende sobre el suelo como si fuera un tipo de bejuco.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Eso es lo que te digo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Pues sí.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Pues sí, bueno..., yo solamente eso te platico, solamente lo que sé, no puedo engañarte otra cosa diferente porque</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>pues no es bueno a que te ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>que esté inventando otras cosas.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Lo que yo sé eso es lo que te digo, agradezco mucho respecto a lo que</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>hemos platicado y yo también quisiera pues</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>mañana o pasado mañana me ...,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>si acaso nos encontramos cerca de donde hay esa planta, si te es posible córta una, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>un pedazo del tronco o las hojas y me lo enseñas para que yo pueda decirte si es la misma planta del que yo te platico.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Solamente eso, muchas gracias,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>Yo me llamo Rubén Macario,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>Vivo en Chilkowtah, pertenece a San Miguel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>(Eso es todo). Solamente eso.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
