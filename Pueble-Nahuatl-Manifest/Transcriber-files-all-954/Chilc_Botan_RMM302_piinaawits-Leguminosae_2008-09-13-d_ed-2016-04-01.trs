<Turn speaker="spk1" startTime="148.803" endTime="150.022">
<Sync time="148.803"/>
¿Wa:n ke:n o:n se: kichi:wa?
</Turn>
<Turn speaker="spk2" startTime="150.022" endTime="198.992">
