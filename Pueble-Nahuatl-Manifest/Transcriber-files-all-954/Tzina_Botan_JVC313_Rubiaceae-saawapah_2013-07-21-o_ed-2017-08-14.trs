<Speakers>
<Speaker id="spk1" name="Amelia Domínguez Alcántara" check="no" dialect="native" accent="" scope="local"/>
<Speaker id="spk2" name="José Ernesto Vázquez Chanico" check="no" dialect="native" accent="" scope="local"/>
