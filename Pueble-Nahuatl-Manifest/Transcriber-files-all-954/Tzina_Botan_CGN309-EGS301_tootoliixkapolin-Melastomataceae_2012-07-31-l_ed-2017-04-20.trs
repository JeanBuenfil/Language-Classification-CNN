<Who nb="2"/>
Ke:mah wa:n, wa:n ne:n yehwa yo:n kowit, neli we:weyak mochi:wa ka:mpa yo:n xiwka:walah wa:n,
</Turn>
<Turn speaker="spk1 spk2" startTime="240.017" endTime="256.493">
<Sync time="240.017"/>
