<Trans scribe="Eleuterio" audio_filename="Tzina_Botan_JVC313_aateenkwaakwalakxoochit-Acanthaceae_2012-07-16-e" version="5" version_date="161007">
<Speakers>
<Speaker id="spk1" name="Eleuterio Gorostiza Salazar" check="no" dialect="native" accent="" scope="local"/>
