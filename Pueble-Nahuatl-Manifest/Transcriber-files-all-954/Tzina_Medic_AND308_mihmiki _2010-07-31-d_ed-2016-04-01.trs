<Sync time="488.691"/>
wa:n nika:n se: i:ka:n, se: iyo:lpan nika:n, yo:lpan nika:n te:ta:liliah
<Sync time="493.609"/>
mm, se: yo:lpan, mm.
</Turn>
<Turn speaker="spk1" startTime="497.053" endTime="499.632">
<Sync time="497.053"/>
