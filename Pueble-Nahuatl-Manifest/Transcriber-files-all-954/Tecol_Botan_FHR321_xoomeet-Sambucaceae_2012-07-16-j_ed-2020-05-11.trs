<!DOCTYPE Trans SYSTEM "trans-14.dtd">
<Trans scribe="Eleuterio" audio_filename="Tecol_Botan_FHR321_xoomeet-Sambucaceae_2012-07-16-j" version="4" version_date="200511">
<Speakers>
<Speaker id="spk1" name="Eleuterio Gorostiza Salazar" check="no" dialect="native" accent="" scope="local"/>
