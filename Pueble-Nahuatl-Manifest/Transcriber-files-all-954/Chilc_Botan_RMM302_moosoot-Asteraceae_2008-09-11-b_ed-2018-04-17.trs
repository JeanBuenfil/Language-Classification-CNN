<!DOCTYPE Trans SYSTEM "trans-14.dtd">
<Trans scribe="tahtol2" audio_filename="Chilc_Botan_RMM302_moosoot-Asteraceae_2008-09-11-b" version="9" version_date="180417">
<Speakers>
<Speaker id="spk1" name="Jonathan D Amith" check="no" dialect="native" accent="" scope="local"/>
<Speaker id="spk2" name="Rubén Macario Martínez" check="no" dialect="native" accent="" scope="local"/>
