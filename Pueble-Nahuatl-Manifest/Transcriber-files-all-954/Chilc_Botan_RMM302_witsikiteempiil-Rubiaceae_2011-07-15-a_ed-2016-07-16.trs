<!DOCTYPE Trans SYSTEM "trans-14.dtd">
<Trans scribe="USUARIO" audio_filename="Chilc_Botan_RMM302_witsikiteempiil-Rubiaceae_2011-07-15-a" version="4" version_date="170716">
<Speakers>
<Speaker id="spk1" name="Eleuterio Gorostiza Salazar" check="no" dialect="native" accent="" scope="local"/>
