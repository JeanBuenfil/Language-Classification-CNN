<Sync time="300.444"/>
pero xi:kowa tiki:xmattok se:katanmohmotsol
<Sync time="306.025"/>
wa:n tiki:xmattok ne:n ne, ne ke:n tomat, tomat pantaxi:pe:wal
<Sync time="315.433"/>
