<!DOCTYPE Trans SYSTEM "trans-14.dtd">
<Trans scribe="Eleuterio" audio_filename="Tecol_Botan_FHR321_kopalkowit-Burseraceae_2012-07-23-j" version="2" version_date="200326">
<Speakers>
<Speaker id="spk1" name="Eleuterio Gorostiza Salazar" check="no" dialect="native" accent="" scope="local"/>
