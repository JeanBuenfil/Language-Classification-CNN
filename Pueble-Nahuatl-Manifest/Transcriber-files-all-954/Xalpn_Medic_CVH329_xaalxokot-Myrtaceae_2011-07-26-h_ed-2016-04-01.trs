<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE Trans SYSTEM "trans-14.dtd">
<Trans scribe="Eleuterio" audio_filename="Xalpn_Medic_CVH329_xaalxokot-Myrtaceae_2011-07-26-h" version="1" version_date="121229">
<Speakers>
<Speaker id="spk1" name="Eleuterio Gorostiza Salazar" check="no" dialect="native" accent="" scope="local"/>
<Speaker id="spk2" name="Cristina Vázquez Hernández" check="no" dialect="native" accent="" scope="local"/>
</Speakers>
<Episode>
<Section type="report" startTime="0" endTime="254.001208333">
<Turn startTime="0" endTime="7.484" speaker="spk1">
<Sync time="0"/>
Na:no, ekintsi:n xite:chtapowi i:n xiwtsí:n tikwa:lkwik, ke:ní:w mono:tsa wa:n ka:ni mochi:wa.
</Turn>
<Turn speaker="spk2" startTime="7.484" endTime="19.034">
<Sync time="7.484"/>
I:n mono:tsa xa:lxokot, xa:lxokoxiwtsí:n.
<Sync time="11.083"/>
Wa:n mochi:wa ompa ne: kahfe:ntah *o** kanah ika mi:lah,
<Sync time="15.025"/>
mot..., noya:mpa achi onkak.
</Turn>
<Turn speaker="spk1" startTime="19.034" endTime="22.463">
<Sync time="19.034"/>
Wa:n i:n *este**, ¿ka:nachi taman teh tiki:xmati?
</Turn>
<Turn speaker="spk2" startTime="22.463" endTime="32.897">
<Sync time="22.463"/>
Ne:, neh niki:xmati *sólo** o:me taman sah.
<Sync time="25.423"/>
Tak ili..., *como que** ne:,
<Sync time="27.758"/>
kiliah tsina:kaxa:lxokot tein chi:chi:ltik.
<Sync time="30.651"/>
Wa:n i:n ista:k.
</Turn>
<Turn speaker="spk1 spk2" startTime="32.897" endTime="36.236">
<Sync time="32.897"/>
<Who nb="1"/>
Wa:n tein chi:chi:ltik, chi:chi:ltik n' ikowyo *o** ixiwyo *o** ton chi:ch...
<Who nb="2"/>
Ne:,
</Turn>
<Turn speaker="spk2" startTime="36.236" endTime="48.415">
<Sync time="36.236"/>
wa:n, wa:n *que** yo:n ta:ki, iihtik *como que** n' ta:kilotsí:n chi:chi:ltik.
<Sync time="40.79"/>
Wa:n tein ista:k tikilwiyah,
<Sync time="42.79"/>
neli ista:ktsí:n iihtik, yo:n, wa:n *que** yo:n oksi a se: kitapa:na wa:n se kita.
</Turn>
<Turn speaker="spk1" startTime="48.415" endTime="50.469">
<Sync time="48.415"/>
¿Wa:n ixo:chio ta:taman *o** nochi iwkitik?
</Turn>
<Turn speaker="spk2" startTime="50.469" endTime="52.357">
<Sync time="50.469"/>
Pané: nochi iwki sah.
</Turn>
<Turn speaker="spk1" startTime="52.357" endTime="52.83">
<Sync time="52.357"/>
Ti...
</Turn>
<Turn speaker="spk2" startTime="52.83" endTime="59.281">
<Sync time="52.83"/>
Wa:n ikowyotsi:n nochi iwki sah, ixiwyotsi:n.
<Sync time="55.393"/>
Nochi se: taman sah, pero ne:n ita:kilo n' ta:taman.
</Turn>
<Turn speaker="spk1" startTime="59.281" endTime="60.817">
<Sync time="59.281"/>
¿ke:niwki ne:n ixo:chio?
</Turn>
<Turn speaker="spk2" startTime="60.817" endTime="63.764">
<Sync time="60.817"/>
Ista:k.
</Turn>
<Turn speaker="spk1" startTime="63.764" endTime="65.675">
<Sync time="63.764"/>
¿Wa:n ita:kilo?
</Turn>
<Turn speaker="spk2" startTime="65.675" endTime="69.684">
<Sync time="65.675"/>
Ita:kilo pos mochi:wa ihkwi:ntsitsi:n mahyá *limón**.
</Turn>
<Turn speaker="spk1" startTime="69.684" endTime="73.358">
<Sync time="69.684"/>
¿Wa:n ita:kilo no: kwali se: kikwi?
</Turn>
<Turn speaker="spk2" startTime="73.358" endTime="77.51">
<Sync time="73.358"/>
kwali se:..., yeh para se: kikwa:s.
</Turn>
<Turn speaker="spk1" startTime="77.51" endTime="80.47">
<Sync time="77.51"/>
¿Wa:n ikowyo?
</Turn>
<Turn speaker="spk2" startTime="80.47" endTime="87.314">
<Sync time="80.47"/>
Pos n' ikowyo *solamente para**,
<Sync time="82.894"/>
ika tikokti:s..., tiktikota:li:skeh.
</Turn>
<Turn speaker="spk1 spk2" startTime="87.314" endTime="91.993">
<Sync time="87.314"/>
<Who nb="1"/>
Wa:n ixiwyotsi:n yehwa ne:n pahti.
<Who nb="2"/>
Ixiw..., ixiwyotsi:n pahti.
</Turn>
<Turn speaker="spk2 spk1" startTime="91.993" endTime="97.14">
<Sync time="91.993"/>
<Who nb="1"/>
Ita..., ita:kilo:tsi:n para se: kikwa.
<Who nb="2"/>
Toni...
</Turn>
<Turn speaker="spk1" startTime="97.14" endTime="99.975">
<Sync time="97.14"/>
Ixiwyotsi:n, ¿ke:ní:w ne:n tikwi pahti?
</Turn>
<Turn speaker="spk2" startTime="99.975" endTime="192.938">
<Sync time="99.975"/>
Se: kimana.
<Sync time="103.636"/>
Se: kimana wa:n ne: se:, se: tai
<Sync time="109.877"/>
i:n. Komohkó:n ne:,
<Sync time="113.292"/>
kowa:ti pili, ke:meh yo:n tikihtowah ne:,
<Sync time="116.864"/>
ta: ne: nopili kowa:ti, we:ro kkokowa iihtik wa:n we:ro tsahtsi.
<Sync time="121.498"/>
Yeha i:n kwali wa:n komo a:mo kina:mikik, epaso:t.
<Sync time="125.752"/>
Wa:n epaso:t iwa:n se: kimana a:lwe:we:noh.
<Sync time="128.766"/>
O:me taman tikmanah seko sah.
<Sync time="131.212"/>
Pero n' tiseki:meh tikchi:wah wa:n seki:meh kichi:wah,
<Sync time="134.65"/>
se: taman sah. A:lwe:we:noh sah kimanah,
<Sync time="138.413"/>
komo kowa:ti m' pili.
<Sync time="140.065"/>
Pero yo:n a:lwe:we:noh no: kwaltiya pero mah miyak.
<Sync time="143.168"/>
Se: taki:tskil ihkwí:n xikmolo:nti,
<Sync time="146.976"/>
wa:n tai:s m' pili semi tepitsi:n sah,
<Sync time="149.677"/>
wa:n yo:n a:tsí:n ika x'pahpacho nika:n ipoxtsi:n.
<Sync time="153.597"/>
Ihkó:n kwaltsi:n x'pahpa..., ke:meh yo:n *rehfi:noh** ihkwí:n timota:liliyah.
<Sync time="156.892"/>
Ihkó:n kwaltsi:n x'poxpahpacho ika,
<Sync time="159.093"/>
wa:n yo:n xiwpachtsí:n,
<Sync time="161.093"/>
'ki:xtili nochi n' ikowyotsi:n *parejo**,
<Sync time="163.794"/>
wa:n itech n' xiwtsí:n de i:ni, de i:n xiwtsí:n, de i:n we:i xiwtsí:n,
<Sync time="168.495"/>
ihkwí:n tikta:liya wa:n ii:xko tikta:liya ya ne:n xiwtsi:ni, tein pisi:ltik.
<Sync time="174.223"/>
Ke:mah, ne: tikpepecholia ya m' pili n' ipoxko.
<Sync time="177.451"/>
Ika yo:ni, a:mo moneki koyo:tapahtihkeh komohkó:n kowa:ti wa:n ki..., teltsahtsi.
<Sync time="182.621"/>
Ta: komo kitelkokowa, teltsahtsi.
<Sync time="185.826"/>
Yeha yo:ni n' ika teha:n tikimpahtiyah.
<Sync time="187.992"/>
Wa:n a:mo tikintai:ltiyah ok tein koyo:meh kite:makah.
</Turn>
<Turn speaker="spk1" startTime="192.938" endTime="200.662">
<Sync time="192.938"/>
A:man i:n, tikihtowa i:n,
<Sync time="194.925"/>
xa:lxokot ixiwyo n' tikwi, sayoh i:n pahti, sayoh i:n xa:lxokot ista:k *o** no: n' tein chi:chi:ltik.
</Turn>
<Turn speaker="spk2" startTime="200.662" endTime="205.653">
<Sync time="200.662"/>
Pané: no:. Wa:n o:me taman nochi kwaltiya.
</Turn>
<Turn speaker="spk1 spk2" startTime="205.653" endTime="208.711">
<Sync time="205.653"/>
<Who nb="1"/>
Tein ya se: kahsik mah se: kikwi.
<Who nb="2"/>
Ke:mah, tein ya tikahsik.
</Turn>
<Turn speaker="spk2" startTime="208.711" endTime="213.912">
<Sync time="208.711"/>
Komo a:mo tikahsi n' tein chi:chi:ltik, ti..., komo tikahsi n' ista:k, yeha ya, kwaltiya.
</Turn>
<Turn speaker="spk1" startTime="213.912" endTime="216.412">
<Sync time="213.912"/>
¿Wa:n i:n xiwit tikwi tein chika:wak oso selik?
</Turn>
<Turn speaker="spk2" startTime="216.412" endTime="238.376">
<Sync time="216.412"/>
Ke:meh i:ni sah, ke:meh yeski, ma:s chika:wak achi, sayoh mah a:mo i:ka:nta:loh, ta: komohkó:n telwehka:wkayo:t ya,
<Sync time="222.975"/>
ata nika:n pané: yo:n xaxakachtik mochi:wa.
<Sync time="225.809"/>
Yehwa i:n a:mo, ta: i:n alaxtsí:n.
<Sync time="229.484"/>
Wa:n no: *igual** ne: *cuando** molo:ni a,
<Sync time="232.818"/>
mah se: kitsetselo ika tasa:ltsí:n,
<Sync time="235.631"/>
para a:mo kiwi:ka tewtsí:n.
</Turn>
<Turn speaker="spk1" startTime="238.376" endTime="247.349">
<Sync time="238.376"/>
*Bueno** pos komohkó:n nochi a ne:n xa:lxokot tite:ch...,
<Sync time="243.064"/>
tte:chtapowih. Ekintsi:n xte:chili ne:n moto:ka:y wa:n moxola:l.
</Turn>
<Turn speaker="spk2" startTime="247.349" endTime="254.001208333">
<Sync time="247.349"/>
*Este** Cristina Vázquez Hernández,
<Sync time="251.501"/>
de Xalpantzingo.
</Turn>
</Section>
</Episode>
</Trans>
