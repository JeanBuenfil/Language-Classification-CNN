<Trans scribe="USUARIO" audio_filename="Chilc_Botan_RMM302-EGS301_kwaakwaanakatsitsiin-Rubiaceae_2011-07-15-f" version="2" version_date="170714">
<Speakers>
<Speaker id="spk1" name="Eleuterio Gorostiza Salazar" check="no" dialect="native" accent="" scope="local"/>
