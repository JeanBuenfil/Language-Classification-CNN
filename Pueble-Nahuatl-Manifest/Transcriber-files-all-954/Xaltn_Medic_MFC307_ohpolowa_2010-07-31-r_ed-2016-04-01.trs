<Speakers>
<Speaker id="spk1" name="Amelia Domínguez Alcántara" check="no" dialect="native" accent="" scope="local"/>
<Speaker id="spk2" name="María Ocotlán Fermín Cabrera" check="no" dialect="native" accent="" scope="local"/>
