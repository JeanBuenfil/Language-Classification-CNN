<Trans scribe="tahtol2" audio_filename="Chilc_Botan_RMM302_eskowit-Euphorbiaceae_2008-09-11-g" version="5" version_date="110905">
<Speakers>
<Speaker id="spk1" name="Jonathan D. Amith" check="no" dialect="native" accent="" scope="local"/>
