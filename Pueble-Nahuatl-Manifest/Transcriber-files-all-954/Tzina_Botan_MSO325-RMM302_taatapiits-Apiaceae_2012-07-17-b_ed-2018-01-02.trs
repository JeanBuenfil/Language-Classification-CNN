<Turn speaker="spk2" startTime="274.844" endTime="276.25">
<Sync time="274.844"/>
María Salazar Osollo.
</Turn>
<Turn speaker="spk1" startTime="276.25" endTime="282.478">
<Sync time="276.25"/>
