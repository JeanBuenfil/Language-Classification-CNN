<Sync time="1988.682"/>
"Pero teh" kihtowa "a:mo nimitsnesita:rowa nika:n ya, 
<Sync time="1991.369"/>
teh xiow" kihtowa "Tikinsalva:ro:ti *almas" kihtowa.
