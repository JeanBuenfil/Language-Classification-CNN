<Speakers>
<Speaker id="spk1" name="Jeremías Cabrera Ortiz" check="no" dialect="native" accent="" scope="local"/>
<Speaker id="spk2" name="Rubén Macario Martínez" check="no" dialect="native" accent="" scope="local"/>
