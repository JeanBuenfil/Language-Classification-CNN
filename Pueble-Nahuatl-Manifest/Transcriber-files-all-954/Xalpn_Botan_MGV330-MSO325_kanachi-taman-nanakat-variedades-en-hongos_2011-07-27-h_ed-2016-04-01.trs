<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE Trans SYSTEM "trans-14.dtd">
<Trans scribe="Eleuterio" audio_filename="Xalpn_Botan_MGV330-MSO325_kanachi-taman-nanakat-variedades-en-hongos_2011-07-27-h" version="1" version_date="130121">
<Speakers>
<Speaker id="spk1" name="María Salazar Osollo" check="no" dialect="native" accent="" scope="local"/>
<Speaker id="spk2" name="María Guadalupe Vázquez" check="no" dialect="native" accent="" scope="local"/>
</Speakers>
<Episode>
<Section type="report" startTime="0" endTime="184.714">
<Turn startTime="0" endTime="3.616" speaker="spk1">
<Sync time="0"/>
¿Alakcho, ka:nachi taman?
</Turn>
<Turn speaker="spk2" startTime="3.616" endTime="22.746">
<Sync time="3.616"/>
O:me taman.
<Sync time="8.817"/>
Se: ti..., ti:ltikalakcho itech mochi:wa kahfe:n, mopehpepechowa.
<Sync time="13.683"/>
Achi *medio** tsikitsitsi:n, ahalaxtik.
<Sync time="16.964"/>
Wa:n kostikalakcho yeh mochi:wa itech chalawih, wa:n no: mopehpepechowa, pero yeh achi pa:pata:wak.
</Turn>
<Turn speaker="spk1" startTime="22.746" endTime="27.858">
<Sync time="22.746"/>
¿Wa:n ma:tananakat, ka:nachi taman?
</Turn>
<Turn speaker="spk2" startTime="27.858" endTime="37.524">
<Sync time="27.858"/>
Mat..., ma:tananakat,
<Sync time="30.894"/>
se: taman sah, *únicamente**,
<Sync time="33.372"/>
yeh kwaltsi:n tampaihista:k wa:n pan..., panehnextik.
</Turn>
<Turn speaker="spk1" startTime="37.524" endTime="39.756">
<Sync time="37.524"/>
¿Wa:n xo:no:nanakat?
</Turn>
<Turn speaker="spk2" startTime="39.756" endTime="48.015">
<Sync time="39.756"/>
kwaltsi:n ihista:k wa:n yeh nehnepantik mochi:wa.
<Sync time="43.037"/>
Tatampa mochi:wtiw ye:..., te..., ne:
<Sync time="45.537"/>
ipi:piliwa:n tsikitsitsi:n.
</Turn>
<Turn speaker="spk1" startTime="48.015" endTime="51.028">
<Sync time="48.015"/>
¿Wa:n ista:knanakat, ka:nachi taman?
</Turn>
<Turn speaker="spk2" startTime="51.028" endTime="59.459">
<Sync time="51.028"/>
Ista:knanakat, iyoh sen taman.
<Sync time="54.325"/>
Yeh kwaltsi:n mets..., metswe:weyak.
</Turn>
<Turn speaker="spk1" startTime="59.459" endTime="62.004">
<Sync time="59.459"/>
¿Wa:n ka:walpox, no: sen taman sah?
</Turn>
<Turn speaker="spk2" startTime="62.004" endTime="66.915">
<Sync time="62.004"/>
Ka:walpox no: sen taman sah.
<Sync time="64.906"/>
Yeh kwaltsi:n tampaihista:k.
</Turn>
<Turn speaker="spk1" startTime="66.915" endTime="68.902">
<Sync time="66.915"/>
¿Wa:n chikinte?
</Turn>
<Turn speaker="spk2" startTime="68.902" endTime="76.625">
<Sync time="68.902"/>
Chikinte o:me taman.
<Sync time="70.799"/>
Seki wehwei wa:n seki tsikitsitsi:n.
<Sync time="73.545"/>
Wa:n no: panehnextik n' chikinte
</Turn>
<Turn speaker="spk1 spk2" startTime="76.625" endTime="79.371">
<Sync time="76.625"/>
<Who nb="1"/>
¿Wa:n seknanakat, i:pa sentaman sah?
<Who nb="2"/>
mochi:wa.
</Turn>
<Turn speaker="spk2" startTime="79.371" endTime="93.233">
<Sync time="79.371"/>
Seknanakat i:pa sentaman sah.
<Sync time="82.496"/>
Mochi:wa ne: talpan, itech
<Sync time="86.849"/>
ne:n tahsoltsí:n tein pahpalaktik mochi:wa itech *cuando** selikme:tsti.
</Turn>
<Turn speaker="spk1" startTime="93.233" endTime="97.452">
<Sync time="93.233"/>
¿Wa:n xilwananakat i:pa no: sentaman sah *o** o:me taman yeh?
</Turn>
<Turn speaker="spk2" startTime="97.452" endTime="101.872">
<Sync time="97.452"/>
Yeh seki kohkostik wa:n seki *medio** nehnextik.
</Turn>
<Turn speaker="spk1" startTime="101.872" endTime="106.894">
<Sync time="101.872"/>
¿Wa:n xopitsa no: o:me taman *o**...?
</Turn>
<Turn speaker="spk2" startTime="106.894" endTime="115.801">
<Sync time="106.894"/>
Xopitsa
<Sync time="109.662"/>
no: *medio** panpohpo:ktik wa:n metswe:weyak.
</Turn>
<Turn speaker="spk1" startTime="115.801" endTime="121.002">
<Sync time="115.801"/>
Wa:n i:pa iwki sah. ¿M' pi:sih no: sentaman sah?
</Turn>
<Turn speaker="spk2" startTime="121.002" endTime="125.734">
<Sync time="121.002"/>
Pisi:h sentaman sah, mochi:wa itech teswat.
</Turn>
<Turn speaker="spk1" startTime="125.734" endTime="129.149">
<Sync time="125.734"/>
¿Wa:n chi:ltaxkal no: sentaman sah?
</Turn>
<Turn speaker="spk2" startTime="129.149" endTime="134.931">
<Sync time="129.149"/>
Chi:ltaxkal,
<Sync time="132.698"/>
seki telchihchi:chi:ltik,
</Turn>
<Turn speaker="spk2 spk1" startTime="134.931" endTime="139.239">
<Sync time="134.931"/>
<Who nb="1"/>
wa:n seki achi ihista:k. O:me taman.
<Who nb="2"/>
O:me taman no:.
</Turn>
<Turn speaker="spk2" startTime="139.239" endTime="143.77">
<Sync time="139.239"/>
Yeh mochi:wa itech a:wa:t, itech o:me taman a:wa:t nochi ompa e:wa.
</Turn>
<Turn speaker="spk1" startTime="143.77" endTime="146.159">
<Sync time="143.77"/>
¿Wa:n to:tolko:skat, no: sentaman sah?
</Turn>
<Turn speaker="spk2" startTime="146.159" endTime="153.949">
<Sync time="146.159"/>
To:tolkoskat no: sentaman sah wa:n yeh mochi:wa no: itech, itech n' tahsolpalaktsí:n, *como que** no: ta:lpan.
</Turn>
<Turn speaker="spk1" startTime="153.949" endTime="156.806">
<Sync time="153.949"/>
¿Wa:n xo:chinanakat, no: sentaman sah?
</Turn>
<Turn speaker="spk2" startTime="156.806" endTime="160.83">
<Sync time="156.806"/>
Yeh sentaman sah.
<Sync time="158.771"/>
Yeh mochi:wa kwowtah.
</Turn>
<Turn speaker="spk1" startTime="160.83" endTime="163.397">
<Sync time="160.83"/>
¿Wa:n kostiknanakat, no: onkak miak taman?
</Turn>
<Turn speaker="spk2" startTime="163.397" endTime="172.504">
<Sync time="163.397"/>
Yeh no: sentaman sah, yeh [...] pan...,
<Sync time="167.437"/>
panehnextik wa:n tampakostik,
<Sync time="170.227"/>
tampakohkostik nochi n' itampa.
</Turn>
<Turn speaker="spk1" startTime="172.504" endTime="174.826">
<Sync time="172.504"/>
¿Wa:n masa:xi:poh?
</Turn>
<Turn speaker="spk2" startTime="174.826" endTime="181.076">
<Sync time="174.826"/>
Masa:xi:poh, yeh senki:s ti:ltik, senki:s ti:ltik, ololtik.
</Turn>
<Turn speaker="spk1" startTime="181.076" endTime="182.192">
<Sync time="181.076"/>
Wa:n i:pa no: sentaman sah.
</Turn>
<Turn speaker="spk2" startTime="182.192" endTime="184.714">
<Sync time="182.192"/>
Yeh sentaman sah.
</Turn>
</Section>
</Episode>
