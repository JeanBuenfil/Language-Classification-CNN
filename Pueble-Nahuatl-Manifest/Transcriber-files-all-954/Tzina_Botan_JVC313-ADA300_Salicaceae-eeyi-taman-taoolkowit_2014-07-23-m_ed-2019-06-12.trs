<Sync time="344.921"/>
Nikitani kikwah n' chiktehmeh yo:n kowtetsi:n.
</Turn>
<Turn speaker="spk1 spk2" startTime="347.513" endTime="354.693">
<Sync time="347.513"/>
<Who nb="1"/>
