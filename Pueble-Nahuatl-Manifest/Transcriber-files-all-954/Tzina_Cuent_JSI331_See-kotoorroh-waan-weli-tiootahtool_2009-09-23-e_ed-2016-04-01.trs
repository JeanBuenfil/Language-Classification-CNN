<Trans scribe="Amelia" audio_filename="Tzina_Cuent_JSI331_See-kotoorroh-waan-weli-tiotahtool_2009-09-23-e" version="1" version_date="140526">
<Speakers>
<Speaker id="spk1" name="José Salgado Isabel" check="no" dialect="native" accent="" scope="local"/>
<Speaker id="spk2" name="Jeremías Cabrera Ortíz" check="no" dialect="native" accent="" scope="local"/>
