<Turn speaker="spk1" startTime="704.422" endTime="706.772">
<Sync time="704.422"/>
I:n a:mo te:kwi:ltiah toto:nik.
</Turn>
<Turn speaker="spk2" startTime="706.772" endTime="720.332">
