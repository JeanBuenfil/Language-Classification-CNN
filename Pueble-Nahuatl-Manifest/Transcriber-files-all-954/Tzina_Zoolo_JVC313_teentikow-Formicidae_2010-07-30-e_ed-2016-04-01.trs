<Trans scribe="TEPOXMANANIJ" audio_filename="Tzina_Zoolo_JVC313_teentikow-Formicidae_2010-07-30-e" version="2" version_date="130227">
<Speakers>
<Speaker id="spk1" name="Eleuterio Gorostiza Salazar" check="no" dialect="native" accent="" scope="local"/>
