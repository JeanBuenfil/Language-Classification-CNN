<Trans scribe="Eleuterio" audio_filename="Tzina_Botan_JVC313_taapaat-Brunelliaceae_2012-07-24-c" version="2" version_date="170725">
<Speakers>
<Speaker id="spk1" name="Eleuterio Gorostiza Salazar" check="no" dialect="native" accent="" scope="local"/>
