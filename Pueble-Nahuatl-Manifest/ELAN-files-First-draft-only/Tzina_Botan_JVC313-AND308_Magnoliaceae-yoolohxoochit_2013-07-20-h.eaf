        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>A: wa:n yo:n tikneki tikmatis, pos no: kwali a de ke nika:n ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>Timona:mikkeh wa:n *siempre** timona:miktinemih pos timotapowiah katí:n kwali, katí:n servi:rowa te:servi:rowa nehjó:n yo:loxo:chit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>yo:n rooxo:chikowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>Yo:n no: kwali para kihtowah de ke ne: para ne: se: iyo:lo te:kokoh kimanah yo:n wa:n te:tai:ltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Ke:masá: se: ... Te:kokoh ne:n se: iyo:lo pos nehjó:n kimanah *por eso** kiliah ki..., yo:loxo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>Pero nehjó:n wa:n no: kwaltia para ne:n kowtati:l oso para ke:meh i:n se: ikaltsi:n pos no: kwali kitsaya:nah wa:n no: oso de n' pihpitsa:wak no: kwaltia para se:, para se: ikaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Para kale:walmeh *o** para taihti:yo:meh no: kwaltia wa:n no: *igual** de n', de n' wehwei toma:wak ihkó:n pos kitekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Kitekih ihkó:n wa:n kitsahtsaya:nah wa:n kikwih para ne:n taihti:yo:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>*O** ta:nka:yo:meh, yo:n nochi kikwih oso seki ta:tablitas, ihkó:n kitekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Pos no: kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>Wa:n no: kwaltia para ne:n kowtati:l ima:yo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>Kowtati:l wa:n yo:n pos no: kwaltia kimanah para kwaltia kihtowah pané: n' ato:l, ato:l kichi:wah, yo:n semi ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Ixo:chio, ne:n ixo:chio, ihkwi:kwí:n de we:weyak, kohkostik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>wa:n iteyo, de *cuando** chika:waya ahko ya mochi:wa, ihkwí:n ohololtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>de ahko, de chika:waya ne: tapa:ni wa:n panxi:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Panxi:ni a, chihchi:chi:ltik iteyo wa:n yehwa nehjó:n ne:n ki..., kitekih ihkó:n oso seki kisentekiliah, de ke yo:n kihtowah ne:wí:n no: ki..., no: kikowah ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Wa:n ata tein ihista:k, *cuando** selik ihkó:n yo:n aya:mo panowa, no:, no: kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Wa:n pos yehwa yo:n nochi no: servi:rowa wa:n pos teh xa: kachi tikmattos para to:n i:n te:chpale:wia nehjó:n kowit, nehjó:n yo:loxo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>*Casi** ke:meskia yo:n, sayoh kiahakiah wa:n ka..., acha kimanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>Pos yehwa i:n timonohno:tstokeh ke ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>Yo:n kwali se: kikwiti:w wa:n se: ki..., te:chihchi:wili:ka:n wa:n mah se: tai wa:n yehwa i:n a:mo tikmatih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>*Cuando** poso:ni de n' weh..., wehwei kowit mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>*Cuando** poso:ni pos a:mo tikmatih, ni:nipaka kwaltsi:n ne: ista:ke:wtok ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Iteyo moka:wa wa:n yehwa yo:n ekintsi:n pos a:mo se: kimati, yo:n no: nikmattok a:mo nochipa mochi:wa, yo:n no: sayoh ke:meh ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>No: yetok to:nal, ne:n me:tsti, mochi:wa itech mayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>Achi ne:n abri:lkopa, nochi mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Yehwa nehjó:n mochi:wa, de pe:wa n' moskaltihtiw, tsikitsitsi:n, kepotsitsi:n, *hasta** wehwei a ya, ke:mah moka:wa ne: pohpochihtik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>No: komo telpanowa moxahxa:lowa, ihkó:n moxahxalketsa wa:n ke:mah xi:ni seki tatampa wa:n seki *hasta** ne:, mochi:wa ke:meh yo:n ke:ní:w kiliah, xi:kaltsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
