                <ANNOTATION_VALUE>Ihkó:n no: kichi:wa de wetsi a n' ta:lpan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n no:, no: ke:masá: kikwi ne: tatampa, de ne:, no: kikwa ne:n, ne:n *palomitas**, ne:n chiktehtsitsi:n no: kikwah, yo:n te:na:ka:lmeh oso papa:meh, yehwa yo:n ke:masá: se: kita, xa: tikita ne: kikohkoyo:nia wa:n ki..., kikwah ne:n papa:meh oso te:na:kalmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
