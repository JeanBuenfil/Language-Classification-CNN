                <ANNOTATION_VALUE>Wa:n yehwa yo:n niknekia nikmatis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Pos yehwa yo:n nikneki nikmatis *porque**...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Pos neh nikitstinemi ne:wi:n ihkatok kowtsitsi:n de nejó:n pero a:mo nikmati ke:ní:w ito:ka:y *o** ke:ni:n kiliah.</ANNOTATION_VALUE>
