        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>A:xka:n nikita neh *que** n' tokni:wa:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts278">
