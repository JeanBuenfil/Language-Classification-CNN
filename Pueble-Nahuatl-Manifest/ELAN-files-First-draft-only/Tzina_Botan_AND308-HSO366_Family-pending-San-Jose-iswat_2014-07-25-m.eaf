        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>pero ekintsi:n *tiempo** komo se: kite:mowa yo:n a:mo se: k'ahsi, a:mo tei</ANNOTATION_VALUE>
