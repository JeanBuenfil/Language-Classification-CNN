        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>*Bueno** nochi n' okseki iswat se: k'oli:nia tepitsi:n wa:n tsaya:ni yo:n ka:mpa ika ne:n mahyá: nochi kipia *rayas** ata</ANNOTATION_VALUE>
