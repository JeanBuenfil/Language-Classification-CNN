        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>a:mo ke:meh okseki iswat *porque** pahpata iswat oso yo:n nexkoko:kiswat...</ANNOTATION_VALUE>
