            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Ke:mah wa:n yo:n SanJosé: n' iswat a:mo tsaya:ni.</ANNOTATION_VALUE>
