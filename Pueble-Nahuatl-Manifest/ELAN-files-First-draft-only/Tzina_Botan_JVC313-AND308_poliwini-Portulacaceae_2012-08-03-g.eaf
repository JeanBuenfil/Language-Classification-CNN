            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>Entó:s ompa ki:saya wa:n se: ki:xtilia ya moka:wa kwaltsi:n, de kipi:tsaya n' ehekat kwaltsi:n moka:waya ya. Tak yo:n no: toto:nik yo:n kokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts623">
                <ANNOTATION_VALUE>Toto:nik wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Yehwa ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>Pos yo:n kokot ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts637">
                <ANNOTATION_VALUE>Pos ekintsi:n no:, no: kwali a ke a:mo tikitah nehjó:n kokolis, de yo:n kokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>*Porque** yo:n kokot no: te:mikti:s koma:mo se: kimati ne:n toni, toni kwali te:na:mikis, yo:n te:kokoh. Kihtowah komo se: ka:wak ahko, a:mo se: kilpih panki:sa *hasta** ahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>Wa:n yo:n kokot ne:n ihkó:n chi:chi:le:wtiw. Chi:chi:le:wi wa:n ka..., we:noh chi:chi:le:wi ka:mpa ne:, tak a:mo se: kimati ke:ní:w panki:sa *porque** ka:mpa moka:wati a ihkó:n chi:chi:le:wi se:, ihkó:n ne: moyewalowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts645" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>Wa:n no:, no: pa:panowa, itech okseko se:, se: imets</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>wa:n a:mo nikihto:s i..., se: ike:sko mo..., mota:lia ta: i:n se: itankwa:i:xpan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>Ka:mpa se: tahyowi:s wa:n yo:n a:mo nikihto:s ke, ma:ski ne: titamattos ihkó:n pero a:mo, a:mo wel ti..., tine:nemis, ti..., titenatos oso tichichinakatos ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>Wa:n yo:n *hasta** se: ... Te:tsahtsi:ltih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>Te:tsahtsi:ltih porin taih..., tsihtik tak kipia ne:n te:mal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>Taihtik wa:n pos yehwa ne:chi..., ne:chilia:yah seki:n no: kwaltia para n' taxwis pero a:mo nikneltoka *porque** yo:n taxwis no:, no: taman, oksé: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts686">
