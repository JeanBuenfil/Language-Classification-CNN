        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>Pos yehwa i:n poliwixiwit ne:n, yehwa neh nikmattok yehwa ya para n' chi:chi:lkokot sah wa:n pos yehwa sah nehjó:n neh nik..., nikmati de yo:n poliwixiwit *porque** yo:n tak moyo:kolia wa:ki wa:n tak ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts739">
                <ANNOTATION_VALUE>Pala:ni ihkó:n, a:mo, a:mo tikihto:ti ok..., xa:, xa: seko yowi tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts743">
                <ANNOTATION_VALUE>*O** xa: mahchi:wa, a:mo se: kimati. Om..., ompa xokoya ka:mpa ixwa yo:n ompa xokoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts750">
                <ANNOTATION_VALUE>*Porque* yo:n pos no: kwali yo:n pahti sayoh ke a:mo, a:mo tikmatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>A:mo nochi tikmatih pero ekintsi:n nika:n ne:n timahsihkeh wa:n nika:n timonohno:tsah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>pos timomati:ltiah ka:ni onkak yo:n poliwixiwt ne: tik..., tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>Yo:n xiwit ne:n ne:wí:n ka:sá: ika ne: kowtah, tikihto:s tikte:mo:ti:w, a:mo tikahsis, tikahsis nika:wi:n itech ohti, ka:sá: ika se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>Xola:lte:n wa:n ihkó:n ne: ka:sá: ika se:, se: kita pero yo:n pos eki..., *antes n' tota:tahwa:n yehwa kikwiah para ne:n to..., te:ch..., ika te:chpahtia:yah de yo:n kokot chi:chi:lkokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>*Por eso** ekintsi:n tikmattokeh katí:n ne:n poliwixiwit ne:n tikwitih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>Wa:n tik..., tik..., we:noh tiki:xmattokeh pero ekintsi:n no:, no: kwali a ke: a:mo ne:si yo:n kokot, yo:n chi:chi:ltik, chi:chi:lkokot *porque** yo:n sayoh para te:mikti:s no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts779">
                <ANNOTATION_VALUE>Te:mikti:s *porque** a:..., pos a:mo no: wel se: ye:ktakwa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>Te:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
