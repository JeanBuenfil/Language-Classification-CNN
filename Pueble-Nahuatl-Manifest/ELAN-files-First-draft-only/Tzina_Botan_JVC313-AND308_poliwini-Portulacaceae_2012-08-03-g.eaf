                <ANNOTATION_VALUE>Wa:n de sepa ne: te:ta:liliah yo:n pos ne: patsa:waya no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
