        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts701">
                <ANNOTATION_VALUE>Weyakaxtik ke:meskia se: ... Komo se: kipa:tska no:, no: wehka wetsiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>Yo:n no: takwa:wak ke:meh, xa: ke:meh tso..., ke:meh tsonti. *Más** toma:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>Pos ...</ANNOTATION_VALUE>
