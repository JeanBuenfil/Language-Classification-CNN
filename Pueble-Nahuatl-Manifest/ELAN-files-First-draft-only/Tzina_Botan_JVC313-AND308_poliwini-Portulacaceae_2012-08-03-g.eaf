        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts801" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>A: we:noh pos ...</ANNOTATION_VALUE>
