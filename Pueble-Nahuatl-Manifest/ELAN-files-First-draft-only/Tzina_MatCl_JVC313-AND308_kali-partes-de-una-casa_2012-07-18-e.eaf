        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a783" TIME_SLOT_REF1="ts1216" TIME_SLOT_REF2="ts1217">
                <ANNOTATION_VALUE>*hasta** motili:ntia:ya ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784" TIME_SLOT_REF1="ts1218" TIME_SLOT_REF2="ts1220">
                <ANNOTATION_VALUE>Ke:mah, se: kimachilia ya tili:ntok ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a786" TIME_SLOT_REF1="ts1224" TIME_SLOT_REF2="ts1225">
                <ANNOTATION_VALUE>Tili:ntok wa:n,</ANNOTATION_VALUE>
