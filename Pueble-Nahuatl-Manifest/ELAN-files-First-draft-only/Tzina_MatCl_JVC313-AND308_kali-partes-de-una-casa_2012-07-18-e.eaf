        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a756" TIME_SLOT_REF1="ts1149" TIME_SLOT_REF2="ts1151">
                <ANNOTATION_VALUE>Pos neh nikitaya, ne:n,</ANNOTATION_VALUE>
