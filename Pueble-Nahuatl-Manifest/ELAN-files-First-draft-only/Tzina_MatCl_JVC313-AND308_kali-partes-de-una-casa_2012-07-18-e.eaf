        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>Ke:meh yo:n kiliah yo:n,</ANNOTATION_VALUE>
