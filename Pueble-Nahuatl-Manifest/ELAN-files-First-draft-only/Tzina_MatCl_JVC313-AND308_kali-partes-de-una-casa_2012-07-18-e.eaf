        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>tehwa:n tik..., tehwa:n tikmattokeh *porque** no: nikpiaya se: kaltsí:n tikpiah kichihchi:wka no:pá:n de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>de yo:n xiw..., de xiw..., kowxiwit n' i..., n' xiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>Wa:n yehwa ya n' kintsi:n nochi mopatak, ne:n, ke:meh ekintsi:n pos no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>te:chne:xtiliah n' tota:tahwa:n, te:chne:xtilihkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>ki:ní:n tiketsaskeh tokaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>I:n tiketsaskeh n' tokaltsí:n pos i:n,</ANNOTATION_VALUE>
