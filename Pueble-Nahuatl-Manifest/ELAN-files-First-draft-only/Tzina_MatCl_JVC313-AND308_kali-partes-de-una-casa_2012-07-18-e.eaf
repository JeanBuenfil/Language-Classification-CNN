        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a787" TIME_SLOT_REF1="ts1226" TIME_SLOT_REF2="ts1227">
                <ANNOTATION_VALUE>pos *antes** neh nikitak kikwiah yehwa yo:n</ANNOTATION_VALUE>
