        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>Tiktehtekiah ihkó:n, 'tamachi:wayah wa:n tiktehtekiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>para ompa tikwa:ta:lia:yah itech i:n, ne:n, taihtikowa:yo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Mo..., ompa tikta:lia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts626">
                <ANNOTATION_VALUE>wa:n kintsi:n a:mo, kintsi:n tikchi:wah se: kaltsí:n ke:meh i:n nikitstinemi ka:s ika timopale:wiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts629">
                <ANNOTATION_VALUE>pos ihkó:n, sayoh tik..., *tikwa:pareja:rowah** ihko:ni wa:n tikta:liah ihko:ni wa:n tik..., tiksoh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>*Más** ne:nke:n kintsi:n ihsiwka se: kaltsí:n te:n se: ki..., ka o:me, e:yi tokni:wa:n se: ki..., se: ma:tami se: kali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>Se: ma:tami.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts644" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>Se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts647">
                <ANNOTATION_VALUE>seki ne:wí:n ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>se: mokwi:lia ne: se: seko ki..., kisoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts650" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>Sepa nika:mpa wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts653">
                <ANNOTATION_VALUE>ni:nipaka se: mokwi:lia se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>kita:lia, ne:n, kowtsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>Pos no:, no: yetoyah de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>ta:tahmeh de no: kimatiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>ki:ní:n talpi:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts676">
                <ANNOTATION_VALUE>Wa:n no: te:chne:xtilia:yah nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>ka:tí:n de n' kwaltias, de n' a:mo koto:nis se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>komekat ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>yehwa ya n' tekolo:i:x wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>xo:no:..., n' tepe:xo:no:t wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts692" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>tata:wikmekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>peto:lmekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts700" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>*hasta** yo:n kwetaxmekat, no: yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts707">
                <ANNOTATION_VALUE>ta: nijó:n no:, no: kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>Entó:s yo:n no: tikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>Neh ne:xtilia..., ne:chne:xtilia:ya no:pá:n katí:n de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts713">
                <ANNOTATION_VALUE>de n' tikwiah ika tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts714" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>ika tahtalpia:yah tatsi:ntsakwil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts718">
                <ANNOTATION_VALUE>Ika tiktekpa:ntia:yah n' xo:no:kowit tikilpih..., tikilpihtia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts720" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>*Eso** ke:meh tikihtowa mah se: kitili:ntihtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>Koma:mo se: kitili:ntia kaxa:ni, no:, no: pos nika:n i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts726" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>nochi kale:walmeh no: tikihilpia:yah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts733">
                <ANNOTATION_VALUE>No: tikihilpia:yah n' kale:walmeh. Tate:nilpil nochi n' ahko ne:n tama:mahkeh, taihtikowa:yo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>No: tikilpia:yah *a veces**, ne:n, yehwa ya ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts737">
                <ANNOTATION_VALUE>de ne: t..., ne:, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts738" TIME_SLOT_REF2="ts739">
                <ANNOTATION_VALUE>n' oksé: kwowtsí:n de ne:pa tama:mahkeh, no: kiliah no: tama:mahkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts741">
                <ANNOTATION_VALUE>Pero a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>wa:n sepa nika:n i:n, no:, no:, no: tikilpia:yah n' tate:nilpil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts749">
                <ANNOTATION_VALUE>Nochi ihilpitok. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>Ta:nka:yo:t pos yehwa ne: nochi tik..., tikihilpia:yah nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>Nochi ika komekat tik..., tiko:nkwiah wa:n tiko:nkwiah se: tama:mal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>wa:n yo:n poposokani de m' pitsa:wak, yo:n no: kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts762" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>No: ika se:, se: tahtalpia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Yetok ke:meh se: chikwase:n taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>tein ika titahtalpia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>de para se: kaltsí:n tiketsayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts779" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>Nochi wa:n tiktahtapa:nayah, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>ne:n xo:no:kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts784">
                <ANNOTATION_VALUE>*o** ke:meh i:n no: oksé: taman yo:n witsyoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>n' ohtat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts789" TIME_SLOT_REF2="ts792">
                <ANNOTATION_VALUE>Yeh yo:n tikwiah para totatsakwil ihkó:n. Tiktekpa:ntia:yah, tikxahxama:nia:yah nijó:n ohtat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>'ta:lia:yah se: kow..., ihko:ni se: kwowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts795" TIME_SLOT_REF2="ts797">
                <ANNOTATION_VALUE>ompa tikwa:ta:lia:yah wa:n ompa tiktekpa:ntia:yah, tiktapa:ntia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>*hasta** kwaltsi:n ihkwí:n pata:wak mochi:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609" TIME_SLOT_REF1="ts803" TIME_SLOT_REF2="ts806">
                <ANNOTATION_VALUE>Ni..., mopata:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a616" TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts824">
                <ANNOTATION_VALUE>Pos yehwa yo:n tikwiah *antes**, te:chilia:yah tota:tahwa:n, tikitayah kichi:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a620" TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>Pos a:mo no: wel tikye:kxihxi:mayah ta: katka chi..., tit..., tinohne:lmeh ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a621" TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>Pero ke:meh te:chilia:yah tota:tahwa:n ihkó:n tikxihxi:mayah ke:meh kina:miktia:ya, ke:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>kwaltsi:n ihkó:n se: kita:lia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a624" TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>Entó:s kwaltsi:n motatsakwaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts849" TIME_SLOT_REF2="ts850">
                <ANNOTATION_VALUE>Katí:n, ne:n ohtat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a627" TIME_SLOT_REF1="ts851" TIME_SLOT_REF2="ts853">
                <ANNOTATION_VALUE>yo:n kwaltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629" TIME_SLOT_REF1="ts855" TIME_SLOT_REF2="ts858">
                <ANNOTATION_VALUE>kwaltsi:n mopata:waya wa:n kwaltsi:n nika:n mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630" TIME_SLOT_REF1="ts859" TIME_SLOT_REF2="ts861">
                <ANNOTATION_VALUE>motekpa:naya ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a632" TIME_SLOT_REF1="ts863" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>A:mo, a:mo takohkoyo:ntoya. Mm. Pero nochi tikwiah nochi ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>yehwa ya n' kwomekat. Tata:wikmekat, peto:lmekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a635" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts873">
                <ANNOTATION_VALUE>yehwa ya n' kwetaxmekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a637" TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts878">
                <ANNOTATION_VALUE>tekolo:i:x, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638" TIME_SLOT_REF1="ts879" TIME_SLOT_REF2="ts881">
                <ANNOTATION_VALUE>tepe:xo:no:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a640" TIME_SLOT_REF1="ts883" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>ne:n, poposokani n' i..., n' ikomekayo, de yo:n pihpitsa:wak no: kwaltia. A:mo koto:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a641" TIME_SLOT_REF1="ts887" TIME_SLOT_REF2="ts888">
                <ANNOTATION_VALUE>Pos de yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a642" TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>seki ne:n, seki komekat ihkó:n pa:pata:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643" TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts893">
                <ANNOTATION_VALUE>no: kwaltia tiktsahtsaya:nayah wa:n no: kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a645" TIME_SLOT_REF1="ts897" TIME_SLOT_REF2="ts899">
                <ANNOTATION_VALUE>Entó:s yehwa nijó:n neh nikmattok de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a647" TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts904">
                <ANNOTATION_VALUE>se: kaltsí:n ki:ní:n se: kichi:wa wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a648" TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>pos kintsi:n kwali no: tine:chili:s, teh xa: kachi tikmati, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a649" TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts909">
                <ANNOTATION_VALUE>ki:ní:n namehwa:n nankichi:wayah se: kaltsí:n *o** ki:ní:n nankitamachi:wayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a651" TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>*o qué tanto de** weyak, *qué tanto** de pata:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a652" TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>wa:n ki:ní:n ki..., kox,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>*derecho** nanketsayah *o** xa: na:sika*o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a655" TIME_SLOT_REF1="ts922" TIME_SLOT_REF2="ts925">
                <ANNOTATION_VALUE>*o** wehkapan kipia n' i..., n' i..., n' ikwa:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a657" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts930">
                <ANNOTATION_VALUE>*o** xa: nankitehtekiah *o** xa: teihsá: nankita:lia:yah ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695" TIME_SLOT_REF1="ts1005" TIME_SLOT_REF2="ts1008">
                <ANNOTATION_VALUE>Pos..., nehwa nikitaya de n..., pos ke:meh tikihtowa, neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696" TIME_SLOT_REF1="ts1009" TIME_SLOT_REF2="ts1011">
                <ANNOTATION_VALUE>ke:meh tein no: tota:tahwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698" TIME_SLOT_REF1="ts1013" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>kitamachi:wayah, yehwa ihkwí:n kitalilia:yah, kita:lilia:yah ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699" TIME_SLOT_REF1="ts1017" TIME_SLOT_REF2="ts1018">
                <ANNOTATION_VALUE>ma:kwi:l, ne:n, ma:kwi:l kita:lilia:yah ihkó:n, ke:mah kitekih se: kowtsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700" TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1021">
                <ANNOTATION_VALUE>wa:n yehwa yo:ni kikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a702" TIME_SLOT_REF1="ts1025" TIME_SLOT_REF2="ts1027">
                <ANNOTATION_VALUE>Wa:n yo:n nikneltoka ke:meh tine:chilihtok kintsi:n, *cuando** kichi:wayah se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a704" TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1032">
                <ANNOTATION_VALUE>*hoyo**, tikiliah *hoyo**, tekoch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a705" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1034">
                <ANNOTATION_VALUE>Entó:s kixih..., kitekiah se: kowtsí:n ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706" TIME_SLOT_REF1="ts1035" TIME_SLOT_REF2="ts1036">
                <ANNOTATION_VALUE>[...]kintsi:n onkas, kintsi:n miak onkak *cosas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1039">
                <ANNOTATION_VALUE>Entó:s kitekiah se: kowtsí:n wa:n kwaltsi:n kipatachxi:mayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a709" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1044">
                <ANNOTATION_VALUE>Yehwa yo:n ika nika:n nochi kitektia:yah, kitektia:yah. Mm. Tatahkoya:n yetoya ne:n kowtsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a710" TIME_SLOT_REF1="ts1045" TIME_SLOT_REF2="ts1047">
                <ANNOTATION_VALUE>wa:n nika:n kitektia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a712" TIME_SLOT_REF1="ts1051" TIME_SLOT_REF2="ts1052">
                <ANNOTATION_VALUE>wa:n neh nikitaya ne: kahfe:nkowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a713" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1054">
                <ANNOTATION_VALUE>Kintsi:n no: nikelka..., kahfe:nkowit kitekiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a714" TIME_SLOT_REF1="ts1055" TIME_SLOT_REF2="ts1056">
                <ANNOTATION_VALUE>pihpitsa:wak *o** teihsá: kowtsitsí:n de n' mehmela:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a715" TIME_SLOT_REF1="ts1057" TIME_SLOT_REF2="ts1059">
                <ANNOTATION_VALUE>*Por eso** kikwiah ye:k miak, miak nika:n se: hkó:n se: *rollo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a717" TIME_SLOT_REF1="ts1061" TIME_SLOT_REF2="ts1064">
                <ANNOTATION_VALUE>wa:n yehwa ya ika kipantamo:tayah ihkó:n kwa:lkwia n' ta:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a718" TIME_SLOT_REF1="ts1065" TIME_SLOT_REF2="ts1066">
                <ANNOTATION_VALUE>Kwa:lkwia ya n' ta:l pos ne:pa kite:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a719" TIME_SLOT_REF1="ts1067" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>Sepa nijó:n komo kitah kaxa:ni a ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a720" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1071">
                <ANNOTATION_VALUE>pos 'kaxa:nia no: *porque** kilpia:yah ika, ne:n, komekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a722" TIME_SLOT_REF1="ts1075" TIME_SLOT_REF2="ts1076">
                <ANNOTATION_VALUE>Ika kwomekat kilpia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723" TIME_SLOT_REF1="ts1077" TIME_SLOT_REF2="ts1078">
                <ANNOTATION_VALUE>Sake:ra e:yi, e:yi *lado** kil..., kilpia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724" TIME_SLOT_REF1="ts1079" TIME_SLOT_REF2="ts1080">
                <ANNOTATION_VALUE>wa:n ika sepa kikwitih ne: kipankalakiah itech n' tekoch ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725" TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1082">
                <ANNOTATION_VALUE>ne:n *kowrollo** ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726" TIME_SLOT_REF1="ts1083" TIME_SLOT_REF2="ts1085">
                <ANNOTATION_VALUE>wa:n kwa:lkwiti a n' ta:ltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728" TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1090">
                <ANNOTATION_VALUE>Ne:pa kitamo:tah, sepa oksé: ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a729" TIME_SLOT_REF1="ts1091" TIME_SLOT_REF2="ts1092">
                <ANNOTATION_VALUE>*siquiera** na:wi:n, na:wi:n.</ANNOTATION_VALUE>
