        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a765" TIME_SLOT_REF1="ts1170" TIME_SLOT_REF2="ts1172">
                <ANNOTATION_VALUE>ox ki..., nijó:n mela:wak ya ne:n kalikxit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767" TIME_SLOT_REF1="ts1174" TIME_SLOT_REF2="ts1177">
                <ANNOTATION_VALUE>A:mo, a:mo 'kwiah ke:meh kintsi:n, pos nochi ta:taman, nochi mopatak ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a768" TIME_SLOT_REF1="ts1178" TIME_SLOT_REF2="ts1180">
                <ANNOTATION_VALUE>Yehwa yo:n ki..., kilpilia:yah se: tetsí:n ihkó:n ololtik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770" TIME_SLOT_REF1="ts1182" TIME_SLOT_REF2="ts1185">
                <ANNOTATION_VALUE>wa:n ompa k..., ike:span kita:liliah kox mela:wak ya ne:.</ANNOTATION_VALUE>
