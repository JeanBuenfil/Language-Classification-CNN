        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a771" TIME_SLOT_REF1="ts1186" TIME_SLOT_REF2="ts1187">
                <ANNOTATION_VALUE>Niman kihtowah ne:, ne: mela:wak ya ne:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a772" TIME_SLOT_REF1="ts1188" TIME_SLOT_REF2="ts1189">
                <ANNOTATION_VALUE>Sepa oksé: k..., ike:span kita:liliah, ne:n, n' kowtsí:n,</ANNOTATION_VALUE>
