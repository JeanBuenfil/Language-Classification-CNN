            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a791" TIME_SLOT_REF1="ts1235" TIME_SLOT_REF2="ts1238">
                <ANNOTATION_VALUE>Xa: tik..., xa: tiki:xmati no:, ma:ta:nkeh kipia n' iyo:lo kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792" TIME_SLOT_REF1="ts1239" TIME_SLOT_REF2="ts1241">
                <ANNOTATION_VALUE>Wa:n yo:n no: selia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794" TIME_SLOT_REF1="ts1243" TIME_SLOT_REF2="ts1245">
                <ANNOTATION_VALUE>Ka:s ika tiketsayah ihkó:n ka:mpa kwecha:wak n' ta:ltsí:n ne:n kaltsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796" TIME_SLOT_REF1="ts1247" TIME_SLOT_REF2="ts1250">
                <ANNOTATION_VALUE>se: kitas itsmoli:ntok ya n' ike:span.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798" TIME_SLOT_REF1="ts1254" TIME_SLOT_REF2="ts1256">
                <ANNOTATION_VALUE>Wa:n yo:n chakay yo:n no: selia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a800" TIME_SLOT_REF1="ts1258" TIME_SLOT_REF2="ts1261">
                <ANNOTATION_VALUE>Yo:n no: tikwiah para ne: kalikxit, chakay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801" TIME_SLOT_REF1="ts1262" TIME_SLOT_REF2="ts1264">
                <ANNOTATION_VALUE>Wa:n yo:n no:, no: tikwiah, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a803" TIME_SLOT_REF1="ts1266" TIME_SLOT_REF2="ts1269">
                <ANNOTATION_VALUE>de n' selia para tikihtowa:yah para taxi:ko:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a804" TIME_SLOT_REF1="ts1270" TIME_SLOT_REF2="ts1271">
                <ANNOTATION_VALUE>Pero seki nijó:n a:mo nochi taxi:kowa:ya, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a805" TIME_SLOT_REF1="ts1272" TIME_SLOT_REF2="ts1274">
                <ANNOTATION_VALUE>posteki nijó:n ta:lte:noh postekia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808" TIME_SLOT_REF1="ts1279" TIME_SLOT_REF2="ts1282">
                <ANNOTATION_VALUE>Ke:masá: se: kitas nijó:n ompa e:wtok ya yo:n chikintenanakat, pero</ANNOTATION_VALUE>
