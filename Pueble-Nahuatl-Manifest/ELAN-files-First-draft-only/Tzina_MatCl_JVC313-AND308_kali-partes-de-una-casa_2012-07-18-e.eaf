        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>N..., no: *igual** n' ahko de n' tama:mahkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts554">
