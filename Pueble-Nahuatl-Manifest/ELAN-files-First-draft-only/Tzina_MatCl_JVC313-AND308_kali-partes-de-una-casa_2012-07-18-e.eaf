        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>kwetaxkwowit n' i..., no: kwaltia para, ne:n,</ANNOTATION_VALUE>
