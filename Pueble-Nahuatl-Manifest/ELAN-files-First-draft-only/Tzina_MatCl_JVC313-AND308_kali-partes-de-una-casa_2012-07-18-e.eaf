        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a743" TIME_SLOT_REF1="ts1121" TIME_SLOT_REF2="ts1124">
                <ANNOTATION_VALUE>Uhuh. Nehwa ya ihkó:n nikmattok, pero ....</ANNOTATION_VALUE>
