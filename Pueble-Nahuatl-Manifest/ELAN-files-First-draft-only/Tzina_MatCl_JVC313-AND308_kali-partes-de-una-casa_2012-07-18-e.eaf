        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732" TIME_SLOT_REF1="ts1097" TIME_SLOT_REF2="ts1098">
                <ANNOTATION_VALUE>Se: ne:wí:n axtok wa:n se: ne:wí:n, niman kihtowa:yah,</ANNOTATION_VALUE>
