            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812" TIME_SLOT_REF1="ts1289" TIME_SLOT_REF2="ts1292">
                <ANNOTATION_VALUE>Nochi mopatak. Ekintsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813" TIME_SLOT_REF1="ts1293" TIME_SLOT_REF2="ts1294">
                <ANNOTATION_VALUE>pos yehwa yo:n selia ya nochi yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814" TIME_SLOT_REF1="ts1295" TIME_SLOT_REF2="ts1297">
                <ANNOTATION_VALUE>kowtsí:n, *hasta** yo:n xi:lo:kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a816" TIME_SLOT_REF1="ts1299" TIME_SLOT_REF2="ts1301">
                <ANNOTATION_VALUE>yo:n no:, yo:n no: selia. Yo:n no: kwaltia ya para ne:n tokalikxiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a818" TIME_SLOT_REF1="ts1303" TIME_SLOT_REF2="ts1306">
                <ANNOTATION_VALUE>No: kwaltiaya, katí:n ne:n ala:wakkowit yo:n, yo:n semi pala:ni niman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819" TIME_SLOT_REF1="ts1307" TIME_SLOT_REF2="ts1308">
                <ANNOTATION_VALUE>Nochi i:n kakatekowit yo:n komo selik se: kiteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820" TIME_SLOT_REF1="ts1309" TIME_SLOT_REF2="ts1311">
                <ANNOTATION_VALUE>yo:n te:mposteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a822" TIME_SLOT_REF1="ts1313" TIME_SLOT_REF2="ts1315">
                <ANNOTATION_VALUE>Te:mposteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a824" TIME_SLOT_REF1="ts1317" TIME_SLOT_REF2="ts1320">
                <ANNOTATION_VALUE>Katí:n yehwa:n yo:n kowmeh yo:n xi:lo:kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a825" TIME_SLOT_REF1="ts1321" TIME_SLOT_REF2="ts1322">
                <ANNOTATION_VALUE>chakaykowit, yehwa ya n' oksé: kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a826" TIME_SLOT_REF1="ts1323" TIME_SLOT_REF2="ts1325">
                <ANNOTATION_VALUE>ma:ta:nkehkowit yo:n nochi 'kwiah ne: a:na:l, *hasta** 'kowayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a829" TIME_SLOT_REF1="ts1330" TIME_SLOT_REF2="ts1333">
                <ANNOTATION_VALUE>Teh tikmattok *porque** ompa no: titato:kaya, ye:k miak onkak, n' ka:mpa onkak nijó:n wa:n ekintsi:n, ne:n, koyo:tsi:n kinamaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a831" TIME_SLOT_REF1="ts1335" TIME_SLOT_REF2="ts1338">
                <ANNOTATION_VALUE>*[Por]que** yo:n kwali para kalikximeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a832" TIME_SLOT_REF1="ts1339" TIME_SLOT_REF2="ts1341">
                <ANNOTATION_VALUE>Ma:ta:nkehkwowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a834" TIME_SLOT_REF1="ts1343" TIME_SLOT_REF2="ts1345">
                <ANNOTATION_VALUE>Nika:wí:n a:mo kachi nikita, xa: onkas we:wehka ampo:wí:n, *pero más** onkak ompa ne: a:na:lpa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a836" TIME_SLOT_REF1="ts1347" TIME_SLOT_REF2="ts1350">
                <ANNOTATION_VALUE>Ompa ne: a:na:lpa onkak nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a837" TIME_SLOT_REF1="ts1351" TIME_SLOT_REF2="ts1353">
                <ANNOTATION_VALUE>yo:n ye:kwehka:wa nijó:n kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a839" TIME_SLOT_REF1="ts1357" TIME_SLOT_REF2="ts1359">
                <ANNOTATION_VALUE>Kachi wehka:wa *que** xokokowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a841" TIME_SLOT_REF1="ts1361" TIME_SLOT_REF2="ts1364">
                <ANNOTATION_VALUE>*porque** xokokowit a:mo taxi:kowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a843" TIME_SLOT_REF1="ts1366" TIME_SLOT_REF2="ts1369">
                <ANNOTATION_VALUE>Uhuh. Yehwa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a845" TIME_SLOT_REF1="ts1371" TIME_SLOT_REF2="ts1374">
                <ANNOTATION_VALUE>Seliaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a846" TIME_SLOT_REF1="ts1375" TIME_SLOT_REF2="ts1377">
                <ANNOTATION_VALUE>Pos tehwa:n *antes** tikwiah yehwa yo:n na:wi, na:wi taman de kowit, n' a:makowit no: selia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a848" TIME_SLOT_REF1="ts1379" TIME_SLOT_REF2="ts1382">
                <ANNOTATION_VALUE>Yo:n no: tikwiah de n' mela:wak para, ne:n, kalikxit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a849" TIME_SLOT_REF1="ts1383" TIME_SLOT_REF2="ts1385">
                <ANNOTATION_VALUE>Entó:s ni:nipaka taxi:kowaya, *sólo** n' tatahkoya:n tikta:lia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a851" TIME_SLOT_REF1="ts1387" TIME_SLOT_REF2="ts1390">
                <ANNOTATION_VALUE>ma:ski tein weli kowit, yehwaya n' ala:wakkowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a852" TIME_SLOT_REF1="ts1391" TIME_SLOT_REF2="ts1392">
                <ANNOTATION_VALUE>oso yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a853" TIME_SLOT_REF1="ts1393" TIME_SLOT_REF2="ts1395">
                <ANNOTATION_VALUE>okseki kowtsitsí:n, xokot no: kwaltia *[por]que** yo:n tatsakwil sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a855" TIME_SLOT_REF1="ts1397" TIME_SLOT_REF2="ts1399">
                <ANNOTATION_VALUE>Pero kachi tayeka:ntoyah ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a857" TIME_SLOT_REF1="ts1401" TIME_SLOT_REF2="ts1404">
                <ANNOTATION_VALUE>ne:n *esquineros**, ka:mpa, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a858" TIME_SLOT_REF1="ts1405" TIME_SLOT_REF2="ts1407">
                <ANNOTATION_VALUE>tama:ma:nimeh de n' tayeka:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a861" TIME_SLOT_REF1="ts1412" TIME_SLOT_REF2="ts1414">
                <ANNOTATION_VALUE>Nika:n tatahkoya:n pos yo:n sayoh, *hasta** a:mo nochi wehkatan tikto:kayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a863" TIME_SLOT_REF1="ts1416" TIME_SLOT_REF2="ts1419">
                <ANNOTATION_VALUE>A:mo wehkatan 'to:kayah pos yo:n nijó:n nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a864" TIME_SLOT_REF1="ts1420" TIME_SLOT_REF2="ts1422">
                <ANNOTATION_VALUE>nochi *mismo** yeh mosempale:wia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a867" TIME_SLOT_REF1="ts1427" TIME_SLOT_REF2="ts1429">
                <ANNOTATION_VALUE>Mar..., ma:ski se: tehkoya ihkó:n a:mo moli:nia:ya, a:mo mo..., mochihkolowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a869" TIME_SLOT_REF1="ts1431" TIME_SLOT_REF2="ts1434">
                <ANNOTATION_VALUE>A:mo moko:so:lowa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a872" TIME_SLOT_REF1="ts1439" TIME_SLOT_REF2="ts1442">
                <ANNOTATION_VALUE>Yehwa, yehwa nijó:n nochi, ne:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a873" TIME_SLOT_REF1="ts1443" TIME_SLOT_REF2="ts1445">
                <ANNOTATION_VALUE>Taxi:kowa:yah, yo:n a:mo monekia semi telwehweikowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a875" TIME_SLOT_REF1="ts1449" TIME_SLOT_REF2="ts1451">
                <ANNOTATION_VALUE>Ma:ski ihkwi:ntsitsi:n tiktekiah seki.&lt;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877" TIME_SLOT_REF1="ts1455" TIME_SLOT_REF2="ts1457">
                <ANNOTATION_VALUE>Taxi:kowa:ya de e:yi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a879" TIME_SLOT_REF1="ts1459" TIME_SLOT_REF2="ts1461">
                <ANNOTATION_VALUE>de e:yi nijó:n kipiaya pos taxi:kowa:ya. Kati:yeh moko:so:lowa:ya komo sayoh ohka:n kipia, ne:n, kalikxit, a:mo, a:mo taxi:kowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a881" TIME_SLOT_REF1="ts1463" TIME_SLOT_REF2="ts1466">
                <ANNOTATION_VALUE>Ihkó:n. Mah e:yi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a882" TIME_SLOT_REF1="ts1467" TIME_SLOT_REF2="ts1468">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nochi nik..., yehwa yo:n neh nikitak, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a883" TIME_SLOT_REF1="ts1469" TIME_SLOT_REF2="ts1471">
                <ANNOTATION_VALUE>ne: ke:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a885" TIME_SLOT_REF1="ts1475" TIME_SLOT_REF2="ts1476">
                <ANNOTATION_VALUE>Tak kintsi:n no:, *cuando** ka:nsika te:ch..., te:chyo:le:wah ihkó:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a886" TIME_SLOT_REF1="ts1477" TIME_SLOT_REF2="ts1479">
                <ANNOTATION_VALUE>tikitatih wa:n timo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a888" TIME_SLOT_REF1="ts1481" TIME_SLOT_REF2="ts1484">
                <ANNOTATION_VALUE>timosenyo:lchika:wah, tiksenchi:wah se: kaltsí:n. *Entre** o:me, e:yi:n, niman kihto:s[keh], ¿ki:n tikchi:waskeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a889" TIME_SLOT_REF1="ts1485" TIME_SLOT_REF2="ts1486">
                <ANNOTATION_VALUE>Kihtowah pos ihkwí:n tikchi:watih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a890" TIME_SLOT_REF1="ts1487" TIME_SLOT_REF2="ts1489">
                <ANNOTATION_VALUE>A:mo nochi tikmatih, pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a892" TIME_SLOT_REF1="ts1491" TIME_SLOT_REF2="ts1494">
                <ANNOTATION_VALUE>ompa se: moseni:xpantilia ya. *Seis**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a895" TIME_SLOT_REF1="ts1499" TIME_SLOT_REF2="ts1501">
                <ANNOTATION_VALUE>Ma:s se: kaltsí:n, ma:s tsikitsi:n, de chikwase:n *vara** komo a:mo se: kimati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a897" TIME_SLOT_REF1="ts1503" TIME_SLOT_REF2="ts1506">
                <ANNOTATION_VALUE>a:mo se: kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a898" TIME_SLOT_REF1="ts1507" TIME_SLOT_REF2="ts1508">
                <ANNOTATION_VALUE>A:mo se: kichi:wa *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a899" TIME_SLOT_REF1="ts1509" TIME_SLOT_REF2="ts1511">
                <ANNOTATION_VALUE>pos kintsi:n nochi ihkó:n se: ki..., *siempre** ma:ski se: kihtowa ke:meh weli se: kaltsí:n, pero nochi se: kitamachi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a902" TIME_SLOT_REF1="ts1516" TIME_SLOT_REF2="ts1519">
                <ANNOTATION_VALUE>Nochi se: kitamachi:wa, *qué tanto de** wehkapan, *qué tanto de** we:weyak n' kowtsitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a903" TIME_SLOT_REF1="ts1520" TIME_SLOT_REF2="ts1522">
                <ANNOTATION_VALUE>*qué tanto de** pata:wak nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a905" TIME_SLOT_REF1="ts1526" TIME_SLOT_REF2="ts1528">
                <ANNOTATION_VALUE>Komo tikta:lih no: chikotik para ne:, pos chikoki:sa n' kali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a907" TIME_SLOT_REF1="ts1530" TIME_SLOT_REF2="ts1532">
                <ANNOTATION_VALUE>Nakasika yetok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a909" TIME_SLOT_REF1="ts1534" TIME_SLOT_REF2="ts1537">
                <ANNOTATION_VALUE>Pero komo tikta:lih nochi kwaltsi:n ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a910" TIME_SLOT_REF1="ts1538" TIME_SLOT_REF2="ts1540">
                <ANNOTATION_VALUE>pos nijó:n kwaltsi:n, ne:n, moka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a913" TIME_SLOT_REF1="ts1545" TIME_SLOT_REF2="ts1548">
                <ANNOTATION_VALUE>Yehwa sah yo:n nijó:n neh nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a915" TIME_SLOT_REF1="ts1552" TIME_SLOT_REF2="ts1554">
                <ANNOTATION_VALUE>Pos neh ni..., nehwa nimono:tsa Anastacio Nicolás Damián, niwi:tsa de ne: xola:l de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
