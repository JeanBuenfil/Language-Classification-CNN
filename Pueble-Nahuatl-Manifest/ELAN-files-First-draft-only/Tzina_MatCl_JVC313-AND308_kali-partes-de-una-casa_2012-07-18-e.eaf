        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734" TIME_SLOT_REF1="ts1101" TIME_SLOT_REF2="ts1102">
                <ANNOTATION_VALUE>ke:meh ne: xtachkwa, nochi kinchihchi:wiliah nochi yo:n kowtsitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735" TIME_SLOT_REF1="ts1103" TIME_SLOT_REF2="ts1105">
                <ANNOTATION_VALUE>wa:n ne: se: axtok ne:, a:kin achto ma:tami pos</ANNOTATION_VALUE>
