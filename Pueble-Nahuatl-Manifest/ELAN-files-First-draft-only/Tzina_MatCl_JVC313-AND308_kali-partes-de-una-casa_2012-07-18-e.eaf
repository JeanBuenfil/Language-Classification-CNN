        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778" TIME_SLOT_REF1="ts1202" TIME_SLOT_REF2="ts1205">
                <ANNOTATION_VALUE>kihtowah kintsi:n yetok ya p..., kintsi:n mah..., yetok ya, kintsi:n nijó:n mah tikintili:nti:ka:n ya. Uhuh, *mopareja:roh** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a779" TIME_SLOT_REF1="ts1206" TIME_SLOT_REF2="ts1208">
                <ANNOTATION_VALUE>Entó:s pos kintili:ntiah, tikintili:ntiah pero a:mo ke:meh kintsi:n eliwis tiktili:ntiah ika yo:n kwowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781" TIME_SLOT_REF1="ts1210" TIME_SLOT_REF2="ts1213">
                <ANNOTATION_VALUE>ika tiktsi:nmahmagayah, tiktsi:n...,</ANNOTATION_VALUE>
