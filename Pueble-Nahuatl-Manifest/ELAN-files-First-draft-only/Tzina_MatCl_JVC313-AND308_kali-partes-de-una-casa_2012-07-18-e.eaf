        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>nijo:n ka:nachi, ne:n, kwi:kah n' kowtsitsí:n wa:n no: tikmattok ne:n tamachi:w ki:ní:n se: kichi:wa, ne:n,</ANNOTATION_VALUE>
