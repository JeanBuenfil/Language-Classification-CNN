        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>*Porque** nijó:n kowtsitsí:n semi,</ANNOTATION_VALUE>
