        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739" TIME_SLOT_REF1="ts1113" TIME_SLOT_REF2="ts1114">
                <ANNOTATION_VALUE>Kipia *que** nochi kichi:wayah yo:n tekoch,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740" TIME_SLOT_REF1="ts1115" TIME_SLOT_REF2="ts1116">
