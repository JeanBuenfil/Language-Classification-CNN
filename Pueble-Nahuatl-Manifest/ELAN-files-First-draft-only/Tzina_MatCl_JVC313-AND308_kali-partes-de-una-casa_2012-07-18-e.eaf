        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a758" TIME_SLOT_REF1="ts1153" TIME_SLOT_REF2="ts1155">
                <ANNOTATION_VALUE>yo:n te:sakame..., [te:saka]mekat 'kwiah, yo:n mopihpilowa ike:span ne: oso ka:ns ika itech tepe:t mopihpi..., yo:n pihpitsaktik.</ANNOTATION_VALUE>
