        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>tikwih de ahokwowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>tikwih de teswakwowit, de yo:n de yo:lohxo:chit,</ANNOTATION_VALUE>
