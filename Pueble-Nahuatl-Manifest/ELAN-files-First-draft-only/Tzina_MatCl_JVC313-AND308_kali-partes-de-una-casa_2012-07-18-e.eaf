            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>Entó:s, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>yo:n no: kwali se: kisa:lowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>Kiliah tama:mahkeh *porque** ompa nochi, nochi n' tama:ma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>Nochi, nochi se: kitehte:mpilowa ne: kiliah tama:mahkeh no:</ANNOTATION_VALUE>
