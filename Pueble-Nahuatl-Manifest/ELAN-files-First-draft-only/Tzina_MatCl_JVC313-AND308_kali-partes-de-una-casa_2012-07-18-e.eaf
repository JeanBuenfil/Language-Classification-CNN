        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
                <ANNOTATION_VALUE>Se: nika:n kichi:wtok, *siquiera** na:wi kichi:wayah yo:n</ANNOTATION_VALUE>
