        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737" TIME_SLOT_REF1="ts1107" TIME_SLOT_REF2="ts1110">
                <ANNOTATION_VALUE>achto nochi kichi:wayah ke:mah kita:lia:yah n' kowtsí:n *qué tanto de** weyak, *qué tanto de** wehkapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738" TIME_SLOT_REF1="ts1111" TIME_SLOT_REF2="ts1112">
                <ANNOTATION_VALUE>De a:mo welik achto, seko kito:kayah.</ANNOTATION_VALUE>
