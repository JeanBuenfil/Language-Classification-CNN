            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>Yo:n no: taman kikehketsah ne:n kowtsitsí:n. Yo:n kachi we:weyak</ANNOTATION_VALUE>
