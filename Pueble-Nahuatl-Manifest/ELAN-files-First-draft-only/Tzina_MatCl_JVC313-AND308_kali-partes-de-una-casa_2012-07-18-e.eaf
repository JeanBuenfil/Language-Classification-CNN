        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775" TIME_SLOT_REF1="ts1196" TIME_SLOT_REF2="ts1197">
                <ANNOTATION_VALUE>Ke:mah, kitamo:tiliah ya n' tatahkoya:n ne:pa, ne:pa kita:liliah, ne:n,</ANNOTATION_VALUE>
