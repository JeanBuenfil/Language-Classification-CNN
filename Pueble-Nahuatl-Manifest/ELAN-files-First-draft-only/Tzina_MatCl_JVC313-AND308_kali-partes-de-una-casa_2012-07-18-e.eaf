        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776" TIME_SLOT_REF1="ts1198" TIME_SLOT_REF2="ts1200">
                <ANNOTATION_VALUE>n' te:sakamekat, ne:pa kita:lilia:yah wa:n sepa ne:pa wa:n</ANNOTATION_VALUE>
