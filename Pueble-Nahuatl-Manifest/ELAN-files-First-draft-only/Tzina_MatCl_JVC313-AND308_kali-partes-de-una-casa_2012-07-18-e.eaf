        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a782" TIME_SLOT_REF1="ts1214" TIME_SLOT_REF2="ts1215">
                <ANNOTATION_VALUE>'tsi:nmahmagatia:yah, 'tsi:nmahmagatia:yah</ANNOTATION_VALUE>
