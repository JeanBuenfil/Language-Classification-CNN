        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Ye:k, ye:koksi wa:n pané: tata wa:n totomoka ne: ka:mpa yo:n te:..., te:kwi wa:n nejó:n nehnemi wa:n te:kwi toto:nik *fuerte**.</ANNOTATION_VALUE>
