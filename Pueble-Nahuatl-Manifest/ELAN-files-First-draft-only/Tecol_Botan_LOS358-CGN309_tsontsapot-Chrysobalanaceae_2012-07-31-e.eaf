            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Ke:mah, tak yehwa ika, mm. Yehwa sah yo:ni ne:n ...</ANNOTATION_VALUE>
