        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>¿Wa:n i..., wa:n i:n nik..., i:n ke:ní:w n' tikilwia i:ni?</ANNOTATION_VALUE>
