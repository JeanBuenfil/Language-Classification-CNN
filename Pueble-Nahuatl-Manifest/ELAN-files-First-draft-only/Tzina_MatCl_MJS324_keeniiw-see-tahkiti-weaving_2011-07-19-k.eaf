        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>wa:n para ompa t'xi:yo:tiah ya, t'ta:liliah ya i:n.</ANNOTATION_VALUE>
