        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>yehwa ya n' ihkó:n iwa:n t'tetekwinohtiwih ya ihkwí:n ya.</ANNOTATION_VALUE>
