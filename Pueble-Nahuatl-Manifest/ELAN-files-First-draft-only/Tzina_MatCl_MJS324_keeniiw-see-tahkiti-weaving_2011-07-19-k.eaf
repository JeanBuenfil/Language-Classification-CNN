        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Ihkó:n para, ihkó:n ke:meh moihkittiw a pos nejó:n tik...,</ANNOTATION_VALUE>
