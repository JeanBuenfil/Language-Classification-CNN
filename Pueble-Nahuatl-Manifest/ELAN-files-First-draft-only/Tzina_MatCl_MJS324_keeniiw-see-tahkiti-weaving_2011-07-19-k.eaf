            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>¿Wa:n i:nkes ke:ní:w mono:tsah i:n kowtsitsí:n pihpitsa:wkeh?</ANNOTATION_VALUE>
