        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>wa:n *de una vez** tik..., ihkó:n tima:tamih ya, tik..., tikpehpenah ya,</ANNOTATION_VALUE>
