        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>¿I:n, i:n pata:wak?</ANNOTATION_VALUE>
