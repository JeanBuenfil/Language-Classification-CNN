        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>para yehwa ya ne:n ki..., kitokia ya n' takwitapan ya ne:n, ihkó:n ne:n inekwalo,</ANNOTATION_VALUE>
