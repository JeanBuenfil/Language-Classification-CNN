        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Koko:k i..., ix..., isakayotsi:n *o** koko:k ikowyo *o** ixo:chio. Wa:n ixo:chio, neh, neh a:mo ke:man tikita ke:niwki.</ANNOTATION_VALUE>
