        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>Pero a:mo ke:man nikitas mah wehkapantia semi *o** we:i kowit mochi:wa, a:mo.</ANNOTATION_VALUE>
