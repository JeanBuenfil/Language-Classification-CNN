        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>Wa:n se: yowi wa:n kwali, ta:ká:n ke:masá: no: tikekowa oso tikita ne:n i:n pos kwali se: moli:s, kwali ... Se: tiknelto..., [tinenel]tokakeh ke koko:k nehjó:n xiwit *o** xa:, xa: i:pa ihkó:n sah ito:ka:i nehjó:n xiwtsí:n, sakatsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>I:n ke:meskia sakatsi:n *porque** ihko:ni mochi:wa ke:meh mi:ltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>A:mo nikihto:s senwe:i kowit mochi:wa.</ANNOTATION_VALUE>
