        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>Ka:sá: ika ne: nikitstinemi ihkó:n pos kwaltsi:n ke:meh yo:n a:ko:lin i..., iteyo.</ANNOTATION_VALUE>
