        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Pos yehwa yo:n miakka:n no: nikte:kalilia ke onkak yo:n ... I:ksá: se: kita yo:n koko:kxiwit wa:n yo:n nimitstahtania xa: tikmati teh ke xa:, xa: ox koko:k yo:n xiwit.</ANNOTATION_VALUE>
