        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>Pos yo:n neh a:mo ke:man nikte:kakilih ox kwali para pahti.</ANNOTATION_VALUE>
