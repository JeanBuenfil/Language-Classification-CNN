        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Wa:n yo:n nikitstinemi ne:wí:n itech cha:wit, ihkó:n ka:mpa a:ta:l</ANNOTATION_VALUE>
