        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>A:mo ke:man nikitak ox koko:k nehjó:n xiwit, a:mo se: kikwa pero kwali se: kitas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Ke:masá: se: ki..., se: kieko:s ne:wi:n, a:mo, a:mo nikihto:s te:pahwi:s ta: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>kwali se: kieko:s ne:wi:n, onkak ne:wi:n.</ANNOTATION_VALUE>
