        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>wa:n ikwa:pan kipia ne:n iteyo.</ANNOTATION_VALUE>
