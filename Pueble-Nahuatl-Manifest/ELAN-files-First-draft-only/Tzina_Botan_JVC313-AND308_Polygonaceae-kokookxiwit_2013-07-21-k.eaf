        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>N' ta:lpan moso:sowa ihkó:n wa:n seki ihkó:n mokehketsa ihkó:n wa:n ihkó:n, ihkó:n yetok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
