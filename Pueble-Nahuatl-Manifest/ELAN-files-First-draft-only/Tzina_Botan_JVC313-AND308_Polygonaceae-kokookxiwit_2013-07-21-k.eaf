        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Se: kita ne:n wehkapantia, ihkwí:n, ihkwí:n de wehkapantia wa:n ompa ne: ke..., moketstiw ne:n iyo:lpan ne:n iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts109">
