                <ANNOTATION_VALUE>no: *mismo** iwki nika:n, sayoh porin nika:n no: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>Ke:mah. Ta: tein nikimpia *listonyohkeh** yeh kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>A:ah, tein a:mo *listonyoh** a:mo n'ta:lilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>I:pa iwki sah niimakia tein a:mo *listonyohkeh**, pero tein *listonyohkeh** kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>Ik..., ne:, achtopa ne:, *cuando** nima:tami nikihtsoma ya n' tasa:l,</ANNOTATION_VALUE>
