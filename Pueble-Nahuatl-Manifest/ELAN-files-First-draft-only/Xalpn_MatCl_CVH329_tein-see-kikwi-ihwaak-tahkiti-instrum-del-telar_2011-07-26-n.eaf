        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Ihkwi:ni a n' tikihtsomah para a:mo xiti:ni, komo a:mo xiti:ni.</ANNOTATION_VALUE>
