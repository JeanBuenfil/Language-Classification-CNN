        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>wa:n nika:n tiktekkeh i:n, entó:s tikwih wa:n ihkwí:n tiktetsi:lowah ihkwí:n.</ANNOTATION_VALUE>
