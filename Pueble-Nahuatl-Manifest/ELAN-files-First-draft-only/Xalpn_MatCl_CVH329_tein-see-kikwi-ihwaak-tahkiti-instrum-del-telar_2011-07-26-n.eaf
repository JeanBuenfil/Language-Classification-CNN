        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>*Por cachitos** se: kita:lilia, ke:meh, ke:meh kina:miktiw se: ki..., se: kiita.</ANNOTATION_VALUE>
