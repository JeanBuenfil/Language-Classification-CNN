        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>wa:n ke:mah niman tiktetsi:lohtiowih ihkwí:n.</ANNOTATION_VALUE>
