        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>Wa:n nika:n i:n nochi seh se:, i:n nochi seh se: se: kipehpena.</ANNOTATION_VALUE>
