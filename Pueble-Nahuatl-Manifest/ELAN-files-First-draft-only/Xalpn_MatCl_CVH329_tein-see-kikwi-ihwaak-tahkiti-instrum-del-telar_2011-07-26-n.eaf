        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>Ke:meh i:ni, nika:n tiktekkeh ya i:n, nika:n yetoya *hilo**,</ANNOTATION_VALUE>
