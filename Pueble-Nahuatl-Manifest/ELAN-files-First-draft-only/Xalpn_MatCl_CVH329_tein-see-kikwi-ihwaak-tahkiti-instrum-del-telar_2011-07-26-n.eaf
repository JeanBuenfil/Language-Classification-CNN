        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>A:mo n'mati seki ke:ní:w motachihchi:wiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Kemah, se: kiteki, se: kitekilia ya n' *hilo** tein moka:wati.</ANNOTATION_VALUE>
