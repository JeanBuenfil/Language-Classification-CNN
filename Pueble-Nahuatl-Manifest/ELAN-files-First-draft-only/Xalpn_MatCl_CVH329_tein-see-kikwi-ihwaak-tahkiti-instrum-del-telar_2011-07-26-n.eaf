            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>nochi, nochi ihkwí:n tikelpachohtiá:s *hasta** tima:tamiti:w ke:meh, ke:meh wehkapan nika:n,</ANNOTATION_VALUE>
