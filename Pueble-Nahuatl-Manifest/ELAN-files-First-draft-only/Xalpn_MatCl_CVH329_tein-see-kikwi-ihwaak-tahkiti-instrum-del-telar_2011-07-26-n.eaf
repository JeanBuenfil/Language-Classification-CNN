        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>ke:mah x'wi:piltaliya. Kemah mochi:wa ke:meh i:n ya, *como que** wi:pil a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>I:n a:mo no:, i:n a:mo no: neh n'chi:wak *porque** ne:,</ANNOTATION_VALUE>
