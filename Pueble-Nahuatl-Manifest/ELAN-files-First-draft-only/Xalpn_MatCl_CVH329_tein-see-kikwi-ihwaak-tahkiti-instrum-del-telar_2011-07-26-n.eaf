            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>wa:n komo i:pa nikpia ya i:n ite:mpotoyo iwa:n n'ta:lilia ya</ANNOTATION_VALUE>
