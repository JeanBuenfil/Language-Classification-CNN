        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts949" TIME_SLOT_REF2="ts951">
                <ANNOTATION_VALUE>Pos kintsi:n nochi tikmattia:tih *de que** ki:ní:n eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts969" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>¿Wa:n yo:n kipanta:liliah *o** achto yoksi ne:n nexkihit?</ANNOTATION_VALUE>
