        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts904">
                <ANNOTATION_VALUE>A:, no: we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts906" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>No: kwe:liltia sayoh *que** a:mo se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>Nika:n i:n timolihtokeh *de tiempo** ke:meh tiuweh ne:wí:n kowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts914" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>Pos kwali se: kitekis wa:n ika se: kitas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts920" TIME_SLOT_REF2="ts922">
                <ANNOTATION_VALUE>De nika:n tise:meh nika:n timolihtokeh pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts924" TIME_SLOT_REF2="ts927">
                <ANNOTATION_VALUE>kihto:s ne:chilih ne: tokni:w ihkwí:n i:n tapalo:l, pos ne:chchihchi:wili:ka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts931">
                <ANNOTATION_VALUE>ox we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts937">
                <ANNOTATION_VALUE>Nijo:n no: kwaltsi:n ke:meh nika:n timotapowihtokeh ki:ní:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts942">
                <ANNOTATION_VALUE>Kiní:n mochi:wa, kox kipia n' ixo:chio *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts945">
