        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts737">
                <ANNOTATION_VALUE>Pos yehwa yo:n taman de kiltsí:n ni..., a:mo se: kimati sah pero yo:n no: we:lik.</ANNOTATION_VALUE>
