        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts861" TIME_SLOT_REF2="ts864">
                <ANNOTATION_VALUE>Pos nochi nika:n ti...., timonohno:tstokeh ne:n tik..., [ti]momaka *cuenta** ki:ní:n, ki:ní:n timoi:xpano:ltiah ke:meh i:n tikowtahnemih tikita katí:n de n' we:lik, katí:n de n' a:mo we:lik ne:n totapalo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts878">
                <ANNOTATION_VALUE>Ne:nke:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>Pos kihtowah *que** no: kwaltia i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts887" TIME_SLOT_REF2="ts889">
                <ANNOTATION_VALUE>ka:ntsili:n mah kita:lili:ka:n ne:n pio:tetsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts893" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>No:, no: kit, no: kwali, no: we:lik, kwe:liltia.</ANNOTATION_VALUE>
