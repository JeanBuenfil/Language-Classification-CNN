        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a639" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1055">
                <ANNOTATION_VALUE>Neh a:mo nikmati, nikmattok sayoh n' okseki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a640" TIME_SLOT_REF1="ts1056" TIME_SLOT_REF2="ts1058">
                <ANNOTATION_VALUE>Ekintsi:n no: nikmattia:ti ka:ns ika nikitas ne: kox onkak, pos niktekis wa:n nikilis mah kimanaka:n wa:n nik..., nikeko:s no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a642" TIME_SLOT_REF1="ts1060" TIME_SLOT_REF2="ts1063">
                <ANNOTATION_VALUE>Wa:n *después** no: se: kiteki a ke:meh i:n tia:skeh i:n seki to:nalmeh ne: kowtah i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a644" TIME_SLOT_REF1="ts1065" TIME_SLOT_REF2="ts1067">
