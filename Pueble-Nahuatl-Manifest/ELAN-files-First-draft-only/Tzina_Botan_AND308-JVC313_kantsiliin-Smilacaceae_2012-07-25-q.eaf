        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>Pos i:n seki achi ta..., achi takwa:wak de chika:wak ya ne: ma:tananakat, pero pos no:, no: seki kwaltia se: kite:tewa:tsa ihkó:n, se: kite:tewa:tsa tatewa:ts no: we:lik.</ANNOTATION_VALUE>
