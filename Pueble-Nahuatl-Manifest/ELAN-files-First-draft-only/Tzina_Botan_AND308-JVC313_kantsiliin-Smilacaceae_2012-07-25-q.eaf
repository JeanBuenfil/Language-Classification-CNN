            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>no: kita:lilia:yah seki yo:n chikinte.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>No: kita:lilia:yah ne:n tapalo:l de ne:n kantsili:n, yo:n no: kwe:liltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>*Porque** yo:n chiki:nte o:me taman.</ANNOTATION_VALUE>
