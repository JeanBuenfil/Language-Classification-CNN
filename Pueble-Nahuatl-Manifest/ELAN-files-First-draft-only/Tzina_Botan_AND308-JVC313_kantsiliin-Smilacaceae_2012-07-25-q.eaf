        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>A:mo *igual**, ki:sa nochi n' ahwia:lis.</ANNOTATION_VALUE>
