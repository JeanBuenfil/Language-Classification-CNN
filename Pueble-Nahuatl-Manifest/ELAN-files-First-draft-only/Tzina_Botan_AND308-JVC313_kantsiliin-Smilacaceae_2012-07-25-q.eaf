        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>A:, para ki:sah yo:n okwiltsitsí:n seki kipia.</ANNOTATION_VALUE>
