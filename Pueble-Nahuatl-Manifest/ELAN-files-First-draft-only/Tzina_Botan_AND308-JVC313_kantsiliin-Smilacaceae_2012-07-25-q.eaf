        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>Ke:meh *limawits o** ke:meh yo:n te:n..., te:nko:lwits.</ANNOTATION_VALUE>
