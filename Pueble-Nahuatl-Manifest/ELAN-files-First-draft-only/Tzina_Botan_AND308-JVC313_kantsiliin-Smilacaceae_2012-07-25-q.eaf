        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>Sayoh kihtowah *que** no:, no: ki:sa n' ahwia:lis ne:n</ANNOTATION_VALUE>
