        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>wa:n se: kipoto:nilia istat wa:n se: takwa ya, ye:kwe:lik kwaltsi:n mahyá: ko:so:lin tikwahtok.</ANNOTATION_VALUE>
