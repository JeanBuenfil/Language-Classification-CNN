        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>Kowta:l.</ANNOTATION_VALUE>
