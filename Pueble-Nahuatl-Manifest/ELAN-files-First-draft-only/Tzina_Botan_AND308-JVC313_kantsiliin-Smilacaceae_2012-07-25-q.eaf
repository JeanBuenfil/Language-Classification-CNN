        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts848" TIME_SLOT_REF2="ts850">
                <ANNOTATION_VALUE>Pos ke:masá: se: moma:kalakilia ye:kte:kokoh, te:kokoh.</ANNOTATION_VALUE>
