            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1071">
                <ANNOTATION_VALUE>Ka:ns ika se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a648" TIME_SLOT_REF1="ts1073" TIME_SLOT_REF2="ts1076">
                <ANNOTATION_VALUE>Tohtoma:wak. Pos, yo:n we:wehka n' ii:x.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a650" TIME_SLOT_REF1="ts1078" TIME_SLOT_REF2="ts1081">
                <ANNOTATION_VALUE>Ihkó:n i:xwe:wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a652" TIME_SLOT_REF1="ts1083" TIME_SLOT_REF2="ts1086">
                <ANNOTATION_VALUE>*Más** niman se: ki:xmati n' a:xiwke:nkech *porque** semi telahalaxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a654" TIME_SLOT_REF1="ts1088" TIME_SLOT_REF2="ts1090">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
