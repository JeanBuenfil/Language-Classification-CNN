        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656" TIME_SLOT_REF1="ts1094" TIME_SLOT_REF2="ts1097">
                <ANNOTATION_VALUE>Pos neh yehwa sah de nik..., nimitstapowih *compadrito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a659" TIME_SLOT_REF1="ts1102" TIME_SLOT_REF2="ts1103">
                <ANNOTATION_VALUE>Pos nehwa niwa:le:w nika:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660" TIME_SLOT_REF1="ts1104" TIME_SLOT_REF2="ts1106">
                <ANNOTATION_VALUE>xola:l de San Miguel Tzinacapan, nimono:tsa Anastacio Nicolás Damián.</ANNOTATION_VALUE>
