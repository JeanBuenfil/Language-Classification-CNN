        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts741">
                <ANNOTATION_VALUE>Sayoh komo a:mo ki..., ka:patah pos nijó:n, n' yo:n tikihtowa ne:n te:pahwih.</ANNOTATION_VALUE>
