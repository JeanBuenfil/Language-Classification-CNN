        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>Komo se: kitila:na pihpilkatok ika n' ite:ntson mopihpilowa ya wa:n a:mo iw..., kineki wa:la:s, wehkapan yetok a:mo se: kitemowia ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
