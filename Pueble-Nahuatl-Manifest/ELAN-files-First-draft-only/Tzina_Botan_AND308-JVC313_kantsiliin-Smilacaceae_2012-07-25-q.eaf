        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Iw..., onkak o..., ke:mah, onkak o:me taman, yehwa n' tein,</ANNOTATION_VALUE>
