        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>n' ta:lte:noh a:mo semi, *cuando** i:n wehkapan ya pe:wa mochi:wa witsti a.</ANNOTATION_VALUE>
