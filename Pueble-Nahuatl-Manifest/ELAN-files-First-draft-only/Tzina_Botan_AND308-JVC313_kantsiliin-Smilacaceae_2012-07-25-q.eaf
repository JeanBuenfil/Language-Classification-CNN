        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>Pos tehwa:n kintsi:n,</ANNOTATION_VALUE>
