        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Wa:n nejó:n seki de chika:wak ya mo..., tehte:nko:ltia n' iwitsyo.</ANNOTATION_VALUE>
