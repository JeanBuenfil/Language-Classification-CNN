        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts830">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n. Yo:n kwaltsi:n, kwaltsi:n semi.</ANNOTATION_VALUE>
