        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>*O** ke:meh xokowits te:kokoh. Ke:meh eskia ne:n...</ANNOTATION_VALUE>
