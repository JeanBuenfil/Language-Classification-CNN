        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts835">
                <ANNOTATION_VALUE>Ihkó:n *de que** kipia n' eski, wihwitsyoh hkó:n tepitsitsi:n wa:n ke:meh eskia kokotsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>Pero yo:n witsti kipia, wits..., tsikitsitsi:n aya:mo te:kokoh.</ANNOTATION_VALUE>
