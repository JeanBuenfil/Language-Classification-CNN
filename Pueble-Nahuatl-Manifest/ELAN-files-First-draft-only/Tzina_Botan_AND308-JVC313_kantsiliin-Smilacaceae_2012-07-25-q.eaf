        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>We:lik, we:lik, *sea que** nochi *parejo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617" TIME_SLOT_REF1="ts997" TIME_SLOT_REF2="ts999">
                <ANNOTATION_VALUE>Nochi mihso:..., mihso:tah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a619" TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1004">
                <ANNOTATION_VALUE>Pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a621" TIME_SLOT_REF1="ts1006" TIME_SLOT_REF2="ts1008">
                <ANNOTATION_VALUE>Yehwa yo:n a:mo se: kimati, moneki mah kwali tamolo:n, *porque** yo:n iteyo i..., nijó:n te:te:mpi:pi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1013">
                <ANNOTATION_VALUE>Yo:n ke:mah. ke:mah. Wa:n moneki mah se:..., mah..., moneki mah se: kimah..., wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts1018" TIME_SLOT_REF2="ts1020">
                <ANNOTATION_VALUE>*Porque** yo:n iteyo no: takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a628" TIME_SLOT_REF1="ts1024" TIME_SLOT_REF2="ts1027">
                <ANNOTATION_VALUE>Te:kampi:pi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a632" TIME_SLOT_REF1="ts1034" TIME_SLOT_REF2="ts1036">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634" TIME_SLOT_REF1="ts1040" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>Pos yehwa yo:n ekintsi:n ne: tikihtowa *que** no: we:lik n' a:xiwke:nkech pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a637" TIME_SLOT_REF1="ts1048" TIME_SLOT_REF2="ts1051">
                <ANNOTATION_VALUE>No: kwaltsi:n we:lik.</ANNOTATION_VALUE>
