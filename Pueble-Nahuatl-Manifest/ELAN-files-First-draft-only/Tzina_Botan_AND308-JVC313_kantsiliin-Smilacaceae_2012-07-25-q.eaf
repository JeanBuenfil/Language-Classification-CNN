        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>Pos ne:n alakcho kihtowah we:lik ihkó:n, ihkó:n xoxowik.</ANNOTATION_VALUE>
