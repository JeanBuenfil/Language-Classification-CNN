        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>de komo ki..., o:me *viaje** ki..., kip..., kipa:kah, kimanah.</ANNOTATION_VALUE>
