        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>De se: *metro o** se: *metro** wa:n tahko chi:chi:ltik nochi n' *cuando** e:wa ta:lte:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Tele:wi kokotsitsí:n, witstsitsí:n, yo:n nejó:n i:pa iwki, iwki sah mochi:wa pero a:mo witsti yo:n, sanoke mahyá: kokotsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Mochi:wa witsti tak *cuando** weh..., moskaltia wehkapan ya,</ANNOTATION_VALUE>
