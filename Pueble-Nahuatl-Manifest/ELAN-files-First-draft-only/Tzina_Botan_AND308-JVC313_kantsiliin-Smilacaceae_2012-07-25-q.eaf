        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>tein xoxoktik ne:n kantsili:n wa:n onkak tein chi:chi:ltik.</ANNOTATION_VALUE>
