        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>ihwa:k semi mochi:wa *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>ne: tehwa:n to..., ke:..., *mayordomos** de ne: toxola:lpan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>tein *mayordomo de** yo:n ne:n *santo entierro**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>*cuando** mochi:wa ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>te:..., te:tamakalis de yo:n e:yi *hora** tio:tak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>yehwa n' kine:ska:yo:tia n' i:n *apóstoles** kintamakah ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>Yehwa yo:n kantsili:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Kit.., kite:motih n' tepotados tein ki..., tein kipiah yo:n chi:walis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>kite:motih kowtahpa ne:n yo:n kwomekat wa:n yo:n ki..., kichi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>chi:lposo:ntsí:n para ika kitamakah ne:n, ne:n i..., *iapóstoles** Jesús.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Yehwa yo.n, *bueno** mosempale:wiah wa:n yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>yehwa n' kine:ska:yo:tiah *que** kintamakah ika kantsili:n, *pobretapalo:l**, a:mo nakat kinkwaltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>Wa:n, wa:n a:mo sayoh yo:n, nochi mahtaktio:mo:me taman tapalo:l de kilts..., kiltsitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>nochi yo:n kinimakah n' *apostóles cuando** yo:n *tiempo** ihwa:k mochi:wa yo:n komekat semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>Ihwa:k tets..., tel..., ihwa:k mochi:wa nochipa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>Kanah, we:wehka sah. Ihwa:k ihwa:k selistok wel ihwa:k. *Dios** kita:lih ihkó:n para, para kikwiskeh ihwa:k yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Se:, se: 'pampixka, n' tein tatak se: kiki:xtilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>Pos neh, neh niki:xtilia n' ie:wayo *porque** tekoloh ya, mahyá: tata,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>neh niki..., *cuando** n' tikoixka, niki:xtilia:ya ne:n i..., ie:wayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>nikta:mo:ta wa:n niki:xtapa:na ya ihkó:n wa:n ke:mah nikpoto:nilia istat ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>Ke:mah kwaltsi:n ika se: takwa yo:n komekat, kwaltsi:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>Niki:xtapanaya sah, sayoh se: *viaje** niki:xtapa:naya wa:n nikte:milia ya n' istat, iwki wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>tikwa:yah ya ihkó:n. kwaltsi:n we:lik yo:n mahyá: *tasajo** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>Pos kihtowah *que** nochi we:lik *hasta** yo:n ima:xiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>We:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>Tein yo:n selontsitsi:n, we:lik ki..., kimanah, kichi:wah chi:lposo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>Ke:mah, kitekiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>We:lik, we:lik no:, we:lik ke:meh we:lik n' ikomekayo, we:lik n' ixiwyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Iwa:n kikokototsah nochi. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts498">
                <ANNOTATION_VALUE>Ke:mah, ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Ke:mah, sayoh witskilit ne: yeh no: taman kite...., yo:n itehte:ntsontsi:n ne: witskilit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>ne:, pané: kipia iihti..., iihtiyo:lo pané: *hilo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts513" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>Yehwa yo:n nejó:n..., wa:n ne:n kantsili:n yeh a:mo, yeh a:mo teh kipia *hilo**, yeh kwaltsi:n kohkoto:ni, chipa:wak kachi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>No: taman. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>I..., yema:nik *porque** kipia *hilo** taihtik *por eso** ne:. Ke:mah. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>Ka:n koto:ni, ka:n koto:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>Ne: koto:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>Koto:ni n' *hijuemala** wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts548" TIME_SLOT_REF2="ts551">
                <ANNOTATION_VALUE>Kení:w se: kikwa, ke:ní:w. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>Ne:n kantsili:n tak, ke:mah eski, ke:mah, nochi n' de tein eski takwalis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>mah nochi kwali tamanal para a:mo teh te:chi:wilia, te:chiwilia kokolis, te:kokolismaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>*Hasta** ke:meh yo:n nanakatsí:n, ma:tananakat semi tel..., ma:tananakat semi, semi ika se: mopahwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>Komo t..., komo tehwa:n a:mo t..., a:mo kie:kmankeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Yo:n ma:tananakat se: kahsi pero mah, mah se: kie:kti wa:n ke:mah se: ki..., kimanaka:n ya, mah molo:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>mah molo:ni sake:ra ohpa mah ka:te:ki:ka:n, mah tsokowa:ki, koh..., ka:te:kiah sake:ra ohpa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>wa:n ke:mah nejó:n moki:xtiah kwali molo:ni, ki:sa ya wa:n *hasta** ema:nik nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>A:mo t..., a:mo teh ki..., te:chi:wilih, pero komohkó:n soh kawa:ni, sepa molo:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>kki:xtiah wa:n iwki xta:tai a, te:kwi kalanemi:lis wa:n ihxo:ch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>Yo:n ika se: mopahwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>Ke:mah. Pero kachi kwali mah se:..., mah ki..., mo:molo:ni miakpa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>para a:mo te:pahwih. ke:mah wa:n nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>komohkó:n iwki se: ta:i, tepitsi:n sah... *Igual, igual** yo:n to:tolko:skat, yo:n ixta:wat mochi:wa, yo:n junio mochi:wa ata ix...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>itech kwa:kowkwitat, yo:n ohololtik, no: iwki, yo:n no:, no: ika se: mopahwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>Komo se:yeh a:mo se: kie:kmanak wa:n se: kikwahtiwetsi iwki, no: s..., no: ika</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>Tehwa:n tikitakeh seki *tovecinos**, te:pahwih, nikitani. Wa:n yo:n yema:nik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>pero, pero no: te:mach para se: mopahwi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts615">
                <ANNOTATION_VALUE>Seki *tovecinos** ne: ye..., yetokeh ne:pa tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>ke:meh i:n *tiempo** junio inimomá:n yahki ne: kwahmo:ch,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts619">
                <ANNOTATION_VALUE>yahki wa:n kitak nanakat nochi yehwa m' pochi:ntok ka:mpa mihkwita n' kwa:koweh, pala:ntok a n' kwitat ompa moye:..., kwaltsi:n nanakat pané:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts621">
                <ANNOTATION_VALUE>ohololtsitsí:n, pisi:ltik, ye:kselontsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts623">
                <ANNOTATION_VALUE>pe:wak kiteki na:nahtsi:n wa:n kwa:lkwik kalihtik, ehkok wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts624" TIME_SLOT_REF2="ts625">
                <ANNOTATION_VALUE>niman kichipa:w wa:n ke:mah kitikoketsak ne: ko:mit ne: tiko..., tanakastan de n' kom..., *casi** koma:ltampa *como que** kimantok, kimantiwetsi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts627">
                <ANNOTATION_VALUE>wa:n siwa:t se: oksé: yeh tistok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>tistiwetsi wa:n tepitsi:n molo:nik *o** kawa:nik sah wa:n kipoye:lih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts635">
                <ANNOTATION_VALUE>wa:n pe:wak kimahmaka ya ne:n pi:pil mah kikwa:ka:n, mah kikwa:ka:n ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
