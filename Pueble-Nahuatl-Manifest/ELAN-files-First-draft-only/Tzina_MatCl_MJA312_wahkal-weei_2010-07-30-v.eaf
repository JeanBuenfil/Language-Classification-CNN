        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>motsonta:lia:ya ihkó:n wehkapan para, para nehjó:n tikwa:lkwiah n' sinti, e:soh, mm.</ANNOTATION_VALUE>
