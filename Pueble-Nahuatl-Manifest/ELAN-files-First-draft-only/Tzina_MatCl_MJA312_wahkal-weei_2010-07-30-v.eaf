        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>wa:n ihwa:k kachi a:mo, a:mo, a:mo moi:xmatiah ke:meh yo:n ekintsi:n tikiliah nehjó:n i:xpatil ne:n, de n' *trenza** ke:mah.</ANNOTATION_VALUE>
