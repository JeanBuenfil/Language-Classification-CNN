                <ANNOTATION_VALUE>Tiksa:lowa:yah *rueda** ihko:ni, a:mo tik..., a:mo tiki:xtapalta:ta:lia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
