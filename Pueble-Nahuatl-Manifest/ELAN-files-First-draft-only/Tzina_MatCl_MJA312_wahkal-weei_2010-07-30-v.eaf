        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>Ke:mah, a:mo t'wi:ka:yah nehjó:n *costal** ke:meh ekintsi:n nio:nó: tikwih ok sake:ra *canasta**, ekintsi:n tikwih *costal** ke:mah.</ANNOTATION_VALUE>
