                <ANNOTATION_VALUE>Komo se: kineki ihilpitok sah pero kachi *más** kichi:wayah yehwa yo:n nimitsilia mahyá: ta:tamali:n, *cuadritos** mochi:waya ihko:ni, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>yehwa yo:ni *más** tikchihchi:wayah para nehjó:n ... Tak a:it ke:ní:w ox para taxi:kowa:ya oso tak i:pa iwki tikwelitayah sah pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
