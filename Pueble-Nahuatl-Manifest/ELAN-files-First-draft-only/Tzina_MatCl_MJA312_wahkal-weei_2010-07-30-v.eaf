                <ANNOTATION_VALUE>titapixkatih ke:meh *cada** xiwit sah pos tiktamikwih wa:n sepa tike:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Para n' se: xiwtika pos sepa te:chservi:rowa, taxi:kowa:ya sake:ra</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>o:me *viaje, porque** no:, de a:mo *seguido** se: kikwi, no: ista:ka:pala:ni xo:no:t, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Pero yehwa yo:ni ne:n tikwiah tehwa:n, nochi yehwa ne:n wahkal, nochi wahkal tikwiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>a:mo tikwiah ne:hjó:n *costal** wa:n a:mo tikwiah nehjó:n *canasta**, i:n *después** a ke:mah pero *antes** nochi wahkal tikwiah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Tikwitih ne:n ke:meh i:n komohkó:n titato:kkeh pos nehjó:n t'mattokeh ya ne:n tikwite:wah ya towahkaltsi:n, mo:sta ya, mo:stah ya *hasta** tima:tamih ya tapixkalis, nochi tite:tapixkia:yah, nochi wahkal tikwi:kayah, e:soh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>A:mo moi:xmatia *canasta**, tak xa: i:pa onkaya pero a:mo ya tikowayah, tikwiah yehwa wahkal, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Tikihtowa:yah tehwa:n ke kachi kwali wahkal *porque** nehjó:n xa: kachi miak akia oso tak no: se: momati de n' se: *cosa** sah se: kikwi, e:soh, mm,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>yehwa yo:ni ne:n tikwiah tehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Ika tikwa:lkwiah sinti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Ika tikwa:lkwiah sinti ne:n tein e:wayoh.</ANNOTATION_VALUE>
