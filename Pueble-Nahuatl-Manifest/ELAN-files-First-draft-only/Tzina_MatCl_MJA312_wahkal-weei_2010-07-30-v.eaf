        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>se: kisa:lowa *hasta** panki:saya, no: kwaltsi:n ihkó:n *copeteado** mochi:waya,</ANNOTATION_VALUE>
