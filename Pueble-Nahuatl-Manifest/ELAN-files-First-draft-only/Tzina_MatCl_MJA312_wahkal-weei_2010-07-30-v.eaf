                <ANNOTATION_VALUE>no: te:tahtaniliah *favor** mah se: kiniwa:lkwili ke:ski sinti, entó:s pos tikiwa:lkwilia:yah ya, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Nochi yehwa ya ne:n ika tikinwa:lkwiah, yehwa, yehwa tikwiah *casi** nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
