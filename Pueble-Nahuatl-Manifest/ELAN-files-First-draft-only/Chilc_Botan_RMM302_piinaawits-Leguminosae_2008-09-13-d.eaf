        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Yehwa n' kiliah, yehwa n' kil..., yo:n kito:ka:ytiah xiwtanechiko:l.</ANNOTATION_VALUE>
