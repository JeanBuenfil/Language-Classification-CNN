            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>kwaltia para, yo:n pi:na:wits kwaltia para pahti.</ANNOTATION_VALUE>
