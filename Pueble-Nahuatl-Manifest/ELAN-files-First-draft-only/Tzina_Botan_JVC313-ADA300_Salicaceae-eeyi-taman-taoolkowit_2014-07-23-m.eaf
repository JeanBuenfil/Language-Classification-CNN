        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>wa:n semi takwa:wak taxi:kowa semi para n'..., am..., para n'... A:mo, a:mo..., a:mo okwilowa</ANNOTATION_VALUE>
