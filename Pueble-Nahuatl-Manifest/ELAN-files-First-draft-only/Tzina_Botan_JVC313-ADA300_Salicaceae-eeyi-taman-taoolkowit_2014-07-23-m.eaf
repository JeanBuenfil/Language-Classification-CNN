        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>ke:man kalmeh ne: aya:mo semi kichihchi:wayah de tepa:mit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>*porque** ekintsi:n no:ya:n nochi tet a n' inkali pero ne: wehka:w mocha:ntia:yah ika ne:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Yehwa nc... *Teja** wa:n yehwa n' kalkowit eliwis sah ihkó:n kite:mowa:yah ne: komimil kihtowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>wa:n nikelna:miktok yehwa yo:n semi kwelitayah ne:n ta:tahmeh ika mocha:nti:skeh yehwa yo:n tao:lkowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Eski kanah neh a:mo nikmati ox a:mo okwilowa neh  nikelna:mikktok ne: no:pa:n yehwa ika mocha:ntia:ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>wa:n yehwa ika nikmattok wa:n yehika no: niki:xmattok *porque** neli ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>Te:chne:xtilia:ya wa:n te:chilia:ya ihkó:n *que**... Komohkó:n te:chwi:kaya mah tia:kan 'tame:watih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>ne: te:chilia:ya mah a:mo te:xi:maka:n n' *cahfentah** ompa te... Tikyewalka:wayah yehwa ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>kowkone:t ke:man katka tsi:tsikitsi:n ne:n, tao:lkowkone:t (...) ompa se: kahsi ta de se: tame:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>entos te:chilia:ya mah tikyewalka:wa:ka:n mah 'tachipa:wi:ka:n mah moskalti *porque** ne:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Ne: pala:nis n' kalkowit wa:n ompa tikwiskeh sah. Yehwa nikelna:miktok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Pero pos neli a:mo nikelna:miki ox okwilowaya oso a:mo okwilowaya *porque** pos de se: pili wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>ke:meh neh no: nisiwa:... Nisiwa:t pos a:mo no: nik... A:mo ke:man nikchi:wa n kali wa:n a:mo nikita</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Ke:mah ka:n ke:man nikita ox okwilowa oso a:mo okwilowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>a:n pos neli yehwa yo:n a:mo nikmatia pero nikmattok no:pa:n semi kwelitaya yehwa yo:n kowtsí:n mah tika:wtia:ka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>para ke:man moneki pos sayoh ompa kikwia ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Ke:mah ne: pos a:mo n'mati xa: teisá: ok tikpia tein ne:chyo:lmela:was ne:chtapowis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Ke:mah eski neli wa:n ixo:chiotsi:n ata mahyá: no: ista:k ye:kpisi:ltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>ke:mah pisi:ltik ata n' iteyotsi:n ista:k wa:n neli de posonia ne:n iteyotsi:n no: mi:miak mo... Mopilowilia seko sah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>Ke:mah. Pos telmiak tasohka:matik ne: ne:chtapowi ka:ni ne:... ke:ní:w n' timono:tsa wa:n ka:ni n' tiwa:le:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>A:n pos neh noto:ka:y *este** Amelia Dominguez Alcantara wa:n niwa:le:wak de ompa ne: Ziltepec.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
