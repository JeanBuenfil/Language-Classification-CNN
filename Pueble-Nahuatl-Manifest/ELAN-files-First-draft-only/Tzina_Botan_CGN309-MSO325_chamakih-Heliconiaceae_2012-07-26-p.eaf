                <ANNOTATION_VALUE>Ke:mah, nikilia neh, ta: neli pos nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>miak taman onkak xo:chitsi:ni, sayoh nikilia neh mah onka sah wa:n mah ika se: tachihchi:wa. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>Ke:mah, pos nikilia neh nejó:n pos komo se: kikwiti nikilia neh no: kwaltsi:n motaka:wa nikilia neh *hasta** ka:mpa se: *ixa:ntohi:pan porque** kwaltsi:n nikilia neh no:, no: taposo:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>Ke:mah, weh neli, ta: no: kwalne:xtia. Takwalne:xtia nikilia neh. Ke:mah, ta: yehwa ok nikilia neh, neli pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>komo a:mo yeh ka:n no: tikalyetoskeh *porque** yehwa yo:ni nikilia neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>komo se: kalyetok pos i:pa *siempre** se:, se: kita:lia *siquiera**, ma:ski a:mo semi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>semi nikilia neh *cada** chikwe:i, *pero siempre siquiera, siquiera** se: *ca..., cada, cada quince días** se: kita:li:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
