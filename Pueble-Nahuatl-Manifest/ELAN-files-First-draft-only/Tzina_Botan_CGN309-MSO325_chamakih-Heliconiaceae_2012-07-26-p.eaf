            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Ata neli yehwa ya. Ke:mah, *porque** pos ne:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>I:n a:man, ke:mah neli sayoh se: *viaje** n' kihtowah mochi:w. Ka:n, tak ka:n kinekik ok ne:n tio:pixka:tsí:n nikilia neh para wa:wa:lahtos. Ke:mah, yehwa:n ya n' kipatah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Ke:mah. A:, yehwa yo:n neli n'mattok *que** ihwa:k neli yo:n tel onkak neli yo:n xo:chitsí:n nochi neli katí:n eski nikilia neh yehwa n' tein tato:k wa:n tein kowtah chamakih, nochi ihwa:k moye:kchi:wa. Ke:mah, nochi mochi:wa ihwa:k yo:ni wa:n nikilia neh pero...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>¿Katí:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Ke:mah, no: kipia, no: kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Ke:mah, ta: tak no: ixwa sepa, ke:meh yo:n nikilia neh seki ompa, ompa chika:waya ka:n akah kiteki pos sepa no: teyowa ompa. Wa:n komo a:mo *mismo** yehwa m..., *mismo** yehwa mokopi:ntiw mahyá: itesyo panki:stiw ata nikilia neh itesyotsi:n no: wa:n ka:mpa kipia ya n' iselotsi:n no: panki:sa ya. Panki:sa ya *porque** yehwa ya i:n nikihtowa neh tehwa:n ne: kaltsi:ntan t'to:..., ne:, *bueno** tak kito:kkah ne: ke:man ya nikilia neh, a:mo n'mati *porque** pos ke:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>*cuando** neh nikinahsiko ompa i:pa onkak yo:n chamakih. Wa:n neli tel onkaya pero ekintsi:n poliwtok a *porque** porin tapialmeh kikwahkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Ke:mah, pero neli panki:stiw neli yo:n nikilia neh tsitsikitsi:n ihkwí:n panki:stiw wa:n kikwahtiwih. Ke:mah, ke:meh moka:wa n' itesyotsi:n m..., nejó:n pos no: iwki panki:stiw sepa ne: nejó:n tein itsmoltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>pero yehwa yo:ni pos komo... Ke:mah, komohkó:n nejó:n onkaskia nikilia neh iwki miakixtiw, *pero de que** kina:miktiwih sah n' tapialmeh pos ka:n... Ke:mah, ka:n kwaltia ok nikilia neh *porque** no:, tak no: te:ntoto:nkeh n' tapialmeh nikilia neh *por eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>Ke:mah, wa:ki. Wa:n neh nikilia ata tein ox no: tiki:ita yehwa n' tein kiliah kowtah chamakih nikilia neh yeh telwehkapan moskaltia, telweh..., telwehwei mochi:wa wa:n i:n... Ajá wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>Ahsi a nikilia neh ika tachihchi:wah ya wa:n yo:n okseki nikilia neh ata a:mo *tanto** tel..., a:mo *tanto** telwe:wehkapania pero neh nikita *porque** ne: n' ompa ne: kahfe:ntah ya nejó:n nikihtowa kito:ktokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>wa:n seki a:mo, a:mo telwehkapan moskaltia wa:n yo:n okseki telwehkapan moskaltia. N..., ke:mah *porque** ni...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>*hasta** n' iswayo nikilia neh telwe:weyakaxtik. Wa:n i:n seki nikilia neh a:mo iwki semi telwe:weyak mochi:wa, ta: *más** moskaltia yehwa yo:n tein kowtah chamakih. Ke:mah, *porque** nejó:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>Ke:mah, nochi iwki nikilia neh mochi:wa wa:n... Ke:mah, ahsi a, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>Ke:mah, ta: nejó:n neli nikilia neh tel..., telwehwei mochi:wa wa:n yehwa neli yo:n okseki neh nikilia a:mo, pané: a:mo *más** nehnemi ne: nikihto:s mah we:i takwi *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts353">
