            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>Pero mochi:wa n' ka:sá: ika, ata yo:n ne: ka:mpa Lencho Juárez katka ata onkak.</ANNOTATION_VALUE>
