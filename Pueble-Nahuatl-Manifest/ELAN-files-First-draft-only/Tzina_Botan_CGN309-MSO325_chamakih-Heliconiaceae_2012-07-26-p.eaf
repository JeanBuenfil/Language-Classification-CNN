            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Ke:meh yo:n ne: totiotsi:n ata nikilia neh nejó:n no: kit kilwi..., kitalwichi:wiliah ya itech i:n junio</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>no: tikmattok. Ajá, ke:mah. Ata pos seki kiliah *Corphus, pero** neh ka:n nikmati, *porque** neh i:pa nika:kakilia:ya note:iskaltihka:w te:ilia:ya neh miakpa ne:chilia:ya *que** kiliah yehwa:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>A:mo n'mati n' teh ox no: tikmattok. ¿A:mo tikmati?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>Ke:mah, pero nejó:n neh nika:kakilia:ya note:iskaltihka:w, ne:chilia ta: ne: kiliah kihtowa yehwa:tsi:n kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>*Porque** ata *cuando** yo:n nejó:n nikilia neh ye..., *cerca** ya n' talwiki:xti:tih. Wa:n pos ta yo:n ata mochi:wa ne: nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>*bueno** ne: ke:man *más** mochi:waya ne:n i:pa ne: nejó:n yehwa ya n' ke:meh yo:n ne:n *misitas** nikilia neh mochi:waya ata e:xpa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>E:xpa wa:n i:n a:man pané: a:mo iwki ok mochi:w. Ata neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Sayoh sepa, ke:mah. Ta: yehwa nikilia neh nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>ihwa:n yo:n wa:n neli ke:meh yo:n *cuando** kiki:xtia:ya *limosnita**, yehwa yo:n kihto:s ne: nejó:n note:iskaltihka:w, kihtowa, ta:, ta: ne: nentok kihtowa yehwa kihtowa n' tein kiliah kihtowa yehwa:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>Wa:n ne: nikilia pos para ke:maniá:n. Pos ta: ne: kihtowa yehwa:n ya kihtowa tein ompa tapale:wiah kihtowa ne:n ta:tahmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>yehwa:n kihtowa ne: kiki:xtiah, kihtowa *pero cuando** pe:wte:wati kihtowa yehwa:n ya kihtowa n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>yehwa:n kixta:wah kihtowah. Yehwa:n kihtowa n' kixta:wah.</ANNOTATION_VALUE>
