                <ANNOTATION_VALUE>A:; yehwa yo:n okseki. Ke:mah, pero neli yo:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>sayoh *que** neli mone:neki nika:wí:n tehwa:n, ke:mah, a:mo mochi:wa, pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>tak mochi:was neli nikilia neh pero mah nejó:n mah neli se: *kkorralti para** a:mo kikwa:skeh tapialmeh. A:, ka:n te:ka:wiliah i:n kaltsi:ntan, ta: kika:wah nikilia neh *solamente** kowtah, neli pero pos ompa nikilia neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>se: k'ka:wati:w pero neli kihtowa yo:n nota:tahtsi:n kihtowa i:pa t'polo:skeh sah kihtowa. Ke:mah, poliwis kihtowa *solamente** i:n okseki kihtowa pos i:pa kitekih kihtowa, *porque** pos yeh kihtowa i:pa onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>kihtowa. Kanah, ka:n te:ka:wilia. ke:mah wa:n neli nikilia neh pos nejó:n ta:taman xo:chitsí:n onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
