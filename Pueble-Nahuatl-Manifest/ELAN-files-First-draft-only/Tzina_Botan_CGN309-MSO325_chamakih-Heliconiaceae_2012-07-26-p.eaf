                <ANNOTATION_VALUE>Ke:mah, yo:n kit iwki ika tachihchi:wah. Ke:mah, a:mo nejó:n... Tak iwki neli, kihtowah *que** ka:n kitapa:nah, kihtowah *que** iwki neli kit *porque** yo:n ke:man, ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>ke:mah , ne: seko ti..., tikalpano:toh wa:n nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>ompa tikitakeh neli yehwa n' ika tachihchi:wkeh. Wa:n neli nikilia neh yo:n nota:tahtsi:n, ye:kkwaltsi:n nikilia ne:, no: t'to:kaskiah.</ANNOTATION_VALUE>
