        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>Wa:n yo:n onkak nikilia neh nejó:n neli no: kostik wa:n no: i:n chi:chi:ltik, *pero mismo** kipia ompa n' *color**. Ke:mah, pero neli yo:n nikilia neh..., wa:n yo:n kihtowah ka:n kitapa:nah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
