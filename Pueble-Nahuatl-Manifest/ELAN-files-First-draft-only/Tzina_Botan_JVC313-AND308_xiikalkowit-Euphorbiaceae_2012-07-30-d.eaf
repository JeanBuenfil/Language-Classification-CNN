        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Seki kwaltsi:n tapa:ni, seki ma:ski wa:kik ihkó:n se: kitapa:na, ki:x..., se: ki:x[tia]na:wi.</ANNOTATION_VALUE>
