        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Wa:n kwe:chwia:yah,kilia:yah chi:ltatix, yo:n we:lik ke:meh a:ko:ltatix.</ANNOTATION_VALUE>
