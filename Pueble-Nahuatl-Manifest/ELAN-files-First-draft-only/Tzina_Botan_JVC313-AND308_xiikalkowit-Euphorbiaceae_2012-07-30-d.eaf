        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Yo:n ke:masá: pos no: kita:lilia:yah ne:n kiltsi:n, kima:nelowa:yah ihkó:n iwa:n ne:n etsi:n, ihkó:n ki..., tikwa:yah *cuando** konkwiah ne:n tota:tahwa:n wa:n yehwa yo:n neh nikmattok ne:n ikowyo seki achi yohyowaltik, chihchi:chi:ltik i..., ikowyo.</ANNOTATION_VALUE>
