        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Ihkó:n posa:lmeh se: kitekpa:naya wa:n se: kakis ne:wí:n se: motal..., se: kakis papataka ya.</ANNOTATION_VALUE>
