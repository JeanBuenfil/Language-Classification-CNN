            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Yo:n ke:masá: tehwa:n ne:, ne: kowtah tia:yah pos tikwi:kayah *morral** wa:n tikwa:lkwiah se:, yo:ltok ne:n tikwa:lkwiah wa:n tikalakia:yah itech yo:n i..., i..., incha:n, yo:n kitachihchi:wiah, yo:n de a:kat.</ANNOTATION_VALUE>
