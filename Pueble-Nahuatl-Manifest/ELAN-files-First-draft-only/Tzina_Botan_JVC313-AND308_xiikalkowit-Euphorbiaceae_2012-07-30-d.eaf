        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Yeh ise:lti ne: tapa:ni ki..., mahmaka:wi wa:n tikololowah wa:n tikwi:kah ya kito:nalwa:tsayah wa:n pos kwe:chowa:yah, yo:n a:mo nikihto:s semi nehjó:n ... Pané: achi kahkakawtiw.</ANNOTATION_VALUE>
