            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Entó:s ompaya ne: se: kitahta:lia:ya ke:masá: ne:n yo:n tsonti.</ANNOTATION_VALUE>
