        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Tehte..., ke:meh istawa:t wa:n seki yo:n tak kiliah, ta: neh niki:xmattok sayoh se:, se: taman de yo:n xi:kalkowit.</ANNOTATION_VALUE>
