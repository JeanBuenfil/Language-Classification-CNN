        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>A:, wa:n 'neki tikmatis ke:meh i:n tikowtahtekitinih tinentinemih, ne:wí:n kowtah oso ne:wí:n ohti tikitah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>Pos nehwa nikitstinemi ne:wí:n seki tikitah ne: xi:kalkowit ne:n pos no: wehkapania, seki mochi:wa wehwe:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Pero yo:n ne:n kwaltia *solamente** ke:masá: kitsaya:nah para nehjó:n ika timotatsakwiltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>Pero seki, pero kihtowah semi yema:nik pero kwaltia.</ANNOTATION_VALUE>
