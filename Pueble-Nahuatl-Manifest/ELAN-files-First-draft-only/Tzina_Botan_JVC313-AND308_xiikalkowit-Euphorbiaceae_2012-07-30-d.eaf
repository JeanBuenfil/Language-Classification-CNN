        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Kimo:ltah nochi wa:n pos yehwa yo:n nikita ye:kkwaltsi:n komoke chihchi:chi:le:wi ne:n i..., tamo:ltal ki..., yehwa yo:n neh nikitaya ne:wí:n tiktekiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>Ka:sá: ika tikma:tekitih wa:n tik..., tikwa:lkwih wa:n ka:sá: ika seki tahtapa:ntok pos tik..., tikololowah *o** yehwa yo:n tikwa:lkwih kalihtik, ke:masá: to:nalwa:tsah.</ANNOTATION_VALUE>
