            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>Wa:n se: ki:xkepa wa:n ixki a wa:n komo se: kita:lilih achto, pos se: kipanta:lilia se: taxkaltsí:n, komo yetok o:me taxkal sese:k</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
