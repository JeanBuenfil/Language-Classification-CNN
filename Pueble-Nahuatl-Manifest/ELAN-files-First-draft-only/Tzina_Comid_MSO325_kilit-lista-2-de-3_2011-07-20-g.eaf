        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Wa:n iteyotsi:n pos no: *igual** iwa:n pi:xowi a *porque** pos de chika:wak a a:mo wel se: kimana ok nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>kwaltsi:n se: kimana *cuando** yo:n *apenas** ixwatok, yo:n ye:kkwaltsitsi:n mokehketsa nikilia neh ke:meh i:n *cuando** mi:lah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>ka:sá: ika ye:kixwa, *ye:kmohmoradito**, yehwa yo:n telahwiya:k no: n' ia:yo *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>*porque** ye:kxoxok..., *bueno** ye:kkwaltsi:n, ye:ktapala:t ki:sa ne:n ia:yotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Ke:mah, ye:ktapaltik ki:sa n' ia:yotsi:n, entó:s kwaltsi:n ye:kahwiya:k se: kikwa, yehwa yo:n ye:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>yo:n ye:kkwaltsitsi:n mochi:wa ke:meh yo:n mi:lah mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>A:mo, neh i:pa niki:xmati ihtikoyokkilit sah, neh i:pa iwki sah niki:xmati. ke:mah, i:pa iwki n..., ihkó:n nikakini *que** ihtikoyokkilit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>María Salazar Osollo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
