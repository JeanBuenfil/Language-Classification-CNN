        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>No: iwki sah. Wa:n komo no: se: kineki pos yehwa ya n' ke:meh nimitsilia neh mah se:</ANNOTATION_VALUE>
