        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>¿Wa:n i:n no: taa:man tikchihchi:wa?</ANNOTATION_VALUE>
