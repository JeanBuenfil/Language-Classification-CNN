            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Wa:n se: kipanta:lia wa:n, wa:n no: se: kikwa ya pero mah ihsiwka se: kimantiwetsi *porque** ta:mo telpa:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
