                <ANNOTATION_VALUE>Yo:n chawak..., yo:n cha:wakilit yo:n nikchihchi:wa no: *igual**, no: ke:meh tomakilit sah nikmana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
