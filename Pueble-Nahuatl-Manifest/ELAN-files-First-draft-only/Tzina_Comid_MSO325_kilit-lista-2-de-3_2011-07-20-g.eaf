            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Ke:mah, a:mo tatsoyo:n nió:n no: a:ko:loh. A:mo ke:man nikwa neh a:lo:loh *o** tatsoyo:n, nochipa tikchi:wah</ANNOTATION_VALUE>
