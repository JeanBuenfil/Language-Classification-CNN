            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Ke:mah, we:lik ok pero mah se: kki:xtilihtiw n' iteyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>kwaltia no: se:..., wa:n se: kiteki de tein ka:n..., tein yo:n chihchika:wak pos se: kie:ktia ya, se: kie:ktia moka:wa sepa kiltsí:n sah wa:n se: kipi:xowa ya n' ikowyotsi:n.</ANNOTATION_VALUE>
