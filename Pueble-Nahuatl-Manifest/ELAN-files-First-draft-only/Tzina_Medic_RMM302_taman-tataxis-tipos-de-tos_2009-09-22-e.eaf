                <ANNOTATION_VALUE>E:..., ¿tikpia *más** tahto:l o:n de nemowtihli?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts360">
