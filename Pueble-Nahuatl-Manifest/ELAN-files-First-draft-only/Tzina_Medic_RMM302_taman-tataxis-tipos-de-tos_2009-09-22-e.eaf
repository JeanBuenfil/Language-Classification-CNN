        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>Yo:n nochi mochi:wa. Pero yo:n no: taman tataxis, yo:n kiliah,</ANNOTATION_VALUE>
