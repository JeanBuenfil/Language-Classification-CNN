        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Tein ye:ktataxis, yehwa n' tehwa:n tikihtowah ye:ktataxis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>*cuando** yo:n tehwa:n tiowih, tikihtowah tima:palo:tih ne:wí:n, tikawa:ntokeh wa:n timoa:palowah,  yo:n tehwa:n tikihtowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>yo:n se: mop..., se: mo..., mosese:lia, tikih[towah]tehwa:n *mopasmarowa** ne:n</ANNOTATION_VALUE>
