    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="María Salazar Osollo" TIER_ID="María Salazar Osollo">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>Ke:mah, niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>Chiktehmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Yo:n ke:mah. Se:... A:ah, ta: teli:xmikistik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>¿Wa:n, wa:n yo:n tiki:xmattok no: mochi:wa we:i?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Yehwa yo:n chihchi:chi:ltik paxi:i:ni ata. Ne:n i..., iteyotsi:n ya tak no:. Ke:mah, niki:xmattok no: yo:ni wa:n neli n' i...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>n' ixiwyotsi:n no: motkisneki ke:meh yo:n, yo:n kiliah to:to:kowit ixiwyotsi:n, iwki *mero**. Ke:mah. A:mo, ta:... Ke:mah wa:n, wa:n semi no:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>A:mo, yo:n a:mo kwaltia para kalkowit, yo:n i:pa, i:pa para kowtati:l sah pero neli teli:xmikistik, teli:xmikistik, telki:sa miak kownex nikilia neh nejó:n se: kekatia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>A:mo, a:mo wa:n nejó:n wa:n ixiwyotsi:n nikilia neh ata pané: nokta kipia *rayitas** yo:n ixiwyotsi:n wa:n motel..., mo...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Motelmahmaxalowa wa:n seki tein moskaltia pero ye:kwehkapan motami wa:n mochi:wa ye:kwehweikowit ta: *hasta** ihkwi:kwí:n mochi:wa n' tein kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Pos yehwa yo:n a:mo nikmati neh. Pero, pero nimolia *que** a:t ox kwaltia *porque de** ke:meh i:pa ka:n takwa:wakkowit semi yo:n. Ke:mah, *porque**...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>Ke:mah, *pero para más** a:mo *porque** nejó:n neli tel..., telkownexyoh nikilia neh komo se: kitatia. ke:mah, telkownexyoh. ke:mah *porque** nikilia neh, neh niki:..., niki:xmattok. ¿Wa:n yo:n i:pa sentaman sah n' onkak oso no: onkak o:me taman? Neh yehwa yo:n a:mo niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>I:pa no: sentaman sah. Pos neh no: iwki nikita ne: kaltsi:ntan ihkatok, neli i:pa, i:pa mahyá: sentaman sah niki:ita, a:mo ni..., a:mo nikmati ox, ox miak taman onkak, *porque** onkak kowit miak taman. Miah...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Pané: a:mo, a:mo ke:man teh nite:kakilia ox, a:mo..., n..., ke:mah ox kwali se: kikwis pahti, pané: a:mo ke:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Pos a:mo...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>Ke:mah, pero neli kie:kkwah neli ne:n iteyotsi:n ne:n neli nejó:n chiktehtsitsi:n, kati:yeski chiktehtsi:n neh niki:ita. Yo:n kinil..., yo:n seki, yo:n kwitatohtoktsitsi:n kiliah ata no: kie:kkwah. Tak iwki *porque** neli nejó:n ye:kxi:i:ni kwaltsi:n *cuando** yo:n pe:wa xo:chiowa nikilia neh ye:ktepe:wi n' ixo:chio. ke:mah wa:n tel..., wa:n motelchi:wa n' ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>Yo:n, ke:mah, yo:n telxo:chiowa nikilia neh, tel..., tel... Ke:mah, telmiak nikilia neh xo:chiowa wa:n neli nejó:n, neli motami we:ikowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Ke:mah, pero neli ne: nejó:n, neli nik...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Ima:xiwyotsi:n neli kwaltsi:n ihkó:n nejó:n mahyá: we:weyakaxtik neli. Mahsi neli ne: yo:n to:to:kowit ixiwyotsi:n pero a:mo yehwa, ta: pos a:mo yehwa, ta: yeh no: taman, pero i:n yehwa neli ne:n tein kilwiah wa:wkowit, yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>Pos tak a:mo teh pahti *porque** ka:n ke:man teh se: te:kakilia ox, ox nejó:n se: kikwi pahti, ta: tein onkak no: pahti nikilia neh pos i:pa se: te:kakilia:ni *que** kwaltia para pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah, pos a:mo, a:mo se: kimati ox kwaltia yo:ni, pero neli niki:xmattok no:. Pos pané: yehwa sah i:n tein</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>tine:chtapowih, pos nejó:n a:mo, a:mo teihsá: *más**, miak tasohka:matik tein tine:chilwih wa:n neh tein nimitsilwih. Neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts150">
