    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Andrés Martín Juárez" TIER_ID="Andrés Martín Juárez">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>*Bueno**. Entó:s sepa name:chili:ti ke:ní:w ne:n wehka:wta:tahmeh mo..., yehwa:n *moservi:rowa:yah**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>wa:n a:m..., *cuando** yehwa:n nemiah wa:n no: tikitakeh ok seki wa:n no: tikpano:keh ok nohjó:n ke:ní:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>*Este**, ihwak pos pe:wak tikitah i:xpoliwtiwi:ts a ke:meh i:n itech i:n xiwit *de año setenta**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>*todavia** ne:si a ok wa:n ka:sá: ne:sis ok pero, a:mo, a:mo miak ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>Ihwa:k, *este**, tiahsiah, timokalpanowa:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>wa:n te:chna:nkilia:yah, te:chilia:yah [mah]tikalakika:n, [mah]timose:wi:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>Pero niman kiwa:lkwitih, [mah]timota:li:ka:n itech yo:n kil..., kito:ka:itiah oh..., ohtakaba:yoh, ohtakaba:yoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Wa:n ompa yo:n *pues** komo ke a:mo, tikiniliah pi:pil ekintsi:n pané: kimana:lmatih, komo ke a:mo kineltokah ok, kihtowah ke toni nikilwihtos kownalwat, ka:n kwaltsi:n. Pero ihwa:k ta:tahmeh nochi iwki mowi:kayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Nikitaya ihkó:n kininsentilia:yah miak, ika to:nal a nohjó:n kichkwayah wa:n kiki:xtia:yah nohjó:n ohtat ka:mpa onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>seki chihchikwase:n imets, seki nahna:wi, seki mahma:kwi:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>kwaltsi:n kichihch..., kichihchi:wah, kim..., kimanisti[li]ah seko wa:n seko no: wa:n kalaxowah nochi nalwat tein wehwei nalwat kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>Wa:n komo ke no: imets a, yehwa yo:n *cuando** se: kinkalpanowa:ya pos yehwa kwa:lkwitih. Ximota:li.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Wa:n komo se:, teisá: nechiko:l kichi:wah pos nochi yehwa itech timota:li:skeh koma:mo kichihchi:waskeh se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>no: *banco** ya, no: tikihtowa:yah telkwali *banco** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Se: de xo:no:kwowit, we:i ihkó:n kit..., kitehtekih, kwaltsi:n kixihxi:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>wa:n kimehmetstiah. Wa:n koma:mo kitapechtia ika tet para ke:meh se: mota:li:s sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Yehwa nohjó:n kikwiah. *Después** pos tikitah miak poliwtiw a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>*porque** ke:yeh, *este**, a:mo kwelitah ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Teisá: nechiko:l kichi:wayah ihkó:n teisá: *compromiso** nochi yehwa t..., itech timota:lia:yah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>na:nahmeh pos ihkó:n, ihkó:n nochi yehwa itech mota:lia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>wa:n *cuando** ihkó:n te:chilia:yah mah tikwa:ka:n se: taxkaltsi:n pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>timota:li..., titakwah ya pero a:mo te:chkechili:ki:wih *mesa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Ihkó:n ta:li:xko tiketsaskeh to..., tokaxtsi:n, tikiliah *mexicano** kaxit, ekintsi:n tikiliah *plato**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Pero a:mo ke:meh ekintsi:n onkak miak taman *plato**, ihwa:k 'kwiah sokikaxit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Sokikaxtsi:n, ompa ne: titakwah ya, ta:lpan wa:n ihkó:n ya *hasta** tixwih. Tasohka:matih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Wa:n iwki a sepa taololowah na:nahmeh wa:n se:, ma:s[ki]se: ta:tahtsi:n wa:n sepa ihkó:n timota:liah itech nehjó:n ohtakaba:yoh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>wa:n oksentaman, *este**, chi:kikiskowba:nkoh kichihchi:wayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>wa:n xo:no:kowba:nkoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Kitekiah de i:n *tanto** de we:i koma:mo kikwadra:dohxi:mayah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>sentapal wa:n sentapal no:, e:yi, e:yi *parte** wa:n tatampa kichkwayah *como ke cajón**, kitapachowa:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>wa:n kita:[li]lia:yah ima:y komo ke, kikwiah ihk..., ihkó:n wa:n ximota:li itech, ta:li:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Ihkó:n no: kichihchi:wayah de n' xo:no:kowit wa:n ihkó:n no: kichihchi:wayah de ne:n chi:kikis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Ke:mah, ihko:ni. Wa:n nikitak ok no: wa:n no: itech nimota:lih ok yo:n ohtakaba:yoh wa:n yo:n kow..., kowba:nkoh, kowba:nkoh tikilwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Pero se: *señora** nika:n nemia, nika:wí:n por talwiah Taxayakatitan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Yehwa kikwia *banco, legítimo** tet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>Se: *tiempo, este**, xa: nankimatih a nohjó:n nemiah, *este**, tikilwia:yah tapahwia:nih de n' kalmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>*Este**, nemiah wa:n neli ke:meh aya:mo timoi:xmatiah tehwa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>wi:tseh okseki:n de wehka tikimo..., seki tikimowil..., tikimowiliah *o** timoitayahne: tsahtsitiw, cho:ka, kinimowilia koyo:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>ke te:kwa:tih, *o** te:wi:katih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Pos kiniwi:katinemiah, ihwa:k *nohermano** katka, *este**, kihtowah ox, kihtowa ke to:pi:leh katka de nika:n Presidencia San Miguel,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>*porque** ihwa:k onkayah nohjó:n nochi, a:xka:n nochi koto:nik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Entó:s, *este**, kineka:ntinemiah para matiskeh. Ahsikeh ompa, tano:tsatoh, kina:nkilihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Kiniliah ox taki:xtihkeh ya *inincosas** nochi para tapahwi:tih *porque** yehwa:n a:mo kipahwi:skeh tein *lo que es** se: kikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Se: ia:ya:tsi:n *o** kochpetat *porque** ihwa:k tikwiah kochpetat, de owapach, de owat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>a:mo tikwiah *cama o tabla**, a:mo, a:mo tik..., a:mo tiki:xmatiah yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Entó:s, *este**, kilwihkeh ke ke:mah, titaki:xtihkeh ya, nehyó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>tein *lo que es** kowit kit kiliahtikpahwi:tih, ke ompa mokalakiah okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>We:noh. Entó:s ne: pe:wak tapahwiah ya, *nohermano** ompa ne: kinitstok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Entó:s nochi kipahwihkeh kali ihkó:n, nochi ke:meh etok taihtik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>wa:n pe:wak kitsi:ntokiliah ya ne:n *ibanco**. "Mah tik..., mah tik..., mah tikpahwi:ka:n *porque** kikwis okwilimeh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>"¡Ay dios!, ta:tameh", kilia, "neh a:mo teh noba:nkoh". "¿Pos mobanco**?" "Yo:n yetokeh, *puro** tet."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>*Nohermano** kitato *puro tet** kihtowa "komo de a *veinte, de a cuarenta kilos** ihkó:n tekpa:ntok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>sa ahalaxtsitsi:n no: kihtowa, "Pos tak *tiempo** ya itech mota:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Pos nohjó:n *señores**, kihtowa, kahwate:wkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Kiliah, "A:mo, a:mo i:pa a:mo tiweli sake:ra de kowit xi..., mah kixihxi:ma *moseñor**", kit kiliah, "tet tikwi *o** tikxi:kowa tikahchi:wtinemi".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>"Wa:n a:mo *tanto más** xine:chnohno:tstoka:n", kit kilia, "nane:chkwala:ntiah", kit kinilia, yo:n *señora**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>"Neh name:chilwih ya ke yehwa neh *nobanco**, ta: *nipobre** ka:n nikpia para nikpias kwali kowba:nkoh."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Pos iwki yahke nohjó:n tapahwia:nih. *Nohermano** kwali kitato.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Ihkó:n nohjó:n, kikwiah tet wa:n yehwa name:chilia xo:no:kowba:nkoh wa:n de n' chi:kikis wa:n de n' ohtat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>*Después** pe:wak ne:si a ne:n *banco** de nehjó:n tikiliah *silla** de kowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>*o** ihkó:n, seki pe:wak kichih..., mochihchi:wiliah ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>de ke, mah ki..., *tabla** kitehtekih ma:ski *tablita, hasta** a:xka:n *más** mopatak a. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Nohjó:n poliwik a yo:n, a:mo kanah ok. Ka:sá: a:chá: yetos ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Wa:n nochi n' kali pos, kitsi:ntsakwayah ika kowtsitsi:n, ika ke:meh ne: ohtat tikiliah, taxahxama:ni:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>Wa:n takalte:ntsakwayah, *este**, soh kikwa:kahkalakia:yah sah ka:n mo..., teh..., *candado o**, kilpi:skeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>*porque** a:mo tachtekiayah tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Pero a:xka:n mah nitaka:wte:wa soh nikwa:kahkalakihte:wa ke:meh weli a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>pos nikahsiki:w kali pero tein yetos kalihtik a:mo nochi nikahsiki:w ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Niman kiki:xti:skeh seki:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>*porque** ihwa:k a:mo, a:mo *malos** katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Ke:mah, nochi yehwa yo:n kikwiah ta..., kalte:ntsakwil, xo:no:kowtsi:n kixihxi:mayah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>*o** yehwa chi:kikis *o** yehwa n' ohtat, kikwa:kahkalakia:yah sah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>wa:n kihilpi:skeh ika komekat *o** ika xo:no:t wa:n iwki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>Wa:n ne:n tapayo:t kita:lia:yah pos ne:, a:mo ke:meh a:xka:n tiki..., tikwih ka:sá: ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>kowtasierrahwi:l, ta: ihwa:k kikwiah yehwa nochi ta:rroh kixahxama:nia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Ihkó:n kita:lia:yah para ompa tata:lia:yah *incositas** ahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>Ke:mah, mowi..., mowi:katia:yah *deve..., deve..., deveras de pobres**. Ke:mah. A:xka:n a:mo ok, poliwik a yo:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>Pero neli pos a:mo *mose:guiroh**, tikitah neli tite:ch..., ihkó:n ka:mpa titekitiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>te:chwi:kilia:yah yehwa nehjó:n *atolito** wa:n koma:mo ahsi *platito** pos titakwa:yah ika pahpataxo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Ta:li:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Tikte:mowa:yah wa:n iwki titakwa:yah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>A:xka:n a:mo ok. Nochi koto:nik yo:n wa:n poliwik pero pos tein t'mattokeh, t'mattokeh ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Mm, ke:ní:w titahyowihkeh, ke:ní:w tipano:keh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Tein te:ch..., te:chne:xtilia:yah tote:iskaltihka:wa:n, mm, ihkó:n yehwa nohjó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Wa:n de ne:n okseki de n' nan..., nan..., nankihtowa:yah de n' wito:n pos yeh, yo:n o:me taman no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>Pos ika taya:yah ne:, komo *atolito o** ne:, *este, cafecito** pos ihwa:k nochi kitekiti:ltia:yah *panela** nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>yehwa ne:n onkayah seki *tazahmeh** de sokit no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>seki ihko:ko:n kilia:yah, no: kilia:yah chi:nahta:sah de sokit, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Koma:mo yo:n *jarritos** onkakeh ok, yehwa ika mitswa:ntiskeh wa:n ihkó:n *porque** nochi ihkó:n se: mowi:ka a:mo, a:mo sayoh se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>Por eso ka:sá: ihkó:n nikita ok tinemih wa:n te:chwa:ntih teisá: ika pos a:mo wel se: kinehnemilia *porque** yo:n de n' *antigua**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>Ke:mah, *todavia ki..., kisegui:rowah** ok ka:sá: pero a:mo miak ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>A:mo ok, semi o:me e:yi:n ya sah. Ke:mah, yehwa nohjó:n tikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>Wa:n no: kiwi:kayah tapalo:ltsi:n pero ika ko:mit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>Se: ko:mit, koma:mo kikowayah tein ma:yeh ya, kikwa:ytia:yah ika xo:no:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Wa:n kwi:kah ya na:nahmeh. A:mo ke:meh a:xka:n n' kwi:kah *olla** de tepos, te:ntsaktok kwali,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>*o** kwi:kah *cucharas** de tepos. A:mo, ihwa:k a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Ko:ntsi:n, tama:mah wa:n kitkih ne: ka:mpa, ka:mpa ne: se: tekitis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Semi no: se: kwi:kas, se: no: kwi:kas taxkal komo se: miakeh, se: n' tapalo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Ke:mah, ihko:ni, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Yehwa yo:n nochi ika te:ch..., techne:xtilihkeh pos tein tikmattokeh a:mo tikelka:wah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Ompa titakwa:yah kowtah wa:n pos komo tikele:wia:yah a:tsi:n pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>komo onkak ne:n a:me:yala:ttikiliah pos yeh titayih wa:n koma:mo a:ichkwala:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>ma:ski ka:mpa tayih kwa:kwemeh tikwitih wa:n titayih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>*Por eso** a:xka:n kihtowah seki nikaki, mitschi:wili:s *mal**, a:mo xitayi pero pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>se:, ekintsi:n se: *tiempo** tietokeh *más** takokolisti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>*Porque** a:mo tikitah *tiempo** ke:ní:w wa:lahtok, de n' ahko, xa: wetstok kokolis itech n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>*Por eso** titayih ya nochi achi chipa:wak a, koma:mo tamolo:nti:l, pero se: *tiempo**, ihkó:n nohjó:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Pos kwi:kayah pero a:mo teposkucha:rah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>Kowkucha:rah, ke:mah, ika kowkucha:rah. Ke:mah, ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>Kite:kayah ika kowkucha:rah, onakakeh ok a:xka:n nohma, nohjó:n xa: nankitah no:, kowkucha:rah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>yehwa ika kite:kayah n' tapalo:l pero de tepos a:mo. A:mo tiki:xmatiah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>Kahfe:ntsi:n *lo mismo** ki..., *como siempre** nohjó:n xi:wah de xi:kal, kikwih ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Onkakeh ok. Pero para nikihto:s *este** tepos a:mo teh ne:sia, ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>*Pues** pos ihwa:k, *este**, pos ekintsi:n tein a:mo tikwih ok pos miak taman i:xpoliw a tein ihwa:k kikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>*Porque** ihwa:k nochi ika tamolo:ntia:yah na:nahmeh *puro** ko:mit, *puro cazuela**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>Wa:n tiko:mit pos a:mo kikwiah ke:meh a:xka:n nohjó:n kininamakah, de yo:n de *varilla**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>kite:mowah e:yi tet, koma:mo xa:ltet, texkaltet tein a:mo tapa:nis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Wa:n ompa ne: tachkwayah tepisti:n wa:n kipalankia:yah se: ko:ntsi:n para ka:mpa mochi:was n' kownex wa:n tekol para taxo:taltia:yah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>Ihkó:n nohjó:n kichi:wayah, ke:mah. Wa:n a:mo kikwiah a:xka:n nochi ne:si koma:l de tepos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>ta: kikwiah *puro** de sokit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Wa:n ompa ne: pos kokxitiah ya n' taxkaltsi:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>pos a:mo kix:matiah *molino** ke:meh a:xka:n *molino de motor o molino de mano**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>*Tal vez** i:pa onkaya pero oksé: *lado**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Neh nikitaya *nomomacita** katka, *este**, kipaya:naya nextamal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>kiketsaya ne:n tao:l, oksi, nikita kipante:milia:ya ne:n tenexa:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>kimolo:ntia *hasta** ahsi *punto**, 'ki:xtia, kichia se:wi wa:n mo:stika *o**, mo:stika kikwi a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>*porque** a:mo wel kikwih toto:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>Pero *cuando** tisia pos a:mo ke:man kitalo:xti:ti*molino o este** ki..., kipante:ntok itech *molino de mano** tein tikpa:palakacho:skeh ika toma:y. Aya:mo onkaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Pos tak onkaya pero a:mo x'matika:ni. Ompa ne: kite:maya metat i:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>Ke:ke:ski, Ke:ke:ski,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>Kipaya:na wa:n ke:mah ompa ne: *cerca** kita:lia tiko:mit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>ompa kita:lih se: taxkaltsi:n pero ya: name:chilia, *este**, a:mo, a:mo ke:meh a:xka:n, ta:li:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Kichih..., semi kipiayah se: tankwa:pech ihko:ntsi:n kichihchi:wayah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>para ompa motankwa:ketsayah wa:n tisiah ya, ta:li:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Ompa nikitaya tisia nom..., noma:ntsi:n katka wa:n kita:lia:ya taxkal *hasta, hasta** nochi tein ke:meh te:chahsia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>Ke:mah, *te:cha:tende:rowa** kimanaya ne:n tap..., teisá: tapalo:ltsi:n tein, ihkó:n kiltsi:n *o** emoltsi:n *o** pio:tetsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Wa:n te:chtamakaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Tiowih ya kowtah komo tiowih kowtah, komo *escuela** pos neh niwi:tsa ya *escuela**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>nitakwah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Ke:mah pero a:xka:n a:mo ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Yo:n ihwa:k nochi yehwa ki:xmatiah ihkó:n moi:xmattoyah na:nahmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>A:mo, a:mo kisakayah, *este**, n' a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>nehyó:n ika, ke:meh ekintsi:n ehko sah kalihtik, tikpiah *llave**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Kisakayah pero pos ika tso:tsokol</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>ke a:xka:n name..., name::chilwih, *este**, a:mo a:me:yal, a:ichkwala:t kikwitih wa:n kisentiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>wa:n no: kisentiliah a:mo ke:meh a:man nohjó:n te:ch..., te:chtekiwihtinemih tokni:wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>ma:ski *hasta** te:chkwe:ntahtiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>Ihwa:k kikwiah mono:tsa ahpa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>Se: we:i ihkó:n, nikita ka:sá: kipiah ok, ke:wtokeh ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>Ompa kipante:kayah n' a:t, kipexo:ntiah, yetok a inina:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>Wa:n kisakayah nohjó:n ika tso:tsokol no: nohne:l nohjó:n, no: iwki ihkó:n *tamaño** pero yeh nohne:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>Wa:n kite:ntsakwayah ika to:tomo:ch, kisentilia:yah wa:n kitili:ntiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>wa:n soh mowita:tsowilia:yah, kima:ma:yah ya. 'kwiti n' a:t, kisakah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Ihkó:n nohjó:n kisentilia:yah wa:n komo kima:wila:na pos yehwa no: name:chilia ika se: ko:ntsi:n tein ma:yeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>A:mo moi:xmatia tepos, *plástico**, a:mo tiki:xmatiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>Nehjí:n *plástico** ne:sik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>aya:mo wehka:w, nikmattok a no: pe:wak ne:si.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Nochi nohjó:n ika se: motsakwa *naylon**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Yo:n a:mo onkaya, ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>Nochi titekitiah, timotsakwayah ika kekexikilit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>*o** pahpataiswat wa:n ihkó:n tipanowa:yah, ke:mah. Nikmattok nohjó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>kwali yetok. *Pues** nomoma:ntsi:n katka *pues** kwalka:n me:waya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>te:chtixilia:ya, te:chkahfe:mania:ya, te:chtapalo:lchi:wia:ya wa:n titakwa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>Wa:n tehwa:n komo tinoh..., ik..., *cuando** tinohne:lmeh katka pos ompa ne: tima:wiltihtokeh *o** te:chahwaya *porque** ne: ke:man semi te:ahwayah *o** te:chkwetaxwia:yah pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>pos a:mo no: te:kwetaxwiah pero mah se: kikaki toni te:ilwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>A:mo no: te:chma:ya ok, *lo primero** ke:mah, a:mo, a:mo se: ye:ktakaki pos i:pa ihkó:n ya para se: *kirespeta:ro:s** se: ite:iskaltihka:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>*Siempre** mah te:kwetaxwi a. Pero a:xka:n a:mo onkak tanawati:l ok yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>Te:chahwaya, te:chilia:ya, "Yehwa ne:, yehwa ne: x'chi:watih!" Ke:meh nopopa:sitoh no: nemia ok, katka ninohne:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>Teh ne:pa xitame:wati wa:n se: i:n mah kisa:saka kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>Wa:n xietoka:n wa:n koma:mo nankichi:wah a:mo nantakwa:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>Ihkó:n te:chilwia:yah. *Todavia** nomomá:n de tamitisi a no:, nochi t..., tapahpa:ka ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>Koma:mo ta..., kipihpixkas sinti, tao:yas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>*o** tapa:kas, *o**nexketsas**, tachpa:nas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>*o** kihtsomas totilmahtsi:n *o** nopopá:n katka itilmah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>*hasta* tayowas *o** nepantah pos sepa te:ch..., komo yetok taxkaltsi:n nepantah sepa te:chilwi:s, "Nantakwa:skeh nopiliwa:n, name:chtoto:nili n' taxkal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>Soh a:mo teh tapalo:l, name:chixkili se: pio:tet *o** name:chmo:ltili chili:toh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>Pos tamela:wa chi:l te:chmo:ltilia:ya, *líquido, verde**, chi:l, chi:l, chi:ltekpin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Tikwa:yah, tikahakia:yah, a:mo no: tie:ktakwa:yah pos koko:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>Timowetskilia:yah ti:kni:meh pos timi:i:xitah, a:mo teh tapalo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>Tikwa:yah ke:meh weli wa:n topopá:n pos te:chitstok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts401">
                <ANNOTATION_VALUE>Tite:ntamih sepa te:chilia, "Yehwa i:n, x'chi:watih". *Hasta** tio:tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>Te:chilia:ya toni tikchi:waskeh, tikchi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Wa:n ne:n tomomá:n sepa mo..., kichi:wtok yeh toni ne: kipolowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>Komo kipolowa ok tachpa:nas *o** tao:yas pos yehwa kichi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>*O** tapa:kas, kichi:wa ok *hasta** tio:tak. Koma:mo teh ia:w, pos kisakas ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>para kikwis n' okyowatika kwalka:n, a:mo s...kisakatiá:s wa:n kikwitiá:s. Ke:mah ihkó:n nohjó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>Semi owih nohjó:n mopano:ltia:yah *porque**, a:mo ke iwki a:xka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>A:xka:n a:mo, a:xka:n komo tiknekih, *este**, teisá: pos nochi, nochi ihsiwka, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts423">
                <ANNOTATION_VALUE>Ihwa:k itech kochiah owapach nochi, owapach. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts425">
                <ANNOTATION_VALUE>Ki..., ki..., kix..., kiki:xtihtia:yah no: ne: ka:mpa n..., tita..., 'tapa:tskayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts427">
                <ANNOTATION_VALUE>*bueno** ne:h semi, semi ni:xpeta:n i:pa tapa:tskah pero ke:meh ninohne:l aya:mo nikimpale:wia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Ne:ch..., ne:n nimos..., tepitsi:n niwe:yak de *ocho años** pe:wa nikimpale:wia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Nikitaya kiki:xtia:yah para n' itech kochiah, no: kiki:xtiah tein mehmela:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>tein a:mo kohkotoltik *porque** a:mo kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>Tein kohkotoltik a:mo kwaltia, para tatas, para *gasto**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>Pero tein yo:n kiki:xtiah ya para ininkochpet *aparte** kixelowa:yah, ke:mah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>kiwi..., kiwi:pa:nayah ika xo:no:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>Yehwa yo:ni. Wa:n *cuando** kochiah pos tikochiah ya te:..., te:chchihchi:wilia:yah sehsé:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>Timotasowiah ya ta:li:xko wa:n tikochih ya wa:n yehwa:n no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>Ti..., time:wah, sepa tikehe:wah yo:n tokochpetaw, sepa seko tiketsah, mo:stah, mo:stah ihkó:n, mo:stah ihkó:n, mo:stah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>A:mo ke:meh a:xka:n tikpiah *cama o** a:mo pero *fuerza** tikochpa:naskehmo:stika de time:waskeh s..., tikchipa:wah *o, o** tikpatah de *una vez**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>*porque, este**, tikihtowah ke:meh te:chiliah tokni:wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>se: mokokolismaka *o** okwilimeh mota:liah, wa:n *deveras** mah wehka:wa mota:lis:keh okwilimeh, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>Ihkó:n nohjó:n t'chi:wayah kisentilia:yah n' owapach</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>para kochpetat, xo:no:t kehke:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>Iwa:n ya *servirowa:ya** para *panela**, ompa kikwiah ya, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>Ihkó:n nochi:ntekitiah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>*Pues**, nohjó:n kochpetat itech mokalakiah nohjó:n kiliah tepechokwilimeh *o** chi:nkismeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>*o** xopepemeh, *porque** ke:yeh pos koma:mo tikpatak niman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>Mahyá: tamantia, de pala:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>Kikwi n' *polvo** wa:n a:mo, pos ke:ní:w tiki:xtili:ti ihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>Ika nohjó:n monechikowa:yah ompa ya nohjó:n okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Ke:mah, *por eso** kihtowa:yah achto telnemih tepecholuilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>Telnemih chi:nkismeh pero tehwa:n, tehwa:n t[i]mochi:wilia:yah *porque** no:hjó:n itech e:wiah nohjó:n, nehjó:n mahyá: tahsol owapach, ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>Ke:mah yehwa nohjó:n okwilimeh mosentilia:yah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>*Porque** ta:li:xko mochi:wayah wa:n pos a:mo poliwiah. Pero a:xka:n a:mo teh tikitah ok, ke:mah, ihkó:n nohjo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>*Pues**, pos ke:mah ki..., ki..., pos na:nahmeh yehwa ne:n kikwiah ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>ke:meh name:chilih ya metat nochi tiko:met, nochi name:chilih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>Nochi tapalkat kikwiah de sokit, a:mo teh ke:ní:w wa:n ne:n tapa:kayah *sólo** yehwa poliwi pos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>Neh nikitaya ompa ne:wí:n ka:mpa nita:ltikpaktik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>wa:n nikaki molwiah oksekin na:nahmeh, tapa:kayah a:mo kikwiah xapoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>Nikitak se: na:nahtsi:n ke:meh ka:n, ke:meh se: mahtakti *viaje**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>kitekte:wa chokonihxiwitwa:n yowi tapa:kati a:taw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>A:taw, a:mo ke:meh a:xka:ntsi:n ne: kalte:noh tikta:liah ne:n tap..., tapa:kalo:ni, kwaltsi:n titachihchi:wah, ma:ski s..., tikihtowah *sencillo** pero t'sa:lowah sake:ra tet, ompa tikta:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>Wa:n ihwa:k a:mo, kiwi:kah n' tilmah a:taw wa:n kitekte:wah i:n kiliah chokonihxiwit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>wa:n tapa:katih ya. A:mo 'kwiah xapoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>Wa:n xapoh onkaya no: pero kil..., kilwia:yah kostik xapoh kiliayah takwa:wak xapoh, nikakia moi..., ki..., kito:ka:itia:yah wa:n yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>sayoh yehwa, a:mo teh onkaya *más** xapoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts518" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>*Porque** a:mo t'matih ka:ni i:n xapoh *más** kichi..., kichi:wkeh *más** kinkwik talna:miki:lis para *más** miak taman ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>Ke:meh a:xka:n pos kihtowah seki tapati:yoh pos a:mo titahyowiah *porque** miak taman onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>A:mo tikowaskeh *solamente** a:mo 'tamahxiti:skeh pero komo tikahxitiah *tocentavos** tikihtowah nikowati ne: wa:n nikwis yeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts525">
                <ANNOTATION_VALUE>Pos tikpiah ya, pero ihwa:k semi tahyowihkeh, neh nikitak ok ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>nikitak ok na:nahmeh, ihkó:n, no: kikwik ok nomoma:ntsi:n katka nohjó:n chokonihxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>Wa:n chipa:wayaya tilmah, a:it ke:ní:w kichi:wayah, ke:mah, yehwa yo:n nikitak nehwa, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>¿Ika ne: taneltokalis? Ke:mah, tein i:pa de tachihchi:wayah pos *más** miakeh katka pané:, a:xka:ntsi:n pané: a:mo ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>Pos neh, neh i:pa, i:pa *completamente** i:pa titachihchi:wah de ni:xpeta:ntok kalihtik *hasta** a:man *tiksegui:rowah hasta** nopi:pilwa:n a:mo tika:wah yo:n, yo:n taneltokalis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>ma:ski a:mo *seguido** 'tachihchi:wah, sake:ra *quince dias** pero tikpatatiowih n' xo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>Kitah tachihchi:wayah wa:n nemiah tokni:wan yo:n te:kahkaya:wah ki..., se: *vez** kikahkaya:wkah nopopasitoh katka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts545">
                <ANNOTATION_VALUE>wa:n yahka ne: se: ta:tahtsi:n de nika:n San Miguel, ya:ya, pe:wak ya:yawi, katka ni..., katka ninohne:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>Nikita yowi ompa mota:li:tih *tale:rohtokeh** wa:n ne:chilia ne:n noma:ntsi:n katka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts548" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>de ya:yah ya wa:n ne: nopopá:n seko mota:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts551">
                <ANNOTATION_VALUE>Ne: mopopá:n *loco**, ne: a:mo tamati ke:yeh, ke:yeh momá:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts552" TIME_SLOT_REF2="ts553">
                <ANNOTATION_VALUE>pos ne: kikahkaya:wah mah nehyó:n *desmático** mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts555">
                <ANNOTATION_VALUE>Wa:n ne: *isantitos** kinkalampi:xo:s kihtowa. Nochi te:chilia:ya tikni:meh, ki..., ti..., tietoyah nochi tikni:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts556" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>E:, pe:wak kisenkwiah ya, kilia:yah ne: tein tamattokeh nokni:wa:n "¿Pa:, neli timochi:wati tidesmático"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>"A:mo xine:chnohno:tstoka:n, name:chkwetaxwi:s". Ke:mah. Entó:s yo:n *señor** kikaya:waya kit ke</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>mah mokalaki yo:n oksé: taneltokalis *porque** a:mo ke:man, a:mo ke:man i:xpoliwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>Mikis wa:n nochi pero e:yi to:nal de *sepul, kisepulta:ro:skeh** wa:n sepa wa:la:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>Mah a:mo *kisegui:ro** ke:meh ne: yo:n kitokatok, *porque** ka:mpa yo:n yetok mikis a:mo ke:man wa:la:s ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts568" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>Mah ki..., mah, mah kininkwi yo:n todio:smeh, yo:n a:mo todio:smeh, ta: *retratos** sah, *muñecos**, mah kinolo:chte:ma seko sah wa:n mah kinte:kili *gas** wa:n mah kintikwi:lti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>Wa:n kinkaktoya *nomomasitah** katka, ye:kkwala:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>Entó:s se: *vez** yahki no:pá:n, yo:n kinkwi:lih n' a:mat, wehka:wak a ya:yahtoyah *des..., después** kinkwi:lih se: *libro** i:n *tanto**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts576" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>wa:n semi kipihpi..., kipihpiak tak nomomasitah katka ka:ni ke:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Yahki ne: no:pá:n katka a:it ka:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>Kikwik nohjó:n *libro** no:má:n katka wa:n kitatahkotikota:lih, tatak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>Ehkok nopopasitoh katka a:mo niman kitak, ekok kitamakak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>Pero *cuando** kinemilih kite:mo:ti a wa:n tak kitaskia pero sayoh *a lo tonto** kitaskia, ka:n tai:xmatia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts586" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>*porque antes** ta:tahmeh a:mo tai:xmatiah *hasta** ekintsi:n seki:n nemih ok *hasta** na:nahmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>Pero pos a:mo mah, mah tikinma:lihto:ka:n *porque** ke:yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>*fuerte** yetoya de tanawati:l de to:te:iskaltihka:wa:n, a:mo kinekiah mah timomachti:ka:n *porque** kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>"Timomachti:ti, ta: xiow xitekititi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>*Todavia** mitskwetaxwi:skeh ok".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>Tika:wah nemachti:l, titekititih pos ta: te:chkwetaxwia to:pá:n *o** to:má:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>pero yehwa:n a:mo ki:xmatih se: *letra**, ika nohjó:n, *este**, miak ihkó:n ok. A:mo kimatih, a:mo kimatih *tofirma**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Teisá: tikihkwilo:skeh *o** se: *cuentas** ke:meh i:n tikihtowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Te:chkahkaya:waskeh koyo:meh, teisá: tikowaskeh *o** teisá: t'namakaskeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>*[por]que** a:mo wel tikchi:wa *cuenta**, tikihkwilo:s *o, este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts609">
                <ANNOTATION_VALUE>tein se: kimati, seki se: itech se: iyo:lo se: kimattok a ne: ka:nachi ne:chmakati *novuelto o** ka:nachi ne:chmakati notomi:n tein n'namaki:ltih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>A:mo moneki *lápiz**, se: kimattok a. Entó:s ne:, ehkok *después** ka..., ki:xahsik a ne: kite:mowa ya, ¿A:koni kitamo:t *nolibro**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>Pe:wak tsahtsi, ne:, ¿"A:koni kitamo:t nolibro"?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts615">
                <ANNOTATION_VALUE>"A:mo n'mati. ¿Ox ne: tikpia *libro**"? "Ta: nika:n n'ta:lihka nehjó:n ne:chka:wilihtiki:skeh yo:n ta:tahmeh". "A:mo n'mati neh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>"A:mo ta: nankitamo:tkeh". Pe:wak kinahwah nokni:wan tein ne:cheka:nayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts619">
                <ANNOTATION_VALUE>Se: ne: ke:man ya mo..., o:me:n ne: ke:man ya momikilihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts621">
                <ANNOTATION_VALUE>Pos pe:wak mihi:xitah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts623">
                <ANNOTATION_VALUE>Pos nikita kikwito ne: *cubierta** ne:n no:pá:n katka wa:n pe:wak kimá: no:má:n katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts624" TIME_SLOT_REF2="ts625">
                <ANNOTATION_VALUE>Tsikwi:nih nokni:wa:n i:pa wehwei:n ya, o:men, kinki:tskihkeh n' impopá:n. A:mo kika:wkeh, neh pe:wak nikowtsahtsi pos ninohne:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts627">
                <ANNOTATION_VALUE>Nikmowilih. Entó:s ne: kit..., ki..., kitaka:waltihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts629">
                <ANNOTATION_VALUE>"Entó:s" kilia "naniwa:ntitokeh sah namo:má:n, namehwa:n nankitamo:tkeh yo:n *libro** tein ne:chakakah ne: tokni:wa:n".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts631">
                <ANNOTATION_VALUE>"Tehwa:n a:mo tikmatih wa:n komo tikneki tikmatis timitsma:skeh ya".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>Pos iwki moka:w. A:mo sepa, tak, tak kinyo:lohpachoh, ke:ní:w yo:n, a:it ka:ni iniwa:n moahsik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts635">
                <ANNOTATION_VALUE>A:mo sepa yahkeh ok yo:n tokni:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts636" TIME_SLOT_REF2="ts637">
                <ANNOTATION_VALUE>Pos pe:wak *kisegui:rowa** ya ne: sepa pe:wak tachihchi:wtiw, tachihchi:wtiw, te:chne:xtilih nochi ke:ní:w tikitayah, ke:ní:w *hasta** iwki *t'segui:rohkeh** tehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts639">
                <ANNOTATION_VALUE>Pero neli yo:n tokni:wa:n para te:yo:lkehkepaskeh, te:tanehnektiah, kihtowah ke a:mo moneki se: tekitis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>ehko sah tomi:n, ke mosentilia sah tomi:n, ke a:mo .... Mah a:mo se: kineltoka tein se: ya..., se: ki..., se: kitokatok se: itaneltokalis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>Wa:n a:mo ke:man te:kwis kokolis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts647">
                <ANNOTATION_VALUE>*porque mismo** dios te:ahchi:wili:s, [...]pos yo:n tak, ke:mah neli tak, te:ahchi:wili:stodios, neli ke:mah nikneltoka pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>komo tehwa:n no: tik..., timoki:tskiah iwa:n, yo:n a:mo moneki te:ilwi:skeh yehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts650" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>Pero de se: mikis, a:mo, a:mo neli kihtowah, timikis wa:n e:yi to:nal tiwi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts653">
                <ANNOTATION_VALUE>Yo:n i:pa te:chte:moliah se: *trampa** sah, no: kinekih *inigente** mah kipiaka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>Ke:mah, pero komo se: *kienten...,** se: kikakik pos se: kintohtokas wa:n koma:mo a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>*A la fuerza** a:mo, *tiksegui:rowah** ka:mpa tooh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>*Porque** a:mo a:kin kimati *mero** ka:nika *mero** kwali, ka:nika kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>*Además** ta:ltikpak nochi *tiiguales** sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>wa:n todios**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>se: n' ta:ltikpak, se: n' ahko, *iguales** sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>Nochi te:chistokeh ke:ní:w, toni tikchi:wtokeh, toni mochi:w..., toni kwali, toni ka:n kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>Wa:n tehwa:n *mismo** tita:ltikpakcristianos** timokahkaya:waskeh, pos a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts671">
                <ANNOTATION_VALUE>Yo:nkes a:mo, kinineltokilia tein, tein tak semi *tonto** pero pos tehwa:n tikitah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>*Porque** ne:pa ka:mpa ne: nita:ltikpaktik miakeh ya nohjó:n mokalakihkeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>ke:m..., kwi:ka ke:meh *año y medio** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>Ompa miakeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>*Por eso** se: *fiesta kichi:wah a:mo, a:mo monechikowah ok *porque** nochi moka:wilihkeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts680" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>O:me, e:yi, ompa ne: ke:meh se: na:wi:n ya sah, ma:kwi:limeh ya sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts683">
                <ANNOTATION_VALUE>Tein kitohtokah yo:n nechiko:l de n' taneltokalis tein tehwa:n tikwi:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>Okseki:n se: *lado** ya, soh tachi:xtokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>Pero pos tikitah pané: *lo mismo**, no: motsikwi:naltihtinemih, no: motekiti:ltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>Wa:n tikitah miak i:xpoliwkeh ya wa:n a:mo ke:man ne:sih ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>A:mo neli tein te:chilwiah, te:chkahkaya:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts692" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>Ke:mah wa:n *por eso** nikakik ye:wa ne: kihtowa i:n siwa:pil ke yehwa a:mo kwelita xolopihyo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts695">
                <ANNOTATION_VALUE>*Deveras** ke a:mo se: kwelita mah se: ki..., mah se: kihto *lo que es**tein neli**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>*porque a veces** xolopihyo:t neli se:, *a veces** se: tamiti *oficina**ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts701">
                <ANNOTATION_VALUE>Wa:n yo:n taman ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts702" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>Ihkó:n nohjo:ni, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>*Pues** se: tachihchi:wa itech ne:n *altar** totodio:swa:n tikiliah ka:mpa tokalihtiktsi:nko ka:mpa te:chpia todio:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>pos *cuando** t'nemiliah titachihchi:watih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts713">
                <ANNOTATION_VALUE>komo de yankwik kali pos *primero** tik..., tikitah ka:nika tikta:li:skeh n' kowit de n' *altar** ka:mpa nimo..., tikilpi:skeh xo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts714" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>Tikchihchi:wah ya yo:n, tikinta:liah ya to..., totodioswa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>wa:n tikte:mowah ne:n xo:chitaa:ketsal tikilwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>Tikowah *o** tikte:wah ne:wí:n ka:sá: mochi:wa n' tein ka:mpa tikitah ka:sá: kowtah onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts720" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>i:ksá: *tiempo** wi:tsa onkak tein kwaltsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts722" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>wa:n ke:mah tikte:mowah ya n' tepe:xi:lo:t wa:n tiktekih ya n' chamakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>Tiki:xehekowah ke:meh ka:nachi kahsis, kahsis *veinte o quince o doce**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts726" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>pos, *este**, tik..., tikte:mowah wa:n de tikte:mowah, tikoho:meki:xtiah yo:n chamakih, tiktapa:nah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>wa:n tikilpiah sehs..., tikilpiliah sehse: *hilo** ne:n kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts731">
                <ANNOTATION_VALUE>e:yi *lado** komo, komo na:wi pos na:wi *hilo**, ke:meh ahsis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts733">
                <ANNOTATION_VALUE>De ompa ke:mah tik..., tikil..., tik..., tiktamitapa:nah ya nohjó:n xo:chit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>tik..., tikilpiliah ya ne:n tepe:xi:lo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>Wa:n iwa:n ne:n chamakih tikilpihtiowih ya. Tikwihkontiowih ti..., *hasta** tiki:sah se: *surco**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts741">
                <ANNOTATION_VALUE>Ke:mah wa:n ta:ká:n tikma:ma:nelowah pos no: tiki:xehekowah ke:ní:w mo..., motohtokas nis..., i:n tikiliah ista:k chamakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts743">
                <ANNOTATION_VALUE>*o** yo:n xokoyo:lchamakih *o** chi:chi:lchamakih *o** yehwa yo:n tata:wik, kowtah chamakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts744" TIME_SLOT_REF2="ts745">
                <ANNOTATION_VALUE>De miak taman chamakih, ke:ní:w motohtokas para kwaltsi:n moitas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts747">
                <ANNOTATION_VALUE>Entó:s tikchihchi:wah nochi, nochi tima:tamih, seko tima:tamih sepa seko tipe:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts749">
                <ANNOTATION_VALUE>Wa:n ne:n.... *Primero** tai:xkwa:ko</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts751">
                <ANNOTATION_VALUE>wa:n *después** tametsko, tikinte:mowah o:me tein *parejos** tikihtowah tikinkechpilo:tih nehjí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>tein taeka:nte:was para paratani a, tikinte:mowah no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>Tik..., tikilpiah ya, tikechpilowah ya, tikilpiah ya, t'ta:lihtiowih ya n' tepe:xi:lo:t *hasta** tani ki:sati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>Sepa sentapal sepa tikwih *hasta** tani ki:sati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts759">
                <ANNOTATION_VALUE>Wa:n komo *sobra** nohjó:n xo:chit yehwa no: tikta:liah ih..., ihkó:n komo ke *lujitos** a, ¿*porque** ke:yeh? tiknehnekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>Ke:mah, ihkó:n tikchi:wah, de tima:tamih nochi titachpa:nah ya ne:n ka:mpa *mesa**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts762" TIME_SLOT_REF2="ts763">
                <ANNOTATION_VALUE>wa:n tik..., komo etok *listo** ne:n tekol, pos titapopo:chwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>Tikchi:wah *lo que es** iwki a:mo iwkiwa:n ke:mah *ticontentos** timoka:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts769">
                <ANNOTATION_VALUE>*Porque** neh nopi:pilwa:n nochi ihkó:n, se:, se: noo:kichpil nikpia pero semi *gustoso** de yo:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts770" TIME_SLOT_REF2="ts771">
                <ANNOTATION_VALUE>A:mo moneki nikilwi:s *cuando** kikwiti:w chamakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts772" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>Nikitas kehkoltih ya, kwa:lkwi tepe:xi:lo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>"'Tachihchi:wati pa:, pané: kichi:wa *falta** ya".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts779">
                <ANNOTATION_VALUE>Tachihchi:wa. "¡Ne:chpale:wi:ka:n!" Pos timopale:wiah, tik..., kitohtoma ya tein wa:kik a wa:n kipi:xowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts781">
                <ANNOTATION_VALUE>wa:n no: kipi:xo:ti wehka wa:n koma:mo tikta:liah itech *bolsa** wa:n kikwiti n' yo:n tein kololo:ti tahsol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>Entó:s timopale:wiah ya wa:n sepa ihkó:n tikchi:wah, e..., a:mo moneki nikilwi:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts785">
                <ANNOTATION_VALUE>*porque** kim..., momakatok kwe:ntah ke pos kitstok ke kichi:wa *falta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts786" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>Wa:n tein a:mo pos kika:was ihkó:n mah eto *hasta** se: xiwtika *porque** neh nikistinemi ka:sá: ihkó:n, a:mo *porque** nitanehnemilia pero pos todios te:chitstok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>Nikita yo:n sempowalxo:chit ka:sá: *cerca** tahkoxiwit nohma ilpitok. Wa:n ihkó:n a:mo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>*porque** tehwa:n a:mo titaxi:ko:skeh n' totilmahtsi:n mah tiaktoka:n se:, *hasta** se: me:tsti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts793">
                <ANNOTATION_VALUE>*hasta** se: *quince dias**, kipia de t'pataskeh, *igual** todios itaselo:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts794" TIME_SLOT_REF2="ts795">
                <ANNOTATION_VALUE>kipia de tikpatili:skeh ¿*porque** ke:yeh? para no: towa:n yetos koma:mo a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>Ihkó:n nohjo:ni name:chilwia nehjí:n tahto:lmeh, ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>Miak taman xo:chit, kwali no: se: kilpia yo:n tikiliah tewi:tso:t *mexicano**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts805">
                <ANNOTATION_VALUE>No: kwali ika se: tachihchi:wa yo:n koyo:po:lxo:chit mochi:wa ne:, acha *santa cruz** xo:chit mochi:wa itech n' *tres de mayo**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts806" TIME_SLOT_REF2="ts807">
                <ANNOTATION_VALUE>xa: nanki:xmattokeh yo:n wehwei no: kwali ika se: tachihchi:wa yeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts809">
                <ANNOTATION_VALUE>Wa:n nohjó:n, *este**, tikiliah tekolo:me:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts810" TIME_SLOT_REF2="ts811">
                <ANNOTATION_VALUE>*cuando** ne: *viernes santo** todio:s ehko i..., i..., [i]ilwiw, yo:n no: ika se: tachihchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts813">
                <ANNOTATION_VALUE>Wa:n welis *cualquier** xo:chitsi:n ika se: tachihchi:wa *porque** n' xo:chit *kibendicia:roh tomadre virgen**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>Miak taman xo:chit yehwa kitio:chi:w, nochi kwali tikmawistili:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>Ihkó:n nohjo:ni. Ke:mah, nochi weli, a:mo se: *mal**, ehe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts822" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>Yo:n a:mo nikmati, nikita wa:n weli *nocarnal**. Weli. Pero neh a:mo nimone:xtilia pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts824" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>nikita *todavia kisegui:rowa** miak mone:xtiliah pero neh a:mo niweli, *nocarnal** weli tewi:tso:t, weli de kowxiwit kichihchi:wa. Ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts830" TIME_SLOT_REF2="ts831">
                <ANNOTATION_VALUE>Pos nikita ke:ní:w kinehnepanohtiw, kinehnepanohtiw iwa:n moilpi:ti wa:n kita:lia se: *hilo** wa:n motili:ntia, ompa moka:wa ya, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts833">
                <ANNOTATION_VALUE>Weli yehwa, weli kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts834" TIME_SLOT_REF2="ts835">
                <ANNOTATION_VALUE>Mm, wa:n ke:mah de n' po:wtok no: kichihchi:wah ne:n *altar o** ke:meh ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>pos kilpiah ya no: tatampa yowi, yo:n a:mo kiwi:ka tepe:xi:lo:t, yo:n kiwi:ka, *este**, nohjó:n kiliah tepe:sin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts838" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>¿*Porque** ke:yeh? wehwei para kahsi ne:n ima:y we:wehka. Kilpiah ya no:, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>Neh nikitaya no: ne: ka:mpa nita:ltikpaktik, *este**, ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts842" TIME_SLOT_REF2="ts843">
                <ANNOTATION_VALUE>*cuando** ta..., tamitachihchi:wayah ompa kite:mowa:yah yo:n kiliah, *este**, seki xo:chit *tulipan**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts844" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>A:mo eliwis onkak ok, pero nika:wí:n a:mo kanah nikita ok pané:, xa: onkas pero a:it ka:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>Sehse: yo:n xo:chit kitekih kiyo:la:nta..., kiyola:nta:liliah para kwaltsi:n moita, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts848" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>*Hasta** yo:n xo:chit semi, semi nehyó:n tak chipa:wak *porque** nikitaya *cuando**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts851">
                <ANNOTATION_VALUE>ihkó:n mo..., kichi:wayah, *este**, mona:miktia:yah na:nahmeh, ta:tahmeh ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts853">
                <ANNOTATION_VALUE>kichihchi:wayah pa:nko:skat, pa:nmekat kilia:yah iwa:n kisohsoyah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts854" TIME_SLOT_REF2="ts855">
                <ANNOTATION_VALUE>Wa:n xokoxiwit wa:n li:mahxiwit wa:n pa:ntsi:n no: ma:neliwtok, a:mo sentaman sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts857">
                <ANNOTATION_VALUE>Kichihchi:wayah ka:..., ka:nachi yo:ni tein ne:n kikwiskeh pos miak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>kisohsoyah no: moka:wayah na:nahmeh tein kisohsoyah wa:n *cuando** ehkoya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts861">
                <ANNOTATION_VALUE>*novia** wa:n *novio** wa:n *padrino** wa:n *madrina** pos kinchiah ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts863">
                <ANNOTATION_VALUE>Ika motso:tsowiah, ke:mah. Wa:n de ompa pos motahpalowah ika wa:n komo kwi:kah pa:kilis pos kalan mihto:tiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts864" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>Ompa kichi:wah se: o:me, e:yi *sonecitos** de xo:chipitsa:wa wa:n *después** kalakih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts866" TIME_SLOT_REF2="ts867">
                <ANNOTATION_VALUE>Ke:mah yo:n xo:chit semi ki..., kikwiah, ki..., kikwih ok ka:sá: eski pero a:mo nochi ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts868" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>Ke:meh kihtowa:ya ne: na:nah ye:wa pos ekintsi:n oksé: *costumbre** ya, koto:nik a yo:n, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts874" TIME_SLOT_REF2="ts875">
                <ANNOTATION_VALUE>Pos motsowia:yah ne:n *te:compadrito** iwa:n tein, tein ipopa:n okichpil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>Pos motsowi:s iwa:n ne: ipopá:n ne: siwa:pil wa:n *padrino** no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts878" TIME_SLOT_REF2="ts879">
                <ANNOTATION_VALUE>Iwa:n no: motsowi:s. *Madrina igual** iwa:n motsowi:s *icomadrita** tein, tein nochi, nochi yo:n ya:s *por parejo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts880" TIME_SLOT_REF2="ts881">
                <ANNOTATION_VALUE>Tein isiwa:pil imomá:n no: kitsowi:s n' *icomadrita** tein okichpil imomá:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts882" TIME_SLOT_REF2="ts883">
                <ANNOTATION_VALUE>*Parejo** ya:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts884" TIME_SLOT_REF2="ts885">
                <ANNOTATION_VALUE>Nochi *te:parientes** tein *deveras** motasohtah pos komo te:okichpil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts886" TIME_SLOT_REF2="ts887">
                <ANNOTATION_VALUE>komo wi:tsa ne:n siwa:montikeh pos, komo yetokeh ne:n iweswa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts888" TIME_SLOT_REF2="ts889">
                <ANNOTATION_VALUE>*porque** mochi:wati iweswa:n a:mo a:wil, ki..., komo kipiah *gusto** kichihchi:wili:skeh sehse: yo:n xo:chimekat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts890" TIME_SLOT_REF2="ts891">
                <ANNOTATION_VALUE>wa:n kitahpalo:skeh ini..., ini..., iniwes wa:n kikechtsowi:skeh, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts892" TIME_SLOT_REF2="ts893">
                <ANNOTATION_VALUE>Wa:n yo:n xo:chimekat a:mo kiki:xti:s wa:n okichpil *igual**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts894" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>no: kitsowi:skeh tein siwa:pil ikni:wa:n, ya:skeh te:wa:n wa:n no:, no: kiwi:kaskeh yehwa:n, no: kitsowi:skeh ya ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts896" TIME_SLOT_REF2="ts897">
                <ANNOTATION_VALUE>ta *cuando** ahsis no: kitahpalo:skeh, ¿*porque** ke:yeh?, pos ini:k..., ini:kni:w ompa ne: yetoti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts898" TIME_SLOT_REF2="ts899">
                <ANNOTATION_VALUE>Ihkó:n nohjó:n. De motahpalowah pos ompa ne: yetokeh, *madrina, padrino wa:n ne:n te:popa:wa:n, te:moma:wa:n pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts900" TIME_SLOT_REF2="ts901">
                <ANNOTATION_VALUE>mo..., ke:meh kimattokeh ya ton *compromiso** kipiah pos niman moiliah kichi:watih se: p..., pa:kilis n' kalte:noh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts902" TIME_SLOT_REF2="ts903">
                <ANNOTATION_VALUE>*porque** ihko:ni mota:lihkeh *de acuerdo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts904" TIME_SLOT_REF2="ts905">
                <ANNOTATION_VALUE>Entó:s ne:n te:popa:n kalte:..., ne:n kalihtik, tein *casero**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts906" TIME_SLOT_REF2="ts907">
                <ANNOTATION_VALUE>niman kwi..., kiwa:lkwiti sake:ra se: *litro** ne:n tikilia:yah refi:noh, mexica:nohkopa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts908" TIME_SLOT_REF2="ts909">
                <ANNOTATION_VALUE>Kimakaya ne:n *padrino** wa:n pe:wa ya *baile** kixelo..., kixelowa ya ne:, taxelowa ya ne: kalampa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts910" TIME_SLOT_REF2="ts911">
                <ANNOTATION_VALUE>*Mientras** mihto:tihtokeh seki:n wa:n yeh no: pos no: te:wa:n, ihkó:n nohjo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts912" TIME_SLOT_REF2="ts913">
                <ANNOTATION_VALUE>A:mo sayoh kichihchi:wayah para se: nohjó:n pa:nmekat tikilia:yah pero iwa:n nohjó:n xo:chit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts914" TIME_SLOT_REF2="ts915">
                <ANNOTATION_VALUE>yehwa ne:n xokoxiwit, li:mahxiwit wa:n pa:ntsi:n no: yetoya sah tein kikwiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts917">
                <ANNOTATION_VALUE>kikwiah *bolillo** wa:n seki kilia:yah *pan blanco**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts918" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>Wa:n nohjó:n kiliah *cuernos** wa:n seki kiliah a:ko:loh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts920" TIME_SLOT_REF2="ts921">
                <ANNOTATION_VALUE>Yehwa kikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts922" TIME_SLOT_REF2="ts923">
                <ANNOTATION_VALUE>Pero a:xka:n a:mo kanah ok, kichi:wah, kichi:wah pero pos oksé: taman ya. A:mo *igual** ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts924" TIME_SLOT_REF2="ts925">
                <ANNOTATION_VALUE>Wa:n i:n.... Ne: ke:man niwa:lahka nika:n, a:mo i:pa nika:n ninemi a, i:n San Miguel i:pa ompa nimoahsi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts926" TIME_SLOT_REF2="ts927">
                <ANNOTATION_VALUE>*Ne:chinvita:roh** se: *amigo** wa:n nikitak ke:ní:w chi:wik, *este**, kichi:wkeh nohjó:n *compromiso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts928" TIME_SLOT_REF2="ts929">
                <ANNOTATION_VALUE>Wa:n, pos tein tikmattokeh *porque** neh no: neli no: ni..., no: *nicasado** katka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts930" TIME_SLOT_REF2="ts931">
                <ANNOTATION_VALUE>nikmattok ke:ní:w yo:n, tikmattokeh ompa ne: tietokeh kalihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a471" TIME_SLOT_REF1="ts932" TIME_SLOT_REF2="ts933">
                <ANNOTATION_VALUE>Etokeh iikni:wa:n ompa ne: ta:kat pero pos ne:n ta:katsi:n kit a:mo kanah yowi. A:mo ke:man kitah, *hasta** kihtoh *después**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts934" TIME_SLOT_REF2="ts935">
                <ANNOTATION_VALUE>Ehkok a *nicompadrito** wa:n *icomadrita** wa:n *novio** wa:n *novia**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts936" TIME_SLOT_REF2="ts937">
                <ANNOTATION_VALUE>A:mo teh molia yeh, ne: kwityetok ne: kalihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts938" TIME_SLOT_REF2="ts939">
                <ANNOTATION_VALUE>Kiliah ya ne:, "Xiow ya ne: x'na:mikiti a moko..., mo..., mosiwa:mon wa:n *mocompradito** wa:n *mocomadrita**!"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts940" TIME_SLOT_REF2="ts942">
                <ANNOTATION_VALUE>Semi 'na:mikiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts945">
                <ANNOTATION_VALUE>Ka:n nikilia mah kalaki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts946" TIME_SLOT_REF2="ts947">
                <ANNOTATION_VALUE>A: nik..., ne:chilia ne:n iikni:w, "*Cabrón don** Andrés ne: *nocarnal** neli ika ya a:mo kanah yowi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts948" TIME_SLOT_REF2="ts949">
                <ANNOTATION_VALUE>I:pa a:mo kimati." "Neh soh nikitstok" nikilia. "Neh *por eso** niwa:la nitachiako, neh n'mattok ke:ní:w", nikilia, "ne: kichi:wah, ke:mah".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts950" TIME_SLOT_REF2="ts951">
                <ANNOTATION_VALUE>"Xiow a", kilia "pero ton, toni n'wi:kas, toni moneki". *Igual n' iseñora** yeh mosenkwikeh ne:pa *cocina** ke:meh ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts952" TIME_SLOT_REF2="ts953">
                <ANNOTATION_VALUE>moolo:chtsahtsiliah ke moneki tekolkaxit, ke moneki *cera**, moneki xo:chimekat, *híjole**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts954" TIME_SLOT_REF2="ts955">
                <ANNOTATION_VALUE>Pos ne: tein iniwa:n, a:mo teh kilwihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts956" TIME_SLOT_REF2="ts957">
                <ANNOTATION_VALUE>Pos semi kihtoh *señor** ne: kalan moketsato, "Name:..., name:chtahpalowa *compadritos** iwki *o** a:mo iwki *comadritas**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts958" TIME_SLOT_REF2="ts959">
                <ANNOTATION_VALUE>*[por]que** neh semi xikmatika:n a:mo ke:man kanah niow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts960" TIME_SLOT_REF2="ts961">
                <ANNOTATION_VALUE>Pero we:noh", kilia, "nehyó:n tikchi:watih", kilia, "n' pa:kilis wa:n timotahpalo:tih, iwki a:mo iwki pos".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts962" TIME_SLOT_REF2="ts963">
                <ANNOTATION_VALUE>Kininohno:tsak, *después** ok kwi:kakeh ne: xochimekat *después** ok ki..., kikechakih *icompadrito**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts964" TIME_SLOT_REF2="ts965">
                <ANNOTATION_VALUE>wa:n *icomadrita** wa:n *te:comadrita no:. Wa:n *novios después** ok kintahpalohkeh wa:n n' xo:chimekat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts966" TIME_SLOT_REF2="ts967">
                <ANNOTATION_VALUE>ne: seki:n kiliah ni..., mah ki..., ki..., kitsowi:tih ne: te:weswa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts968" TIME_SLOT_REF2="ts969">
                <ANNOTATION_VALUE>Moka:ka:wiliah, ke kwala:nih, we:wetskah, wetskah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts970" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>Entó:s kinilia se: te:tioh wa:n se: te:awi, "A:mo xiwetskaka:n", kilia, "pero ne: *como respeto**", kilia, "*anterior**", kilia, "[komo]nawetskah, kihto:skeh ke sayoh nankiwetskiliah wi:tseh, a:mo nankiwehwelitah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts975">
                <ANNOTATION_VALUE>*Este**, a:mo iw, a:mo iwki nehyó:n nankichi:wtokeh, ¡xi..., xia:ka:n¡" kinilia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts976" TIME_SLOT_REF2="ts978">
                <ANNOTATION_VALUE>"ma:ski *fuera de tiempo** nanehkokeh pero namehwa:n x'ta:lili:tih". Pero kita:lili:toh a:mo iwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts982">
                <ANNOTATION_VALUE>'Kechkalakili:towa:n ne:si yo:n teisá: kimowtia para kalihtik, sepa.Ihkó:n a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts985">
                <ANNOTATION_VALUE>'Kechta:lili:s ika *paciencia, primero** kitahpalo:s 'kechkalakili:s wa:n no: kitahpalo:s wa:n ompa moka:was a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts986" TIME_SLOT_REF2="ts987">
                <ANNOTATION_VALUE>Ta: mihto:ti:s mah mihto:ti a ne:n te:wes *o te:cuñado o te:cu...,** te:popá:n, *a ver** a:koni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts988" TIME_SLOT_REF2="ts989">
                <ANNOTATION_VALUE>Soh tikitakeh. *Después** ne:chilia ne:nte:ikni:w se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts990" TIME_SLOT_REF2="ts991">
                <ANNOTATION_VALUE>"Ne: *nocarnal** a:mo ke:man i:x..., mi:xpeta:nih", kihtowa, "*este**, n' i:n a:mo yahtinemi ta: okachi kwali", kihtowa, "mah se: yowi ka:sá: mah se: kita ke:ní:w mowi:katiah, ke:ní:w kichi:wah, ke:ní:w motahpalowah", kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts992" TIME_SLOT_REF2="ts993">
                <ANNOTATION_VALUE>"para no: se: yeh teto..., a:mo, a:mo se: motahtanihtok pero *a veces cualquier amigo** se: kipia *amistad**", kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts994" TIME_SLOT_REF2="ts995">
                <ANNOTATION_VALUE>"Te:tahtania *favor**. Pos *tikinvita:rowa amigos** komo t'na:nkilih, *tikinvita:rowa** o:me, e:yi *amigos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts996" TIME_SLOT_REF2="ts997">
                <ANNOTATION_VALUE>Pero tiow tikmattok a ke:ní:w wa:n komo semi a:mo se: kimati mah se: kitsi:ntokili tein kimattokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts998" TIME_SLOT_REF2="ts999">
                <ANNOTATION_VALUE>'¿Ke:ní:w nikchi:was i:n *compromiso** nikpiati?'".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts1000" TIME_SLOT_REF2="ts1001">
                <ANNOTATION_VALUE>Pero ne: nokni:w a:mo tahtowa pero soh *por relajo**" kihtowa, a:mo kimati ke:ní:w, kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts1002" TIME_SLOT_REF2="ts1003">
                <ANNOTATION_VALUE>Pos kichi:wkeh se: o:me, o:me e:yi *son** kalampa *bailecito** kichi:wkeh wa:n iwki a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts1004" TIME_SLOT_REF2="ts1005">
                <ANNOTATION_VALUE>ompa ne: kimpa:ktihtiw ne:n *casero** pos a:mo kimati tak ke:ní:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts1006" TIME_SLOT_REF2="ts1007">
                <ANNOTATION_VALUE>Kalakkeh wa:n de kalakkeh, *este**, motahpalohkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts1008" TIME_SLOT_REF2="ts1009">
                <ANNOTATION_VALUE>Semi kin..., te:chsenilwih ya, "*Más bien** nohjó:n *señor**".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1012">
                <ANNOTATION_VALUE>Kihtowa,"Tak iwki, ki..., tak iwki", te:chilia, "wa:n tak iwki *compadritos** nanik..., tik..., tik..., nikchi:wtok *[per]o**name:chchiak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts1013" TIME_SLOT_REF2="ts1015">
                <ANNOTATION_VALUE>*porque** neh", kilia, "mah semi name:chili a:mo ke:man kanah niow pos sake:ra", kilia, "name:chchiak, a:mo niwintitok".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts1016" TIME_SLOT_REF2="ts1017">
                <ANNOTATION_VALUE>Pos miak kwetskilihkeh *porque** neli a:mo iwki ne: kichi:wtok kitakeh, pero we:noh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts1018" TIME_SLOT_REF2="ts1019">
                <ANNOTATION_VALUE>sake:ra te:chwa:ntik taxkaltsi:n seki kihtowah, "Pos yehwa sah *más** moneki", kihtowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts1020" TIME_SLOT_REF2="ts1021">
                <ANNOTATION_VALUE>Kichi:wkeh *baile. Después** tamik nochi yo:n *baile** wa:n monawatihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts1022" TIME_SLOT_REF2="ts1023">
                <ANNOTATION_VALUE>Ke:mah, ompa ya tikitakeh a:mo mochi:wa *o** a:mo kimatih okseki:n ke:ní:w nohjó:n mochi:wa tein *más**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts1024" TIME_SLOT_REF2="ts1026">
                <ANNOTATION_VALUE>semi telwehka:w kichi:wayah n' ta:tahmeh, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts1030" TIME_SLOT_REF2="ts1031">
                <ANNOTATION_VALUE>*Pues**, pos yehwa yo:n tein mame:chilihtok ne:n, de n' motahpalowa:yah pero tein *morespetaro:wah pues</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts1032" TIME_SLOT_REF2="ts1033">
                <ANNOTATION_VALUE>kisegui:rowah** wa:n tein a:mo pos, a:mo kino:tsas nió:n *porque icuñado o porque** iwes a:mo kino:tsas kwali iwa:n moahwas</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts1034" TIME_SLOT_REF2="ts1035">
                <ANNOTATION_VALUE>*porque** tikitah *pasa:rowa** wa:n *pues te:chpasa:rowa pero a:mo tinochi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts1036" TIME_SLOT_REF2="ts1037">
                <ANNOTATION_VALUE>Pero neh *gracias a dios** a:mo ke:man *ne:chpasa:roh** iwa:n no..., *nosuegro** katka *o** no..., no..., nos..., no..., no..., *nosuegra katka *o nocuñado, nocuñadas hasta** a:xka:n nochi nikinohno:tsa, nochi ne:chnohno:tsah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts1038" TIME_SLOT_REF2="ts1039">
                <ANNOTATION_VALUE>pero *por** kwali a:mo *por mal**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts1040" TIME_SLOT_REF2="ts1041">
                <ANNOTATION_VALUE>*Porque** ke:yeh a:mo yo:n, a:mo i..., a:mo ika yo:n nehwa nikinte:moh *o** nikinehnekik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts1042" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>A:mo kwaltsi:n nohjó:n *porque** ke:yeh *este** tasohtalis se: mochi:wa pero *hasta** ke:man dios kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1045">
                <ANNOTATION_VALUE>Tein se: kinemilia wa:n tein a:mo, niman nikaki kihtowah ke yehwa:n *kinivale:rowa madres** pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts1046" TIME_SLOT_REF2="ts1047">
                <ANNOTATION_VALUE>semi *tontos** etokeh, *porque** nochi *ticristianos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts1048" TIME_SLOT_REF2="ts1049">
                <ANNOTATION_VALUE>Mah a:mo se: momachili semi se: yehwa ya *porque** se: chika:wak *o** ke:ní:w *porque** todios a:mo tikitah wa:n tonemi:lis a:mo tikitah *o** se: kokolis te:chahsis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts1050" TIME_SLOT_REF2="ts1051">
                <ANNOTATION_VALUE>*Por más** semi titelchika:wak pero kipia de se: wetsi ika kokolis wa:n ihwa:k timota:tawti:s iwa:n ya ma:ski tein tik..., tein mitstawe:litaya *o** t'tawe:litaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts1052" TIME_SLOT_REF2="ts1053">
                <ANNOTATION_VALUE>Wa:n mah a:mo yo:n se: kichi:wa, mah, mah se: motasohta *por parejo** seki tein tiknemiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts1054" TIME_SLOT_REF2="ts1055">
                <ANNOTATION_VALUE>Pero tein a:mo kinemilia, a:mo, weli mits..., mitspanawia nió:n no: mitstahpalo:s *o** tiktahpalo:s nió:n no: mitsna:nkili:s yeh ya:s, yeh ya:s ke:meh tapial.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts1056" TIME_SLOT_REF2="ts1057">
                <ANNOTATION_VALUE>Wa:n ihkó:n a:mo kwaltia. Ke:mah, iwki nehjo:ni, *pues** tein mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts1058" TIME_SLOT_REF2="ts1059">
                <ANNOTATION_VALUE>mowi:kah kwali *como siempre** mowi:katinemih *hasta** sentekitih *cuñados o** ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts1060" TIME_SLOT_REF2="ts1061">
                <ANNOTATION_VALUE>iweswa:n ya siwa:t mosewi:katinemih, kwaltsi:n motasohtah *porque** ke:yeh a:mo teh onkak tawe:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts1062" TIME_SLOT_REF2="ts1063">
                <ANNOTATION_VALUE>Wa:n seki tite:kakilia:nih niman kihtowah, "A:, ke ne: yehwa i:n ika tapoloh, ke kima:keh *o** 'kwetaxwihkeh *o** ki:xkahkapa:nihkeh." Ihkó:n a:mo kwaltsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts1064" TIME_SLOT_REF2="ts1065">
                <ANNOTATION_VALUE>Ta: komo se: kimati yo:n iwki pos *mejor** a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts1066" TIME_SLOT_REF2="ts1067">
                <ANNOTATION_VALUE>para toni te:chkwala:ntihtos se: siwa:t, *este**, tokalihtik *o** tikwala:nti:skeh tehwa:n pos *mejor** a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts1068" TIME_SLOT_REF2="ts1070">
                <ANNOTATION_VALUE>[por]que se: te:ikne:ltih. Ke:mah, iwki nohjó:n, tein se: kinemilia pos iwki wa:n tein a:mo pos se: kihtowa se: siwa:t wa:n tita:kah nochi titasohmeh, a:mo a:kin a:mo tasoh, *parejo**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts1074" TIME_SLOT_REF2="ts1075">
                <ANNOTATION_VALUE>*Pues, pos solamente** yehwa yo:n name:chilia ya tayah *puro refino** wa:n mowintia:yah ta:tahmeh *hasta después** motewia:yah seki:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts1076" TIME_SLOT_REF2="ts1077">
                <ANNOTATION_VALUE>wa:n monawatia:yah a:mo monawatia:yah, i:ksá: tane:siah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts1078" TIME_SLOT_REF2="ts1079">
                <ANNOTATION_VALUE>se: yowal *baile hasta** mo:stika i:ksá: moka:wayah nepantah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts1080" TIME_SLOT_REF2="ts1081">
                <ANNOTATION_VALUE>ika miak *gu...,**, ika miak pa:kilis kichi:wayah *baile**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts1082" TIME_SLOT_REF2="ts1083">
                <ANNOTATION_VALUE>A:mo ke:meh a:xka:ntsi:n, a:man taman ya. Ke:mah, a:man seki, seki iwki sah, seki *baile** mochi:wa se: *dos, tres horas o** tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts1084" TIME_SLOT_REF2="ts1085">
                <ANNOTATION_VALUE>*o** tiknechikowah yo:n wehwei tatsotsonanih *porque** ke:yeh a:xka:n oksé: ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1087">
                <ANNOTATION_VALUE>*O** tikinte:mowah miak, *este**, nehyó:n nechiko:l *padrinos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts1088" TIME_SLOT_REF2="ts1089">
                <ANNOTATION_VALUE>Wa:n ihwa:k katka a:mo, ihwa:k katka *solamente** se: sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts1090" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>Wa:n ne:n tein tayo:lpa:ktia:nih *solamente** o:men ya:s ki..., ne:n *guitarra** tein kitsotsonas wa:n tein *violín** sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts1092" TIME_SLOT_REF2="ts1093">
                <ANNOTATION_VALUE>Wa:n yehwa:n ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts1094" TIME_SLOT_REF2="ts1095">
                <ANNOTATION_VALUE>Aa:n a:xka:n tikitah a:mo, yowih sake:ra chikwase:meh *o** na:wi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts1096" TIME_SLOT_REF2="ts1097">
                <ANNOTATION_VALUE>*porque** ke:yeh onkakeh ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts1098" TIME_SLOT_REF2="ts1099">
                <ANNOTATION_VALUE>*más** momachtihkeh wa:n semi kwalia ke *más** momachtihkeh, a:mo ke:man moelka:was yo:n wehka:wkayo:talna:miki:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts1100" TIME_SLOT_REF2="ts1101">
                <ANNOTATION_VALUE>Ke:mah, [mah]semi se: kintasohka:matili *porque** te:ikne:ltihkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts1102" TIME_SLOT_REF2="ts1104">
                <ANNOTATION_VALUE>semi *kisufri:fowah, modesvelarowah por, por** tein *tigustosos** tikchi:wah se: pa:kilis, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts1108" TIME_SLOT_REF2="ts1109">
                <ANNOTATION_VALUE>Pos neh nimono:tsa niAndrés Martín Juárez, nita:ltikpaktik Xaltepec, a:xka:n nimoahsi Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1112">
                <ANNOTATION_VALUE>Ne: nik..., xiwit nikpia *cincuenta y nueve años**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts1114" TIME_SLOT_REF2="ts1117">
                <ANNOTATION_VALUE>Tasoh..., tasohka:matik *igual**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
