    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="CommentType" PARTICIPANT="Comments" TIER_ID="Comments">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>{Aquí quiso decir 'kikamana:lmati'.} {Por equivocación dice kowinalwat}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>{Aquí quisiera decir 'tikinitayah'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>{aqui no alarga i, pero casi todos los hablantes lo alargan}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>{Aquí hubiera dicho 'a:mo ke:man kitalo:xtia:ya'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>{Por 'a:mo xikmati'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>{Aquí dice ochpa:na ('barrer') donde quizá mejor hubiera dicho tikehe:wa}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>{Aunque dijo mochi:n, en el mpio. Cuetzalan se utiliza la forma nochi o nochi:n}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>{Probablemente es kochonih, Vasconcellea cauliflora (Jacq.) A. DC, un tipo de papaya}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>{Aqui está preguntando acerca de las costumbres de arreglar los altares}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a564" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts560">
                <ANNOTATION_VALUE>{quizá sea dogmático o quizá de carismático o de diezmar}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>{Está hablando de los evangélicos que no creen en y quieren destruir a las imágnes religiosas}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>{Aquí es como sarcástico, ¡Vas a estudiar! Mejor...}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts641" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>{Esto es, para cambiar a la gente de sus ideas, decían que solamente al dejar de creer lo que creían de católicos, iba a llegar el dinero solo.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>{Tamiti es como 'finalizar en un lugar' en este caso, la oficina, que es el juzgado}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>{Trad. 'Y junto con el chamaki vamos amarrándolo. Lo vamos formando bien hasta salir un surco.'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts765" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>{Esto es, lo hacemos si está bien o no está bien}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>{Pa: de 'papá'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts944">
                <ANNOTATION_VALUE>{Aquí probablemente es el imperativo, 'xikna:mikiti'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts974">
                <ANNOTATION_VALUE>{Aquí refiere a los tíos y tías del novio, que están en su casa esperando la llegada de la novia y su gente} {Esto es, nankwetskiliah tein wi:tseh, se rien de los que vienen, esto es, los familiaries de la novia}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts980">
                <ANNOTATION_VALUE>{Esto es, que pongan el  xo:chimekat a la novia y su gente}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts981" TIME_SLOT_REF2="ts984">
                <ANNOTATION_VALUE>{Aparentemente aquí es singular,  fue algún pariente del novio a  poner el xochikomekat a la novia y a sus familiares} {Esto es, al ponerle el xo:chimekat a la novia algo lo asustó (afuera de la casa) y corrió hacia adentro de la casa. Asi no se hace}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts1011" TIME_SLOT_REF2="ts1014">
                <ANNOTATION_VALUE>{Aquí habla el papá del novio} {Aquí no tiene mucho sentido el "o" quizá mejor 'pero' y por eso la corrección}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="Eleuterio Gorostiza Salazar">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>Iwki a. Ta:tah pos ekintsi:n x'te:chtapowi ne: tein tikihtowa:ya ke:ní:w ne:n wehka:w mo..., tonika mota:lia:yah ta:tahmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>*Bueno este** yo:n sa:te:pan tikitaskeh de ne:n wito:n, ekintsi:n, *este**, para *bueno, este**, 'sentokaskeh ika i:n tein tite:chnohno:tstok, tikihtowa ke ...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>pos ne: ke:man, *este**, kikwiah nochi sokikaxit wa:n tein ika taya:yah teisá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Tikihtowa ihwa:k a:mo kikwiah *cuchara**, ne:n a:mo kwi:kayah *cuchara** n' kowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>¿Ke:ní:w kite:kayah n' tapalo:l?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>Ta: ka:n teisá:, *este**, tikelna:miktos ok tein yo:n ihwa:k kikwiah wa:n ekintsi:n a:mo kikwih ok ke:meh yo:n kalihtik tinemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>Komo tiknekiskia kwali 'te:chtapowi:s teh ke:ní:w, *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>ton chi:walis kichi:waya mo:má:n katka *desde** ke me:waya *hasta** tayow..., *este**, tayowaya wa:n iwki, *este**, pos tapoya:wia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Wa:n, *este**, yo:n ihwa:k, *bueno** ye:wa tikihtoh ika, *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>a:mo, a:mo kochiah itech wapal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>Ekitsi:n no: tikihtowa no: ika, *este**, moneki se: kichipa:was ne:n kochpetat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>koma:mo, *este**, mokaliakiah okwilimeh. ¿Ton okwilomeh ne: kwali mokalaki:skeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>Ta:ka:n teisá: tikelna:miki ok tein mokwia kalihtik yo:n ihwa:k, *o** nochi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>Nochi a eski ke:meh ne: ke:man mowi:kayah, *este**, xa: tikelna:mikis ke:ní:w, *este**, ox i:pa tachihchi:wah kalihtik tokni:wa:n, ke:ní:w tachihchi:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts707">
                <ANNOTATION_VALUE>kwali 'te:chtapowi:s ke:ní:w se: tachihchi:wa, ke:ní:w se: kipe:waltihte:wa, toni se: kikwi, *desde** se: kite:mowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>Okseki xo:chit tein kwali se: kita:lia oso i:pa chamakih sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts819" TIME_SLOT_REF2="ts821">
                <ANNOTATION_VALUE>Tikmattok ke:ní:w se: kita:lia n' tewi:tso:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts829">
                <ANNOTATION_VALUE>Pero tiki:ita ke:ní:w kichihchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts873">
                <ANNOTATION_VALUE>Wa:n a:konimeh yo:n motso:tsowia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts1027" TIME_SLOT_REF2="ts1029">
                <ANNOTATION_VALUE>Pos a:mo n'mati ta:ká:n teisá: tikelna:miki ok tein, *este**, wehka:w nemi:lis katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts1071" TIME_SLOT_REF2="ts1073">
                <ANNOTATION_VALUE>Teisá: *mas** ok tikneki 'te:chtapowi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts1105" TIME_SLOT_REF2="ts1107">
                <ANNOTATION_VALUE>*Bueno pues, este**, komohkó:n nochia tein tite:chtapowih kwali 'te:chili:s moto:ka:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts1113" TIME_SLOT_REF2="ts1116">
                <ANNOTATION_VALUE>Tasohka:matik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
