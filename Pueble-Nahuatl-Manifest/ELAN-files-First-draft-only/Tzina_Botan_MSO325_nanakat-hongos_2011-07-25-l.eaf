        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>No: ke:meh a:man nochi mochi:wa yo:n ma:tananakat, ke:mah. Wa:n ma:tananakat no: kie:wa yehwa n' chalawihkowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>Ke:wa wa:n a:mo n'mati seki ton kowyo no: kie:wa, yehwa de yo:n teswat no kie:wa, chi:kikis no: kie:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>Ke:mah, pero yo:n nochi komo ye:kchika:wak a no, yo:n kwali se: kikwa mah se: kipuye:li wa:n mah se: kite:tewa:tsaka koma:lko, kwaltsi:n te:tewa:ki no: kwaltsi:n ika se: takwa, ye:kahwiya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>Komo yo:n telchihchika:wak a, *porque cuando** ye:kchika:wak a ata ye:kkohkostik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Wa:n *cuando** ko:kone:meh ye:kpohpochiktik wa:n sa sehseltik, se: ki:e:ktia ye:kne:nke:n kokotoka yo:n itsi:nkowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>Pero komo chika:wak a pos ka:n no: we:l se: kikwa ok *porque** takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Ke:mah, kwali se: ki..., kwali se: kitewa:tsa koma:lko, se: kipuye:lia wa:n se: kitewa:tsa koma:lko wa:n kwali ika se: takwa no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>Se: kia:mana oso komo se: kichi:wa a:ko:loh no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Pero n' ta: nimitsilwihtok seki kihtowah komo se: kia:ko:lwih</ANNOTATION_VALUE>
