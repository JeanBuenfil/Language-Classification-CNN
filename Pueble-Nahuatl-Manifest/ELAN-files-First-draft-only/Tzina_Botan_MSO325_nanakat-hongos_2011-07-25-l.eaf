        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>*que** a:mo mochi:wa ok n' ka:mpa mochi:wa, pero a:mo se: kimati ox neli, neh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>neh nochipa nikmana ihkó:n pero taa:man sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>A:, ke:mah, *como que**, komo se: kitela:yo:tih pos ka:n no: we:lik ok ki:sa, mah se: kia:yo:ti pero tepitsi:n sah *porque** yo:n moa:yo:tia *porque** ke:meh, ke:meh *de que** kiowi *cuando** mochi:wa pos kwa:lkwi miak a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Ke:mah wa:n de se: kite:kilia a:t miak pos moa:yo:tia wa:n komo tepitsi:n sah tika:yo:tih kwaltsi:n ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Mah kwaltsi:n sah se: ka:yo:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>Ke:mah we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>¿Ka:n tiki:xmati? Neh niki:xmattok, niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>Ke:mah, pero seknanakat no: yetok sah ke:man mochi:wa, yehwa yo:n a:mo, a:mo nikelna:miki, de seknanakat no: yetok sah *cuando** mochi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>*cuando** yo:n ye:ktasese:ya sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>Ke:mah, itech i:n, itech i:n tapowal de diciembre ihwa:k mochi:wa yo:ni. Yo:n neli, yo:n neli no: we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>Wa:n yo:n kwaltsi:n no: se: kichi:wa. Ke:mah, yehwa yo:n a:mo nikelna:mik teh nimitsilih pero yo:n neli no ni..., no: niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Pos yo:n kwali se: kikwa no: mah se: kichi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>taa:man *o** mah no: se: kichi:wa chi:lposo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>oso tatsoyo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>Wa:n komo mah se: ki...., mah se: kkokototsa kwaltsi:n wa:n mah se: kipuye:li wa:n mah se: kichi:wa koma:ltamal, no: ye:kwe:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>Tehwa:n iwki tikchi:wah, *más** koma:ltamal tikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>Ke:mah, ke:meh yo:n n'ta:lia n' tixti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>wa:n de nikepa ya ihwa:k a ompa niki:xta:lilia ya ne:n nanakat wa:n sepa se: n'pasowilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>wa:n ke:mah oksi a wa:n tikwah ya, ye:kahwiya:k neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Ke:mah, pero yo:n mochi:wa ihwa:k itech i:n diciembre sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>Ke:mah, oso enero mochi:wa *cuando** yo:n teltasese:ya, ke:meh i:n a:man mochi:wka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>Ke:mah, *porque** teh..., wa:n yo:n mochi:wa ta:li:xko sah, yo:n a:mo mochi:wa itech kowit, yo:n ta:l..., no: mochi:wa seki *pero más** mochi:wa sekita:li:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>Mochi:wa ke:meh i:n ta:li:xko wa:n kwali se: kkwiti ompa wa:n se: kichihchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>A:mo semi, ka:sá: ika sah mochi:wa, ka:sá: ika a:mo mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>*Porque** neh n'mattok *porque** ne: ka:mpa nota:tahtsi:n ita:lpan ompa mochi:wa, ompa tiko:nkwi:kwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>Ma:ski kahfe:ntah ihkó:n mochi:wa ye:kkwahkwali wa:n a:mo ta: no: kie:wa xo:no:kowit, chika ompa ko:nkwika seki nota:tahtsi:n itech xo:no:kowit, no: kie:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>Ke:mah, ye:kwehwei mochi:wa no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>Pero yo:n no:, no: komo pano:tok a a:mo no: wel se: kikwa ok. Mah se: kikwa no: yo:n *cuando** sehselik kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE>Wa:n yo:n neli no: moy..., no: motela:yo:tia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>Ke:mah, yo:n ye:ktsikilitsi:n sah a:tsí:n sah t'te:kili:s wa:n ye:k miak mochi:wa n' ia:yo *porque** ye:ka:yoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>Ka:n wel se: kikwa ok *porque** eliwis pa:ti, kokotoka ya sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Wa:n de sehselik kwaltsi:n se: kkokototsa, sehseltsitsí:n kwaltsi:n se: kkokototsa *porque** komo telpano:k pos ka:n wel se: kikwa ok *porque** ka:n wel..., wa:n kie:kkwih yo:n ihkochimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Yo:n neli kinye:kpia, kintelpia ihkochimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts390">
                <ANNOTATION_VALUE>Pero de chika:wak a, *pero de que** sehselik ka:n teh kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts391" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>*Porque** neh niki:itani *porque** nikchihchi:wani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>A:, yeh m..., yeh mochi:wa ke:man eski pero no: *cuando** kiowtiw, *de que** yo:n *cuando** teltakawa:ni a:mo no: mochi:wa, *pero siempre** se: kahsitiw ahachichi, *casi** ke:meh i:n de kahfe:ntah mochi:wa, yeh kwali mochi:wa itech kahfe:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>Yehwa yo:n seki yo:n nikilia ti:ltik wa:n de yo:n okseki, pero de yo:n ti:ltik te..., yeh *más** takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>Wa:n yo:n seki *más** ema:nik wa:n telihkochyoh, n' okseki ne:n alakcho pero tein yo:n ti:ltik *más**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>*más** takwa:wak, yo:n kihtowah kwali se: kikwa iwki mah chi:lposo:n se: kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>No: we:lik kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Weli se: kikwa taa:man no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>Taa:man. Neh iwki nikchihchi:wa taa:man sah, nikmanilia nota:tahtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>N..., ke:mah, mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Pané: a:mo okachi, *porque** a:mo akah ihkó:n mah, mah kinemi:lti. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>Se: kahsi pero ke:meh yo:n, pos tehwa:n i:pa tikahsih pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>tik..., a:mo ke:man n'namaka neh, nochipa tikmanah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>Ke:mah *porque** yeh *más** ka:n pa:ti wa:n okseki no: pa:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>Ke:mah, yeh *más**, yeh kahkanaktik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>*pero más, más** kwaltsi:n, a:mo semi..., wa:n yo:n seki kitelkwih ihkochimeh wa:n kitelkwih mo:yo:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>N' tein okseki nikihtowa ne:n alakcho wa:n yo:n tein ti:ltik a:mo okachi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Ke:mah mochi:wa, mochi:wa itech kahfe:n *o** itech chalawih no: mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Kahfe:ntah mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>Ke:mah, o:me taman onkak neh niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>A:, n' to:tolko:skat yeh nimitsilia mochi:wa tsikitsitsi:n, neli, neli tsi:tsikitsi:n ihkwí:n mahyá: *bobolitas**, yeh mochi:wa no: kahfe:ntah *o** ehkawtah ka:mpa se: tato:ka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>Ompa yo:ni no: mochi:wa yehwa yo:n pisi:ltik wa:n tein wehwei no: mochi:wa ehkawtah *o** kahfe:ntah no: mochi:wa, pero yeh wehwei ihkwi:ni mochi:wa wehwei. Seki *más** wehwei mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>Pero yehwa yo:n komo tikahsik yehwa yo:n xikwi wa:n niman x'mantehko *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>komo pano:tok a: no:, ka:n no: kwaltia ok se: kimana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>*Porque cuando** ki:sa n' iihtik mahyá: yo:n ye:kpopo:ka ya, ka:n wel se: kikwa ok, se: kikwa *cuando** yo:n pochiktsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Ke:mah, yo:n neh no: nikmana nochipa iwki no: taa:man sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>Pero yo:n mochi:wa neli kahfe:ntah *o** ompa ka:mpa se: tato:ka wa:n nejó:n ka:mpa owasintah no: mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>Ke:mah, tein tsikitsitsi:n pos yeh kwali se: kkohkoto:nilia sah n' imestkowyotsi:n ihkó:n wa:n iwki se: kimana ya. Wa:n tein wehwei pos se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>kkohkoto:na wehwei, se: kkohkoto:na *porque** wehwei, yeh a:mo wel se: kimana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>iwki ahsitok, we:i, we:i ihkwi:ni, yo:n ke:man se: nikahsika ihkwi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>Ke:mah, neli tikokototskeh para tikmahkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>Wa:n no: iwki tikwah no: taa:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Pané: a:mo okachi kanah xkita mah kinamakaka:n. Ke:mah, pero mochi:wa no: neli ke:meh i:n kahfe:ntah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>Pos a:mo n'mati *porque** ka:mpa tehwa:n titato:kah tika:ahsih i:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>Wa:n ne: okseko ttato:kayah i:pa no: tikahsiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>Pero ompa sah, ka:mpa titato:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts518" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>Wa:n kahfe:ntah neli mochi:wa pero a:mo, a:mo semi mah, mah nochi n' kahfe:ntah a:mo n'mati *porque** ke:meh tehwa:n tiko:nkwih i:pa ka:mpa tehwa:n sah tokahfe:ntah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>Ompa neli nikahsini. Ke:mah. Wa:n ompa ya n' ka:mpa ttato:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>Ka:mpa yo:n ye:kkwaltsi:n ta:ltsi:ni, ye:kti:ltik, ompa mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>Ka:mpa yo:n kwaltsi:n kipia *abono**, ke:mah, ompa mochi:wa. Wehwei mochi:wa neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>A:, neh niki:xmattok *porque** tehwa:n neli i:pa, i:pa ni..., nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>tikwitih wa:n nikmana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>A:, pos neli, ke:mah ta:taman se: kikwa. A:mo, neh. A:, neh nikahsika i:n ka:ya wehka:w sepa se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>Ke:mah, nikahsika wa:n ne: no:mantsi:n yetoya ok, nikwa:lmakatiki:s. Nikilia, teh xikwa ma: nikilia i:ni *porque** tehwa:n nikilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>ka:n miak nikilia, wa:n namehwa:n nano:metsitsi:n nikilia name:chahsis. Xkwa:ka:n nikilia. Nikwa:lmakatiki:s no:ma:ntsi:n mah yeh kimana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>Ke:mah, i:ihko:ntsi:n nikahsika, ihkwí:n se:, se: ololtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>A:mo, we:lik, ke:mah, nejó:n tehwa:n tikwah nochipa iwki sah, ke:mah, tika:manah sah ihkó:n, t'puye:liah wa:n tikmanah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>ika se: ko:ntsí:n wa:n yehwa ya yo:n pos neli i:pa a:mo t'we:ia:yo:tiah nochi *porque**  nochi *lo que es** nanakat nochi moa:yo:tia. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>Ke:mah, chi:ltaxkal neli no: onkak. Yeh, yeh nik..., yeh yo:n neli nikowani, yo:n a:mo a:mo ke:man nikahsi ka:mpa ip..., *porque** yo:n kihtowah ke:wa *solamente** yo:n kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>yo:n a:wa:kowit wa:n chini:nahkowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>Pero a:mo nochi ke:wa *porque** tehwa:n ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>ne:pa ka:mpa nejó:n tota:lpan ompa kite:ntekkah se: chini:nahkowit a:mo ke:man kie:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>Ke:mah, pero tikoko:wanih neli kihtowah kie:wa *que** yehwa chini:nahkowit wa:n a:wa:kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>Pero yeh wehwei ih..., yeh kihtowah *que** wehwei mochi:wa, pero neh nikowa *porque** tsikitsitsi:n, i:pa takokotots a neh nikowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>Wa:n nikchihchi:wa neli yo:n neli nikchi:wa chi:lposo:nyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>Wa:n tikta:liliah epaso:t. Ke:mah wa:n iwki tikwah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>We:lik kwaltsi:n no: neli. Wa:n no: tein sehselik *porque** tein chika:wak no: ye:ktahtakwa:wak a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Ke:mah, *pero más**, yo:n mahyá: te:teiktik wa:n n' okseki i:n nanakat a:mo iwki n' tikwah. Ke:mah, pero we:lik no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>A:, neh niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>Ke:mah, niki:xmattok *porque** tein ko:kone:meh neli ye:kkokotoka kwaltsi:n se: kimana wa:n tein chika:wak no: takwa:wak a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Yehwa yo:n neh nikmattok *porque** neh niko:kowani, yo:n neli nikowa a:mo ke:man nikahsi ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>ompa ne: nejó:n ka:mpa tehwa:n tota:lpan *porque** a:mo mochi:wa. *Más** mochi:wa kihtowah ne: we:ikowtahpa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>Ne:, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>A:, seki a:mo niki:xmati okseki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>Ihista:k no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>Ka:walpox n' yeh nimitsilihtok yeh *más** tihtilaktik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts642" TIME_SLOT_REF2="ts643">
                <ANNOTATION_VALUE>wa:n yeh ipanko mahyá:, mahyá: pantahta:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts644" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>Wa:n tein, tein xo:no:nanakat yeh ye:kpohpochiktsi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts647">
                <ANNOTATION_VALUE>Wa:n *más** ihkó:n kipia *ra:ra...**, ihkó:n kipia *ra:rayitas**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>wa:n okseki ne:n ma:tananakat yeh no: taman, yeh no:, yeh no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts650" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>yeh no: nimitsilihtok, yeh no: komo nejó:n se: kimana yo:n ko:kone:meh ye:kkwaltsi:n no: s..., kwaltsi:n se: kikwa wa:n komo chika:wak ka:n no: wel se: kikwa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>Totolko:skat yeh kwaltsi:n kokotoka yeh kwaltsi:n ema:nik no:, yo:n no: kwaltsi:n ema:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>Ke:mah, yeh ista:k no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>No: ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>Chi:ltaxkal yeh chihchi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>Yeh mahyá: panchihchi:chi:ltik wa:n itampa ihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>Seknanakat yeh, seknanakat yeh ipanko no: mahyá: ye:kma:ta:ltik no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>Ke:mah wa:n nochi iwki ne:n im..., imetskowyo, ke:mah mahyá: n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>mahyá:n neli nejó:n tahta:loh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>Ke:mah, iwki yo:ni n' seknanakat, ke:mah yeh niki:xmattok *porque** yeh neli ta:lpan mokehketsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts695">
                <ANNOTATION_VALUE>Wa:n neli no: ke:wa xo:no:kowit, pero a:mo okachi wa:n a:mo semi mah *seguido** mochi:wa, pos mochi:wa sayoh *cuando** tasese:ya, pero i:ksá: a:mo mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>A:mo nochipa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts706" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>A:mo ok, pané: nochi a n' tein nimitsilwih, ka:n teh niki:xmati ok *más** nanakat. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>A:, neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts714" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>*Bueno**. A:mo teihsá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
