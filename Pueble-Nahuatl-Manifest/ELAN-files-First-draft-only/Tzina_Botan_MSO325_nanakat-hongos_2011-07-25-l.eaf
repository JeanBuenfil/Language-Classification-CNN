        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Ke:mah, yo:n chikinte yeh a:mo, yeh a:mo wehwei mochi:wa, yeh tsitsikitsitsi:n pero mah..., nehnextik neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>Wa:n yo:n no: kwali se:, kwaltsi:n iwa:n ne: nejó:n emo:l se: kimana wa:n se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
