        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts225">
                <ANNOTATION_VALUE>Yeh ika n'mattok *que** kwaltia. I:pa iwki ne:chilia:ya note:iskaltihka:w, yo:n ka:n teh *kipasaro:s** kihtowa, mah ampó:n yeto kihtowa,</ANNOTATION_VALUE>
