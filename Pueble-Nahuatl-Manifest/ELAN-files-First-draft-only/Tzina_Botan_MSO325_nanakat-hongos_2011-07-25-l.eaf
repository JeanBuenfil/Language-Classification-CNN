                <ANNOTATION_VALUE>no: we:lik kwaltsi:n. Iwa:n a:ko:lin no: mah se: kkwe:choli wa:n ika chi:lxoxowik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>no: we:lik wa:n iwa:n yehwa n' ti:ltiket.</ANNOTATION_VALUE>
