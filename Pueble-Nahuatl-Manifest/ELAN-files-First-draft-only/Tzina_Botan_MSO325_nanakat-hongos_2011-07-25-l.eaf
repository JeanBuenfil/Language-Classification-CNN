                <ANNOTATION_VALUE>no: we:lik. Ke:mah, pero neli yo:n no: mochi:wa yehwa, itech yehwa yo:n chakaykowit wa:n yehwa nimits..., neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>itech yo:n xi:kalkowit, yo:n nochi kie:wa.</ANNOTATION_VALUE>
