        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>A:mo iwki sah, neh iwki sah n'chihchi:wa i:pa sayoh a:ko:lin n'ta:lilia, nikwe:cholia a:ko:lin wa:n yehwa ne:n chi:lxoxowik wa:n iwki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts242">
