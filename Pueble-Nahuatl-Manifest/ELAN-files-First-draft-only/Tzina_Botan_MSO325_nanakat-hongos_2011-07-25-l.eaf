        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>Ke:mah, wa:n kwali n..., pero yo:n *ma...**, yo:n taxi:kowa wehka:wa yetok, *porque** neh ye:k yo:n ke:man ya nikwito ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>nikahsik ne: ahko ke:ski wa:n iwki nike:wtinemi *porque** a:mo kanah nikahsitok *más** wa:n nikilihtoya nota:tahtsi:n komo nikahsik *más** nikilia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>yehwa ya n' chi:was e:mol nikilia pero yo:n taxi:kowa wehka:wa yetok, a:mo teh *kipasarowa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>Ke:mah, iwki, iwki yetok, mah se: kita:lihto wa:n *cuando** yo:n se: kkwiti a mah no: se: kahtselwi wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>wa:n no: nejó:n mochi:wa wehwei a wa:n se: kie:ktia wa:n se: kipante:milia ya n' e:mo:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
