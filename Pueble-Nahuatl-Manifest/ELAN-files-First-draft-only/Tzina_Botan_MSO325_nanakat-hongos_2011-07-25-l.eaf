        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Mah *cuando** yo:n se: kipante:ma ya n' et mah no: se: kipante:ma ya, *cuando** se: kichihchi:waki a pos oksik a wa:n se: kikwa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>A:mo, kwaltia se: ke:wtok, *porque** neh niketstok ompa neli.</ANNOTATION_VALUE>
