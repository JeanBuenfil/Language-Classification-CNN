    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="María Salazar Osollo" TIER_ID="María Salazar Osollo">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>Ke:mah, niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>A:, kikwa. A:, kikwa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Ke:mah, tsohya:k neli se: kiteki sah wa:n ye:ktsohya:k. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>A:, n' ihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Ke:mah neli, ta: niki:itani no:, pero a:mo ke:man nikita n' iteyo ke:niwki neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>A:mo ke:man nikita, peroniki:itani neli yo:n, yo:n neli yo:n ohololtsitsí:n wa:n neli wihwitsyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>A:, pos neli, yehwa yo:n neh a:mo ke:man nikita ke:ní:w ne:n nejó:n yo:n tikihtowa se:, se: kima:toka wa:n topo:ni, a:mo ke:man nikita *pero demás** niki:xmattok. Ompa mochi:wa. Wa:n yo:n no: mowi:wila:na ata. ¿Wa:n ompa sah ke:meh i:n ka:mpa se: tato:ka *o** mochi:wa ka:nika eski?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>Mochi:wa ka:nika eski ata. Ke:mah, ta: niki:ita neli no: neh ke:meh i:n ka:sá: ika ke:meh i:n kohkowtah se: kita moye:kpa:pacha:nia. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>A:mo we:lik. Ke:mah, ta: se: mokaya:was nikilia neh ke:meh yo:n kiliah ma:kwi:lkilit pero a:mo yehwa, ta: a:mo ta: nejó:n yehwa n' tein yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>kiliah tsohpikilit neli pero neli teltsohya:k. Ke:mah, ta: neli se:, se: kiteki sah nikilia neh wa:n ihkó:n se: kihnekwi neli nejó:n..., emah, pos nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Pos tak ka:sá: ika kikwah neli pero neh neli ka:n no: ke:man nikmahse:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>Kanah no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Pos a:man a:t ox ok pero tak nejó:n pos neli ke:meh tehwa:n nika:wí:n nikilia neh a:mo tikwah *porque** ke:meh n' tote:iskaltihka:wa:n nikilia neh ka:n ke:man te:chne:xtilihkeh, ta: tein kiku... ke:mah, tein... Ke:mah se: kikwa, pero neli de yehwa yo:n neli a:mo, neh a:mo no: ke:man neli ne:chilwih note:iskaltihka:w ox nejó:n mah se: kikwa pero neli i:pa sayoh yo:n nejó:n tia:yah ka:sá: ika wa:n nikili:s, ¿toni i:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>Kihtowa, ta: i:n kihtowa kiliah kihtowa, kihtowa yehwa kihtowa yo:n tsohpikilit, tein kihtowa teltsohya:k kihtowa. Nikilia, a:, pos neli nikilia wa:n i:n pos nikilia i:pa a:mo se: kikwa. Kihtowa kanah kihtowa, ka:n, tak ka:n we:lik kihtowa, ka:n ke:man nikteki kihtowa neh mah tikwa:ka:n kihtowa, ka:n ke:man ne:chne:xtilihkeh kihtowa mah tikwa:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Ke:mah, ta: tak yo:n i:pa, i:pa mochi:wa sah, pero neli moye:..., neli moye:kpa:pacha:nia ka:mpa yo:n owihka:n nikilia neh motelpa:pacha:nia. ke:mah, wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>A:, pos neli, ke:mah. A:, n' ihista:k, ke:mah neli ta: nejó:n niki:itani neli yo:n neli mowi:wila:na pero neli a:mo, a:mo ke:man nikita neh ke:ní:w ne:n iteyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>¿Wa:n ompa ki:sa ya n' iteyotsi:n? A:, pos neli. ¿Wa:n iteyo ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>A:, tihti:ltik. A:, pos neli. Ke:mah, ta: yehwa ika yo:n nikilia neh ka:mpa yo:n mochi:wa motelpacha:nia *porque** pos ompa, ompa nejó:n mochi:wtiw sah ne:n iteyotsi:n. ke:mah, ompa ixwatiw sah. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Ajá. Ke:mah niki:xmattok no: pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>pos pané: yehwa sah tein ika timonohno:tskeh, miak tasohka:matik tein tine:chilwih. Neh n..., neh nimono:tsa niMaría Salazar Osollo,niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Celina González Nazario" TIER_ID="Celina González Nazario">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>Yekintsi:n timonohno:tsatih de yo:n tsohpi:lo:kilit, ox tiki:xmattok n' teh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>Yehwa yo:n kihtowah ka:sá: ika kikwah, ke:meh nehkwí:n *por**, ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>ox Huehuetla ka:ni wa:le:w yo:n na:nah Victoria Núñez, yeh kihtowa *que** kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>Kikwa yo:n tsohpikilit, pero nika:n tehwa:n a:mo tikwah *porque** ye:k..., ye:ktsohya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>Tiktsohya:kmatih. ke:mah. Wa:n ne:n ixo:chiotsi:n ihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Ihista:k wa:n i..., iteyotsi:n ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>nejó:n kwaltsi:n *bohbolitas, pero** pawihwitsyoh mahyá: yo:n kowach nikahkwí:n onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>Wihwitsyoh wa:n nejó:n ke:man chika:waya ya kwaltsi:n se: kima:toka sah, topo:ni wa:n mi:xkepa n' ie:wayotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>Ke:mah wa:n... Neh niki:itani *porque** ke:meh i:n ka:sá: ika ke:meh yo:n nite:tapixkilia:ya wa:n onkak itech ne:n owasin. Motelchi:wa itech n' owasin, ompa mochi:wa. Mowi:wila:na, mowi:wila:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts48">
