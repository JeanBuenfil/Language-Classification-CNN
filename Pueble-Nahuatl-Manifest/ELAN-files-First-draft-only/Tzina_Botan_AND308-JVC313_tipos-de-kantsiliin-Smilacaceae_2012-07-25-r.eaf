                <ANNOTATION_VALUE>Pero ne:wí:n a:na:lpa a:mo n'mati ke:ní:w pero nika:n nikitaya nika:n, A:tsa:la:n nochi, ompa yo:n ke:man,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
