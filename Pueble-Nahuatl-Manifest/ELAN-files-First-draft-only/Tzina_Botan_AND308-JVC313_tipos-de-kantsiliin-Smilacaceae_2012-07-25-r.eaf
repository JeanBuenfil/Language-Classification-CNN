        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>tein chi:chi:ltik n' i[...], mah tikihto:ka:n *morado** no:,</ANNOTATION_VALUE>
