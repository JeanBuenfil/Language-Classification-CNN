        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>kahkokwi *machete** ke:mah kitek ikwitapi:l ihkó:n, kitehtektiw *cachitos, cachitos** ihkó:n</ANNOTATION_VALUE>
