        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Ke:mah *porque** tikowte:xi:mayah miakka:n tehwa:n tikitayah yo:n,</ANNOTATION_VALUE>
