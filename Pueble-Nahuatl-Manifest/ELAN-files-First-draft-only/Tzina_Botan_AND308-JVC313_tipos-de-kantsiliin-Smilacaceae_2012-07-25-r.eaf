        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>ista:k ya ihkó:n wa:n yowi itech ne:n, itech kwowit.</ANNOTATION_VALUE>
