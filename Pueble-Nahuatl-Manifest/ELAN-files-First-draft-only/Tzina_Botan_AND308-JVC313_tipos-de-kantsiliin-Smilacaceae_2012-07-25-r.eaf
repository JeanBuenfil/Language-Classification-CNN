        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>nmattok neh *porque** tikowte:xi:manih, ka:mpa ke:meh tik..., ka:sá: tikamohta:iyah wa:n nikitaya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>tikpaya:nah n' ima:tako:yo n' kowit wa:n ompa yowi n' kwomekat iwki ne: ke:s..., ke:schi:chi:ltik, mah to..., *o morado** tikihtoka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>Neh nikilia chi:..., *o morado, porque** telchika:wak n' tapalo n' chi:chi:ltik.</ANNOTATION_VALUE>
