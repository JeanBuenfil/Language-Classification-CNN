        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>wa:n yehwa yo:n te:kokoh no: komo se: mometskalakilia se: ima:ko,</ANNOTATION_VALUE>
