        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>A:, *na..., nauyaque**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>A:mo kitekik ok n' kantsili:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Wetsito ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>A:mo taxi:ko:to ta:... *Siempre**. Wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n mokwaltihka mo..., telkantsili:ntah n' Tepe:ihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>A:, pos onkak ne:pa ke:meh i:n tikihtowa, pos nika:n i:n ke:meh ekintsi:n nimitsilihtok nika:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>A:tsa:la:n, yehwa yo:n onkak yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>N' i..., n' ista:k wa:n chi:chi:ltik ne:n i..., n' iselo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>*Cuando** moskaltihtiw ihkó:n chi:chi:ltik, kwaltsi:n pi:ktok ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>Y..., yoh..., yo:n mopi:ki yo:n tikihtowa pi:ktok ka:mpa i..., ka:mpa ii:x, yo:n motsaktok ihkwí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>*Porque** ka:mpa n' ii:x kipia ke:meh eskia kokotsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>N' xiwtsí:n pi:ktok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>Wa:n ompa motohtoka kipia witstsitsí:n ihkwi:ni pero de selik selik ok no: n' witsti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>Wa:n de sepa chika:waya pos wehwei witsti ihkó:n kipia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>ye:ktakwa:wak, te:..., te:metskokoh no: de yo:n se: taksa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Mela:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>A:, pos yeh ih..., ko:koltik ihkó:n, chihkoltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>I:n komo se: mokwi:ltih ihkó:n se: kitila:na, te:kwitiw itech se: itilmah, kitsaya:na se: itilmah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>Ke:meh n' a:xiwke:nkech a:mo semi witsyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>A:mo witsyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Pos yehwa yo:n kintsi:n nochi tikmattia:tih katí:n de n' we:lik, ki:ní:n i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>ki:ní:n ipaniá:n, chi:chi:ltik oso ista:k, ke:meh teh no: tiki:xmati de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>chi:chi:ltik de n' okseki wa:n neh no: niki:xmati de n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>moskaltihtiw chi:chi:ltik, hkwi:ntsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>wa:n de moskaltihtiw ihkó:n ne: mopata ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>ista:k ke:meh eskia nextia. Yehwa yo:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>ne: ahko wehkapania wa:n ke:mah mowi:wila:na ya ne:wí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>Ma:ski se: kitila:nas ihkó:n, pero a:mo temowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>*Mo que** n' i..., n' ima:y ihkó:n tehtetsi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>Motetekwin..., ke:masá: kikwi xiwit ihkó:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>ma:s se: kitila:na ompa motetsi:lowa wa:n a:mo, a:mo wi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Miakka:n, miakka:n mopihpilowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Wa:n a:mo koto:ni n' komekat *porque** takwa:wak, n' kantsili:n takwa:wak n' ikomekayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n ke:meh eskia witskilit n' ikwa:pan se: kiteki wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>we:lik no: n' ikwa:pan, *porque** selik se: kikokototsa wa:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>N' ixiwyo ihkwi:ntsitsi:n wa:n selik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>Ke:mah, alaxtsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Ke:mah, n' iwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n se: kikwa chi:lposo:n. Yehwa nimitsilia ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>tehwa:n tikwa:yah chi:lposo:n, pero a:mo ke:man tikwa:yah ne: a:ko:loh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>Taixkal oso yo:n a:tamanal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>Sayoh kita:liliah istat wa:n iwki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>A:mo kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Pos tehwa:n no: tikwa:yah ma:ski n' imahma:yo, yehwa ya n' kita:lia:yah itech koma:l wa:n de achi tohtoma:wak pos tiki:xtilia:yah n' ie:wayo, *porque** n' ie:wayo kana:wak kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>Se: kiki:xtilia wa:n kisa de, de takweto:l ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>De takwetol, komo a:mo tata pos ki:sa kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>Masá: t'tehtekiah hkwi:ntsitsi:n wa:n tiktahtapa:nayah hkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Se: kitahtapa:na, *siquiera, siquiera** se: kiki:xtia *siquiera** na:wi, na:wi taman ihkó:n na:w...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts482">
                <ANNOTATION_VALUE>se: kiki:xtia wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>kimanah no: ki:sa *siquiera** ihkwí:n de miaktsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>No:, de n..., de n' selik, pero de n' chika:wak a a:mo no:, a:mo no: se: kikwiti ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>A:mo se: kikwi *porque** takwa:wak ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts495" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Wa:n de, de n..., de n' okseki ma:s tohtoma:wak yo:n nimitsilia de n' sehselik ihkó:n moskaltihtiw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>pos kwaltsi:n selik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>Se: kitehteki ihkó:n wa:n se: kitapa:na ye:kkwaltsi:n, ne:nke:n yoksi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>Ne:nke:n yoksi wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>Ke:mah, pos yehwa yo:n sah neh, neh nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>*Bueno** pos yeh...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>Ne:chili:s ne:n moto:ka:y wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>No: *igual** neh niwa:le:w ne: xola:lpan de San Miguel Tzinacapan, nimono:tsa Anastacio Nicolás Damián.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
