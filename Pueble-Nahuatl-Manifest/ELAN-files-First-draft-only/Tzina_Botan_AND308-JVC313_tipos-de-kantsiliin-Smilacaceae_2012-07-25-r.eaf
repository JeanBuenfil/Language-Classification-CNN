                <ANNOTATION_VALUE>n..., mochi:wa nikahkwí:nAte:kohkomolkopa n' tehwa:n tikitayah, ompa titekitiah nochi, A:tekohkomol nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
