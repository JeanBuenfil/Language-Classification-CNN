                <ANNOTATION_VALUE>wa:n koli:nih ya n' kowa:t ka:n..., ne:pa etok, kwa:lkehtson nika:n itankwa:ko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>Kanah, etoya ta:lpan, nika:n tetsi:ntan, tetsi:ntan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
