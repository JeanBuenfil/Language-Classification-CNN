        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>ke:meh kikwehtsomaya kit kikwa:tsoma:tsoh ihkwí:n wa:n kahok n' kowa:t ihkwí:n ta:tahtsi:n, *hasta** ahko *hijuemala**, wehkapantik n' ta:tahtsi:n,</ANNOTATION_VALUE>
