            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Ompa mochi:wa nochi xoxoktik, pero nikahkwí:n... Ke:mah ista:k, ista:k pero yo:n xoxoktik n' ikomekayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
