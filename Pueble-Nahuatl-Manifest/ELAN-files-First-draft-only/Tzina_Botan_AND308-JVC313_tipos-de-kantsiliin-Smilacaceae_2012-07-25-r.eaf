        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Ke:mah wa:n tikpaya:nah n' kowit, tikitah *hasta** ahko ya nochi iwki ne:n</ANNOTATION_VALUE>
