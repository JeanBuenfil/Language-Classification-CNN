        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>nejó:n yeh panki:sa wa:n moskaltia we:i n' kantsili:n, mos..., yowi sake:ra se:, wehkapan yowi se: chikwe:i *o** mahtakti *metro o** kachi ok,</ANNOTATION_VALUE>
