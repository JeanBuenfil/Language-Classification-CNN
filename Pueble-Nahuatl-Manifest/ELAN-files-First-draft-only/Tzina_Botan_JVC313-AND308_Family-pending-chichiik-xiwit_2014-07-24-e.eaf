                <ANNOTATION_VALUE>Ke:man domingo kinamakah Cuetzalan *o** jueves se: kitati ne: kampa ki..., tanamakah n' tokniwan kwalkwih de parahko witseh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>Kwalkwih miak taman tanamakakih ompa e..., kwalkwitewah yo:n xiwit ne:, ma:ika:nehnextik wa:n tepitsi:n mohmoloxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>Wa:n nejó:n yekma:..., mahyá: ma:pihpitsa:wak sah pero yekmiak n'ima:y mochi:wa ke..., ke:meh sempowalxo:chit pero tel..., telmiak xiwit kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Wa:n nejó:n ma:ika:n..., [ma:ika:n]nextik wa:n moloxtik n' ima:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>Wa:n kitekih ihkwikwintsitsí:n sah kwalkwih a:mo n'mati ke:ní:w wehkapan mochi:wa ne: ka:mpa kwalkwitewah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>Ihkwi:kwini wa:n se..., semi kwali pali..., pahti para *bilis** kimanah n' siwa:meh ke:meh yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>seki ihtioli:nih *o** kinkokowa inihtik kiliah *bilis**, yehwa n' momaniliah wa:n taih wa:n k'kotonilia n' kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
