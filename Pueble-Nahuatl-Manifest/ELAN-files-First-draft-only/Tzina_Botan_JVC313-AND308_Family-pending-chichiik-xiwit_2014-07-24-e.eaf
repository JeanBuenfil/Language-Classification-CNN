        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Wa:n no: nikahkwí:n no: onkak n' tehwan ne:pa ihkatok se: *mata** yo:n xiwit, no: yehwa pero no:... Yeh a:mo ma:i:ka:nnextik yeh ne: xoxoktik sah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>wa:n ke:meh eh..., kemeh mo:so:t ne:n imaxiwyo. No: i..., iwki n'imay yek m..., ma:..., mahyá: telmiak n'imaxiwyo wa:n ma:mahmaxaltik semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>Ke..., wa:n nejó:n,</ANNOTATION_VALUE>
