        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>Weyakaxtik. Wa:n yo:n no: tikmattok ne:n nikneki nikmatis ne:n ¿Ke:maniá:n ki:sa ie:wayo, mopatah?</ANNOTATION_VALUE>
