        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Wan yo:n x..., yo:n xilimeh kanachi ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>¿Kanachi taman xilimeh mokalakiah itech nejó:n a:chikiwit? A yo:n wehwei, ihkoko:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Wa:n k...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Wa:n ¿kanachi taman xilimeh tikini:xmati?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Ma:chiko wa:n kanachi taman *den** xi..., xilimeh ne:n tiki:xmati ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>ka..., a:mo onkakeh.</ANNOTATION_VALUE>
