        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Pos aki nika:n timona:mikih sepa nikahkwí:n, ne: nikneki nimitstahtani:s ox tiki:xmattok yo:n kwamekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>E: kihtowah kikwih n' para a:chikiwit *o** para yo:n so..., *so:sombrerohmeh** kininnamakah para koyo:meh kwi:kah wehka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>yo:n kwomekat tiki:xmattok ka..., ke:niwki *o** ka:ni mochi:wa yo:n.</ANNOTATION_VALUE>
