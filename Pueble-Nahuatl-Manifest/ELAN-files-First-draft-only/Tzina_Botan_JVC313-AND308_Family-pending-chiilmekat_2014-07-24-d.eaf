        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>Ka:n ke:man tikita n' ixo:chio ke:niwki yo:n, pos yo:n ixo:chio ne: kohkostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Kostik, n' ixo:chio kohkostik wa:n nejó:n neh niki:xmattok *porque** de i:n se: xiwit ka:mpa i:xta..., n' ta..., nitato:kka nika:n A:watepe:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>takwapan *taesquina**, ka:mpa Miguel Santos ta:tahtsi:n itatsi:ntan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>[i]wa..., iwa:n mona:miki ka:mpa n'tato:kka, ompa onkak ne: yo:n n' kwomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>onkak n' komekat *porque** nikitak neh ompa ke:meh tetah, texahkalah, onkak n' komekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>Yo:n a:mo kanah onkak nikahkwí:n *solamente** ompa nikitak neh onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>yo:n we:weyak mochi:wa ke:meh tata:wikmekat, mowila:na ta:lpan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>wa:n nejó:n yehwa yo:n kitekih wa:n ki..., kikwiti n' akin kineki kichihchi:was yo:n chikiwit *o** teisá: akin kichi:wasneki *ar..., artesanía** kiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Ki..., kixokoltia, ka:pachowah ke:meh yo:n xo:no:t, ka:pachowah wa:n ke:mah xokoya ya n' ie:wayo, kiki:xtiah ya, kwaltsi:n ki:sa n' e:wat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts91">
                <ANNOTATION_VALUE>Wa:n yo:n ki:sa n' e:wat ke:mah ki..., yo:n sayoh para ika tahkitih sah ke:meh yo:n xo:no:t kichihchi:wah wahkal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>Pero komo ... Tein kichi:wa n' a:chkiwit, a:kin kichi:wa n' a:chikiwit, kite:mowa yo:n, komamo tata:wikmekat, poposokani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>kite:mowa n'pisi..., pitsaktsitsi:n ne:n komekatsitsi:n para kwali kichihchihkolo:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Neh n'mattok no: n'chihchi:wani n' a:chikiwit no:, no: ne: kowtah tietoyah no: nimomachtih ke:ní:w n'chi:was n' a:chikiwit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>para niki:tskiaya xilimeh. Wa:n nejó:n se: kiteki se: [ki]ketsa se: ma:it ne:n, ne:n kwamekat. Ke:meh se: kinekis, komo se: kineki we:i n' chikiwit pos *mas** we:i se: kiteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Ke:meh se: ik... Ihkwí:n de weyak ne:n, ne:n kwomekat para kwali t'chikolowa, yo:n se:, yo:n se: kwaolo:chilpia kwomekat achto,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>tikkwa:olochilpia wa:n ke:mah tik..., tikweta:nia ya tik..., sepa tike..., se:pa tikilpi:ki nika:n ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>pero neh achto, achto nikwa:olochilpia wa:n ke:mah nika:n nikihkitia: n' ika n' kwomekat, nikihkitia ika n' kwomekat, nikihkiti a, ihko:ni, nikta...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>[niksa:sa:lowa]ke:meh kwesal..., kwesalkwa:akat se: kichi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>wa:n i:n, oso ihkwí:n ya, se: *pedacito** ihkwini a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>ke:mah n'chihkolowa ya n' komekat wa:n nika:n nikilpia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Nikolo:chilpia nika:n itsi:ntan ya wa:n nika:n nik..., sepa niknekwa:lo:tia ihkwí:n n'chi:wtiw n' komekat, n'chi:wtiw, n'chi:wtiw, n'tsaktik, *hasta, hasta** n'tsakwati a, *hasta** nika:n n'tsakwati a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Wa:n i:n moka:wa, moka:wa ne:n ... Yo:n koyok moka:wa taihtik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>wa:n nika:n ike:spa ya ne:n *casi** nika:n mahyá ihkó:n yetok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>te:nkoyo:ntok a, n' *trompeta** yetok taihtik wa:n nika:n yetok sepa n' itsi:ntayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Ompa ke:mah se: ki..., se: kikwaltilia ya pos, newi:n se: kita:lia, sepa se: kichi:wa se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>kowtepah i..., tikta:litia n' *trampa** i:n yowak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>tein nika:n t'te:nkwaitia ika se: *hilo** tein se: tein takwa:wak para a:mo koto..., koto:nis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Wa:n ke:mah tikta:lia ya nakatsi:n ke:meh yo:n pitsocho:pih, *siempre** tehtewa:ki para a:mo tamantias niman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>T'ta:lilia ne:n nakatsí:n wa:n ke:mah de t'ta:lia *siquiera** o:me oso e:yi tet tikta:lilia a:tet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>Tikalakia taihtik [de]n' chikiwit wa:n ke:mah t'pankahka:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Wa:n yo:n tiktamo:tas n' a:ihtik a:mo mah tapachiwto ihkó:n, mah a:mo tapachiwto n' chikiwit *porque** yo:n tsi:npata:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>mahyá: se: xi:kaltekomat. Yo:n a:mo, yo:n tik..., tikoli:ni:s para mah mahkets..., mah mokets..., mah moahketstite:ka ihkó:n ne:n chikiwit, mah te:nkoyo:nto komo ke.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Ihkwintsi:n ih..., ke:meh nika:n yetok ihkwí:n sah i:n wa:n koyoktik ihkwí:n, mahyá: *trompeta**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>witsa ya xili, kite:mowa nika:n mah kalaki pos a:mo ne: yo..., pankalakia nika:n, m' pantsikwi:ni a, ompa ya kikwa nakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Wa:n motra:mpahwia,kisasneki, a:mo wel ki:sa *porque** ne:n ite:noh moka:wa ehekai:xko ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>nentinemi nika:n ike:spa ihkoni a ne:n xilitsí:n, ompa yetok *hasta, hasta** ompa tane:si, tikahsiti:w ompa ya komohkó:n teh...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>Ompa moka:wah xilimeh, nikita neh *porque** nikinki:tskia ya ihkó:n neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Neh iwki ninki:tskiaya n' a:chi..., niki:xmattok n' a:chikiwit, kwali n'chihchi:wa no: neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>No: n'chihchi:waya neh, ke:mah *porque** i:n *tipobres** nochi timomachtiah tehwa:n para tikeko:skeh teisá: tapalo:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>nochi timomachtiah para tikinki:tski:skeh n' okwiltsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n tikchihchi:wah, neh niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>Moka..., mokalakiah mekos wehwei, *hasta** ihkó:n yekinachichi mekos mokalakiah, ke:mah n' mattok ompa tiahkah ne: kowtah wa:n nikchihchi:waya a:chikiwmeh, ekints..., nikpiaya ma:kwi:l a:chikiwmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>*De, de** tio:tak nika:wati a wa:n kwalka:n sepa nikwiti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>wa:n tonaya:n nikochtia kaltsi:ntan para a:mo kitaskeh ne:n *vecinos** ke *porque** nexi:kolmeh ne:chwehwelowili:skeh *o** tes..., kwikaskeh yehwa yo:n kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>wa:n para a:mo ne: ... Pos *mejor** nika:wati, nikwiti nika..., nikwiti n' kwalka:n wa:n tio:tak nika:wati, yowak a, iwki n'chi:waya neh para nikitskiaya n' okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>Nikitskiaya *hasta** ihkwí:n mekos, yo:n tomak..., ma:tohtomaktikeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Ne A:tmo..., ka:mpa weitahchiktet e:, parahko yetok se: o..., ompa ne: tamiti a ka:mpa mochi:wah xilimeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>pantsikwi:ni se: a:tsi:n ata, yo:n ka:mpa pahpatatah, ka:mpa kiliah yo:n pahpataa:paneco ya ita:lpan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>ompa nikonta:lihka sepa, ne: o:me a:chikiwit n'ta:lito, mostika nikwito pepe..., pehpexo:ntokeh xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Pe..., nochi ma:chikomeh kohkostikeh nikwito, ika yo:n, ika yo:n chikiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>ke:mah wa:n ompa soh onkakeh nimitsilia, ahkokopa a:mo onkakeh ok, *bueno** onkakeh ... Ekintsi:n a:mo onkakeh *porque** kintamihkeh ika pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Yehwa niki:xmattok yo:n a:chikiwit kit wa:n no: kihtowah ke:n..., nikakiliaya nowe:ita:tah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>ke no: kitemowaya yo:n yehwa yo:n kwomekat ne: wa:n kichi:wayah kimanoh:tetekwinowayah nochi ika n' ixiwyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>wa:n kitsontewiayah tehtekwako ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Yo:n kitsontewiah para ika kimpahwiah ika yo:n pescaditos a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Wa:n ke:mah *kinkwetehwiayah** ya yo:n koko:k no: *por eso** ne: nejó:n ika, ika mikiah *o** kisayah a:te:n, kini:xkokowaya wa:n kininkwa:motayah ika *kweteh** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>Ne:n xilimeh, pos xilimeh onkakeh, ne: nika:n tehwan onkakeh ma:xakameh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>ma:xakameh yo:n a:mo ma..., maxaltik n' ima:i, yeh ma:xaka yeh komo te:kehtsoma te:natskwaltia sah ihkwí:n, te:natskwaltia sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Kipia iisti se: sah yo:n *cuando** teisá: kichi..., te..., se: kwa..., wa:n se: kite:natskwaltia, ihkó:n ya kichi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>wa:n nejó:n kwaxaxa..., xaxakachtik n' ikwako wa:n nika:n nochi n' i..., ipanko komo ke ikakawyo nochi xaxakachtik wa:n *medio** tohtohmiyoh tein okich,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>wa:n tein siwa..., siwa:maxaka, yeh alaxtik wa:n achi tsikitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Wa:n yo:n seki onkakeh ne:n kwa:poye:kxilimeh yehwa: yo:n tekehtsomah yek *fuerte** kwa:poyekxilimeh pero yo:n tsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>kwa:poye:kxilimeh no:, yo:n kipia tet n' ikwako, yo:n komo se: kikwa ya se: kixaxawatsa iwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Yo:n xi..., o:me taman ya, wa:n ika n' e:yi taman, ne:n ma:chikotsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>E yeh ima:chikot..., kiliah ma:chiko *porque** se: ima:y weyak wa:n se: tsikitsi:n, ika kiliah ma:chikomeh. KK</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>Wa:n ne: koso:lin tein wei koso:lin yeh ne:n ni..., ima:y e..., *iguales** sah nochi, nochi achi n' o:me ima:y,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>yeh tomaktik sah yo:n koso:lin kiliah, wa:n, wa:n me:koh, me:koh yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>yeh nejó:n, [ye:k weyak]mochi:wa wa:n, wa:n ma:ski pili ok pero mota ke me:koh mochi:wati *porque rarayado** ihkó:n ne: ki:x..., xoxoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Xoxoktik ihkó:n *desde** ikwitako:n, ata kwi:kwiltik, ihkwí:n *rayado** hasta, hasta ipanko, nika:n ikechtipan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Wa:n ite:ntson we:weyak wa:n, wa:n ima:y de ima:y chihchi:chi:ltik ne:n ima:wa:n komoke. Ke:mah wa:n maski pili ok pero niman mota ke meki:toh mochi:wati *porque rayado** n' ikwitako:n nochi ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Wa:n moskaltia wei, mochi:wa wei n' chik..., yo:n okwilin *hasta** ihkwí:n tomaktik mochi:wa ne:n ikwitako:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>wa:n ima:wa:n tein wei *hasta** ihkwí:n tomaktik n' ima:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>No: nakayoh n' ima:y yo:n meko wa:n ite:ntson *hasta** ihkwí:n we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Yowi, yowi ikech..., ikechtipan ihkó:n *hasta** ikwitako:n kitamilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Ke:mah weyak, wehwei no:, yehwa yo:n ne: ... Miak, miak taman xilimeh onkakeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Pos yo:n mopatah itech *mayo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Itech *mayo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>itech *mayo**mopatah wa:n se: taman onkak xilimeh tikihtowah ista:kxilimeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>pero nika:n a:mo okachi onkak, onkakeh nika:n, nika:n Ti:ltika:t Tos..., Toskapochi:nitepe:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>Toska..., [Toska]pochi:ni tani, tani *de, de** Xa:ltipan nochi ne:n nika:n Na:wala:ko ompa onkakeh ne:n yo:n ista:kxilimeh, yehwan tikoliniti:w, ahkopata:ni ihkwí:n wa:n a:mo wel tikitskihkeh tik..., tikta:lis ma:tat, pata:ni sah ihkó:n wa:n tsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>Ompa n' onkakeh pero nika:n tehwa:n a:mo onkakeh, nika:n Tahchiktekopa a:mo onkakeh yo:n ista:kxilimeh. Onkakeh ma:xaxakameh sah wa:n i:n nimitsi[lia]xi..., xilimeh seki taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Wehwei ma:xa[xa]kameh, ne: A:wa:tepe:k mochi:wah yekwehwei ma:xa[xa]kameh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>yekwehwei xahxaxakachtikeh inachichi yo:n okichmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>Wa:n nika:n Ahkokowtah mochiwayah ma:xakameh mo..., onkayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>ompa ne:n no: taman *mi.., mismo** ma:xa[xa]ka pero tsikitsitsi:n wa:n *de colores** seki kostik, seki ti:ltikeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>wa:n tsikitsitsi:n ne:n xilitsitsi:n, nika:n Ahkokowtah mochi:wayah no:, pero ekintsi:n tankeh ika n' pahti kitamihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>Ke:mah yehwa yo:n niki:xmattok xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>No: pahti, pahti wa:n para se: kichi:was a:chikiwmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Ke:mah o:me taman kwaltia, ke:mah ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Pos yeh..., yehwa sah neh nik..., nikmati wa:n teh xa: tikmattos ke:ní:w ne: para toni yo:n ke tei *servirowa o** ke:ní:w yo:n teh tiki:xmattok ke:ní:w tiktokaitia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>Pos neh ne:chilikeh ihkó:n nota:tahwa:n ke mono:tsa ne:, ne: kiliah ne: ko..., ko..., yo:n koko:k yo:n, kiliah chi:..., chi:lmekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Pankohkoko:k, mahyá: chi:l..., ke:meh chi:ltekpin, pero ki:x..., ki[ni:]xkokowa n' *pescados** ne: kimpahwiah ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>Kitsontewiah wa:n kini:xkokowa *por eso** ki:sah a:te:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Ke:mah, Ke:mah a:ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>A:mo ika mikih *sino que** kimpanawia sah pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>pero yo:n sayoh kinoli:niah ika para kinimo:tah ika *kwete**, kinimo:tayah achto ika *kwete** ne a:te:n, kampa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>kampa a:t sese:k tepitsi:n ki:stok ompa motehtempilo:tih ne:n *pescaditos** yo:n, yo:n ihkwi:..., ihkwi:kwí:n de wehwei ne:n *truchas** onkayah n' ihwak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>Kampa onkak n' a:t ihxi:katok n' a:t sese:k wa:n a:mo pahyoh ompa mote:mpilo:tih *pescaditos** para mopale:wiah tepitsi:n para i..., porque ii:xtololo kinkokowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>ke:meh koko:k, i:xchi:lowah mahyá: yehwa n' *por eso** mota:litih ne: ka:mpa sese:k n' a:t *o** a:te:n mota:liah pos ompa kinkwatsontekih ya oso kininkwetahwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Iwki yo:n kichi:wah, ehe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>Yehwa sah yo:n nejó:n tine:chtahtania wa:n nejó:n yehwa sah nikmattok neh, ke:mah. Ke:mah, yehwa sah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>Pos neh ni..., nimono:tsa niErnesto Vázquez, niwale:w San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>Tasohka:matik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
