        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>A:mo koto:ni.</ANNOTATION_VALUE>
