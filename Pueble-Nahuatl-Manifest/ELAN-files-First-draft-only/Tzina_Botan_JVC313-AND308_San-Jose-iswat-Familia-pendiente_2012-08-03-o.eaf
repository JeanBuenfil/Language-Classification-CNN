    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="José Ernesto Vázquez Chanico" TIER_ID="José Ernesto Vázquez Chanico">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>Ke:mah, ke:na:mo ne: san jose:iswat niki:xmattok wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>yo:n i:pa se: taman sah, a:mo onkak miak taman, i:pa se: taman sah san jose:iswat, ka:mpa eski tikitas kito:kah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>nika:kwi:n, ne: tanikwa:kopa, nika:kwí:n yowalicha:npa *o** ne: Reyeshogpan, tikitas i:pa se: taman sah, ka:mpa eski tikitas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>*Este** se: taman sah i..., ineketsalis xo:chit, a:mo teisá: *más** we:wehkapantik, nió:n *más** ta:lpantsi:n sinoke</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>i:pa ihkwí:n sah mochi:wa wa:n e:wa ta:lte:noh. Yo:n a:mo kow..., a:mo kowyoh ke:meh, ke:meh nex..., nexkoko:kiswat, a:mo kowyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>Yo:n nehjó:n ta:lpan sah mochi:wa, ki:sa wa:n panki:sa de n' tako:tsi:n wa:n iwa:n ... *Cuando** panki:sa ke:meh yo:n pahpataiswat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>tetekwiniwtiwi:ts *cuando, cuando** yo:li yo:n is..., iswat, tetekwiniwtiwi:ts, yo:n ke:meh se:, ke:meh yo:n kichi:wah tokni:wa:n yo:n iyatsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>chichi..., tetekwiniwtiwi:ts wa:n moma:pata:wa ya, moma:pata:wa, sepa se: ki:sa de n' i..., yo:n *cada** taktson kipia semi ne: ixiwyo ke:meh se: chikwase:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>chiko:me kite:maka ixiwyo ata yo:n, yo:n san jose:iswat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Wa:n yo:n nehjó:n imetskowyo achi, a..., pa..., pané: mets..., metschihchi:chi:ltik pero a:mo semi chi:chi:ltik, mahyá: *morado** ne:n imets,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>ne:n i..., ka:mpa i..., ka:mpa ta:lte:noh e:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>Ke:mah mah..., mah..., mah[yá:]*morado** imets wa:n, wa:n nehjó:n ima:xiwyo pa:pata:wak, ye:kpa:pata:wak ima:xiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>Wa:n chi:chikotik, chi:chikotik ima:xiwyo, a:mo kipia iyo:lkowyo pero a:mo *mero** tatahko, kipia i..., sentapal tsikitsi:n i..., ne:n ima:xiwyo wa:n sentapal ne: ye:kpatakaxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Ke:mah, chikotik yo:n, a:mo ke:meh, ke:meh yo:n nexkihiswat *o** nexkoko:iswat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>Yo:n tatahko yowi ne:n iyo:lo wa:n moma:itia ni:nipaka, iw..., nochi iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>Ne: a:mo, ne: chikotik, se..., sentapal pitsaktsi:n wa:n sentapal ye:kpatakaxtik ne:n san jose:iswat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Ke:mah wa:n, wa:n seki tein tel, tel, teltawelita tak ne:n san jose:iswat ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Ima:tampa ne: chi:chi:ltik *hasta** me:diomo..., *morado** ima:tampa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>komo ima:yekapan ya, ne: *morado** ne:n iswat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>wa:n yo:n i..., i:x..., ata i:xkahkana:rtik, i:x..., pané: i:xra:raya:doh ne:n iswat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>E:wa de itech iyo:lkowyo wa:n ima:te:mpayo yowi ihkó:n. Ke:mah yo:n, ke:mah tehtekochtik nochi kitekpa:na, ka:mpa pe:wa ima:tsi:ntan *hasta** ikechtan nochi i..., iekapan ne:n xiwit nochi tehtekochtik ihkó:n, mahyá: ka:niohtsitsi:n kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Wa:n nochi iwki yo:n wa:n *siempre** kahkana:wak wa:n yo:n nehjó:n ixo:chio mochi:wa no: chi:chi:ltik wa:n wehkapania, ihkó:n sah de wehkapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Ke:meh e:yi kwarta de wehkapan mochi:wa wa:n kwa:oholo:chtik, sayoh sentapal moahkokehketsa wa:n kwa..., ikwa..., iyo:la:n mochi:wa kwa:oholo:chtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>Yehwa yon neh nikilia san jose:iswat wa:n nehjó:n de poso:ni yo:n i:x..., ix..., poso:ni, i:x..., ompa, ompa moka:wa ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>xokoya, ye:kalaktik yo:n ikwa:payo ixo:chit, ye:kalaktik wa:n nehjó:n a:mo n'mati ox teyowa oso ke:ní:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>pero nikita xo:chiowa ne: yo:n kowtet wa:n ompa moka:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>A:mo, pos ka:n, ka:n 'mati, pané: ka:n ke:man nikita ika taa:ketsah pero kwaltsitsi:n no:, kwaltsitsi:n no: xo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Chihchi:chi:ltik wa:n a:mo mets..., a:mo ma:xiwyoh sanoke metsmehmelaktik de se..., ima:tsa:la:n wa:le:wa ne: ta:lte:noh ne:n iswat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>wa:n panki:sa ke:meh se: e:yi, na:wi kwa:rta semi we:weyak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>wa:n ikwa:pan mo..., mota:lia olo:chtik ne:n xo:chit ihkó:n,</ANNOTATION_VALUE>
