            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>Koma:mo se: kwi:ka ne:n ihkó:n teisá: ika se: kilpi:s pos ika komekat kwali ika se: kilpia.</ANNOTATION_VALUE>
