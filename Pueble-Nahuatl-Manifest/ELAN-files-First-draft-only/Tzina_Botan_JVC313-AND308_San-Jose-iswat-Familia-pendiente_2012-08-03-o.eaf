                <ANNOTATION_VALUE>Wa:n taxkaltsi:n a:mo kixokoltia *porque** mahyá: wa:kkatik yo:n iswat, a:mo a:yoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Yeh ika, yeh ika kwelitah seki yehwa yo:n san jose:iswat wa:n kwelitah kachi *porque** ke:meh yo:n pitsoomit kikowah ke:meh yo:n i..., ilo:moh, ilo:moh pitsot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>kwali wehwei kita:liah omit ne:n tixti wa:n wehwei kipi:kih, kwaltsi:n kipi:ki yo:n xiwit *por eso kwelitah yo:n, yo:n san jose:iswat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>Ka:n teh ahwia:k nió:n tei, a:mo kahwia:lia, n' tamaltsi:n a:mo kiahwia:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>A:mo, a:mo teh ahwia:k, mahyá:, mahyá: to:tomo:ch. To:tomo:ch tepitsi:n ahwia:k yeh mahyá: mah to:tomo..., taxkaltsi:n kita:li:kih to:tomo:chtsohya:ya ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>To:tomo:chtsohya:ya pero ta:taman, ta:taman tik..., tikwah n' tamaltsi:n, seki kipi:kih ika, ika iswat, seki kipi:kih ika to:tomo:ch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
