        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts513" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>ihwa:k tikiliah ne:n santo *porque** pos ne: tein te:chka:wte:wkeh pos no:, pos no: kihtowah seki ne:n no: moke..., a:mo ke:meh i:n tehwa:n, no: mokepah komo santos a.</ANNOTATION_VALUE>
