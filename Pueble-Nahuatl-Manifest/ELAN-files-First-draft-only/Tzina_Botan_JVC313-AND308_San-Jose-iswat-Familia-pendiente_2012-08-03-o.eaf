        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>chi:chi:ltik xo:chitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>No: kwaltsi:n moitas ta komo ika se: taa:ketsa ika, pero ka:n a:kin kiteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>A:mo akah kiteki, yehwa yo:n niki:xmattok wa:n yo:n iswat no: ika kipihpi:kih ne: tamal..., nakatamaltsi:n ke:meh i:n, i:n tiehkoh *todos santos** kite:mowah yo:n. Kachi kwaltsi:n yo:n *porque** kahkana:wak, a:mo tsaya:ni.</ANNOTATION_VALUE>
