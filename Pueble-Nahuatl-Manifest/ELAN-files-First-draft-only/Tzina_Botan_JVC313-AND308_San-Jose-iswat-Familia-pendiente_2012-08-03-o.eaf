                <ANNOTATION_VALUE>Pero nakatamal ne:pa tehwa:n to..., tikmattokeh ke ke:meh i:n ehko *todos santos*</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>tikte:mowah yehwa yo:n san jose:iswat koma:mo tikte:mowah ne:n nexkoko:kiswat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>pero yo:n san jose:iswat kwaltsi:n para n' tamaltsin ki..., kanaktsitsi:n wa:n taxkaltsi:n a:mo kixokaltia, taxi:kowa wehka:wa yetok, a:mo xokoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
