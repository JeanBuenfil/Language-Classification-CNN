        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>Tak no: tiknemiliah wa:n tik..., tak ke:meskia yo:n se: kitstoskia pero a:mo no: yetok de ke mah tikitaka:n ta: yeh no:, no: se..., ne: seko mose:wi..., mose:wihtok a.</ANNOTATION_VALUE>
