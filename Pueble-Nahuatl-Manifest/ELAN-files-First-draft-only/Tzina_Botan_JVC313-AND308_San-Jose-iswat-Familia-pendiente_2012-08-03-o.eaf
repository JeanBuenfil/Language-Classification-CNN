        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>Pos yehwa sah neh nik..., no: nikmati de i:n san jose:iswat, de n' ke:maniá:n kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
