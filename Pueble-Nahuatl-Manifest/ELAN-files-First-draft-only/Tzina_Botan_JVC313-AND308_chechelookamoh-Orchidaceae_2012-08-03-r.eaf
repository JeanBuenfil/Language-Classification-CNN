            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Ompa ya, ompa ya moka:wa ya ne:n ...</ANNOTATION_VALUE>
