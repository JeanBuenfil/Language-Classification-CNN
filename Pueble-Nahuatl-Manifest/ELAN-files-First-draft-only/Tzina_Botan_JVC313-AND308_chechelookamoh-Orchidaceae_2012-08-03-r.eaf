        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Pos sasaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>A:, ise:lti, a:mo teh kita:liliah tepitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>Se: kehke:wa ya, ki:sa yane:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Ahwayoh wa:n ne:hjón ... Pero neli kina:miki ke:meh yo:n se: mokelo:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>A:, kina:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>*Casi** para mah kikwi ne:n nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Mah kitila:na ke:meskia wa:n ke:meskia mah kite:na:mikti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>*casi** yo:n kwali ke:meskia sasaltik, ki..., kikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>Te:kokoh tal..., talwameh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>I:n ke:meskia wehweliwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Pos no: kwaltsi:n ne:n se: kimati ne:n, ne:n chechelo:kamoh, ke:meh ekintsi:n tine:chilihtok pos no: sepa neh no: *igual** nik..., nikmattok yo:n chechelo:kamoh ne:wí:n ana:l no: timopahtia:yah, te:chpahtia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Yo:n tehwa:n tiktehtekiah kwaltsi:n ihkó:n tik..., tiktehtekiah wa:n nochi tikxahxama:nia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Wa:n tik..., te:chta:lilia:yah ka:mpa yo:n, eski ke:masá: se: wetsi wa:n se: moma:xama:nia oso se: moposteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>entó:s ompa te:ta:lilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>Ma:ski te:chwi:kayah ihkó:n tapahti:lo:ya:n pero *siempre** de se: ehko, siempre kihto:skeh x'te:mo:ti yo:n chechelo:..., chechelo:kamoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>yo:n kwaltsi:n sasaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>*O sea**, sasaltik wa:n ye:k..., ye:kahwayoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Ahwayoh wa:n neh nik..., neh niki:xmattok sayoh se:, se: taman de yo:n, no: nikitani okseki ne: yo:n achi we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Ihkó:n achi we:weyak ihkó:n yehwa yo:n wa:n wihwitsioh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Pero neh a:mo nikmati no: ox pahti wa:n no: kwali a ekintsi:n tine:chilih wa:n pos neh nikmattok de n' oksé: taman oksé: chechelo:kamoh yo:n, yo:n ihkwí:n de we:weyak wa:n tohtoma:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>Yo:n tohtoma:wak wa:n kwa:pihpitsaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>Wa:n ka:mpa ne:n e:wi pos itech ne: kowit, ike:span.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>Ka:mpa se: kita seki wehwei, ihkó:n sikie:ra na:wi oso ma:kwi:l yetok de wehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>wa:n seki tsikitsitsi:n e:wtok, yo:n tak a:m..., ompa ke:meskia ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nikitstok ne:n ka:sá: ika se: kitas ne:wí:n yo:n chechelo:kamoh, yo:n kwali, semi pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>Yo:n ke:meh ekintsi:n ne:n nekwil *o** yehwa yo:n tikihtowa de n' tsi:nki:sa yo:n omitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>pos yehwa tak kisa:lowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>Kisa:lowa yo:ni, tak porin sasaltik ke:meskia kikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>Kitila:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n ka:sá: ika se: kitas ke:meh i:n no: tinentinemi ne:wí:n kowtah *o** kwali, kwali ti..., kwali tikwa:lkwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>Yo:n kwali yo:n pahti, yo:n chechelo:kamoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Ompa se: kikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>A:mo se: kahsi wa:n de ekintsi:n tise:meh nika:n timonohno:tstokeh komo tikahsih ihkó:n pos kwali timomati:lti:skeh *o** kwali tike:wtoskeh kaltsi:ntan komo yetok se: kowtsí:n pos ompa kwali tikta:li:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Ompa kwali tikta:li:skeh wa:n pos yo:n kwali pahti no: wa:n yehwa ya ke:meh yo:n se: wetsi, se: moma:kokowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>Pos yo:n no: te:sa:lowah wa:n *siempre** moneki yo:n mah te:ta:lili:ka:n nehjó:n, yo:nkamoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Wa:n yo:n kamoh semi sasaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Pero yo:n neh a:mo nik..., a:mo ke:man nikita neh mah, nikihto:s mah se: tai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>Yo:n a:mo, yo:n nochi ki..., kixahxama:nia:yah, kwaltsi:n kipa:tayah ihkó:n wa:n te:ta:lilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>wa:n te:ta:lilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>No: *igual** ke:meh ekintsi:n tine:chilihtoya ne:n mah, mah se: kwahwa:na ihkó:n, no: kwaltsi:n ne:n mo..., mo..., *casi** momox..., kwe:chiwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>De kwe:chiwi kwaltsi:n ka:mpa se: mota:lilia, ne:n mopepechowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Mopepechowa ya, a:mo, a:mo ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>Wa:n neh niki..., neh niki:x...., de se: kixahxama:nia, seki ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts425">
                <ANNOTATION_VALUE>Moneki mah kwali pi:kto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Mah kwali pi:kto wa:n i:n, de yo:n se: ki..., se: kichi:wa ihkó:n kwaltsi:n nochi, nochi mo..., mopepchowa ya *porque** nochi, nochi kwe:chtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Wa:n i:n seki, de se:, ihkó:n se: kimohmo:lta pos wehwei ki:sa seki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>Wehwei ki:sa seki wa:n yo:n pos no: a:yoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Yo:n no: kipia ke:meskia a:tsí:n ka:mpa se: kiteki no: a:ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>Wa:n a:ki:sa yehwa yo:n a:t, yehwa ya ne:n cho:kil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>Yehwa n' cho:kil, yehwa ya yo:n te:na:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>Yehwa yo:n te:na:miki *porque** n' i..., ipaniá:n achi, achi wa:kkatik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>yo:n ipaniá:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Pero taihtik achi kipia a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>Se: kiteki, ki:sa, a:ki:sa wa:n yehwa yo:n nochi ne:n te:na:miki, pos ekintsi:n nochi timomati:ltiah nehjó:n tikitstokeh ke:ní:w, katí:n te:chna:mikis ta:ká:n ke:masá: se: wetsi, se: monekwilowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>pos yehwa yo:n te:na:mikis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Mah se: 'kwiti sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Mah se: 'kwiti sah nehjó:n kamoh, *solamente** yeh, para yehwa yo:n, yo:n ika te:ch..., te..., se: mopahtia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>Yehwa sah yo:n ne:n, para nikihto:s oksé:, se: taman oksé: kokolis ihkó:n a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>neh nikmattok yehwa yo:n se: ... De nekwil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Wa:n de yo:n se: westi ke:masá: se: moma..., moma:posteki *o** se: imahpil *o** se: ima:ko ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>Pos no: kwali no: se: moma:sa:lowa ke:meh yo:n te:ta:liliah ne: tapahti:lo:ya:n teisá: ihko:ni *siempre** moneki mah te:ta:lilika:n ne:n para kikwi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>Para kikwi a ne: *porque** yo:n ye:k, ye:k, ye:ksasaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Ye:ksasaltik wa:n yo:n kihtowah ke a:mo no: komo a:mo niman te:ki:xtilihkeh ye:kahwayoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>Ahwayoh nehjó:n, nehjó:n chechelo:kamoh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>wa:n yo:n chechelo:kamoh onkak ne:wi:n, ne:wí:n se: kita, ne:wí:n kowtah, kahfe:ntah, ka:sá: ika ne: ike:span de kowit, yo:n *siempre** se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>Pero ne:wí:n we:ikowtah pané: a:mo kachi se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>A:mo se: kita *más**, ne: se: kita ompa ne:wi:n, ampo:wi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>ka:mpa kahkafe:ntah, yo:n ke:masá: se: kite:mohtinemi wa:n a:mo se: kahsi niman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>A:mo se: kahsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>Se: kahsi yo:n okseki yo:n achi pihpitsa:wak yo:n, pos no:, no: se: kahsi *hasta** ne:wi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>ne:wí:n kowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>nika:wí: a:mo se: kahsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>A:mo ke:man ne: tikita ne: tatsa:la:n, pos se: ... A:ah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Pos sa..., sayoh porin itsintan mowe:ita:lia ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Itsi:ntan sah pero yo:n a:mo semi wehkapantia, tsikilitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>Yo:n ke:meh e:wtiw ihkó:n xo:chiohtiw wa:n tak ihkó:n moskaltihtiw ne: i..., n' ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>Ihkó:n moskatihtiw *hasta, hasta** moskatia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Mm, *hasta** moskaltia ya nehjó:n ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>Pos neh yehwa sah yo:n de nikmati no: wa:n yehwa sah de n' ekintsi:n nimitsilih wa:n tehwa no: tik..., no: teh tikihto:s komo tik..., tikmati no: oksé:, xa: tikmati *más** pos kwali tine:chili:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>A:, we:noh pos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>Pos koma:mo teyo:k *más** tikmati pos yehwa ya ne:n kwali tine:chili:s ne:n moto:ka:i wa:n ka:n ti..., tiwa:le:w, ke:ní:w timono:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Pos nehwa nimono:tsa Anastacio Nicolás Damián, neh niwa:le:w San Miguel Tzinacapan.</ANNOTATION_VALUE>
