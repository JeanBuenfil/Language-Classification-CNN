                <ANNOTATION_VALUE>entó:s moka:wtiw tila:wak, ihkó:n pero pa:ttiw, pa:ttiw, *moasenta:rohtiw, moasenta:rohtiw**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
