        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>Tosa:ntohtsi:n, ompa ya ne:n tikechiliah ne:n ne:, ne:, ne: xo:chia:ko:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>sokiko:mit, ka:n, ka:n tik..., monekiti te..., tepos oso toni de *plásticos** ta: tik..., tikinkwiah sokikaxit, onkakayah soki..., sokiko:meh, sokiko:meh ika se: kitaa:kechia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>Seki na:nomeh, nikitaya neh no..., nowelitah, kichihchi:waya ko:ko:ntsitsi:n para ixo:chia:ko:nko:mit kihtowa:ya, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>'Konkwia sokit *hasta** ne: se: *lugar** kiliah teposkal, *hasta** ompa tikonkwiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>we:noh ne: ka:mpa tikihtowa, ne: xi:lo:xochit paratani tiahkah wa:n yo:n se: ta:tamanis, yetok se: teposkal, se:, se: kali</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>entó:s ompa yo:n t'konkwiah sokit, *o** kichihchi:wayah kali, ka:mpa yeski, *hasta** iwki ok no:má:n konkwi, ompa ne: *todavia**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>pos *este** para kichihchi:wayah ko:meh, koma:lmeh, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>Pos kichi:wa o:me ko:ntsitsi:n wa:n tiketsah ya *altar**, ompa ki..., kita:lia ya xo:chitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts609">
                <ANNOTATION_VALUE>pero ihwa:k katka a:mo takowal xo:chit, ta: ihkwa:k *natural** ke:meskia, nika:n kayo:t katka, nika:n *criollohxo:chit**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Kitemowa:yah sempowalxo:chit, olo:xo:chit, xe:lahxo:chit, yo:n ka:ketsayah ompa ne: itech n' *altalitoh**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>*o** teisá: xo:chitsi:n, yo:n kwitapi:lso:rrah kiliah, yo:n kostikxo:chit, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Yo:n taa:ketsayah ika, a:mo [ke:meh]a:xka:n nochi takowal xo:chit, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts621">
                <ANNOTATION_VALUE>Olo:xo:chit, tein tikahsik xo:chitsi:n, kipia ke tikahsis, miak xo:chitsi:n onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts623">
                <ANNOTATION_VALUE>Yo:n kiliah tehwa ne: e:esta:mbrehxo:chit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts624" TIME_SLOT_REF2="ts625">
                <ANNOTATION_VALUE>a:xka:n kiliah *molini:llo**, koyo:meh kiliah *molini:llo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts627">
                <ANNOTATION_VALUE>Pero tikiliah e:esta:mbrehxo:chit**, ke miak ta:taman onkak xo:chitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>No: nehjó:n mochi:wa nika:wí: mah se: kitepe:wa sah, mah se: kito:ka. Yehwa yo:n kitekia *puro rollitos** wa:n kaha:ketsayah, mm.</ANNOTATION_VALUE>
