        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Tiow wa:n tiki:xti:ti wa:n t'chi:wa *morollitos**, tikpowa sake:ra sehse: pa:nti t'ta:lihtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Owasakat para se: kali de chikwase:n *vara**, kwi:ka no: chikwase:n *ciento**,</ANNOTATION_VALUE>
