        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>no:, no: *por** taki:tskil kikwih, se:, se: taki:tskil tikechilpia wa:n tikwa:lma:ma ya, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>A:, yo:n *parejo** ika kwilo:t, *puro** kwilo:t, kwilo:t se: kiwi:pa:na, a:mo, a:mo, a:mo t'ta:taka:wilihtiw</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
