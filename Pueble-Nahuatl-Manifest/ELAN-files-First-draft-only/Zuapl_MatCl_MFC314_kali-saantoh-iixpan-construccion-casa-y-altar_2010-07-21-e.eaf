                <ANNOTATION_VALUE>Ne: titahtaksatoti ke:meskia nika:n tapo:toti nika:n ihkwí:n pero n' ahko tikwa:olo:chilpi:ti, mm,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
