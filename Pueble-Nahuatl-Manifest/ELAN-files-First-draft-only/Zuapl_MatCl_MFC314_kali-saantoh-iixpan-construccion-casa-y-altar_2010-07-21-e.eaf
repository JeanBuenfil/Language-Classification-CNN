        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts644" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>niktekiti *aceite** wa:n n'chipa:wa wa:n n'molo:ntia wa:n kwali, kwali n'chihchi:wa n' *aceite**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>Entó:s ika se: *vaso** n'ta:lia:ya ne:h*aceite** wa:n xo:tatok nochi n' to:nal, nochi yowak, ehe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>*Aceite** kitatia:yah *más**, kichihchi:wayah *aceite** nika:wí:, mm wa:n koma:mo wa:l..., kinamak..., kowayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>aya:mo *veladora** ka:chi a:mo onkaya ya, i:pa sayoh *aceite** wa:n no: n' *cerita** kichihchi:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>*Aceite, aceite semilla,** mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>pero nika:n we:noh, neh niki:xmati kikwiah semi de yo:n *aceite, aceite** kit, *aceitexiwit** yo:n onkak, moskaltia, nika:wí: onkak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>wa:n *isemillita**, komoke se: kisentilia wa:n kwe:chowah na:nomeh, kwe:chowah kwaltsi:n wa:n kimolo:ntiah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>Ki:xa:te:kah ke:meskia i:xcha:wka, sepa kitsoyo:niah i:xcha:wkah *hasta sin ....** kwaltsi:n tata nochi n' a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>ke:mah ki:x..., kixtiah ya yo:n, ki:sa ya n' *aceite**, mm. Yehwa kwali kixo:taltiah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>Wa:n kichi:wayah ikpat de n' ichkat pos ke:meh onkaya ikpatnika:n, ichkat nika:n kito:kayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>T'chi:wayah, neh n'chihchi:waya ne:n, n'piaya malakat ika noaweli:tah n'pale:wia:ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>n'piaya malakat, n'piaya n'..., nochipa n'chihchi:waya, nitekitia n' *hilo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>tiktila:ntiowih ichkat, t'tetsi:lohtiowih ichkat wa:n nika:n motetsi:lohtiw, kwaltsi:n momali:ntiw, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts683">
                <ANNOTATION_VALUE>A:, ika, ika tsakwilo:t, t'ta:liah, t'wi:pa:nah n' tsakwilo:t komo ti..., ohtat tikwi:pa:nah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>wa:n koma:mo tikxihxi:mah xo..., *xo:no:tablitas** wa:n tikinkwa:kahkalakiah sayoh ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>t'ta:liah o:me kowit ompa ti..., tikwa:kalakiah ya nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>Pero komo tawi:pa:n ke:meh ne: de n' ohtat, entó:s t'ta:lia:yah se:, se: komekat ihkó:n para tikwa:kalakiah ompa kowit a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>T'ahokwih komekat, t'kwa:kalakiah nika:n pos a:mo tatapowi ok, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts692" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>Tatsaktok a, yo:n kilia:yah tsakwilo:t, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>Se: kitai:xkechia ika se: kowit, aha, se: kikwi se: kowit, *solo** ika se: kitai:xkechili, kilia:yah tai:xketsalkowit.</ANNOTATION_VALUE>
