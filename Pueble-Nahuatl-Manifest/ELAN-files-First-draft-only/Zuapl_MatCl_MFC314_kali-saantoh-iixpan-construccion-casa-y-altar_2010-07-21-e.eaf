                <ANNOTATION_VALUE>Yehwa sah tikwiah tehwa:n, koma:ixiwit oso anayxiwit, *porque** okseki xiwit a:mo kwaltia niman pa:ti, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>Owasakat yo:n no:, no: kwaltia pero owasakat pos ne: mo..., moki:xtihtani ke:meh tikihtohtokeh ya de n'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>mo ro..., moro..., *o** tahtaki:tskil *pues** taki:tskil ka:mpa kipiah owata:l</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>ompa se: tahtani wa:n koma:mo tikpia owatah pos titahtani kanah ika ximotahtani owasakat.</ANNOTATION_VALUE>
