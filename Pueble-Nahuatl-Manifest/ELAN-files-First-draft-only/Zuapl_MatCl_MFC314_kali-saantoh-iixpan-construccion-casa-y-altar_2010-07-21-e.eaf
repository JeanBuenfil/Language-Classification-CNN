        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts225">
                <ANNOTATION_VALUE>Yehwa ke:meh i:n xiwit sah se:, ke:meh i:n nika:n tiktohto:ka:itih ya *este** anayxiwit, yehwa ya ne: *este** owasakat, chama:lo:..., chama:lo:xiiwt</ANNOTATION_VALUE>
