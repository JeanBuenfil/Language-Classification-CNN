                <ANNOTATION_VALUE>xo:no:wapalmeh tikxihxi:mayah, xo:no:wapalmeh ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>ompa tiksohsowayah tan..., wapaltsitsi:n, ompa tiketsakih tosanti:toh.</ANNOTATION_VALUE>
