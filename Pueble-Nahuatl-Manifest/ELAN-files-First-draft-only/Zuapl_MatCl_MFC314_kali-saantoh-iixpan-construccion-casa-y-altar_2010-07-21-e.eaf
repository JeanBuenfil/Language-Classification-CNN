        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>yehwa yo:n ki:xtiliah *cera** ta:tomeh wa:n kichihchiwayah ne: *cerita** wa:n kixo:taltiah *altari:xko**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts642" TIME_SLOT_REF2="ts643">
                <ANNOTATION_VALUE>wa:n koma:mo kwiah *aceite**, neh kwali n'chichi:wa n' *aceite**</ANNOTATION_VALUE>
