        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>wa:n tik..., tik..., tikteki a kalikximeh, mah etoka:n ya, mm, mah wa:ktoka:n,</ANNOTATION_VALUE>
