        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts635">
                <ANNOTATION_VALUE>I:pa tapopo:chwiah, *pues** ho:rah kopal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts636" TIME_SLOT_REF2="ts637">
                <ANNOTATION_VALUE>Wa:n kichihchi:wa na:notsi:n tekolkax wa:n ika tapopo:chwia, mm, i:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts639">
                <ANNOTATION_VALUE>[ki]tatia:yah s..., tane:x, kichihchi:wayah ke:meskia, tikowayah ne:n *cera o** kipiayah ne: nektsitsi:n ke:meskia de n' wehweikeh de n' kiliah *enjambres**</ANNOTATION_VALUE>
