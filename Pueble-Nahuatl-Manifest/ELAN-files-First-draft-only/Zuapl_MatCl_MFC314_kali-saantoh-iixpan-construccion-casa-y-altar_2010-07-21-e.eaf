        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>*mismo** kowxiwit komo ke ika se: kwa:tsakwa, pero ompa no: iwki no: se: kiahketsta:lihtiw ahko, mm, *para con eso** kwaltsi:n mosowa ya, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Pos neh nimolia a:mo kwaltia tikihtowa mah se: kwa:tsakwa *porque** tahxi:kas, aha, tahxi:kas tayo:lpan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>*porque** a:mo ke:man, *bueno** neh *noparte** pos a:mo ke:man nikta:li yo:n koma:ixiwit, i:pa yehwa kowxiwit nochi n'ta:lia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
