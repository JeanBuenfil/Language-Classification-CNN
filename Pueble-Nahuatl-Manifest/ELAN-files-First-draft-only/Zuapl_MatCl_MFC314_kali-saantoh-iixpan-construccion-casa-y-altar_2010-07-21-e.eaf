            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>*parejo** tikwi:pa:ntiw *parejo**, aha, pero *con eso este** kwali moka:wati n' kali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>komo tiktaka:wilihtiw kwilo:meh pos xahkaltiati sah, a:mo, a:mo, a:mo, a:mo kwaltias,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>*trabajo** de kwetawiti *porque** kalakiti n' a:t, kiowiti wa:n....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Ka:n ta..., aya:mo nitamati a ne: wehka:w, ne: ninohne:ltamati a ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Nimonemilih nimochihchi:wili:s se: nokaltsi:n wa:n nohjó:n n'chihchiwa:k, ne: niki..., nikitaya kichihchi:wah *noabuelitos** kali,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>no: n'chihchi:wak se: ihkó:n pero a:mo *ne:chservi:roh** pe:wak tahxi:kak kalihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>Entó:s *después** ne:chilia *noabuelito**, "a:mo" kihtowa, "ta: se: kita:lilia kwilo:t *por** kwilo:t se: kwi:pa:ntiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>A, ihkó:n takwi:lo:yeh yahtok nika:n pos nika:n t'pantekpa:na se:, nika:n no: t'tekpa:na, nika:n t'tekpa:na, t'tekpa:ntiw *hasta** tipanki:sati:w ahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Ompa tipanki:sati ke:mah t'tso..., t'tsonkepa ya n' koma:ixiwit, seki t'ta:lia ihko:ni, seki t'ta:lia ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>para *con eso** tikwa:pachowa ya ke:meskia, mm, *cuando** a:mo tahxi:ka, wehka:wa nimitsilia ma:ski, ma:ski xiwyohtos a ahko teisá: xiwit e:wis ompa n' ahko</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>wa:n kali nohma a:mo tahxi:ka, *moasenta:rowa**, ke:meskia tila:wak moka:wa, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Se: tatsi:ntsakwa ya, t'te:mowa ya n' *a ver** to..., tein tikahsis, xo:no:kwowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>t'tahtapa:na wapaltsitsi:n, ke:meskia t'chihchi:wa o..., oso ma:ski *ro..., rollizo** tik..., tikwi ta..., ihkó:n ne:n t'teki wa:n tik..., tikwi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>*porque** wa:n komo tikneki kwali se: kitahtapa:na ne:n xo:no:kowit, se: kitahtapa:na ika *machete**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Wa:n yehwa [ika]t'tsi:ntsaktiw, ke:meskia yo:n tsi:ntsakwil, mm. Komo tikneki mah kwali tahtatsakto wa:n koma:mo kowmihmil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Kowmihmil achto kehketsah wa:n etok a kali, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>No: se: kilpihtiw, se: kwi:pa:ntiw no: ika kwomekat, ika kwomekat se: kima:wi:pa:ntiw, mm,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>ke:mah, koma:mo pos.... *Antes** ihkó:n kichi:wayah kalimeh, a:mo tasohsoyah ke:meh a:xka:n moneki teposmeh, *clavos**, ihwa:k *puro** tawi:pa:nayah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>kwaltsi:n se: kwi:pa:ntiw, no: monetechohtiw, monetechohtiw n' kowit, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>*Siempre** tein yo:n chihchihkoltik pos tapo:tiw, moka:wa tahtapo:tok *como sea**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>wa:n xo:no:kowit pos *más** motsaktiw, komo *ta:tablitas** oso ohtat tiktahtapa:na no:, no: kwaltia ohtat neli, ika se: tasti:ntsakwa yehwa i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>tahtapa:nili, no: monetechohtiw, tein mehmelastik, pero tein chihkoltik ma:ski ohtat no: sanipa tapo:tok, aha.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Texokomekat, aha, yehwa ya pero semi *bueno** para se: talpia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>para tsi:ntsakwil yehwa texokomekat *o** yo:n kiliah koyo:meh *tripa de pollo** kiliah tehwa:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>Yehwa semi kwali, takwa:wak semi, mahyá:, mahyá:, mahyá: *alambre**, takwa:wak, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>yehwa ika kwali se: tawi:pa:na ya, *o** kwitaxkowit no:, kwetaxkowit se: kiehke:wa, nike:se:wayo ne:n to:to:kowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>wa:n no: kwaltia ika se:, ika se: tawi:pa:na, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Pos de a:mo kimá: kiowit, wehka:wa, *casi** o:me xiwit, *demás** sepa mah se: kipata, mm. Ma:koto:ni pos mah niman se: kipatatiw</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>koma:mo wetsiti:w ne:n tsi:ntsakwil *porque** pos *este** pala:ni komekat, pero kwetaxkowit *más** wehka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Itech tai:xwi:pa:nka:yo:t, t'ta:lia, 'ta:lia ne:n tatsi:ntan se: kowit wa:n sepa se: n' ahko</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>wa:n sepa se: tatahkoya:n komo tikneki mah kwali tsakto, 'ta:lia e:yi, seki tai:xwi:pa:nka:yo:t, mono:tsa tai:xwi:pa:nka:yo:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>'ta:lilia tai:xwipa:nka:yo:t tani wa:n sepa se: ahko, tatahko wa:n sepa se: *hasta** ahko wa:n ompa ya tikwi:pa:ntiw itech nehjó:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>Itech kalikxit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>Itech *mismo** kalikxit ompa se: kilpia, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>A:, para n' tsakwi..., tsi:ntsakwil de n' *puer..., ** tsi:ntsakwilo:t a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>pos de no: *igual** se: kiwi:pa:na de n' ohtat *o** xo:no:kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>Tikwi:pa:na no: *igual** wa:n tikta:lilia se: kow..., kowto:k ke:meskia ihkó:n nika:n wa:n sepa se: nika:wí:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>wa:n ompa tikte:mpilowa ya, tikte:mpilowa ya ne:n sentapal wa:n sentapal para motosta:sati itech</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>wa:n ompa t'ta:lia se: komekat oso se: tamali:n tikchihchi:wa de xo:no:t, xo..., t'chi:wa ke:meskia ta:tamali:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>wa:n ompa tikkwa:kalaki:ti a ne:n mo..., mo..., motsi:ntsakwil, mo..., mo..., motsakwilo:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Entó:s *este** tsakwilo:t tatapowah, pos a:mo, a:mo a:kah tatapowa *como quiera** ok, tatsaktok kwali a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>pero komo kimatiliah pos ka:nika takwa:kalaktok, pos takwa:ki:xtia wa:n kwali tatapowa, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>Iwki se: tatsakwa ya kalte:noh, ika tsakwilo:t, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>Kiliah tsakwilo:t se: tawi:pa:na ke:meh ne:, kwaltsi:n se: kehketsa *o** xo:no:kowit kwali se: kiwi:pa:na, ehe, pantsakwilo:t a, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>Iwki a moka:wa, mm, iwki a moka:wa ke:meh i:n yetok *puerta** entó:s pos, name:chilia:ya se: ta..., se: kalaki a itech, se: kitope:wa tsakwilo:t wa:n se: takwa:kalakia sepa, motatsakwa ya, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>Pos *solo** yehwa nehjó:n, ta:ká:n t'neki tikchihchi:was mote:tepech para a:mo ta:li:xko tikochis pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>no: tikxihxi:ma *tatablitas** de xo:no:kowit, tikchihchi:wa xo:no:kowmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>wa:n ke:mah tik..., tik..., tiketsa kowto:k ne:pa *o** kow..., kow..., kowmachalmeh ke:meskia kowkamachalmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>wa:n ompa tika:na:lta:lia se: kowtsí:n ihkó:n, ompa tiksowa ya ne:n *tatablita**, ne:n wapalmeh tein tikchihchi:wa de xo:no:kowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>wa:n ompa tikochi a, no: tikoyo:kochi a *trato** no:, a:mo ta:li:xko ok timoxakwalohtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>*Mejor** timochihchi:wilia mo..., motepech wa:n ompa tikochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>Koma:mo kinekih kichi:waskeh imintepech.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>*Este** ki..., ko..., ta:li:xko kochiah, sayoh kichi:wayah ininkochpet,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>yehwa ya ne:n kite:mowa:yah n', *este** ne:n owapach ka:mpa tapa:tskayah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>tah..., motahtania:yah owapachtsi:n wa:n kipowayah se: *ciento**, komo we:i *cristiano** se: *ciento**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Se:, se:mpa:nti, komo we:i *cristiano** kiwi..., kiwi:pa:nah ka..., kix..., ki..., kite:mowah tamali:n de n' xo:no:t kimali:nah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>Xo:no:tamali:n wa:n yeh ika ke..., *mismo** kiwa:..., kima:wi:pa:nah ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>yo:n kiwi:pa:nah, tein komo we:weyak pos seki kiwi:pa:nayah e:yi lado,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts401">
                <ANNOTATION_VALUE>e:xka:n kiwi:pa:nayah wa:n seki kiwi:pa:nayah sayoh ohka:n, mm,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>pero nehjó:n ti..., se: kitamachi:was sayoh ke mah moka:wtiw ihko:ni, sakie:ra se:, se: kwa:rtahpan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>mah moka:wtiw *ipun...,**, nika:wí: yowi i:n komo ke *ipu..., ipunta** ya i:n moka:wa, iekapayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>No: sentapal no: *lo mismo**, entó:s nochi *igual** de ohka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>pero komo kinekih e:xka:n entó:s *más** tate:noh kita:liah, ke:meskia ne:n tikma..., t'mali:nah ke:meskia 'wi:pa:nah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>kiwi:pa:nah, kiwi:pa:nah wa:n we:noh yehwa kikwih para imintapech.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Ehe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>A:mo ta: kiahchi:wayah, ta..., tane:si ki..., tap..., tap..., tapoya:wi kisowah para ompa kochitih ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>sepa ne: tane:sna:wak, ko..., ki..., me:wah komo ke, ihwa:k me:wayah kwalka:n, a:mo ke:meh a:xka:n me:wah tokni:wa:n nepantah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts423">
                <ANNOTATION_VALUE>ta: ihwa:k me:wayah kwalka:n *las cuatro, las tres de la mañana** me:wah ya, pe:wa tapaya:natih ya na:nomeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts425">
                <ANNOTATION_VALUE>entó:s ta:totsi:n no: me:waya wa:n kite:ntia *imachete** para ya:ti tekititi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts427">
                <ANNOTATION_VALUE>entó:s *este** ne: ki..., kiti..., na:notsi:n ke:wa ya kochpetat, kitetekwinowa wa:n ne:wí:n ketsah *rincón** wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>yeh kima:pa:ka inextamal wa:n yowi ne: ketsa ikahfe:n, tamolo:ntia wa:n para ya:ti tekititi ta:totsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>kitaxkalti:ti, kwi:kati itaxkal, entó:s a:mo teh tatso:ptok no: n' kochpetat ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>aya:tsi:n ipantake:n, ta:ká:n motake:ntihka pos ne: kipiliwa no: ne: ko..., itech tamali:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>yetok, ka:mpa itasa:l no: ompa yetok, panpilo:ti no: ipantake:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>Entó:s tisi a na:notsi:n, tapaya:na ya, ta:totsi:n yeh tate:ntihtok ne:, mm, *imachete** ta: ya:ti tekititi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>ne: ma:kwi:l *hora** tane:si kino:tsa ya mah takwa:ti a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>takwaya, *porque** tahtayowaya:n ok yowi n' ta:totsi:n tekititi, yeh tane:sis ne: itech itekiw a, ompa ya tapial tekititok a, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>Itech n' ikpalmeh, ikpal, t'chihchi:wah ikpal ihkó:n, nahnakasehkeh, neli ke:meh nimitsilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>de xo:no:kowit, komo kahsikeh, ka:n kite:mowa:yah mah kwali, ke:meh a:xka:n kite:mowah kwali yonkwikikpalmeh ok para mota:liskeh, ta:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>ihwa:n tein ya kahsikeh mo..., *mas** se: tetsi:n se: te..., se: motokotsta:lia wa:n takwahtok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>o: se kowohololtsi:n, a:mo moneki *tanto** miak ikpalmeh mota:li:skeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>komo kahsiah ya ikpal tein nakasyeh pos *que bueno** yeh mochi..., mochihchi:wilia:ya *mismo**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>ompa mose:wia:yah, ompa mota:lia:yah para takwah ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>pero a:mo monekia ne:n *mesa** para takwa:s ta: ihwa:k monekia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>ta:li:xko ne: ketsa n' *iplato** wa:n no: takwahtok, almasa:lowa n' ta:totsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>Kipi:kilia ika, ika pahpataiswat, kipi:kiliah itaxkal wa:n yahtok tekititi a, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>Nehwa ke:mah, kwali, ke:meh yo:n nakasehkeh kwali nikinchihchi:wa, moneki xo:no:kowit sah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>mm, se: kikwi ne: xo:no:kowit oso ala:wakkowit, kwali se: kikwi no:, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>A:, entó:s tik..., tikwiti ne:n xo:no:kowit *al según** ke:ní:w tikneki de weyak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>entó:s eski por ka..., *porque** seki tikchihchi:wayah tehwa:n *antes**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>tikchi:wayah para o:me *persona** mota:lia:ya, a..., o:me, o:me tokni:wa:n mota:li:skeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>entó:n we:itsi:n t'chi:wayah, ke:meh i:n *tanto**, akiah o:me ya mota:liah, mm, se: *vara**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>Se: *vara** mota:lia entó:s tikchi:wah nehjó:n *tanto** tikp..., tikwi:kah *machete**, kwaltsi:n tikwa:te:ntiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>Se: kwa:te:ntia kwaltsi:n *machete** wa:n ke:mah pe:wa se: kihtitehtektiw a ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>se: kihihtitehtek..., se: kiihtitehtektiw, kitehtektiw *hasta** ihkó:n tapo:tiw, tapo:tiw, tapo:tiw</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>wa:n ke:mah *hasta, hasta** moihtiolo:chowa ya, tiktamiihtiolo:chowa entó:s ke:mah t'nakastanxi:ma ya, nakastanxihxi:ma ya nika:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>sepa nika:n no: x'nakastanxihxi:ma sentapal, ompa ke:mah x'panxihxi:ma ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Entó:s kwaltsi:n moka:waya, moke *ba:banko** komoke i:ikpaltsi:n wa:n *después** se: mota:lia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>we:noh, pero *primero** tikwih kowmimil ke:meskia tikihtikoyo:niah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>Tikihtotehtekih, tikihtitehtekih *hasta, hasta** mah ihtikana:waya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>*en eso** kana:wayakia, n' i...., n' i,,,m n' ipankakawyo pos, ke:meh tike:sxihxi:mah ya nika:n para mochi:wa ke:meskia ta: i..., ke:meskia, kemeskia *tabla** mochi:waya mahyá: wapal eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>entó:s akis para o:me wa:n komo para se:sah pos tikwis sayoh tako, tahko ke:meskia, tahko n'..., tahko *vara**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>soh para se: *persona**, tika:wiliah inakas nika:n wa:n mota:lia tokni:tsi:n, t'makah mah mose:wi, mm,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Kalpanohkeh yowi, tix..., tikmakah ikpaltsi:n mah mota:li, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>Pos para se: ki:tski:s, para kwali se:.... Wa:n seki kika:wilia:yah inakas, seki a:mo, sayoh kikwiah ihkó:n ohka:n mokihki:tskiah ihkó:n wa:n ne: kitokosta:liah wa:n mota:lia, mm,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>entó:s pero tal..., te..., tika:wilia:yah inakas para kwali se: ki:tskia ihkó:n wa:n x'ta:li ne:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>A:xka:n koma:mo t'chihchi:wah se: achi *más** kanaktsi:n, *más chachaparrito** ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts518" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>tikwiah para kwa:to..., no: komoke tikchihchi:wah, no: *babanquito** ke:meskia t'ihtikoyo:niah para tokwa:totsompech,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>timokwa:pechtia:yah, tik..., tikochitih, timokwa:pechtia:yah tot..., tokwa:tatsompal, mm</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts524">
                <ANNOTATION_VALUE>wa:n yehwa t'chihchi:wayah no: de xo:no:kowit, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>I:pa kowit sah, i:pa kowit sah, ka:n teh moneki tilmah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>ma:ski mo..., koto:n, ta:ká:n tikpia mokoto:n pos timokwa:pechtia mokoto:n, mm,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>pero a:mo teh monekia toni ikwa:tapech, a:xka:n moneki ne: ke:meh koyo:meh kichi:wah a:xka:n kwahkwali kwa:tapech, *algodones**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>wehka:w a:mo, ta: kowtsí:n timokwa:pechtiah, a:xka:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>A: para n', para ti..., timotapatiliah, *bueno** komo nita:loh ya de ne: nitekitito, nit..., nita:loh pos nimotapatili:ti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>nona:nahtsi:n pos i:pa yetok a *listo**, ne: kihtsontok a notasa:l, ta:ká:n tsayaktik, ta:ká:n kowtah se: tekiti se: motatsa:ya:nia san i:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts545">
                <ANNOTATION_VALUE>ke entó:s *este** nimotatsaya:nih pos yeh ne: komo nimota:lwia tapa:ka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>wa:n *este** ne: yowi a ne:n kipa:kati wa:n *mientras** kiwa:tsa, tio:tak niehko ta:ká:n nia:paltik pos nimotapatili:ti ika</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts548" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>wa:n tein niki:xtia pos ne: koma:panpilowa ke:meskia para kipa:kas mo:stika kwalka:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts551">
                <ANNOTATION_VALUE>Wa:n ompa kitemowi:ti a sepa se: tein ompa pilkatok se: tamali:n kita..., 'chihchi:wa de xo:no:t, nikch..., nikchihchi:wilia:ya de xo:no:t, ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts552" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>wa:n ompa, ompa kipilowaya ya no..., notasa:ltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts556" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>Iwki sah ka:n teh moneki a kowkaxo:n para tae:was tasa:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>Wa:n komo sati:roh, ke:masá: tikpiayah tomi:ntsi:n timokowilia:yah yo:n kowkaxo:n tikilia:yah *este, gascajón** kilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>Yehwa yo:n *solamente** yehwa ki..., ki..., takaliayahtotasa:ltsi:n ompa, mm, kihtowah ke kwa:lkwiah *gas** ne: wehka:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>*Gascahjón**, pero, pero *más que nada, desconfiarowa:yah porque** kimichimeh kitehtekih wa:n de pilkatok a:mo kitehteki kimichin, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts568" TIME_SLOT_REF2="ts569">
                <ANNOTATION_VALUE>komo *cajón**, itech kahxo:n aktok ne:, kitehteki kimichin, mokalakia kimichin wa:n kitehteki. Wa:n de pilkatok pos a:mo kitehteki kimichin, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>*Pues más** kwelitayah ta:tomeh tpilo:skeh inintasa:l, ika tamali:n, se: kita:lia ahko wa:n ompa tahtapilowah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>Ompa yetok na:notsi:n itasa:l wa:n ompa yetok ta:totsi:n itasa:l, sekosah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Ke:mah, yo:n i:pa tika:wayah sa:ntohi:pan por....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>Ne: *tanto***to..., to..., to..., toaltar** ke:meskia tikchihchi:wayah ompa ne: para ta:lkwiah se: *lugarcito**, yehwa ya para toxa:ntohi:xpan ke:meskia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>ta: tik..., tiketsah ya ne:n kowketsal ihkón, 'ketsah o:me kakkwetsalmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>ta:i:x..., tai:xkwa:yo:t t'ta:liliah wa:n ke:mah tikx..., t'ta:liah se: tai:xkwi:lo:t nika:n tata..., tani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts586" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>Tai:xkwi:lo:t ke:meskia para ompa ya tiksowatih ne:n wapalmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
