                <ANNOTATION_VALUE>koma:ixiwit, t'tekih ya koma:ixiwit wa:n koma:ixiwit tiki:x..., tiki:xnehnepanohtiowih ihkó:n, kwaltsi:n tiktepa:ntiowih, t'tekpa:ntiowih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>wa:n ke:mah tik..., no: iwki tehwa:n tikchi:watih ya de n' kali a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>no: tik..., tikwi:pa:ntiowih, *cinta pos cinta** no: *cinta pos cinta**, tiktekpa:ntiowih para moka:wtiw tila:wak koma:ixiwit,</ANNOTATION_VALUE>
