        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>¿Wa:n pahti tikwi yehwa n' ixiwyo oso: ikowyo? Aa n' ikowyo kwomekat</ANNOTATION_VALUE>
