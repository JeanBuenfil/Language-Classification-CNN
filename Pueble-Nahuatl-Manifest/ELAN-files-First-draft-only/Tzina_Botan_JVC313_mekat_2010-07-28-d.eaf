        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>¿Ke:meh eskia ekimit ixiwyo?</ANNOTATION_VALUE>
