        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>In okse: *este** t toka:ytia chi:lmekat ¿in keniwki?</ANNOTATION_VALUE>
