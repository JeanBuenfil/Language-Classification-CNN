        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>Aman ne: tipanotih ika in kwomekat tei:n kwali ika se: tahtalpia *bueno** ye:wa t techilwih ika ne: n' tata:wikmekat ihwak selik no: kwaltia</ANNOTATION_VALUE>
