                <ANNOTATION_VALUE>I..., xo:chio pané: ista:k mochi:wa. Ista:k ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts639">
                <ANNOTATION_VALUE>Ke:mah wa:n ixiwyo nimitsilia mo..., no: mote:tekpa:nilia ke:meh, ke:meh mahyá:, ke:meh ay..., ekimixiwit ne:n ixo:chio te..., tepitsi:n pisi:ltik pero, ekimit telma:pata:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>I:n pisi:ltik ne:n ixo..., ixiwyo, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts647">
                <ANNOTATION_VALUE>Yeh ke:mah, yehwa yo:n, yo:n se:, komo se: kitila:na koto:ni no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>pero yo:n pihpixki, moka:wa n' ie:waya mahyá: wa:n mo..., s..., yo:n ikomeka[yo], tein moka:wa taih..., mahyá: komekat a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts650" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>xoxoktik moka:wa, yo:n semi tsohya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts653">
                <ANNOTATION_VALUE>Yehwa yo:n kowke:smekat kiliah ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>no kwali se: kiwi:pa:na, no: takwa:wka yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>Wa..., achi toma:wak wa:n yo:n seki te:sakamekat yeh pitsa:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>Te:sakamekat ka:n semi tsohya:k wa:n i:n kowke:smekat ye:k tsohya:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>pané: te:yekakokoh, ika a:mo se: kie:kneki se: kitekis yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>pero no: kwaltsi:n [ika]se: tawi:pa:na, taxi:kowa no, takwa:wak. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>Ixiwyo ma:we:weyak ne:n ixiwyo, ke:meh yehwa yo:n ... Ke:meh kowe:lo:t ima:xiwyo, yehwa yo:n kowke:smekat kiliah pero ...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts671">
                <ANNOTATION_VALUE>wa:n no: ta:ki yo:n kowe:lo:t, no:, no: we:lik ne:n ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>Seki kichi:wah ato:l, ki:sa ita:kka pané: et, *cuando** oksi a ke..., *cuando** oksi a, pihpixki yo:n kowe:lo:t wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>wa:n komo se: kikwa, se: kitekiti pos, komo okachi mah se: kiteki..., xohxowik mah se: kiteki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>wa:n se: kiokxitia kalihtik wa:n kima:pa:kah ipacho wa:n kimanah ke:meh et wa:n kichi:wah kowe:lo:ato:l. Yo:n ye:kwe:lik ato:l no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>Yehwa yo:n kowke:skemat. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>Kwesalmekat no: kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts692" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>Te..., tein, tein we:i no: kwaltia para ke:meh yo:n seki kichi:wah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts695">
                <ANNOTATION_VALUE>tehwa:n ti.... Ke:meh i:n ka:mpa nowe:ipopa:n kamohto:kaya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts697">
                <ANNOTATION_VALUE>ne: kamohto:kaya wa:n tiktekiah kowit we:weyak, ne:n mahyá: kale:waltsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>Kito:kaya ne:n kowketsalmeh ne: we:wehka, mahyá: poste ekintsi:n kiliah koyo:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts700" TIME_SLOT_REF2="ts701">
                <ANNOTATION_VALUE>wa:n no: para a:mo takwa:s tapial, a:mo kalakis te:kwa:kow oso te:kaba:yoh kalakis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts702" TIME_SLOT_REF2="ts703">
                <ANNOTATION_VALUE>*porque** kamohmekat semi kikwa:yah ne:n tapialmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts705">
                <ANNOTATION_VALUE>Pos kitohto:kayah yo:n kowit wa:n kite:mowa:yah yo:n kwesalmekat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts706" TIME_SLOT_REF2="ts707">
                <ANNOTATION_VALUE>wa:n ika kilpia:yah para a:mo net..., a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>a:mo taneki:sa wa:n a:mo ma:koto:ni eliwis. Ma:ski kitope:wah sentapal, a:mo koto:ni *porque** takwa:wak yo:n kwesalmekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>Yeh ika tawi:panaya nowe:ipopá:n nikitak, kwa:i..., kitekpa:naya ne: kie:ra e:yi kita:lia ne:n i:xtapal mahyá: tatsoko:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts713">
                <ANNOTATION_VALUE>wa:n kwali kitili:ntiaya wa:n yo:n ke:mah kite:tetsi:lowa para y..., para yema:nia, [ki]te:tetsi:lowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts714" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>para mahyá: posteki ka:mpa ne: i..., itahtakoya:n para kwa:ilpiah komekat no: iwa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>Ke:mah yo:n a:mo wel se: kikehkelpachowa ke:meh se: kinekis, yo:n se ki..., yeh kitetsi..., moketsa itech komekat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>wa:n kitetsi:lowa ihkó:n, katka ma:chihchikaktik, ompa kitetsi:lowa wa:n ke:mah yema:nia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts720" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>kwikomaya kowit wa:n ke:mah kitel..., kilpilia:ya wa:n ompa kipe:waltia kiwi:panah kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts722" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>Eheyi sah kita:lilia:ya, mahyá: *alambre** ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>para a:mo kalakia nen tapial, kwa:ti komeka..., ne:n kamohmekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts726" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>Kie:kkwa, kwa:kwemeh kie:kkwa kamohxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>Tehwa:n semi timoskaltihkeh ika yo:n kamohxiwit, ika kamoh, ika kamoh ne:n timotekipanohkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts731">
                <ANNOTATION_VALUE>tikto:kayah keni..., kamoh..., wa:n neh niki:xmati mo..., ke:ní:w se: kichi:wa kamoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts733">
                <ANNOTATION_VALUE>ke:ní:w se: ki..., ke:waltia, ke:ní:w se: kichkwati, ke:ní:w para se: kimanas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>Yehwa yo:n kat..., ompa ika ta..., tawi:pana sah yo:n kwamekat, kiliah kw..., kwesalmekat, ye:ktakwa:wak semi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>wa:n koma:mo kwesalmekat yehwa ne:n kwitalkolmekat wa:n yehwa yo:n tata:wikmekat, ika tawi:panayah nochi. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts744" TIME_SLOT_REF2="ts745">
                <ANNOTATION_VALUE>Pos semi cho:kiloh yehwa i:n, i:n .... Poposokani ye:kcho:kiloh no:, ye:kte:pa wa:n ti:ltik icho:kilo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts747">
                <ANNOTATION_VALUE>Komo se: mocho:kilwih a:mo ki:sa ok wa:n yehwa ne:n ista:kpoposokani no: ye:kcho:kiloh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts749">
                <ANNOTATION_VALUE>wa:n i:n, i:n tata:wikmekat no: ye:kcho:kiloh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts751">
                <ANNOTATION_VALUE>No: tiltik icho:kilo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>Wa:n i:n, wa:n i:n te:sakame..., te:sakamekat no: cho:kiloh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>wa:n yehwa yo:n kowke:smekat no: ye:kcho:kiloh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>Nochi chohcho:kiloh. A:mo cho:kiloh ne:n yo:n kwitaxkolmekat a:mo cho:kiloh. A:mo cho:kiloh yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts759">
                <ANNOTATION_VALUE>Ma:s[ki]cho:kiloh, a:yoh no:, pero a:mo te:pa n' icho:kilo, a:mo te:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>Ke:mah wa:n yehwa yo:n kwetolmekat, yo:n a:mo no: [no:]cho:kiloh yo:n, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>Ah. Nochi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts770" TIME_SLOT_REF2="ts773">
