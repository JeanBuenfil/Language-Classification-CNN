        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>Ke:mah, ta: wehka:wa neli, taxi:kowa, ke:mah, taxi:kowa wa:n neli nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>kwaltia neli pos nejó:n, para neli n' tik..., de kowtati:l nikilia neh kwaltia pos para ika se:..., ke:meh yo:n se: motixili:s nikilia neh ka:n miak se: kekatia *porque** nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Ke:mah, *de que** weloktik wa:n neli de wa:kik nikilia neh *más** kwaltsi:n tata. ke:mah wa:n... A:mo, *porque** yo:n nikilia neh komo miak se: kilpih nikilia neh ka:n se: kixi:ko:s *porque** teleti:k. Ke:mah, ye:keti:k, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>Ke:mah, ompaka nochi yehwa, ke:mah nochi yehwa wa:n neli, neli yo:n wa:n tein yo:n ista:k pos no:...,n..., a:mo niken...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>neh niki:xmattok i:pa yehwa sah tein yo:n chi:chi:ltik pero tein yo:n ista:k pos no: iwki, no: wehwei mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>No: ata, no: wehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>A:, n' achi mehmela:wak yeh, a: pos neli, neh a:mo niki:xmati, neh niki:xmattok i:pa yehwa sah yo:ni wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>Wa:n nikilia neh ka:mpa yo:n mometsketsa tal..., tel..., motelchi:wa inalwayo. Ke:mah, tel nejó:n pahpanki:stok nikilia neh inalwayotsitsi:n *porque** niki:ita neh tiuwih nehkwi:ni nikilia neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>nejó:n nochi yehwa ne:n inalwayo wa:n neli ne:chi:ilia *que** yehwa n' ahkokowit kihtowa i:n, pero telnalwayoh nikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah, motel..., motelchi:wa payá:n ne:n inalwayotsi:n wa:n neli pos tein moskaltia pos neli mochi:wa we:ikowit wa:n, wa:n telmahmaxaleh neh nikilwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Ke:mah, kitelpia ne: sa nipa ya:yah..., ke:mah n' im..., n' imaxalyotsi:n wa:n neli n' ixiwyo ata ahalaxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Ke:mah, ahalaxtik kwaltsi:n wa:n mahyá: achi...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Ke:mah, *porque de que** wa:ki a n' ixiwyotsi:n telahalaxtik. Ke:mah wa:n neli nejó:n ka:mpa se: taksa neli se: moxola:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>Tel..., tel nejó:n wa:kik wa:n tak porin telahalaxtik oso ke:yeh yo:n ika se: moxola:wa. Ke:mah, yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Ke:..., ke:mah ta: kwaltia neli wa:n neli pos no: se: kitehtekis tein pitsa:wak *porque** tein yo:n toma:wak a:mo se: kiteh... A:mo *porque** poron teltakwa:wak. Ke:mah. Eh...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Pos i..., *solamente** ika yehwa, ke:mah ika yehwa *porque** ika *machete** nikilia neh a:mo wel se: ki..., a:mo, ke:mah, ta: pos nejó:n nikilia neh yehwa:n *más** ma:chika:wkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>Ke:mah, yoh *solam...**, yehwa kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>Neli n' tein ista:k neh a:mo, a:mo niki:xmati, pero nejó:n neh niki:xmattok yehwa sah yo:n chi:chi:ltik. A:, no: ista:k. Ke:mah. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>A:mo, tehsá: miak tasohka:matik tein tine:chilwih, neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
