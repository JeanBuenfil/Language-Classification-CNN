                <ANNOTATION_VALUE>Pos neh niki:xmattok nijó:n yehwa yo:n e:yi, e:yi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Chini:nah yo:n tihti:ltik achi,</ANNOTATION_VALUE>
