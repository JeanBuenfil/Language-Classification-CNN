        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>*o** teisá: ihkó:n *cazuela** ihkó:n ki..., kichi:wah.</ANNOTATION_VALUE>
