        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>Yo:n kwaltsi:n mowi:wila:na wa:n mopampihpilowa ixo:chio.</ANNOTATION_VALUE>
