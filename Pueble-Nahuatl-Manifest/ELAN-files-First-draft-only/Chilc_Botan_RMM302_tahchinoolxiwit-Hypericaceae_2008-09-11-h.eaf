        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>*medio** mahyá:, mah tikihto:ka:n tehwa:n *medio, medio** kostik</ANNOTATION_VALUE>
