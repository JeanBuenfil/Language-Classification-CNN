        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Wa:n ma:pisi:ltik, pisi:ltik n' ixiwyotsi:n,</ANNOTATION_VALUE>
