        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>Neh nikmati pané: yehwa sah, *hasta** n' ompa sah yo:n neh nikmattok. Mm.</ANNOTATION_VALUE>
