        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Ke:mah, kwali moka:wa ya nejó:n pili, *por eso** nikmatik *que** moxwitihtok.</ANNOTATION_VALUE>
