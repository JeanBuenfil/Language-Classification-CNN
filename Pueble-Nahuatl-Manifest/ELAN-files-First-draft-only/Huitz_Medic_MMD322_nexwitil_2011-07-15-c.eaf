        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>yeh no:, yo:n nimitsilia *que** sayoh n' kwala:ntok wa:n ne: no: *igual** komo momowtihtok,</ANNOTATION_VALUE>
