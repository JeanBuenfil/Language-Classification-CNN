        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Ke:mah yo:n se: kitewa:tsa pero se: kkana:wka:tehteki, wa:n tiktewa:tsa wa:n ke:mah pero</ANNOTATION_VALUE>
