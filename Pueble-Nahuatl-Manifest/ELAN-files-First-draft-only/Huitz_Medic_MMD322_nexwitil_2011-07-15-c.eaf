    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="Eleuterio Gorostiza Salazar">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>*Bueno** na:no a:man xte:chnohno:tsa ne: i:n kokolis tein kinkwi pilimeh i:ksá:, mono:tsa nexwitil. Nochi n' tein teh tikmattos xte:chtapowi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>A:man, *este**, ¿kwali tite:chili:s ke:ní:w n' tikmatis de se: pili ox moxwitihtok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>*Bueno** ne: ye:wa tite:chilia:ya ika komohkó:n se: pili momowtihtok tikwitapawia ika</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>*pelotillas**. ¿kwali tite:chili:s ke:ní:w n' tikchihchi:wa m' *pelotillas** wa:n toni se: kikwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>A:man se: kikwi awakatet. ¿Katí:n awakat *porque** tikmattokehta:taman awakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>¿Ika toni se: kitewa:tsa, ika koma:l, itech *cazuela**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>A:man i:n ma:lta:ntsi:n tikihtowa, ¿i:n se: kito:ka, se: kikowa oso mochi:wa sah wa:n ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>¿Ke:niwki n' ixiwyo ne:n ma:ltantsi:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Wa:n *este** a:man tikihtowa:ya ne: i:n kowtsapotet wa:n awakatet se: kitewa:tsa. ¿Yo:n ahsitok oso se:...?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>¿Ton *tanto** ne: ika wehwei ne:n ololtsitsí:n tikta:lia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Wa:n a:man i:n pili, ¿ka:nachi *pelotillas** tikta:lilia sepa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>A:man xite:chili ne: moto:ka:y wa:n ka:ni n' tiwa:le:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Ne: Wi:tsikitepe:k[Huitziltepec]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>wa:n ne: nimono:tsa niMaría Modesta Millán Diego.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
