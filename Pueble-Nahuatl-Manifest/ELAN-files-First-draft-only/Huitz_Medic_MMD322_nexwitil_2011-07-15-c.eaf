        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Wa:n a:mo kimaka *lugar** para ne: *ora sí** mah</ANNOTATION_VALUE>
