        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>wa:n tik..., tik..., tikta:lilia ya. ¿Tikahsika:kakik ya?</ANNOTATION_VALUE>
