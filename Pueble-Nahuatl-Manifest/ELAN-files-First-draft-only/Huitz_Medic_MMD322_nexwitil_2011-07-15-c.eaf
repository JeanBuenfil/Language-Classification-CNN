        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Wa:n *cuando** tein yetok pilikwali, a:mo teh kipolowa, a:mo teh ki..., ne: momowtihtok.</ANNOTATION_VALUE>
