        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Entó:s se: kit..., kikwi a nika:n wa:n se: kitohtopo:nia de nika:n ii:ka:n,</ANNOTATION_VALUE>
