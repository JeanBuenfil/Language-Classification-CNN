        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Yo:n nochi, nochi, serviro..., yo:n, yo:n nochi kwaltiaya yo:n kowit sayoh kixihxi:mah.</ANNOTATION_VALUE>
