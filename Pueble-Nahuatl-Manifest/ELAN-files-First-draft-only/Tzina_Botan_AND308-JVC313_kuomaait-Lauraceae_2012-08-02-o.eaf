        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>*porque** ne: tate:noh kilia:yah tate:nkowa:yo:t.</ANNOTATION_VALUE>
