        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>Entó:s ompa nika:n, de nika:n i:n kwaltia nika:n kilia:yah ne:n taihtikkowa:yo:t no:, no:, no: kwaltiaya,</ANNOTATION_VALUE>
