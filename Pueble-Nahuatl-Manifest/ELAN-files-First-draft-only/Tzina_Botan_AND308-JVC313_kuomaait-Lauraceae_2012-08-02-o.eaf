        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>Ke:mah nehjó:n kiokwilo:tia:ya pero nehjó:n ke:mah kwaltia ya no:, ke:mah.No: kwaltiaya para ta:nka:yo:t, ta:nka:yo:t no: kwaltia.</ANNOTATION_VALUE>
