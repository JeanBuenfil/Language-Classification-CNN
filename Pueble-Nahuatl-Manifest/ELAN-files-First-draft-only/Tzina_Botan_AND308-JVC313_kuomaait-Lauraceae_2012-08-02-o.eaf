        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Kahkantia:yah wa:n de ka:mpa kantia:yah ompa kilpia:yah ya ika ne:n kwomekat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>Ka:mpa ne:kaneh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>Ka:mpa kaneh, ka:mpa yetok ne:n, ka:mpa tate:nilpil a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>Ompa ata, ka:mpa yetok, ne:n, tate:nkowa:yo:t, ¿ke:ní:w kiliah?, ata yo:n tehwa:n tikiliah tate:nilpil, tate:nkowa:yo:t kilia:yah ta:tahmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>*porque** ompa kita:lia:yah nika:n para mah kitsakwili,</ANNOTATION_VALUE>
