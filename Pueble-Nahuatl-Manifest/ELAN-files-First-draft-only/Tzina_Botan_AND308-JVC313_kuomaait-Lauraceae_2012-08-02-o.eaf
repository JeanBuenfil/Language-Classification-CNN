        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>mah kitsakwili, 'tsakwili, ne:n, kale:wal, ka:mpa ne:n tate:nkowa:yo:t,</ANNOTATION_VALUE>
