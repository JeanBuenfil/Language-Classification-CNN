            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>Pos ekintsi:n yehwa yo:n se: kite:mo:skia ne:n se: kite:mo:skia wa:n se: kinmakaskia pi:piltsitsi:n kwaltsi:n ika ma:wilti:skiah, kwaltsi:n kakisti ekintsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>Xa: *hasta, hasta** kowaskia ta: yo:n kwaltsi:n tikihtowa tsili:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Pos no: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>Tikihtowa ke wehkaya no: ka:mpa mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>Wehka ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>Pero teh tikihtowa timattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>Pos neh no: nimattok na:wala:ko, nochi ne:wi:n, nochi a:te:nte:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>Pero a:mo niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts482">
                <ANNOTATION_VALUE>A:mo nikikita komekat sah ihkó:n ti:tila:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>Pero a:mo nikmati ke:ní:w ito:ka:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>*O** ke:ní:w ox kwaltia oso a:mo kwaltia *porque** seki posteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>kwaltsi:n ke:meskia yo:n tapaloh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>Wa:n yo:n no: tihtila:wak ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>A:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>Wa:n yo:n iteyo no: kikwah ne: chiktehmeh oso okwilimeh ta...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>'Kohkoyo:ni:skiah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>Komo 'kwa:skiah chechelo:meh no: 'kohkoyo:ni:skiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>Ipanakayo sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>Ke:mah, kwaltsi:n mo..., moka:wa ya tsitsikiltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts553">
                <ANNOTATION_VALUE>Pero i:n a:mo, a...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Wa:n no: *igualito** ke:meh oksé: no: *mis[mo]**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>Panwihwitstik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>Pos i:n kachi kwaltsi:n, i:n seki tikihtowa i:n ne:n komekat i..., iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>*Más** kwaltsi:n wa:n ixiwyo no: tikihtowa ma..., no: kwaltsi:n ima:xiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>A:mo *igual** ke:meh ekintsi:n nika:wí: onkak, ne:wí:n poposokani oso okseki ne:n tata:wikmekat n' i..., ixiwyo, ta: tepitsi:n ma:we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>No: xahxakachtik, ta: seki a:mo xahxakachtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>Pos yehwa yo:n neh nik..., yo:n i:pa a:mo, a:mo kwaltia para teisá: ihkó:n nikihto:s se: k..., ika se: mopahtia ixiyo, yo:n i:pa sayoh para ne:n wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>Pos yehwa yo:n ne:n, neli ke:meh a:mo nik..., a:mo nikmati, ne: kwali a ke tine:chilih, ta:ká:n ke:masá: timoyo:le:wah pos kwali se:, se: kite:mo:ti:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Se: kite:mo:ti:w ke:meh i:n tik..., ke:masá: tikma:chihchi:wah ne:n, ihkó:n ne:n tikihilpiah ne:n se: toma:tachihchi:w pos kwali tikte:mo:ti:wih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Wa:n tine:chi:xmati:lti:s katí:n ne:n yo:n komekatsi:n, yo:n, yo:n semi kwali tikihtowa a:mo posteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>kwaltsi:n se: kweta:nia sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>Se: kwata:nia no:, no: kwaltia para se: kichihchi:wa, kwaltsi:n ne:n yowaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Pos yehwa nehjó:n neh a:mo, a:mo nikmati ne:n ke:yeh ika ... kwali a ke tine:ch..., tine:chilih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>Akin nika:n timonohno:tsah pos nochi timomati:ltiah katí:n ne:n kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts643">
                <ANNOTATION_VALUE>Se: kikwiti, se: 'kwiti ika o:me e:yi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>Kita ka:mpa wehka pos a:mo no: semi miak se: kwalkwi, ika se: o:me, e:yi *porque** eti:k no:. Eti:k *porque** neh niki:xehekowa no: no: selik, de selik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>De selik, ihkó:n xohxowik ne:n eti:k, de wa:ki a pos nochi, nochi wa:ki a, a:mo eti:k ok, aho..., ahoktia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>Ahoktia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>Pos neh yehwa sah nika:n nikmati, ne:n nik..., nimitstahtanih wa:n tine:..., kwali a ke tine:chilih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>Pos ekintsi:n no: tik..., tikmattia:tih ke kwaltia yo:n noktawahkalkomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>Pos ihkó:n kwaltsi:n timomati:ltihkeh wa:n ekintsi:n posne:n pos yehwa sah ne:n wa:n no: yehwa sah tein tikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>Pos kwali tine:chili:s ne:n moto:ka:i, de ke ke:ní:w timono:tsa wa:n ka:ni tiwa:le:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>A:, no: *igual** neh ni..., nimono:tsa Anastacio Nicolás Damián, niwa:le:w ne: San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
