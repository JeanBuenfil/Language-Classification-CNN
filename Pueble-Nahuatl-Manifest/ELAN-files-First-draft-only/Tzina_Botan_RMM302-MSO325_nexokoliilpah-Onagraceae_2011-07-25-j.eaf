        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>Ne:, ke:mah, no:, ke:mah pos komo se: iihtik, ke:mah. Pero komo payá:n tikitstok ke:meh i:n, se: imetsko titi:kak ata,</ANNOTATION_VALUE>
