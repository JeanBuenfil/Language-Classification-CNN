        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>Ne:chtapohpolwi na:nah, neh nimitstahtani:sneki ox tiki:xmati yo:n nexokoli:lpahxiwit.</ANNOTATION_VALUE>
