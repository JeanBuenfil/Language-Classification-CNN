        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Ke:mah, yehwa, yehwa, ke:mah. Wa:n de nika:wí:n pos teihsá: xiwtsitsí:n sah ihkó:n timota:lili:s *o** titai:s pos yo:n a:mo se: kiko:wtok.</ANNOTATION_VALUE>
