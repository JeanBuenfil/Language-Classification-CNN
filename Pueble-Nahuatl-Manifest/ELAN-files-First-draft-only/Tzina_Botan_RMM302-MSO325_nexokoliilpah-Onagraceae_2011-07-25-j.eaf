                <ANNOTATION_VALUE>ne:chne:xtilia:ya note:iskaltihka:w, *que** yehwa i:ni kwali kihtowa para se: moxokolia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Ke:mah, i:pa nik..., i:pa niki:xmattok, pe:wak niki:xmati *desde** a:chá: nikpiaya ke:meh se: mahtakti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>o:mo:me xiwit pe:wak, i:pa niki:xmati a *porque** pe:wak ne:chne:xtilia ne: note:iskaltihka:w katka *que** yehwa yo:ni n' kwali para pahti.</ANNOTATION_VALUE>
