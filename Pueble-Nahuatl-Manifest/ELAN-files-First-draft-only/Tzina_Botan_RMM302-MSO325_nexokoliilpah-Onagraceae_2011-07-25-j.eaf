        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>A:mo, ne: ke:man ya i:pa niki:xmattok, i:pa *desde** ne: ke:man ya i:pa, i:pa nejó:n</ANNOTATION_VALUE>
