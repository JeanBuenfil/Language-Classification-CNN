                <ANNOTATION_VALUE>Ke:mah, mah se:, mah se: moilwi nikilia neh tohtoni m' pahti *porque** komo a:mo se: kimati pos neli ka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>ka:n, ma:ski se: ti..., tik..., tikitstos ne: onkak pero komo a:mo tikmati nejó:n komo kwali para pahti pos ka:n se:..., ka:n se: kitekis wa:n de a:mo se: kimati, wa:n komo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>ke:meh i:n se: tanohno:tsa nikilia neh te:ilwiah nochi tohtoni m' pahtsitsi:ni wa:n mah se: ki:xmati pos yehwa ya yo:n se: kikwi wa:n</ANNOTATION_VALUE>
