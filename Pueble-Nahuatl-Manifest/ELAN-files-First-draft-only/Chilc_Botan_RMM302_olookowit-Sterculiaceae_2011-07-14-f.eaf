        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>Chikwas..., ke:mah ke:meh se: chikwase:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
