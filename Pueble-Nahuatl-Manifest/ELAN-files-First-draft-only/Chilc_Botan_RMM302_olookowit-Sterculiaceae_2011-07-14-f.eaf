        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>pos neh niki:xehekowa xa: onkas okseki *más** talnemili:lis[tanemili:lis]de,</ANNOTATION_VALUE>
