        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>para no:, *sea** para ne: ke:mih yo:n tikihtowah tehwa:n *este**,</ANNOTATION_VALUE>
