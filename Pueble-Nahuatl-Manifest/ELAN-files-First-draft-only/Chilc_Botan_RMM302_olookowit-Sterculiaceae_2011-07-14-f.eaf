        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Wa:n ka:mpa tehwa:n tikitakeh *que** neli *este**, neli tana:miki. Ke:mah.</ANNOTATION_VALUE>
