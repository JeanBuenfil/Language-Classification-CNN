        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>ke:meh i:n *este** i:n, yo:n te:kokoh semi se: itsontekon,</ANNOTATION_VALUE>
