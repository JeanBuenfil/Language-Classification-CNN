            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>tiki:xmatih tehwa:n tsikitsi:n, pero komo se: kika:wa mah moskalti, mah moskalti, mah moskalti n' kowtsí:n, we:i kwowit moskaltia.</ANNOTATION_VALUE>
