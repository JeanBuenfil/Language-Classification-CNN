        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>*Sea** neh nikmattok nejó:n *serbi**..., nejó:n kwaltia para n..., para o:me taman kokolis.</ANNOTATION_VALUE>
