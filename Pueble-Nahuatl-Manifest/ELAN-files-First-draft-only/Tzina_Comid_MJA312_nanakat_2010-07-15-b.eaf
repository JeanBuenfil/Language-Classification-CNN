        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Pi:sih yeh tihti:ltik, yeh kie:wa yo:n kapolkowit, no: yo:n yeh ki..., neli kapolkowit kie:wa yo:n kowtah, kapolkowit mochi:wa, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>Yeh, yeh se: kikwa a..., komo chihchika:wak a pos se: ehko wa:n se: kikokototsa yo:n iekapayo pos se: kiman iwki wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>tein yo:n chihchika:wak a pos se: kwe:chowa ika metat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Se: kwe:chowa ika metat wa:n se: kwe:cholia se: chi:lwak wa:n se: tomatsi:n wa:n tapalo:l a se: kichi:wa, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>A:mo, yo:n a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>Iwki sah *por eso** yehwa chi:lwak, chi:lposo:n ke:meskia se: kichi:wa, e:soh, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>Ne:n sinanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Sinanakat yeh ne: mochi:wa itech n' ka:mpa se: tato:ka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>wa:n se: ki..., se:, komo se: moahxilia ke:meh i:n *cuando** taekpo..., *cuando** takelpachowah ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>entó:s pos nehjó:n se: kwalkwi wa:n se: ehko wa:n se: kokototsa tsikitsitsi:n wa:n se: ki..., se: k..., kikokotochilia ne:n epaso:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>wa:n ne:n *cebolla**. Pisilitos se: kitehteki wa:n komo se: kipia se: *chilito**, pos no: se: kitehteki chi:l wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>se: kichi:wa ya ne:n, tikiliah koma:lpitsot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Pos ne: se: kipata:wa se: itix wa:n se: kita:lia itech koma:l wa:n se:, se: lado i:xoksi wa:n se: *lado** a:mo i:xoksi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>wa:n yo:n se: kikwi wa:n se: ki:xtahta:lilia ihkó:ni wa:n kixo:mekelpachowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>Se: ki:xo:mekelpachowa, yehwa yo:n tikiliah koma:lpitsot, oksi a. E:soh, ihko:ni yo:ni se: kichi:wa, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>Yo:n, yo:n nehjó:n to:tolko:skat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>Ista:k, no: *bolitas**, onkak tein *bolitas** ihko:ntsitsi:n yo:n tsikitsitsi:n ihko:ni wa:n onkak ihkó:n wehwei</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>itech i:n me:tsti *cuando** takelpachowah no: *a veces** kahsih ne: mi:lah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>We:i mochi:wa ihko:ni, pero a:mo no: semi telwe:i, ta: ihko:ntsi:n sah komo no: telwe:i mochi:wa pos pala:ni no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>pero a:mo ta: ihko:ntsi:n sah mochi:wa wa:n kwa:lkwih, se: kikwa *caldito** no:, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>A:mo, ta: se: kokototsa, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>Se: ehko, komo te:wa:lkwilia ne:n a:kin tekelpacho:ti pos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>Se: kokototsa tsikitsitsi:n, ihko:kontsitsi:n wa:n ke:mah se: kimana ya, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>No: we:lik, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>*Solo** ne:n nin..., ke:ní:w kito:ka:itiah, nikelka:w a tein mochi:wa ne: kowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>Masa:..., masa:nanakat, nikelka:w ke:ní:w, e:soh, masa:xi:poh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Yo:n, yo:n no: we:i mochi:wa ihkó:n, ihkó:n we:i, mochi:wa wa:n kwa..., kwa:lkwih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>te:wa:lkwiliah tein ya:yah kowtah ne: ke:man *porque** pos ne: ke:man neli kachi onkaya pero ekintsi:n a:mo teyi nió:n *porque** yo:n ista:knanakat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>kwa:lkwih wa:n se: kokototsa no: wa:n se: kikwa *caldito**, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Yo:n tak nehje:n itech ta:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>*Igual** ne:n nin..., yo:n nimitsilia nanakat, to:tolko:skat tein we:i, ihkó:n no: itech ta:l sah mochi:wa, a:mo kie:wa kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Ista:k no:, ista:k, ihko:ni, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Tehwa:n wel konkwia ne:n nin..., *nosuegro** katka konkwia wa:n te:chilia:ya para ta..., i:n, i:n nanakat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Mah se: kino:tsa ne: nikwiti a ne: xi:pohnanakat, xi:pohnanakat para we:lik ki:saki:w kihtowa: ya yeh, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
