        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>ihista:k nanakat, pa:pata:wak, tein, tein *enteros pos mochi:wa wehwei wa:n tein ko:kone:meh pos nohne:lmeh no: tein yo:n *apenas** moskaltihtok.</ANNOTATION_VALUE>
