        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>wa:n neh a:mo nikmati no: kox kikwih n' iteyo para ne:n pahti xa:, xa: sayoh n' ixiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>[Porque]n' ixiwyo kwaltsi:n ne: n' ma:..., ma:pohpototik wa:n kwaltsi:n ma:we:weyak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>pero ne:n n' ixo:chio kwaltsi:n pa:mpi:ktok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Pa:mpi:ktok no *de** seli..., *de** nikitaya no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>*de** selik kwaltsi:n tsaktok ok: ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>wa:n *después de** yoksi a, *de** chika:waya ne: pochi:nia ya, pos motapo:wa ne:, kwaltsi:n yewaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>Wa:n pos neh no nikitstinemi se: taman ihkó:n tak nikita pero a:mo no: nikchi:wa *cuenta de** pos tikihtowa *de** o:me taman ne:n i:n pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>*De** o:me taman, pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>pos ekintsi:n ya:ki no: tine:chilihtok pos ne:wi:n no: nik..., nikitas wa:n niki:xte:mo:s wa:n nik..., nijó:n nikitas ke:niwki nijó:n chikoa:mpah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>Pos no: nikitani ne:wi:n pero ke:meh a:mo tikmatih katí:n *de** n' para ne: n' *de** n' kone:t *de** n' [siwa:]piltsí:n oso okichpiltsi:n pos a:mo se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Pero ekintsi:n tine:chilih pos kwali se: ki..., kite:mo:ti:w wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Pos no: kwaltsi:n timoliah, para ke:masá: i:n toxwi:wa:n *o** a:ksá: se: kone:t pos te:..., te:iliskeh xa:, xa: tikmati para i:n pahti katí:n xiwtsí:n ne:n kina:mikis i:n nopili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Yo:n ki:n..., seki eliwis ki:nkihkitskiah wa:n yehwa yo:n ki:n..., kinchi:wilia *mal porque**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>*De** ma:chihchika:wkeh wa:n yema:nkeh [ix...,]*cuando** se: tsikitsi:n pos se: yema:nik ok, mosenkokowa ya wa:n yo:n kihtowah ke *hasta** te:kwi nejó:n kokolis, kinkwi ne:n kone:meh pos a:mo, a:mo wel yek:pahtisnekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Miak ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Wa:n yo:n kwali kise:nnelowah ne:n xiwtsí:n *o, o** no:, *o** no: kwaltia [tak]oso, oso ta:taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>Pos timiakeh a:mo tikmatih nijó:n ox kwali yo:n chikoa:mpah pero yo:n semi kwali ta:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>pos yehwa ne:n kikwiah ne: ke:mania:n tota:tahwa:n ne:n kikwiah ne:n xiwtsí:n sah, a:mo ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Ihwa:k a:mo teh *más** onkaya tapahtihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Wa:n yehwa ne: xiwtsí:n, te:cho:nkwi:lia:yah, *hasta** i:n tehwa:n timoskaltihkeh, ijkó:n te:chii:ilia:yah tota:tahwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>*Por eso** ekintsi:n no: timolwihtiwih ke se: kone:tsí:n, se: toxwiwih oso se: [kone:]tsí:n mah a:mo semi se: kima:a:wilti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Yehwa yo:n kichi:wilia ne:n *mal**, yehwa yo:n [mihkwi]ta ne: xoxoktik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>wa:n ye:ktsahtsih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>wa:n ika sepa ne:n pahtih, pos no: kwali moka:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>Yehwa yo:n te:, seki te:tahtaniskeh katí:n kwali ne:n xiwit pero komo nochi no: tikmattok *de** ke se: kise:nnelowaya ne:n xiwtsí:n pos nochi kwali, nochi kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>[*Por]que** a:mo ta:taman, ta:taman ne:n yetok sah ne:n ke:ní:w ... Ista:k wa:n ne:n chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>O:me taman, ¿wa:n yo:n o:me taman sah onkak a:mo, a:mo e:yi taman?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>Wa:n yo:n nochi ista:k n' i..., n' i, n' ita:kka ne:n iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Nochi iwki mok...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Pos seki ne:chiliah ke ne: ke:man no: n' tota:tahwa:n [kikwa:yah]ke: no: we:lik n' iteyo kwaltsi:n tsope:k</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>pero achi nejó:n xahxawatik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>No: tsope:k kit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>No: tsope:k n' iteyo *de** n' yo:n chikoa:mpah n' iteyo no: tsope:k yo:n ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>No: tsope:k kit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>pero neh a:mo ke:man nikekohtok nejó:n kox no: we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>Pisilitos n' iteyo pos neh sayoh nikita ne:n xahxawatik pero a:mo nikita ke:niwki n' iteyo kox, kox ti:ltik oso ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Pero neh niki:xehekowa kipias n' iteyo ne:n no: *porque** yeh nik..., Wa:n yo:n tak chiktehmeh kwikah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>N' ike:spa:n kitamo:tatih wa:n ompa ixwa *o** ok..., ompa mota:lia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>Wa:n yo:n ompa moskaltia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>*Pues, pues** kwali yetok nika:n ti..., timolihtokeh, neh a:mo, a:mo n'mati xa: kachi tikmatiaok no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>Pos koma:mo tei ok pos ne: kwali tine:chili:skia moto:ka:y, ke:ní:w timono:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>A: wa:n neh nimono:tsa Anastacio Nicolás Damián, niwa:le:w San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
