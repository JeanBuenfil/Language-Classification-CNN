        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>wa:n de mostika sepa tikmana, sepa no: titai. Ihkó:n, ihkó:n,</ANNOTATION_VALUE>
