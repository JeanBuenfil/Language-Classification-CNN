        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>Yehwa yo:n ika ne: neh nikini:n..., nikimpahtia.</ANNOTATION_VALUE>
