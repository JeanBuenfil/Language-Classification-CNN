        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>Yeh kwali titai:s kwalka:n wa:n tio:tak,</ANNOTATION_VALUE>
