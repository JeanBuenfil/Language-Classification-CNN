        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>yehwa yo:n, yehwa yo:n *hasta** ti..., *hasta** tikahxitis,</ANNOTATION_VALUE>
