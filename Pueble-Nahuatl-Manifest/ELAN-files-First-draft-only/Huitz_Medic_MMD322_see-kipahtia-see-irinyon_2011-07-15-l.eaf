            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>*huele de noche**, yehwa iwa:n se: kinelowa.</ANNOTATION_VALUE>
