        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>Tein ista:k ta: tiki:xmat... *Esole**, yehwa yo:ni.</ANNOTATION_VALUE>
