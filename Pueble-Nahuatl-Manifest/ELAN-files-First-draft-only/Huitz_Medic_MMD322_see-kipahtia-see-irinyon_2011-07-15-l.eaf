        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>A:mo semi kini..., nikihtowa mitski:xtili:ti, pero *siempre** ne:..., a:mo tikmachili:s ke:meh tikmachilihtoya.</ANNOTATION_VALUE>
