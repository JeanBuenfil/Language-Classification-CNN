        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>pané: a:mo nika:n, pané: a:mo ne: yetok ta:ltikpak, ihkó:n kimachilia.</ANNOTATION_VALUE>
