        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>se: kikwi a n' tanechiko:l xiwit, ke:meh ne:</ANNOTATION_VALUE>
