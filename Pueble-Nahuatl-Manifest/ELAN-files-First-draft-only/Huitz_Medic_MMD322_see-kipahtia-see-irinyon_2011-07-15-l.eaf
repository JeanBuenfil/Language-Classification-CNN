        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>*Porque a veces** tein ehekayoh, i:xtayowa, fie:roh kimachilia.</ANNOTATION_VALUE>
