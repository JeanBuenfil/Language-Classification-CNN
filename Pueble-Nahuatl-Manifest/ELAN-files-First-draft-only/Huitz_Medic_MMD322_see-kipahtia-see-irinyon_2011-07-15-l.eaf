        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>wa:n iwa:n *palma** wa:n tik..., tikpopo:chwia.</ANNOTATION_VALUE>
