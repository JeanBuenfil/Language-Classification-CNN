        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Entó:s de tikmachilia kwali pos tepitsi:n tika:wa ya.</ANNOTATION_VALUE>
