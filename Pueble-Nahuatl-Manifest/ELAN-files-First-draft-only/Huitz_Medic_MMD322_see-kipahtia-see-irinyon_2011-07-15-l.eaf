        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Yehwa yo:n neh name:chilwia, yehwa yo:ni, o:me taman ok yo:ni, yehwa yo:n neh nikmati m' pahti.</ANNOTATION_VALUE>
