        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts864" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n neh nikihtowa mah se: ki..., nochi kwal...,</ANNOTATION_VALUE>
