        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>yehwa n' tikihtowa n' teh mahyá: kwopach, ata kipia yo:n, seki mahyá: yo:n, tehwa:n tikihtowa mahyá: yo:n ma:tsah.</ANNOTATION_VALUE>
