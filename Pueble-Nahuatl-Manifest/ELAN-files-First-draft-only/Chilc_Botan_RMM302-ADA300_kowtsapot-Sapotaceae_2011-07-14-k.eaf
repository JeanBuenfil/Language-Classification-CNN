        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>Pero yehwa yo:n tehwa:n totahtakol, *que** ke:meh nimitsilia neh, tehwa:n tiki:xahsih sayoh ke:man chika:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts726">
                <ANNOTATION_VALUE>Wa:n *cuando** a:mo, *cuando** a:mo tei kipia ita:kilo, tikelka:wah.</ANNOTATION_VALUE>
