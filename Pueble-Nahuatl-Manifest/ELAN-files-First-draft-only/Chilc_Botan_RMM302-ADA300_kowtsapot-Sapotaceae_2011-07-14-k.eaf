        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts882" TIME_SLOT_REF2="ts883">
                <ANNOTATION_VALUE>Entó:s nejó:n mahyá: tikihtowah tehwa:n, se: kokolis ke:meh para n' ta:ltsí:n wa:n ke:meh para tehwa:n.</ANNOTATION_VALUE>
