        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>yo:n kopach kipia ompa ka:mpa xo:chiowaskia wa:n ompa ka:mpa ta:kiskia.</ANNOTATION_VALUE>
