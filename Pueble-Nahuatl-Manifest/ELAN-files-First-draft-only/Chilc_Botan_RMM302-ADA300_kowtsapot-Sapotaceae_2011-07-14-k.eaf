        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>kwaltsi:n neli yo:n kowtsitsí:n.</ANNOTATION_VALUE>
