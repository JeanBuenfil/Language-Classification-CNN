        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts731" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>Ka:mpa semi x..., semi xik..., semi xiknehmach..., xiknehmachita ka:mpa yo:n se: kowtsí:n yetok se: kowtsapot,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts733" TIME_SLOT_REF2="ts734">
