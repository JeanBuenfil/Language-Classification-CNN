        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts851">
                <ANNOTATION_VALUE>Yo:n neli semi kwali wa:n no: semi kwali para kowtati:l. Yo:n tehwa:n tikwih s..., tikwih n' nompa ne: ko..., tein a:mo, tein kinemiliah kitatsakwi:lti:skeh</ANNOTATION_VALUE>
