            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>Neh nikita neh, *mismo** yehwa:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts933" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>*mismo** tehwa:n timo..., timoyo:lchika:wah wa:n timonemiliah toni t'chi:waskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts936">
                <ANNOTATION_VALUE>Yo:n kowtsapot komo semi teltami yoksik a ne: tikpia, tikpia sake:ra se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts938">
                <ANNOTATION_VALUE>mah tikihto:ka:n sike:ra se: sempowal, o:me powal wa:n a:mo wel tiknamaka ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts939" TIME_SLOT_REF2="ts940">
                <ANNOTATION_VALUE>¿tikmatis n' toni kwali se: kichi:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts942">
                <ANNOTATION_VALUE>mah se: kikwe:cho ika ..., mah se: ..., mah kikwe:cho:ka:n *o** mah kima:pa:taka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts944">
                <ANNOTATION_VALUE>wa:n mah kima:nelo:ka:n iwa:n a:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts945" TIME_SLOT_REF2="ts946">
                <ANNOTATION_VALUE>wa:n mah kichi:waka:n *este paletas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts947" TIME_SLOT_REF2="ts948">
                <ANNOTATION_VALUE>Semi telkwali wa:n motelnamaka. A:mo semi sayoh yehwa sah, kowtsapot wa:n mah tepitsi:n yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts949" TIME_SLOT_REF2="ts950">
                <ANNOTATION_VALUE>tepitsi:n mah se: kima:nelo iwa:n, iwa:n, iwa:n *leche** tein yo:n ne: kwesala:n kinamakah, yo:n *cajitas**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts951" TIME_SLOT_REF2="ts952">
                <ANNOTATION_VALUE>ika se: li:troh de *leche**, ika se: tamachi:w de *leche** xikma:nelo iwa:n yo:n kowtsapot, sake:ra na:wi *o** ma:kwi:l kowtsapot,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts953" TIME_SLOT_REF2="ts954">
                <ANNOTATION_VALUE>wa:n ompa tikchihchi:wa ya m' *paleta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts955" TIME_SLOT_REF2="ts956">
                <ANNOTATION_VALUE>Wa:n ompa yo:n *como que** onkak se: nepale:wi:lis para tehwa:n. Neh nikmati *porque** ne: nosiwa:w ne: kalihtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts957" TIME_SLOT_REF2="ts958">
                <ANNOTATION_VALUE>i:n a:man tik..., te:chka:wili:toh seki kowtsapot wa:n oksik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts959" TIME_SLOT_REF2="ts960">
                <ANNOTATION_VALUE>Ekintsi:n kiht[ow]a nikeheko:ti kihtowa xa: kwaltias para *paletas** kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts961" TIME_SLOT_REF2="ts962">
                <ANNOTATION_VALUE>Pos takawa:ni, i:n mayo tiwa:lpano:keh teltakawa:nik, pos x'chihchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts963" TIME_SLOT_REF2="ts964">
                <ANNOTATION_VALUE>Entó:s kima:pa:tak nochi yo:n kowtsapot</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts965" TIME_SLOT_REF2="ts966">
                <ANNOTATION_VALUE>wa:n kikwito se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts967" TIME_SLOT_REF2="ts968">
                <ANNOTATION_VALUE>se: tama:chi:w yehwa de n' *leche**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts969" TIME_SLOT_REF2="ts970">
                <ANNOTATION_VALUE>wa:n kipante:kilih, kwaltsi:n kima:neloh iwa:n wa:n *kibo:lsahkehkehtsak**, kikechihil[pih]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>wa:n kita:li:to itech ne: taseselo:lo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts974">
                <ANNOTATION_VALUE>Mochi:w kihtowa seki *paletas** tele:..., telwe:lik wa:n telahwia:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts975" TIME_SLOT_REF2="ts976">
                <ANNOTATION_VALUE>a:mo te:chahsik. Kichi:w *como** se: e:yi powal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts978">
                <ANNOTATION_VALUE>se: to:nal ma:tamik nochi n' e:yi powal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts980">
                <ANNOTATION_VALUE>*Entonces** n' ompa, n' ompa yo:n se: nepale:wi:lis a para tehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts981" TIME_SLOT_REF2="ts982">
                <ANNOTATION_VALUE>Yo:n kowtsapotsí:n ne: para a:mo tika:wilo:skeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts984">
                <ANNOTATION_VALUE>*pues** tikte:molihkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts985" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>tikte:molihkeh ke:ní:w para t..., ika timopale:wi:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts987" TIME_SLOT_REF2="ts988">
                <ANNOTATION_VALUE>Wa:n neli ke:meh tine:chilia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts989" TIME_SLOT_REF2="ts990">
                <ANNOTATION_VALUE>wa:n onkak kihtowah ki..., *bueno** de a:mo tikmattokeh n' tehwa:n, te:chtapowihkeh, te:chtapowihkeh towa:mpoywa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts991" TIME_SLOT_REF2="ts992">
                <ANNOTATION_VALUE>no: kwali se: kichi:wa *dulces**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts993" TIME_SLOT_REF2="ts994">
                <ANNOTATION_VALUE>Yo:n *dulces** mah se: kichi:wa, mah se: kiki:xtili nochi n' ii:xnakayotsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts995" TIME_SLOT_REF2="ts996">
                <ANNOTATION_VALUE>wa:n, wa:n mah se: kite:ma, mah se: kita:li itech se: ko:ntsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts997" TIME_SLOT_REF2="ts998">
                <ANNOTATION_VALUE>wa:n mah tepitsi:n se: kite:kili tepitsi:n a:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts999" TIME_SLOT_REF2="ts1000">
                <ANNOTATION_VALUE>Tepitsi:n a:t wa:n ompa se: kipanta:lia yo:n kowtsapot,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1002">
                <ANNOTATION_VALUE>wa:n mah se: kite:mili tepitsi:n *azúcar** wa:n tepitsi:n *carbonato**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts1003" TIME_SLOT_REF2="ts1004">
                <ANNOTATION_VALUE>wa:n ke:mah xiktikoketsa wa:n x'ma:ma:nelo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts1005" TIME_SLOT_REF2="ts1006">
                <ANNOTATION_VALUE>'ma:ma:nelo, x'ma:ma:nelo, x'ma:ma:nelo *hasta** tami tsokowa:ki nochi yo:n a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts1007" TIME_SLOT_REF2="ts1008">
                <ANNOTATION_VALUE>wa:n ke:mah x'ki:xti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts1009" TIME_SLOT_REF2="ts1011">
                <ANNOTATION_VALUE>Wa:n mochi:wa ya ne:n..., mochi:wa ya *dulces**. Yo:n nochi onkak yo:n tamachi:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts1016" TIME_SLOT_REF2="ts1018">
                <ANNOTATION_VALUE>A:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts1020" TIME_SLOT_REF2="ts1023">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts1025" TIME_SLOT_REF2="ts1028">
                <ANNOTATION_VALUE>Ke:mah, teltsope:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts1042" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>Pos ke:meh nimitsilia neh, ne: nosiwa:w a:mo na:kin kimachtih, yeh *mismo** itech, itech itsontekon sayoh kinemilih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1045">
                <ANNOTATION_VALUE>*Bueno** pero molia pos i:n tsapot, i:n kwaltias para *paletas**, molia pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts1046" TIME_SLOT_REF2="ts1047">
                <ANNOTATION_VALUE>¿ke:n a:mo kwaltias?, wa:n ahwia:k, wa:n pa:tis wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts1048" TIME_SLOT_REF2="ts1049">
                <ANNOTATION_VALUE>n' ts..., komo sepa pa:tik kihtowa wa:n se: kita:lia itech ne:n taseselo:lo:ni kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts1050" TIME_SLOT_REF2="ts1051">
                <ANNOTATION_VALUE>kwi..., mokwis kihtowa ke:meh *paleta**. Wa:n kinemilih kichi:was wa:n ne:li n' ompa ki:sak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts1052" TIME_SLOT_REF2="ts1053">
                <ANNOTATION_VALUE>*Después** no: kwelitaya ya, kikowaya n' tsapot wa:n kimattok toni n' kichi:walti:ti. A:mo kia:wilo:s ne:n kowtsapot, *sino que** yeh kimattok toni n' kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts1054" TIME_SLOT_REF2="ts1055">
                <ANNOTATION_VALUE>De se: kowtsapot kiki:xtilia:ya *siquiera**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts1056" TIME_SLOT_REF2="ts1057">
                <ANNOTATION_VALUE>mah tikihto:ka:n kikowa e:yi pe:soh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts1058" TIME_SLOT_REF2="ts1059">
                <ANNOTATION_VALUE>e:yi pe:soh yeh kiki:xtilia *siquiera**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts1060" TIME_SLOT_REF2="ts1061">
                <ANNOTATION_VALUE>mah, mah tikihto:ka:n semi a:mo miak mah kiki:xtili se: *ocho**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts1062" TIME_SLOT_REF2="ts1063">
                <ANNOTATION_VALUE>se: chikwe:i pe:soh *o** se: mahtakti pe:soh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts1064" TIME_SLOT_REF2="ts1065">
                <ANNOTATION_VALUE>*Entonces** n' ompa ya yo:n oksé: nepale:wi:lis a para tehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts1066" TIME_SLOT_REF2="ts1067">
                <ANNOTATION_VALUE>Onkak miak ko..., onkak miak talna:miki:lis, sayoh *que** tehwa:n timosenka:wah, a:mo tikmatih toni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts1068" TIME_SLOT_REF2="ts1069">
                <ANNOTATION_VALUE>se: *por ej...**, mah tikihto:ka:n tehwa:n pos *porque** i:n kowtsapot</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts1070" TIME_SLOT_REF2="ts1071">
                <ANNOTATION_VALUE>oksik a, mah n'tamo:ta ne:wí:n *porque** pala:n ya. A:, yo:n a:mo n'chi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts1072" TIME_SLOT_REF2="ts1073">
                <ANNOTATION_VALUE>*Hasta** ke:meh a:xka:n i:n *mangos** tikihtowah telonkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts1074" TIME_SLOT_REF2="ts1075">
                <ANNOTATION_VALUE>onkak tokni:wa:n kia:wilowah ya *mangos, mejor** kipi:xowah ya *porque** a:mo no: wel kikwah ok wa:n a:mo no: wel kinamakah ok *porque** tel,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts1076" TIME_SLOT_REF2="ts1077">
                <ANNOTATION_VALUE>tel a:mo kikowah ok n' tikihto:tih n' tehwa:n. kikowah pero semi tel, teltsi:nki:stok n' ipati:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts1078" TIME_SLOT_REF2="ts1079">
                <ANNOTATION_VALUE>Pero onkak, onkak se: talna:miki:lis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts1080" TIME_SLOT_REF2="ts1081">
                <ANNOTATION_VALUE>ne:chilihtoya, ne:chilihtoya, i:n *apenas** timonohno:tstoya iwa:n se:, se: to..., se: towa:mpoy,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts1082" TIME_SLOT_REF2="ts1083">
                <ANNOTATION_VALUE>mah kichi:waka:n kihtowa, mah kichi:waka:n kihtowa *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts1084" TIME_SLOT_REF2="ts1085">
                <ANNOTATION_VALUE>*dulces o** tso..., *bueno** tsope:lik kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1087">
                <ANNOTATION_VALUE>No: we:lik kihtowa iwki *o** mah kichi:waka:n *paletas** kihtowa, *igual** kihtowa no: we:lik *para paletas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts1088" TIME_SLOT_REF2="ts1089">
                <ANNOTATION_VALUE>Wa:n neli, niki:xehekowa neli eski, pos ke:ní:w we:lik n' kowtsapot, a:mo welik eskia *mangos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts1090" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>Sayoh neli ke:meh nimitsilia neh, mah se: ki..., mah se: kinemili,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts1092" TIME_SLOT_REF2="ts1094">
                <ANNOTATION_VALUE>ke:ní:w se: kitateki:wti:s wa:n para toni se: kitateki:wti:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts1096" TIME_SLOT_REF2="ts1099">
                <ANNOTATION_VALUE>Para ihkó:n, para nochi, nochi onkas, nochi onkas nepale:wi:lis, ta: neli n' ke:meh nimitsilia neh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts1100" TIME_SLOT_REF2="ts1101">
                <ANNOTATION_VALUE>tehwa:n tikwelitah tim..., tikowaskeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts1102" TIME_SLOT_REF2="ts1103">
                <ANNOTATION_VALUE>tikixta:wati:wih nima:n ne: ka:mpa kinamakah wa:n ta: no: onkak tehwa:n nika:n para tikchihchi:waskiah, sanoke tehwa:n a:mo ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts1104" TIME_SLOT_REF2="ts1105">
                <ANNOTATION_VALUE>timosenka:wah mah tikihto:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts1106" TIME_SLOT_REF2="ts1108">
                <ANNOTATION_VALUE>Ke:mah, nikita nokni:wa:n *que** yehwa:n achi ke:mantih kichihchi:wah *mermelada**, ekintsi:n telsenka ya onkak *mango**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1113">
                <ANNOTATION_VALUE>Yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts1115" TIME_SLOT_REF2="ts1118">
                <ANNOTATION_VALUE>Yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts1120" TIME_SLOT_REF2="ts1123">
                <ANNOTATION_VALUE>Yehwa ya yo:n, yehwa ya yo:n. Yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts1125" TIME_SLOT_REF2="ts1128">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a608" TIME_SLOT_REF1="ts1133" TIME_SLOT_REF2="ts1136">
                <ANNOTATION_VALUE>A:mo nochipa. Ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610" TIME_SLOT_REF1="ts1138" TIME_SLOT_REF2="ts1141">
                <ANNOTATION_VALUE>Ke:mah, yehwa..., pos neh no: pané: yehwa sah *lo que** tein neh nikmattok wa:n tein ika nimitsnohno:tstok pos no: pané:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts1142" TIME_SLOT_REF2="ts1143">
                <ANNOTATION_VALUE>yehwa sah no: nikmattok neh. Pos semi kwaltsi:n timonohno:tskeh wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612" TIME_SLOT_REF1="ts1144" TIME_SLOT_REF2="ts1145">
                <ANNOTATION_VALUE>pos *ora**, niktasohka:mati no:, niktasohka:mati no: *lo que** tein teh tikmati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a613" TIME_SLOT_REF1="ts1146" TIME_SLOT_REF2="ts1147">
                <ANNOTATION_VALUE>tine:chtapowih, a:mo sayoh tehwa n' tike:wtok, sano a:mo tehwa n' tikmattok sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a614" TIME_SLOT_REF1="ts1148" TIME_SLOT_REF2="ts1149">
                <ANNOTATION_VALUE>*sino que** no: tine:chmati:ltih wa:n *lo que** tein neh no: nikmati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts1150" TIME_SLOT_REF2="ts1151">
                <ANNOTATION_VALUE>pos no: neh nimitsmati:ltia</ANNOTATION_VALUE>
