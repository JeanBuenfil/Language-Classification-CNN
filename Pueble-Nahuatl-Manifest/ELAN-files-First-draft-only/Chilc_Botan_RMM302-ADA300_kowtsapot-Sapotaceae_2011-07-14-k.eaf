        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>yahtok wa:n sepa seki moskaltihtok. *O sea** neh ihko:ni nikitani ke:masá: n' kwowtsapot.</ANNOTATION_VALUE>
