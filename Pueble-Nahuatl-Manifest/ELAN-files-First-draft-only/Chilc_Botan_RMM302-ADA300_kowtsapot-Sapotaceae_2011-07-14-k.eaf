        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>Pero newí:n para tani, ka:mpa ika, ka:mpa ika teh mo..., mocha:n..., mocha:nkopa pos,</ANNOTATION_VALUE>
