        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>Pero tehwa:n *lo que** tein, *lo que** tein tikpiah tehwa:n totalna:miki:lis ke:meh i:n sayoh tikelna:mikih *cuando** chika:w..., *cuando** ta:ktok tikna:litatih n' kowtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts753" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>T..., *porque** tikmattokeh *que** te:ch..., te:ch..., te:chpale:wi:ti a, tikmattokeh ika timopano:l..., ika timopano:lti:tih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
