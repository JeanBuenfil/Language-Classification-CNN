        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>neh niki:xehekowa *cada** se: xiwtika xo:chiowa ke..., xo:chiowa ke:meh o:me *viaje**.</ANNOTATION_VALUE>
