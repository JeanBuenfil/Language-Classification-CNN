        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>Komo tiknemilih tikitati:w, 'kitati wa:n komo a:mo n' kowtsí:n a:mo xkihto tikchipa:wtoti, a:mo xkihto xikta:lihto[xikta:lilihto]ne:n tapala:n para,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>para ta:kis. Sanoke yo:n nochipa ya n' ta:ki n' kowtsí:n wa:n yehwa yo:n neh nikihtowa pos</ANNOTATION_VALUE>
