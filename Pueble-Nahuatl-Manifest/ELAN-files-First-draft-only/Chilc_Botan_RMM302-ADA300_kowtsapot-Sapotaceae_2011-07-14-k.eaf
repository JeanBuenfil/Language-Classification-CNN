        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>Tikmatis onkak, onkak xiwit, wi:..., wi:tsa xiwit telkokolisyoh n...,</ANNOTATION_VALUE>
