        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n a:mo nikmati neh, ke:yeh yo:n</ANNOTATION_VALUE>
