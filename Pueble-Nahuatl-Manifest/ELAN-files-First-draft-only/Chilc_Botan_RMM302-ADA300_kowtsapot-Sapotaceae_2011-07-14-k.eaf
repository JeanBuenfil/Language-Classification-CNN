        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts793">
                <ANNOTATION_VALUE>Ke:mah tak, neh niki:xehekowa yo:n mahyá: i..., se: i...,</ANNOTATION_VALUE>
