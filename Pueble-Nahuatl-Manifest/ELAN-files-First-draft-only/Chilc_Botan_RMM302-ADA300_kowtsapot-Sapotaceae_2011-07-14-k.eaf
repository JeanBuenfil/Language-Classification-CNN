        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a616" TIME_SLOT_REF1="ts1152" TIME_SLOT_REF2="ts1153">
                <ANNOTATION_VALUE>ke:meh yekintsi:n nimitsilih ika *para paletas** kichi:waskeh yo:n kowtsapot no: semi kwali, ta:ká:n a:mo tikmatia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617" TIME_SLOT_REF1="ts1154" TIME_SLOT_REF2="ts1155">
                <ANNOTATION_VALUE>pos xikchi:wa.</ANNOTATION_VALUE>
