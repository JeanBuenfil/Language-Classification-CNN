            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts676">
                <ANNOTATION_VALUE>tein kipiah wa:n tein a:mo tikpiah pero ento:..., ento:..., *entonces kwali ika timopale:wiah *porque** pos *parejo** ke:meh ne: n' a:kin,</ANNOTATION_VALUE>
