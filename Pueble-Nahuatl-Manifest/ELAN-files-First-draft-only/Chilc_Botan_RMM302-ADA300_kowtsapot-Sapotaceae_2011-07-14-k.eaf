        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts870" TIME_SLOT_REF2="ts871">
                <ANNOTATION_VALUE>A:mo sayoh *porque** tikihtowah kowtsapotsi:n, *porque** ta:ki, wa:n tikihtowah ika timopale:wi:tih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
