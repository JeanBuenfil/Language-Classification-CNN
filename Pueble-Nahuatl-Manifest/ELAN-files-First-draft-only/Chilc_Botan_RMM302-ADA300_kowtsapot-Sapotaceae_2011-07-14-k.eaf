        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>Wa:n yo:n semi kwaltsi:n eskia mah ika timota:li:skiah mah tikihki:xtili:ka:n yo:n, *porque** yo:n ka:mpa yo:n tikihtowa teh yo:n kopach kipia,</ANNOTATION_VALUE>
