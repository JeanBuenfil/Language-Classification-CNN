        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>n' a:kin kipia wa:n a:kin a:mo kipia pos te:ma:pale:wia ya wa:n timopale:wiah ya, *parejo** timomahcha:nah ya ke:meh tikihtowah n' tehwa:n.</ANNOTATION_VALUE>
