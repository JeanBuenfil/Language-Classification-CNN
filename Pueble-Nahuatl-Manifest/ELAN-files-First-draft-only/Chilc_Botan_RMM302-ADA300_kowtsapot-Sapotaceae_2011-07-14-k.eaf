        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts810" TIME_SLOT_REF2="ts811">
                <ANNOTATION_VALUE>pos *siempre** tikitstiá:skeh wa:n tikmattiá:skeh no:, pos i:n ne:chwa:ntik a kwali i:n kowta:kilo:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts813">
                <ANNOTATION_VALUE>No: kwali a para nikpale:wis a, *porque** no: ne:chpale:wih ya neh. Wa:n yehwa yo:n nimitsilia neh semi tel..., semi tel...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>tel..., telsenka kwaltsi:n mah se: ki..., mah se:..., mah se: mo..., mah se: kitstiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts828" TIME_SLOT_REF2="ts829">
                <ANNOTATION_VALUE>*Pues** yo:n kowtsí:n kwaltia para ke:meh i:n para kalkowit, ke:meh i:n para kale:walmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts830" TIME_SLOT_REF2="ts831">
                <ANNOTATION_VALUE>wa:n kwaltia para n' taihtiyo:meh, sanoke teleti:k.</ANNOTATION_VALUE>
