        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts806" TIME_SLOT_REF2="ts807">
                <ANNOTATION_VALUE>a:mo ke:mah tiki..., tiktekiskeh ke:man kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts809">
                <ANNOTATION_VALUE>A:mo ke:man kwali tikitaskeh n' ta:kilo:t, ke:ní:w n' ta:ki kox kwali ta:ki *o** a:mo kwaltsi:n ta:ki, pero komo tehwa:n tiknehmachpiah,</ANNOTATION_VALUE>
