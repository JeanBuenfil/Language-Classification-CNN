        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>Ka:mpa tsi:n..., ka:mpa e:kapantantok a ne:n ixiwyotsi:n,</ANNOTATION_VALUE>
