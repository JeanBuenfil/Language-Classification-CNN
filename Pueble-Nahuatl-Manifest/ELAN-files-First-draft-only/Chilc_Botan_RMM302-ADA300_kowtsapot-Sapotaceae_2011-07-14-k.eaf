        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a620" TIME_SLOT_REF1="ts1160" TIME_SLOT_REF2="ts1161">
                <ANNOTATION_VALUE>tikihtowah tehwa:n ka:mpa semi s..., semi kal..., kalnehnetech,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
