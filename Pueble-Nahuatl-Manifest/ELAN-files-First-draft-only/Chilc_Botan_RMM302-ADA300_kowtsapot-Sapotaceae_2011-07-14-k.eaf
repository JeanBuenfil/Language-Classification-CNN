        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts645" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>tein yo:n achi tsik..., achi itsitsi:n, kachi nohne:lmeh,</ANNOTATION_VALUE>
