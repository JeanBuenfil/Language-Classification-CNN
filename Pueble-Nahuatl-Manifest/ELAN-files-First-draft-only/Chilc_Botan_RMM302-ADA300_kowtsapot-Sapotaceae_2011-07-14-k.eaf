        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>Wa:n seki tein ki:sak a ne:n *cosecha, entonces**, yehwa yo:n kihto:sneki *que** neli,</ANNOTATION_VALUE>
