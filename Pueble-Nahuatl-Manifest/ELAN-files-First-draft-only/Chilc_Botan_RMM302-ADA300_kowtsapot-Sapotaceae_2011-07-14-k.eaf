        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>te:chwa:lka:wilia:yah ehe:yi pe:soh *cada** se:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>Wa:n yo:n neh nikihtowa tel *bar...**, semi tel..., telkwali etok yo:n ipati:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>pero pos semi miak, miak tik..., miak tokni:wa:nkwelitah n' tein newí:n paratani,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>*porque** yo:n kow..., kowtetsí:n a:mo tikihto:tih mah semi se: kinehmachpia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts655" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>Yo:n ka:mpa moskaltihtok, ka:mpa moskaltih, moskaltih ya.</ANNOTATION_VALUE>
