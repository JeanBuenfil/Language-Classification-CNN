        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>*O** ke:ní:w yo:n, *porque, porque** neh nimitsilia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>ke:ní:w yo:n mochi:wa. Neh n' ika nimitstatsi:ntokia teh Amelia, xa: kachi tikmattos n' teh</ANNOTATION_VALUE>
