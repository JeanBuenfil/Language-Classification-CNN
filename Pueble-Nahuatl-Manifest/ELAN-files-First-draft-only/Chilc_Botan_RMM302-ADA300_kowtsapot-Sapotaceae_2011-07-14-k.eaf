        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>Pos n' ompaka newí:n paratani *porque** nika:n ka:mpa ika, nika:n ka:mpa ika tehwa:n a:mo, pané: a:mo okachi kie:kneki moye:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts666">
                <ANNOTATION_VALUE>a:mo te:chye:kta:kamati porin tak, *siempre más** tasese:ya ya.</ANNOTATION_VALUE>
