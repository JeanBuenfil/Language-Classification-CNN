        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>no:, no: ke:meh, ke:meh mets..., ke:meh wi:tsa, ke:meh wi:tsa xiwit.</ANNOTATION_VALUE>
