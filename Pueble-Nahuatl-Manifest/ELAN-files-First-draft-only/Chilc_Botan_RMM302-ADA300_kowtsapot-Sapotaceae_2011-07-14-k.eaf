        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>*Entonces** yehwa yo:n tikihto:snekih tehwa:n xiwit,</ANNOTATION_VALUE>
