                <ANNOTATION_VALUE>wa:n seki a:mo we:i ta:ki. Wa:n seki, seki yehwa n' tein nimitsilia kostiktsapot, kostik... kostikkwowtsapot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>Yehwa sah yo:ni. Yo:n e:yi taman, e:yi taman mah tikihto:ka:n neh niki:xmattok no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Wa:n tak xa: eski ke:m..., xa: eski neli *porque** neh nikita n' a:man neli n' kwowtsapot ka:n</ANNOTATION_VALUE>
