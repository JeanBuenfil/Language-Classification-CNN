        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts741" TIME_SLOT_REF2="ts743">
                <ANNOTATION_VALUE>Wa:n ka:mpa yo:n xo:chiowaskia komo nochi yehwa yo:n pachti kipia, a:mo xkihto *que** xo:chiowas ok *sino que**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts745" TIME_SLOT_REF2="ts748">
