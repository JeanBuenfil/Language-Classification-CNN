        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>ne:n imaxaltsi:n ompa ya pe:wa ya ne: mopihpilowilia ne:n ta:kilo:tsí:n.</ANNOTATION_VALUE>
