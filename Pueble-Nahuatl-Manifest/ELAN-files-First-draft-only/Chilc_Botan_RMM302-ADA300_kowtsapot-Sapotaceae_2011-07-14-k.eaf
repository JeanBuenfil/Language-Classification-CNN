        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>Pos, yehwa sah yo:n neh ika nimitsnohno:tsaya wa:n nimits..., nimitstatsi:ntokia:ya *porque** para no: nikahsika:matis neh.</ANNOTATION_VALUE>
