        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts637">
                <ANNOTATION_VALUE>O:me si:entoh se: koxta:l. Ke:mah. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>Ke:mah *porque** neh nimitsilia ne: kalihtik neh ka:mpa ne: neh, ka:mpa tehwa:n ticha:nchi:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>te:chwa:lkwiliah n' kowtsapotsí:n, te:chwa:lkwiliah</ANNOTATION_VALUE>
