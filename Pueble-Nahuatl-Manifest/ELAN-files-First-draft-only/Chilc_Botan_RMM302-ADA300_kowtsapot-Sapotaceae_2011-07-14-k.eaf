        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>Sayoh a:mo ke:mah, tehwa:n a:mo ke:man semi tik..., a:mo semi ke:man tikitah, semi ika timota:liah mah tikitaka:n ke:ní:w n' ta:ki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>wa:n ke:ní:w xo:chiowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>*Porque** tehwa:n tikahkoitah neli ke:meh tikihtowa n' teh, tehwa:n tiki:xahsih n' kowtsí:n *cuando** chika:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>Ihwa:k n' tehwa:n tikahkoitatih *cuando** chika:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>Wa:n yo:n semi, semi k..., semi a:mo kwaltsi:n. Moneki komo tehwa:n semi tiknehmachpiaskiah yo:n kow..., yo:n kowta:kilotsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>kipia *que** tikitaskiah wa:n tikahsika:matiskiah ke:ní:w n' *cuando** pe:wa xo:chiowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>ka:nachi me:tsti para pe:wa *o** ka:nachi me:tsti para pe:wa chika:waya ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>Pero tehwa:n a:mo ke:man tikchi:wah kwe:ntah, ti..., tehwa:n, ta: tehwa:n tikchi:wah kwe:ntah neli ke:meh nimitsilia neh *cuando** yo:n chika:wtok a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>*Cuando** tikmatih *que** k..., *que** we:liati a, ihwa:k a n' tehwa:n tikahkoi:xahsitih ya ne:n kowtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>Wa:n yo:n semi yo:n kwaltsi:n, semi yo:n, semi taman yo:n talna:miki:lis, ta: kwaltsi:n neli mah tiknehmachpiaskiah n' tokowta:kilo:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>para tikahsika:matiskiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>ke:ni:w, ke:ní:w xo:chiowa, ke:ní:w n' ta:ki, pero pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>pero komohkó:n tik..., tik..., tik..., timonemilia n' teh *más, más** i:n..., *bueno**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>sanokachi teh xkitas, sanokachi teh xta:li, xta:li, xikta:li</ANNOTATION_VALUE>
