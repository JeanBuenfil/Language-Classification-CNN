        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>Wa:n n'neltoka yeski *porque** ke:meh a:xka:n i:n ke:meh tikihtowa n' teh xo:chiohtiw a wa:n sepa seki kpia ya.</ANNOTATION_VALUE>
