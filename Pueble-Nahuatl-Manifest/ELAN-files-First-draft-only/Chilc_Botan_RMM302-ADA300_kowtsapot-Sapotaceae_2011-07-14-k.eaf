            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>Nochi mochi:wa yo:n mah *hasta, hasta cualquier** kowta:kilo:t, komo a:mo *ticuida...**, tiknehmachpiah n' tehwa:n wa:n a:mo timo...,</ANNOTATION_VALUE>
