        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts805">
                <ANNOTATION_VALUE>mah tikihto:ka:n tehwa:n timomakah se: to:nal *de que** tikchipa:waskeh a:mo ke:man tik...,</ANNOTATION_VALUE>
