        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts890" TIME_SLOT_REF2="ts891">
                <ANNOTATION_VALUE>nochipaya n' onkak ne:n tapala:n itech n' to..., itech n' tota:ltikpaktsi:n wa:n ka:mpa ne:n tokahfe:ntah *o** ka:mpa ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts892" TIME_SLOT_REF2="ts893">
                <ANNOTATION_VALUE>ka:mpa ti..., ka:mpa tikpiaskeh yo:n kowtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts894" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>Neh nikilwia neh de nochi te:chpale:wia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts896" TIME_SLOT_REF2="ts897">
                <ANNOTATION_VALUE>Ke:mah wa:n yehwa neh nimitsilia, pos a:mo nikmati xa:, xa: yehwa sah. Pané: nik..., nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts898" TIME_SLOT_REF2="ts899">
                <ANNOTATION_VALUE>a:mo t'mat..., a:mo n'mati neh xa: teihsá: tatsi:ntokalis ok tikpias *o** oksé: talna:miki:lis *o**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts900" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>neh pané: nikmati pané: nochi a n' tein nimitsilwih wa:n pos neh *hasta** ompa sah neh nikmattok, neh a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts904" TIME_SLOT_REF2="ts907">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts920" TIME_SLOT_REF2="ts923">
                <ANNOTATION_VALUE>*Pues** xkita,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts928">
                <ANNOTATION_VALUE>a:xka:n yo:n talna:miki:lis tein tine:chiliwtok, yo:n no: semi kwaltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts930">
