        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>Wa:n a:t kite:kiliah para yo:n a..., yo:n kite:kiliah n' texkaltet,</ANNOTATION_VALUE>
