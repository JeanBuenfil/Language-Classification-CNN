            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Tikita yo:n teihi..., yo:n sipo, sip..., sipomeh ata yo:n teihix..., ata yo:n te:ihixkanih kiniliah, pero yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
