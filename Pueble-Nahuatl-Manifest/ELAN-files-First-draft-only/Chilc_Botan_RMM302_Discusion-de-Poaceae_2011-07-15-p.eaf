        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>yo:n ke:mah neli, neli miak, miak tapale:wia *porque** ika n' tapialtsitsí:n ika motekipanowah, kwa:kwehmeh, *caballos**, tein</ANNOTATION_VALUE>
