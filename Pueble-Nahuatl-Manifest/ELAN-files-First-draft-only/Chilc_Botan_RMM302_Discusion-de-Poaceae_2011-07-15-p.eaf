            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>Sayoh yehwa sah yo:n nim..., ne:ch..., ne:ch..., ne:chpolo:to neli a:mo nikto:ka:yi:xmati,</ANNOTATION_VALUE>
