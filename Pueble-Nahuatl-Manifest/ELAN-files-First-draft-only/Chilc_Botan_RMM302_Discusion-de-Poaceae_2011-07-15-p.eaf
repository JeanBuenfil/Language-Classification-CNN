        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>no: ka:mpa weli sah. No: onkak sah ka:mpa mochi:wa, a:mo, a:mo tikihto:tih no:ya:n mah tikihto:ka:n nochi yehwa ika tasakayohtok. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>Yo:n yeh ika kito:kaytiah wa:n yo:n a:mo teh kwaltia. nió:n para tikihto:tih sake:ra tapialmeh ika motekipano:tih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
