        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Ke:mah. A:chá: onkak, pané n'mati, a:mo nikye:kma..., a:mo nikye:kelna:miki pané nikmati onkak *hasta** e:yi taman iteyo.</ANNOTATION_VALUE>
