        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Ka:mpa aha:tawyoh semi, semi telionkaya:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
