        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>Pero yo:n a:mo no: kikwah kwa:kwehmeh, yo:n i:pa no: sayoh onkak sayoh ke:meh i:n ka:mpa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
