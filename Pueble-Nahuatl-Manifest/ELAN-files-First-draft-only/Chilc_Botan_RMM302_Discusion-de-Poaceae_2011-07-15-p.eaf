        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>Pero pané: semi, semi, semi, semi neh niktelmattok kwali *que** onkak o:me taman. Onkak n' tein nextik wa:n onkak yo:n tihti:ltik n' iteyo.</ANNOTATION_VALUE>
