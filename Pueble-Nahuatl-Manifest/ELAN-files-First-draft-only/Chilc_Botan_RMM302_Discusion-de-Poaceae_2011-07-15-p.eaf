            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>mah tikihto:ka:n tehwa:n telta:ltetexka:n, yo:n semi yehwa yo:n ompa e:wa.</ANNOTATION_VALUE>
