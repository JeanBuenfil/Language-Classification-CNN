            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Yeh ika kiliah si:sipo, si:sipo, si..., sakasi:sipotsi:n porin mahyá: sipotsi:n ne:n, si:sipotsi:n ne:n iteyo, yeh ka kiliah si:sipotsi:n.</ANNOTATION_VALUE>
