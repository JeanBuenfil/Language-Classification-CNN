    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Amelia Domínguez Alcántara" TIER_ID="Amelia Domínguez Alcántara">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>A:man ki..., *bueno**, no: n'te:kakilia:ni kihtowah ke se:, *bueno**, namehwa:n ke i:n nan..., nankinitah siwa:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>no: nanki:xehekowah ke:maniá:n okichpil wa:n ke:maniá:n nejó:n siwa:pil. ¿Ke:ní:w yo:n nankimatih?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>Ta:ká:n se: siwa:t, *este**, i:ksá: kineki komo ke pilma:yowis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>ke:meh yo:ni ¿ke:ní:w ne:n tikpale:wia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>*Porque** kihtowah ke no: onkak siwa:meh ke i:ksá: a:mo kineki moskalti:s n' pili, ne:n, yekinikatsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>A:mo, nimitsilwia:ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>¿ke:ní:w kwali se kimpale:wia? Porque onkak seki pilimeh ke, oso seki siwa:meh mahyá a:mo wel mokokoxka:ta:liah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>[si]no ke mokokoxka:ta:liah ya wa:n niman ne: komo ke ...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>A:mo, a:mo kitamotah *sino** moyo:koliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>A:mo, a:mo *porque** kinekih *sino que**, mahyá: no: se: kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Pero kihtowah ke no: onkak ke:ní:w se: kimpale:wis, a:mo n'mati, neh nikinte:nkakilia:nisah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>Aha, a:mo tehwa tik..., a:mo tehwa xikchi:wa ke, mah mah kimikti:ka:n impili, *sino** ke:ní:w mopale:wi:skeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>Para mah a:mo miki yo:n pili, *porque** komo yehwa:n a:mo mopahtihkeh yo:n pili kwali mikih, *o sea** pilma:yowih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>A:mo yeh, p..., a:mo *porque** yehwa:n kinekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>*Sino** moyo:koliah sah. Aha, ¿toni yo:n ika tikpahtia ox no: i:ksá: tikimpale:wia:ni?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>Tikihtowa:yah ne: ke *después** de mochipa:wah mah tai:ka:n yo:n a:tsi:n ¿Ka:nachi to:nal ke moneki tai:skeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>Aha.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>Yo:n xiwtsitsi:n tein tite:chilwih yeh para ne: se:, para se: mah tai se: siwa:t tein a:mo wel ke:man mokokoxka:ta:lia. Wa:n no: ye:wa 'te:chtapowih ke onkak seki xiwtsitsi:n ke:man se: siwa:t mokokoxka:ta:lia pero niman pe:wa mahyá: kimachilia ke mikis ..., *bueno** temosneki ipilitsi:n, kineki, ne:, mah tikihto:ka:n, mikisneki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>¿Kati:yeh xiwmeh yo:n kwali ne:n 'tai:skeh para mah a:mo chi:wi yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>[Wa:]n ke:man a:mo mik..., a:mo temowa ok pili, mo..., moye:kta:lia ya, *hasta** nemis a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>Mm, pos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>E:yi taman. A:mo teisá: tikmati ok, *este**, ke:man nemiki ¿Ke:n..., ke:ní:w ne:n, ke:n tikmati ke nemiti a se: pili?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>Tikihtowa ke:man pe:wa temowa pili kinilpiah ne:n *este**, nika:n ahko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>komohkó:n yo:n pili mokepak *o** komohkó:n a:mo t..., a:mo tikilpih ne:n siwa:t toni weli, toni chi:wis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>Ke:man chi:wi yo:ni kwali miki se:meh de, pili oso te:momá:n, oso a:mo teh chi:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts569">
                <ANNOTATION_VALUE>Tikihtowa ke ika olo:t nankitekiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>¿Wa:n olo:t ke:yeh? ¿Toni ika kichi:wayah olo:t?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>¿Yo:n tachihchi:w a yo:n tikilia *ombligos**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts609">
                <ANNOTATION_VALUE>Ah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>Pos yehwa sah komohkó:n a:mo tikmati ok, miak tasohka:matik. N...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>Pos yehwa sah, sepa yankwiká xite:chtapowi moto:ka:y, ka:ni tiwa:le:wa wa:n ka:nachi xiwit tikpia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>Pos miak tasohka:matik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="María Ocotlán Fermin Cabrera" TIER_ID="María Ocotlán Fermin Cabrera">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Ke:mah, *cuando** ihkó:n ne:ch..., ne:chitatih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>ika se: kokoxkeh tein mokokowa, de *tres meses**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>niman ne:chilwiah, "Xkitati ne: *noseñora**, ox ne: toni kimaka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>kipia *tres meses** de mochipa:wak ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>wa:n a:man a:mo mochipa:wtok. Nikneki nikmatis toni kipia, *o** ke xa: kipia kokolis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>para nikwi:kas iwa:n *médico**. Pero achto teh xikitati." Nikili:s, "*Bueno**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>Xikwi:ka ompa i:n, ompa nikitas."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>"A:, we:noh, entó:s ompa tiá:s." "Ompa niá:s, ompa nikitati:w."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>"Entó:s komo tiá:s para ompa timitschiah" *o** "Ompa 'te:chchia."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>"Ompa name:chchia," *o** "ompa nane:chchiah." Kihto:s, "*Bueno**."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>Entó:s ompa ne: niahsi. *Nikregistra:rowa** nehjó:n *paciente** wa:n ke:mah nikpahpachowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>Pero como niman ne:, neli ke:meh se: kihtowa tehwa:n komo *tiksoba:roh** kwaltsi:n, kwaltsi:n wa:n moka:wa *suavecita n' ipancita**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>entó:s mota:lia se:, se: *manchita** ke:meh nehjí:n tepostsi:n, i:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>Se: *manchita** nika:n mota:lia. "A:mo ta: pané: pili tikpia."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>"A: we:noh, nikpiati pili."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>"Ke:mah tikpia pili."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>"Aha, wa:n, ne:, *cuando** nikpias *cinco meses, más** ¿tine:chyo:lmela:was?" "Ke:mah, nimitsyo:lmela:wtia:ti ke:ní:w, ke:meh teh tikwi:katiw *moembarzo*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>*Porque** tina..., nam..., nane:chilwihkeh mah *nimitskwida:ro, nimitskwida:ro:ti, a ver hasta** ke:man *timosalva:ro:s *hasta** ihwa:k neh nimitska:was." "Pos we:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>'Ne:chkwida:ro." "Pero nimitspahpachohtia:ti iwki, iwki ke:meh tik..., ke:meh tiktohtokati *momes**, neh no: iwki nimitspahpachohtiá:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>wa:n nikye:kta:li:s mopili. Nikmachili:s ox i:xtapaletok ox xa: kwityetok, ox xa: ixt..., *a veces** mota:lia i:xtapal tikihtowah, *atravesado**, pero *pues como atravesado** etok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>*o** kwityetok de *primero de, de cuatro meses, cinco meses**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>niman se: kimachilia n' *icabeza** nika:n, ke nika:n kipia n' *icabecita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>Entó:s weli, timoma:ohsa *aceitito** wa:n tikwi:ka ya para ne: *o, bien, bien** tikwi:ka para nika:í:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>Tikwi:ka para nika:n *hasta** nehjó:n pili tikmachilihtiw</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>*icabecita** ka:nika yahtok, ka:nika yahtok wa:n teh *tiksegui:rowilia**, tikpahpachowa ne:n *paciente**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>*hasta** tikta:li:ti:w *frente n' icabeza**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>tikta:liliah *frente icabecita**, a:xka:n x'machili</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>*hasta** ta:kat nikilwi:s, "Teh *señor**, a:mo x'nehnemili *moseñorah**, xikmachihli:ki ka:nika etok ekintsi:n *icabeza** pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>kwityetoya *o** i:xtapalyetoya, ekintsi:n x'machili, ekintsi:n kwali etok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>Ekintsi:n a:mo ne:, a:mo teh xmolwihto, ke:mah n' tamati:yak *hasta** neh no: n'machilihtok n' tamati:yak."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>"*Porque** ne:chkokowa:ya semi nika:n *o** a:mo wel 'nakasikakochi." Ke:ní:w mah nakasikakochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>pos ta: nika:n i:n mokalakia *icabecita o** wa:n itsi:ntayo nika:wí:n wi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Ni..., [ni]kihto:s pos, "¿kwali moka:w?" "kwali moka:w."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>"*A ver** x'machili, 'machili *mismo** tehwa. A:mo t'nehnemili:s *moseñora porque** no: ompa tiwa:le:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>X'machili *moseñora** ka:ni kipia *ipilkabecita,"** ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>Komo ihko:ko:ntsi:n kipia *cinco meses**, ihko:ko:ntsi:n motaka:wilia n' *icabecita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>Komo *más, más** tepitsi:n *más** tepisti:n we:ia kipia *seis meses**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>*Cuando** kita:lis a yo:n *siete meses** ya, *siete, ocho, más** we:ia n' *icabecita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>Ihwa:k ke:mah, nochi t'machili:s a ke:ní:w yetok. Mm. Yetos paratani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>*Menos** mota:li:s ilakats, *menos** mota:li:s n' ikwitako:n nika:n *porque** kikokohtos."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>Niman nikili:s, "Nika:n mitskokowa." "Ehe, ne:chkokowa."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>"Neh a:mo moneki 'ne:chilwi:s. nika:wí:", nikili:s, "i:n mitskokowa." "Ehe, ne:chkokowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Ne:chkokowa neli." Pe:wa ya m'pahpachowa, pe:wa ya m'pahpachowa ihkó:n, *hasta por fin** moye:kta:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Mota:lia kwaltsi:n ihkó:n wa:n ke:mah ne: nik..., ne: yo:n nikpahpachowa ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts91">
                <ANNOTATION_VALUE>kwaltsi:n, kwaltsi:n nikwi:kilia ihkó:n, kwaltsi:n ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>kwaltsi:n nikchi:wa ihkó:n. Ompa nikahokwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>A:mo ke:man se: *nopaciente** nikpia mota:lia *bola** nika:n, a:mo ke:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>*Siempre nopaciente** ehkos n' i..., ikwitako:n tikiliah tehwa:n nika:n, etos *de ladito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>*Porque** mah se: kipahpacho para momela:was nehjó:n pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Para momelawa pili *hasta** siwa:t no: kwali ne:nentok a:mo mopilowa nika:n sah. Ke:mah, ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>Ihkó:n neh n'tekiti ika ne: *nopartera, nipartera** pero ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Wa:n a:mo nimone:xtilih kihto:s *abuelita o notio, o notia o nohermana, no señor**, nimone:xtilih *por necesidad**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>*Cuando** neh nikimpiaya pilimeh wa:n a:mo m´pia n' tomi:n wa:n n'taxta:wia *partera** ne:chpahpacho:ki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>ta:ká:n *cinco pesos** ta:ká:n *diez pesos** pero koma:mo nikpia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>wa:n nikitaya ke:ní:w ne:chchi:waya *pobrecito nopartera** ka:mpa *Dios** kipia a:xka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>*mismo** neh nimota:lia wa:n xkita, nikwi:ka *nopancita**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>*a ver hasta** ka..., kama..., ka:nika *moacomoda:ro:ti** nehjó:n nopili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>A:mo a:kan nikilwia ok, ne:chkokohtok nika:n pos *órale**, ne:chkokowa nika:n pos *órale**, nika:n niow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Wa:n nopilitsi:n no: n'machilihtiw *icabecita** nika:n ka:nika mota:li:ki:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>Komo mota:li:ko *frente** nika:n *icabecita** pos no: nitamati:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>A: pos no: niweli a, *porque** nitamati:yak, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Wa:n ihkó:n neh nimomachtih, a:mo a:kin ne:chilwih, ximomachti, ximo..., ximo..., ximomachti yehwa i:n tekit xikpia, kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>Nimonemilih *mismo** nehwa sah. Nikmachilihtok ke:ní:w ne:chpahpachohtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>*Mismo** neh *nosentidos** niknemilih. Nimopahpacho:ti. *A ver** ton Dios kihtowa, xa: nitamati:yas</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>*porque a veces** t..., tehwa:n ti..., *rancho** titama:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>Tikwitih tokow, ta:ká:n tikwitih tosin, ta:ká:n tikwitih teisá: tama:mal, pero kipia ke tikwiti:wih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>Entó:s topilitsi:n komo tepitsi:n nimoilakatswita:tsoh pos nopilitsi:n no: sentapal yowi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Ka:n nikihto:s tak..., takwa:wka:yetok ta: pos yeh yemaxtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Ke:mah, ihkó:n neh nimo..., nimo..., nimomachtih nose:lti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>A:mo akah nikilwih xne:chmachti, xne:chilwi ke:ní:w tip..., nik..., nipahtis *o** ke:ní:w, ah, kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>*Mismo** neh nimone:xtilih, *hasta** pe:wak a ihkó:n ki..., seki:n x'kakili, "Pero ne:chtelkokowa."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>"Ah, mitskokowa, 'mopahpacho."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>"Pero ka:n niweli."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>"¿Pero komo ke a:mo tiwelis? *A ver** xmote:ka, 'mote:ka wa:n nimitspahpacho:ti. ox ne: tiwelis, ta:ká:n t'miktih."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>Ka:n nikimiktih neh, wehwei:n ya, wa:n nikim..., 'mopahpachowa nose:lti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>"Iwkwí:n xmopahpacho, ihkó:n, ihkó:n ka:nika mitskokowa ompa xkitki ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Ka:n xkitki eliwis ta: tikwi:ka yo:li:ktsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>ika moma:kpal, ihkó:n. Wa:n nika:n t'machilihtiw ka:nika mitskokohtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Komo [ihkó:n]etok *frente** nikilia *icabecita, pos *adelante** a:mo teisá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Kanah. Pahti, tamati:ya. Miak siwa:meh ihkó:n nikimpahpachoh. Aha, miak siwa:meh, nikimpahpachowa:ya, tamati:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>*Por último** a:it ke:ní:w i:n ne:chma:ahsikeh, para ke:mah *nimoregistra:roh** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Nikchiak *cuatro, cuatro viajes** Zacapoxtla, *cuatro, cuatro meses, al mes** nia:ya, *al mes** nia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>*Después** niah Tlatlauqui[tepec], *después** niah Chignahuapan, *después** niah Puebla, *después** niah *hasta** México.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>Nitaminemik a, nitaminemik a *cursos, primero Dios**, a:xka:n a:mo *ne:chfallarowa** para ke:s nikihto:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>A:mo ke:man n'te:ma:ktia se: siwa:t mike:t wa:n a:mo ke:man n'te:ma:ktia se: pili mike:t, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>*Primero Dios** kwali yahtok *notrabajo** pero *sol..., solito** nehwa nimone:xtilih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>a:mo a:kah ne:chchilwih ihkwí:n 'pahtis, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Wa:n yehwa sah, tasohka:matik, welik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>Tasohka:matik ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>Pos *la mera verdad** neh a:mo ke:man n'mati ke:maniá:n okichpil wa:n ke:maniá:n siwa:pil. Neh a:mo ke:man, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Soh ke tepisti:n, *porque cuando** okichpil, mota:lia *medio** ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>*atravesado** ke:meskia, ke:mah, ihkó:n monakasikata:lia tikihtowah wa:n *cuando** siwa:pil mosentapachowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Tikmachili:s nika:n pero *puro** ikwitte:nomiotsi:n de i:n para *hasta** nika:n *ilomo** para *icabecita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>Yehwa yo:n tepitsi:n ika nimomaka kwe:ntah. Wa:n komo okichpiltsi:n pos yehwa ya mahyá: ihkó:n mok..., monakasikata:lia, *cerca** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>¿Ke:yeh *cerca** ya wa:n ke:yeh mokepa ya? *Porque** yeh no: kimati ke:ní:w moehkawi:ti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>ke:ní:w moehkolti:tia ta:ltikpak, mm, [iw]ki yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Neh a:mo nimokalakia, neh a:mo nimokalakia, yo:n ke:mah a:mo nimokalakia neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Ke:ní:w mah neh n'ma:ma se:, se: tahtakol por se: *ángelo**. ¡'nemili sah!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Se: *ángelo, más** ok ke se: *nuestra señora virgen María Santísima** nik..., *cuando** nikiskaltia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>*más** nikpia *valor** ke mah nikpia nopili wa:n *menos** ke niktamo:tas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Kihto:s, neh niktamo:tati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>*Bueno** wa:n ¿Ke:yeh t'tamo:tati? Ke:yeh timote:ka:wilihtok iwa:n ta:kat koma:mo tikneki tikpias.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>¿Ke:yeh timote:makatok iwa:n ta:kat koma:mo tikneki titaskalti:s?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>*Mejor** xtaskalti wa:n *mejor** xikpia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>wa:n para *la otra** ya *ximo..., moopera:ro** ya *mejor**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>para a:mo tikimpias pilimeh. X'chi:wa tein t'nekis pero a:mo titahtakohtok ika se: *ángelo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Kitamo:tah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Seki ke:mah, weli, weli. Aha, aha, ke:mah, ke:mah, ke:mah, mastika</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>*Eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Moyo:kolia pili, *exactamente**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Pos de se: kimpale:wia, se: kimpale:wia. Pero *la mera verdad** neh nikilia, "*Mejor** xmo..., ekintsi:n *mitspasa:roh** ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>*mitspasa:roh** ya i:n *de malas**, pero a:mo tikmatih para *la otra**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>*Cuando** sepa tikitas *dos meses, tres meses** a:mo timochipa:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>xiow iwa:n se: *señor o** se: *señora**. 'Ta:tawti mah mitspale:wi iwa:n Dios, tikneki tikitas *moangelito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Tikneki tikitas mopilitsi:n pos xiow iwa:n ne: *señor**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>wa:n neh nimitsmakati seki xiwtsi:n pero a:mo para wetsis n' *ángelo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>"Neh nimitsmakati seki xiwtsi:n para timo..., *más** mah, mah kikwi *valor** ke mah moskalti." Ihkó:n yo:ni se: kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>*Porque** ma..., onkak, "¿Ka:n t'pia pahti para se: kitamo:tas pili?" "¡Nió:n no: xne:chilwi, nió:n no: xne:chilwi!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>A:mo xne:chilwi *porque** a:mo nikwelkaki, a:mo nikwelita,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>*porque** komo neh nikmati ke nimokokoxka:ta:li:ti pero *eso si** ke mah nikpia pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Mah nikiskalti, mah we:ia, mah ne:chpa:kti *o** mah ne:chkwala:nti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>*porque** ihwa..., onkak te:pa:ktih wa:n onkak te:kwala:ntih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>¿Ke:yeh? *porque** seki telma:wiltiah, seki a:mo takakih, seki ma..., seki mokwapi:pilo:tih, se..., *o bien** me:walti:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Entó:s ompa wi:tsa ya n' *coraje** para se: yehwa. Pero i:n a:mo, yehwa yo:nse: kichi:wa. Neh a:mo niwelis nikpale:wi:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>pero oksé: *señor o** se: *señora** nikilwi:s mah kitati. Mah kipale:wi, mah kiyo:lchika:wa iwa:n *todios**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Mah a:mo *pasa:ro** ok, *porque komo nochipa ke:meh yo:n, a:it ka:n 'tamiskiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Wa:n nochipa iwki, wa:n nochipa iwki wa:n ta: neh no: niknekiskia*porque a veces** tiwetstokeh itech kokolis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>*a veces** timaya:nah, *a veces tia:mikih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>No: 'tahtaniskeh tsiktsi:n a:t. ¿Pero a:koni tiktahtani:ti? Ka:n a:kin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>Nopilitsi:n mikik, nopilitsi:n ka:n nemi, wa:n a:mo. *Mejor** mah moskalti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Wa:n *mejor** mah we:ia ke *cualquier rato** pos ne: kine..., niknekis a:tsi:n, niknekis tsiktsi:n teisá: pos ne:chmakas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Ta: n'tasohta, wa:n n'tasohtak, ihkó:n se: kimpale:wia nehjó:n na:nahmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>*O** kihto:s, neh a:mo wel nimokokoxka:ta:lia wa:n no: nikneki se: nopilitsi:n, skie:ra, "¿A:, t'neki mopilitsi:n. *Bueno**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>nimitsmakas xiwtsi:n, *cada** timochipa:was ti..., titai:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>titai:s ne: *mirtos**, titai:s tsapotsitsi:n, titai:s siwa:pah, titai:s tsope:likxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>*Cada** timotapa:ki:s, timotamitapa:kia titai i:n a:tsi:n, se: *tesito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Komo titai:ki:n tesito, pos xkowa, xkowa i:n, yehwa i:n wa:n yehwa i:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>'xi:kowa ne: *mirtos** wa:n 'xi:kowa ne: siwa:pahtehwa:n 'xi:kowa ne: tsapotsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>wa:n 'xi:kowa ne: nehjó:n *vitamina**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Pero a:mo se: kimati, *a veces** wetsih pilimeh pero a:mo kipiah, a:mo kipiah ne: neyo:lchika:walis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>*O** teisá: *tikantoja:rowa**, tikwa:sneki. Pero a:mo tikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>Entó:s pos, mits..., mitschi:wilia *mal** a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>Ke:mah yehwa yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Titoli:na *o bien** titoli:na wa:n tikwa:sneki wa:n a:mo tikwah. Entó:s ompa ya, ompa, ompa ya pe:wa ne: yo:n nekokol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Mm. Tiktamo:tati pili *por medio** de tikwa:snekia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>*A veces** a:mo moneki se: *bola, a veces** t..., tioli:nis ika se: *pedacito de sandia** se: *pedacito de manzana o, o cosas lo que** tein onkak ne: *plaza**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>Pos 'kita, koma:mo wel *moembarazowa de dos, tres meses, cad..., hasta cuatro meses**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>mah tai yehwa n' a:tsi:n, mah tai ne:n pisi:lnek, pisi:lnek wa:n mah tai a yehwa yo:n xiwtsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>Mah tai yo:n xiwtsitsi:n para *con eso** mah moyo:lchika:wa wa:n mo..., mah motot..., ke:meskia mah kawa:ni i..., *ipancita**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>Wa:n koma:mo teh tikpahpachowa, tikpahpachowa *porque** onkak, onkak ne: ni..., nisiwa..., tosiwa:yo ke:meh i:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>Takwa:wak, mimiltik, yetok, etok pero pos takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>Wa:n komo tikchi:wak *suavecito** ya, tikpahpachoh ihkó:n, nochi n' ohka:n wa:n nika:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>x'chi:wa kwaltsi:n ihkó:n x'pahpacho, x'pahpacho, x'pahpacho. Ihkó:n tikxita:nia ika teisá:, ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>Seko n' italwayotsi:n, *parejo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>Ihkó:n t'pahpachowa wa:n komo t'pahpachoh tikmachilia ya no:. Italwayotsi:n yema:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Nochi n' e:xka:n,*porque** tehwa:n ata tikpiah e:yi de ne:n, nehjó:n tein nika:n ne: moskaltia topili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>Wa:n se: tein ika *tikrecibi:rowah** topili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>Ke:mah. Se: wa:n se: ika moskaltia tein *cuando** ke:meskia timoahsih iwa:n toi:xna:mik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Se: sah mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>Komo ya..., komo yetok de okichpil yowi *siete, siete bolitas**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>wa:n komo yetok de siwa:pil yowi *cuatro bolitas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>Wa:n ke:mah seko sah yowi mahyá: mopa:palakachowa ihkó:n kwaltsi:n, kwaltsi:n mosentilia wa:n mochi:wa sayoh se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Eske *porque** tikokoxkeh ya ika siwa:pil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>Neh nikitani itech *televisión**. Ke:meh te:chwi:katinemih *cursos**, a:mo ekinika a:man name:chilwihtok, *tantos**ninemik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>A:mo ekinika a:man nik..., niknemilia i:n. Nehwa n'nemilihtok, kanah,nikitstinemi itech *televisión**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>*Porque** okichpil *siete gotas** kwi:ka, *siete bolitas** wa:n siwa:pil kwi:ka *cuatro**. Mm, ihko:ni yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>Aha, tein a:mo wel ke:mah nokokoxka:ta:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Yehwa sah tsope:likxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>Tsope:likxiwtsi:n wa:n n' pisi:lnek. Pero a:mo ika *refino** pisi:lnek, sayoh mah tamolo:nti:l wa:n mah tai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts423">
                <ANNOTATION_VALUE>Wa:n yehwa ya ne:n tsope:li:kxiwtsi:n, mah kimolo:nti se: *bola** wa:n mah tai</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>wa:n ika o:me *hoja** yehwa tsapotsitsi:n, o:me *hoja**, a:mo miak, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Ka:n, ka:n teh *kipasa:ros**, ka:n teh *kipasa:ros** n' pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Ke:mah, ka:n teh *kipasa:ro:s** ok, kwali nemis n' a ipilitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>Iwki we:ias wa:n *hasta cuando** yeh Dios kihto:s ke nemis, ihwa:k *kitoca:ro:ti:w**. Mm, ihko:ni yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>O:me taman sah yo:ni, e:yi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>A: pos *cuando** nemiti a *porque** mochi:wa se: *bolita** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>Mochi:wa se: *bolita** itech *ipancita** wa:n nika:n taka:wi a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>taka:wi a nika:n, entó:s kihtowa ne:n koyo:meh tikchi:wilia n' *icontacto**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>Teh no: kipiake tikchi:wati *icontacto**, ¿ke:yeh yo:n *contacto**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>Para teh timomakas *cuenta, si n' 'caso** ke, *si n' acaso** kalihtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>entó:s para tiki:xti:s pero kipia ke mah etok i:n, para tiki:xti:s de n' ikalihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>Pero komo tiehkokwa:n sayoh i:n, nio:nó: xkalanki:sa, mm, toni yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>Tikchi:wilia *icontacto** pero komo sayoh i:ni, tikalan..., a:mo xki:xti ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>Pero komo tiah ok ka..., kalihtik, kipia n' *icontacto** i:n *tanto**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>*a ver** ka:ni tikwi:katiwetsi. *Dos horas** kiihyowi:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>*Dos horas** kihyowi:ti *porque** tikchi:wilia n' *icontacto**, mm, ihkó:ni yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>Wa:n ke:mah, *o** komo kalihtik, *igual**, tikchi:wilia *icontacto** pero komo kipia ne:n, ¿ke:ní:w kiliah ne:n?, *apenas** i:n ke:meskia ohtokatok ni..., nip..., ni..., n' *icabecita** nika:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>entó:s kwi..., kwi..., *bueno** kichia ok para tikwa:lkwis Cuetzalan. Pero komo a:mo, a:mo xiki:xti ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>*porque a veces** ma:ski t'matis ton *tanto**, to:n *tanto** yahtok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>pero *cuando** kis..., yeh kihto:s ke temo:ti *porque** temo:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>A:mo wel tikmahpacho:ti, tikahkotope:wati, *porque** yeh kihtohtok ke temo:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Ke:mah. Yeh kita:lihtok ke nemiti. Ke:mah, *asi que** pa..., *asi que** ne:, tikmachilia ne:n *icabecita** nochi mo..., *mopela:roh** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>*Es porque** tikilpia ya siwa:t nika:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>tikilpia nika:n itahkoya:n para mah a:mo *subi:ro** ok pili, mah a:mo tehko ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>*De una vez** kipia se: *dolor**, momaka *valor** paratani, ampó:n etok pili</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>ika se: *cuatro veces** ampó:n etok pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>Niman ehko, tikchipa:wa i:xko, mah a:mo kitolo n' a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>wa:n tiktake:ntia ihkó:n niman i..., n' *icarita**, kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>Wa:n nika:n t'mahpachowa wa:n nika:n t'tsakwilia para ne: mah ehko ya nochi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>wa:n *una vez** de nochi ehko ya, nika:n t'ta:lia ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>wa:n tikilia imomá:n mo..., mah mokaxa:nia, mah taniki:sa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>Wa:n nik..., wa:n *iombliguito, iombliguito, carrerita** t'tamo:tilia ne:n na:wi momahpil</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>nika:n t'tekilihtiwetsi. Tikilpilia, nika:n *ombligo** wa:n nika:n t'tekilia. Ihkwí:n. O:me mahpil moka:was para t'tekili:s ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>Ke:mah, nika:n tikilpia ya, pero i:n, i:n yetok a para itech n' pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>Nika:n t'ta:lilia *pinza, si acaso** kinemilia panki:sa, a:mo pano:s, *porque pinza** kipia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>nika:n tikwi *tijera** wa:n n' 'kwi *pinza**. Ihkó:n neh n'tekiti a:xka:n. [Ke:]mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>Pos yehwa sah pa:panki:stok, ompa pa:panki:stok, panki:sa sepa pili, sepa temowa, sepa panki:sa, sepa temowa, ompa sayoh kitahyowi:ltihtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>¿Ke:yeh? Porque imomá:n a:mo no: kimaka *valor** mah, mah pano. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>A:mo, a:mo ke:man. Nimitsilihtok ke neh a:mo ke:man ne: yo:n, a:mo ke:man *ne:chpasa:rohtok** oso nante:kakilihkahnamehwa:n ne: tani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>Mikis pili *porque** sayoh *porque** kinekis. Mah i:pa we:i a, mah a:mo noma:ko ok, mah a:mo Dios ne:chma:petsko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>Ya:lwa seki ki:skeh *escueleritos** ne: Tonalix tein ompa nikimpehpanato.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>*Contemporáneos** e:yi, *contemporáneos** ki:skeh ya:lwa. Mm, ki:skeh *pre-escolar**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>Ne: Wicho wa:n ne:n Reina ipili wa:n se:, se: ne:n Calio ipili,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>no: ki:sak ya:lwa *pre-escolar**. E:yi:n, nikinitato, nikimawiso:to ke:ní:w mihto:tiah, ma:wiltiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts545">
                <ANNOTATION_VALUE>yehwa yo:n neh nikwelitaskia mah nochi iwki, mah a:mo akah *kim..., mah a:mo akah kima:lchi:wa se: kone:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>*porque** neh nimika:ka:wal, ka:n *ne:chkwida:roh** no:má:n, no:pá:n, pos no:pá:n o: no..., *o** se: *nocarnalito** tsi:tsikwi:ni ke nimikiti, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts548" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>Nose:lti, nose:lti ihkó:n ke:meh nose:lti n'te:moh nopili, nose:lti nikpia nopili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts551">
                <ANNOTATION_VALUE>A:mo akah ke:man akah *ne:chkwida:roh, hasta** a:xka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts552" TIME_SLOT_REF2="ts553">
                <ANNOTATION_VALUE>Wa:n nikimpia nopi:piltsi:tsi:n, mikik se: *porque** pos, tak i:pa no: Dios kita:lih ke ne:chka:wte:wati, pero *más** a:mo teh miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts555">
                <ANNOTATION_VALUE>A:mo teh mikik de pilkone:t. Mm, nante:chtahtaniah i:n to..., totalna:miki:lis tein *antes, porque** i:n *antes**, i:n a:mo tein yankwik, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts556" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>I:n ne:n, ke:meh name:chilwihtok ekintsi:n neh nitekititok, pos i:n de neli yankwik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts558" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>*Porque** ekintsi:n ne: wehka:w x'te:mo:ka:n *machetehsol** ne: kaltech, ka:n aktok, kitekitih n' pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>"'Wa:lkwi se: olo:t, *órale**. ¡'Panchichino:ka:n! *Órale**, t'tekitih n' pili." A:xka:n ke:mah a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>*Al contrario** tikpias ne:n *paciente** ahko. Ke:mah, a:mo t'pias ta:lpan, ne: ta:lixko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>Ah, ika olo:t kintekiah, kintekiah, neh o:me nopili kimpehpenkeh ika olo:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>wa:n *machete, a ver** ka:ni ne:wí:n i:xaktok, ma:ski *oxidado, aunque sea**, mah kipia toni kipias pero *eso si** ke nika:n t'tekitih n' pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>Wa:n a:mo kikwiah teisá:, *hilo** kimamalitsa wa:n *órale**, kilpiah n' pili. Ampó:n wi:tsa ya n' *machete**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts576" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>Nika:n kita:liah olo:t, nika:n kitekih ya, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>Eh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>Pos yehwa yo:n, a:mo n'mati ke:yeh yo:n iwki kichi:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts586" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>Pos a de kwe, mah..., mahyá: nikihto pos kikowtetechkawiah ya nika:n ya ne:n pili ixi:k. Kitekih ya nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>Nika:n etok a n' olo:t pero pos nika:n kitekih ya pili ixi:k, pero ilpitoka ika n' *hilo**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>*Hilo, nada que ombligo** ke:meh a:xka:n tiktekiti:ltiah *ombligo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>Ehe, nika:n nikpia *ombligos** wa:n nikpia *ombligos** nikpia, mm. Soh mah kihto a:kon, a..., ka:ni nemiti pili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>Mm, kima..., *gobierno**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts612">
                <ANNOTATION_VALUE>*Gobierno** ima:ko wi:tsa, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Aha. Ah, we:noh, we:noh, neli mopata *tiempo**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Pos ih..., ne:, *este**, Mar..., Maria Ocotlán Fermín Cabrera, niwi:tsa de Xaltipan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Limontakxitan, [o]mpa niwa:le:wa. Nikpia *sesenta y siete años**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>*niculpliro:ti** veinticinco de diciembre, n'te:ma:kti:tide *nosesentisiete**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts635">
                <ANNOTATION_VALUE>*Igual** tasohka:matik no: ke ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
