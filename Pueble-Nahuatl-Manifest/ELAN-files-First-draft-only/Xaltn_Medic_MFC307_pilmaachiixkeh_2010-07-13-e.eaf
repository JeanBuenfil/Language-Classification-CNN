    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="CommentType" PARTICIPANT="Comments" TIER_ID="Comments">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>{Aquí Amelia utiliza 'kineki' como 'está a punto de' como 'quiere llover' y no como 'desea' (abortar).}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>{Aquí hubiera dicho simplemente 'nikte:kakilia:ni'.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>{Aquí probablemente quiso decir 'nikmatik a' con el sentido de 'ya entendí (lo que me querías decir)}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>{Aquí cabe el singular, 'miki'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>{Es decir, tener un bebé.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>{Hubiera dicho aquí 'titai:s'.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>{Aquí parece que hispanizó la palabra náhuat 'siwa:pah'.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>{Esto es, hay tres partes del cuerpo que se  encargan de concebir, desarrollar y parir el niño.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>{Se hace un solo, en referencia aparente a la espermatozoide y el óvulo}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>{Tantos en referencia a los viajes de capacitación}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>{Aparentemente hace falta 'a:mo' o antes o después de 'Nehwa', mejor antes.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>{Esto es, se va dejando un espacio en la matriz al bajarse el feto al aproximarse el parto}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>{Aquí hablando de haber llegado a un punto de dilación que imposibilita la ida al hospital}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>{Esto es, ya se está asomando}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>{Ya amarraste a la mujer con una faja para que ya no subiera el bebé hacia la matriz}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>{También hubiera sido correcto decir nankite:kalihkah} {Aquí 'ne: tani' (allí abajo) refiere a Xaltipan de donde es María Ocotlan y que queda hacia las tierras bajas de donde se está haciendo la entrevista, en Cuetzalan}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>{Esto es, en la cama.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>{Por equivocación dice 'ixpitok'.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>{Literalmente 'hoy ocupamos el 'ombligo' aparentemente en referencia a una herramienta de los médicos que utilizan para cortar el ombligo del recién nacido.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>{De broma María Ocotlan dice que trae la herramienta llamada 'ombligo' y a ver quien quiere tener un niño, dónde va a nacer el niño.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>{El uso de te:ma:ktia para significar 'cumplir' una cantidad de años, es idiosincrática de María Ocotlán.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
