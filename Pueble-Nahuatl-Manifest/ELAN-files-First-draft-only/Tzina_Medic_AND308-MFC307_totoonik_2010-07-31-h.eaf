        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Niktai:ltia para mah ki:sa n' iihtik ne:n itoto:nka.</ANNOTATION_VALUE>
