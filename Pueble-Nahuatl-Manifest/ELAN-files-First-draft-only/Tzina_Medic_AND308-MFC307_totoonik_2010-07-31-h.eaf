        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>We:noh, ompa yo:n ne: popo:ka se: itsontekon.</ANNOTATION_VALUE>
