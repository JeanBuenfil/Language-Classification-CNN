        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Mah ki:sa yo:n itoto:nka, komo ki..., kika:wa ya yo:n nochi ke:meh yetok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Entó:s nejó:n pos nikihtowa ke pahti a, kwali a, mm. Wa:n ne ... Sese:ya ya nochi, kika:wa ya wa:n ne:n limo:ntsi:n pos ... Ke:mah. Se:wi a *parejo**, se:wi a, ki:sa n' i..., nochi ki:sa toto:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
