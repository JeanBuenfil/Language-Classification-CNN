        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Entó:s ihko:ni *cuando** totsontekon ne:, *cuando** te:chtelkokowa totsontekon, e:s..., popo..., mahyá: popo:ka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
