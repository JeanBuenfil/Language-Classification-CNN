                <ANNOTATION_VALUE>A: no: iwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1217" TIME_SLOT_REF1="ts2045" TIME_SLOT_REF2="ts2047">
                <ANNOTATION_VALUE>Kikwi tsahtsilis a, ke:meskia yo:n mohka:kwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1219" TIME_SLOT_REF1="ts2049" TIME_SLOT_REF2="ts2052">
                <ANNOTATION_VALUE>Yo:n mohka:kwi wa:n *hasta** wiwiyoka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1223" TIME_SLOT_REF1="ts2059" TIME_SLOT_REF2="ts2062">
                <ANNOTATION_VALUE>A:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1228" TIME_SLOT_REF1="ts2071" TIME_SLOT_REF2="ts2073">
                <ANNOTATION_VALUE>[Ni]ka:n chikotik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1230" TIME_SLOT_REF1="ts2075" TIME_SLOT_REF2="ts2078">
                <ANNOTATION_VALUE>Se: we:i wa:n se: tsikitsi:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1233" TIME_SLOT_REF1="ts2083" TIME_SLOT_REF2="ts2087">
                <ANNOTATION_VALUE>Mm, ke:mah, *casi** chikotia ite:noh, nika:n ite:nxi:paltsi:n, nika:n nasikayowi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1235" TIME_SLOT_REF1="ts2089" TIME_SLOT_REF2="ts2093">
                <ANNOTATION_VALUE>Pos yo:n neh nikita pané: ki..., yo:n kita:liah yo:n xo:met wa:n awakaiswat wa:n seki ehekapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1237" TIME_SLOT_REF1="ts2095" TIME_SLOT_REF2="ts2098">
                <ANNOTATION_VALUE>Pero de nika:n i:n kikwitiowih nika:n *hasta** nika:n inkwitapan nika:n tai:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1239" TIME_SLOT_REF1="ts2100" TIME_SLOT_REF2="ts2102">
                <ANNOTATION_VALUE>Tai:ka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1241" TIME_SLOT_REF1="ts2104" TIME_SLOT_REF2="ts2107">
                <ANNOTATION_VALUE>Wa:n no:, no: seki no:..., nochi, nochi kin..., kinxakwalowah no: pero primero nika:n tai:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1243" TIME_SLOT_REF1="ts2109" TIME_SLOT_REF2="ts2112">
                <ANNOTATION_VALUE>Wa:n pos yehwa yo:n kihtowah kina:miki yo:n de n' xo:xal, *porque** yo:n xo:xal yo:n, yo:n *hasta** se: pitsotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1245" TIME_SLOT_REF1="ts2114" TIME_SLOT_REF2="ts2116">
                <ANNOTATION_VALUE>*Hasta** pits..., se: piotsi:n, niman kihtowah "ye:kkwaltsi:n mopitsotsi:n".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1247" TIME_SLOT_REF1="ts2118" TIME_SLOT_REF2="ts2120">
                <ANNOTATION_VALUE>*Después** a:mo takwa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1249" TIME_SLOT_REF1="ts2122" TIME_SLOT_REF2="ts2125">
                <ANNOTATION_VALUE>A:mo takwa ok.</ANNOTATION_VALUE>
