        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Pero sin que** a:mo ne:, se: *hasta sin que, sin que** kwaltia ya se: itsontekon, a:mo, mah a:mo popo:ka ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>entó:s yeh tikaha:wia, tepitsitsi:n, tepitsitsi:n wa:n i:pa tikepa n' a:tsi:n ikwechkochi:ka:mpa, ahketstikopa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Iahketstikopa wa:n ... Ehe, ke:mah, ihkó:n nikaha:wihtiw, tehtepitsitsi:n, tehte..., tehtepitsitsi:n. A:mo ta: nika:n sah nik..., itsontekon sah, itsontekon sah.</ANNOTATION_VALUE>
