                <ANNOTATION_VALUE>Aha.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1261" TIME_SLOT_REF1="ts2152" TIME_SLOT_REF2="ts2155">
                <ANNOTATION_VALUE>A:, ke:meskia yo:n moto:chketsa ya, a:mo kineki takwa:s ok.</ANNOTATION_VALUE>
