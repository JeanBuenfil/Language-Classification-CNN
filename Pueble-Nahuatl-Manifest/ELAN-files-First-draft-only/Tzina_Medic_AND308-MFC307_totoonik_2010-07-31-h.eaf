        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>Se:, tsiktsi:n n'xelowa ke:meh se: ta:sah.</ANNOTATION_VALUE>
