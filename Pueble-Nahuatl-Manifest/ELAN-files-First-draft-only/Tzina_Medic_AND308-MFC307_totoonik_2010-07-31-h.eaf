        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1282" TIME_SLOT_REF1="ts2200" TIME_SLOT_REF2="ts2203">
                <ANNOTATION_VALUE>Yeh, yeh a:mo, *hasta** se: pitsotsi:n ihkó:n, se: pitsotsi:n komo kwelitakeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1284" TIME_SLOT_REF1="ts2205" TIME_SLOT_REF2="ts2208">
                <ANNOTATION_VALUE>Niman kihtowah "ye:kkwaltsi:n ne: mopitsotsi:n, ye:kkwaltsi:n takwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1286" TIME_SLOT_REF1="ts2210" TIME_SLOT_REF2="ts2213">
                <ANNOTATION_VALUE>kwaltsi:n, mm. Ka:nachi mits..., ka:nachi ... Ke:mah. Entó:s no: nikwiti:w i:n pitsotsi:n ye:kkwa:kwaltsi:n ta: pochiktsi:n oso i:n to:tomaktsi:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1288" TIME_SLOT_REF1="ts2215" TIME_SLOT_REF2="ts2218">
                <ANNOTATION_VALUE>*Después** pe:wa a:mo kineki takwa:s ok, pe:wa kima:xe:lowa ya tao:ltsi:n, kimakah taxkaltsi:n a:mo kineki kikwa:s ta: tsahtsi a, tsahtsi a, mo..., nejó:n a:hkote:te:nketsa ya, a:mo kineki takwa:s ok, niman kihtowah ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1290" TIME_SLOT_REF1="ts2220" TIME_SLOT_REF2="ts2223">
                <ANNOTATION_VALUE>"A: pos yo:n na:nahtsi:n wa:lahka wa:n yehwa kixo:xak".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1292" TIME_SLOT_REF1="ts2225" TIME_SLOT_REF2="ts2228">
                <ANNOTATION_VALUE>"Ne: pero ke:ní:w tik..., ke:ní:w tikmatik kixo:xak", ke:mah pos ta: kipias iko..., ikechkochi:ka:n ichokoy.</ANNOTATION_VALUE>
