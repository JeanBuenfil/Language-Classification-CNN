                <ANNOTATION_VALUE>Wa:n komohkó:n ne: ata tikihtowah motanawia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Motanawia, komo motanawih wa:n sepa t'chi:wilia de, de yehwa yo:n a:t wa:n a:mo kina:miki ok, entó:s a:mo ok yehwa tikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>A:mo tikwi yehwa ok, a:mo, tikwi, tikwi a ne:n, tikwi a ne:n tomatsi:n.</ANNOTATION_VALUE>
