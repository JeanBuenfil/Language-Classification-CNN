        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>Pos ta: niahka nikilia iwa:n, iwa:n *doctor**. ¿Wa:n *doctor** toni mitsilih? *Doctor** ne:chilih, ne:chkoto:nili:ti noma:y, nikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Wa:n neh nikilwih, *que** ne:chkoto:nili:skeh noma:y, nikilia, *mejor** mah nimiki, nikilia, wa:n a:mo ne..., wa:n a:mo, a:mo ne:chkoto:nili:skeh se: *parte de** nonemi:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts397">
