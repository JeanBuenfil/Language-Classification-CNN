        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>Entó:s kihtowa, ton tik..., ton tikneki, ton t'nemilia, *mejor** timikis *o mejor** mitstekili:ka:n moma:y. Nikilia, a:mo, *mejor** mah nimiki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts401">
                <ANNOTATION_VALUE>A:mo teh..., a:mo teh nikwaltiati ok, nikilia. *De una vez que** ne:chkoto:nili:s se: noma:y, nikilwia, ne:chki:xtili:skeh tahko de nonemi:lis a, nikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>*mejor** mah nimiki a, nikilia, neh nikilia, a:mo pahtis. *Bueno**. Pero a:mo yo:ni,</ANNOTATION_VALUE>
