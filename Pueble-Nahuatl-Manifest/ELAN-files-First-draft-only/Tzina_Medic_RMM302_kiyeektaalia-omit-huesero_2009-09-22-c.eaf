        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>Ihkó:n pe:wak nitekiti, ompa niahsik pe:wak ntekiti, ntekiti,</ANNOTATION_VALUE>
