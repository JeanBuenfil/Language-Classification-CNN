        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>kwa:tamattoya, *porque** ke:yeh. *Este**, a:mo, a:mo katka koyo:tapahtihkeh, sanoke se: ma:se:waltapahtihkeh pero kipiaya miak talna:miki:lis de miak taman pahti.</ANNOTATION_VALUE>
