            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts427">
                <ANNOTATION_VALUE>Tapahtia, kihtowa, de nochi kihtowa. Wa:n pe..., pahtis kihtowa, mitspahti:s kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Nikilia, pos... ¿Tikpia n' tomi:n? Nikilia, n'pia tepitsi:n, nikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Pos ne: ka:mpa niahka nimota:nili:to tepitsi:n *centavitos**, nejó:n *tiempo** katka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>katka pos *ochocientó:s pesos**, a:xka:n tehwa:n tikihtowah *ocho mil pesos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>Miak tomi:n katka, n'piaya *ocho mil pesos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>Pos neh niki:ste:w, niah. Ento..., mo:s..., mo:sta kwalka:n nimitsno:tstiki:sa kihtowa, *las cinco de la mañana** xieto *listo**, kihtowa, wa:n tia:tih. Nikilwia, *pues, órale**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>*Pobre** n..., *nofamilia**, ta: *notío**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts441">
