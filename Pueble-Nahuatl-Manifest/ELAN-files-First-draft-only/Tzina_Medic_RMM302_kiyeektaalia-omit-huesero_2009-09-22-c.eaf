        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>yo:n kokolis ihkó:n nikwi:katinemik, wa:lkohkoyo:n nochi noma:y wa:n yo:n n'me..., nimikiti a, a:mo..., n'machilia a:mo kanah ika.</ANNOTATION_VALUE>
