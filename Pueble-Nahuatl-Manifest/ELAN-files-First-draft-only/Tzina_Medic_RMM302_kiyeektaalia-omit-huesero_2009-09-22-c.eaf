        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>Entó:s yo:n ke:meh tahko xiwit pe:wak, pe:wak pach..., pachiwi a ne:n ka:mpa n' titi:kak.</ANNOTATION_VALUE>
