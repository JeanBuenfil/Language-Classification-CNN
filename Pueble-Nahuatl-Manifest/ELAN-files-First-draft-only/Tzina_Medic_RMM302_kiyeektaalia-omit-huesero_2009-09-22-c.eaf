                <ANNOTATION_VALUE>ne:chpahti, nikilia, wa:n nimitsmakas ka:nachi teh tikihto:s nikilwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>Neh niki..., n'neki n' pahtis nikilwia.</ANNOTATION_VALUE>
