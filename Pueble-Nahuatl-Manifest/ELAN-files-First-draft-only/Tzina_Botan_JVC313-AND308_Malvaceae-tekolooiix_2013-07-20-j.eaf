        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Ke:mah, pero niki:xmattok yehwa yo:n tekolo:i:x kiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>n'mattok tikehke:wayah tehwa:n, ne:chilia:ya no..., nowe:ita:tah, nowe:ita:tah katka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>wa:n te:chne:xtilia:ya yo:n tekolo:i:x, tein yo:n itsmol, tsikitsitsi:n, sehselik ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>kwali se: kehke:wa wa:n se kiyehyema:nia komo se: kineki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>Nehjó:n se: kite:nteki wa:n se: kechteki *desde** ka:mpa ta:ntok ima:xiwyo, ka:mpa tantok ima:xiwyo ya, ompa se: kiteki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Ompa kihto:sneki chika:wak a yo:n kine:xtia, ka:mpa tamik a yo:n ima:xiwo, a:mo tei ok, chika:wak, kwali se: kehke:wa xo:no:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>Wa:n se: ki:tskia *fuerte** itech kowit ihkó:n se: kitila:ntiw, *fuerte, fuerte** kow..., kowke:span se: kitila:ntiw n' e:wat, ke:mah wa:n *hasta** pampihpixki ata n' e:wat ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>Pampihpixki wa:n ke:mah ata *hasta** xi:ntiw, se: kitemo:ltia, nochi *parejo** se: kiyewalohtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Se: kiyewalohtiw *parejo** ihkó:n, no: se: kwi:ka se:, se: *tiempo** sah kisentemo:ltia, se: kimalakachohtiw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>paar kwali ehke:wi pero komo tiki..., tika:wte:wa oksé: tein *último** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Tein *último** ya, a:mo ki:sa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>Yo:n nehjó:n mo..., nika:n ehke:wtiwetsi wa:n a:mo wel se: kiema:nikehke:wa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Wa:n yo:n se: kitaneki:xtia wa:n ke:mah *hasta** tani ki:sa wa:n ke:mah yema:nikehke:w wa:n tatsi:ntan tik..., sehse:, ke:meh se: *geme** para se: kiteki a para se:, komo kwali tiki:xtiliah xo:no:t, tikwi sah, t'tamo:tah n' e:wat tein wehweliwi wa:n tikwih xo:no:t kwaltsi:n, yehwa yo:n kwaltia ika se: talpia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>Yo:n kwaltsi:n *o** tikwis no: para ika titama:mas, no: kwaltia, komo t'neki titama:ma:s iwki sah kakaltik, tiktila:nilia *ipunta** wa:n tiktila:na ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Wa:n tikwi para mokwa:i komo tik..., ika tikma:masneki kowtsi:n, a:mo teh momekapal, yo:n kwali se:, kwaltia. Yo:n kakaltik se: ki:xtia. Ke:mah, se: *cacho** para kwa:it a mahyá:. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Ke:mah wa:n tikwi:ka ya kowtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Wa:n yehwa sah yo:n n'neki nimitstahtani:s wa:n ne:chilwi mo..., moto:ka:i wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>pos yehwa sah yo:n n'nekia nikmatis wa:n soh a..., a:xka:n xine:chilwi moto:ka:i wa:n de ka:ni ti..., tiwa:le:wak.</ANNOTATION_VALUE>
