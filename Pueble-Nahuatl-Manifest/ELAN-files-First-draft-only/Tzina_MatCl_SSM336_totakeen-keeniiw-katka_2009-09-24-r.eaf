        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>Tehwa:n *tocostumbre** no: se:meh, a:ksá: te:chkalpanowa *importa** tikwa:ntih se: kahfe:ntsi:n, telimportah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
