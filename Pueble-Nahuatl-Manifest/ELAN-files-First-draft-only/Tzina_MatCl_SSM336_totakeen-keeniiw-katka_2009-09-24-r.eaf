        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>A:mo weli, a:mo tiahsi..., a:mo tiahsiskeh ke:meh koyo:t *icostumbre**, a:mo weli,</ANNOTATION_VALUE>
