                <ANNOTATION_VALUE>telsenka ya mochi:waya pero ekintsi:n mahyá: poliwtiw a mahyá:, ihkatok ne:n ixiwyotsi:n pero ta:ki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts75">
