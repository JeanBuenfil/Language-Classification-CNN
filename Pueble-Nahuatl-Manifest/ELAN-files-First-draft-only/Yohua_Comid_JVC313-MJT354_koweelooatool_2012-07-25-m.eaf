            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Pos ne: yo:n no: niki:xmattok ta:to, ne: *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>motehko:ltia itech se: kowit we:i *o** teihsá: yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>i:pa motehkoltia itech yo:n nejó:n te..., ne:n ke:ní:w mono:tsa yo:n kowtsí:n, yo:n tikiliah tehwa:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>yo:n ika ttaxo:taltiah okokowit, no: mochi:wa n' itech.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>wa:n itech yehwa ya n' tsontsapokowit no: mochi:wa, no: kwaltsi:n motehkoltia wa:n ompa ka:mpa imaxala:n ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>ompa ya mota:ki:ltia, iwki pa:nki:sa ya, n' kwaltsi:n mota:ki:ltia n' ka:mpa no: kwelita ne:n ta:kilowas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Wa:n *este** ne: we:lik semi n' a:to:ltsí:n se: kichihchi:wa, sayoh mah se: kiwitoma ika *este** olo:tsí:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>mah se: kimomolotsa kwaltsi:n mah molo:ni wa:n ompa ke:mah ne: xiktsetselo:s a no: moato:ltsi:n, komo se: kichi:wa ato:ltsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>wa:n mah seko ya moye..., molo:ni wa:n seko ya t'molo:ntihtok wa:n ne:, ke:mah tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>tikwia ne: no..., n' se: kimana, kwaltsi:n mah se: kimolo:ni, mah momoloka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>kwaltsi:n se: kii:ixkwi, 'ki:xtilia nochi n' ii:xpacho, ke:meh ne:n iwitso.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>wa:n ke:mah xki:..., xiki..., kwaltsi:n mo:molo:ni, oksi a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>no: kwaltsi:n molo:ni a ke:meh i:pa yo:n ti:ltiketsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>wa:n ke:mah mah se: kitsope:li a kwaltsi:n ato:ltsí:n ika pane:lah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>wa:n ke:mah mah se: kipante:mili a ne:n, ne:n ieyotsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>yehwa ya sah ne:, *mo que** ka:n ok witsoh, ta: kwaltsi:n chipa:wak a se: ki:xma:ma:patska.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Wa:n ke:mah nokta ya we:lik n' ato:l ki:sa, mahyá: tikmatis teh ti:ltika:emo:l n' tikpante:milih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Ke:mah, kwaltsi:n wa:n neli ta:ki itech ne:n kowmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Mohkó:n *pues** [mo]kowte:tehkoltia wa:n ompa ya n' ta:kiti kwaltsi:n, ke:man no: tawelita ne: miak, ne: wehka:w neh nikita pe:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
