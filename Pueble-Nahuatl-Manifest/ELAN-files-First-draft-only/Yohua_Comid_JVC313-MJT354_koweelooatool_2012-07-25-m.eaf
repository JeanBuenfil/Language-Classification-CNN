        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Ke:mah, namehwa:n nika:wí:n namehwa:n nochi kowyoh ok pos ne: moonkaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Onkak. Ke:mah, motekili:ti sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Kanah neli, ta: ne: mochi:wa sah kihto:snekih, mochi:wa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>Ke:mah, ta: nochi yeh..., nochi yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Nochi yehwa. Pos iwki n' kwaltsi:n *porque** ne: we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>We:lik. Ke:mah, ta: ne: kwali a n' tine:chilwih, miak tasohka:matik, n' kowe:lo:tsí:n pos neli no: kina:miki n' ato:ltsí:n, [i]ka no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>se: moyo:ltsope:lia tepitsi:n. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Tein kwe:liliah pos taih kwaltsi:n. Wa:n ki..., tein..., moneki mah kimati n' a:kin kichi:was *porque** seki... E... Ke:mah, seki ne: ki... Ta: yo:n ahwayoh, ah..., ahwayoh, n' seki kichi:wah ne: nikita ne: *novecinos**, kichi:wkeh se: *viaje** ne:n ne: ato:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Ke:mah, ta: ka:n we:lik, ta: kwaltsi:n we:lia pero mah se: kie:kchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Ke:mah, kwaltsi:n mah se: kie:k... Para no: se: momanili:s. Ke:mah, se: momanili:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>Se: mowehwelo:s tehwa:n sah. Ke:mah, yehwa yo:ni ta:to ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>nimitstahtania *porque** nochi tik..., tikwe:liliah wa:n neli ka:n nochi tikye:kmatililiah ke:n timochihchi:wili:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Ka:n se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>*Bueno** ne: tasohka:matik i:n nika:n timona:mikkeh wa:n nika:n timotahtaniyah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>Ke:mah, wa:n neh nimono:tsa niMaría de Jesús Tecuaco wa:n niwi:tse de Yohualichan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>A:, pos neli. A:, tasohka:matik, nika:n timoitah, ne: t..., nipawí:n tiowih ya. Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
