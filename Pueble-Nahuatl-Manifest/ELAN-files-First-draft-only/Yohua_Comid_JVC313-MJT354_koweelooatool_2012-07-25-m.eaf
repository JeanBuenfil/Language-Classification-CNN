            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>*mo que** mahyá: no: mone:nekte:wa ya tak ke:ní:w n' kichi:wa *porque** a:mo no: ta:ki ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>Semi wehka ya sah n' ta:ki, a:mo, a:mo no: y..., a:mo no: se: kichi:wa n' ato:ltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
