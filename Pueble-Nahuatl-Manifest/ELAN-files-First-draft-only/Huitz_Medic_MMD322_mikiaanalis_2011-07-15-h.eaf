            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Wa:n i:n *mango** tikwi, ¿kati:yeh eski?</ANNOTATION_VALUE>
