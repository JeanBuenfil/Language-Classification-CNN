        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>Yo:n ne:n, pos yehwa yo:n kita:liliah emo:ltsi:n wa:n i:ksá: ne:n xilimeh no: kita:liliah wa:n ne:n yo:n okseki para ne:n tapalo:l de yo:n *pe..., pescado** no:, no: kita:liliah.</ANNOTATION_VALUE>
