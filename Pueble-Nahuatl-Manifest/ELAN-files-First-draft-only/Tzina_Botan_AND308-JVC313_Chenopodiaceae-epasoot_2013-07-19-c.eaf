        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Yo:n komaltamal yo:n ... Pos ke:meh ekintsi:n ne:n a:mo tei ok tein tato:k, ne:n nanakatsi:n de n' xi:lo:t, elo:tsi:n kipia no:, no: mochi:wa wa:n yehwa yo:n ne:si kiliah koma:ltamal.</ANNOTATION_VALUE>
