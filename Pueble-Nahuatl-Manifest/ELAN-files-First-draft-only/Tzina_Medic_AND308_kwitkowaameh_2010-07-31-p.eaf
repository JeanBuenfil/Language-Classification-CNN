        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>yehwa:n ya ke:meskia ne: kikwahtokeh ne:n okwiltsitsi:n ne:n itakwal ya ne:n kone:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>*por eso** yo:n tikiliah kwitkowa:tih *porque** a:mo wel moskaltia, mm.</ANNOTATION_VALUE>
