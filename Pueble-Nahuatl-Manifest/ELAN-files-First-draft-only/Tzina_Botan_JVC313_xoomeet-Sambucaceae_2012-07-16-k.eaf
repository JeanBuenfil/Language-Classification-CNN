        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Wa:n *igual** no: ne:, yo:n xo:me:t de miak taman kichi:wa, semi pahti nochi,</ANNOTATION_VALUE>
