        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>Nochi ki..., tein eski tapial kixo:xa oso *hasta** pilimeh kinxo:xah, yo:n pilimeh ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>tein nohne:lmeh ok, komohkó:n kwelitak se: pili n' yo:n a:kin taxo:xa, no: *kijoderowa** m' pili, tsahtsiskwi oso</ANNOTATION_VALUE>
