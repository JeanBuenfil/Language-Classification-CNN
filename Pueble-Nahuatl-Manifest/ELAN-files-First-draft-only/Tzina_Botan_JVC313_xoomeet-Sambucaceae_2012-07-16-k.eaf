        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Pero ne: kita:liliah yehwa i:n xo:me:t neli,</ANNOTATION_VALUE>
