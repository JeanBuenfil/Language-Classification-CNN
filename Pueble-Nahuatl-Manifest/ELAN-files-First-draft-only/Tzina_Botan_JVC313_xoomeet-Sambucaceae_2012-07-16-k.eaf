        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>*o** pio:tsitsi:n nochi kinixo:xa yo:n *porque** i..., nexi:kol kipia n' ikechkochi:ka:n.</ANNOTATION_VALUE>
