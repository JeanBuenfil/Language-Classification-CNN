        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>para a:mo ne:, para kwali oksi *porque** seki neli a:mo oksi ok,</ANNOTATION_VALUE>
