        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>N'mattok neh *[por]que** iwki n' kichi:wa nona:nahtsi:n tanamaka ne:pa,</ANNOTATION_VALUE>
