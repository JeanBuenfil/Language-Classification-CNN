        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>ne:nke:n ma:tami n' tanamak, wa:n yeh nochipa yowi ne: tanamakati, yeh ika n'mattok no: kichi:wah yo:n, tanamak no: kipale:wia.</ANNOTATION_VALUE>
