            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>ke:meh i:n a:ksá: kalpano:ti ne:, taxo:xa, yo:n taxo:xah no: yetok sah n' tein taxo:xa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Kipia n' ikechkochi:ka:n ichokoy yehwa yo:n taxo:xah yo:n tokni:wa:n, a:mo nochi:meh taxo:xah n' tokni:wa:n.</ANNOTATION_VALUE>
