        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>ompa kite:mah ya n' tanamak wa:n ke:mah wi:tsa ya *marchante** takowaki, yo:n ki..., yo:n kitawelia para a:mo ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>para a:mo kinexi:koli:skeh n' itanamak, ne: se: tanamakati *más** wa:n neh kanah.</ANNOTATION_VALUE>
