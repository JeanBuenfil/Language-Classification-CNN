        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>i:xchikotia m' pili, sentapal n' ii:xtololo we:i mochi:wa i:xtapalkopitstia n' ii:xtololo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>¿Ke:yeh? *Porque** kixo:xa ne:n a:kin tokni:w tein yo:n,</ANNOTATION_VALUE>
