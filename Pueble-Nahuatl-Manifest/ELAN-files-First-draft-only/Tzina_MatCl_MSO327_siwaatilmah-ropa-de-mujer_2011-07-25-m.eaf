        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>A:mo, ompa ke:mah no: taman ya n' intilmah.</ANNOTATION_VALUE>
