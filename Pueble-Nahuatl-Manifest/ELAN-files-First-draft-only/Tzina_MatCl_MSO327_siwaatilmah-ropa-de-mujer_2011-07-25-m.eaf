            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>Ke:meh, se: o:men, o:men sah neh nikini:xmattok kihtowah *que** welih ne:n yehwa ke:meh i:n wi:pil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts495" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>Pero neh a:mo ke:man nikinkowilia, neh i:pa nikowa seko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>¿De i:n tilmah, ke:meh i:n niaktok? Kik..., kikwih ok, kikwih ok *siempre**, kikwih ok San Miguel, pero pos nimitsilwihtok *que** a:mo miakeh ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>Ke:mah, pero Ayotzinapan no: kikwih ok, no: kikwih ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>Kikwih ok no:, pero nochi yehwa n' ke:meh i:n, kikwih ya ke:meh i:n nochi xoloche, pero yehwa ya nimitsilia n' kwe:it nochi yehwa yo:n alaxtik tilmah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>Yo:n onkak ata seki *de co:colores** n' tilmah, seki kikwih yo:n mahyá: xoxoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>Ke:mah, wa:n neh ka:nke:man nimakia de yo:n xoxoktik, neh i:pa nikwi nochipa i:n ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts524">
                <ANNOTATION_VALUE>Ke:mah, a:mo, neh a:mo nikwi de yo:n onkak yo:n tilmah seki mahyá: xoxoktik, seki mahyá: yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts525" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>*azulito** yo:n kihtsoma ika yo:n *color de hilo**, a:mo ke:man nikwi neh iwki no..., nokwe:y, neh nikwi nochipa ista:k.</ANNOTATION_VALUE>
