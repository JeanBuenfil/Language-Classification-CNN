        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>A:mo teihsá:.</ANNOTATION_VALUE>
