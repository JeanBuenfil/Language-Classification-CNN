                <ANNOTATION_VALUE>Ke:mah, wi:pil kwali kima:ihtsomaya n' kihtowa. Pero neh ka:n..., neh yehwa yo:n neh a:mo nimone:xtilih, a:mo ke:man niwelik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>a:mo nikchi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>A:mo, yeh nejó:n i:pa pe:wak tikowah, ke:meh i:n ompa ne: kininemi:lti:tih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Se: na:nahtsi:n tiko:kowilia:yah nochipa, nemi nika:n Pinahuistan.</ANNOTATION_VALUE>
