        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>Ompa sepa no: taman ya, ke:mah, ompa sepa no: taman ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>A:, ompa sepa no: taman intilmah, ke:mah, sepa no: taman ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Es que** ta:taman se: itilmah nochi se: makia. Pero neli neh pos neh de i:n nikwi, i:pa yehwa i:ni nikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>¿I:n noko:skaw?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Pos i:n, i:n tiko:wka *antes** ya, i:n a:mo, a:mo n'mati ke:n, i:n tein no:má: ne:chakaka seki wa:n seki tein tehwa:n tiko:wkah pero tonto:nal a n' tiko:wkah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>*Porque** a:man ihkwí:n se: *bolsita** nitahtan i:n *apenas**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts626">
                <ANNOTATION_VALUE>ne:chilwihkeh nejó:n, ka:nachi, ka:nachi ne:chilwihkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>no: o:me *ciento**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>ihkwí:n se: *bolsita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>Ahsi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>ahsi mahtaktio:mo:me *hilo** ahsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>*Porque** i:pa niko:wka yo:n ke:mah, i:pa niko:wka, ihwa:k nikowka pané: katka se: *ciento** ok ika</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>se: *ciento**, ka:n nikelna:miki ka:nachi, se: *ciento** wa:n tahko ok pané: niko:wka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>Ke:mah, pero, pero neh niko:wka para se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts641" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>para se: noto:ka:y nikmakak. Ke:mah, yeh ika n'mattok ke:ní:w. Wa:n i:n a:man sepa nitahtan, nikitak sepa onkak, ne:chilihkeh *que** o:me *ciento** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>Ke:mah, panki:sak a. Neh niko:wka ke:meh e:yi xiwit niko:wka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>A:mo, a:mo, i:n se: kkowa i:pa, i:n a:mo n'mati ka:ni kko:wkah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>Ke:mah. Wa:n i:n seki, pos i:n seki tein yehwa ya nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>kikowak ne: notatahtsi:n pero pos a:mo nikelna:miki ke:ní:w, tonto:nal a no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>¿I:n? I:n i:pa kilwiah *listón**, neh i:pa iwki niki:xmati, pero se: kilwia iko:skama:it[ko:skama:it].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts666">
                <ANNOTATION_VALUE>Ko:skama:it pero pos i:pa se:, se: tahtanis nikneki *listón para** s..., ko:skama:it, ke:mah *porque, más, más** wel kiliah ko:skama:it,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>para ika se: kima:ytia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>A:mo neh i:pa nochipa ke:meh i:ni nikowa para n'ta:lilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>A:mo ke:man nikwi tilmah sah, kwaltia seki kikwih *hilo**, pero neh nikwi nochipa de i:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>A:mo, a:mo i:n no:, i:n no: nikowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>I:n no: nikowa ompa nika:n kwesala:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>Ka:mpa yo:n monamaka teihsá: nochi yo:n para ne: sa..., ompa neh nikowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>*Mercerías** neh nitalia, ke:mah, ompa neh nikowa nopi:pilo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>Ke:mah, no:, no: nejó:n, no: onkak *hasta** no: onkak de se: *ciento** panowa, *ciento veinte** no: onkak, ihko:ni, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>Pati:yoh no:, nochi pati:yoh wa:n tein se:, pos ke:meh se: kinekis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>se: kahsis seki ika</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts701">
                <ANNOTATION_VALUE>ika, yo:n ke:mah nitahtan seki ne:chilihkeh *a** kaxto:l *peso**, seki sempowal *peso**, ke:meh se: kinekis wa:n komo se: kineki tein *más** pos yehwa ya no: tahko *ciento** no:. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
