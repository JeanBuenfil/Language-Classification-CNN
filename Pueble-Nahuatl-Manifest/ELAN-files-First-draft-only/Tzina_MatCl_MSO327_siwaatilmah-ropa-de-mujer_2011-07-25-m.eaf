                <ANNOTATION_VALUE>Pero *que**, pos kininamakah, ke:meh ne:wí:n San Andrés kiniwa:lkwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>Ke:mah, no: kinimachtihkeh ya para pe:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>kichi:wah, kihtowah *que** se: na:nahtsi:n no: k..., no: weli pero no: ki..., no:..., i:n wa:lahka n' kihtowah i:n *apenas** pero no: kimachtihkeh ya, ke:mah, no: welih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
