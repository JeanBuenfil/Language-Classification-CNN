        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>wa:n no:, wa:n kwali, neh nejó:n note:iskaltihka:w katka kwali k..., kwali kihtsomaya, kwali kichihchi:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>Yeh welia nochi, kwali kichihchi:waya, kima:ihtsomaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
