        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Wa:n a:man pos ke:meh i:n kwesala:n onkakeh ya no: ompa ya n' tikowah, a:kin yeski a tikowiliah, a:mo t'matih ka:n kayo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
