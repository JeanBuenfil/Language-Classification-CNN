    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="Eleuterio Gorostiza Salazar">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>We:noh a:man te:chnohno:tsa tepitsi:n de i:n xiwit nika:wí:, *este** komekat mochi:wa nika:wí:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>kiliah a:pahkamoh, te:chili ke:niwki ne:n ixiwyo, ke:niwki ne:n ixi:chio, ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>Ka:ni ne:n mochi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>ke:ní:w ne:n toni, toni ne:n kwali se: kikwi, xa: pahti, xa: *este** pos toni ne:n, *o** xa:, xa: nehje:n kikowah, a:mo se: kimati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>tein teh tikmattos te:chili nochi i:n a:pahkamoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Tikihtowa i:n, we:noh ne: koma:mo nankinamakayah, achto tikihtowa nankichkwayah wa:n ika nan..., nankini:xtayowaltia:yah i:n *este** seki tak a:michimeh, i:n teh tikilia ma:lotsitsi:n. ¿Ke:ní:w se: kichi:wa komo se: kini:xtayowalti:sneki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Wa:n yehwa i:n komekat ¿Ke:niwki ne:n ixo:chio wa:n ita:kka?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Tikihtowa a:mo ke:man tikitak ixo:chio. Ita:kka a:mo no: ke:mah tikitak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Wa:n ne:n yehwa i:n, i:n xiwit tikihtowa, we:noh, a:mo ke:man *este** tikita .... A:mo 'mati ke:yeh ne:n kito:ka:itiah iwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>Tikihtowa ke ne:n ixiwyo iwkitik a seki, seki kamoh tein *este** kwali se: kitsope:lia wa:n se: kikwa. ¿Ke:ní:w mono:tsa yo:n kamoh tein se: kitsope:lia wa:n se: kikwa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>We:noh pos tasohka:matik miak tite:chtapowih i:n a:pahkamoh, te:chili moto:ka:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
