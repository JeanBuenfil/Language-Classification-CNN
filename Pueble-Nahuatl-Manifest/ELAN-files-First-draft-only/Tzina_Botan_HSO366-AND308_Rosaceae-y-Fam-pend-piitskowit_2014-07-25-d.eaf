                <ANNOTATION_VALUE>Wa:n yo:n no: kwaltia ne:n para tama:chihchi:walis no: kichihchi:wa ne:n tokni:wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
