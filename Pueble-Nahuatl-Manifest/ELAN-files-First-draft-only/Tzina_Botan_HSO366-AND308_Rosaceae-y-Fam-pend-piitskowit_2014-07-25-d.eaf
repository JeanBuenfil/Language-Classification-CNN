        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>wa:n ista:k n' ima:xo:chio, mokehketsa n' ik..., ikwa:pan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>wa:n *cuando** yoksi a xi:ni a ne:n tih..., tih..., ti:le:wi a. Ti:le:wi a ne:n, ne:n kapoltsitsi:n ihko:ni, ke:meskia yo:n xa:lkapolin iteyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>wa:n pos yo:n semi kwaltia, onkak ne:kwi:ni, ka:mpa ... Ne:wi:n ka:mpa, ka:mpa semi paniá:n, ma:pahpata:wak wa:n ma:pihpitsa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>Yehwa nejó:n niki:xmatok wa:n n' oksé: n' taman de ka:mpa mochi:wa itsi:ntan tepe:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
