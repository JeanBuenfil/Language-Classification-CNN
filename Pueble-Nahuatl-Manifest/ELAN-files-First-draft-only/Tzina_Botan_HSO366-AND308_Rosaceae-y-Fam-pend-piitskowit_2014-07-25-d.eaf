                <ANNOTATION_VALUE>yo:n ahaktok ihko:ni wa:n komo sepa se: kixihxi:ma nochi, kwaltsi:n chi:chi:le:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Chi:chi:lewi nejó:n kowit wa:n nejó:n kowit no: ki..., no: ki...,</ANNOTATION_VALUE>
