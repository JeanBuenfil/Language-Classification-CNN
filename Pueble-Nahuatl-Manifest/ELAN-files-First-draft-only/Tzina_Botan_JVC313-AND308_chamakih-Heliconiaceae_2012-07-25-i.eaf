        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a931" TIME_SLOT_REF1="ts1405" TIME_SLOT_REF2="ts1408">
                <ANNOTATION_VALUE>Ma:neliwtok, ma:neliwtok n' itapalo wa:n yo:n tikihtowa yo:n tato:kchamakih de achi wehwei,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
