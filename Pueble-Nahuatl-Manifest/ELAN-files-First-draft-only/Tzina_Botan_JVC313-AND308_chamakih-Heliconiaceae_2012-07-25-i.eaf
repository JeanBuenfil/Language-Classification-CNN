        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a970" TIME_SLOT_REF1="ts1502" TIME_SLOT_REF2="ts1505">
                <ANNOTATION_VALUE>Sepa n' tepe:xi:lo:t pos yo:n no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a971" TIME_SLOT_REF1="ts1506" TIME_SLOT_REF2="ts1508">
                <ANNOTATION_VALUE>yo:n no: de miak taman onkak *siempre**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a973" TIME_SLOT_REF1="ts1510" TIME_SLOT_REF2="ts1513">
                <ANNOTATION_VALUE>yo:n no: *más** tikwih, yo:n de n' kwaltsi:n ma:..., ma:pehpetak.</ANNOTATION_VALUE>
