        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723" TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>de xa: tik..., xa: tikmattos ka:nachi taman n' teh xa: kachi tikmatos ne:wí:n, xa: oksé: taman, xa:</ANNOTATION_VALUE>
