        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>para ne:n, ne:n tona:ntsi:n tiktachihchi:wiah, ne:, entó:s ne:n niman se: molia pos tak tiktachihchi:wi:tih ta:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>a:mo para yehwa i:n tokni:w te:ch..., te:chitaki.</ANNOTATION_VALUE>
