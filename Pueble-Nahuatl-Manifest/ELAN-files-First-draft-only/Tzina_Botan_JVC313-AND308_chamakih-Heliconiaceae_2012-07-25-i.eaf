            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a760" TIME_SLOT_REF1="ts988" TIME_SLOT_REF2="ts989">
                <ANNOTATION_VALUE>Niman kihtowa, i:n niman se: kihtowa, ne: i:n a:chá: tikpa:patilih ya, wa:n i:n a:mo, a:mo kikwi ok wa:n</ANNOTATION_VALUE>
