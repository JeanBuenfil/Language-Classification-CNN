        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732" TIME_SLOT_REF1="ts922" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>Wa:n i:n de n' a:..., ma:pisi:ltik no: kwaltsi:n ne:n kina:..., mona:miktiw.</ANNOTATION_VALUE>
