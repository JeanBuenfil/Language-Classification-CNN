            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>a:mo para yehwa ne:n tokni:tsi:n de n' te:ch..., te:chyo:le:wati, ta:,</ANNOTATION_VALUE>
