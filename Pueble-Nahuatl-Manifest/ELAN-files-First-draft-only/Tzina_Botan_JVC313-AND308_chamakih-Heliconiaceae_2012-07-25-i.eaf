        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731" TIME_SLOT_REF1="ts918" TIME_SLOT_REF2="ts921">
                <ANNOTATION_VALUE>Pos nijó:n de n' achi pa:pata:wak yo:n semi mo..., mosowa.</ANNOTATION_VALUE>
