        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a720" TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts894">
                <ANNOTATION_VALUE>meh i:n kowtah tinemih pos nochi se: kitstinemi, ke:meh i:n teh kowtah no: ti...,</ANNOTATION_VALUE>
