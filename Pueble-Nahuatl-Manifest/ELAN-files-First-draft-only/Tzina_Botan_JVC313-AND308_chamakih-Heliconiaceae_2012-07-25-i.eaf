        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a955" TIME_SLOT_REF1="ts1466" TIME_SLOT_REF2="ts1469">
                <ANNOTATION_VALUE>i:n a:ksá: no: mitsilia *o** teh tiknemilia tikwa:lkwi para ne: *mosantoi:xpan**, pos no: tikmattok tikwiti xo:chitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a957" TIME_SLOT_REF1="ts1473" TIME_SLOT_REF2="ts1474">
