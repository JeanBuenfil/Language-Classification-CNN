        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1103" TIME_SLOT_REF1="ts1837" TIME_SLOT_REF2="ts1839">
                <ANNOTATION_VALUE>Nochi ta:taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1105" TIME_SLOT_REF1="ts1843" TIME_SLOT_REF2="ts1844">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1106" TIME_SLOT_REF1="ts1845" TIME_SLOT_REF2="ts1847">
                <ANNOTATION_VALUE>a:mo se: taman sah, ta: nochi ta:taman de n' *cada** ne: kostiktsitsi:n oso ista:k oso chi:chi:ltik, nochi ta:taman i..., n' itapalo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1108" TIME_SLOT_REF1="ts1849" TIME_SLOT_REF2="ts1852">
                <ANNOTATION_VALUE>Ta:tamah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1112" TIME_SLOT_REF1="ts1859" TIME_SLOT_REF2="ts1862">
                <ANNOTATION_VALUE>Tiki:xmattokeh ke:meh i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1114" TIME_SLOT_REF1="ts1864" TIME_SLOT_REF2="ts1867">
                <ANNOTATION_VALUE>kowtah tinemih *o** titekititih *o** a:ksá: te:chyo:le:wa pos tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1116" TIME_SLOT_REF1="ts1869" TIME_SLOT_REF2="ts1872">
                <ANNOTATION_VALUE>tikte:mo:tih wa:n tikahsih. Ehe, se: kahsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1119" TIME_SLOT_REF1="ts1878" TIME_SLOT_REF2="ts1880">
                <ANNOTATION_VALUE>A:, *bueno**. Neh nik..., nmono:tsa ne:n Anastacio Nicolás</ANNOTATION_VALUE>
