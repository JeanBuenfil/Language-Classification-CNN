        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>pos nijó:n, pos ompa ne: tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>te:chmakah ya pos tika:watih, titachihchi:watih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Achto titachihchi:wah ne: tio:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>ompa ke:mah titachihchi:watih ne: kalihtik ya. Kalihtik a ompa no: te:chiliah mah se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>tachihchi:wa wa:n ka:s ika pos te:tayo:koliah, ke:meh nikinilia neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>a:mo para nehwa nijó:n ne:n, para nehwa ne:n na:ne:chmakatih, para ne:n de n' *te:chcuidarohtok**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>Pos kihtowa, xkwi:ka sah, xkwi:ka sah yo:n taselo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>*Porque** yo:n taselo:t, yo:n de n' seki pihpitsa:wak kostik, yo:n semi yo:li:k se: kitapa:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Chi:chikoki:sa wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>pos seki se: kikwa:pohposteki wa:n yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>yo:n de n' kowtah chamakih pos yo:n kachi ne:nke:n se: kitahtapa:na sayoh mah kwa:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>mah, mah kwa:te:neh de n..., de n' ika se: kitapa:nas *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>ke:masá: no: pano:tiki:sa wa:n se: moma:teki wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>pos kintsi:n neh nikitstok ne:n, ne: ke:man ya ihkó:n titachihchi:wah pos no: tikitstinemih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>ki:ní:n, ka:ni, ka:ni ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>onkak n' xo:chitsí:n, ke:masá: tikte:mo:tih ne:wí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>kowtah. *A veces** ke:masá: a:mo no: se: kahsi ok ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>de n' tato:kchamakih, pos se: kahsi ne:wí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>te:kaltsi:ntan pos se: tahtani wa:n te:makah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>Ka:s ika de ka:mpa kinemiliah no: kihto:s, xwi:ka, ta: *ca..., caso para** tehwa, ta: para i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>ten *techcuidarohtok** ne:n tona:ntsi:n ne:n tiktachihchi:wi:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Entó:s to..., tikwi:kah ya, tikwitih ne:n tepe:xi:lo:tsi:n wa:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>titachihchi:wah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>No: ke:mansá: se: mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>moyo:le:wa *de entre mismo** ya tehwa:n, ompa time:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>xola:lpan ne: ka:mpa tietokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>ne: ka:mpa *San Miguelito** tein *te:chcuidarohtok**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>pos no:, no: seki moyo:le:wah. Kihto:s, ¿ka:n tiow? Ompa i:n ntachihchi:wati. Pos nimitspale:wi:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>Se: kitahtapa:na ya ne:n xo:chitsí:n wa:n se: kiwi:ka, se: kiwi:ka ya ne: tio:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>wa:n se: kilpia ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>pos ihkó:n ne: se: mosempale:wia ya. Sepa *cuando**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>kinekis se: tokni:w no:, kihto:s, neh no: ne:chpolowa, ekintsi:n xa: tne:chte:moli:s xo:chitsí:n para ne:n ni..., nita..., n'tachihchi:wati ne: tio:pan wa:n yehwa i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>yeh i:n *compromiso** nitana:nkilihtok pos kintsi:n xa: tine:chpale:wi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>Pos no: tanehnekih ke:meh i:n kinemiliah de se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>semehkia se: momaka *manito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>*Cuando** kinekis se: tokni:w pos no: tikpale:wi:tih ne: kalihtik ke:meh kintsi:n ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>tipano:tokeh nochi ilwitsitsí:n ti..., tiwa:lahtokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>pos kintsi:n *de cada, cada** se: ilwitsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>ilwiti se: tona:ntsi:n pos no: nochi yehyetok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>No: nochi yehyetok ke:meh kintsi:n ne:n, ke:meh i:n mayo tpano:..., tipano:keh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>nijo:n nochi n' xo:chit yehwa de i:n chamakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Tamiti *hasta** i:n nika:n i:n junio, nochi ihkwa:k tamiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>Nochi yetok wa:n ke:mah tipe:watih nepaka ne:n nochi, nochi yehyetok *de cada** nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>pos no: *de cada** ilwitsí:n ilwiti ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>se: tonantsi:n pos nochi, nochi yetok n' xo:chitsí:n katí:n tikwiskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>*Todos Santos**, sepa ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>itech n' ilwit de i:n tiahsitih n' i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>na:mo wehka:wa pos moneki tewi:tso:t. Yehwa yo:n nochi kilwiah yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>yehwa ne:n nochi *cada** n' ilwitsitsí:n ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>tipano:tiuweh nochi yehyetok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>Kowxiwit nochi itech i:n tikiliah *San Ramos, cuando** ilwititi a ne:n *santito** pos yehwa ya nijó:n noch..., nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>*Casi** t..., ekintsi:n de se: *santito** nochi, nochi tikmattiuweh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Katí:n, katí:n xo:chitsí:n, ne:n taselo:t tik..., tikwitih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Niman kihto:s, kintsi:n tikwitih ne: taselo:t *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>ilwititi a i:n tona:ntsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>Pos yehwa de n' *te:chcuidarohtok** nijó:n tikwitih ya i:n xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Niman kihtowa pos no: nimitspale:wi:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>Tikwitih oho:me e:yi wa:n tik..., tikwitih, timo..., ke:meh eskia *timomanowiah**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>Wa:n para nochi ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>nijí:n chamakih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>pos de kwaltsitsi:n no: ne:si de se: kita:lia ihkó:n nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>seki se: kita:lia chi:chi:ltik, ista:ktsi:n se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>kina:miktihtiw ke:meh kina:mikis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>*Porque** yo:n se:..., seki se: kita:lia chi:chikotik pos a:mo *igual** ne:si kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Wa:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>te..., yo:n se: ki..., ahko se:kita:lia chi:chi:ltik wa:n sepa tani ista:k</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>wa:n sepa ni:nipaka se: kita:lia ista:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>kwaltsi:n mokwi. Se: kita ya ne: kwaltsi:n ne:si ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>ihkó:n ne:n *santohi:xpan** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>kwaltsi:n ne:si nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>pero se: kita:lia seki tikta:liah chi:chikotik ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>chi:chi:ltik oso ista:ktsí:n ne:wí:n, a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>seko sah ne: t'ta:liah chi:chi:ltik, pos a:mo, *siempre** a:mo *igual** ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>Wa:n de kwaltsi:n ka:mpa se: kita:lia ne:n chi:chi:ltik oso ista:k oso kostik, kwaltsi:n mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>ihkó:n mo..., mo..., se:..., ke:meh ihkó:n se: kita:lia, pos meh eskia nijó:n *moigualarowa** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>*Moigualarowa** ya, se:, se: taman sah ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>Se: taman sah ki:sa, ke:masá: pos se: kichihchi:wa ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>kalte:noh oso yehwa yo:n tio:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>*o** ne: te:kalihtik pos no:, no: kwelitah n' tokni:wa:n, *después** pos a:mo no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>a:mo no: teka:wah, te:yo:le:wah ihkó:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>meh kintsi:n a:ksá: ki..., hkó:n kiselia se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>tonantsi:n ihkó:n oso ihko:ni,</ANNOTATION_VALUE>
