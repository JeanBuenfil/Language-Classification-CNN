        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735" TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>kwaltsi:n sah. Wa:n no: se: ki..., komo se: kipano:ltih yeh yo:ni,</ANNOTATION_VALUE>
