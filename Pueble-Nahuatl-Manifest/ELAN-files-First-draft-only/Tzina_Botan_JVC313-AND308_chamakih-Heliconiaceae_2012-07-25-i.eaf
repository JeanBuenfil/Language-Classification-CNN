        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a968" TIME_SLOT_REF1="ts1498" TIME_SLOT_REF2="ts1500">
                <ANNOTATION_VALUE>nochi, nochi weli, tiwelih ti..., titachihchi:wah.</ANNOTATION_VALUE>
