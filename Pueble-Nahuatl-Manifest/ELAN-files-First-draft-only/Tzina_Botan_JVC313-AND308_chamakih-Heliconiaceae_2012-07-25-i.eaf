        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>Pos no: ti..., tiuweh ya, ihkó:n ke:meh, *de una vez** ihkó:n ti:xpano:tokeh tik..., tikwitih ne:n xo:chitsí:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>ma:sá: a:mo nochipa tiwelih. Kihto:s se: tokni:w, kihtowa niow kow[tah]. Tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>*por favor** tik..., tikiliah xte:chkwi:li:ti tepe:xi:lo:t, pos no: yahtok ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts524">
                <ANNOTATION_VALUE>ompa *cuando** kineki se: tokni:w pos no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts525" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>no: tikpale:wiah. Kihto:s no: nikwiti a ekintsi:n ta: ne:chpale:wih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>Wa:n sepa ne:n se: kitapa:na a n' xo:chit, sake:ra se: e:yi:n, pos ihsiwka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>Ihsiwka wa:n *cuando** a:mo se: kahsi, *siquie...**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>pos se: ise:lti se: kitapa:na *pero siempre**kachi yo:li:k, kachi yo:li:k wa:n yehwa yo:n kintsi:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>pos *de que** ekintsi:n i:n yowi:pta titachihchi:wkeh, no: kwaltsi:n ne:sik ne: tio:pan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>No: kwaltsi:n ne:sik, nochi tik...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>Yo:n tai:xpan ompa ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Ke:mah, nochi mahma:nel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>Wa:n *igual** ne:, tikehketskeh seki wa:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts568" TIME_SLOT_REF2="ts569">
                <ANNOTATION_VALUE>wa:n seki mos..., nijó:n seki ne: kwi:kakeh para ne: kalte:noh kintsi:n kita:lihkeh wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>pos sepa ne:chyo:le:wkeh i:n seki to:nalmeh mah nikte:mo xo:chitsí:n, pos no: nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>nikitati:w *hasta** ne: a:nalpa, ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>nika:n, ne:paka de n' a:t ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>ne: ka:mpa no..., *noparientes** ompa kipiah xo:chitsí:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>pos xa: no: seki, xa: tikpias ne: Tahchikteko, kwali no: se: ki..., kite:mo:ti:w, xa: tite:chmakas para ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>tona:ntsi:n ne:n, ne:n *te:chcuidarohtok**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>Mokwilani sah ta: pos ne: yehwa ne: kintsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>masá: se: ki..., se: motahtania kachi kwali wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts600">
                <ANNOTATION_VALUE>pos ompa sayoh *que**, pos i:n kowtah chamakih yeh nimitsilia ne: tamiti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Tamiti ta: tate:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a606" TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>A:, moneki mah se: kipa:ka wa:n miak yo:n kipia yo:n okwilimeh, ihkochtsitsí:n yo:n kwihkwitapi:lehkeh, yo:n kwihkwitapi:lehkeh wa:n yehwa yo:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts611" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>Pos no: ne:nemih, komo a:mo se: kipa:ka pos ne: *santohi:xpan** ne:n ne:nemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609" TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>Wa:n kintsi:n moneki nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>de chika:wak ya mah se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts623">
                <ANNOTATION_VALUE>mah se: kipa:ka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a614" TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts631">
                <ANNOTATION_VALUE>Mah se: kipa:ka wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>pos nochi mah se: kiki:xtili yo:n i..., ipachyo n' xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617" TIME_SLOT_REF1="ts636" TIME_SLOT_REF2="ts639">
                <ANNOTATION_VALUE>Yo:n kohkostik n' i..., n' iteyo, kwaltsi:n iwa:n ki:sa ya, seki de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a618" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>de chika:wak pos no: xoko:k ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a621" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>No: xoko:k ya, ne:nke:n ki:sa wa:n de</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>achi selik ok, no: de n' achi selik n' xo:chitsí:n pos no: tahtakwa:wak wa:n no: ihi:sta:k n' i..., n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a625" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>Ihista:k n' iteyo wa:n sepa ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>de chika:waya pos nochi xihxi:i:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a628" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>Wehwetsi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>Wehwetsi a ne:n, tihti:le:wi n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630" TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts671">
                <ANNOTATION_VALUE>Wa:n yo:n iteyo no: kas ika se: kita,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>ne: wetsi pos ompa ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a633" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>Ompa ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634" TIME_SLOT_REF1="ts680" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>Ompa ixwa nijó:n seki, seki kihtowah de yo:n ista:k ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a635" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts683">
                <ANNOTATION_VALUE>kkwi..., kikwitih ne:n chamakih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a636" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>*matita** ihkó:n wa:n kito:kah ne:wí:n, entó:s we:itia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a637" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>*We:imata** mota:lia ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638" TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>wa:n nijó:n yehwa ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a639" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>pos ka:ns ika ne: xa: no: tikitani kowtampa ne:wí:n ye:k miak ixwatok ne:n xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a641" TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts697">
                <ANNOTATION_VALUE>Miak yetok ne:n *matita, pero** a:mo se: kimati kox yehwa ne:n kowtah chamakih, xa: ma:neliwtos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a642" TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>Xa: seki n' tato:kchamakih, ta: seki kihtowah *que**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643" TIME_SLOT_REF1="ts700" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>wehka kwi:kah yo:n chechelo:meh wa:n seki yo:n chiktehmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a645" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts707">
