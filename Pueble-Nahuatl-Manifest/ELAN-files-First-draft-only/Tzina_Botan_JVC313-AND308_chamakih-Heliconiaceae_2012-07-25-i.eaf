        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1121" TIME_SLOT_REF1="ts1882" TIME_SLOT_REF2="ts1885">
                <ANNOTATION_VALUE>Damián, neh niwa:le:w no: de xola:l ne: San Miguel Tzinacapan, ompa no: niwa:le:w. Ke:mah.</ANNOTATION_VALUE>
