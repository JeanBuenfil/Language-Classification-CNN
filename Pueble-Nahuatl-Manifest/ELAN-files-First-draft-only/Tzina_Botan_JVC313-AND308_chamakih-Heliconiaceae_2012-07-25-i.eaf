        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a962" TIME_SLOT_REF1="ts1485" TIME_SLOT_REF2="ts1486">
                <ANNOTATION_VALUE>no: *igual** neh ka:nachi taman nik..., niki:xmati, nochi de nika:n,</ANNOTATION_VALUE>
