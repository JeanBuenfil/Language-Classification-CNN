            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1003" TIME_SLOT_REF1="ts1589" TIME_SLOT_REF2="ts1591">
                <ANNOTATION_VALUE>wa:n ahsi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1005" TIME_SLOT_REF1="ts1595" TIME_SLOT_REF2="ts1596">
                <ANNOTATION_VALUE>Ahsi a, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1006" TIME_SLOT_REF1="ts1597" TIME_SLOT_REF2="ts1598">
                <ANNOTATION_VALUE>Pos neh yehwa sah de nikmattok ne:n i..., nimitstapowih nika:n timonohno:tskeh ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1007" TIME_SLOT_REF1="ts1599" TIME_SLOT_REF2="ts1601">
                <ANNOTATION_VALUE>yehwa sah de nikmatik de i:n chamakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1014" TIME_SLOT_REF1="ts1614" TIME_SLOT_REF2="ts1617">
                <ANNOTATION_VALUE>Ma:neliwtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1016" TIME_SLOT_REF1="ts1621" TIME_SLOT_REF2="ts1623">
                <ANNOTATION_VALUE>Ne: tikpias ne: Tahchikteko, ompa semi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1018" TIME_SLOT_REF1="ts1625" TIME_SLOT_REF2="ts1628">
                <ANNOTATION_VALUE>tikpia miak *matas** no:. Ompa miak..., kintsi:n ke:meh kintsi:n onkas n' ompa ne:, komo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1020" TIME_SLOT_REF1="ts1632" TIME_SLOT_REF2="ts1634">
                <ANNOTATION_VALUE>Komo a:mo a:kin kiteki, *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1022" TIME_SLOT_REF1="ts1636" TIME_SLOT_REF2="ts1639">
                <ANNOTATION_VALUE>miak ke:meh i:n te:yo:le:wah, ke:meh i:n ki..., kiseli:tih ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1023" TIME_SLOT_REF1="ts1640" TIME_SLOT_REF2="ts1641">
                <ANNOTATION_VALUE>tona:ntsi:n kiselia wa:n sepa kichi:wiliah n' ilwitsí:n pos miak kit..., kite:mo:tih yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
