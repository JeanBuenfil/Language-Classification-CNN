        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a975" TIME_SLOT_REF1="ts1515" TIME_SLOT_REF2="ts1518">
                <ANNOTATION_VALUE>Yo:n de n' kwa:pa:pata:wak yo:n a:mo no: kachi, *porque** yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a977" TIME_SLOT_REF1="ts1520" TIME_SLOT_REF2="ts1523">
                <ANNOTATION_VALUE>Yo:n wa:kkatik wa:n se: ki..., se: kikwa:tsahtsaya:na wa:n i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a978" TIME_SLOT_REF1="ts1524" TIME_SLOT_REF2="ts1525">
                <ANNOTATION_VALUE>n' okseki tepe:xi:lo:t, kowtahtepe:xi:lo:t yo:n no: ma:we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a979" TIME_SLOT_REF1="ts1526" TIME_SLOT_REF2="ts1528">
                <ANNOTATION_VALUE>Yo:n no: *ma:ce:..., ce:cerca**, nehnetechtik kipia seki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a981" TIME_SLOT_REF1="ts1532" TIME_SLOT_REF2="ts1534">
                <ANNOTATION_VALUE>Pero pos yo:n ke:masá: kihtowah a:mo kachi taxi:kowa no *que** niman wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a983" TIME_SLOT_REF1="ts1536" TIME_SLOT_REF2="ts1539">
                <ANNOTATION_VALUE>Ke:mah, kana:wak wa:n i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a984" TIME_SLOT_REF1="ts1540" TIME_SLOT_REF2="ts1542">
                <ANNOTATION_VALUE>yo:n ma:pehpetak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a986" TIME_SLOT_REF1="ts1544" TIME_SLOT_REF2="ts1547">
                <ANNOTATION_VALUE>nochi ne:wín. Matihti... *Más** ne:wí:n tikte:mo:tih, kihto:s seki tokni:wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a987" TIME_SLOT_REF1="ts1548" TIME_SLOT_REF2="ts1549">
                <ANNOTATION_VALUE>xikte:mo:ti xa: tikahsis yo:n ma:pehpetak yo:n tepe:xi:lo:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a988" TIME_SLOT_REF1="ts1550" TIME_SLOT_REF2="ts1552">
                <ANNOTATION_VALUE>Niman se: kilia, komo a:mo nikahsi, mah..., kwaltias ma:ski yo:n kwa:pa:pata:wak. Kihtowa, ke:mah, kihtowa ta: no: xo:chi..., no: tepe:xi:lo:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a990" TIME_SLOT_REF1="ts1556" TIME_SLOT_REF2="ts1558">
                <ANNOTATION_VALUE>Pero yo:n a:mo kachi kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a993" TIME_SLOT_REF1="ts1563" TIME_SLOT_REF2="ts1566">
                <ANNOTATION_VALUE>A:mo kachi. Kachi kikwih yehwa i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a994" TIME_SLOT_REF1="ts1567" TIME_SLOT_REF2="ts1568">
                <ANNOTATION_VALUE>ma:pehpetak wa:n *[por]que** ma:ahalaxtik wa:n kwaltsi:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a995" TIME_SLOT_REF1="ts1569" TIME_SLOT_REF2="ts1571">
                <ANNOTATION_VALUE>*ma:ce:cerca, de que** se: kitalia kwaltsi:n kikwi ne: xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a997" TIME_SLOT_REF1="ts1573" TIME_SLOT_REF2="ts1576">
                <ANNOTATION_VALUE>No: *igual** ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a998" TIME_SLOT_REF1="ts1577" TIME_SLOT_REF2="ts1578">
                <ANNOTATION_VALUE>de n' kwowtah, kowtahtepe:xi:lo:t pos yo:n no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a999" TIME_SLOT_REF1="ts1579" TIME_SLOT_REF2="ts1581">
                <ANNOTATION_VALUE>no: kwaltsi:n wa:n i:n we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1001" TIME_SLOT_REF1="ts1583" TIME_SLOT_REF2="ts1586">
                <ANNOTATION_VALUE>We:weyak mochi:wa seki, we:weyak, yo:n a:mo miak kikwi para se: i:x..., *santoi:xpan** se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1002" TIME_SLOT_REF1="ts1587" TIME_SLOT_REF2="ts1588">
