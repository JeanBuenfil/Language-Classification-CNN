            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778" TIME_SLOT_REF1="ts1031" TIME_SLOT_REF2="ts1032">
                <ANNOTATION_VALUE>Ke:mah, se: pe:wa ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a779" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1035">
                <ANNOTATION_VALUE>a:mo no: eliwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1039">
                <ANNOTATION_VALUE>Ta: yo:n no..., nochi yetok. Nochi yetok, nochi yetok wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a783" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1044">
                <ANNOTATION_VALUE>nijo:n se: ki..., a:mo se: kita:lia de tani se: pe:was, se: kita:lia de ahko se: wa:l..., se: ahko ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784" TIME_SLOT_REF1="ts1045" TIME_SLOT_REF2="ts1046">
                <ANNOTATION_VALUE>se: wa:le:wa, *más** owih ne:n ahko takwa:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a785" TIME_SLOT_REF1="ts1047" TIME_SLOT_REF2="ts1049">
                <ANNOTATION_VALUE>wa:n tahtanakastan a:mo semi owih ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a787" TIME_SLOT_REF1="ts1051" TIME_SLOT_REF2="ts1054">
                <ANNOTATION_VALUE>A:mo kachi owih ok *porque**...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a789" TIME_SLOT_REF1="ts1056" TIME_SLOT_REF2="ts1059">
                <ANNOTATION_VALUE>Komo se: iseltihtsi:n *siempre** se: kitsakwilihtiw ika, *hasta** ika se: itsontekon se: kitsakwilihtiw komo se: ise:ltihtsi:n wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a790" TIME_SLOT_REF1="ts1060" TIME_SLOT_REF2="ts1062">
                <ANNOTATION_VALUE>Pero komo se: o:men, pos se: kilia, pos ekintsi:n xki:tskihtiw ne:n kwali para no: kwaltsi:n moka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792" TIME_SLOT_REF1="ts1064" TIME_SLOT_REF2="ts1067">
                <ANNOTATION_VALUE>Komo a:mo yehwa yo:n chi:chikotik wa:n pos *bueno** n' tani pos tak...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1072">
                <ANNOTATION_VALUE>komo a:kin pos se: weli a se: ise:lti, se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796" TIME_SLOT_REF1="ts1074" TIME_SLOT_REF2="ts1077">
                <ANNOTATION_VALUE>kitekpa:ntiw se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797" TIME_SLOT_REF1="ts1078" TIME_SLOT_REF2="ts1080">
                <ANNOTATION_VALUE>kitetsi:lohtiw ihkó:n ke:meh, ke:meh kikwitiw, kachi owih ka:mpa yo:n monepanohtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a799" TIME_SLOT_REF1="ts1082" TIME_SLOT_REF2="ts1084">
                <ANNOTATION_VALUE>Yo:n ka:mpa monepanohtiw no: kwali seh..., se: kilpi, ta:mo pa:nwetsis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801" TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1089">
                <ANNOTATION_VALUE>Ke:mansá: mopanxola:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a803" TIME_SLOT_REF1="ts1091" TIME_SLOT_REF2="ts1094">
                <ANNOTATION_VALUE>Wa:n, wa:... Moxola:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a804" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1096">
                <ANNOTATION_VALUE>Moxola:wa wa:n yo:n, pos yo:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a805" TIME_SLOT_REF1="ts1097" TIME_SLOT_REF2="ts1099">
                <ANNOTATION_VALUE>de moxola:wa ta:lpan wehwetsi, seki pohposteki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808" TIME_SLOT_REF1="ts1104" TIME_SLOT_REF2="ts1107">
                <ANNOTATION_VALUE>Pohposteki a wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a809" TIME_SLOT_REF1="ts1108" TIME_SLOT_REF2="ts1109">
                <ANNOTATION_VALUE>pos yehwa yo:n neh nikmattok yo:n *cada** ilwitsitsi:n ke:meh kintsi:n tipano:tokeh, a:xka:n ilwitsí:n pos nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a810" TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1111">
                <ANNOTATION_VALUE>pos ika ne: titachihchi:wah wa:n tikta:liah, no: ka:ns ika ne:n tiuweh ampó:n tik..., tikwi:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811" TIME_SLOT_REF1="ts1112" TIME_SLOT_REF2="ts1113">
                <ANNOTATION_VALUE>Tikilpiah kwali ne: ika ne:n tamali:n wa:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812" TIME_SLOT_REF1="ts1114" TIME_SLOT_REF2="ts1116">
                <ANNOTATION_VALUE>tikechpanohtiuweh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814" TIME_SLOT_REF1="ts1118" TIME_SLOT_REF2="ts1121">
                <ANNOTATION_VALUE>Tikechpanohtiuweh iwa:n totepe:xi:lo:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a816" TIME_SLOT_REF1="ts1125" TIME_SLOT_REF2="ts1126">
                <ANNOTATION_VALUE>Wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a817" TIME_SLOT_REF1="ts1127" TIME_SLOT_REF2="ts1128">
                <ANNOTATION_VALUE>pos ka:ns ika ne:n, meh kintsi:n i:n ti...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a818" TIME_SLOT_REF1="ts1129" TIME_SLOT_REF2="ts1131">
                <ANNOTATION_VALUE>ti..., sepa i:n seki to:nalmeh tiahsitih no: oksé: taman xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a822" TIME_SLOT_REF1="ts1138" TIME_SLOT_REF2="ts1140">
                <ANNOTATION_VALUE>Tewi:tso:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a824" TIME_SLOT_REF1="ts1142" TIME_SLOT_REF2="ts1145">
                <ANNOTATION_VALUE>Yehwa yo:n no: de n' kimatih kichi:waskeh. Sepa i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a825" TIME_SLOT_REF1="ts1146" TIME_SLOT_REF2="ts1147">
                <ANNOTATION_VALUE>tehwa:n tikmattokeh *de que**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a826" TIME_SLOT_REF1="ts1148" TIME_SLOT_REF2="ts1150">
                <ANNOTATION_VALUE>ki:ní:n tiktachihchi:waskeh[titachihchi:waskeh]ka i:n, i:n chamakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a828" TIME_SLOT_REF1="ts1154" TIME_SLOT_REF2="ts1156">
                <ANNOTATION_VALUE>Ne:n te..., ne:n tewi:tso:t pos a:mo nochi tikmatih, tik..., tikmatih no: para tikxihxi:maskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a830" TIME_SLOT_REF1="ts1160" TIME_SLOT_REF2="ts1162">
                <ANNOTATION_VALUE>Para ne: tik..., tikwi:panaskeh, tiktekpa:naskeh a:mo ti..., a:mo tiwelih tinochi:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a832" TIME_SLOT_REF1="ts1164" TIME_SLOT_REF2="ts1167">
                <ANNOTATION_VALUE>Pero i:n, nijí:n chamakih nochi, *cada** se: tokni:w nochi, nochi weli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a835" TIME_SLOT_REF1="ts1172" TIME_SLOT_REF2="ts1175">
                <ANNOTATION_VALUE>Nochi kimati ki:ní:n kitapana:s, ki:ní:n kipa:kas, kox kipia okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a837" TIME_SLOT_REF1="ts1179" TIME_SLOT_REF2="ts1181">
                <ANNOTATION_VALUE>Katí:n ne:n, katí:n to:nal, katí:n me:tsti ne:n mochi:wa xo:chitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a839" TIME_SLOT_REF1="ts1185" TIME_SLOT_REF2="ts1186">
                <ANNOTATION_VALUE>¿*Qué tanto** kikwi itech se: ihkó:n itech se: *ar...**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a840" TIME_SLOT_REF1="ts1187" TIME_SLOT_REF2="ts1188">
                <ANNOTATION_VALUE>ihkó:n se: *santoi:xpan de arquito** se: kichi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a841" TIME_SLOT_REF1="ts1189" TIME_SLOT_REF2="ts1191">
                <ANNOTATION_VALUE>ki:ní:n se: kichi:wa, nochi miak kimattokeh n' tokni:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a843" TIME_SLOT_REF1="ts1195" TIME_SLOT_REF2="ts1196">
                <ANNOTATION_VALUE>Ke:mah, nochi kin..., nochi kimattokeh katí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a844" TIME_SLOT_REF1="ts1197" TIME_SLOT_REF2="ts1198">
                <ANNOTATION_VALUE>katí:n to:naltsi:n, katí:n me:tsti, nochi ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a845" TIME_SLOT_REF1="ts1199" TIME_SLOT_REF2="ts1201">
                <ANNOTATION_VALUE>kita:liah *de cada** mochi:wa se: xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a847" TIME_SLOT_REF1="ts1205" TIME_SLOT_REF2="ts1207">
                <ANNOTATION_VALUE>Wa:n nochi katí:n, ox kikwah okwilimeh nochi ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a849" TIME_SLOT_REF1="ts1209" TIME_SLOT_REF2="ts1211">
                <ANNOTATION_VALUE>ta: kipia n' okwiltsitsí:n, a:mo se: ki..., neh a:mo ke:man nikitak ox kikwah n' okwilimeh yo:n chiktehmeh tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a851" TIME_SLOT_REF1="ts1213" TIME_SLOT_REF2="ts1216">
                <ANNOTATION_VALUE>xa:, pero neh nikita sayoh panxi:i:ni *o de** kintamo:ta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a854" TIME_SLOT_REF1="ts1221" TIME_SLOT_REF2="ts1223">
                <ANNOTATION_VALUE>Pos n' iteyo no: kikwah n' chechelo:meh wa:n a:chá: no: kikwah yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a856" TIME_SLOT_REF1="ts1225" TIME_SLOT_REF2="ts1227">
                <ANNOTATION_VALUE>pa:pameh, ta: ke:masá: ompa se: kita itech ne:n xo:chit ompa panihkak m' pa:pa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a858" TIME_SLOT_REF1="ts1229" TIME_SLOT_REF2="ts1231">
                <ANNOTATION_VALUE>Pos yehwa yo:n kintate:moliah ta: se: kita ompa ne: mo..., pa:pata:nih ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a860" TIME_SLOT_REF1="ts1233" TIME_SLOT_REF2="ts1236">
                <ANNOTATION_VALUE>yo:n kwa:sa:me:tmeh no:. kwa:sa:me:tmeh wa:n yehwa ya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a861" TIME_SLOT_REF1="ts1237" TIME_SLOT_REF2="ts1238">
                <ANNOTATION_VALUE>papa:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a862" TIME_SLOT_REF1="ts1239" TIME_SLOT_REF2="ts1241">
                <ANNOTATION_VALUE>ompa itech i:n xo:chitsí:n se: kita kikwihkwih pero yehwa n' yo:n okwiltsitsí:nkinki:xtiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a865" TIME_SLOT_REF1="ts1246" TIME_SLOT_REF2="ts1249">
                <ANNOTATION_VALUE>Pero ne:n iteyo a:chá: no: kikwah *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a866" TIME_SLOT_REF1="ts1250" TIME_SLOT_REF2="ts1252">
                <ANNOTATION_VALUE>a:mo se: kimati x..., kox tsope:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a868" TIME_SLOT_REF1="ts1254" TIME_SLOT_REF2="ts1257">
                <ANNOTATION_VALUE>Yo:n a:mo a:kin kiekowa kox, kox tsope:k *o** ki:ní:n, ta: yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a869" TIME_SLOT_REF1="ts1258" TIME_SLOT_REF2="ts1259">
                <ANNOTATION_VALUE>kwaltsi:n *cuando** se: kitapa:na seki xi:i:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a870" TIME_SLOT_REF1="ts1260" TIME_SLOT_REF2="ts1262">
                <ANNOTATION_VALUE>Moyo:kolia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a873" TIME_SLOT_REF1="ts1267" TIME_SLOT_REF2="ts1270">
                <ANNOTATION_VALUE>Moyo:kolia xi:i:ni, a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a874" TIME_SLOT_REF1="ts1271" TIME_SLOT_REF2="ts1273">
                <ANNOTATION_VALUE>Yo:n, tak no: de chika:waya ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877" TIME_SLOT_REF1="ts1278" TIME_SLOT_REF2="ts1281">
                <ANNOTATION_VALUE>Ke:mah, metstehteiktia wa:n pos nijó:n, yehwa yo:n tik...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a878" TIME_SLOT_REF1="ts1282" TIME_SLOT_REF2="ts1284">
                <ANNOTATION_VALUE>tikta:liah ta:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a880" TIME_SLOT_REF1="ts1288" TIME_SLOT_REF2="ts1290">
                <ANNOTATION_VALUE>Yehwa sah yo:n neh nikmattok *compadrito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a892" TIME_SLOT_REF1="ts1313" TIME_SLOT_REF2="ts1315">
                <ANNOTATION_VALUE>Wa:n yo:n seki ne:, pihpitsa:wak semi, yo:n no: ma:..., ma:we:weyak tepitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a894" TIME_SLOT_REF1="ts1317" TIME_SLOT_REF2="ts1319">
                <ANNOTATION_VALUE>Pero pihpitsa:wak n' i..., xo:chitsí:n, yo:n semi owih se: kitapa:na, yo:n moneki no: de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a896" TIME_SLOT_REF1="ts1321" TIME_SLOT_REF2="ts1323">
                <ANNOTATION_VALUE>tikmatiskeh, no: onkak yo:n kostik de n' wehwei, pero yo:n seki tohtoma:wak n' ikowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a898" TIME_SLOT_REF1="ts1325" TIME_SLOT_REF2="ts1328">
                <ANNOTATION_VALUE>Pero i:n de seki semi, no: kostiktsi:n pero semi tel...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a899" TIME_SLOT_REF1="ts1329" TIME_SLOT_REF2="ts1331">
                <ANNOTATION_VALUE>telpihpitsa:wak n' ik..., n' ikowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a901" TIME_SLOT_REF1="ts1333" TIME_SLOT_REF2="ts1336">
                <ANNOTATION_VALUE>Wa:n no: onkak de n' ista:k, no: onkak seki de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a902" TIME_SLOT_REF1="ts1337" TIME_SLOT_REF2="ts1339">
                <ANNOTATION_VALUE>tohtoma:wak, *mismo**no: ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a904" TIME_SLOT_REF1="ts1343" TIME_SLOT_REF2="ts1344">
                <ANNOTATION_VALUE>Wa:n seki no: de achi pisi:ltik, no: achi, achi pitsa:wak n' ikowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
