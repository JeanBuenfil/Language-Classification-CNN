        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a966" TIME_SLOT_REF1="ts1493" TIME_SLOT_REF2="ts1496">
                <ANNOTATION_VALUE>Nochi tikmattokeh wa:n nochi</ANNOTATION_VALUE>
