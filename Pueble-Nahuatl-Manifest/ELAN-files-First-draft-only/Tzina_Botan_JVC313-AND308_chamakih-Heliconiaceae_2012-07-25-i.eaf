        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a960" TIME_SLOT_REF1="ts1481" TIME_SLOT_REF2="ts1482">
                <ANNOTATION_VALUE>ka:tí:n, katí:n taman,</ANNOTATION_VALUE>
