                <ANNOTATION_VALUE>taselo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1027" TIME_SLOT_REF1="ts1649" TIME_SLOT_REF2="ts1652">
                <ANNOTATION_VALUE>Yo:n taselo:t wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1028" TIME_SLOT_REF1="ts1653" TIME_SLOT_REF2="ts1654">
                <ANNOTATION_VALUE>pos ka:ns ika seki tahta..., seki se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1029" TIME_SLOT_REF1="ts1655" TIME_SLOT_REF2="ts1657">
                <ANNOTATION_VALUE>kitekih sah wa:n pos a:mo se: kimati ox onkas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1031" TIME_SLOT_REF1="ts1659" TIME_SLOT_REF2="ts1662">
                <ANNOTATION_VALUE>A:mo se: kimati, ke:meh nimitsilia ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1032" TIME_SLOT_REF1="ts1663" TIME_SLOT_REF2="ts1664">
                <ANNOTATION_VALUE>nochi pano:tok de n' ilwitsitsí:n de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1033" TIME_SLOT_REF1="ts1665" TIME_SLOT_REF2="ts1666">
                <ANNOTATION_VALUE>n' kintsi:n nochi de n' *te:chcuidarohtok** ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1034" TIME_SLOT_REF1="ts1667" TIME_SLOT_REF2="ts1669">
                <ANNOTATION_VALUE>*santitos** ihkó:n, pos nochi pano:tiw wa:n niki..., tikte:mo:tih *siempre** ma:ski wehka pero tiuweh tikte:mo:tih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1038" TIME_SLOT_REF1="ts1676" TIME_SLOT_REF2="ts1679">
                <ANNOTATION_VALUE>Tikte:mowah wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1039" TIME_SLOT_REF1="ts1680" TIME_SLOT_REF2="ts1682">
                <ANNOTATION_VALUE>pos n' kintsi:n kaxa:ntiw ya no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1041" TIME_SLOT_REF1="ts1684" TIME_SLOT_REF2="ts1687">
                <ANNOTATION_VALUE>Kaxa:ntiw ya ke:meh i:n, i:n to:nalmeh miak tikte:mohkeh wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1042" TIME_SLOT_REF1="ts1688" TIME_SLOT_REF2="ts1689">
                <ANNOTATION_VALUE>Kintsi:n ka:mpa tiktekkeh ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1043" TIME_SLOT_REF1="ts1690" TIME_SLOT_REF2="ts1691">
                <ANNOTATION_VALUE>wa:n yo:n, yo:n chamakih komo a:m..., yo:n no: moneki ma..., para ka:mpa ta:ki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1044" TIME_SLOT_REF1="ts1692" TIME_SLOT_REF2="ts1693">
                <ANNOTATION_VALUE>kwaltsi:n mochi:wa, no: moneki mah se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1045" TIME_SLOT_REF1="ts1694" TIME_SLOT_REF2="ts1696">
                <ANNOTATION_VALUE>kite:nxi:ma wa:n kwaltsi:n mah se: kitehteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1047" TIME_SLOT_REF1="ts1700" TIME_SLOT_REF2="ts1702">
                <ANNOTATION_VALUE>Mah se: kiki:xtili, mah se: kichipa:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1050" TIME_SLOT_REF1="ts1707" TIME_SLOT_REF2="ts1710">
                <ANNOTATION_VALUE>*Porque** seki nikita, seki, ki..., se: kiyo:ltekih sah. Xo:chit sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1051" TIME_SLOT_REF1="ts1711" TIME_SLOT_REF2="ts1713">
                <ANNOTATION_VALUE>Xo:chit sah wa:n nió:n no: ki..., ki..., kitehtekih n' ima:yo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1053" TIME_SLOT_REF1="ts1715" TIME_SLOT_REF2="ts1718">
                <ANNOTATION_VALUE>Entó:s ki..., ihkó:n kita:tamo:tah ihkó:n a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1054" TIME_SLOT_REF1="ts1719" TIME_SLOT_REF2="ts1720">
                <ANNOTATION_VALUE>a:mo mo..., ye:kkwaltsi:n moskaltia ok wa:n ka:mpa kwaltsi:n ke:meh eskia nochi se: kitaki:xtilia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1055" TIME_SLOT_REF1="ts1721" TIME_SLOT_REF2="ts1722">
                <ANNOTATION_VALUE>pos ka:mpa se: tahtani ihkó:n ka:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1056" TIME_SLOT_REF1="ts1723" TIME_SLOT_REF2="ts1724">
                <ANNOTATION_VALUE>te:..., pos mah te:makaka:n pos se: kiteki ika *paciencia** nejó:n xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1057" TIME_SLOT_REF1="ts1725" TIME_SLOT_REF2="ts1726">
                <ANNOTATION_VALUE>Pos kwaltsi:n no: se: ki..., ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1058" TIME_SLOT_REF1="ts1727" TIME_SLOT_REF2="ts1729">
                <ANNOTATION_VALUE>kitehteki mah kwaltsi:n momoxtik se: kita:tamo:ta ne:wí:n *o** seko se: kite:ma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1060" TIME_SLOT_REF1="ts1731" TIME_SLOT_REF2="ts1734">
                <ANNOTATION_VALUE>Yo:n kihtowah *que** no: tapala:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1063" TIME_SLOT_REF1="ts1739" TIME_SLOT_REF2="ts1741">
                <ANNOTATION_VALUE>No: tapala:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1065" TIME_SLOT_REF1="ts1743" TIME_SLOT_REF2="ts1746">
                <ANNOTATION_VALUE>Tapala:n kit para ne:n kahfe:ntsi:n mah se: kite:mili oso teihsá: pahpatatsi:n itsi:ntan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1066" TIME_SLOT_REF1="ts1747" TIME_SLOT_REF2="ts1749">
                <ANNOTATION_VALUE>Sayoh mah se: kimomoxo, *por eso** kans ika te:iliah ka:mpa se: kitekiti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1076" TIME_SLOT_REF1="ts1768" TIME_SLOT_REF2="ts1771">
                <ANNOTATION_VALUE>Tapala:n yo:n nochi ne:n kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1078" TIME_SLOT_REF1="ts1775" TIME_SLOT_REF2="ts1776">
                <ANNOTATION_VALUE>Kkwih nochi ke:meh i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1079" TIME_SLOT_REF1="ts1777" TIME_SLOT_REF2="ts1778">
                <ANNOTATION_VALUE>ma:sá: ka:ns ika se: ki..., kite:ma ihkó:n oso iwa:n yo:n pahpata,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1080" TIME_SLOT_REF1="ts1779" TIME_SLOT_REF2="ts1781">
                <ANNOTATION_VALUE>pahpata n' ikowyo pos iwa:n ya pala:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1082" TIME_SLOT_REF1="ts1783" TIME_SLOT_REF2="ts1786">
                <ANNOTATION_VALUE>Iwa:n pala:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1083" TIME_SLOT_REF1="ts1787" TIME_SLOT_REF2="ts1788">
                <ANNOTATION_VALUE>Wa:n yo:n no:, no: semi kwali para ne:n tapala:n para ne:n *toplantitas** ihkó:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1084" TIME_SLOT_REF1="ts1789" TIME_SLOT_REF2="ts1791">
                <ANNOTATION_VALUE>seki ne:n, e:wi kwaltsi:n, selia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1087" TIME_SLOT_REF1="ts1796" TIME_SLOT_REF2="ts1799">
                <ANNOTATION_VALUE>Kina:miki *de veras** wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1088" TIME_SLOT_REF1="ts1800" TIME_SLOT_REF2="ts1802">
                <ANNOTATION_VALUE>wa:n yo:n neh nik..., nikmattok no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1090" TIME_SLOT_REF1="ts1806" TIME_SLOT_REF2="ts1807">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n nika:n timonohno:tskeh pos neh no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1091" TIME_SLOT_REF1="ts1808" TIME_SLOT_REF2="ts1810">
                <ANNOTATION_VALUE>a:mo, yeh..., neh yehwa sah yo:n de nik..., nimits..., nimitsilih de nikmattok de n' chamakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1093" TIME_SLOT_REF1="ts1814" TIME_SLOT_REF2="ts1816">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1100" TIME_SLOT_REF1="ts1829" TIME_SLOT_REF2="ts1831">
                <ANNOTATION_VALUE>Ma:we:weyak wa:n yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1102" TIME_SLOT_REF1="ts1833" TIME_SLOT_REF2="ts1836">
                <ANNOTATION_VALUE>pos de se: xo:chitsí:n nochi kipia ta:taman n' itapalo ne:n i..., paniá:n ne:n,</ANNOTATION_VALUE>
