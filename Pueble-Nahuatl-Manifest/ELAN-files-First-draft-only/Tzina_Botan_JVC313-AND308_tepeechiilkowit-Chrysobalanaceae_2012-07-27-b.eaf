        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>pos nochi nika:wí:n, nika:wí:n ka:mpa ka tinemih ompakawí:n onkak nijó:n tikiliah tepe:chi:lkowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>pos ke:masá: niman se: kihtowa, komo a:mo tikahsi ne:n okseki kowtsitsí:n, pos kwali tiktekis yo:n tepe:chi:lkowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts267">
