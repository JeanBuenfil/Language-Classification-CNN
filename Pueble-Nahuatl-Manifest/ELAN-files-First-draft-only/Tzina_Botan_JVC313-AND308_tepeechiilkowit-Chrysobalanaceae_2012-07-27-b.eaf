        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>*o para** ta:nka:yo:t pos *más** wehwei,</ANNOTATION_VALUE>
