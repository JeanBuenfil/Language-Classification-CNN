        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>yo:n nochi te:chpale:wia. Pos yehwa yo:n neh nik...,</ANNOTATION_VALUE>
