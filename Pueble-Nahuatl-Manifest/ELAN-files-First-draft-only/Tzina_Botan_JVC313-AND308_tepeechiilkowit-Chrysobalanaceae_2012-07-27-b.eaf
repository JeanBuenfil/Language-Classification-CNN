        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>ox we:lik n' iteyo *o, o** ki:ní:n, neh a:mo nikmati nio..., oso kikwah kowtahokwilimeh, neh *solamente** nikita ne:n chiktehtsitsi:n kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts425">
                <ANNOTATION_VALUE>Yo:n kwitatohtokmeh, yo:n okseki chiktehtsitsi:n, ne:n,</ANNOTATION_VALUE>
