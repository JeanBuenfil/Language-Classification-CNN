        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>Wehwei mochi:wa.</ANNOTATION_VALUE>
