        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Ihkó:n *merito**, ihkó:n *merito**.</ANNOTATION_VALUE>
