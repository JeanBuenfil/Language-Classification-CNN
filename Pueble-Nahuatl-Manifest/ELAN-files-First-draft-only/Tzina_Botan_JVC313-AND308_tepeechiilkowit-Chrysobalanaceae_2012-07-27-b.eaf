        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>Ke:mah, teh xa: kachi tikmattos ne:n..., katí:n, xa: tikmattos para teihsá: kikwih, para,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts471">
