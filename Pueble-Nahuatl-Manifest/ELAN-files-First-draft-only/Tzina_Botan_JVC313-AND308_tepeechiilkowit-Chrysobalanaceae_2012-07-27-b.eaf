        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts746">
                <ANNOTATION_VALUE>Pos yo:n no: kwaltia ne:n..., wehwei mochi:wa semi.</ANNOTATION_VALUE>
