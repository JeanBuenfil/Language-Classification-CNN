        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>pos se: kiteki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>Wa:n seki no: wehwei mochi:wa, wehwei wa:n itsmoli:ni no:.</ANNOTATION_VALUE>
