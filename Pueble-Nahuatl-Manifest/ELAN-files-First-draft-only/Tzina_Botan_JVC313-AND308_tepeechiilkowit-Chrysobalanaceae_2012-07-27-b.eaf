        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>pos nijó:n, yo:n *lo más** ne: ki..., kitahtapa:nah, sayoh moneki ka:mpa se: ki..., kitehtekis ihkó:n mah se: kpa:ntsakwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts490">
