        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>pero teihsá: wehweiokwilimeh pos neh a:mo no: ke:man nikita mah,</ANNOTATION_VALUE>
