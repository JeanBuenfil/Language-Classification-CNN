        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts759">
                <ANNOTATION_VALUE>*O** miak n' ima:yo mochi:wa.</ANNOTATION_VALUE>
