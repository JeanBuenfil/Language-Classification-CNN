        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>Nochi kwaltia eski, sayoh ke:masá: se: kita ne:wí:n wetstok ihkó:n,</ANNOTATION_VALUE>
