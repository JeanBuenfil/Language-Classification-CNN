        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>yo:n neh nikita yo:n mohmot no: kikwa, ma:sá: se: kita ompa pata:nte:wa.</ANNOTATION_VALUE>
