        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>pos nochi n' ima:tako:yo nochi kwaltia ke:meh i:n tikwih kowtati:l. Ke:mah, tik...,</ANNOTATION_VALUE>
