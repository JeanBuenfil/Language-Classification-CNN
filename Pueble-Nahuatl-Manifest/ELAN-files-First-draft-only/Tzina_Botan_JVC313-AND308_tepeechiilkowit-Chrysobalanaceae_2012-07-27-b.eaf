        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>Neh nikita sayoh yehwa ne:n chiktehtsitsi:n ne:n ompa ne: mopi:pilowah.</ANNOTATION_VALUE>
