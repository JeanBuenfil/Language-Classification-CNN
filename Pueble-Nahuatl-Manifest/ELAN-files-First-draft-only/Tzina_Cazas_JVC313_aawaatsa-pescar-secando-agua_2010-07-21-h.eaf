                <ANNOTATION_VALUE>Wa:n se:, se: tamitaololowa entó:s tikihtowa ne: sepa mah se: kwehwelo n' a:t ne: ka:mpa se: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>¿Nochi a eskia de i:n se: a:wa:tsa?</ANNOTATION_VALUE>
