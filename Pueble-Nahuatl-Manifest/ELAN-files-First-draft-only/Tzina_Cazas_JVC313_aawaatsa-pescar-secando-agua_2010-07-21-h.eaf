        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Wa:n komohkó:n a:mo se: kite:milia tenex n' a:t, ¿Keni:w se: kinkwi xilimeh, se: a:wa:tsa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
