        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>Wa:n ahko ka:mpa tamiti a, ka:mpa tikwa:ilpiayah ya ne:n, n' yehwa n' *hule**, entó:s ompa yo:n, kipia, kipias e:yi, e:yi mahpil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>A:mo se:, a:mo se: tamachi:w sah, sanokeka:mpa n', ka:mpa, ka:mpa momaxalohtok kowtsí:n kipia ke o:me mahpil</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
