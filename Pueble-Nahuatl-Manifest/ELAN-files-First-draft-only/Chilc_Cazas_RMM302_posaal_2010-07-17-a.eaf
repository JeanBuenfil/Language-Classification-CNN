                <ANNOTATION_VALUE>Yehwa yo:n, yehwa yo:n te:..., tikitayah, *bueno** neh ne:chmachtihkah *notiohwa:n**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
