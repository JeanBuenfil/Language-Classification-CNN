                <ANNOTATION_VALUE>A:mo no: wel semi ke:meh weli kowit tikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>*Solamente** no: se: kitaya sah *porque** tein tikitayah no: achi mela:wak wa:n tein kwaltsi:n ikamachal kipia ya no: *porque**,</ANNOTATION_VALUE>
