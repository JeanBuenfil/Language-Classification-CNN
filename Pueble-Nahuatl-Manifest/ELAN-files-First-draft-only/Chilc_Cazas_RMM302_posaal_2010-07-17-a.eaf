        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Wa:n komo tapo:tok de o:me mahpil, pos sa yehwa sah aki tet se: kitamo:ta wa:n yowi.</ANNOTATION_VALUE>
