        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>A:mo *igual** we:lik ke:meh se: piotsi:n, *porque** se: piotsi:n no: taman we:lik</ANNOTATION_VALUE>
