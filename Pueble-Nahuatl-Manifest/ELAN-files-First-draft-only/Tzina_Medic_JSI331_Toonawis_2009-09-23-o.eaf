    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="José Antonio Salgado Isabel" TIER_ID="José Antonio Salgado Isabel">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Ne: ke:man, ke:meh itech *del año treinta, cuerenta,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>hasta cincuenta** ok kihtowah, tehwa:n te:chilihkeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>Ke ne:n kokolis de n' to:nawis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>a:mo wel kintaka:wilia:ya ok, a:mo wel mahchi:waya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>e..., kihtowah ke telsemi *delicado** katka *porque** a:mo wel kikwa:yah *helado**, a:mo wel kikwa:yah *paleta**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>e..., nochi kinkwi:ltiaya n' to:nawis. E..., tein tonika mopahtia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>a:mo nikelna:miki tonika mopahtia:yah pero pos pané: a:mo teh pahti katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>Yo:n pahtiko *porque** ne:n tamik m' *paludismo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>no: *por lo mismo** de n' moyo:t ata kihtowah, ki..., kimoya:waya n' kokolis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>wa:n a:xka:n a:mo teyi ok *por lo mismo** miak koyo:pah ne:siko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>miak *este,** onkaya yo:n *campaña de paludismo**, a:mo n'mati ox tikelna:miktok ata yo:n, a:mo n'mati ox tikitak ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>tarosia:rowa:yah, te:chakalante:m..., [te:chkalan]tate:milia:yah *al año milnovecietos sesenta, sesenta y uno** chi:wik ok, *últimos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>A:man a:mo tei ok, a:man okseki kokolisme onkak, n' *paludismo** tamik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>nemi *paludismo** kilia pero sayoh mo:yo:t, se:, se: xahkalmo:yo:t inachi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>yehwa kilia *paludismo** nika:n, a:xka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>pero n' kokolis a:mo, a:mo teyi ok. A:man onkakeh okseki kokolismeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>onkakeh kokolismeh yankwikeh a:xá:, a:mo sayoh *paludismo**, e...,ne: tehwa:n tiki:xmatiah to:nawis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>N', n' to:nawis ka:n teh *más que** sehsekwi:lis wa:n m..., motsetselowa ma:ski to:natos chi:ka:wak pero sekwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>yehwa ne:n kiliah n' koyo:meh *sintomas** de n' tak, n' *paludismo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>A:man oks..., onkak okseki kokolismeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>a:mo se: kimahmati toni, ke:meh kihtowah kokolis de n' *cáncer**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>¿Toni yo:n?, kokolis de n' *cancer** a:xá: se: *tumor** de, de se: itech se: inakayo *o** itech se: io:miyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>yo:n onkak *maligno** wa:n *beningno**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>Se: wehka:wa wa:n se:, se: telwehka:wa... para n' miki n' a:ksá</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>wa:n se: telihsiwka para n' miki n' a:ksá:, se:meh de n' o:men e...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>nochi n' o:men *malos** pero se: *a largo plazo** wa:n se: *a corto plazo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>Ne:n yo:n kokolismeh kihtowah ke onkak pahti pero sayoh, soh *control, igual porque mortal**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>wa:n a:mo, wa:n [a:man]miak kokolismeh ne:sih, achto xa: i:pa onkaya pero a:mo tikmatiah *porque** a:mo teh onkaya *medico**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>a:mo teh onkaya *análisis** de ke:meh ekintsi:n onkak tai:xeeko:lis de se: iesyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>de se: ixi:x, de se: inekalawi:l, de se: ichihchi, de se: i..., de nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Entó:s ki..., ke..., momakah kwe:ntah tapahtia:nih toni tikpiah kokolismeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>de yo:n kokolismeh ki..., ne:n *mayor parte, o sea que** de n', tein telmiak tehwa:n tike:waltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Ke:meh kihtowah ne:n ekintsi:n *diabéticos** n', no: se: kokolis *mortal** ke a:mo no: kipia m' pahti, soh kipia se: *control.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>Control** ika pahti, ika, ika *veneno**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>wa:n *control** ika takwalis wa:n *control** ika ... a:mo n'mati ke:ní:w, ika kwalyeto:lis no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>E..., e:yi, e:yi, te..., e:yi *control** kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>wa:n no:ne:n yo:n kokolismeh kihtowah ke ... a:mo kihtowah, ta: neli wi:tsa de nemowtil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>a:kin momowtihtok kikwi yo:n kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>Yo:n, yo:n ye:wa tik..., yo:n tikelna:miktoyah yo:n ta:kat mokwe:tehwih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>*al último** kikwik *diabetis**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>E..., ekintsi:n *diabético** por yo:n mohka:yo:t de n' *cohete** de n' *kitoca:roh** i:xtololo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>wa:n a:mo sayoh yo:ni, onkak miak. *Cualquier** nemowtil, miakeh mikkeh ya *por[que]** ka:n, a:[mo]... ka:n mopahti:skeh de yo:n, de nemowtil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Nemowtil kihtowah kipahtia *solamente** ika cho:kil de iyat kite:mpachowah, kino:tsah wa:n *pelotillas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Pelotillas** chihchi:wtok de n' xiwmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts91">
                <ANNOTATION_VALUE>seki *bolitas** de, *son pelotas, pelo..., pelotitas</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>sería como de ... ah, a:xá: eskia ke:meh se:, ke:meh se: xa:lxokot,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>achi se: xa:lxokot</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>*o más** tsi:tsikitsi:n. Aha, tsikitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>Se: xokotoloh tikihto:ka:n *o** se: canica**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>e:... a:mo nikmati de ka:nachi xiwmeh pero tachihchi:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>tatsoyo:n ika *aceite**, takwa:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>mota:lililiah*por, por el** ... ke:ní:w kihtowah *este,** e..., se: itsi:ntan *pues**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>se: itsi:ntan kita:liliah *o** se: mota:lilia ke:meh eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>Neh a:mo ke:man, a:mo ke:man nimota:lilia pero tein nikitani wa:n ne:chilia:nih tapahtia:nih *a veces**, i:ksá: se: kininohno:tsa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>com..., pero *más** kachi kwali ximopahti de yo:n ke timikis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>*Porque** timi..., *porque** tinemiko sioh se: *viaje**, soh sempa:nti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>wa:n monemi:lis a:mo itsmoli:ni ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>E..., a:k..., miakeh kihtowah, "no:, *mejor** okachi kwali mah nimiki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>wa:m a:mo neli, a:mo neli, se: ... *cuando** se: miktok a, se: monemilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>mah aya:mo nimiki, *mejor** mah nimopah..., kachi kwali mah nimopahti ok, xa: ninemiskia ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Xa: nikinitas nopilwa:n ok, xa: nikinitas noxwi:wa:n ok, ka:n n' mati, miak se: monemilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>No: [...], de yo:n ne:n nemowtil *mismo** nika:wí: onkakeh tapahtia:nih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>e..., siwa:meh, ta:kah wa:n te[i]n..., nemowtil tikmachili:s ke sayoh a:mo wel titakwa, yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>Ka:n titakwa:s, a:mo teh tikwe:lili:s nió:n tei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>A:mo teh we:lik, timattos ke we:lik *o** moihtik timaya:nas, mote:noh a:mo k..., a:mo ki..., a:mo ki..., a:mo kiselia, a:mo weli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>A:xá:, a:mo tie:lmoya:wi pero a:mo panowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>wa:n yo:n kimattokeh tein, tein te:pahtiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>tein te..., tem..., te:te:mpachowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>wa:n ne: a:mo, a:mo *este,** a:mo kipahtia n' tapahtihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>No: kipahtiah ika, ika seki xiwit kihtowah, yo:n ma:ltantsi:n tayih ke:meskia ika moa:mikpahtiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>ke:mah de yo:n pahti a, a:mo ok kit:mpachowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>*o** kino:tsah. Kino:tsah a:mo n'mati ke:ní:w, so..., yehwa:n kimattokeh tapahtia:nih ke:ní:w te:no:tsah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>wa:n ne:n ... onkak miak kokolismeh, i:ksá: moma:nelowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>moma:nelowa. Onkak moko..., onkak kokoyanih kipia se: oso o:me oso e:yi kokolis sepa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>Ke:ní:w kichi:wah, achto kipahti:tih se: kokolis, sa:te:pan oksé: kokolis kipahti:tih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>wa:n sa:te:pan n' oksé:, sehse:, sepa sah a:mo weli</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>Komohkó:n momowtihtok, *o sea** a:mo takwa, achto t'pahti:tih de nemowtil para takwa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>A:man, komo [ki]kokowa itsontekon, tikitatih itsontekon ke:yeh kikokowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>a:man, komo kalanemi, a:man tikitatih mah mopahti de kalanemi:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>Miak kokolis onkak, nochi yo:n i:ksá: tehwa:n tikpiah tahtakol,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>a:mo se: moita, a:mo se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Kihtowah ke, ke *este,** m..., ne:n tapahtia:nih, seki kihtowah ke tiokwilohkeh, a:mo n'mati ox neli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>ta: ma:se:walmeh nemikoh wa:n ka:n ke:man tia..., mopahtia:yah de okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Nemikeh, kichi:wkeh n' we:i, we:i tio:pah, we:i tio:panwe:..., tio:pameh kichi:wkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>wehwei *palacios** kichi:wkeh wa:n ka:n onkayah, a:mo onkaya, a:mo onkaya *médicos**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>a:mo onkaya análisis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>a:mo onkaya tei wa:n tekitikeh, kichi:wkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Ke:ní:w ... wa:n tehwa:n timotahtaniah, ke:ní:w se: itskwinti, se: tapial ka:n ke:man motahtania, ka:n ke:man mopahtia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>wa:n ke:ní:w *cristiano**, ke:ní:w tokni:w, ke:ní:w ta:kat tel..., e..., ke:ní:w ... impo:rtah mah mo..., moihmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>Yo:n se: mo..., netahtani:lis ke tinochi:meh timochi:wiliah, de n' kokolismeh teli:xkich onkak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>ke:meh se: ihtik, ke:meh se: i:xtololo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>ke:meh se: inakas, se: itsontekon, m..., se: io:miyowa:n wa:n se: inakayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>Se: iesyo a:mo mota.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>onkak seki nochi kokolismeh sek..., nochi, nochi mota pero seki a:mo mota</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>onkak a:mo kokolismeh, onkak seki kiliah te..., tein te:ch..., timokowah tehwa:n, i:ksá: se: motsonteki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>*o** se: monekwilowa, miak chi:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>I..., ke:man se: motsonteki, komo kowtah tietokeh wa:n a:mo moketsa n' esti, t'mattok ke:ní:w se: moketsa, se: ketsa n' esti teh Mariano.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Xo:no:alak ata kihtowah, kakaltia xo:no:alak wa:n a:mo ka:wa ok mah ki:sa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>yo:n panti. A:mo pahti, *sino que** kitsakwilia ka..., takwa:waya ne:n, kichi:wa *igual** ke:mehn' yo:n, yo:n mokwa:ohsah, yo:n alaktik, [ke:ní:w]mono:tsa, *gel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Igual**, xo:no:t ialakyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Entó:s takwa:waya wa:n a:mo kika:wa n' esti mah ki:sa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>yo:n komo *accidente**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>Ta:ka:n tepitsi:n nekwilo:l, ata yo:n omisa:l, no:, no: kwali, mela:w. Omisa:l ke:meh piomeh, ta:ká:n ... *o** to:tolin mometsposteki *o** posteki n' i..., n' i..., n' io:miyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>a:it toni kipia, kwitat de *mismo** to:tolin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>wa:n pahti, ika moketsa, mota:lia *bueno** sepa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>E..., ne:n *cristiano** a:mo t'matih pero *lo que es este,** to:tolin ika *mismo, mismo ikwit** sepa pahti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>e..., pahti, axá: pah..., a:xá: a:mo pahti ke:meh achto yetoya pero sepa mokwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>kwali nehnemi *o** kwali pata:ni, komo, komo kalak se: kwowit itech se: tapial, ke:meh tapial a:mo tahtowa, a:mo se: kimati</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>ompa mopachowa ya ika inakayo, ompa aktok kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts225">
                <ANNOTATION_VALUE>E..., *últimamente** timomakatiwi:tseh kwe:ntah ya ke, ke *después** de *cincuenta años**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>wehweliwi toi:xtololo, tapahtia:nih kihtowah mah se: kitati ne:n te..., te:i:xitakeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>A:man onkak te:skat, onkakeh seki kihtowah ke pos kachi, kachi, kachi te:i:xwehweloh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>pero niki:xehekowa pe..., según no: se: yeh, ke:ní:w se moih..., se: mo..., se: kihmatis se: i:xtololowa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>E..., tehwa:n tiseki:meh a:mo tachiah ok kwali ke:meh moneki, n'..., tikihtowah ti:xmiakiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>tein tsikitsitsi:n teisá: a:mo tikitah ok, nochi yo:n se: kwehmol a pero *por edad,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>cuando por** kokolis pos yo:n ihwa:k komohkó:n kite:maka, onkak weliti:lis se: mopahti:s, komo onkak tomi:n se: mopahtia wa:n koma:mo ihkó:n se: moka:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>Miak itech kowtah tinemih tikihyowihtokeh miak kokolismeh *porque** a:mo tei n' tomi:n para se: mopahti:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>on..., kihtowah koyo:meh ke onkakeh, ke onkakeh tapahtia:nih tein i:pa yehwa yo:n intekiw, ke:ní:w kiniliah especiali:stas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>Tehwa:n nika:n a:mo o..., onkak de yo:ni, ka:n, ka:n weli, ka:n wel timopahtiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>i:n *tiempos** tein tiahtokeh ne:nke:n ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>E..., kihtowah nika:n i:n to..., toxo..., to..., ka:mpa tinemih onkak miak xiw..., xiwpahmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>wa:n neli, t'mattokeh miak xiwpahmeh onkak, para kalanemi:lis, para nemowtil, para se: moxole:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>para se: monekwilowa, para ... santeina:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>Nochi, nochi pahti. Kihtowah ke:meh ne:n *cebolla** semi kwali pero ... *ajo** ke semi kwali,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>pero n' *ajo** a:mo tinochi:meh tikwah, tikihyah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>semi chika:wak ih..., iahwia:kka:yo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>Tikwah, tikwah pero para, para emo:l</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>pero mah ihkó:n tik..., o..., onkak tokni:wa:n kikwah iwki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>A:mo n'mati Mariano, teh t'mattok iwki, kipixkah se: *ajo** wa:n ... mm ... A:mo tinochi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>entó:s no: *igual, ajo** kihtowah ke ehekapah, nelto..., a:p..., tamanká:, xo:me:t ehekapah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>E..., ke:ní:w mono:tsa yo:n, ke:ní:w mono:tsa yo:n xiwtsi:n ihkó:n tsi:tsikitsi:n, *albahaca.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>Albahaca** o:me taman, se: tsitsikitsi:n, tsi:tsikitsi:n al..., *albahaca** wa:n se: we:i *albahaca**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Se:meh de n' o:me, se: *macho** wa:n se: *hembra, según** kihtowah, e:..., nochi ehekapah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Mm. yehwa ya n' *ajo** ehekapah. I:n to:to:, nochi i:n ka:m..., *casi** tikihto:ka:n *municipio de Cuetzalan**, nochi, nochi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>kineltokah yo:n de n' ehekat, ehekakokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Mm, onkakeh tokni:wa:n ke kichi:wah, kichi:wah ne: chipa:walis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>mitschipa:wah ika xo:me:t, ika pio:tet wa:n tipahti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>Tipahti i..., yo:n kokolis tikpia seki, seki kokolis, ta:ká:n ehekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>komo ehekat, koma:mo mitspahti:s *médico**. Ke:man se: kokoxkeh kipia, kwi:kah iwa:n tapahtihkeh wa:n de ehekat, tapahtihkeh a:mo kipahtia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Kipahti:s se: ma:se:waltapahtihkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>kichipa:was, kihto:s tio:tahto:l wa:n a:it toni *más** kichi:wa, entó:s mitspahtia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>nika:wí: no: kihtowah ke ka:sá: ika mitski:xtiliah se: tet, se: kowit, se: xiwit, se: t..., se: *hilo** oso a:it toni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>ox neli, ox neli, ox neli yo:n, a:mo se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>Miakeh kihtowah ke e..., te:ka ma:wiltiah sah, a:mo ... te:kahkaya:wah, a:mo neli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>seki kihtowah ke ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Mm, neh a:mo, a:mo, pané: a:mo nikneltoka, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Miak kokolismeh onkakhe ke, a:mo, a:mo a..., nika:wí: a:mo mopahtia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>*importa, telimporta** tikpataskeh, *hasta** tikitati:wih ne:n tapahtihkeh ne:n tapahtihkeh, iwa:n *medico**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>ke:meh yo:n, yehwa ya ne:n *diabeticos**, ne:n xo:met a:mo kipahtia, *ajo**, a:mo kipahtia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>kipahtia okseki xiwmeh pero sayoh *como control**, mah a:mo miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>*Cuando** tahtohtokeh de kilia *control** sioh ke mah kitsakwili sioh n' kokolis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>pos sayoh kitahyowi:ltihtokeh n' kokoxkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Mm, mah yo:lto ok, mah yo:lto ok, mah yo:lto ok. "Ne:chmaka se: pahti mah yo:lto ok, mah yo:lto *diez años, veinte años, treinta años** mah yo:lto",</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>mah yo:lto para mah *más** tahyowi, yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>E:..., ke:meh kihtowa ne:n, tehwa:n timomakah kokolis tein tikwah ika [tehwa:n timokokoliskwi:ltiah ika tein tikwah], tikwah miak santeina:motsitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>Ke:meh yo:n ye:wa tikihtowa:yah ke tai:tih a:t, a:mo titai:tih *coca cola.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Coca cola te:chkwi:l[t]i:s *diabetis**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>a:mo sayoh *coca cola**, nochi:meh, nochi:meh *refrescos**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>koyo:tai:l, e..., no: de n', no: de n' ta:wa:nalis, no: kip..., no: kipia miak , no: kika:wa miak kokolismeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>Ke:meh kihtowa komohkó:n se: mo..., miakeh pi:pil neh kih..., nikakini</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>iwa:n nitekitini, pi:pil, pi:pil, *quince años,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>a..., diesciocho años, veinte años, ventitres años**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>kipia *gastritis** wa:n pilimeh ok, mm. A:it ke:yeh, de o..., wa:n koma:mo mopahtiah de *gastritis**, kinkwi *úlcera**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>wa:n ke:mah kinkwi, a:ksá: kikwi *úlcera** wa:n a:mo mopahtih ika miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>Ma:ski kipia *ulcera** pero komohkó:n kipia mo..., mopahtih pos nemi ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>Yo:n tehwa:n tot..., tehwa:n tikmatih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>Wa:n i:ksá: a:mo timopahtiah *porque** tipi:na:wah tikihto:skeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>*últimamente** kimat..., kihtowah ke nochi onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>kokolis de ta:kameh wa:n kokolis de siwa:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>E..., miakeh i..., tikakilia:nih ke kokolis de siwa:meh, ke:meh pi:na:wah para kihto:skeh *hasta** ika mikih, a:mo kihtowah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>*igual** ta:kameh, mm. *Igual** ta:kameh, e..., sayoh ke tehwa:n tipi:na:wah tikihto:skeh ne:chkokowa nota:kayo *o** ne:chkokowa *tal parte**, ka:n 'mati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Pi:na:wka:yo:t a:mo teh ka:wa, tein pi:na:wka:yo:t kika:wa, ka:wah sayoh miki:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>No: *tanto** ke:meh kokolismeh de n' wehwei:n wa:n kokolismeh de n' pilimeh, ta:taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>kipia ke ki..., se: yeh se: kimatis wa:n, wa:n *antes** ke se: mokoko:s, moneki mah se: monehmachti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>Kihtowah *últimamente** tapahtia:nih a:mo, a:mo kipahtiah, sanoke kinehmachtiah tein kiliah *vacunas**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>a:mo sayoh sentaman, de miak taman. I:ksá: se: kokoliskwi *por** kokolis wa:n i:ksá: *porque** okwilimeh, okwilimeh tekwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>N' *por ejemplo**, se: sempowalma:yeh, *por de malas**, se: kowa:t *por de malas**. E: se: sipo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>se: a:skat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>Onkak te..., a:skameh te:kwi:ltih toto:nik tein te:kwa, mm, tein nika:wí: onkakeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>e:..., onkakeh, onkak se: okwiltsi:n mono:tsa ta:lchokoy,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>*igual**, telte:kokoh *hasta** a:it ke:ní:w. Mm, onkak okwilimeh ke a:mo mota,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>a:mo mota, mota iwa:n xiwit, ompa yo:li itech xiwit *igual**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>miak onkak, kihtowah ke:meh yo:n nektsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>ne: we:inekmeh, yo:n wehweinekmeh ki:xmatih, mela:w. Mm, pos yo:n no: *igual**, telte:kokoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>xi:kohmeh, *parientes** de nektsitsi:n, telte:kokohkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>E..., *ultimamente ekintsi:n no:ya:n telte:kwah yowak mo:yo:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>ka:mpa kwali tatsaktok pos a:mo te:kwah mo:yo:meh pero ka:mpa a:mo kwali tatsaktok kalakih mo:yo:meh, telte:kwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>Mm, ika ekintsi:n nochi, nochi ka:nachi *gente** mo..., mo..., ke..., ke:ní:w kihtowa[h], o:meyo:lohtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>tayowati nono, tikochitih nono wa:n te:chkwa:tih mo:yo:meh ka:mpa i[ka]eski,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>kihtowah *porque** xiwtah, kihtowah *porque** tika:wah ta..., tapalkat ne: kipia a:t, ompa yo:lih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>kihtowah *porque** a:mo t'pahtiah n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>Pos okwilimeh i:pa nemih, i:pa nemih wa:n te:chkwah. E:..., miak kokolismeh te:chmakah, yehwa n' okwilimeh, kihtowah *porque** tikimpiah itskwimeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>no: iwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>A:mo teh, a:mo teh kokolis, mah tiktahtakolti:ka:n a:ksá:, nochi:meh t'tahtakoltiah a:ksá:, a:ksá: kipia tahtakol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Mm. Ihkó:n ke:meh tehwa:n tikokolistih, tapialmeh no: kokolistih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>wa:n ke:man tikwah se: kokolis, *este**, se: pio</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>*o** se: tapial ika kokolis, kihtowah ke te:chpano:ltilia yo:n kiliah kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts401">
                <ANNOTATION_VALUE>*Últimamente** ye:kmiak ... A:mo kokolis ok *sino que** yo:n ne:n ke:ní:w mono:tsa piomeh kihtowah ke no: kiwa:lkwi kokolis, pio:tet de tein tikowah *tienda**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>Kitsopo:niah po..., pio ke:meh a:man wa:n a:man tata:sa n' pio</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>wa:n tikololo..., kololowah pio:temeh wa:n iwki tikwah, pio:temeh tein kita:lihkeh *vacuna** pio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>Yo:n kichi:waskiah *tres**, ke:meskia e:yi pio:temeh tein mo:stah kita:lia *hasta** tein na:witika ya yo:n kwali a pero n' e:yi ka:n kwali</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>*porque** kipia *vacuna** n' pio. Yo:n a:mo kichi:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>wa:n a:koni kikwi kokolis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>a:kin kikwa. A:konimeh kikwah?, Tehwa:n tikowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>Yo:n a:mo kina:miki, a:mo kinina:miki n' *comerc..., bueno, negociantes o de n' empresa**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>yehwa:n ina:xka, yehwa:n kinimakah nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>Tikakinih ya i:ksá: kinkwi kokolis itech se: ilwit wa:n moko..., sempa:nti sah n' piomeh, e..., piomeh tein ista:kpiomeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>yo:n no: iwki kichi:wa ata. Te:kwi:ltih kalane..., a:mo te:miktih, te:kwi:ltih kalanemi:lis, kimpasa:roh miakeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts423">
                <ANNOTATION_VALUE>Yo:n t'mattokeh no: pero n' a:kin kinamaka a:mo, a:mo, a:mo, yeh a:mo kimati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts425">
                <ANNOTATION_VALUE>i:n ka:mpa wa:le:wa, ihkó:n kimakah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts427">
                <ANNOTATION_VALUE>E.., no: miakeh timopahwia:nih ika tein tikowah tikwah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>tein wi:tsa tsaktiwi:ts, ike:span ihkwiliwtiwi:ts *hasta** ke:maniá:n sayoh kinamakaskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Neh ... i:n ke:man tehwa:n tiko:wkeh seki, seki *leche**, se: [...], pano:k a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>No: te:kwi:ltih kokolis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>wa:n tanamakanih miakeh ki..., miak *cosas** kinamakah tein se: kikwa, pano:k a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>ki..., kiliah koyo:meh *fecha de caducidad, caducado** ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>wa..., pano:k a ne:n de n' para se: kwa:skia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>Nochi yo:n te:kwi:ltih kokolis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>a:mo ke:man ... a:mo teh *más** kwali *que solamente** x..., se: xokot xikwa, se: pahpata n' a:mpó:n, chipa:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>pero nochi yo:n tein kinamakah pihpitsotik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>Kihtowah ke yo:n *queso de puerco**, yehwa ya yo:n 'kwitih pitsokokolimeh, ne: kololowah itech *granjas**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>ti..., kita:liah itech ne:n teposmeh mah kichipa:waka:n wa:n tehwa:n tikwah nochi n' kokolis wa:n ka:n t'matih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>*Por eso** ne:, a:man *últimamente**, a:man a:mo tiwehka:wah ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
