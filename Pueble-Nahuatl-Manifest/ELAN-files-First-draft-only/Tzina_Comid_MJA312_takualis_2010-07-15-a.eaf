        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>*Por eso** yehwa ya a:yo:to:chin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>A: *conejo, conejo** yo:n pos yeh se: ki..., yo:n se: ki..., no: se: kichichinowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>no: se: kichichinowa wa:n no: se: ki:xtapa:na para se: 'kwa:tsa ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>wa:n ke:meh *después** komo se: kineki pos se: kikwa no: chi:lposo:n, e:soh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>Aha, yo:n yeh ke..., wa, a:mo, no: we:lik a:ko:loh komose: kineki pero pos ke:meh, ke:meh *con forme** se: kwelitas se: kikwa:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>se: kikwa:s a:ko:loh, se: kikwas:, se: kikwa:s chi:lposo:n, nochi kwaltia, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Marto, marto no: nehjó:n, ke:mah no: tik..., no: kikwia ne:n ta:tahtsi:n *antes**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>pos yehwa yo:ni nikelna:mikia toni ito:ka:y wa:n a:mo nikelna:mik, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>*Igual** no:, no: *igual** komo t'neki chi:lposo:n *o** t'neki a:ko:loh, nochi weli</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>*o** t'neki tatsoyo:n ke:meh teh mitspa:kti:s, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Ka:n teh nikelna:miki ok tapalo:l teisá:, mahyá: nochi tipano:keh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>Pos *sesenta y dos** name:chilih, mm</ANNOTATION_VALUE>
