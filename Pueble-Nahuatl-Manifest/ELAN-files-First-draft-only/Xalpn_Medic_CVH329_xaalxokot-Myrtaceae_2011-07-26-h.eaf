        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>xa:lxokot ixiwyo n' tikwi, sayoh i:n pahti, sayoh i:n xa:lxokot ista:k *o** no: n' tein chi:chi:ltik.</ANNOTATION_VALUE>
