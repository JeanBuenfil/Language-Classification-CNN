        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts873" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>Kito:tohto:kah ya nijó:n chi:ltekpin wa:n</ANNOTATION_VALUE>
