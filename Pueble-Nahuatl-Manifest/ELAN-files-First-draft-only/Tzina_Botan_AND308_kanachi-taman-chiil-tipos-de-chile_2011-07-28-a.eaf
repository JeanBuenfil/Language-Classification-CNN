        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts900">
                <ANNOTATION_VALUE>niman kihtowah ne:n tota:tahwa:n, tote:iskaltihka:wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>kihtowah pos i:n nika:n i:n yehwa i:n chi:ltekpin i:n *matita**, i:n a:mo xkwiwitas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts904">
                <ANNOTATION_VALUE>¿Pero ke:yeh? Pos ta: ihkó:n nochi ne:n..., ke:mah, pero ta: kikwitokeh n' a:skameh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>Pero i:n i:pa ihkó:n, ta: i:n tiki:xtili:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>Pos ke:masá: kikwitih n' a:tsí:n wa:n kitsi:nte:te:kiliah n' a:tsí:n wa:n mahchi:wah seki n' okwiltsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts910">
                <ANNOTATION_VALUE>Yo:n a:skameh wa:n seki okwiltsitsí:n ihkwi:kwi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>n' ikwahkwa:pan kipia n' ik..., nika:n ikwa:ko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>Entó:s yo:n no: kima:kwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>No: kima:kwih wa:n yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts918">
                <ANNOTATION_VALUE>ke:masá: no: kima:kohkoyo:niah yo:n kiliah cha:..., chapolimeh, cha:wanimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>Cha:wanimeh yo:n hkwi:kwí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts922">
                <ANNOTATION_VALUE>achi we:wey..., *mo que** ke:masá: no: se: kita n' cha:wanimeh kima:kohkoyo:niah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts923" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>nochi kima:pisi:l..., nochi kima:tehtekih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>nika:n wa:n kwaltsi:n mote:tekpa:ntok ka:sá: se: kita,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts928">
                <ANNOTATION_VALUE>pos nima:n se: kihtowa, a: pos i:n cha:wani kima:..., kima:tehtek, kima:koto:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts930">
                <ANNOTATION_VALUE>pos nijó:n yehwa yo:n neh nikmattok ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>nijó:n *chilito** se: kito:ka yo:n a:mo, a:mo nikihto:s semi wehkatan mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts933" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>monalwayo:tia, paniá:n sah, paniá:n sah mota:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts936">
                <ANNOTATION_VALUE>Komo se: ki..., ihkó:n se: kichi:wa, ke:masá: se:, wiwiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts938">
                <ANNOTATION_VALUE>Wiwiti wa:n wetsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts939" TIME_SLOT_REF2="ts940">
                <ANNOTATION_VALUE>*Porque** nijó:n seki nikneltoka *porque** seki wehwei mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts942">
                <ANNOTATION_VALUE>Wehwei wa:n seki tsikitsitsi:n, seki tsikitsitsi:n mochi:wa *porque** tak i:pa ihkó:n ne: mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts944">
                <ANNOTATION_VALUE>wa:n seki de pe:wa ya momachtihtiw ihkwi:ntsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts945" TIME_SLOT_REF2="ts946">
                <ANNOTATION_VALUE>pe:wa momachtihtiw ya xo:chiowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts947" TIME_SLOT_REF2="ts948">
                <ANNOTATION_VALUE>Xo:chiowa ya wa:n kwaltsi:n momahma:yo:tia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts949" TIME_SLOT_REF2="ts950">
                <ANNOTATION_VALUE>Momahmayo:tia ya wa:n ompa ki:stiw ya ne:n xo:chitsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts951" TIME_SLOT_REF2="ts952">
                <ANNOTATION_VALUE>ihista:k, ompa ki:stiw ya wa:n ke:mah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts953" TIME_SLOT_REF2="ts954">
                <ANNOTATION_VALUE>de we:tsi a pos ompa ne:n ki:sa ya ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts955" TIME_SLOT_REF2="ts956">
                <ANNOTATION_VALUE>ne:n *chilito**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts957" TIME_SLOT_REF2="ts958">
                <ANNOTATION_VALUE>ihko:ni, ihkó:n tsikitsitsi:n, niman se: kita, pos nima:n se: kihto:s ne:n ti..., niman ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts959" TIME_SLOT_REF2="ts960">
                <ANNOTATION_VALUE>entó:s i:n moskalti:ti a, kwaltsi:n kwa:nehne:stok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts961" TIME_SLOT_REF2="ts962">
                <ANNOTATION_VALUE>*después** sepa se: kitati kwaltsi:n tekpa:ntok ya, kwaltsi:n seko sah yentok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts963" TIME_SLOT_REF2="ts964">
                <ANNOTATION_VALUE>Wa:n sepa pos ihkó:n nochi se: kita kwaltsi:n xohxoxoktik, kwaltsi:n kwa:ihihkak ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts965" TIME_SLOT_REF2="ts966">
                <ANNOTATION_VALUE>kwa:ihihikak ne:n *chilito**, no: *igual** ne: yo:n ohololtik, nochi, nochi kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts967" TIME_SLOT_REF2="ts968">
                <ANNOTATION_VALUE>Yo:n ohololtik pos seki kostik, kostik wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts969" TIME_SLOT_REF2="ts970">
                <ANNOTATION_VALUE>kwaltsi:n no: wa:n ke:masá: de se: koli:nia, ke:masá: x..., wetsi, xi:i:ini.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>Xi:i:ni, yo:n no: miak taman para se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts974">
                <ANNOTATION_VALUE>se: kitekis yo:ni *porque** no: semi miak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts975" TIME_SLOT_REF2="ts976">
                <ANNOTATION_VALUE>mah se: kipixtiw semi ne:n toma:ko *porque** ta:mo nijó:n se: kitamixi:i:ni:s, ta: tsi:nyehyema:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts978">
                <ANNOTATION_VALUE>Tsinyehyemanik nijó:n wa:n ta:lpan ke:masá: se: kita miak ihkó:n xi:i:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts980">
                <ANNOTATION_VALUE>Xi:i:ntok pero se: ki..., kahokwi se: kipehpena ke:meh ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts981" TIME_SLOT_REF2="ts982">
                <ANNOTATION_VALUE>wa:n se: kita:lihtiw *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts984">
                <ANNOTATION_VALUE>pos nijó:n ne..., ne:si ke:meh tikihtowa, seki xokoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts985" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>*Antes** ne:n tota:tahwa:n te:chne:xtilia:yah ke:meh i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts987" TIME_SLOT_REF2="ts988">
                <ANNOTATION_VALUE>tokalyekawitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts989" TIME_SLOT_REF2="ts990">
                <ANNOTATION_VALUE>kikwih ika ne:n yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts991" TIME_SLOT_REF2="ts992">
                <ANNOTATION_VALUE>koma:ltsí:n, yo:n de sokit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts993" TIME_SLOT_REF2="ts994">
                <ANNOTATION_VALUE>ompa kite:mayah n' tein chihchi:chi:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts995" TIME_SLOT_REF2="ts996">
                <ANNOTATION_VALUE>wa:n de n' xokok wa:n kita:liah ya ne: ne:pa ka:mpa ne:n tocha:ntsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts997" TIME_SLOT_REF2="ts998">
                <ANNOTATION_VALUE>Ompa ahko kita:liah kal..., tikiliah kalkwa:pan ihkó:n ahko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts999" TIME_SLOT_REF2="ts1000">
                <ANNOTATION_VALUE>ompa kita:lia:yah yo:n, yo:n hkwi:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1002">
                <ANNOTATION_VALUE>ke:masá: tapa:n se: *cachito** ihkó:n de koma:l, tikiliah koma:ltapalkat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts1003" TIME_SLOT_REF2="ts1004">
                <ANNOTATION_VALUE>Entó:s yo:n de sokit, ompa kite:mayah wa:n ki:xmoya:wayah ihkó:n kwaltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts1005" TIME_SLOT_REF2="ts1006">
                <ANNOTATION_VALUE>wa:n ompa ki..., kita:lia:yah kwaltsi:n ne:n nijó:n wa:kia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts1007" TIME_SLOT_REF2="ts1008">
                <ANNOTATION_VALUE>Wa:kia, ke:mah ki..., kikololowa:yah ya nijó:n de n..., de n' xohxoko:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts1009" TIME_SLOT_REF2="ts1010">
                <ANNOTATION_VALUE>Ihkó:n *antes** tehwa:n ti..., tikitayah *cuando** te:..., kichi..., kichi:wayah ne:n tota:tahwa:n ki:ní:w m' para,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts1011" TIME_SLOT_REF2="ts1012">
                <ANNOTATION_VALUE>kichikowa:yah para mah a:mo ma:wilo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts1013" TIME_SLOT_REF2="ts1014">
                <ANNOTATION_VALUE>Mah a:mo ma:wilo *porque** ika yo:n nochi ki..., ki..., kwa:tsayah nijó:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts1015" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>*chili...**, chi:ltsí:n ika ne:n koma:l, koma:ltapalkat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts1017" TIME_SLOT_REF2="ts1018">
                <ANNOTATION_VALUE>Yo:n koma:ltapalkat pos nijó:n xa: no: tiki:xmati, nochi yo:n nochi de sokitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1020">
                <ANNOTATION_VALUE>de ta:ltsí:n kichi:wah yo:n de n' ta:ltsí:n kihtowah de yo:n sasaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts1021" TIME_SLOT_REF2="ts1022">
                <ANNOTATION_VALUE>De yo:n sasaltik, nijó:n, yo:n a:mo de moloxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts1023" TIME_SLOT_REF2="ts1024">
                <ANNOTATION_VALUE>Tein moloxtik ne:n ta:ltsí:n a:mo kwaltia, ehehke:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts1025" TIME_SLOT_REF2="ts1026">
                <ANNOTATION_VALUE>Wa:n yo:n de n' tak no: i:pa kikwih ne:wí:n ahko ne:n kwa..., te:chwa:lkwiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts1027" TIME_SLOT_REF2="ts1028">
                <ANNOTATION_VALUE>nijó:n no: de n' sasaltik para a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1030">
                <ANNOTATION_VALUE>para a:mo ki..., a:mo, yeh, yeh niman ne:n tapa:ni, ihkó:n i:i:xtapal ne: mochi:wa wa:n tapa:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts1031" TIME_SLOT_REF2="ts1032">
                <ANNOTATION_VALUE>Entó:s yo:n de n' tapa:ni, komohkó:n tapa:ni tahko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1034">
                <ANNOTATION_VALUE>tahkotapa:ni pos kikwih ya, kikwih ya. Kihto:s ne:n tota:tahwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts1035" TIME_SLOT_REF2="ts1036">
                <ANNOTATION_VALUE>a: pos ne: tapa:nik ne: tokoma:l tikwitih para ne: *chilito** tikta:li:tih ahko, kaltipan, kalkwa:ko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1038">
                <ANNOTATION_VALUE>Kikwitih ya ne:n tota:tahwa:n, kikwitih ya wa:n ki..., kololowah ya nochi ne: wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts1039" TIME_SLOT_REF2="ts1040">
                <ANNOTATION_VALUE>ompa kit..., ompa kite:mah, ompa ki:xmoya:wah kwaltsi:n, kana:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1042">
                <ANNOTATION_VALUE>para nijó:n, *después** para mah kwaltsi:n wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts1043" TIME_SLOT_REF2="ts1044">
                <ANNOTATION_VALUE>De kwaltsi:n wa:ki no: *hasta** tsihtsiliktia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts1045" TIME_SLOT_REF2="ts1046">
                <ANNOTATION_VALUE>Tsihtsilaktia ya ihkó:n *porque** kwaltsi:n wa:ki, no: *hasta** kakits..., kakisti no: ne:n i..., n' iteyotsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts1047" TIME_SLOT_REF2="ts1048">
                <ANNOTATION_VALUE>No: kwaltsi:n wa:ki wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts1049" TIME_SLOT_REF2="ts1050">
                <ANNOTATION_VALUE>pos ke:wah ya ne:wí:n, ke:wah ya teihsá: ihkó:n itech se: ko:ntsí:n *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts1051" TIME_SLOT_REF2="ts1052">
                <ANNOTATION_VALUE>ihkó:n itech se: ko:ntsí:n oso ihkó:n ke:meh es..., ke:meh se: kita seki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1054">
                <ANNOTATION_VALUE>to:tomochtsí:n ki..., kipihpi:kih ya wa:n ne:wí:n kita:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts1055" TIME_SLOT_REF2="ts1056">
                <ANNOTATION_VALUE>Kita:liah ne:wí:n para mah ompa e:wto ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts1057" TIME_SLOT_REF2="ts1058">
                <ANNOTATION_VALUE>Kihtowa pos ke:masá: ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts1059" TIME_SLOT_REF2="ts1060">
                <ANNOTATION_VALUE>de i:n tikwa:skeh seki ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a564" TIME_SLOT_REF1="ts1061" TIME_SLOT_REF2="ts1062">
                <ANNOTATION_VALUE>chi:lta:tix oso ke:meh i:n tikma:nelowili:skeh wa:n tikwa:skeh *o** tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts1063" TIME_SLOT_REF2="ts1064">
                <ANNOTATION_VALUE>tike:waskeh, ke:masá: ne:n tota:tahwa:n seki kikwe:chowa:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts1065" TIME_SLOT_REF2="ts1066">
                <ANNOTATION_VALUE>nijo:n kimo:ltayah ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts1067" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>ke:masá: ihkó:n tikta:lilia:yah istatsí:n wa:n ke:masá: ihkó:n tikwiah nijó:n ihkó:n ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1070">
                <ANNOTATION_VALUE>takwe:chol sah, takwe:chol sah, a:mo, a:mo kipiaya, a:mo kita:lilia:yah a:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts1071" TIME_SLOT_REF2="ts1072">
                <ANNOTATION_VALUE>Ihkó:n sayoh kita:lilia:yah istatsí:n *porque** yo:n istatsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts1073" TIME_SLOT_REF2="ts1074">
                <ANNOTATION_VALUE>neh ne: ke:man nikitak nota:tahwa:n, nijó:n, onkaya yo:n ohololtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts1075" TIME_SLOT_REF2="ts1076">
                <ANNOTATION_VALUE>ololtikistat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts1077" TIME_SLOT_REF2="ts1078">
                <ANNOTATION_VALUE>Entó:s kita:lilia:yah *mismo** yeh kim..., kit..., kima:nelowa:yah ihkó:n wa:n kimo:ltayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts1079" TIME_SLOT_REF2="ts1080">
                <ANNOTATION_VALUE>Kimo:ltayah, *mismo** yeh kitehtekia ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1082">
                <ANNOTATION_VALUE>ne:n *chilito**, entó:s ihsiwka ne:n kohkoto:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts1083" TIME_SLOT_REF2="ts1084">
                <ANNOTATION_VALUE>Kohkoto:nia ya wa:n mochi:wani..., mochi:waya tamomox.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts1085" TIME_SLOT_REF2="ts1086">
                <ANNOTATION_VALUE>mochi:waya tamomox, yehwa yo:n ihkó:n ti..., tikwa:yah, ke:masá: tikwiah ika totaxkaltsi:n, tikchi:wayah ihkwi:ni, ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts1087" TIME_SLOT_REF2="ts1088">
                <ANNOTATION_VALUE>Tikpalowa:yah n' taxkaltsí:n, tiko:tonayah wa:n tikwiah tsikitsi:n wa:n tiki:xohxilia:yah totaxkaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1090">
                <ANNOTATION_VALUE>Tiktetsi:lowa:yah, ke:mah tik..., tikwahtokeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts1091" TIME_SLOT_REF2="ts1092">
                <ANNOTATION_VALUE>Ihkó:n ne:n tik..., wehka:w ihkó:n tehwa:n te:chne:xtilia:yah ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
                <ANNOTATION_VALUE>te:iskaltihka:wa:n, tota:tahwa:n para</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1096">
                <ANNOTATION_VALUE>nijo:n ihkó:n ti..., tehwa:n ti:xpeton..., ti:xpeta:nkeh para nijó:n te:chtekipanohkeh para no: timoskaltihkeh. Tehwa:n no: *siempre** tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts1097" TIME_SLOT_REF2="ts1098">
                <ANNOTATION_VALUE>nika:n i:n tinemiah nika:n kowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts1099" TIME_SLOT_REF2="ts1100">
                <ANNOTATION_VALUE>pos no: miak tik..., tikihyo:wihkeh wa:n no: kihyo:wihkeh n' tota:tahwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts1101" TIME_SLOT_REF2="ts1102">
                <ANNOTATION_VALUE>para kinín n' ti..., timoskaltihkeh, kiní:n ti:xpeta:nkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts1103" TIME_SLOT_REF2="ts1104">
                <ANNOTATION_VALUE>para kintsi:n nika:n ay ti..., tinentinemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts1105" TIME_SLOT_REF2="ts1106">
                <ANNOTATION_VALUE>Nika:n tietokeh itech nijí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts1107" TIME_SLOT_REF2="ts1108">
                <ANNOTATION_VALUE>kaltsí:n, kalye:kawiltsi:n wa:n nika:n timonohno:tstokeh ke:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts1109" TIME_SLOT_REF2="ts1110">
                <ANNOTATION_VALUE>pos yo:n ke:masá: ihkó:n nante:chyo:le:wtiwi:tseh pos nika:n ti..., tiwi:tseh pané:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts1111" TIME_SLOT_REF2="ts1112">
                <ANNOTATION_VALUE>pané: kwaltsi:n nijó:n, ke:masá: kwaltsi:n timonohno:tsah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts1113" TIME_SLOT_REF2="ts1114">
                <ANNOTATION_VALUE>wa:n kwaltsi:n timota:kamatih, nió:n no: eliwis ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts1115" TIME_SLOT_REF2="ts1116">
                <ANNOTATION_VALUE>timopa:panawiah ta:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts1117" TIME_SLOT_REF2="ts1118">
                <ANNOTATION_VALUE>pos neh no: nikwelita ke:meh i:n timonohno:tsah pos nochi timo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts1119" TIME_SLOT_REF2="ts1120">
                <ANNOTATION_VALUE>timoliah kiní:w n' ti:xpano:keh, kiní:w n' te:chi:xpeta:nihkeh tota:tahwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts1121" TIME_SLOT_REF2="ts1122">
                <ANNOTATION_VALUE>N' ekintsi:n tisehse:meh pos ki:ní:w n' timoskaltihkeh nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts1123" TIME_SLOT_REF2="ts1124">
                <ANNOTATION_VALUE>kiní:w n' tikihyo:wihkeh, pos nijó:n kwaltsi:n nochi ti..., timotapowihtokeh wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts1125" TIME_SLOT_REF2="ts1126">
                <ANNOTATION_VALUE>pos teh, yehwa sah neh de nikmattok, no: kiní:n, teh xa:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts1127" TIME_SLOT_REF2="ts1128">
                <ANNOTATION_VALUE>xa: kachi tikmati ne:n kiní:n nochi de i:n chi:ltekpin,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts1129" TIME_SLOT_REF2="ts1131">
                <ANNOTATION_VALUE>kiní:n moskaltia, *qué tanto** we:i, pos nochi tine:chilih ya pero se: taman xa:, xa: tikmattos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609" TIME_SLOT_REF1="ts1152" TIME_SLOT_REF2="ts1155">
                <ANNOTATION_VALUE>Yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610" TIME_SLOT_REF1="ts1156" TIME_SLOT_REF2="ts1157">
                <ANNOTATION_VALUE>Pos nehwa nijó:n nimono:tsa Anastacio  Nicolás Damián.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts1158" TIME_SLOT_REF2="ts1160">
                <ANNOTATION_VALUE>Nehwa niwi:tsa de nika:n mono:tsa xola:lpan, mono:tsa San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a613" TIME_SLOT_REF1="ts1162" TIME_SLOT_REF2="ts1165">
                <ANNOTATION_VALUE>De ompa niwi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a614" TIME_SLOT_REF1="ts1166" TIME_SLOT_REF2="ts1167">
                <ANNOTATION_VALUE>A:, Xaltipan. A:, *bueno**. Tasoh..., tasohka:matik tine:chilih kení:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts1168" TIME_SLOT_REF2="ts1170">
                <ANNOTATION_VALUE>moto:ka:y, *igual** neh nimitstapowih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
