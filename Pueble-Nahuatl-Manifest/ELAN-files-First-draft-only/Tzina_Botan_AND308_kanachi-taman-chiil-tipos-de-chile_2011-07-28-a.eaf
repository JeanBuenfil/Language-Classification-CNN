        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>no: miak n' chi:l..., chi:ltekpiwa:k n' tiki:xtia:yah. Wa:n tak sepa kinamakaya nowe:iná:n wa:n tehwa:n neli ke:meh tikihto:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>tikihto:waya ye:wa, ne: tehwa:n no: tikwa:yah, *que** chi:ltamo:ltal, tikpa:tilia:yah emo:ltsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts688">
