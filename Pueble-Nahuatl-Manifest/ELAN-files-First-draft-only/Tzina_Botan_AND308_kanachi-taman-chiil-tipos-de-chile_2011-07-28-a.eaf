            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>oso et. Miak ihkó:n tiki:xmoya:wayah,</ANNOTATION_VALUE>
