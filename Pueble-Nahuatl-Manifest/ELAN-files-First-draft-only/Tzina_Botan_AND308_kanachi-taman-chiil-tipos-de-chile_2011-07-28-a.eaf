                <ANNOTATION_VALUE>tiko:tenoh mah po:kyo:wa wa:n ompa po:kyowaya, po:kwa:kia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts723">
