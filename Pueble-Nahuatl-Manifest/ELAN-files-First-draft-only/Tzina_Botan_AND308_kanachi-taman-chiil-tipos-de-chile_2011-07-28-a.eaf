            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts872">
                <ANNOTATION_VALUE>Pero kintsi:n ka:sá: ika nijó:n tikitah ki..., kitohto:kah ya.</ANNOTATION_VALUE>
