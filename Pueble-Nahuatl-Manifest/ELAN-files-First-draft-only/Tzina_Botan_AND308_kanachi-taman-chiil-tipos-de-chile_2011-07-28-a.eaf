            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>ne: kwesala:n timokowili:tih ke:man tikele:wiah komohkó:n, yo:n no: taman ahwia:k.</ANNOTATION_VALUE>
