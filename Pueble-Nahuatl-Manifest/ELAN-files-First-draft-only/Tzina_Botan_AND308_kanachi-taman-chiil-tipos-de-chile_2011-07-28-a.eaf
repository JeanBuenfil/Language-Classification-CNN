        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>Wa:n i:n chi:ltekpin i:n mochi:waya sah ne: wehka:w, a:mo a:kin kito:kaya, tak ke:meh kikwa:yah n' chiktehmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>kimoya:wayah n' iteyo wa:n ka:mpa weli tikitas ihkó:n ihkatok se: chi:ltekpinkone:t wa:n ompa sayoh se: kitachipa:wia wa:n ta:kia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Ne:, wa:n tak neli yo:n, neh nikelna:miktok ne: ka:mpa nowe:iná:n te:chwi:kayah tio:nchi:ltekiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts636">
