        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>pero yehwa yo:n chiktehtsi:n kwi:ka, kimoya:wayah, ixwa sah.</ANNOTATION_VALUE>
