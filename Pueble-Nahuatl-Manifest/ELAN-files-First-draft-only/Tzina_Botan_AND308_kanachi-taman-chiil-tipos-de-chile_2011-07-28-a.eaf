                <ANNOTATION_VALUE>i:n aya:mo semi wehka:w, a:mo se: kimati ka:ni wa:le:w seki mahyá:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts737">
                <ANNOTATION_VALUE>ihkwitik ke:meh yo:n chil *de cera** tein ne: Zacapoaxtla kinamakah, sayoh *que** no: pisi:ltik, no: chi:ltekpin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts738" TIME_SLOT_REF2="ts739">
                <ANNOTATION_VALUE>Yeh xohxoxoktik ne:, mahyá: a:mo se..., a:mo xohxoxoktik, mahyá: aha:kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>Mahyá:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts746">
                <ANNOTATION_VALUE>xox...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts750">
                <ANNOTATION_VALUE>No: ihkwitik a, sayoh *que** ne: ohololtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>Ke:mah, yo:n tein teh tikihtowa no: aya:mo semi wehka:w, a:t ka:ni wa:le:w yo:n xina:ch,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts757" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>no: ihkwitik a n' itapal, ke:meh yo:n, mahyá: xoxoktik, pero a:chi:petik mahyá: tepitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts762" TIME_SLOT_REF2="ts763">
                <ANNOTATION_VALUE>Ke:mah, wa:n no: we:weyak, ke:meh eskia yo:n chi:ltekpin tein ne: wehka:w i:pa t'piah we:weyak, sayoh *que** achi tohtoma:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>Se: tepilitsi:n achi wehwei, ekintsi:n no: mochi:wa ne:, ne: tanikwa:kopa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts767">
                <ANNOTATION_VALUE>wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts768" TIME_SLOT_REF2="ts769">
                <ANNOTATION_VALUE>yo:n telsenka ya n' koko:k, ika se:tsi:n mitsahsi a ne:n titakwa:s, a:mo tikihto:s timo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts770" TIME_SLOT_REF2="ts771">
                <ANNOTATION_VALUE>tikpa:tili:s moemo:l sake:ra e:yi, ta: ika se: sah, telsenka ya n' kohkoko:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts772" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>Wa:n yehwa no: ke:meh yo:n itapal onkak seki nimitsilia ohololtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>wa:n no: telkoko:k. Wa:n oksi no: chihchi:chi:ltik, telsenka ya, ne: tani semi mo..., ka:sá: ika, a:mo no:ya:n, mocha:nmatik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>Mocha:matik a ompa ne:n, ekintsi:n neli no: mochi:wa ya wa:n miak tokni:wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>a:t ke:yeh tak ne:n yehwa yo:n chi:ltekpin, ke:meh ekintsi:n miak tokni:wa:n kipahwiah ne:n xiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts785">
                <ANNOTATION_VALUE>no:, n' ehekat kiwi:ka ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts786" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>ka:mpa yo:n tapahwihtokeh pos ke:meh i:n taehekatok kiwi:ka wehka ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts789" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>n' itsohya:kyo yehwa yo:n pahti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>kipi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts798" TIME_SLOT_REF2="ts799">
                <ANNOTATION_VALUE>Ke:mah. Entó..., entó:s mahyá: ne: tsihtsimoltia ne:n chi:ltekpinkowkone:t, ompa ma:tsihtsimoltia, a:mo xo:chiowa ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts802">
                <ANNOTATION_VALUE>ompa iwki tsitsimoltia. kwali ompa ihkatos pero a:mo xo:chiowa ke:meh moneki wa:n a:mo ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts806" TIME_SLOT_REF2="ts807">
                <ANNOTATION_VALUE>Mahyá: wa:ki a, wa:n yehwa yo:n chi:l nimitsilia, tein ohololtik mahyá: wa:n seki mahyá: i:xtapalwe:weyak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts809">
                <ANNOTATION_VALUE>ka:n w..., ka:n, mahyá: ka:n kimachilia yehwa yo:n pahti ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts810" TIME_SLOT_REF2="ts811">
                <ANNOTATION_VALUE>ki..., kite:tekah ka:sá:, n' ta: tehwa:n a:mo tikpahwiah xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts814">
                <ANNOTATION_VALUE>Ne:, pero ma:ski seki:n wehka n' tapahwiah i:pa kimachilia n' okseki ne:n okseki tato:k n' tein ma:ski wehka ya etok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>Kwi:ka n' ehekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>Tak eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>Meh..., Ajá, ihkó:n neli. Neli neh nikita wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>pos yo:n chi:l ekintsi:n no: monamaka ya, ekintsi:n no: tikitas ne: kwesala:n kite:temah n' tokni:wa:n wa:n nimitsilia neli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts838" TIME_SLOT_REF2="ts840">
                <ANNOTATION_VALUE>neli n' kohkoko:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts844" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>Kohkoko:k. Ne:, pos neh yehwa sah de i:n ne:n nimitsilia ne:n nochi n' tein ta:taman chi:l tein neh niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>A:, *bueno**. Pos neli ekintsi:n a:mo, a:mo a:kin semi kiwe:ito:ka ok, onkak ta:tahmeh nimitsilia kito:kah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts848" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>onkak ta:tahmeh *que** kito:kah, pero ekintsi:n tehwa:n nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>pos neh a:mo, neh ne: wehka:w nikelna:miktok nió:n chi:ltekia, pero ekintsi:n a:mo no: nikto:ka wa:n nió:n, nió:n no: nikteki, n' ta: i:ksá: no: nimokowilia ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>i:ksá:. Wa:n i:ksá: a:mo no: ne:chta:kamati, nikto:ktok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>ka:n o:me, pero ka:n no: ne:chahsi ta: neli se: kikwa n' *chilito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>Telsenka ya se: kikwa nikilia wa:n entó:s ika se: kowtsí:n a:mo te:ahsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts1132" TIME_SLOT_REF2="ts1133">
                <ANNOTATION_VALUE>Kanah, no: yehwa sah n' tein nimitstapowih i:pa yehwa sah, ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts1134" TIME_SLOT_REF2="ts1135">
                <ANNOTATION_VALUE>ka:n teh, ka:n teh semi nikmati ok, ka:n, pané: i:pa yehwa sah ta:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts1136" TIME_SLOT_REF2="ts1137">
                <ANNOTATION_VALUE>nimitsilia *que** a..., a:xka:n nohma ne:, pos se: kitstiw ok i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts1138" TIME_SLOT_REF2="ts1139">
                <ANNOTATION_VALUE>i:n chi:l ma:ski a:mo semi miak ok onkak pero ata onkak ok tatsa:la:n, ka:sá: ika ka:mpa yo:n tai:xtapowah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts1140" TIME_SLOT_REF2="ts1141">
                <ANNOTATION_VALUE>i:n tak chiktehtsí:n ompa kwi:ka n' iteyotsi:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts1142" TIME_SLOT_REF2="ts1143">
                <ANNOTATION_VALUE>wa:n i:n chi:lwehwei pos nohma ki..., onkak, ka:n miakeh ok, tatsa:la:n ya sah, se: o:me, e:yi tokni:wa:n kito:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts1144" TIME_SLOT_REF2="ts1145">
                <ANNOTATION_VALUE>Kito:kah ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a606" TIME_SLOT_REF1="ts1146" TIME_SLOT_REF2="ts1147">
                <ANNOTATION_VALUE>wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts1148" TIME_SLOT_REF2="ts1150">
                <ANNOTATION_VALUE>pos yehwa:n ya n' te:chnamaki:ltiah i:ksá: ke:man a:mo tik..., ke:meh tehwa:n a:mo tikto:kah, yehwa:n ya n' te:chnamaki:ltiah nimitsilia, pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a608" TIME_SLOT_REF1="ts1151" TIME_SLOT_REF2="ts1154">
                <ANNOTATION_VALUE>ne: pos i:pa yehwa sah. Ne:, pos a:xka:n ne:chilwi ne: moto:ka:y wa:n ka:ni n'tiwi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612" TIME_SLOT_REF1="ts1161" TIME_SLOT_REF2="ts1164">
                <ANNOTATION_VALUE>Pos neh noto..., neh noto:ka:y ne: Amelia Domínguez, nikayo:t ne: Xaltipan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
