                <ANNOTATION_VALUE>A:mo n'mati ox ke:ní:w n' teh tikto:ka:ytia, ekintsi:n tne:chtapowi:s no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>Wa:n no: i:ksá:, yo:n chi:lwehwei nika:wí:n a:mo semi kita:ki:ltiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts398">
