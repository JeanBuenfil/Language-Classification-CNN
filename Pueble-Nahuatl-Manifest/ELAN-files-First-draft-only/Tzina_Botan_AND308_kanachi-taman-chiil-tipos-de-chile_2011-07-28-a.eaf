        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>tak kwaltsi:n kime:wayah, *porque** nikelna:miktok wehka ihkó:n katka ne:n</ANNOTATION_VALUE>
