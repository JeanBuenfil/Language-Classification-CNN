        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Pero no: mochi:wa nika:wí:n, sayoh mah se: kito:ka we:wehkatika:, no: mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Wa:n i:ksá: nejó:n nikelna:miktok ne:n no:má:n kita:ki:ltia:ya wa:n teloksia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>wa:n kita:nia, n' ta: i:ksá: tikwa:yah chi:la:yo:t wa:n i:ksá: a:ksá: t'wa:ntiah.</ANNOTATION_VALUE>
