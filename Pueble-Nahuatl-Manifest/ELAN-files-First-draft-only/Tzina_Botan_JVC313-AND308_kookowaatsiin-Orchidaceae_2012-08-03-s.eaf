        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>Ke:mah, ko:kowa:tsi:n niki:xmattok, yo:n a:mo teyowa, ne: niki:xmattok ke:ní:w, ne: poso:ni *cuando, cuando** kepotsi:n mo..., ki:sa itech i..., ikamohtsa:la:n ne:, ka:n ima:tsa:la:n yo:n itaktsoyo</ANNOTATION_VALUE>
