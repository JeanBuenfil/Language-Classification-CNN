                <ANNOTATION_VALUE>ke:mah, yo:n a:mo, a:mo teh kikwih para pahti, soh kwelitah porin ahwia:k, yehwa sah yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
