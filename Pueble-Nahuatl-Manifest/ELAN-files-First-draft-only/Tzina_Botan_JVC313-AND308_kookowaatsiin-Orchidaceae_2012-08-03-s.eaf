                <ANNOTATION_VALUE>wa:n nehjó:n i...,ikamohyo ko:kowa:tsi:n pahpatachtik sah ne:n, ne:n kowtet, de n' kamohtsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>wa:n nehjó:n i..., itech, itech ikwa:payo ya ne:n kamohtsi:n</ANNOTATION_VALUE>
