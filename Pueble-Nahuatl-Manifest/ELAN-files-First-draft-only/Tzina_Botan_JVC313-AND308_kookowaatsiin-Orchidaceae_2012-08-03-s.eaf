        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>ompa ki:sa ya ima:xiwyo mochi:wa. Wa:n nehjó:n ... Wa:n xo:chit yeh mopampilowa yeh, de yo:li mopampilowa ne:n xo:chitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>pihpi:ktiw, pihpi:ktiw pero yeh *hasta** mo..., mota..., motami a yo:n, yo:n i..., itsi:nkowyo ne:n xo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>ke:mah pe:wa ki:sa ya ne:n imaxaltsitsi:n pero cada xo:chit, se: imaxaltsi:n *cada** xo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>Mopihpilowa kie:ra ka:n chikna:wi *o** chikwe:i xo:chitsí:n moka:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>tein tayo:la:n mochi:wa xo:chit okachi tsikitsi:n ya sah, a:mo we:i wa:n seki, seki iyo:la:n ya tein, tein ta..., tayo:lpayo:t a, a:mo mochi:waok, pitsaktika sah xo:chitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
