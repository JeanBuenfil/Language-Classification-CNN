        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>*Bueno**, pos ta:tah ekintsi:n kwali 'te:chtapowi:s de tein teh tikmattok n' tahpe:wal. ¿Toni yo:n tahpe:wal?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>Wa:n i:n tahpe:wal se: kichi:waya, ¿ton kowyo ne:n kwali se: kikwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Wa:n ne:n okseki tein tikwi, ke:meh yo:n *corral**, ton kow..., ton kowyo tikwi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>¿Wa:n mi:nkat, ton kowyo se: kikwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>Wa:n tet, ¿katí:n tet ne: kwaltia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>¿Komo a:mo se: kita:lilia itakwal, a:mo motokia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>Tikihtowa komohkó:n kita n' *corral, este**, a:mo motokia. ¿Entó:s i:n *corral** ke:meh eskia tikta:tia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>¿Toni kipahtia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>Ye:wa 'te:chtapowia:ya ika a:mo kwali ne:..., mah se: ki..., kika:wa eliwis i:n kowtahnakat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>tein se: kikwi ika i:n tahpe:wal. ¿A:koni n' teh mitstapowia:ya yo:n ... *O** i:pa tikmattok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>¿Wa:n ekintsi:n *como siempre** kichihchi:wah n' tokni:wa:n ne: i:n kowtahpe:waloso kelka:wtiwih ya?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>¿Wa:n teh tikine:xtilia ke:meh i:n a:man pi:pil mah kichihchi:waka:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts700" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>Taká:n tikpia *este** teihsá: *más** ok tein tite:chtapowi:s de i:n kowtahokwilimeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts734">
                <ANNOTATION_VALUE>¿Tikmattok ke:ní:w ne:n kinchihchi:wah i:n tein we:lkeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>¿Tiki:xmattok se: okwilin kiliah *marto**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>*Este**, ta:ká:n *este**, tiki:xmattos oksé:, oksé: okwilin, ¿nochi a n' okwilimeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>Wa:n okseki okwilimeh, ¿tikmattok toni ika ne: motekipanowah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts948" TIME_SLOT_REF2="ts950">
                <ANNOTATION_VALUE>Ma:pachin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts992" TIME_SLOT_REF2="ts994">
                <ANNOTATION_VALUE>Wa:n takwatsi:n yeh toni n' kikwa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts1008" TIME_SLOT_REF2="ts1009">
                <ANNOTATION_VALUE>Ye:wa tikihtowa:ya *este**, o:me taman ne:n takwatsitsi:n. Se: takwatsi:n wa:n se: ne: tikihtowa:ya *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1012">
                <ANNOTATION_VALUE>e..., nikelka:w ke:ní:w ne:n tiko:nto:ka:ytih, ¿ke:ní:w se: kini:xmati?,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts1026" TIME_SLOT_REF2="ts1028">
                <ANNOTATION_VALUE>Wa:n pe:sohmeh, ¿no: miak tamameh *o** i:pa se: taman sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1046">
                <ANNOTATION_VALUE>Okseki okwilimeh tein tikini:xmattos, ¿i:pa yehwa:n sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts1072" TIME_SLOT_REF2="ts1074">
                <ANNOTATION_VALUE>Wa:n yo:n a:mowe:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts1090" TIME_SLOT_REF2="ts1092">
                <ANNOTATION_VALUE>*Pues, este**, ¿a:mo tikelna:miki ok teihsá: *más de** okwilimeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a757" TIME_SLOT_REF1="ts1476" TIME_SLOT_REF2="ts1478">
                <ANNOTATION_VALUE>¿Xa: tikpias teihsá: ok para ne:n 'te:chili:s de ne:n okwilimeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762" TIME_SLOT_REF1="ts1488" TIME_SLOT_REF2="ts1490">
                <ANNOTATION_VALUE>*Bueno pues** komohkó:n nochi a, kwali 'te:chili:s moto:ka:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766" TIME_SLOT_REF1="ts1498" TIME_SLOT_REF2="ts1501">
                <ANNOTATION_VALUE>*Bueno**, pos tasohka:matik miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
