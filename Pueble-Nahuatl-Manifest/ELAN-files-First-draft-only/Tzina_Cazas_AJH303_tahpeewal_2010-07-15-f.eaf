            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a771" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>{hubiera dicho 'ie:wayo'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a772" TIME_SLOT_REF1="ts1056" TIME_SLOT_REF2="ts1059">
                <ANNOTATION_VALUE>{Aquí el narrador está hablando del tejón grande que anda solo cuando tendría que hablar del mapache, pues anteriormente menciona que los mapaches, al igual que los tejones, también se dividen en dos grupos: grandes y pequeños.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a773" TIME_SLOT_REF1="ts1060" TIME_SLOT_REF2="ts1063">
                <ANNOTATION_VALUE>{En esta frase el narrador parece que quiere corregir su error al confundir el mapache con el tejón, puesto que enfatiza que no sabe cómo se llama, pero que sus hijos sí lo saben. Esto indica que se está refiriendo al mapache grande}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a774" TIME_SLOT_REF1="ts1170" TIME_SLOT_REF2="ts1173">
                <ANNOTATION_VALUE>{La vocal a, no es larga, pero aquí el narrador alarga tal vez como una consecuencia de la emoción }</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775" TIME_SLOT_REF1="ts1438" TIME_SLOT_REF2="ts1441">
                <ANNOTATION_VALUE>{Se escucha xixilimeh o xihxilimeh. Pero Amelia Domínguez comentó que la reduplicación no se usa para pluralizar. Así o es un titubeo o bien el habla de Andrés representa una forma antigua cuando la reduplicación si indicaba plural}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776" TIME_SLOT_REF1="ts1458" TIME_SLOT_REF2="ts1461">
                <ANNOTATION_VALUE>{En lugar de 'por' probablemente hubiera dicho 'para'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="SectionType" TIER_ID="Sections">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a0" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts1500">
                <ANNOTATION_VALUE>report</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Andrés Martín Juárez Hernández" TIER_ID="Andrés Martín Juárez Hernández">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>*Bueno, este** sepa name:chtapowi:ti ekintsi:n i:n *rato este** de n' tahpe:wal, de n' okwilimeh. Ne: ke:man ke:ní:w tikin..., tikinkwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>Pero, [y]ekinika,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>se: nemiti ka:ni nojó:n se: kahsis para se: kinchihchi:wili:s ka:mpa mo..., motsakwili:skeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>wa:n de se: kitati ka:ni nojó:n *este**, ka:ni motsakwili:skeh, pos se: monemilia:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>- *Mejor** nikchihchi:wati n' *trampa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>- Xa: nikwis se: n' okwilin ompa ne: ka:mpa panowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>Ka:mpa kipiah no: inoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>de ompa, pos komo se: ise:lti, pos se: ise:lti se: yowi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>komo a:mo se: o:m..., se: o:men.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Pero ompa ne: se: ahsi wa:n se: kita kwali ka:mpa panowah kwali wa:n ka:mpa tepe:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>kowtah, owihka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Ka:sá: wehkapan tepehxikwa:ko *o** ka:sá: a:mo pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>semi, semi te:mach ka:mpa yo:n se: tachihchi:wa *porque** owihka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Yekinika se:, se: ta:li:xmela:wa o:me *metro** de wehka para kwali motali:s ne:n tikilwiah kowtapech.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>O:mpa se: kinte:mowa nojó:n kowtapechmeh, o:me, *parejos, como de cuatro pulgadas** de toma:wkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>[K]e:mah, tein mela:wkeh nojó:n komeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>De ompa se: *kimpareja:rowa** nojó:n, se: kite:mowa ya n' komekat tein ika se: kilpi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>[K]e:mah, e:xka:n se: kilpia, *parejitos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Komo se: o:me:n pos se: mopale:wia, se: *kasentarowa** ka:mpa ne:n kipias ne:n i...,*ilugar** ka:mpa kwali</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>moka:was *cuando** wetsis. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Entó:s de se: kita:lilia nojó:n kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>pos komo se: o:men se: mi:xpantilia ya: - ¿Tiktekitih teh n' *corral** seki *o** seki neh niktekiti?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>- Ti[owi]h t'te:mo:tih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Pero a:mo ompa se: kitekis *cerca** ka:mpa se: tachihchi:was,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>se: kikwiti:w wehka *porque** ompa a:mo wel *más** se: tate:xi:ma *porque** pos tapaya:ntia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Entó:s se: kite:mowa nojó:n *corral**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Ekin..., ne:n achto,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>tein ka:mpa mero mo..., mokwis ne:n lugar de ka:mpa kowtapech.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Tein mehmela:wkeh, sake:ra, sake:ra, tikiliah tahko *ciento**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n ekinika se: ki..., se: kite:mo:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Se: kichihchi:was a yo:n wa:n ne:n kowtapech yetos *ilugar** ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>se: kitohto:kas a nojó:n *corral** moitstos *como de a pulgada** de we:wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>*Parejito** tein mehmela:wak, kampa *mero lu...**, ne:n *lugar** ne: ka:mpa mokwis n' okwilin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>De ompa nojó:n se: ki..., se: kito:ka nochi tai:xpampa wa:n tai:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Se: ki..., kinto:ka *este,** o:me kalikximeh, o:me kalikximeh no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>de *a vara** de wehkapan, de *a vara** de wehkapan, kipia *orquetitas**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>wa:n se: kinteki o:me kilwiah *manos**. No: kwomeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>wa:n de yo:n kwomeh se: kinteki yo:n o:me, *manos**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>se: kite:mowa *este**, n...,kwomekat para tikilwiah tikwiskeh *este**, ima:y no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>para ka:mpa t'te:mpilo:skeh ya ne:n tikiliah mi:nka:t, mi:nka:t n' ito:ka:y. Se: kowtsí:n se: kixihxi:ma</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>ka:mpa *mero trampa** ya. [K]emah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>De ompa nojó:n, tika:wah iwki a k..., nojó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>tikta:liah ke:meh *imedido[a]** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>De ompa ke:mah tik..., tikte:mowah ya ne:n okseki *corral**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Oksé: kite:mo:s okseki *corral** wa:n oksé: kite:mo:s tet</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>tein kima:ma:s ne:n kowtapech para</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>i:xtayowas ne:n okwiltsí:n tein mokalaki:ti:w tatampa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>[K]e:mah, kisenti:li:s nojó:n tet, sake:ra *diez**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>*Según** de wehwei, *diez o veinte**. Yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>De ompa ne:n *corral** se: kichi:wtos a ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>na:w..., na:wka:n, na:wka:n *partes**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>parahko wa:n paratani. Komo wehka tatsakwas pos wehka wa:n komo *cerca** pos *cerca**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>Pero yo:n owih *porque mote:mohtani yehwa n' *corral**, mote:mohtani tai:xwi:pa:nka:yo:t wa:n kwomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Entó:s tiksentiliah nojó:n, tikte:mowah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>wa:n *pues** tikihtowah ahsis a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Tikchi:wah ya ka:mpa *mero** ne: mokwi n' okwilin, tikihilpiah, ompa kwi:ka o:me tai:xwi:pa:nka:yo:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>tein mehmelaktsitsí:n. O:me *metro** de wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>Ompa no: taman se: kilpia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Ompa se: *parte** tani soh se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>*como de** se: *vara**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>wa:n a:hko se: ki:sa, senki:stok, de o:me *metro**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>Pero ompa se: kilpia *este**, tikiliah *este**, nep..., nepaniwtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>nepaniwtok o:pochkopa wa:n ye:kma:kopa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>para kwali moka:wa *porque** para a:mo wehweliwis *porque cuando** wetsine:n kowtapech,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>ika *fuerza** wa:n okwilin tahmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Para a:mo, para a:mo wehweliwis pos moneki mah kwali ilpito.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>wa:n ompa yo:n kwo..., mokwi kwomekat tein ito:ka:y tata:wikkwomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>A:mo okseki kwomekat para a:mo wehweliwi niman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Wa:n *después** tikitah ya ox kwali tawetsis. *Tikarreglarowa** nojó:n ka:mpa *mero**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>tikiliah *centro**, ka:mpa *mero** taihtik, kalihtikkopa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Timopale:wiah. Komo timopale:wiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>tiktamachi:wah ya ne:n ima:y ne:n *manos**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>ox i..., ox ahsis a ne:n *lugar** ka:mpa yetos mi:nkat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>Pero ka:mpa mi:nka:t t'te:mowah se: kowtsí:n ihkwi:ntsi:n *como de cuarenta**, tikpatachxihxi:mah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Se: *lado** tila:wak, se: *lado** a:mo, ke:ptok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>[y]o:n mi:nka:t tik..., tiktekiskeh *como de tres pulgadas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>De ompa se: kita:lia ihkwí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>wa:n se: 'kalakia kalihtikpa [y]o:n mi:nka:t wa:n tatampa yowi a n' oksé: tikiliah *puente**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>*Puente** nojó:n kowtsí:n, tikiliah *puente**. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>Pero tikte:mo:skeh *este**, sake:ra *treinta o veinte** kowtsitsí:n, *varitas** tsikitsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>para n' ka:mpa m' *puente** ehekai:xko etos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Tikta:liah paniá:n, sake:ra oho:me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Paniá:n de nojó:n *puente** moka:was tepitsi:n wehkapan *como de tres pulgadas** no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>*Tres pulgadas** ehekama:pan etos wa:n tai:xpa:n ya:s nojó:n kowtsitsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>wa:n de ompa nojó:n kowtsitsí:n ya:s tai:xko, tikta:li:skeh tapech, se..., seki xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Komo tikahsi yo:n nojó:n ito:ka:y tekxo:chima:it pos yehwa t'ta:li:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>[Sa]ke:ra na:wi, para ompa ne: ehkos ne:n okwiltsí:n ompa moka:wa. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>*Después** nojó:n tikitah komo kwali a *pues**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>*que** yetok a nojó:n *mero** ka:mpa n' *lugar**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>pos tikchihchi:wtiwetsih a ne:n na:wka:n. Tikilpiah ompa ke:meh weli a wa:n oksé: *lado** no: wa:n oksé: *lado** no:.Komo, komo tima:tankeh sen to:nal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>kwali wa:n komo a:mo, o:me to:nal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Owih *porque** name:chilia semi te:mach, ka:sá: ika sayoh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>*cuatro metros o tres metros** de tate:mpan wa:n tani pos ehekama:pan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Komo se: pawetsik ompa se: moka:was. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>Entó:s tik..., tikchi:wah ya nochi yo:n, mo:stika tima:tamih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>Tika:wah ya yo:n, ke:mah tiki:itatih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>Mo:stah, kwa:lka:n, mo:stah kwalka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>mo:stah kwa:lka:n. A:mo ke:man se: moka:was *de que** a:mo tikitati:w *porque cuando** mokwis ne:n okwilin pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>komo a:mo tikitato ompa moa:wilchi:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Wa:n [komo]ma:wilchi:wa pos no: n' tein ia:xkawa:n no: tayo:koyas *porque** yeh no: kimattok kinka:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Wa:n i..., nojó:n tikchi:wayah nojó:n tahpe:wal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>a:mo *tiempo, este**, se: ke:meh weli, *tiempo** sah. No: ika *tiempo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>De nejí:n me:tsti i:n julio *hasta** diciembre *servirowa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Pero para enero para ne:paka a:mo ok. A:mo ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Yehwa yo:n tikchi:wayah *te:chservirowaya** de a:xka:n de julio, agosto, septiembre, octubre, noviembre, diciembre.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>[K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>*Te:chservirowaya** nojó:n *trampa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Pero pos ka:mpa owihka:n tia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>tik..., tikpanowa:yah se: *sufrimiento** tikihtowa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Tikihtowa:yah a:mo teh totapalo:l *o** a:mo teh tomi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>*Porque** neh no: ni..., no: nimoskaltih ika miak tahyo:wi:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Ne:chiskaltihkeh note:iskaltihka:wa:n, *después** nokni:wa:n ya *porque** n....,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>*nopopacito** katka motamilih nikpiaya *apenas nueve años**. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Entó:s *este**, tik..., tikinkwiah n' okwiltsitsí:n wa:n ke:meh nemia ne:n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>se: nokni:w nemi, nemi ok m' *pobrecita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Pos kilia:ya n' oksé: nokni:w: - "X'chihchi:wa nojó:n okwilin, tikwa:skeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>de a:mo teh tapalo:l. Tikinkwitoh ya pero pos x'chihchi:wa, tikwito para tikwa:skeh". Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Kichihchi:waya ya nokni:w, chi..., chi:lposo:n *o** a:ko:loh, *o** iwki tikwa:yah tatewa:ts.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>De kwaltsi:n wa:ki, ahwiya:k semi. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>Entó:s yo:n tikin..., tikinkwiah mo:stah tikino:nitayah. I:ksá: mokwiah o:me:n, i:ksá: e:yi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>I:ksá: a:mo tei, [sa]ke:ra o:me to:nal, e:yi to:nal iwki tikitatih sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Kipia de tiowih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Pero mo:stah, de yo:n se: *medio año** mo:stah tiahtos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>Se: mi:xpatas komo se: o:mentitok *o** se: e:yi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Wa:n nojó:n *delicado** nojó:n kowtahokwili:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>*porque** a:mo wel eliwis se: kinamakas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Ni[o:n]wel eliwis tikte:wa:ntis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Tikwa:ntis se: tokni:w tikwa:ntiskeh pero komo tiki:xmatih de mo:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>moi:xmati de mela:wak chipa:wak. Komo a:mo, a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>*Porque** ne:n *trampa delicado**. Komo tikwa:ntik se: tokni:w *este, medio** yo:ltaman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>*pues** tiki:itati:w sah ne:n..., weli ne:n *trampa** a:mo teh mokwis ok *o** weli tikahsiti:w se: kowa:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>Yehwa ya nojó:n, komo tikneki kowa:t ya, a:mo mokwis ok n' okwili:n tein we:lik *porque** ke:yeh tikwa:ntik ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>*mopariente o mocompadre o a ver** ke:ní:w, *moamigo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Teh tikmatis tikikne:lih *porque** ya nankitah a *de veras** se: moikne:lia se:tokni:w *a veces**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>tikihtowah, - Nikwa:ntiti i:n *por[que]** te:ikne:ltih *o** ne:chitstok nitakwahtok *o** ne:chwa:litak, pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>nikwa:ntiti. *Por medio** de timoikne:li:skeh neli nojó:n kowtahnakat semi *delicado**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>pero onkak okseki tapalo:l pos a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Komo h..., komo nojó:n tikchi:wkeh yo:n, *mismo** tehwa:n timotatsak..., timotatsakwiliah m' *puerta** de nojó:n okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>A:mo teh tikwiskeh ok. Tikahsiskeh yehwa n' kowa:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>[Ko]mo iwki a:mo teh mokwis ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>*O bien** mokwis no: pero se: okwilin tein a:mo we:lik. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>*De más** okwilimeh, miak tamameh we:lkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>A:mo sayoh sentaman. Seki a:mo we:lkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>Mokwiskeh, mokwiskeh, p[er]o seki a:mo we:lkeh. Komo se: ki:xmattok pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>tikwiskeh para tikwa:skeh wa:n komo a:mo tiki:xmatih pos tika:wah ya, *mejor** tik.., tikto:kah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>*o** nikitaya ne: ke:man ki..., kinto:kayah *o** kitamo:tayah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>Pero a:xka:n a:mo ok *porque** a:xka:n oksé: *tiempo** tietokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>A:mo wel tiktamo:taskeh se:, se: tapialtsí:n tein mikis ihkó:n sah *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>pos kichi:wa se: kokolis para tinochi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Entó:s nojó:n okwilimeh mokwiah, mokwia ne:n..., *tacuache**, mokwia a:yo:to:chin,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>mokwia ne: tikiliah pe:soh, mokwia ne:n ma:pachih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>nochi yo:n okwilimeh. Mokwia kow..., ne: kowtahmisto:n, mokwia kowtu:san.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Mokwia *este**, i:ksá: nojó:n tikiliah kwe:kti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>*o** a:itskwinti *o** yo:n kiliah xo:pamikel. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>*Pues** tahpe:wal se: kikwi ne:n tein kowtapech tikiliah, tikwiskeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>xo:nokowit *o** chi:kikis, tein mela:wkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>Wa:n kalikximeh kwali tikwis ne: ke:meh eski kowit. Ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Pos tikwih *este**, ne:n tikiliah seki ka:kahfe:nkowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>pos tiki..., tiki..., tikwih seki yo:n pesma ima:..., ima:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>Tikwih seki teswakowit, tein *varitas** tiktekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>Ihkó:n t'tektinemih, tiksentiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>wa:n ne:n ima:y ne:n *este**, tikil..., nimitsilwia *ma..., mano**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>tikwih ne: seki kowit moto:ka:ytia tepe:tahka:la:kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>tepe:tahka:la:kowit ima:y. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Wa:n kalikximeh pos ke:meh eski kowit tikwih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>wa:n tai:xwi:pa:nka:yo:t no: tikwih tikiliah ne: ka:la:omikowit *o** kahfe:nkowit, tein *varitas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>Wa:n *este** tepe:chi:lkowit, tein mehmela:wak. Yehwa nojó:n tikwiah. [Ke:]mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>Wa:n ne:n ika tit..., titawi:pa:nayah n' tein kalampa ya n' *corral** kwomekat mono:tsa te:sakakwomekat, ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>wa:n tein ima:y ne:n *mano** tikilia:yah tata:wikkwomekat no:, ka:mpa mi:nkat kikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>Ika tik..., tikilpiah mi:nkat wa:n ika tikilpiah *mano** mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>Mi:nkat pos yehwa ne:n ka:la:omit, tein takwa:wak no:, ke:mah, *o** tepe:chi:lkowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>Pos n' tet ... Pos tepe:tah *siempre** a:mo onkak s... tet tein i:n tikwih nika:n, tikihtowah tikwih para tepa:nkal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>te..., tex..., ke:meh ne:wí:n tepe:tah onkak texkaltet tikiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE>yehwa tiksentilia:yah texkaltet n' ito:ka:y, seki tet *medio** kohkostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>T'sentiliah sake:ra *veinte o treinta**. T'sakah no: te:chwi:kilia *trabajo**. Komo a:mo tei, pos tikte:mowah ma:ski wehka *o** tiktapa:nah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>*Trato que** ne:sis *porque** komo sayoh kowit a:mo mikis n' okwilin ne:n tatampa mota..., moka:wati:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>*porque** yeh wa:la:s kalakiki:w komo, komo tikta:lih ne:n toni n' ika motoki:s, komo tta:lih xokot *o** tsapot *o** pahpata,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>pos yeh yehwa ne:n kitstiwi:ts.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>[K]e:mah. A:mo kimati ox ompa moka:wati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>[K]e:mah. Yehwa nojó:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts390">
                <ANNOTATION_VALUE>Entó:s ne: wi:tsa ya pos *seguro**. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts391" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>*Demás** pos a:mo teh *más** ke:ní:w, takwal *más** a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Yehwa sah n' tsapot, pahpata, xokot, [ke:]mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>A:mo motoki:s, a:mo. Ihkó:n sah tiki:itati:w wa:n a:mo ai:k teh, a:mo ai:k teh tik..., tikwi[s], ke:mah pero a:mo niman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>*hasta** ke:man yeh kinekis no: wa:la:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Ke:mah *porque** pos no: kitah n' *corral**. [K]e:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>*Pues** se: kita:lilia xiwit n' ahko, n' tate:n ne:pa ka:mpa n' tami kowtapech, [se: kita:lilia]xiwit wa:n ne:pa no: xiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>*pero a fuerza de** mokalaki:ki:w ke:meh nejí:n tatampa de nejí:n yetok i:n *mesitas**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>para a:mo pano:s ahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>Wa:n nojó:n ne:n *este**, tikiliah epat, yo:n kwali no: para pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>Pos yo:n a:mo se: kikwa:ya, no: se kikwa:ya pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>*pues** se: *señor** se: vez ne:ch..., ne:chkwaltihka *porque** ke:meh yo:n name:chilia se: moahsi de se: tamahse:wtok, pos se: mo..., pos se: moikne:lia, *como que** a:mo se: *moaguantarowa** [a:mo]se: mowa:ntis teihsá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>*Este** ne: kih..., ne:chilwia yehwa *que**, "xikyeko" kihtowa "*zorrillito**". Yehwa kihto *español**, a:mo kihtoh epat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>"¿ke:ní:w we:lik? *O** ...". I:n nikilia, "neh a:mo ke:man nikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>Nikmattok *que** a:mo we:lik".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Kihtowa, "we:lik, ta: niktsoyo:nih".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>Pos nikwah, nikwe:lilih pos *mantecado**, kwaltsi:n tachihchi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>*Después** ne: ke:man tikinkwiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>aya:mo wehka:w e:..., *nocarnal** ne:..., iwa:n tikinkwiah wehka:wak wa:n *después** nopi:pilwa:n ya.*Apenas** tika:wkeh nejó:n *costumbre, como de..., como de diez años**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>*Porque** nopi:pilwa:n semi kwelitayah *porque** nikine:xtilih *después**. Katka noh..., tik..., nankitah ya n' topi:pilwa:n de nohne:lmeh wa:n kwelitah ay te:tohtokaskeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>*este**, te:..., no: kinekih weliskeh toni se: kichihchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Pos *trabajo** de kitakeh de ke:ní:w nikchihchi:wa, pe:wak yehwa:n moyo:lchika:wah ya ne:n pi:piltsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>kichihchi:wayah ke:meh weli wa:n no: kinkwiah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>*Después** pe:wak kinkwih ya, *hasta** wehweyakoh. No: kwelitayah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>*Pues** nojó:n epat, ke:meh tine:chilwia *este**, toni m' pahti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>*pues** neh *ne:chpasa:roh** wa:n, wa:n nikwah seki, wa:n yehwa wa:n imante:kayo wa:n okseki taman ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>tepe:xi:lo:t wa:n koyo:lin wa:n tsanamets,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts457" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>kiliah seki *plantita** ihko:kó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Wa:n nojó:n *este**, pahti para nojó:n mihmikilo:tataxis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>Neh nikihtowa *porque** neh *ne:chpasa:roh** wa:n *a puro Dios** nimoyo:lkwik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>*[Por]que** se:, se: *tiempo**, nikpiaya ke:meh ompakawí:n, ke:meh *siete, ocho años**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>ne:chkwik yo:n kokolis wa:n a:mo nitata..., a:mo, a:mo tataxis ke:meh kihtowah okseki tataxis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Nitatasi wa:n nihyo:tami *hasta** niti:le:wi wa:n nitalka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>A:mo, a:mo nikmatia ok, ni..., niwa:ltamatia ne:chpi:pi:tstokeh ihkó:n nokni:wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>ke:meh yehwa:n wehwei ya pos ne:chsenkwih, neh niwetstok wa:n nitatasi wa:n a:mo, a:mo nitaxi:kowa de n' ihyo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>Pos ki..., kitsi:ntokakeh toni n' pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Ne:chte:molihkeh *mismo** yehwa:n nokni:wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>wa:n pos *de que** kite:mohkeh, kinechikohkeh nojó:n xiw..., xiwit, tepe:xi:lo:t iyo:lo wa:n inalwayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>wa:n koyo:lin no: wa:n ne:n tsanamets</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts482">
                <ANNOTATION_VALUE>wa:n kite:mohkeh n' epat, nenkeh, yehwa:n ne: aya:mo k..., aya:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>aya:mokichi:wa ya ne:n *trampa, no..., nocarnal, porque** nohne:l katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>Pos tehwa:n sah tikni:meh, tinohne:lmeh, neh *más** ni..., ni..., nix..., nixo:koyo:t. Nokni:wa:n seki:n i:pa..., ne: tein *nomayor**, tein ne: Xaltepec yetok, pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>i:pa kipia ya ke:meh *catorce años, quince años**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>wa:n ne: se: *nohermana** pos *más** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>*Entonces** nojó:n, ki..., kisentilihkeh nojó:n xiwit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>wa:n pos nikitstok sah. Pero pos *cada ratillo** ne:chkwi, nitatasi, pero nihyo:tami wa:n nisenti:le:wi wa:n a:mo nikmati ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts495" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Ne:chpi:pi:tsayah ya para ne:ch..., nimihyo:kwia wa:n ne:chyo:li:xxita:nia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts498">
                <ANNOTATION_VALUE>Semi fie:roh nojó:n kokolis kilwiah mihmikilo:tataxis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Entó:s ki..., kisentilihkeh nojó:n x..., *planta**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>kimankeh, yehwa n' tepe:xi:lo:t iyo:lo wa:n inalwayo wa:n koyo:lin wa:n tsanamets.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Wa:n ne:n epat kite:mohkeh n' imante:kayo wa:n ne:chkwaltihkeh iwki wa:n nakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>Iwki nikwah. Pos nikneki ni..., nipahtis nikwah, nochi nitai:k yo:n xiwa:... xiwa:tsi:n, kip..., kipa:kkeh kwaltsi:n wa:n kima..., ne:chmanilih nokni:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>wa:n ika se: *jarro** we:i, kwali tsokomo:molo:n. No: kitsi:ntokakeh ke:ní:w nitai:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>Nitai:ya ta:tahko *taza o** se: se: *taza**. kwaltsi:n tachihchi:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>wa:n de se:wia ya, tepitsi:n toto:nik ok, ki...,onkaya seki pah..., seki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts513" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>pahti no: nika:n Cuetzalan ne: ke:man ya *pues** kilia:yah sosalasa:nteh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>seki mahyá *este**, mahyá: yo:n monamaka *istaterrones, granitos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>Kipante:milia:yah tepitsi:n ne:n *tazahko** ne:n *remedio** wa:n *medio** tsope:ya. Ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>Kilia:yah sosalasa:nteh nojó:n pahti. A:xka:n a:mo, a:mo tei ok tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>Nitai:ya. Miak *veces** nitai:k, pe:wak ne:chka:wtiw a nojó:n tataxis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts524">
                <ANNOTATION_VALUE>Nitatasi pero we:wehkatika: ya, we:wehkatika: ya, *como siempre n'segui:roh** nitai:tiw, nitai:k miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts525" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>Mia:k nitai:k *hasta** ne:chna:mik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>*Después** pe:wak a:mo nitatasi ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>Pero n'mattok nojó:n *planta** semi kwali para *remedio de** nojó:n mihmikilo:tataxis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>pero a:mo tiknehnektokeh, a:mo t'te:mohtokeh, mah Dios te:chpale:wi *porque** semi fie:roh. Neh, nehwa nikmattok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>*porque ne:chpasa:roh**. [K]e:mah, *solamente** yehwa ne:chna:mik nojó:n tikiliah ekintsi:n *natural** nojó:n *planta**. [K[e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>*Pues** neh ne:chtapowia:ya ne:n, se: *notío** katka, ompa *novecino**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>mono:tsaya [E]milio Juárez, *porque** yehwa:n nochi yehwa ika no: moskaltihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>ta:tahmeh. "Wa:n komo nanki..., nanki..., nankinkwih *sobrinos**", kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>"a:mo eliwis xite:wa:ntika:n ne:n..., ne:n *este**...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>ihkó:n kitati:w a:ksá: kalihtik tahtanis, a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>"Kichi:wa *mal por** yehwa i:n *cosa**" kihtowa."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>Wa:n *de veras**, se:, se: *nocuñada** katka *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>ki..., kiwa:ntik se: *ipariente**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>Ke:meh semi no: kinkwia no..., *nocarnal**, kimpiaya n' okwilimeh pero miak sake:ra *diez** kimpiaya kalihtik tawa:tsmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts560">
                <ANNOTATION_VALUE>ki..., *cualquier** okwilin ompa ne: sa: taahwiya:xtok de okwilnakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Ki:sato kinitak. Ah, "ne:ch..., ne:chwa:ntis", kit kilia. "Nimitskowili:s", kit kilia. "A:mo nimitswa:n..., a:mo, a:mo nimitstahtania semi xne:chwa:nti", kilia."Tine:chmakas", kit kilia, "pero nimitsixta:wili:s se: a:..., se: a:yo:to:chin imets".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>[K]e:mah, "¿ka:nachi t'nekis?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>Wa:n ke:meh *nocuñada** katka semi kwalta:kat katka, a:mo ke:man *este** kicho:kilia:ya para teihsá te:wa:ntis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>entó:s kit kilia, kit kilia "kwaltia". Wa:n ne:n *nohermano** a:mo etoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>"kwaltia", kit kilia. "Tikwa:skeh", kit kilia, "ka:n ke:man tikwahtokeh, no: taman we:lik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>*porque** ne: kalihtik yehwa:n a:mo k..., a:mo kinte:mowah".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>Pe:wak, kit kilia, "ta: komo tikwi:kas" kit kilia "pos x'wi:ka ya".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>"¿Neli?" kit kilia, "ke:mah", "¿ka:nachi nehyo:n tiknekis?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>Kit kilia, "ka:n nimitsnamaki:ltia, ta: ampó:n *sobrarohtok**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>'Wi:ka sah, [k]e:mah, nimitswa:nti sah". "Xa: kwala:nis n' ta:kat". Kit kilia: "kanah, ta: nikilwi:s de ehko".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>Pos ki..., yeh kimattok ke ki..., kinka:wte:w n' okwilimeh ahsitokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>We:no, kite:wa:ntik. Kwi:kak nojó:n *señora**, pero pos tak a:mo momakak *cuenta, este**..., ke:[yeh]ke:ye:h yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>ke:yeh kimakak. Tak..., *caso**[casi]kimo..., motekipachoh *de que** a:mo kiwa:ntis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>Entó:s tio:tak ehkok ne:n nokni:w, kilia: "a:mo tikwala:nis", kilia, "nikte:wa:ntik n' nakat".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>"¿A:kon t'wa:ntik?" "*Nopariente**".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>"E...," kit kilia, "a:mo x'wa:ntini, ke:yeh nehyo:n tikwa:nti, ta: [yo:]n a:mo kwaltia se: te:wa:nti. "A: pero ka:n, ka:n eliwis" kit kilwia "ta: nemi kwali".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>*Porque** nojó:n para el..., se: tein eliwisyo:t wa:n x'wa:nti nojó:n okwilin a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>a:mo kwaltia. *Hasta** nojó:n a:tawokwilimeh tikiniliah xilimeh *o pescados**, nochi *delicados**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>[K]e:mah. Entó:s *este**, pos kisegui:roh ne: nokni:w ta:tachiati, ta:tachiati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts600">
                <ANNOTATION_VALUE>a:mo teh mokwi, a:mo teh mokwi ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts602">
                <ANNOTATION_VALUE>Kitati *como siempre** yetok ne:n tahpe:wal iwki wa:n a:mo teh mokwi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>*Por último** yahsik sepa, nehyo:n ne: tawetsik ne:n ka:mpa n' kowtapech,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>mowelitstiw ne: kitstiw, wetsik, mokwik n' *armadillo** kit [molia].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>Kahsito ne:n tatampa a:mo *armadillo**, se: we:i kowa:t, na:weyak ne:n chompachiwtok[tsompachiwtok]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>tatampa de n' *corral**. Pos soh kina:litato.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts611" TIME_SLOT_REF2="ts612">
                <ANNOTATION_VALUE>A:mo ki:mak. Ehkok wa:n pe:wak kahwa ya ne:n *nocuñada** ya katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>"Ke at..., ke a:mo xite:wa:ntini nojó:n nakat, tikihtowa ke a:mo eliwis *mopariente** wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>ekintsi:n nikitato se: kowat. Ekintsi:n ke:meh teh tite:wa:ntik, teh xiow xik, teh xiow xiki:xti:ti yo:n okwilin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>teh x'mikti:ti, neh a:mo niki:xti:s, we:i, nikmowili:to".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>Pos a:mo yahki n' siwa:t. Pos kit kilia, "nite:wa:ntik a, ka:n wel nikahwati ika, ta: neh..., motahtani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Pos iwki a " kit kilia, "xika:wa ya". "Pero, ¿ke:niw n' chi:wati? Pos mokwitoyah, wa:n *solamente** yehwa n' tikwa:ntik wa:n a:mo teh mokwi ok".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Pos, pos kihtowa *que siempre** kikwa:tahtatsi:nih, kima:k *por medio de** yo:n te:wa:ntik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts626">
                <ANNOTATION_VALUE>kwala:nik nokni:w *porque** pos yehwa ya ne: sa: achi mokwaltia ne:n kowa:t, kahsito tatampa ne:n, aktok ka:mpa n' kowtapech</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>wa:n *hasta** de yehwa yo:n moka:w se: *recuerdo** nojó:n neli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>chi:wi neli *por eso** a:mo..., nikihtohtok ekintsi:n tein neli, a:mo, a:mo soh nik..., niknemilia sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>ta: *kipasaroh** no..., *nocuñada** katka kite:wa:ntik wa:n nokni:w *kipasaroh**, kahsik n' ka:mpa *trampa** nojó:n okwilin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Wa:n yehwa ya no: ne:chilwih "ke a:ah, *de veras que** a:mo kwaltsi:n" kihtowa, "nojó:n okwilimeh tikinkwis *carnal**" kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>"weli pero xikwa:ka:n sah, namehwa:n sah, xikwa:ka:n sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>[K]e:mah. Ke:meh i:n tikni:meh timowa:ntih" kihtowa, "pos timomattokeh ke...."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>A:mo semi a:kin semi telchipa:wak ta:ltikpak pero mah *siempre** se: momaka *cuenta, regular**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts641" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>[K]e:mah. I:ksá: ne:n nokni:w siwa:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>nopi:pilwa:n kininkwih *pájaros**, *porque** yehwa:n *kiseguirowah** wikihi:ksá: kinte:mo:tih *pájaros o** kahsi *este, armadillo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>kiwa:ntih wa:n ka:n teh *kimpasarowa porque** ke:yeh *mocuidarowa nohermana** tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>Ke:mah, *porque** kikne:liah n' ina:wi. Moliah, tikwa:ntitih toa:wi, [mah]mochihchi:wili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>Kwa:ntih wa:n a:mo teh *kimpasa:rowa**, ke:yeh, *mocuidarowa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>Pero tein a:mo, niman. Niman kine:xtia ton *cosas**, a:mo moneki se: kilwi:s, ni[o:]n, ni[o:]n ke:ní:w ok. Iwki nojo:ni, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>*Pues** newí:n kowtah ke:mah, *como siempre**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>pero a:mo *igual** ok *porque** seki ekintsi:n miak, nankitah ya miak *este, malos** nemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts666">
                <ANNOTATION_VALUE>Ihkó:n pano:tiki:sah kitah sah wa:n *cuando** yowak a, *kimachetearo:tih**. kiwehwelowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>Pero *demás** welih, newí:n welih pos tein se: kimattok ke:ní:w se: kichihchi:wa se: kichihchi:wati:w pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts669" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>pos te:pihpiah ya. Komo a:mo yowak kit kiki:xti:tih n' okwilin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>Se: kikwiti:w wa:n tein *dueño de n' trampa** a:mo *kitoca:rowa** ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>Wa:n ne: ke:man katka, a:mo. Ke:mah ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>A: pos ta: nopi:pilwa:n welih, welih, *hasta** kinemilia:yah i:n a:xka:n nejín junio tamik, tikchihchi:waskiah *trampa**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>pero monemiliah, moka:wiliah, pos teh titatachiati:w *hasta** ne: wehka.|</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>Kihtowa:ya se:, ke:mah, niá:s.  Yowa:k nihsas wa:n niá:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>Tikwa:skeh n' okwilin, pos, pos ta: kimattokeh ke:ní:w se: kichihchi:wa, e..., tikine:xtilihkeh,ke..., a:mo teh molwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>Ehkoh yehwa:n *mismo** kichihchi:wah, kitehtekih, kitipampilowah, kiwa:tsah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts690">
                <ANNOTATION_VALUE>[wa:n]etok, etok a n' tapalo:l, [k]e:mah, a:mo teh molwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>Okseki pi:pil a:mo, a:mo kimatih *porque** a:mo kinine:xtiliah inte:iskaltihka:wa:n wa:n a:mo kitsi:ntokah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>ke:ní:w nojó:n mochihchi:was pero demás pos kihtowah miak, nochi n' *cosas** tiweliskeh pero mah yeto a:koni n' te:chi:xyeka:nas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>ke:ní:w n' te:chmachti:s para tiweliskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>Nochi ihko:ni n' *cosas**, a:mo a:kin, a:mo a:kin i:pa weli n' ta:ltikpak *lo que** tein onkak. Ke:mah, ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>*Pues sólo** ne: name:chilwia ne:n xo:pamike:l a:mo wel se: kimahse:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>wa:n ne:n kwekti a:mo no: kwaltia para se: kimahse:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>Yo:n kiliah a:itskwinti a:mo no: kwaltia para se: kimahse:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>Ne:n kiliah kosama:lo:t a:mo no: kwaltia para se: kimahse:was *porque** yo:n no: mokwi ne:n itech n' tahpe:wal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>wa:n ne:n takwakwilo:t. Takwakwilo:t oksé: wa:n takwatsi:n no: oksé:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>yo:n a:mo no: *servirowa** para se: kimahse:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts716">
                <ANNOTATION_VALUE>Wa:n no: n..., kiliah *este, onza real**, yo:n kihtowah seki we:lik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts718">
                <ANNOTATION_VALUE>pero a:[i]t ox mela:w. *[Por]que** tehwa:n a:mo ke:man, a:mo ke:man tikwikeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>pero tikini:xmatkeh ne: Ehkatla:n se: *tiempo** titekititoh wa:n se: *amigo** ompa kinkwik to:naya:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>Wa:n kihtowa *que** yeh a:mo te:ka:wah mah se: *kinicercaro**, te:tsikwi:nka:wiah te:kwah komo a:mo tikima:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>A:mo wehwei:n, *pesarowa como de cinco kilos, cuatro kilos** sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts726">
                <ANNOTATION_VALUE>Pero kihtowa "komo timahchi:w mitstokaskeh wa:n mo..., mitskehkehtsomaskeh", kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>A:mo te:ka:wah. Seki o..., seki okwilimeh tamat..., tamat..., tamantikeh sah, *medio** nextikeh. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts731">
                <ANNOTATION_VALUE>Yehwa:n yo:ni pero okseki de n' tein name:chmakak *nombre**, we:lkeh, we:lkeh, [k]e:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts735" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>Ke:mah. Pos ne:n *armadillo** pos ke:meh ne: ..., n..., kihtowa:ya ye:wa ne: *señora** we:lik a:ko:loh *o mole**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>Pero se: yehwa name:chilia *nocuñada**, yeh kichihchi:waya *tamales de mole**, no: we:lik ki:saya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>*Igual, igual** ne:n *tlacuache, pues** no: we:lik yeh a:koloh, chi:lposo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts741" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>Pero ne: ke:man *este**, se: *señor** ompa ne:pa *tovecino, difuntito** ya no:, ka:mpa *Dios** kipia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>tikpale:wihkah titekititoh, tio:tak a, i:pa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts745" TIME_SLOT_REF2="ts746">
                <ANNOTATION_VALUE>kihtowa, "tiowih ok" kihtowa, "kalihtik, [nanta]i:skeh sake:ra kahfe:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts747" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>Tiahkeh, te:chilia ne:..., titai:keh n' kahfe:ntsi:n wa:n tikitah mokwehmolowah, kikehketsah ne: *cafecito, mesas, sillas**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts749" TIME_SLOT_REF2="ts750">
                <ANNOTATION_VALUE>tikitah kwa:lkwih ya s..., itech..., ika *bandejas**, ihkó:n tatahko *de mesas, puro tamales**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>Kihtowa xik..., "mowa:ltoki:ka:n ya nika:mpa" kihtowa "tikwa:tih se:, se: taxkaltsí:n".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts753" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>Tikiliah "we:noh". Pos tio:tak ya, pos ne:n ke:meh titekititoh pos neli ti..., ti..., *de la mera** tikele:wiah n' taxkaltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>Entó:s timota:li:toh, tikwikeh ya sehse:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts757" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>"Wa:n mah semi name:chili" kihtowa, "i:n a:mo namokaya:waskeh", kihtowa "*este, tamales de** pitsot *o de** pio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>De t..., de takwatsi:n" kihtowa. "'Yeko:ka:n" kihtowa "ox we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>Neh i:pa nikwa:ni" kihtowa. Tikilwiah "we:noh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts764">
                <ANNOTATION_VALUE>Pos *sie[mpre]** tikwahkeh pero a:mo semi *igual** ke[me]h pitsot, oksé: *sabor**, [k]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts765" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>*Medio** xo:kihya:k ki:sak nojó:n *tamalitos** pero de timaya:nayah pos tikwahkeh, ta: chihchi:wtok kwali, ka:n nikihto:s taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>Yehwa no:[jó:]n..., we:lik no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Ora ne:n *este**, m' pe:soh pos no: we:lik chi:lposo:n, we:lik a:ko:loh. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>Ihkó:n nojó:n. Ma:pachin *igual** no:, a:ko:loh kichihchi:wah, chi:lposo:n. Se: kikwa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts773" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>[Ke]mah mah kwaltsi:n tawa:ts *o regular** tawa:ts, kwaltsi:n ki:sa n' tapalo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>Wa:n tein we:i de mela:w, neli mante:kayoh, we:lik kwaltsi:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>*Porque** ne: k..., ne: ti..., ne: ke:man kikwika se: *nomuchacho** se: takwatsi:n a:mo ke:man iwki tikwih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts779" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>*pesaroh como diez kilos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>We:i, we:i n..., we:i *hasta** ihko:ni n' i..., n' ikechko n' *tacuache** kehkoltih kalihtik. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts784">
                <ANNOTATION_VALUE>Nemia, ne: ke:man ya, a:mo, a:mo *apenas** ok, nemia ok *noseñora** katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>Ehkok wa:n kichihchi:w n' imomá:n ... Wa:n ... Pero tila:wak de mante:ka kipia ya. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts787" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>Pero neli ke:meh nikihtowa tikwa:yah *este**, chi:lposo:n, a:ko:loh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts789" TIME_SLOT_REF2="ts790">
                <ANNOTATION_VALUE>Ora, ma:pachin, *lo..., igual, lo mismo**, a:ko:loh *o** chi:lposo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts791" TIME_SLOT_REF2="ts792">
                <ANNOTATION_VALUE>[K]e:mah. Yehwa:n yo:ni ihko:ni se: kinimahse:wa, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>Wa:n se: kichipa:wa pos ke:meh kihtoh ne:n *señora**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts795" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>ihkó:n se: kichichinowa. Pero n' kowtu:sa:n a:mo, yehwa a:mo se: kichichinowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts797" TIME_SLOT_REF2="ts799">
                <ANNOTATION_VALUE>Yeh ika a:toto:n *porque** semi yema:nik. kwaltsi:n ki:sa ika n' a:toto:n ne:n nochi n' i..., itake:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts802">
                <ANNOTATION_VALUE>Chipaktsí:n moka:wa pero kwaltsi:n chipa:wak, chipa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts803" TIME_SLOT_REF2="ts804">
                <ANNOTATION_VALUE>Mah se: ki..., mela:wak ema:nik, telema:nik ke:meh pitsomante:ka. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts806">
                <ANNOTATION_VALUE>Mela:w weli:k. Nikmattok *porque** tikin..., tikinkwikah no:, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts807" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>Motki n' tu:sah pero oksé: *color** mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts810">
                <ANNOTATION_VALUE>Yehwa nojó:n, *demás** okseki pos a:mo teh *más**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts811" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>name:chilwih ya de katí:n tein se: kimahse:wa, ke:ní:w, katí:n tapalo:l</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>wa:n tein a:mo se: kimahse:wa no: name:chilwih ya kati:nkeh, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts819" TIME_SLOT_REF2="ts820">
                <ANNOTATION_VALUE>*Marto**..., ¿a:mo yehwa n' a:itskwinti?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>A:mo niki:xmati. Yehwa a:mo niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>Yeh ika a:mo name:chto:ka:ytilia, [k]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts830">
                <ANNOTATION_VALUE>Pos de kowtahokwilimeh *sólo** ne:n chechelo:t, no: kowtahokwilin no:, yo:n ... pero yo:n nemi kwoma:pan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts832">
                <ANNOTATION_VALUE>[K]e:mah, yo:n yeh ika motekipanowa ke:meh tehwa:n no:, sintsí:n, ihkó:n, tsapotsí:n, pahpatatsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts833" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>San tein a:mo kowtetsí:n ika motekipanowa no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>[K]e:mah yo:n no: we:lik, pero yo:n yeh we:lik, pos se: ki:xtilia ne:n itake:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts838" TIME_SLOT_REF2="ts840">
                <ANNOTATION_VALUE>[K]e:mah, ah, yo:n a:mo se: kichichinowa, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts841" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>[K]e:mah, *porque** n'mattok neh *porque** se: *nomuchacho** kipia *catorce años** semi kiwelita para kinkwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>Kinima: ika *charpe o** ika se: tepostatopo:n nikpia, wehka sah n' kinimpantamo:ta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts845" TIME_SLOT_REF2="ts846">
                <ANNOTATION_VALUE>wetsitih. We:no yehwa kinin..., kinin..., kininma: *porque** kihtowa ke semi *dan..., dañosos**, kihtowa "ki..., ki..., ki..., kikwah" kihtowa "e:lo:t".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts847" TIME_SLOT_REF2="ts848">
                <ANNOTATION_VALUE>"Wa:n e:lo:t" kihtowa "pos a:mo no: tik..., tiknekih tika:wili:skeh" kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts849" TIME_SLOT_REF2="ts851">
                <ANNOTATION_VALUE>"*mejor** mah mikika:n" kihtowa. "Pero a:mo tamiskeh ke:man", nikilia, "ta: miakeh". Ihko:ni, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts855" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>*Pues** ne:n *armadillo** kinte:mowa yo:n tikiliah okwiltsitsí:n ta:l..., ta:l..., ta:li:xko mochi:wah, itech kopalak seki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts857" TIME_SLOT_REF2="ts858">
                <ANNOTATION_VALUE>ne: kiniliah nextekwilimeh. Pe..., pe..., pe..., ke:meh eski okwiltsitsí:n mointe:molia, tahtachkwatinemi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts859" TIME_SLOT_REF2="ts860">
                <ANNOTATION_VALUE>Yehwa yo:n wa:n nexkihit, yehwa yo:n semi itakwal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts861" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>Nexkihit ka:mpa onkas a:mo kika:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts863" TIME_SLOT_REF2="ts864">
                <ANNOTATION_VALUE>yehwa yo:n semi a:mo, a:mo k..., ki..., teh ke:ní:w *más** kikwa:s, *solo** yehwa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts865" TIME_SLOT_REF2="ts866">
                <ANNOTATION_VALUE>okwiltsitsi:n kinte:mos ka:mpa tapala:ntok, tahtachkwas</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts868">
                <ANNOTATION_VALUE>*o** komo kwopalak ki..., kwehwelo:s wa:n kahsis yo:n itakwal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts869" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>Yehwa n' ika nemi wa:n yehwa nexkihit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts872">
                <ANNOTATION_VALUE>Wa:n ne:n *este**, n' pe:soh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts873" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>yehwa:n kite:mowah miak taman, pahpata *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts876">
                <ANNOTATION_VALUE>yo:n *papaya cimarrón o** ma:ski tein we:lik kitoka:h ne:wí:n tokni:wa:n de Ehkatla:n, a:mo *kintoca:rowa** ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts877" TIME_SLOT_REF2="ts878">
                <ANNOTATION_VALUE>*O** yo:n *sandías** yo:n tikitah i:ksá: kininemi:lti:kih, ompa newí:n kipiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a471" TIME_SLOT_REF1="ts879" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>Komo a:mo niman kikwitoh, kahsiti:wih taihtikoyo:ni:l a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts882">
                <ANNOTATION_VALUE>*o** ayohmeh tein i:pa ayohmeh de nejí:n *original** tiki..., tikiliah a:xka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts883" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>*este**, a:mo, a:mo wel onkaskeh ok, a:mo kinka:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>Yowih yehwa:n, yo:n kinkwah. Yehwa n' kikwah ne:n *papaya cimarrón o** tein kwali wa:n ne:n pahpata</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts887" TIME_SLOT_REF2="ts888">
                <ANNOTATION_VALUE>wa:n yehwa n' *sandía o** ayohwachmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>A:mo kika:wah komo kowte:noh ne:wí:n kita:liah tokni:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts892">
                <ANNOTATION_VALUE>Wa:n tehwa:n no: tik..., te:chchi:wilihkah se: *vez**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts893" TIME_SLOT_REF2="ts894">
                <ANNOTATION_VALUE>pos a:mo no: sepa tikin..., tikinto:kilihkeh ok *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts895" TIME_SLOT_REF2="ts896">
                <ANNOTATION_VALUE>pos kihtowa ne: nokni:w "soh tika:..., tika:watih para okwilimeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts897" TIME_SLOT_REF2="ts898">
                <ANNOTATION_VALUE>pos tak ma:ski mah tikele:wihtoka:n ya" kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts900">
                <ANNOTATION_VALUE>"Tikowaskeh ya komo tikele:wiah ka:sá: tikitah", kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>Entó:s yehwa yo:ni n' kikwah yehwa:n pe:sohmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts904">
                <ANNOTATION_VALUE>Nojó:n a:makowtet, tetsapokowtet, ti:ltsapot,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>kowtsapot. Yo:n miak taman kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>Yo:n ta:lpan..., ta:lpanehnekinikahtso:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts910">
                <ANNOTATION_VALUE>¿Ox tiki:xmatitehwa:tsi:n yo:n tikiliah ta:lpankahtso:t? Ta:lihtik mochi:wa pero a:mo ye:kwe:lik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>tikiliah *cimarrón**. Yo:n kichkwah mas:ki se:, se: *cuarenta centímetros de** wehkatan, kichkwah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>*hasta** kahsiskeh. A:mo x'mati ke:ní:w ki..., kihnekwih tak ka:n n' to:ktok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>*Porque** se: *lugar** ne:pa ni..., se: *tiempo** ntato:kak ta:l de Ehkatlá:n wa:n semi on..., semi onkaya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts918">
                <ANNOTATION_VALUE>wa:n *después** momattkeh, pos pe:wak yowih wa:n ne:chkwalia:yah noe:lo:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>Pos tikitayah *después de que** a:mo titatokkeh ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts922">
                <ANNOTATION_VALUE>pero ka:nachi *hoyos** kichi:wkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts923" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>Kichkwah *hasta** ka:mpa weli wa:n kitetexo:tih n' kamoh wa:n mosiowtiah, pero ke:meh istiyehkeh tak a:mo, a:mo no: siowih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>*Trato que** kikwa:skeh ne:n intakwal.[K]e:mah, yehwa nojó:n kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts928">
                <ANNOTATION_VALUE>Nojó:n miak taman kikwah m' pe:sohmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts930">
                <ANNOTATION_VALUE>*Igual** ma:pachin, yo:n no: *igual**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>no: *mismo igual** kikwa, nochi yo:n *cosas**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts933" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>Pero ne:n a:itskwinti yeh *solamente** xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts936">
                <ANNOTATION_VALUE>Ke:mah, kinte:mo:s a:taw xilimeh, nentinemis a:taw wa:n yehwa yeh n' ika motekipanowa, xilimeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts938">
                <ANNOTATION_VALUE>*porque** kalaki a:ihtik. Ihkó:n kinte:mowa a:ihtik, panki:sa, sepa pankalaki, pa:nki:sa, sepa pankalaki wa:n kinahsi xilimeh, kikwa:s ne: paniá:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts939" TIME_SLOT_REF2="ts940">
                <ANNOTATION_VALUE>Ihko:ni, kiliah..., *por eso** kiliah a:itskwinti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts942">
                <ANNOTATION_VALUE>[K]e:mah. Pero ne:n kwe:kti yeh *solamente** kinki:tski:s *pollitos**, kinkwa:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts944">
                <ANNOTATION_VALUE>wa:n ti:ltsapot. Yehwa yo:n semi itakwal yehwa. [K]e:mah, yehwa yo:n, kwe:kti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts945" TIME_SLOT_REF2="ts947">
                <ANNOTATION_VALUE>Wa:n ne:n *este*,* n..., ¿okseki katí:n okwilin nimitstapowih?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts951" TIME_SLOT_REF2="ts952">
                <ANNOTATION_VALUE>Ma:pachin yeh *lo mismo** kik..., mo..., tamahse:wa ke:meh m' pe:soh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts953" TIME_SLOT_REF2="ts954">
                <ANNOTATION_VALUE>Kikwa:s ne:n pahpata, kikwa:s ne:n *papaya**, kikwa:s ne:n.... Yeh a:mo, ye:h a:mo kikwa ne:n kahtso:t *cimarrón**, yeh....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts955" TIME_SLOT_REF2="ts956">
                <ANNOTATION_VALUE>Ma:pachin no: *igual** ke:meh pe:soh, kikwa:skeh n' e:lo:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts957" TIME_SLOT_REF2="ts958">
                <ANNOTATION_VALUE>*porque** m' pe:sos[pe:sohmeh]]semi kikwah n' e:lo:t, *hasta** sinti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts959" TIME_SLOT_REF2="ts960">
                <ANNOTATION_VALUE>wa:n ma:pachin kisa:sakas n' e:lo:t ka:mpa mahxili:s[moahxili:s]kikwa:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts961" TIME_SLOT_REF2="ts962">
                <ANNOTATION_VALUE>wa:n yehwa n' ti:ltsapot mote:moli:s ma:pachin. K]e:mah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts963" TIME_SLOT_REF2="ts964">
                <ANNOTATION_VALUE>[ko]mo wehkapan yeh a:mo kimowili:s wehkapan, ompa nentó:s wa:n ki... *[a]fuerza que** kikwa:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts965" TIME_SLOT_REF2="ts966">
                <ANNOTATION_VALUE>yo:n a:makowtet *igual**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts967" TIME_SLOT_REF2="ts968">
                <ANNOTATION_VALUE>*Porque** nikmattok *porque** ne:chilia:yah nopi:pilwa:n wa:n ika nem..., nemih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts969" TIME_SLOT_REF2="ts970">
                <ANNOTATION_VALUE>*bueno** ekintsi:n a:mo yowih ok *porque** pos miak, miak *delicado** onkak ekintsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>se: xiwit ya:yah ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts974">
                <ANNOTATION_VALUE>Nikmattok toni nojó:n itech kinahsiah wa:n ne:chilwia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts975" TIME_SLOT_REF2="ts976">
                <ANNOTATION_VALUE>*hasta** yehwa:n molwi:ayah, ompa i:n onkak, tiowih *porque** ompa tikinahsiti:wih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts978">
                <ANNOTATION_VALUE>Kihtowah kinahsiah sake:ra *treinta o veinte o, o cuarenta** okwilimeh itech se: tein we:ikowit ahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts980">
                <ANNOTATION_VALUE>Pos kikwiah sake:ra se: *o** o:me, wi:tseh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts981" TIME_SLOT_REF2="ts982">
                <ANNOTATION_VALUE>Wa:n moka:wkeh *porque pues** tikita ya, miak *de malas** mochi:wa. A:mo no: nikinselih ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts984">
                <ANNOTATION_VALUE>Para toni namoka:wati:wih ne: owihka:n, *después** neh ne:chtahtakolti:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts985" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>A:mo yowih ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts987" TIME_SLOT_REF2="ts988">
                <ANNOTATION_VALUE>[K]e:mah, iwki kihtowah ke kikwah ti:ltsapot,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts989" TIME_SLOT_REF2="ts991">
                <ANNOTATION_VALUE>kikwah a:makowtet, e:lo:tah, ihkó:n ompa ne: kinahsih, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts995" TIME_SLOT_REF2="ts996">
                <ANNOTATION_VALUE>Pos yeh kikwa pahpata</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts997" TIME_SLOT_REF2="ts998">
                <ANNOTATION_VALUE>wa:n no: kin..., kininki:xtia m' *pollitos** ka:sá: ka..., kaltsi:ntan kinahsi, k[e:m]eh yo:n kalan kochih no:, no: kiniwi:ka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts999" TIME_SLOT_REF2="ts1000">
                <ANNOTATION_VALUE>N' takwatsi:n kikwa pahpata, kikwa:s *este**, ... Yehwa n' *pollitos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1002">
                <ANNOTATION_VALUE>o** teihsá: mahxili:s san tein a:mo ya no: *porque** pos a:mo, a:mo no: onkak *más** intakwal yehwa:n, *de tanto** no: miakeh ya, mahyá: tehwa:n monechikohkeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts1003" TIME_SLOT_REF2="ts1004">
                <ANNOTATION_VALUE>Pos sanipa no: yowih ya, wehka ki:sah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts1005" TIME_SLOT_REF2="ts1007">
                <ANNOTATION_VALUE>*Por eso** yowih *hasta, hasta** kaltsi:ntan ya *porque** pos kinahsih *pollitos**, [k]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts1013" TIME_SLOT_REF2="ts1014">
                <ANNOTATION_VALUE>Takwakwilo:t yeh tsi:tsikitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts1015" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>wa:n takwatsi:n tein we:i, yeh we:i wa:n yehwa:n no: o:me tamameh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts1017" TIME_SLOT_REF2="ts1018">
                <ANNOTATION_VALUE>*casi** e:yi tamameh de por nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1020">
                <ANNOTATION_VALUE>Takwatsi:n tein we:i tikilwiah nextiktakwatsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts1021" TIME_SLOT_REF2="ts1022">
                <ANNOTATION_VALUE>*mexicano** wa:n tein achi tsiktsi:n tikilwiah ti:ltiktakwatsi:n, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts1023" TIME_SLOT_REF2="ts1025">
                <ANNOTATION_VALUE>Wa:n takwakwilo:t yeh *más** nohne:l pero yeh a:mo se: kimahse:wa, [k]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1030">
                <ANNOTATION_VALUE>*Este** yehwa:n o:me tamameh, a..., e:yi tamameh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts1031" TIME_SLOT_REF2="ts1032">
                <ANNOTATION_VALUE>pero n' *color**, pero *nombre** tein wehwei:n ise:lpe:sohmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1034">
                <ANNOTATION_VALUE>Yehwa:n a:mo miakeh ay mowi:kah, sake:ra o:me:n *o,o** na:wi:n *o** yehwa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts1035" TIME_SLOT_REF2="ts1036">
                <ANNOTATION_VALUE>Wa:n tein, tein tsikitsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1038">
                <ANNOTATION_VALUE>tein wehwei:n nika:n *i:xkwa:rayados**, se: *manchadita** kipiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts1039" TIME_SLOT_REF2="ts1040">
                <ANNOTATION_VALUE>[K]e:mah. Wa:n tein tsikitsitsi:n yehwa:n miakeh ay mowi:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>Mia:keh, a:mo se: sah *o** o:me, e:yin, yehwa:n miakeh, nohne:lmeh, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts1047" TIME_SLOT_REF2="ts1048">
                <ANNOTATION_VALUE>*Pues**, ne:n takwatsi:n nimitsilwih ya no:, takwakwilo..., e:yi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts1049" TIME_SLOT_REF2="ts1050">
                <ANNOTATION_VALUE>Pe:sohmeh no: nimitsilwih ya, no: o:me tamameh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts1051" TIME_SLOT_REF2="ts1052">
                <ANNOTATION_VALUE>Ma:pachimeh yehwa:n no: o:me tamameh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1054">
                <ANNOTATION_VALUE>yetokeh no: n' tein tsiktsitsi:n, yetokeh no: wehwei:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts1055" TIME_SLOT_REF2="ts1057">
                <ANNOTATION_VALUE>Kiliah, tikiliah nehyo:n *español, tejon [tejón]solo**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts1058" TIME_SLOT_REF2="ts1061">
                <ANNOTATION_VALUE>A:chá: ma:..., ¿ke:niw nopi:pilwa:n kito:ka:ytiah? Yehwa:n kimattokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts1062" TIME_SLOT_REF2="ts1064">
                <ANNOTATION_VALUE>*Más** wehwei:n, [k]e:mah, *porque** seki:n nohne:lmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts1065" TIME_SLOT_REF2="ts1066">
                <ANNOTATION_VALUE>wa:n yehwa:n oksé: *color**, a:mo ke:meh pe:soh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts1067" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>Yehwa:n mahyá: *medio** nextikeh. [K]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1071">
                <ANNOTATION_VALUE>Pos oksé: okwilin niki:xmati *sólo** n' tu:san, [k]e:mah, pero yeh a:mo nemi paniá:n de n' ta:l, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts1075" TIME_SLOT_REF2="ts1076">
                <ANNOTATION_VALUE>Pos a:mo we:lik *pero señor** tein nimitsilia ne:chik..., ne:chkwaltihka ne:n epat, ne:n nakat de n' epat, kihtowa kikwa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts1077" TIME_SLOT_REF2="ts1078">
                <ANNOTATION_VALUE>*Pero demás** ne:wí:n tehwa:n a:mo a:kin tik..., ihkó:n tikin..., i:ksá: tikinkwih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts1079" TIME_SLOT_REF2="ts1080">
                <ANNOTATION_VALUE>pero a:mo no: wel tikwa:skeh *porque** tikimpahwiah *porque malos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a564" TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1082">
                <ANNOTATION_VALUE>A:mo, a:mo a:kin tik..., nikaki ne:pa kikwa tu:san</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts1083" TIME_SLOT_REF2="ts1084">
                <ANNOTATION_VALUE>wa:n ihkó:n timolwiah, mm, kih..., ti..., timoliah, ¿tikwa:s n' tu:san?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts1085" TIME_SLOT_REF2="ts1086">
                <ANNOTATION_VALUE>Kihtowa a:mo, *de que** a:mo ke:man nikwa, a:mo nikwa:s. Nikwa:s tein i:pa n'mattok we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts1087" TIME_SLOT_REF2="ts1089">
                <ANNOTATION_VALUE>Ihko:ni nojó:n, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
                <ANNOTATION_VALUE>*Pues, de** okwilimeh a:mo, pero** ne:n de n' epat a:mo no: nikmati toni nojó:n yehwa n' ika motekipanowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1096">
                <ANNOTATION_VALUE>[k]e:mah, a:mo nikmati yo:n, para toni name:chkaya:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts1097" TIME_SLOT_REF2="ts1098">
                <ANNOTATION_VALUE>Pos n' tu:san name:chilwih ya ke:ní:w nojó:n yeh motekipanowa, pero ne:n.... Pos a:mo teh *más** ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts1099" TIME_SLOT_REF2="ts1100">
                <ANNOTATION_VALUE>para oksé: n' taman de okwilimeh *sólo de** a:taw sepa pero oksé: taman ya, a:mo ke:meh tonto:nal [nikpano:lti:ko]nika:n namowa:n, okseki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts1101" TIME_SLOT_REF2="ts1102">
                <ANNOTATION_VALUE>wa:n ekintsi:n okseki, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts1103" TIME_SLOT_REF2="ts1104">
                <ANNOTATION_VALUE>Pero para niktami:lti:s nejí:n tahto:lmeh name:chili:s, xa: ke:meh se: *hora**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts1105" TIME_SLOT_REF2="ts1106">
                <ANNOTATION_VALUE>Pero komohkó:n na:me:chilwia. *Pues** ne: ke:man ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts1107" TIME_SLOT_REF2="ts1108">
                <ANNOTATION_VALUE>neh ni:xpeta:n wa:n nikinitak ok, nehwa a:mo nikchi:wak ok. Kinte:mowa:yah xilimeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts1109" TIME_SLOT_REF2="ts1110">
                <ANNOTATION_VALUE>seki tik..., seki kilia:yah ika *trampa**, to:naya:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts1111" TIME_SLOT_REF2="ts1112">
                <ANNOTATION_VALUE>wa:n seki kinte:mowa:yah ika yowal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts1113" TIME_SLOT_REF2="ts1114">
                <ANNOTATION_VALUE>wa:na:mo kikwah *lámpara** n' ta:tahmeh ta: kikwiah kanti:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts1115" TIME_SLOT_REF2="ts1116">
                <ANNOTATION_VALUE>A:mo tiki:xmatiah yo:n *lámpara**, a:mo tiki:xmatiah *este**, i:n tein a:xka:n onkak tane:x.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts1117" TIME_SLOT_REF2="ts1118">
                <ANNOTATION_VALUE>Okseki. *Pues lo...,** ekinika nojó:n *trampa** kit kichi:wayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts1119" TIME_SLOT_REF2="ts1120">
                <ANNOTATION_VALUE>nemih ok tein nojó:n kichi:wayah. *Pues** tehwa:n tikitayah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts1121" TIME_SLOT_REF2="ts1122">
                <ANNOTATION_VALUE>*nojefecito** katka ke:meh i:pa nitamattok a ki..., *kienca**..., kinintekowa:ya, ki:xmattoya n' a:kin kin..., kinkwia nojó:n xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts1123" TIME_SLOT_REF2="ts1124">
                <ANNOTATION_VALUE>Ihkó:n panowa:ya, de ya..., e:waya de nika:n San Miguel, ya:ya para ne: tani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts1125" TIME_SLOT_REF2="ts1126">
                <ANNOTATION_VALUE>Ya:ya, *pariente**, *pariente**. ¿Tikinkwiti xilimeh? Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts1127" TIME_SLOT_REF2="ts1128">
                <ANNOTATION_VALUE>¿Tikinkwi:s? Ke:meh ki:xmattoya ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts1129" TIME_SLOT_REF2="ts1130">
                <ANNOTATION_VALUE>Wa:n de n' *palomas**, no: mokalakia:ya se: tokni:w, no:, no: kinkwia semi, no: kitekowilia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts1131" TIME_SLOT_REF2="ts1132">
                <ANNOTATION_VALUE>*Todavía** name:chilia de nojó:n xilimeh pos kilwia, "¿ka:nachi tikneki?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts1133" TIME_SLOT_REF2="ts1134">
                <ANNOTATION_VALUE>"Pos neh kwali nimitstahtani:s ke:meh n'nekis, pero a:mo n'mati ox tikinkwis".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts1135" TIME_SLOT_REF2="ts1136">
                <ANNOTATION_VALUE>"Ke:mah, ta: niow nikinkwiti a:mo niow soh ni..., nikinitati".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts1137" TIME_SLOT_REF2="ts1138">
                <ANNOTATION_VALUE>Kwi:ka, yo:wi kwi:ka ne:n se: *bolsita** kichihchi:wa mahyá: ma:tat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts1139" TIME_SLOT_REF2="ts1140">
                <ANNOTATION_VALUE>wa:n ompa ne: kinte:mohtahsi para kinkwis, ompa kite:mohtahsi itech n' a:me:yalmeh nejó:n tikiliah kwa:poye:kxilimeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts1141" TIME_SLOT_REF2="ts1142">
                <ANNOTATION_VALUE>wa:n kwi:ka se: ma:tat wa:n mochi..., mowihwi:ka ompa ne:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts1143" TIME_SLOT_REF2="ts1144">
                <ANNOTATION_VALUE>Wa:n ompa ne: ki..., ke:meh ompa de ika tekitia pos ompa kie:waya se: *garrocha** we:i, sake:ra de ..., sake:ra de ma:kwi:l *vara o** sake:ra de chikwa:se:n *vara** de weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts1145" TIME_SLOT_REF2="ts1146">
                <ANNOTATION_VALUE>para nojó:n *trampa pues** ki..., kilpilia yo:n *hilito** wa:n nojó:n *bolsita** kihtikahkalakilia ne:n kwa:poye:kxilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts1147" TIME_SLOT_REF2="ts1148">
                <ANNOTATION_VALUE>Entó:s kilpialia nojó:n *bolsita** ikwa:pan nojó:n *garrocha** wa:n ma:tat kichihchi:waya metsweyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts1149" TIME_SLOT_REF2="ts1150">
                <ANNOTATION_VALUE>*Porque** ya:ti ne: a:mo paya:n, ka:mpa wehwei *pozas**, sake:ra *de ocho varas de** wehkatan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts1151" TIME_SLOT_REF2="ts1152">
                <ANNOTATION_VALUE>ka:mpa a:mo a:kin m..., motoki:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts1153" TIME_SLOT_REF2="ts1154">
                <ANNOTATION_VALUE>*porque** yehwa kimattok kinkwiti we:hwei:n, a:mo kinkwiti tsikitsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts1155" TIME_SLOT_REF2="ts1156">
                <ANNOTATION_VALUE>*porque** ne: ke:man onkayah, a:mo ke:meh a:xka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts1157" TIME_SLOT_REF2="ts1158">
                <ANNOTATION_VALUE>A:xka:n a:mo..., se: ya:s i:pa ne:nkah wa:n tein a:mo, a:mo tit..., a:mo tita..., titamachti:lmeh i:pa a:mo no: tia:skeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts1159" TIME_SLOT_REF2="ts1160">
                <ANNOTATION_VALUE>Pero yehwa:n momattoyah, pos ya:ya yo:n *señor** mo:stah, wihwi:ptika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts1161" TIME_SLOT_REF2="ts1162">
                <ANNOTATION_VALUE>*Nojefecito** katka pos niktohtokatinemia ompa ne:, ka..., neh katka ninohne:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts1163" TIME_SLOT_REF2="ts1164">
                <ANNOTATION_VALUE>Tio:taki de *las cinco, las seis**, ehko ya *señor**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts1165" TIME_SLOT_REF2="ts1166">
                <ANNOTATION_VALUE>"'Mitsahsiko ya *pariente**". "*Bueno**". "¿Tikiwa:lkwi". "Ke:mah".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a606" TIME_SLOT_REF1="ts1167" TIME_SLOT_REF2="ts1168">
                <ANNOTATION_VALUE>"¿Ka:nachi t'neki?" "*A ver cinco pesos**, ma:kwil *peso**" kilia, "xine:chmaka".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts1169" TIME_SLOT_REF2="ts1171">
                <ANNOTATION_VALUE>Pero pos ne: ke:mah ma:kwil *peso** mia:kxilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a608" TIME_SLOT_REF1="ts1172" TIME_SLOT_REF2="ts1174">
                <ANNOTATION_VALUE>Nejó:n tomi:n miak katka. O:me to:nal tite:pale:wi:s, [k]e:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609" TIME_SLOT_REF1="ts1175" TIME_SLOT_REF2="ts1176">
                <ANNOTATION_VALUE>Ihkó:n neh ni:xpeta:n yo:n tomi:n, we:noh, *este**, monechi..., ne: monechikowa:ya de ma:kwil *peso**, o:me to:nal tite:pale:wi:s nikitaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610" TIME_SLOT_REF1="ts1177" TIME_SLOT_REF2="ts1178">
                <ANNOTATION_VALUE>*Porque** ne: *nojefecito** no: tayo:le:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts1179" TIME_SLOT_REF2="ts1180">
                <ANNOTATION_VALUE>Entó:s *este**, ki..., kinimakaya wa:n wi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612" TIME_SLOT_REF1="ts1181" TIME_SLOT_REF2="ts1182">
                <ANNOTATION_VALUE>"¡E:y!", kilia "Ke:maniá:n *pariente**" kilia "sepa tiwa:la:s sepa tine:chinwa:[lkwili:s],</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a613" TIME_SLOT_REF1="ts1183" TIME_SLOT_REF2="ts1184">
                <ANNOTATION_VALUE>[k]e:m[mah". "We:noh, we:noh", kilia. "Pos seki, seki nikinka:wtahsi" kilia "ne:pa, no: *encargo**. No: ne:chtahtanihtokeh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a614" TIME_SLOT_REF1="ts1185" TIME_SLOT_REF2="ts1186">
                <ANNOTATION_VALUE>We:noh. Entó:s *cuando** sepa yowi, pos se..., sepa kimakaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts1187" TIME_SLOT_REF2="ts1188">
                <ANNOTATION_VALUE>Pero yo:n pos semi owih, to:nal a nojo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a616" TIME_SLOT_REF1="ts1189" TIME_SLOT_REF2="ts1190">
                <ANNOTATION_VALUE>Mota:li:tih ka:mpa wehkatan, ka:mpa *pozo** wa:n no: n' *garrocha** kipankalaki:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617" TIME_SLOT_REF1="ts1191" TIME_SLOT_REF2="ts1192">
                <ANNOTATION_VALUE>wa:n a:mo moli:ni:s. Ompa mah eto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a618" TIME_SLOT_REF1="ts1193" TIME_SLOT_REF2="ts1194">
                <ANNOTATION_VALUE>Ka:mpa ... Wa:n kimachili:s koholi:niah ya ne:n *garrocha**, ihkó:n kitihtila:nah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a619" TIME_SLOT_REF1="ts1195" TIME_SLOT_REF2="ts1196">
                <ANNOTATION_VALUE>ke:mah yo:li:k kitila:nas a wa:n ma:tat kitokili:s ika se: ima:y ya itampa, yo:li:k kitila:nas a *garrocha**, kitila:..., [kitila:]na,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a620" TIME_SLOT_REF1="ts1197" TIME_SLOT_REF2="ts1198">
                <ANNOTATION_VALUE>ompa wi:tsa ya ne:n xili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a621" TIME_SLOT_REF1="ts1199" TIME_SLOT_REF2="ts1200">
                <ANNOTATION_VALUE>Ompa wi:tsa ya, ne:n itech *bolsita** pilkatiwi:ts *porque** ke:yeh, ki..., mahyá: no: yo:n tehwa:n tik..., tikmatih ton tikwah ne:wí:n, a:mo wel tikahka:waskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a622" TIME_SLOT_REF1="ts1201" TIME_SLOT_REF2="ts1202">
                <ANNOTATION_VALUE>Tiki..., kikwitki:tskihtiwi:ts pos yeh a:mo kimati ox kikwitih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts1203" TIME_SLOT_REF2="ts1204">
                <ANNOTATION_VALUE>Ki..., kitokilia ya ma:tat, ompa kipankalakia ya wa:n kiki:xtia ya para kalampa ya, kikwi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a624" TIME_SLOT_REF1="ts1205" TIME_SLOT_REF2="ts1206">
                <ANNOTATION_VALUE>Entó:s ke:wa ya nojó:n, no:[jó:]n xili. Pero y[ehw]a ya name:chilia *este** nojó:n xilimeh kinkwiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a625" TIME_SLOT_REF1="ts1207" TIME_SLOT_REF2="ts1208">
                <ANNOTATION_VALUE>taihitalmeh. Yehwa ne:n ito:ka:y *pinto**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts1209" TIME_SLOT_REF2="ts1210">
                <ANNOTATION_VALUE>ko:so:limeh n' tikiniliah pero to:ka:yehkeh no: wa:n *color** no: tamameh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a627" TIME_SLOT_REF1="ts1211" TIME_SLOT_REF2="ts1212">
                <ANNOTATION_VALUE>*Pinto** tikiliah kipia ista:k wa:n ti:ltik *rayados**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a628" TIME_SLOT_REF1="ts1213" TIME_SLOT_REF2="ts1214">
                <ANNOTATION_VALUE>Wa:n tikiliah me:kohko:so:lin, yeh senki:s tihti:..., ti:ltik mahyá: *medio** me:koh neli, ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629" TIME_SLOT_REF1="ts1215" TIME_SLOT_REF2="ts1216">
                <ANNOTATION_VALUE>Yehwa nojó:n kinkwiah. Kinkwia n' ta:katsí:n wa:n kisentilia:ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630" TIME_SLOT_REF1="ts1217" TIME_SLOT_REF2="ts1218">
                <ANNOTATION_VALUE>wa:n ke:mah ki..., pos ka:mpa kimattok kitahtania:yah pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631" TIME_SLOT_REF1="ts1219" TIME_SLOT_REF2="ts1220">
                <ANNOTATION_VALUE>a:mo ne..., a:mo ne:nkah ya:ya n' a:taw, kita:lia:ya n' *irato, porque** pos ihwa:k se: ma:kwi:l *peso** tomi:n katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a632" TIME_SLOT_REF1="ts1221" TIME_SLOT_REF2="ts1222">
                <ANNOTATION_VALUE>Se: *diez pesos** pos tomi:n ya katka kwali. Yeh kita:nia ya *más que todo que** te:tekitili:skia kahfe:ntah *o** ihkó:n mi:lah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a633" TIME_SLOT_REF1="ts1223" TIME_SLOT_REF2="ts1224">
                <ANNOTATION_VALUE>Kimattok *que** a:mo..., ya:ti pero *más** kita:niti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634" TIME_SLOT_REF1="ts1225" TIME_SLOT_REF2="ts1226">
                <ANNOTATION_VALUE>Entó:s yehwa yo:n *señor** kinkwia wa:n okseki:n ompa ne:pa tani, welia seki:n no, pos no: mokwala:ntia:yah n' a:taw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a635" TIME_SLOT_REF1="ts1227" TIME_SLOT_REF2="ts1228">
                <ANNOTATION_VALUE>*[por]que** tine:chpanawih neh ampó:n nikinkwiskia. [K]e:mah, ekintsi:n nia:ti seko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a636" TIME_SLOT_REF1="ts1229" TIME_SLOT_REF2="ts1230">
                <ANNOTATION_VALUE>Ompa moahwayah, pero ke:meh tikihtowah n' tehwa:n pos a:taw a:mo a:kin ia:xka *cada quien libre** pos toni ne:n mote:moli:s, a:taw *libre**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a637" TIME_SLOT_REF1="ts1231" TIME_SLOT_REF2="ts1232">
                <ANNOTATION_VALUE>Entó:s kinte:mowa:ya nojó:n ta:katsí:n, de nojó:n de n' *trampas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638" TIME_SLOT_REF1="ts1233" TIME_SLOT_REF2="ts1234">
                <ANNOTATION_VALUE>Wa:n nojó:n ki..., a:kin kiniwa:tsaya pos kiniwa:tsaya de ne: tein kinkowilia:ya wa:n a:kin niman kikwa:ya pos ata nojó:n xilitsi:n we:lik *este..., mantecado**, de xoxowik semi we:lkeh, [k]e:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a639" TIME_SLOT_REF1="ts1235" TIME_SLOT_REF2="ts1236">
                <ANNOTATION_VALUE>wa:n tein a:mo pos kiwa:tsaya wa:n kichi:lposo:wilia:yah *o** a:ko:loh kikwa:yah, tapalo:l a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a640" TIME_SLOT_REF1="ts1237" TIME_SLOT_REF2="ts1238">
                <ANNOTATION_VALUE>Ihkó:n nojó:n, mm. Wa:n ne:n nojó:n *este**, tine:chtapowia:ya mah no: name:chtapowi de n' a:chikiwit, yo:n no: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a641" TIME_SLOT_REF1="ts1239" TIME_SLOT_REF2="ts1240">
                <ANNOTATION_VALUE>Yo:n..., *este, de** n' a:chikiwit no: yetok sah katí:n komekat no: yo:n kikwih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a642" TIME_SLOT_REF1="ts1241" TIME_SLOT_REF2="ts1242">
                <ANNOTATION_VALUE>wa:n etok sah ke:ní:w n' kipe:waltiah n' kichihchi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643" TIME_SLOT_REF1="ts1243" TIME_SLOT_REF2="ts1244">
                <ANNOTATION_VALUE>Wa:n se: no:kichpil no: momachtihka ya pero a:mo kipiak *salida**. Tak pi:na:wak *o** a:it ke:yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a644" TIME_SLOT_REF1="ts1245" TIME_SLOT_REF2="ts1246">
                <ANNOTATION_VALUE>pos neh nikilwia, "xikiniwi:ka" nikilia "a:mo tikita yo:n *señor**" nikilia ne: *Cuetzalan** kiniwi:katinemi".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a645" TIME_SLOT_REF1="ts1247" TIME_SLOT_REF2="ts1248">
                <ANNOTATION_VALUE>Kinchihchi:waya *sombreros de** komekat, kichihchi:wa nojó:n yehwa de n', ne:n a:chikiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646" TIME_SLOT_REF1="ts1249" TIME_SLOT_REF2="ts1250">
                <ANNOTATION_VALUE>Ompa ne: iwki yetokeh ok, pala:nkeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a647" TIME_SLOT_REF1="ts1251" TIME_SLOT_REF2="ts1252">
                <ANNOTATION_VALUE>We:li pero, no: nikitaya sah n' kichihchi:wa, kichihchihkolowa n' komekat wa:n kipe:waltia *hasta** tamiti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a648" TIME_SLOT_REF1="ts1253" TIME_SLOT_REF2="ts1254">
                <ANNOTATION_VALUE>kwaltsi:n moka:wa mahyá: xi:kal ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a649" TIME_SLOT_REF1="ts1255" TIME_SLOT_REF2="ts1256">
                <ANNOTATION_VALUE>Yo:n, yo:n *este**, para n' xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a650" TIME_SLOT_REF1="ts1257" TIME_SLOT_REF2="ts1258">
                <ANNOTATION_VALUE>De yo:n tikinchihxhi:was itsi:ntan tapo:tok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a651" TIME_SLOT_REF1="ts1259" TIME_SLOT_REF2="ts1260">
                <ANNOTATION_VALUE>ihkó:n chihchi:wtok, yewaltik, keptok n' kwomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a652" TIME_SLOT_REF1="ts1261" TIME_SLOT_REF2="ts1262">
                <ANNOTATION_VALUE>[Sa]ke:ra i:xchikwe:i *o** chikwase:n tein tikiliah i..., ichika:wka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653" TIME_SLOT_REF1="ts1263" TIME_SLOT_REF2="ts1264">
                <ANNOTATION_VALUE>para ompa pa:pano:tiw ihkó:n, tikiliah mone:nekwalo:tihtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a654" TIME_SLOT_REF1="ts1265" TIME_SLOT_REF2="ts1266">
                <ANNOTATION_VALUE>Entó:s ne:n tatampa moka:wa se: *hoy..., hoy..., hoy..., hoyito**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a655" TIME_SLOT_REF1="ts1267" TIME_SLOT_REF2="ts1268">
                <ANNOTATION_VALUE>Wa:n yo:n, tate:noh moka:wati no: tsiktsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656" TIME_SLOT_REF1="ts1269" TIME_SLOT_REF2="ts1270">
                <ANNOTATION_VALUE>[k]e:mah, no: keptok tepitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a657" TIME_SLOT_REF1="ts1271" TIME_SLOT_REF2="ts1272">
                <ANNOTATION_VALUE>Entó:s *este**, kichihchi:wah, ompa moka:wa ya yo:n para ne:n a:taw kiniwi:kah *pues**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658" TIME_SLOT_REF1="ts1273" TIME_SLOT_REF2="ts1274">
                <ANNOTATION_VALUE>a:mo ise:lti, kita:liliah nakat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a659" TIME_SLOT_REF1="ts1275" TIME_SLOT_REF2="ts1276">
                <ANNOTATION_VALUE>tein *huesitos**, pero kinta:lili:tih yowak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660" TIME_SLOT_REF1="ts1277" TIME_SLOT_REF2="ts1278">
                <ANNOTATION_VALUE>De tapoya:wi kiniwi:kah sake:ra *seis o ocho o diez**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661" TIME_SLOT_REF1="ts1279" TIME_SLOT_REF2="ts1280">
                <ANNOTATION_VALUE>kinta:li:tih ka:mpa ne: wehkatan, ka:mpa ki:saskeh tein wehwei:n *porque** yo:n itech mokalakiah taihitalmeh sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a662" TIME_SLOT_REF1="ts1281" TIME_SLOT_REF2="ts1282">
                <ANNOTATION_VALUE>A:mo se: kimati ke:yeh *porque** n' tein nohne:lmeh a:mo moka:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663" TIME_SLOT_REF1="ts1283" TIME_SLOT_REF2="ts1284">
                <ANNOTATION_VALUE>*Solamente** tein wehwei:n. Ompa ne: kinkalaki:tih, a:kin, a:kin a:mo kochisneki pos ompa kimpixtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664" TIME_SLOT_REF1="ts1285" TIME_SLOT_REF2="ts1286">
                <ANNOTATION_VALUE>Wa:n a:kin a:mo, kinta:li:ti pero y[ehw]a name:chilia komo kitak a:ksá: ne:n kinta:li:to pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665" TIME_SLOT_REF1="ts1287" TIME_SLOT_REF2="ts1288">
                <ANNOTATION_VALUE>kinchi:xti:tiw yeh wa:n a:mo teh kikwiti:w ok yeh. Iwki a sah n' kahsiti:w ne:n n' na:chikiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666" TIME_SLOT_REF1="ts1289" TIME_SLOT_REF2="ts1290">
                <ANNOTATION_VALUE>Entó:s n' a:kin ne: kipia *cuidado** pos kinki:xti:s sake:ra se:, se: *cuatro kilos**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667" TIME_SLOT_REF1="ts1291" TIME_SLOT_REF2="ts1292">
                <ANNOTATION_VALUE>de ko:so:limeh, mo:stika. Komo kinkwa:s, kinkwa:s *o** kininamakas, kininamakas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668" TIME_SLOT_REF1="ts1293" TIME_SLOT_REF2="ts1294">
                <ANNOTATION_VALUE>Pero kinihilpiah ika kwahkwali *hilos**. Ihkó:n nojó:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669" TIME_SLOT_REF1="ts1295" TIME_SLOT_REF2="ts1296">
                <ANNOTATION_VALUE>Pero pos semi *trabajo**. Achto kite:mowah n' komekat para kichihchi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670" TIME_SLOT_REF1="ts1297" TIME_SLOT_REF2="ts1298">
                <ANNOTATION_VALUE>We:noh, yo:n oksé:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671" TIME_SLOT_REF1="ts1299" TIME_SLOT_REF2="ts1300">
                <ANNOTATION_VALUE>A:man oksé: sepa tiowih pero de n' a:chikiwit no: pero de n' oksé: *tamaño**, semi *sencillo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672" TIME_SLOT_REF1="ts1301" TIME_SLOT_REF2="ts1302">
                <ANNOTATION_VALUE>Se: kihto:s a:mo motsakwiliah ne:n xilimeh wa:n ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a673" TIME_SLOT_REF1="ts1303" TIME_SLOT_REF2="ts1304">
                <ANNOTATION_VALUE>*Porque** nehwa nikitak *porque** seki noparientes nemih ne: nehyo:n Huitzilan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674" TIME_SLOT_REF1="ts1305" TIME_SLOT_REF2="ts1306">
                <ANNOTATION_VALUE>se: *tiempo** yetoyah ne:pa wa:n ne:chne:xtilihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675" TIME_SLOT_REF1="ts1307" TIME_SLOT_REF2="ts1308">
                <ANNOTATION_VALUE>Wa:n se: *nocuñado** nikpia pos iwa:n nitekitia ika *sierra**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a676" TIME_SLOT_REF1="ts1309" TIME_SLOT_REF2="ts1310">
                <ANNOTATION_VALUE>Y[ehw]a name:chilwia ne:n ya:lwa, yowi:pta ke neh no: nitekitik se: *algo de tiempo** nojó:n ika *sierra**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677" TIME_SLOT_REF1="ts1311" TIME_SLOT_REF2="ts1312">
                <ANNOTATION_VALUE>*Pues** ompa ne: niehkok a..., niahsik ompa ne:, ikalihtik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678" TIME_SLOT_REF1="ts1313" TIME_SLOT_REF2="ts1314">
                <ANNOTATION_VALUE>[tik]tekiah n' kowit. Kihtowa "ne: kwalka:n ok" kihtowa "*cuñado**". Nikilia "kwalka:n ok".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679" TIME_SLOT_REF1="ts1315" TIME_SLOT_REF2="ts1316">
                <ANNOTATION_VALUE>Wa:n kihtowa "ne:h aya:mo nitakwa". "Aya:mo titakwa". Nikilia "titelkochik"."Ke:mah" kihtowa "ta: se: siowi".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a680" TIME_SLOT_REF1="ts1317" TIME_SLOT_REF2="ts1318">
                <ANNOTATION_VALUE>Ne: ne:chwa:ntikeh *cafecito**, nita:ik. Kihtowa "xiwa:lpano xitakwa:ki, neh nitakwa:ti". Nikilia "we:noh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681" TIME_SLOT_REF1="ts1319" TIME_SLOT_REF2="ts1320">
                <ANNOTATION_VALUE>*hijo de la mala**, ne: ni..., nimota:lito, pe:wak iwa:n nitakwa *nocuñado**, pos timotasohtah mahyá: ti:kni:tsitsi:n, pe:wak tisentakwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a682" TIME_SLOT_REF1="ts1321" TIME_SLOT_REF2="ts1322">
                <ANNOTATION_VALUE>¡Uta!, ne:chta:lilih se: *plato de** xilimeh, pero ke:meh *ocho** nimah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683" TIME_SLOT_REF1="ts1323" TIME_SLOT_REF2="ts1324">
                <ANNOTATION_VALUE>"*Cuñado**" nikilia "pero a:mo nikintami:s" nikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a684" TIME_SLOT_REF1="ts1325" TIME_SLOT_REF2="ts1326">
                <ANNOTATION_VALUE>Kihtowa "pero ta: teh xitakwa kihtowa, titekitih a:mo tima:wilti:tih". "We:noh". "Ta: i:n a:man sah".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a685" TIME_SLOT_REF1="ts1327" TIME_SLOT_REF2="ts1328">
                <ANNOTATION_VALUE>"A:mo a:man sah" nikilia, "*mientras** tinemiskeh" nikilia "nejó:n tik..., tikwa:skeh *cuando** ne:sis wa:n *cuando a:mo tikihyo:wi:skeh" nikilia. Kihtowa "neli".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a686" TIME_SLOT_REF1="ts1329" TIME_SLOT_REF2="ts1330">
                <ANNOTATION_VALUE>"Teh xitakwa" kihtowa. Pe:wak nitakwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a687" TIME_SLOT_REF1="ts1331" TIME_SLOT_REF2="ts1332">
                <ANNOTATION_VALUE>*Nosuegra** katka, a:mo yetok. Nikita ehkok ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a688" TIME_SLOT_REF1="ts1333" TIME_SLOT_REF2="ts1334">
                <ANNOTATION_VALUE>Kwa:lkwi se: *cubeta** we:i, se: *color de rosa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689" TIME_SLOT_REF1="ts1335" TIME_SLOT_REF2="ts1336">
                <ANNOTATION_VALUE>Kihtowa "niwa:lah *hijo**" kilwia. "I:n ke:ní:w eski" kilwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a690" TIME_SLOT_REF1="ts1337" TIME_SLOT_REF2="ts1338">
                <ANNOTATION_VALUE>"M..., ¿mo..., mokalakihkeh?". Kilia "ke:mah".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a691" TIME_SLOT_REF1="ts1339" TIME_SLOT_REF2="ts1340">
                <ANNOTATION_VALUE>"Toni" nikilia "n..., ¿toni *suegra**" nikilia. *E..., en español** nikihtohtok. "¿Toni momá:n?" nikilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692" TIME_SLOT_REF1="ts1341" TIME_SLOT_REF2="ts1342">
                <ANNOTATION_VALUE>Kihtowa "i:n xilimeh". "¿Wa:n ka:ni n' tikinkwito?, ta: kwalka:n ok".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693" TIME_SLOT_REF1="ts1343" TIME_SLOT_REF2="ts1344">
                <ANNOTATION_VALUE>"Ne: a:taw" kihtowa, "yetok seki, seki *trampa**", kihtowa "wa:n ompa nikinki:xti:to".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694" TIME_SLOT_REF1="ts1345" TIME_SLOT_REF2="ts1346">
                <ANNOTATION_VALUE>Pero mia:k, *como diez kilos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695" TIME_SLOT_REF1="ts1347" TIME_SLOT_REF2="ts1348">
                <ANNOTATION_VALUE>Wa:n miak xilimeh. Sa moli:nihtokeh pos ta: yo:ltokeh, ka:n mikih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696" TIME_SLOT_REF1="ts1349" TIME_SLOT_REF2="ts1350">
                <ANNOTATION_VALUE>Kilia ne:n, ne:n iokichpil, "xkin..., 'kimpa:ka kwali" kilia "wa:n xkiniwa:tsa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a697" TIME_SLOT_REF1="ts1351" TIME_SLOT_REF2="ts1352">
                <ANNOTATION_VALUE>[wa:]n [tik]inkwa:skeh" kilia, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698" TIME_SLOT_REF1="ts1353" TIME_SLOT_REF2="ts1354">
                <ANNOTATION_VALUE>Entó:s ne: nikilwia ne: *nocuñado**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699" TIME_SLOT_REF1="ts1355" TIME_SLOT_REF2="ts1356">
                <ANNOTATION_VALUE>"¿Toni n' tik..., toni nankita:lilihtokeh *cuñado**" nikilia "ne:n i:n kinkwito ne:n momá:n, momá:n" nikilia "ne:n xilimeh" nikilia "ye:k kwalka:n sah, ta pos ekintsi:n a:mo ki:sah" nikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700" TIME_SLOT_REF1="ts1357" TIME_SLOT_REF2="ts1358">
                <ANNOTATION_VALUE>Kihtowa "ta se: *trampa** nikpia *cuñado** i:n kaltsi:ntan" kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a701" TIME_SLOT_REF1="ts1359" TIME_SLOT_REF2="ts1360">
                <ANNOTATION_VALUE>"¿Toni?", nikilia. "Se *trampa**, tikitas ekintsi:n" kihtowa. "A: ke:mah" nikilia. Kihtowa "ke:mah".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a702" TIME_SLOT_REF1="ts1361" TIME_SLOT_REF2="ts1362">
                <ANNOTATION_VALUE>Ke:mah, se: *trampa** semi taman sah. "¿Wa:n a:koni mitsne:xtilih?" Kihtowa "ne: *noprimos** de Huitzilan", kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a703" TIME_SLOT_REF1="ts1363" TIME_SLOT_REF2="ts1364">
                <ANNOTATION_VALUE>"¡Ah! ¿*Cuando** yo:n wa:lahkah?" nikilia. "Kihtowa" ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a704" TIME_SLOT_REF1="ts1365" TIME_SLOT_REF2="ts1366">
                <ANNOTATION_VALUE>"Tikitas" kihtowa. We:n[noh], "teh xitakwa" kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a705" TIME_SLOT_REF1="ts1367" TIME_SLOT_REF2="ts1368">
                <ANNOTATION_VALUE>Titakwahkeh wa:n timose:wihkeh. "O:rah tipe:waskeh ma:ski nepantah, ta: se: siowi", kih[towa]. Nikilia "neli, se: siowi".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706" TIME_SLOT_REF1="ts1369" TIME_SLOT_REF2="ts1370">
                <ANNOTATION_VALUE>*Después** kihtowa s..., e:..., "tiowih" kihtowa "semi tikitatih para tikneltokas" kihtowa, "a:mo tikihto:s" kihtowa "ne:n tomá:n" kihtowa "nehyo:n *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707" TIME_SLOT_REF1="ts1371" TIME_SLOT_REF2="ts1372">
                <ANNOTATION_VALUE>xa: a:ksá: kikowilih *o** xa: a:ksá: kitahtanih ne: a:taw", [kih]t[ow]a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a708" TIME_SLOT_REF1="ts1373" TIME_SLOT_REF2="ts1374">
                <ANNOTATION_VALUE>[Nikilia], "We:noh". Tiahkeh. Tikahsitoh ya ne:n se: *tecorral**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a709" TIME_SLOT_REF1="ts1375" TIME_SLOT_REF2="ts1376">
                <ANNOTATION_VALUE>De a:te:n *hasta** a:te:n, ihkwí:n *tanto de** n' sa:liwtok, *como de** se: *vara más**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a710" TIME_SLOT_REF1="ts1377" TIME_SLOT_REF2="ts1378">
                <ANNOTATION_VALUE>*Más** wa:n ahko *pozo** mahyá: mosentilih n' a:t. Se: a:xoxowi:l mochi:w, mochi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a711" TIME_SLOT_REF1="ts1379" TIME_SLOT_REF2="ts1380">
                <ANNOTATION_VALUE>ke:mah. "Nika:n", kihtowa, "yetokeh n' *trampas**". "¿Ke:ní:w" nikilia "tikchi:w?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a712" TIME_SLOT_REF1="ts1381" TIME_SLOT_REF2="ts1382">
                <ANNOTATION_VALUE>"Ta: tiowih" kih[towa]"tikitas sah", kihtowa. Niah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a713" TIME_SLOT_REF1="ts1383" TIME_SLOT_REF2="ts1384">
                <ANNOTATION_VALUE>Entó:s nikita se kowit ke:m..., ke:meh se: kowit ka:ni n' kikwito, xa: mopale:wihkeh, we:i ke:meh ne: tio:kowmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a714" TIME_SLOT_REF1="ts1385" TIME_SLOT_REF2="ts1386">
                <ANNOTATION_VALUE>Sempano:tok *hasta** tate:n wa:n yo:n kowit pahpachiwtok ika n' tet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a715" TIME_SLOT_REF1="ts1387" TIME_SLOT_REF2="ts1388">
                <ANNOTATION_VALUE>Wehwei tet. No: to:nal tak kichi:w..., kichi:wayah, to:nal a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a716" TIME_SLOT_REF1="ts1389" TIME_SLOT_REF2="ts1390">
                <ANNOTATION_VALUE>"wa:n ¿ke:ní:w i:n tikchi:wak?" Kihtowa, "Ne: niksentilih", kihtowa, "miak tet".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a717" TIME_SLOT_REF1="ts1391" TIME_SLOT_REF2="ts1392">
                <ANNOTATION_VALUE>"¿Wa:n a:koni ni..., mitsne:xtinilih? I:n a:mo ke:man nikita", nikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a718" TIME_SLOT_REF1="ts1393" TIME_SLOT_REF2="ts1394">
                <ANNOTATION_VALUE>Kiht[ow]a, "Ne: *noprimos**".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a719" TIME_SLOT_REF1="ts1395" TIME_SLOT_REF2="ts1396">
                <ANNOTATION_VALUE>"¿Wa:n mokalakiah", nik[il]ia, "xilimeh?" "Ke:mah. Xkita to...". "¿Ke:ní:w?" Kihtowa, "Ta: ne: etokeh n' a:chikiwmeh". "¿Ka:ni?", nik[ili]a. "Ne a:tampa", kiht[ow]a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a720" TIME_SLOT_REF1="ts1397" TIME_SLOT_REF2="ts1398">
                <ANNOTATION_VALUE>Kiki:xtih ya se:, pero a:mo se: kineltokas, moitstok ke:meh ne: *corral** ne: tohto:ktok, i:ihkwí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a721" TIME_SLOT_REF1="ts1399" TIME_SLOT_REF2="ts1400">
                <ANNOTATION_VALUE>Tahtapo:tok wehwei. Ihkwí:n de we:wehkapan, *como de, de setenta, sesenta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a722" TIME_SLOT_REF1="ts1401" TIME_SLOT_REF2="ts1402">
                <ANNOTATION_VALUE>Ihkó:n wa:n itsi:ntan pos tsiktsí:n, yeh olo:chtik, yeh a:mo ke:meh oksé: name:chilwihtoya a:chikiwit, yeh olo:chtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723" TIME_SLOT_REF1="ts1403" TIME_SLOT_REF2="ts1404">
                <ANNOTATION_VALUE>*Como que** tsi:mpitsaktik wa:n ilpitok pero ahko tapo:..., tahtapo:tok a ihkó:n, wehwei pero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724" TIME_SLOT_REF1="ts1405" TIME_SLOT_REF2="ts1406">
                <ANNOTATION_VALUE>"¿Wa:n ke:ní:w", nikilia "n' tikinkwi? ¿Ton tikinta:lilia?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725" TIME_SLOT_REF1="ts1407" TIME_SLOT_REF2="ts1408">
                <ANNOTATION_VALUE>"Ta: i:n", kihtowa, "a:mo teh se: kinta:lilia" kiht[ow]a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726" TIME_SLOT_REF1="ts1409" TIME_SLOT_REF2="ts1410">
                <ANNOTATION_VALUE>"I:n", kihtowa, "sayoh "wi:tseh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a727" TIME_SLOT_REF1="ts1411" TIME_SLOT_REF2="ts1412">
                <ANNOTATION_VALUE>"Pero a:mo mela:w". Ke:mah, "¿A:mo tikitak" kihtowa "ne: momá:n kinkwiko ye:wa?" kihtowa, "miakeh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728" TIME_SLOT_REF1="ts1413" TIME_SLOT_REF2="ts1414">
                <ANNOTATION_VALUE>Kiht[ow]a, "Wi:tseh wa:n pexo:nih. Seki pexo:nih, seki kanah, seki tepitsi:n mota:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a729" TIME_SLOT_REF1="ts1415" TIME_SLOT_REF2="ts1416">
                <ANNOTATION_VALUE>O:me, e:yi:n wa:n seki ihkó:n", kihtowa, "kipia de nochi se: kinitas, sakera *diez o quince canastas**".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730" TIME_SLOT_REF1="ts1417" TIME_SLOT_REF2="ts1418">
                <ANNOTATION_VALUE>Ihkó:n kintekpa:naya *derechito**, pero wehkatan moka:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731" TIME_SLOT_REF1="ts1419" TIME_SLOT_REF2="ts1420">
                <ANNOTATION_VALUE>Ihkó:n *paraditos** "para ne: *cuando** wi:tsa", kihtowa, "n' a:t kiniwa:lkwi xilimeh ke:meh i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732" TIME_SLOT_REF1="ts1421" TIME_SLOT_REF2="ts1422">
                <ANNOTATION_VALUE>pan..., pawetsi a n' a:t, nochi iihtik wetsitih nojó:n xilimeh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733" TIME_SLOT_REF1="ts1423" TIME_SLOT_REF2="ts1424">
                <ANNOTATION_VALUE>"Pero a:[i]t ke:ní:w", nikilia, "*porque** nehwa", nikilia, "a:mo n'mati i:n ke:ní:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734" TIME_SLOT_REF1="ts1425" TIME_SLOT_REF2="ts1426">
                <ANNOTATION_VALUE>A:mo ke:man nikita", nikilia. "Ke:mah yehwa[n]iwki n' ompa", kiht[ow]a, "kichi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735" TIME_SLOT_REF1="ts1427" TIME_SLOT_REF2="ts1428">
                <ANNOTATION_VALUE>Ekintsi:n niwelik a i:n", kiht[ow]a. "A:mo ke:man nikelka:was" kiht[ow]a. "Ke:mah".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736" TIME_SLOT_REF1="ts1429" TIME_SLOT_REF2="ts1430">
                <ANNOTATION_VALUE>*Pero de** n..., de nika:was *solamente** a:mo teh xili eski, *pero de que** se: kichihchi:wa a:mo nikelka:was nik..., niki..., niwelik a kwali", kiht[ow]a. Nikilia "we:noh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737" TIME_SLOT_REF1="ts1431" TIME_SLOT_REF2="ts1432">
                <ANNOTATION_VALUE>Yehwa yo:n *este** ki..., kichi:wayah yo:n chi:walis kwaltsi:n semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738" TIME_SLOT_REF1="ts1433" TIME_SLOT_REF2="ts1434">
                <ANNOTATION_VALUE>A:mo monekia *veneno**, a:mo monekia tenex.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739" TIME_SLOT_REF1="ts1435" TIME_SLOT_REF2="ts1436">
                <ANNOTATION_VALUE>*Igual** n' *a:canasta** a:mo monekia tenex. *Igual** n' *trampa**, a:mo monekia tenex.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740" TIME_SLOT_REF1="ts1437" TIME_SLOT_REF2="ts1439">
                <ANNOTATION_VALUE>*Por eso** ni:xpeta:n neh wehka:wak, onkayah tel miak xi..., xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a741" TIME_SLOT_REF1="ts1440" TIME_SLOT_REF2="ts1442">
                <ANNOTATION_VALUE>*Porque** ke:yeh, kite:mowa:yah ke:ní:w para a:mo kini:xpolo:skeh. Kinihitayah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a742" TIME_SLOT_REF1="ts1443" TIME_SLOT_REF2="ts1444">
                <ANNOTATION_VALUE>Wa:n yo:n ne:n nikihtowa ne:n a:chikiwmeh tein de i:n ekintsi:n nikihtohtok tsi:mpihpitsaktikeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a743" TIME_SLOT_REF1="ts1445" TIME_SLOT_REF2="ts1446">
                <ANNOTATION_VALUE>yeh *por parejo** mopankalakia:yah, tsikitsitsi:n wa:n wehwei:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744" TIME_SLOT_REF1="ts1447" TIME_SLOT_REF2="ts1448">
                <ANNOTATION_VALUE>wa:n a:mo ki:sayah, wa:n a:mo n'mati ke:yeh *porque** tahtapo:tok wehwei. Ompa ne: yetokeh wa:n ompa kinkwiti:wih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745" TIME_SLOT_REF1="ts1449" TIME_SLOT_REF2="ts1450">
                <ANNOTATION_VALUE>Wa:n ompa ne: *cerca** tikowtekiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a746" TIME_SLOT_REF1="ts1451" TIME_SLOT_REF2="ts1452">
                <ANNOTATION_VALUE>pos *tacuidarowa:yah nocuñados**. S..., seki, seki tokni:wa:n ki:satoh, ki:ste:w kika:wte:w ne:n *sierra**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747" TIME_SLOT_REF1="ts1453" TIME_SLOT_REF2="ts1454">
                <ANNOTATION_VALUE>"Nikintaka:walti:ti ne: porin ne: kinki:xti:tih", [kih]to[w]a, "mokalakiah ma:ski to:naya:n", kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748" TIME_SLOT_REF1="ts1455" TIME_SLOT_REF2="ts1456">
                <ANNOTATION_VALUE>Yah[k]i kinahwato. Mahchi:wkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749" TIME_SLOT_REF1="ts1457" TIME_SLOT_REF2="ts1459">
                <ANNOTATION_VALUE>Kinki:xtia:yah ya ne:n..., kinitayah ya ne:n a:chikiw[meh]pero pos tak yehwa:n ne:n tein ompa nemitoh a:mo no: kimatiah porke:yeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750" TIME_SLOT_REF1="ts1460" TIME_SLOT_REF2="ts1462">
                <ANNOTATION_VALUE>*Pos que** ka:sá: se: mowi, a:mo se: kimati toni yetok. Pos nikitas yetok, pos nikoli:nis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a751" TIME_SLOT_REF1="ts1463" TIME_SLOT_REF2="ts1464">
                <ANNOTATION_VALUE>Pero n' tein a:mo mowi pero tein se: mowi pos se: kihto:s, "Taká:n ne:chwa:litstok ne:n a:kin ia:xka m..., *mejor** nikita wa:n niow".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752" TIME_SLOT_REF1="ts1465" TIME_SLOT_REF2="ts1466">
                <ANNOTATION_VALUE>Yahki kinahsito. Ihkó:n yahkeh. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753" TIME_SLOT_REF1="ts1467" TIME_SLOT_REF2="ts1468">
                <ANNOTATION_VALUE>Pero yehwa yo:n nikitak kwali ke:ní:w n' kichi:wayah nojó:n. Se: kowit kita:lia:yah wa:n kipachowa:yah ika tet</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754" TIME_SLOT_REF1="ts1469" TIME_SLOT_REF2="ts1470">
                <ANNOTATION_VALUE>wa:n kintehte:nkwa:itia:yah kwali nojó:n *kowcorral** mahyá:, a:chikiwit no: n' ito:ka:y</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a755" TIME_SLOT_REF1="ts1471" TIME_SLOT_REF2="ts1472">
                <ANNOTATION_VALUE>wa:n kinkehketsayah *hasta** tate:n wa:n tate:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a756" TIME_SLOT_REF1="ts1473" TIME_SLOT_REF2="ts1475">
                <ANNOTATION_VALUE>Mokalakia:yah to:naya:n xilimeh wa:n yowak. Ihkó:n nojó:n tekitik, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a758" TIME_SLOT_REF1="ts1479" TIME_SLOT_REF2="ts1480">
                <ANNOTATION_VALUE>Pues**..., de okseki okwilimeh pos yo:n kowtahokwilimeh name:chilwih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a759" TIME_SLOT_REF1="ts1481" TIME_SLOT_REF2="ts1482">
                <ANNOTATION_VALUE>De ne:n *trampas** no: name:chilwih ya. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a760" TIME_SLOT_REF1="ts1483" TIME_SLOT_REF2="ts1484">
                <ANNOTATION_VALUE>Pero *ora** de se: kipahwia pos name:chpano:ltilih ya yowi:pta ke:ní:w. Ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761" TIME_SLOT_REF1="ts1485" TIME_SLOT_REF2="ts1487">
                <ANNOTATION_VALUE>A:mo ok, de okseki okwilimeh a:mo ok, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a763" TIME_SLOT_REF1="ts1491" TIME_SLOT_REF2="ts1492">
                <ANNOTATION_VALUE>*Bueno, este**, neh noto:ka:y Andrés Martín Juárez, neh ni..., nita:ltikpaktik Xaltepec.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764" TIME_SLOT_REF1="ts1493" TIME_SLOT_REF2="ts1494">
                <ANNOTATION_VALUE>Pero a:xka:n nnemi Tzinacapan, n'wi:ka, n'wi:kati *se..., siete años** nia..., *cumplidos seis años** a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a765" TIME_SLOT_REF1="ts1495" TIME_SLOT_REF2="ts1497">
                <ANNOTATION_VALUE>[K]e:mah. Nikpia *cincuenta y nueve años**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767" TIME_SLOT_REF1="ts1499" TIME_SLOT_REF2="ts1502">
                <ANNOTATION_VALUE>Mm. [Ta]sohka:matik miak *igual** tehwa:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
