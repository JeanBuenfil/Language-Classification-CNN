                <ANNOTATION_VALUE>{Se equivocó, no quiere decir nada chikowa.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>{'Pocillo' aquí quiere decir 'taza' o 'jarrito' a que le pone agua}</ANNOTATION_VALUE>
