        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>{Generalmente tai implica un objeto pero no lleva el objeto ki-. Aquí María Ocotlán dice kitai, quizá marcando el objeto pero más probablemente un error por tai simplemente.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
