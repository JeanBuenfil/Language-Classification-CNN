        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>Nochi tikpi:kis ika n' *cobija**, ne:n a:ya:t tikihtowah a:ya:t, wa:n se: t'ta:lilia nika:n n' a:ya:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Yo:n a:ya:t ne:pa mah kipi:kto n' *cobeta** para *con eso** mah panki:sa *sabor**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Wa:n se: nika:n t'ta:lia ya ne:n a:ya:t Wa:n ke:meh nika:n tikta:lia se: tasa:l, a:mo tikwi a:ya:t ok, nika:n, mokwa:ko</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
