        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>{Quizá quiso decir tayeko:l, que sería como 'probabita'.}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts401">
                <ANNOTATION_VALUE>{Esto es, ¿qué enfermedad cura el chakay?}</ANNOTATION_VALUE>
