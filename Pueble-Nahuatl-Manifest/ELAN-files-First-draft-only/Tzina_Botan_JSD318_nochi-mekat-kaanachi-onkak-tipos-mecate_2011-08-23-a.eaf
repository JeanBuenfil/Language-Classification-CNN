        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>Ah pos n' kwetaxmekat onkak *hasta** ne:pa *por** Masa:owatah.</ANNOTATION_VALUE>
