        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Yehwa m' poposokani, yehwa m' poposokani ...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Ke:mah, niman, niman mah se: ki..., mah se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Yo:n kixi:kowa wetstotinemis wa:n *después** tikchihchi:was. Ke:mih kwetaxmekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>*Pues** a:mo ta: n' kwetaxmekat *aparte**, yeh tikchihchi:waskeh no: se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>Ke:mah. kwetaxmekat yeh no: *servi:rowa** para teihsá: ihkó:n tein tiknekis tikchi:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>Pero yo:n yeh weli tikweta:ni:s ka:ni..., ka:nika tiknekis *o** tein ke:meh tiknekis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>*Pues** n' texokomekat a:mo teh *servi:rowa, solamente**</ANNOTATION_VALUE>
