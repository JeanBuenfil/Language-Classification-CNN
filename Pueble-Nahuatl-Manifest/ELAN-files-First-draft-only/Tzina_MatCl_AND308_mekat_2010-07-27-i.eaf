                <ANNOTATION_VALUE>kipowayah ihkó:n de, se sempowal ne:n n' ima:i, nika:n mahtakti kita:lia:yah wa:n nika:n ne: no: mahtakti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Entó:s ne: ki..., ni:nipaka kikwiah, ihkó:n kitekpa:ntia:yah</ANNOTATION_VALUE>
