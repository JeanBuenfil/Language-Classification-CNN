        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>Wa:n nehjí:n wahkal i:n tein kisoyah de n' ihko:ni, achi ihkó:n niki....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Yo..., we:noh, no: ihkó:ni i:xtapalweyak, ompa kita:liah se:kone:tsi:n *cuando** yo:n nemi oso ihkó:n de panta:ltsi..., de: we:i, ihkó:n de weiak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Ompa kipanta:lia:yah wa:n kima:ma:yah, kilpia:yah, kita:lia:yah, kima:itia:yah ika yehwa yo:n xo:no:mekapal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Yo:n xo:no:mekapal ki..., kichihchi:wayah kwaltsi:n, ihkó:n kite:tekpa:nayah no:, kipowayah ne:n xo:no:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
