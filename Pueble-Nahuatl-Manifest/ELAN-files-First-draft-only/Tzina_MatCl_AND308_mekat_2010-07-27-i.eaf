        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Nochi i:n, we:noh nika:n ahsi *este** pos ma:kwi:l taman ne:n komekat tein kwali se: kikwi wahkalkowit.</ANNOTATION_VALUE>
