                <ANNOTATION_VALUE>kwaltia yo:n no: kwaltsi:n no: ihkó:n ne:n xo:no:tsi:n, de n' a:mo kipia n' i:x,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>ke seki kipia ii:x wa:n ne: kwaltsi:n de yo:n i:sta:kxo:no:t kipia ne:n ihkó:n se:semela:wa ne:n xo:no:t tikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n ne:n tikitayah yo:n poposokani, semi, semi kwaltsi:n yo:n, yo:n kwaltsi:n mo..., mochihkolowa ihkó:n, mochihkolowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>No: *igual** oksé: de n' ista:k no:, no: kwaltsi:n pero yeh ne:n nimitsilia ne:n nika:n yowi ke:meskia tayewalowa ke:meh eskia ihkó:n chihkoliwtok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>wa:n yo:n ne: poposokani tein achi chi:chi:ltik, yo:n yowi wehkapan, mehmelaktik ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Ahko yowi itech i:n kowit wa:n ni:nipaka ihkó:n, chihchi:chi:ltik ixo:chio,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>kwaltsi:n, ni:nipaka ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>Pero ima:te:mpan ka:mpa *cerca** de kipia ixo:chio, a:mo kwaltia, posteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>i:n kwaltia de itsi:ntan de n' pa:panki:stok, pa:panki:stok ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Onkak seki pihpitsa:wak, pihpitsa:wak kikwih para yo:n kikwiah para yo:n yohyowaltik, ihkó:n yohyowaltik wa:n kit kikwiah yo:n,</ANNOTATION_VALUE>
