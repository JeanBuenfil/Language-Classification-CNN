        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Komo se: i:xko chala:ni yehwa yo:n cho:kil, onkak teisá: pahti *o** iwki se: kelka:wa.</ANNOTATION_VALUE>
