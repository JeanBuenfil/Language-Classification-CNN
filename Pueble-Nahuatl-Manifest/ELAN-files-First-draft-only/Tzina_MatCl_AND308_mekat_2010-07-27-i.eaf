                <ANNOTATION_VALUE>¿Ke:niwki ixiwyo i:n poposokani?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>I:n oksé: komekat mono:tsa tata:wikmekat, ¿Ke:niwki i:n?</ANNOTATION_VALUE>
