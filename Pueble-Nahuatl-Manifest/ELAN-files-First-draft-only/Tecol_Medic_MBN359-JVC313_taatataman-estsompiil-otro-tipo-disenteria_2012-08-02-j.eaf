                <ANNOTATION_VALUE>komo se: tahyal pero yo:n kokolis se..., semi, semi kachi taman sah ke a:mo i:n se: kokolis tikihtohtokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Wa:n nehjó:n yo:n siwa:t mo..., motamilih ika yo:n ko..., e:xpa sah yahka kalan wa:n pero ka:kampeya:w esti, esti ne: xohxowik, xohxowik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
