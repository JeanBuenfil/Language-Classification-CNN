        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>"Xikmaka" kilia "komohkó:n tikneki" kilia "se:, xikmaka" kilia "yo:n ... 'Te:mo" kilia "*leche**" kilia</ANNOTATION_VALUE>
