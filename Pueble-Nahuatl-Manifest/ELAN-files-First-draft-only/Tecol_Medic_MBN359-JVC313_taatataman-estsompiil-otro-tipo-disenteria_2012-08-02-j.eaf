        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>a:paliw, ehkok kalihtik wa:n motapatilih, ke:mah pe:wak a yo:n, yo:n kokolis.</ANNOTATION_VALUE>
