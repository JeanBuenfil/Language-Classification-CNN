        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>No: kikwah eski, no: kikwah eski.</ANNOTATION_VALUE>
