        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Nehjó:n tehwa:n tikitah ompa ne: *porque** ke:masá: ne: te:chka:wili:kih yehwa yo:n kowtet, tein chi:chi:ltik wa:n kostik.</ANNOTATION_VALUE>
