        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Wa:n ekintsi:n ompa yetok o:me, o:me ok, yo:n me:sahpan nikitak ne:n chi:chi:ltik, ihkwi:ntsitsi:n. Ka:n semi, ihkwi:kwí:n sah, ohololtik yeh mochi:wa, ohololtik sah, ihkwi:kwi:n.</ANNOTATION_VALUE>
