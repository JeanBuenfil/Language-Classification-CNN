        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>Nika:n tanikwa:kopa kwa:lkwih, nika:n de, nika:n de Xaltipan mochi:wa *o** Ziltepec, ompa mochi:wa de yo:n kowtet, ompakawi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>Yehwa:n te:chka:wili:kih ne: ... Kostik sah mochi:wa nika:n tehwa:n pero neh niki:xmattok neh *porque** ni..., nikitak ne: ke:masá: te:chka:wili:kih wa:n nikita chi:chi:ltik seki wa:n yo:n chi:chi:ltik tsope:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
