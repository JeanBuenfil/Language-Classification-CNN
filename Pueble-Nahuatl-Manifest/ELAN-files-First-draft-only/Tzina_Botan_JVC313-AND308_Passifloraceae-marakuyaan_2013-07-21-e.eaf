                <ANNOTATION_VALUE>Ke:mah, no:, no: takwa:wak, se: kiteki ika *machete** se: kiistekwi, a:mo ye:kweli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
