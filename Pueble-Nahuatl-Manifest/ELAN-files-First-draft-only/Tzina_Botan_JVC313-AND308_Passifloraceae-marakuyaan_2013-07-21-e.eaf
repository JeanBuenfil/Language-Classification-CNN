        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Yehwa sah yo:n tiki:xmatih, ke:..., ke:mah. Ke:mah nika:n tehwa:n mochi:wa nochi kostik pero ne: onkak, onkak tein chi:chi:ltik, niki:xmati neh porin nikitani wa:n, wa:n nehjó:n ke:masá: ti..., tikpiah yo:n kowtet.</ANNOTATION_VALUE>
