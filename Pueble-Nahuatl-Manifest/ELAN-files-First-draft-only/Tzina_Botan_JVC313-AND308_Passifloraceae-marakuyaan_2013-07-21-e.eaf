        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Yehwa yo:n, pos yo:n onkak o:me taman nik..., nikita o:me, seki kostik wa:n seki chi:chi:ltik.</ANNOTATION_VALUE>
