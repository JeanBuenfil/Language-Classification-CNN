        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Ke:mah wa:n ... Ke:mah yo:n kostik pero yo:n chi:chi:ltik tsope:k.</ANNOTATION_VALUE>
