        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Ne:pa kaltsi:ntan onkak seki, kitekikih wa:n kwi:kah ne:wí:n kwa:tih *o** koyo:..., *o** kitamo:tati ne:kwí:n sepa ne: ...</ANNOTATION_VALUE>
