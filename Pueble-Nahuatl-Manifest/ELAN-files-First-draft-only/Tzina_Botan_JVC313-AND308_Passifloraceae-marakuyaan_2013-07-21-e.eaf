        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>Tak kikwa che..., ne:n chechelo:meh kikwah ne:n, ne:n kowtet.</ANNOTATION_VALUE>
