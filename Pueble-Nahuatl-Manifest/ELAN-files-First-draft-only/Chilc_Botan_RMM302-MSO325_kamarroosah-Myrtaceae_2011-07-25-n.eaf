        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>Wa:n ka:mpa n' *arado** ike:span ka:mpa i...,</ANNOTATION_VALUE>
