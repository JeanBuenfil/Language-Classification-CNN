        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>n..., yo:n pos a:mo kipia se: tachialis de tsi:na:ka *o** a:mo kipia se: tachialis ihkó:n mah nikihto neh</ANNOTATION_VALUE>
