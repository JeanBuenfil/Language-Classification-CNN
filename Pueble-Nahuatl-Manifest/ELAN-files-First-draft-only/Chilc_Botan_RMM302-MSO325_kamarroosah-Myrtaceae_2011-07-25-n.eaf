            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>wa:n yehwa yo:n neh nikneki, nikneki nikahsika:matiskia ke:yeh n' kito:ka:ytiah tsi:na:kaxa:lxokot ta:</ANNOTATION_VALUE>
