        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>tein ika kitihtiti:chakiliah n' kowtsitsí:n para mah motili:nti.</ANNOTATION_VALUE>
