                <ANNOTATION_VALUE>no: tikmattokeh *que** no: tikmahse:wah yo:n xa:lxokot, a:mo n'mati kox no: tiki:xmattok n' tehwa:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts246">
