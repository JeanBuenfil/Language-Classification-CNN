        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>wa:n mah se: kikoyo:ni ka:mpa kalaki a kihtowa yo:n kiliah *este timón**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts513" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>Ajá, yo:n kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts518" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>Wa:n ompa kihtowa x'ta:lili a kihtowa, mah se: kita:lili kihtowa yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>a:mo nikye:kelna:miki ke:ní:w mono:tsa yo:n ka:mpa kikalakiah ya ne:n *timón**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>yo:n se: kowtsí:n ata ki..., no: kipankalakiliah wa:n ki:xkahkalakiliah *este**,</ANNOTATION_VALUE>
