        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>A:, n' iteyotsi:n.</ANNOTATION_VALUE>
