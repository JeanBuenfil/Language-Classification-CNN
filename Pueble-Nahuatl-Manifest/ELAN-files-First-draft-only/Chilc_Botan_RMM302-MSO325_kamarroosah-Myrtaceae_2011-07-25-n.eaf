        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Ke:mah, ompaka nika:wí:n, ka:mpa *más** tepitsi:n.</ANNOTATION_VALUE>
