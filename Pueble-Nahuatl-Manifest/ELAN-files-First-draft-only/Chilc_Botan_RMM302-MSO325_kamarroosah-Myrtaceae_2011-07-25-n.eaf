                <ANNOTATION_VALUE>wa:n yo:n, ¿ka:ni n' onkak, semi nika:wi:ni sah oso onkak ne:wí:n *más** paratani?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Pero neli nikih..., neh niki:xehekowa *más** paratani a:it ox onkas, xa: ta:lna:miki sayoh ka:mpa achi tepitsi:n tasese:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts212">
