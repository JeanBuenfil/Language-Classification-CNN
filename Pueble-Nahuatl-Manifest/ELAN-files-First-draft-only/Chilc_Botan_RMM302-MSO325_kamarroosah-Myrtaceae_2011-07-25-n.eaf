        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Pos neh niki:xmattok *que** onkak o:me taman, onkak yo:n tein kiliah ista:k wa:n onkak yo:n tein yo:n kiliah tsina:kaxa:lxokot, tein yo:n chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Wa:n yeh teltsohtsope:k nikilia ne: yo:n tsina:ka, yo:n no: nikekowa:ni neli, yo:n nikilia neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>yo:n neh *más** nikwe:lilia *porque** teltsohtsope:k.</ANNOTATION_VALUE>
