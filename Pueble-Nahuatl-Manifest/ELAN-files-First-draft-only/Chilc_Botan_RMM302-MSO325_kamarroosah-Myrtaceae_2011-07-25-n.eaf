        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>¿Wa:n ixiwyotsi:n?, *siempre** xa: taman eski n' ixiwyotsi:n.</ANNOTATION_VALUE>
