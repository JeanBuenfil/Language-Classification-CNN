        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>A:mo nikelna:miki ke:ní:w mono:tsa pero no: kipia n' ito:ka:y, tein ka:mpa kikalakiah n' *timón**, a:mo n'mati ox no: tiki:itani n' teh,</ANNOTATION_VALUE>
