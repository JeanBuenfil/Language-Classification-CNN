        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>Yo:n *más** we:lik neh nikilwia.</ANNOTATION_VALUE>
