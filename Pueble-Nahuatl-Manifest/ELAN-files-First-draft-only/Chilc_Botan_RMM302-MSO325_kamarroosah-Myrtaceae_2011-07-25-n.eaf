        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Pos yehwa sah yo:n ika timonohno:ts..., timonohno:tskeh. Neh no: niknekia nimitstahtani:s sen, sen taman kowtetsí:n no: mahyá: nikihto:sneki neh *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
