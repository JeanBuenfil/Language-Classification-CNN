        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>Entó:s *como que** mah tikihtokeh[tikihto:ka:n], tikihto:snekih n' tehwa:n mopata sayoh n' ita:kilo:tsí:n[[ita:kilotsi:n].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>Ta:kilo:t sah. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Wa:n yo:n tsi:na:ka, ts..., *bueno** xa:lxokokowit kiliah, para toni yo:n se: kikwi, kwaltia teihsá: ihkó:n para se: kitatekiwti:s *o** tamela:wa sayoh kowit sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>Ke:mah. Pos semi kwaltsi:n neli yo:n kowtsí:n komohkó:n neli pahti, ta: yo:n a:mo se: kikowas, ta: yo:n onkak sah nika:wí:n kowtah tehwa:n neli n' tikihtowah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>neh a:mo n'mati kox neli, kihtowah, nikinkakilihka no: ne:n to..., n' to...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>towe:..., towe:ita:twa:n kihtowa:yah *que** no: kwali pahti kit para n' estsompi:l wa:n kwali pahti para n' te:mpala:n kit no: n' kihtowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>Mah ika se: moto:t..., mah se: kimolo:nti n' ie:wayo wa:n ixiwyotsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>wa:n mah ika se: motoskapa:ka n' kihtowah, kihtowah no: semi kwali kihtowah para n' te:mpala:n. A:mo x'mati kox neli ke:meh neh...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Kihtowah, neh a:mo ke:man nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>a:mo ke:man nikehekohtok ihkó:n mah nikchi:wa, neh ihkó:n mah ika timo..., mah ika nimopahti *porque** neli pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>neli ke:meh tikihtowah n' tehwa:n pos miak taman, miak taman pahti onkak para yo:n kokolis, neli a:mo se: kimahmati sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>Neli.</ANNOTATION_VALUE>
