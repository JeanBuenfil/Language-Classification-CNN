        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Yeh no: ista:k n' ixo:chiotsi:n ata, ista:k.</ANNOTATION_VALUE>
