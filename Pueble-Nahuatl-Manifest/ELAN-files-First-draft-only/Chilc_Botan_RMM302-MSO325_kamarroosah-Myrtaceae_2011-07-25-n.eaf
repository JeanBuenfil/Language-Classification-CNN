        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Wa:n seki no: tsope:k, pero yo:n tsina:ka *más** tsope:k.</ANNOTATION_VALUE>
