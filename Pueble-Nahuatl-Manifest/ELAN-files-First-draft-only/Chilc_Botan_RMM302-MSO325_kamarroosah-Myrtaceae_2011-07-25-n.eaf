                <ANNOTATION_VALUE>kihtowa. Nikilia, ¿wa:n ke:ní:w tikchi:wa yo:n? Kihtowa, tein yo:n chihkoltik kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>xik.., mah se: kiteki kihtowa wa:n mah se: kixihxi:ma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>Mah se: kixi:ma wa:n mah se: kimetsti kihtowa, mah se: kitstiw ke:ní:w se: kim..., ke:ní:w se: kimi..., se: kixi:ntiá:s</ANNOTATION_VALUE>
