        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>niú:n teltakawa:ni wa:n niú:n teltasese:ya tikihtowah n' tehwa:n ka:mpa ta:lna:miki yo:n kowtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
