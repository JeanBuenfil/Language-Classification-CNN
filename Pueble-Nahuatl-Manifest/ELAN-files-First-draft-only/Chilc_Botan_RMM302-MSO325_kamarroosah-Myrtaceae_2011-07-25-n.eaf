        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>Wa:n nik..., nikilia:ya neh *que** ton kowyo, kihtowa ta: i:n de xa:lxokokowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
