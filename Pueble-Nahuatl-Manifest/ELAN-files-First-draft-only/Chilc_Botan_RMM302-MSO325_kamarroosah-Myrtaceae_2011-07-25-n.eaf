        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>kikoyo:niah wa:n ompa kah..., kahkokalakiliah ya yo:n,</ANNOTATION_VALUE>
