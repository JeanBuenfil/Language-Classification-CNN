        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>¿Wa:n yo:n ixo:chio ke:niwki n' tein kiliah, kiliah ista:kxa:lxokot?</ANNOTATION_VALUE>
