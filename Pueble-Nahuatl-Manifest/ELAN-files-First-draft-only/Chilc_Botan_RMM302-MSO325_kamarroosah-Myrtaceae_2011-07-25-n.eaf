        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>Wa:n yo:n ista:k seki ata onkak achi xohxoko:k.</ANNOTATION_VALUE>
