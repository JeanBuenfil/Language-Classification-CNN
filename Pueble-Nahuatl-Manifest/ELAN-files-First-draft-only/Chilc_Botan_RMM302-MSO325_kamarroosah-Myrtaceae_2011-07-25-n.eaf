        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>miak, miak ta:kilo:tsí:n ki:xmatiah wa:n neli kito:ka:yi:xmattoyah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Wa:n yo:n to:ka:it pos yehwa:n te:chne:xtilihte:wkeh, nikaki kito:ka:ytiah tsi:na:kaxa:lxokot, pero sayoh neh nimonemilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>ke:yeh n' kito:ka:ytiah tsi:naka, pero yo:n neh niki:xehekowa teihsá: kipias tachialis no: ke:yeh n' kito:ka:ytiah tsi:na:ka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
