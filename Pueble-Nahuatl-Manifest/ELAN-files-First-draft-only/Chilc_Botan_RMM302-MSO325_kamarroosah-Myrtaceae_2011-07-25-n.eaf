        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>wa:n ompa kipankalakiliah ne:n, yehwa ne:n yo:n kowtsí:n ahkokechiliah n' kowit,</ANNOTATION_VALUE>
