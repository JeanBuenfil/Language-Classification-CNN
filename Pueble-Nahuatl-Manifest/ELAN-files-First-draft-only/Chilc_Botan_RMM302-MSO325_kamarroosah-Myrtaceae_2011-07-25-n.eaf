        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>A:, pos yehwa ika neli, yehwa ika. Ke:mah, neh nimitsilia xa: ke:mah eski ke:meh tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts335">
