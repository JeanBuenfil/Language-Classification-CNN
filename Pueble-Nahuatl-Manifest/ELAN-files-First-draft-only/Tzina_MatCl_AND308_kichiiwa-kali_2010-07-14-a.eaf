    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Amelia Dominguez Alcántara" TIER_ID="Amelia Dominguez Alcántara">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Ta:tah, tikihtowa ke tehwa:tsi:n tikmati ke:ní:w n' kichihchi:wah kal..., *bueno** kichihchi:wayah kalmeh ne: wehka:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>Tiknekiskiah 'te:chtapowi, ne:n, kihtowah ne:, ne: wehka:w onkayah xiw..., kowxiwkalmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>ihkó:n yo:li:k mopatatiahkeh, ekintsi:n tikitah ke kalmeh tein a:xka:n ka:mpa tehwa:n tinemih no: taman ya, a:mo iwki ok ke:meh ne: wehka:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>Aya:mo. Ekintsi:n, *bueno** tikihtowa:ya ke kalmeh ne:, *bueno** ke:man tikinchihchi:way kal..., kalmeh nankinonkwiah kalikximeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Em..., neh n'mattok ke kalmeh miak, miak taman, *este**, kowtsitsi:n kiwi:ka. A:mo n' mati xa: tikmattos ke:ní:w motohto:ka:itia nochi yo:n kowmeh *porque** ta:taman, ne:, mahyá: ta:taman kito:ka:ytiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>Es..., 'nekiskiah ne: xite:chtapowi nochi yo:ni, ke:ní:w, ke de *desde** kalikxit ihkó:n ke:meh tehkotiw, ke:ní:w, ton kowmeh, ke:ní:w mono:tsah ne:, ke:ní:w mono:tsah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>*Hasta** ka:mpa tamiti a kali, ke:man tamiti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>Ke:man kichihchi:wayah ne:n kowxiwkal ¿Ke:ní:w kipe:waltia:yah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>¿*Igual** ke:meh *teja** kipe:waltiah ki...?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>¿*O** kipe:waltiah ke..., ahkwa:kopa oso tanikokopa, tate:noh oso ne: ka:mpa kwa:tami ne:n kali?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>A:xka:n ke, *bueno**, a:xka:n neh nikita kalmeh mopatakeh ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>¿Ke:yeh timolia a:mo kisentokakeh ok kichihchi:wkeh ne:n kowxiwkalmeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>*Este**, welis 'te:ch..., 'te:chtapowi:s ne: ka:ni..., ka:nachi to:nal, ne:n, nankichi..., nankichi:wah para nankite:mowah xiwit tein mokwi para s..., ika nankipantsakwaskeh kali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>Ox miak ta:ke:walmeh, ne:n, na..., namopale:wia:yah *o** namosehse:lti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>¿Wa:n ke:ní:w nankimatiah ke:man sepa mopatas..., mopatalania ya ne:n xiwit?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>¿Wa:n no: ka:nachi xiwit kichi:waya ne:n kali, ox wehka:waya oso a:mo semi wehka:waya?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Tikihtowa onkaya sakani:nyoh, owa..., owaxiwit wa:n ne:n kowxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>De yo:n e:yi taman, ¿Katí:n yeh okachi wehka:waya?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>A:, yehwa kowxiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Wa:n ke:man nankipe:waltia:yah namocha:n nankichihchi:wayah ¿Ka:nachi to:nal ne: name:chwi:kilia:ya, *hasta** nantatsi:ntsakwayah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>Wa:n yo:n, ¿Ke:yeh yo:n xo:no:kowit nochi nankikwiah o[k]? ¿Ka:n onkaya okseki kowtsitsi:n tein achi takwa:wak? ¿Oso no: takwa:wak xo:no:kowit?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>*Bueno pues**, miak tasohka:matik. ¿Welis tite:chilwi:s es..., moto:ka:y, ka:nachi xiwit tikpia wa:n ka:ni ne:n, ka:ni tinemik wa:n ka:ni ekintsi:n tinemi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>¿Ke:ní:w moto:ka:y?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Miak tasohka:matik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
