        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>wa:n yo:n momowtihka itech a:t, ke:meh wehka ki:saya,</ANNOTATION_VALUE>
