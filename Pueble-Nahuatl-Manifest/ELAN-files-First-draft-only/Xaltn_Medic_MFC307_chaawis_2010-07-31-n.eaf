            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>wa:n momakpalko nochi ohka:n, nika:n moi:xkwa:ko nochi, motoskatampa nika:n *parejo**.</ANNOTATION_VALUE>
