        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>Wa:n neli ihkó:n se: tami koma:mo tikmatik toni timopahti:ti ika</ANNOTATION_VALUE>
