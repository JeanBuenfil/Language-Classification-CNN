        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Kinka:wte:w pilimeh, a:mo ke:man a:kah kinekik mah kite:mpacho</ANNOTATION_VALUE>
