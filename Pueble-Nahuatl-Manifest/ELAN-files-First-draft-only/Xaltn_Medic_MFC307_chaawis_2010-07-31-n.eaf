        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Toni, toni chi:wik, ekintsi:n, wehka:w a te:chka:wte:w, e..., ipi:piltsitsi:n kwahkwali *maestros**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
