        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>wa:n yo:n tikte:mpacho:s a, ke:mah tikxama:nia ya *ajo**, o:me, se: tanti</ANNOTATION_VALUE>
