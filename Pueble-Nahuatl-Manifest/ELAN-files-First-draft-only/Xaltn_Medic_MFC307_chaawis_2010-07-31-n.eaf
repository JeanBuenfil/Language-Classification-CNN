        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>wa:n kinka:wte:w tsikitsitsi:n, o:men, a:mo miakeh.</ANNOTATION_VALUE>
