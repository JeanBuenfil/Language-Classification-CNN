                <ANNOTATION_VALUE>A:man ne: kihto:s, "tepitsi:n ni..., nimi:to:nih, ka:n mati ke:yeh ox porin nimota:lilih refi:noh". "Ke:mah, yehwa ika,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>yehwa ika timota:lilih wa:n tik..., tikpialih ne: *respeto,</ANNOTATION_VALUE>
