        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>Pero pos tikita ya ka:sá: ika tak xa: kixo:xak n' a:t</ANNOTATION_VALUE>
