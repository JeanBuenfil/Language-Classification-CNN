        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>wa:n koma:mo timote:makak mah mitspahti:ka:n pos a:mo tipahtis</ANNOTATION_VALUE>
