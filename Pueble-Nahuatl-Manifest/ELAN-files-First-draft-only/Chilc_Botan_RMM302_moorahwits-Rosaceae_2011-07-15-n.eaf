        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Wa:n a:mo wel te:chkaya:waskeh *que** a:mo yehwa *mismo**, yehwa *mismo**, sayoh ke:meh neh nimitsilia onkak n' tein tato:k,</ANNOTATION_VALUE>
