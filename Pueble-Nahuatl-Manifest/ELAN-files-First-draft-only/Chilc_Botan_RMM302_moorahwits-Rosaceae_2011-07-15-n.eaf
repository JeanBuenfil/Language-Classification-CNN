        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>yo:n tikwa..., yo:n, yo:n *solamente** ne:wí:n por</ANNOTATION_VALUE>
