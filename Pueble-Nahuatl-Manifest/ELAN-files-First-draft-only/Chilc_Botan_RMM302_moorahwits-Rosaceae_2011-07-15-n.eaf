            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>wa:n ompa pe:wa selia. Yehwa yo:n. Ihko:ni, ihko:ni mochi:wa yo:n,</ANNOTATION_VALUE>
