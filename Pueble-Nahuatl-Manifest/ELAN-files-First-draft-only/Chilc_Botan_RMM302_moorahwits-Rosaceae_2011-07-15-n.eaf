        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>A:mo nikmati, xa: no: tikmatini ke:meh yo:n chi:chi:lkapolato:l kichi:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>no: iwki i:n kichi:wah ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts247">
