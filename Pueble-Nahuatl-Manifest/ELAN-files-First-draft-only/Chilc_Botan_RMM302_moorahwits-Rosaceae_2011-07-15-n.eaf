        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>No: ki..., kipati:yo:tiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Se: tamachi:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>se: tamachi:w, tahko *o** tahko tamachi:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>tikmatis ka:nachi, ka:nachi no: ika te:chka:wilia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>sem..., kaxto:l, kax..., kaxto:l *peso** tahko tamachi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Se: tamachi:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>yehwa n' tehwa:n tikih..., tehwa:n tikihtowah n' koyo:..., koyo:kopa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>se: *kilo**, tehwa:n tikihtowah se: tama..., se: tamachi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Se: tamachi:w *vale...**, tikmatis ka:nachi ika te:chmakayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>sempowal wa:n mahtak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>Wa:n a:mo miak *porque** eti:k, eti:k porin a:yoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Yeh ke:mah yo:n, ika yo:n, ika yo:n se: tamachi:w n' tehwa:n tik..., tikixta:wayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>te:chahsia ya para *siquiera** se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>se: o:me, e:yi powal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>e:yi powal, o:me, o:me powal wa:n mahtak takman..., *este, paletas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Entó:s tehwa:n tikitayah *que** no: te:chki:saya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>tiki:xta:wayah ne:n, tikixta:wayah sempowal wa:n mahtak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>pero n' tikmattokeh *que** no: tiki:xtili:tih ika m' *paletas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>Entó:s tehwa:n nió:n no:, a:mo timoyo:lkokowa:yah tikixta:wayah tepitsi:n, tepitsi:n ipati:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>*porque** tikitayah itech..., ompa *mismo, mismo** ompa tiki:xtia:yah de n' itech *mismo** n' kowta:kilo:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Ihkó:n ke:meh tikixta:wayah ihkó:n sepa tiki:xtilia:yah ne:n i..., n' ipati:wtsi:n, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Wa:n neh name:chilwia yo:n o:me taman kwaltia. kwaltia para n' ato:l wa:n kwaltia para ne:n *paletas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Yo:n a:mo sayoh tehwa:n tikowayah, mah se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>tokni:wa:n tein, tein kwa:tamattokeh wa:n tein,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>tein no: ika mota:liah ya, kiwi:kah ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>xola:l ka:mpa kichi:wah *paletas**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>wa:n mah kite:tekiwi:tih kinixta:wiliah no: kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>Yo:n a:mo sayoh tehwa:n tikowayah, yo:n kiko.., yo:n kikowah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>t..., ka:mpa kichi:wah *paletas**, ka:mpa kipiah tanamak de yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>Pos ke:mah, yehwa sah yo:n tein nimitsilwih. A:mo nikmati, a:mo wel *más** teh nimitsilwia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>*porque** yehwa sah*lo que** tein neh nimitstapowih, tein neh nikmattok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>para toni n' kwaltia wa:n ke:ní:w se: kichi:wa wa:n ke:ní:w se: kitatekiwtia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>Yehwa sah yo:n, tasohka:matik miak. Neh nimono:tsa niRubén Macario,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>Neh nip..., ni..., niwa:le:wa de nika:n Chi:lkowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>nipowi nika:n San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
