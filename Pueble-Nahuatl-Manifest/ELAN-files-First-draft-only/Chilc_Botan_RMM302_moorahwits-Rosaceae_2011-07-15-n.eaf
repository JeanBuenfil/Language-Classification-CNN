            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>mo:rah, mo:rahwits iteyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>Wa:n kikwih no: para kichi:wah *paleta, por eso** yo:n, yo:n a:mo ke:man kanah kika:wah.</ANNOTATION_VALUE>
