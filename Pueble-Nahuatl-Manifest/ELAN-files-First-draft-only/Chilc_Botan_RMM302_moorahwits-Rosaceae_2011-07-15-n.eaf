        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>wa:n kinamak..., te:..., kinamakayah ihkó:n kalpan por kalpan. Neh name:chilia *porque** ne: ka:mpa neh ninemi,</ANNOTATION_VALUE>
