        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>Kima:pa:tah wa:n ke..., ke:mah kimolo:ntiah ya i..., kimolo:ntiah ya iwa:n tepitsi:n, tepitsi:n tixa:tsí:n kipa:tah no: wa:n ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts233">
