            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>n' ompa, n' ompakawí:n, n' ompa kionkaltihtokeh.</ANNOTATION_VALUE>
