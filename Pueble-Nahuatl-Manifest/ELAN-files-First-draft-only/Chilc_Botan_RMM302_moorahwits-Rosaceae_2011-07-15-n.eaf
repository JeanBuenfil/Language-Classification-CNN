                <ANNOTATION_VALUE>Para m' *paletas** semi we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Yeh ke:mah neli no: pati:yoh para tikowaskeh, no: pati:yoh *vale**...,</ANNOTATION_VALUE>
