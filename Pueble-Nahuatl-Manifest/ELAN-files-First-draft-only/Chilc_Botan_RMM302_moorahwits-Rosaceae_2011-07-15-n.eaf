        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Kipia *que** ne: kikwiti:wih wa:n kima:pa:taskeh.</ANNOTATION_VALUE>
