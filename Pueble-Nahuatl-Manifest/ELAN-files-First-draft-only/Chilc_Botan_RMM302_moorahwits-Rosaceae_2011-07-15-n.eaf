            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>Para a:mo tik..., para a:mo tikowas *es...**, n' tikowas *este** ne:n kapolin *mejor** xki:sa, xte:mo:ti ne: ka:mpa onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>wa:n tikteki wa:n ke:mah tikehkoltia n' kalihtik wa:n kima:pa:tah.</ANNOTATION_VALUE>
