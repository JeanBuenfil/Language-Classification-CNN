        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>wa:n nehjó:n kwali *hasta** se: kone:tsi:n oso tehwa:n te:ch..., te:chpepechowilia:yah ihkó:n ika te:chpahtia:yah yehwa yo:n tikownex ne: se: i:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>Pero yo:n se:, yo:n se:se:ya para se: yolkawa:..., se: kawa:nis,</ANNOTATION_VALUE>
