                <ANNOTATION_VALUE>nika:n se: ikechkochi:ka:n wa:n nika:n te:ta:liliah, i:n se: iyo:lpan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>Se: iyo:lpan nika:n wa:n i:n *mero** nika:n, se: ikechko, nika:n ka:mpa se: ki..., temowa se: itakwal ompa no: te:ta:liliah.</ANNOTATION_VALUE>
