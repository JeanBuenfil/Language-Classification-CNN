        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Ta:tah tiknekis..., tiknekih xite:chtapowi, xa: tikmati to..., ke:ní:w se: mopahtia *o** toni ika se: mopahtia komohkó:n te:kwi i:n kokolis tein tikilwiah mihmikilo:tataxis.</ANNOTATION_VALUE>
