            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>De n' epat imate:kayo pos yo:n no: kwali teoh..., yo:n te:ohohsah ka:mpa se: sahsa:liwtok,</ANNOTATION_VALUE>
