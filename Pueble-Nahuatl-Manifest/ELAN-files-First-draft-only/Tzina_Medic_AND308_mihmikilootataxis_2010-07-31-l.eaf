        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>I:pa yehwa sah yo:n xiwtsi:n wa:n okwiltsitsi:n tein teh tiki:xmattok ke kwali ika se: mopahtia.</ANNOTATION_VALUE>
