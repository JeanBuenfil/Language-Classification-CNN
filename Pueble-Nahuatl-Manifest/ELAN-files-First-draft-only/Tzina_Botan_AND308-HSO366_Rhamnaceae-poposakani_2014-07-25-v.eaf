        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>yo:n ka:n t'mati, ¿a:mo kwaltia para pahti ata?</ANNOTATION_VALUE>
