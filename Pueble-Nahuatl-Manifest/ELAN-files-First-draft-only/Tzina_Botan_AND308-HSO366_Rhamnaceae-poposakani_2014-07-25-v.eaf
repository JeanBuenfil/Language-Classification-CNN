        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>Miakeh tekitih ika yo:ni. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
