        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>Seki tsi..., tsikitsitsi:n wa:n de n' achi tohtoma:wak de n' achi</ANNOTATION_VALUE>
