        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
