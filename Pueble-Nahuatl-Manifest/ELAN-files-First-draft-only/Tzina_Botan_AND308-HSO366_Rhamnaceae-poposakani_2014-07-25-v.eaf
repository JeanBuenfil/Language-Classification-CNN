            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>n' ina:wil, yehwa yo:n kinchihchi:wiliah kwaltsitsi:n, ihko:ko:ntsitsi:n.</ANNOTATION_VALUE>
