        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>No: kitah, no: kwaltia ke:meh yo:n ki..., kwi:kah se: kone:tsí:n ompa kita:liah.</ANNOTATION_VALUE>
