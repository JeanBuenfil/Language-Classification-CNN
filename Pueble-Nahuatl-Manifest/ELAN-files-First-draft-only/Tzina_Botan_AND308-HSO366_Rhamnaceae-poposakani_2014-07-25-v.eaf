        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>*Bueno**. Pos 'ne:chili sah ke:ní:w moto:ka:y.</ANNOTATION_VALUE>
