        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>N..., komohkó:n ki:sa *de s..., de s...**, mah tikta:lika:n de *sesenta**, ke:ní:w n' kiliah de e:yi powal ne:</ANNOTATION_VALUE>
