            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>wehwei para tahtapotoya ihkwí:n para ompa paxi:i:ntiá:s ne:n tekol tein tatas ne:n kowit.</ANNOTATION_VALUE>
