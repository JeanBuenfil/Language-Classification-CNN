        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>*lo de cuarenta** para akis kina:lkalaki:skeh miak kowit.</ANNOTATION_VALUE>
