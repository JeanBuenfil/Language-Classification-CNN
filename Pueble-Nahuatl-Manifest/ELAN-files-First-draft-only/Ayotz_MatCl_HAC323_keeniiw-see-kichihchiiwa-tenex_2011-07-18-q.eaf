        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>teh tikmattos. Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Ajá</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Na:wi powal wa:n kaxto:lomo:me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Wapali:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Ne: pos yo:n tikihtowa kaxto:lto:nal xo:tatoya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>¿yehwa sah yo:n na:wi powal wa:n kaxto:lomo:me *kilos** ki:saya?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>A:mo, ta nimitsilihtok ki:sa e:yi powal wa:n mahtakti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>m..., e:yi powal wa:n ka:nachi nimitsilwih, e:yi powal wa:n kaxto:lomo:me, pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>*cargas** mah tikihto:ka:n, de *c..., de a cien kilos cerca** mah t'ta:li:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>A:, ki:saya mah tikihto:ka:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>Ajá se: mi:l wa:n tahko *kilos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>A:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>Wa:n tahko. Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>Tein kaxto:l to:nal kitatilihtoyah, kitatatilihtoyah. Wa:n tein sayoh ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>chiko:mei to:nal tikihtowa kixo:tal..., kitaxo:taltilihtoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>A:mo se: kineki ok se: mochihchika:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Ekintsi:n tisiowtiwih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>*Seiscientos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>okachi koko:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Wa:n neli ne:n ke:man kitaxo:ltaltiliah ya, ta:ká:n pe:wak kiowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Ye:wa tine:chilih *que** n' tatsi:ntan kita:liliah xa:l..., xa:ltet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>¿Wa:n ka:nachi xa:ltet kita:liliah, se:sah oso miakeh[miak]?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>Ke:man kitis..., ke:man tise:wi a, ahxi..., ahsi a ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>chikwe:yito:nalika oso kaxto:lto:nalika, ke:man tise:wi a, ¿niman kiki:xtiah n' tenex?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>Ne:n ka:mpa te:nkoyoktik n' ki:sasneki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>Wa:n yo:n tatsakwil de tet tikihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>Wa:n nanki:x...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>Tiknamaka ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>Ke:mah, *porque** neh nimotahtania,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>*porque** yo:n tenex ata ke:man se: kikowa n' tet,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>ne: wa:n komo tikta:lih itech se: kwetax,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>wa:n tikihto:ti ompa t'momoxo:ti, kitahtatia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>Tata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>Pos pané:, pané: nochi yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts609">
                <ANNOTATION_VALUE>Ne:, ka:n n'mati xa: teihsá: tikelna:miki ok, neh a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Neh nikelna:miktok ke:mah katka nipili, ne: sepatsi:n no:pá:n no: kitatatilihka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>pero a:mo no: nikelna:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts619">
                <ANNOTATION_VALUE>A:mo nikelna:miki. Neh sayoh nia:ya no: nió:n ma:wiltia:ya wa:n nikwi:kilia:ya itakwal, pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>a:mo nikelna:miki ke:ní:w n' kichi:wka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts625">
                <ANNOTATION_VALUE>Nohma etok ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>n' *ho...**, ke:mah, nohma yetok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>Ke:mah wa:n ka:mpa kitahtatiah n' tenex, nikilia neh mahyá: kwitapi:leh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>Ke:mah. Pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>miak tasohka:matik. kwali a *que** tine:chyo:lmela:w tepitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>ihkó:n no: tikmatiskeh. Neli ekintsi:n a:mo a:kin semi, a:mo a:kin kineki ok kichi:was i:n tekit, nochi titatsiwih ya n' tehwa:n ekintsi:n tein timoskaltihtokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>Wa:n neli n' tein okachi ta:tahmeh pos mahyá: kinehnekiskiah ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>pero de a:mo no: tikimpale:wiah a:mo no: kichi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts680" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>*Bueno** pos ne:chili moto:ka:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts688">
