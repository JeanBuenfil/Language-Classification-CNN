        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>de w..., eti:k mah tikihto:ka:n, de wehwei tet, tein tekit se: kixi:kowa oho:me:n.</ANNOTATION_VALUE>
