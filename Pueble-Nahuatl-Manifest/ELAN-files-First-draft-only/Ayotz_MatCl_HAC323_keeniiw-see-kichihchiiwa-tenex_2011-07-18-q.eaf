        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Mi:xna:mikih ne:pa kita:ta:liah, kita:ta:liah ihkó:n kitekpa:nah nika:n,</ANNOTATION_VALUE>
