        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Ke:mah. Nikitak de yo:n, nochi de yo:n, nikitaka ok ke:ní:w n' tekitik no:pá:n katka no:.</ANNOTATION_VALUE>
