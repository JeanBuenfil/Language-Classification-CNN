        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>de tet mahyá: de kimaga n' to:nal wa:n ne:n kiowit, entó:s *como que** mahyá: *mopasmarowa**, entó:s a:mo ne:</ANNOTATION_VALUE>
