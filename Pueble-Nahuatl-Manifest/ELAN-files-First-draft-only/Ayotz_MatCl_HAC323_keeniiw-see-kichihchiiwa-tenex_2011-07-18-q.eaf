        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>mah yowi, a:mo, a:mo s..., a:mo seko sah nepaniwtok, seko sah n' ihkwí:n mokwa:nahna:miktok, sanoke mahyá: ilpitiw.</ANNOTATION_VALUE>
