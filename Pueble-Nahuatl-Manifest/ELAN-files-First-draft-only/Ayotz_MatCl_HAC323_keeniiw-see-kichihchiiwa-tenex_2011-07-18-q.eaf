        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>Entó:s ke:mah ne: ompa yo:n pe:wa ki..., nika:n wehka m' pe:wa nika:n, pe:wa ihkó:n kis..., ihkó:n kitokihtiwih, kitokihtiwih, kitokihtiwih, kitokihtiwih,</ANNOTATION_VALUE>
