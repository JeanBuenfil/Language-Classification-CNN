        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>*de veinticinco, treinta**, kichi:wayah se: de tahko *metro, hasta** ne:,</ANNOTATION_VALUE>
