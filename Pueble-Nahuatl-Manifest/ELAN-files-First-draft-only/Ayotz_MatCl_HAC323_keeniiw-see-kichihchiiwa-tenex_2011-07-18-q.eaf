        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Kisa:lowah de nika:n ihkwí:n kitekpa:nah, seki tet tein, [...], mah tikihto:ka:n de,</ANNOTATION_VALUE>
