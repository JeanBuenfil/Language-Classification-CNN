            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>seki para mah a:mo teh poliwi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>seki para mah nochipa achi kwaltsi:n tietoka:n,</ANNOTATION_VALUE>
