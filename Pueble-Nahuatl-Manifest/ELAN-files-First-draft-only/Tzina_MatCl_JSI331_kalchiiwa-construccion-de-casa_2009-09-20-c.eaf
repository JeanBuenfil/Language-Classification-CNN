        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>Ah, nika:n nikelka:waya se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>n' tatio:chi:wala:t wa:n kwawxiwit tein tatio:chi:wal, mm.</ANNOTATION_VALUE>
