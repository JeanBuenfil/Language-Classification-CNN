        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>D..., *de que** yo:n ihwa:k a:mo onkaya *malos**,</ANNOTATION_VALUE>
