        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>Ne: ke:man *inimpuerta**, a:mo 'kwiah kiliah n' koyo:meh *bisagra**,</ANNOTATION_VALUE>
