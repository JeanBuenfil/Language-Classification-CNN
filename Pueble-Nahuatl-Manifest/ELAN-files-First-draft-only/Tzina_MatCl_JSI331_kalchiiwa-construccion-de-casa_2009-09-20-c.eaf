        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>Miak kipia [ke]kitas, itech tokalte:noh ka:sá: ika, seki:meh tikta:liah se: totio:tsi:n para mah te:ch..., mah te:chita.</ANNOTATION_VALUE>
