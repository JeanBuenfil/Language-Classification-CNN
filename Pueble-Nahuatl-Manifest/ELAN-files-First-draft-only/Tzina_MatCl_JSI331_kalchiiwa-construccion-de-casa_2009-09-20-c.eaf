        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>Tikta:li:tih se: kolo:tsi:n *de cera iesquina para** yo:n kali mah a:mo teh tatekipacho.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>Itech yo:n kali mah a:mo kalaki n' a:mo kwali,</ANNOTATION_VALUE>
