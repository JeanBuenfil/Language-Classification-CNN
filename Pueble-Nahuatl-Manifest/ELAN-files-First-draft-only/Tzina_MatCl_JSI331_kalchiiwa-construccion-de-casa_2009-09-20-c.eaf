        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>A:mo, a:mo *parafina**, ta..., tatsa:wak *cera** tein de nektsitsi:n.</ANNOTATION_VALUE>
