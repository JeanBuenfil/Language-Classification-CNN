        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>para miak iwi:kal n', n' xina:chmeh.</ANNOTATION_VALUE>
