        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>pero yo:n ihwa:k a:mo tapoliwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts529">
