            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>pos no:, no: ki:sas nehjó:n seki ie:wayo, ie:wayo tihtila:wak ihkó:n, ihkó:n de tihtila:wak achi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Nehjó:n wa:n nehjó:n ahko ne:n n' ima:i achi kahkana:wak n' ie:wayo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>pero ne: ka:mpa ne:n toma:wak, toma:wak ne:n kowit achi tihtila:wak</ANNOTATION_VALUE>
