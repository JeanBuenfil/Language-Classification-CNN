        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>*porque** nehjó:n yo:n tikiliah komekachalawih pero yo:n komekachalawih</ANNOTATION_VALUE>
