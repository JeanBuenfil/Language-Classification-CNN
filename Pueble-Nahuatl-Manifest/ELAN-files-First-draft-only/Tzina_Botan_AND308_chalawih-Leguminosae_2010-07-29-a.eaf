        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Mm, yo:n kowtahchalawih a:mo we:lik, welik *solamente** de nika:wí: chalawih</ANNOTATION_VALUE>
