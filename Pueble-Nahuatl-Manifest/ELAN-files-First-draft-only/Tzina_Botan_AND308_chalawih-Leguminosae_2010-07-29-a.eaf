        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>pos ki:sa ise:lti n' e:wat, moka:wa sayoh ihkó:n kowtsí:n ya,</ANNOTATION_VALUE>
