        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>a:mo *porque** tikiliah ya sayoh komekachalawih, yo:n nehjó:n ihkwí:n i:ixtapal kipia ke:meskia se: tapal ihkó:n achi, achi, achi xohxoxoltik, ihkó:n, ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Achi ihihwiyoh, ihkó:n ya:yahtok, ihkó:n ya:yahtok tikiliah komekachalachih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts278">
