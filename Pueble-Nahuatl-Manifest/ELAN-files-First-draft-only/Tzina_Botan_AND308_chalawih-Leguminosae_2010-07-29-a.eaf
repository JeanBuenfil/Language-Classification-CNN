        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>wa:n ko..., *hasta** se: kita ihkó:n *matitas** ne:n ixwak a de ihko:ntsitsi:n, ke:mah.</ANNOTATION_VALUE>
