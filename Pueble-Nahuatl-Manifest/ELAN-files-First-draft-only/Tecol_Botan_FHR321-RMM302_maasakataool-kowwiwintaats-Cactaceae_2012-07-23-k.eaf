            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>Ke:mah, telmiak tasohka:matik. Neh nimono:tsa Rubén Macario, niwa:le:wa de,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts390">
                <ANNOTATION_VALUE>Chilcuauhta, nipowi nika:n San Miguel.</ANNOTATION_VALUE>
