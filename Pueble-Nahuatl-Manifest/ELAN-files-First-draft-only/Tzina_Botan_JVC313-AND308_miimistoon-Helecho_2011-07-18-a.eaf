    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastasio Nicolás Damián" TIER_ID="Anastasio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>Pos i:n mi:misto:ntsitsi:n tikneki tikmatis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>[pos]i:n mi:misto:ntsitsi:n nejó:n *casi** ihkó:n mowila:na pero pos yo:n a:mo semi x..., nejó:n ... nikihto:s ne: [xa:]nejó:n no: taman, achi nextik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>A:mo xoxoktik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Nextik. Entó:s yo:n nejó:n ih..., ihkó:n yowi wa:n pos ke:meskia yo:n sa:sakatsi:n wa:n yo:n kwaltia no: para teisá: se: kikwi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>pero pos yo:n a:mo we:lik ok para se: kihto:s se: kikwa:ti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>Yo:n se: kikwi ihkó:n para teisá: ihkó:n teisá: mi:misto:n, de ke se: kikwi para taso, para teisá: ihkó:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>Teisá: ne: s...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>Ke:mah, ihwa:k se: kita:lia itech i:n *noche buena**, itech sempowal wa:n na:wi to:nal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Pos ihwa:k ki..., kitekih ne: kowtah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Ka:sá: ika kowtah wa:n ka:sá: ika kaltsi:ntan onkak wa:n pos yehwa yo:n tikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>Kiliah mi:misto:n *porque** pos *casi** n' i..., n' ima:i ihkó:ni, ke:meskia ohololtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Ohololtik, *por eso** kiliah miak tokni:wa:n ke mi:misto:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Ke:masá: kachi ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>Pos neh no: nikita ka:sá: ika ne:n kahfe:ntah *compadrito** ka:mpa, ka:mpa taxiti:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Ompa ka:sá: ika nejó:n no: se: kita</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Ke:mah, no: mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>Pero ka:mpa ne:n *más** kachi ne:n kowtah, ka:mpa achi chahcha:wit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>Pos ompa nejó:n mo..., mochi:wa, nejó:n a:mo ... Pos nikihto:s kaltsi:tan a:mo no: nochi mochi:wa pero yetok nejó:n wa:n pos ke:masá: no: to..., tokalihtik *cuando** yo:n ilwitsi:n nejó:n pe:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>wa:n nemitia ne:n te..., te:pixa:tsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>Pos nejó:n no: tik..., no: tikta:liah ya, nochi tikta:liah, nochi miak taman de n, de n iwi:kal, no: kiliah iwi:kal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Ento:s ne:n yehwa yo:n nochi tikmattokeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>iwa:n ne:n tio:pantsi:n nochi ki..., [ki]ta:liah, nochi titachihchi:wah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>Wa:n timosempale:wiah timiakeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>Nochi te:chtasohta *porque** yehwa ne:n te:chkwida:rohtok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>*por eso nejó:n, pe:wa nejó:n sempowal ika na:wi xiwit, we:noh, pe:wa ya para ne:n nochi sempowal na:wi to:nal pe:wa ya nejó:n ke:meskia nejó:n ne: *cuando**, pe:wa nejó:n *antes** ok pe:wa, nemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
