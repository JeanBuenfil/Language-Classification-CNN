        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735" TIME_SLOT_REF1="ts1302" TIME_SLOT_REF2="ts1304">
                <ANNOTATION_VALUE>*Bueno**, pos miak tasohka:matik, neh noto:ka:y Amelia Domínguez.</ANNOTATION_VALUE>
