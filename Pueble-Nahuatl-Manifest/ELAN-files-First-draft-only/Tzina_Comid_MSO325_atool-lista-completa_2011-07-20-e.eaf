                <ANNOTATION_VALUE>wa:n se: tai no:. Tetsaktsi:ni no: se: tai, pero yeh a:mo teh kipia niú:n tei tsope:k, n'mattok iwki sah se: kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665" TIME_SLOT_REF1="ts1141" TIME_SLOT_REF2="ts1143">
                <ANNOTATION_VALUE>Yo:n onkak de nochi, de yo:n *arroz** no: kwali se: kkwe:chowa wa:n no: kwali se: kimolo:ntia koma:li:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667" TIME_SLOT_REF1="ts1147" TIME_SLOT_REF2="ts1148">
                <ANNOTATION_VALUE>Ke:mah, no: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668" TIME_SLOT_REF1="ts1149" TIME_SLOT_REF2="ts1150">
                <ANNOTATION_VALUE>Ke:mah, no: pahti. ke:mah, yo:n no: pahti, no: yehwa n' kihtowah no: para kalanemi:lis oso pané: no: para estsompi:l, a:mo nikelna:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669" TIME_SLOT_REF1="ts1151" TIME_SLOT_REF2="ts1152">
                <ANNOTATION_VALUE>Pero yehwa yo:ni no: koma:li:xko mah se: kimolo:nti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670" TIME_SLOT_REF1="ts1153" TIME_SLOT_REF2="ts1154">
                <ANNOTATION_VALUE>Ke:mah, se: k..., se: kikwe:chowa wa:n no: *igual** mah se: kite:ka koma:li:xko wa:n ompa molo:ni a wa:n iwki titai a ololtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671" TIME_SLOT_REF1="ts1155" TIME_SLOT_REF2="ts1157">
                <ANNOTATION_VALUE>Ke:mah, pero tein yankwik n' koma:l n' tikwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674" TIME_SLOT_REF1="ts1163" TIME_SLOT_REF2="ts1165">
                <ANNOTATION_VALUE>Ke:mah, yehwa, yehwa yo:ni, para yo:ni neh n'mattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677" TIME_SLOT_REF1="ts1171" TIME_SLOT_REF2="ts1172">
                <ANNOTATION_VALUE>Yeh ka:n niweli, yeh a:mo niweli, neh de yo:n a:mo ke:man nikchi:w ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678" TIME_SLOT_REF1="ts1173" TIME_SLOT_REF2="ts1174">
                <ANNOTATION_VALUE>Miakpa n'nemilia:ya nimone:xtili:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679" TIME_SLOT_REF1="ts1175" TIME_SLOT_REF2="ts1176">
                <ANNOTATION_VALUE>ne:chili:aya ne: note:iskaltihka:w se: na:nahtsi:n nemia n' ompa ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a680" TIME_SLOT_REF1="ts1177" TIME_SLOT_REF2="ts1178">
                <ANNOTATION_VALUE>wa:n sepa nikilihka mah ne:chili ke:ní:w kichi:wa wa:n ka:n ai:k nikchi:w *cuenta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681" TIME_SLOT_REF1="ts1179" TIME_SLOT_REF2="ts1180">
                <ANNOTATION_VALUE>*Por eso** yo:n ka:n niweli, komo a:mo yo:n niweliskia *porque** ne:chne:xtili:skia ne:chilihka na:nahtsi:n wa:n nehwa ka:n nikchi:w *cuenta**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a682" TIME_SLOT_REF1="ts1181" TIME_SLOT_REF2="ts1182">
                <ANNOTATION_VALUE>Nikili..., niki:ilia:ya *cuando** nemia, nikilia tine:chne:xtili:s. Kihtowa, ke:mah nimitsne:xtili:ki:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683" TIME_SLOT_REF1="ts1183" TIME_SLOT_REF2="ts1184">
                <ANNOTATION_VALUE>pero ka:n ke:man nikchi:w *fuerza** nikitato mah, *bueno** mah nejó:n ne:chne:xtiliti, *por eso** ka:n niweli, komo a:mo no: niweliskia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a684" TIME_SLOT_REF1="ts1185" TIME_SLOT_REF2="ts1186">
                <ANNOTATION_VALUE>Ke:mah, *porque** yo:n a:mo n'mati ton xiwyo yo:n wel kikwih n' kihtowah pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a685" TIME_SLOT_REF1="ts1187" TIME_SLOT_REF2="ts1188">
                <ANNOTATION_VALUE>pero neli n' kihtowah *que** no: we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a686" TIME_SLOT_REF1="ts1189" TIME_SLOT_REF2="ts1190">
                <ANNOTATION_VALUE>Pero a:mo ke:man nikchi:w neh. Neh, yo:n nehwa nitapoloh *porque** a:mo nikitato yo:n na:nahtsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a687" TIME_SLOT_REF1="ts1191" TIME_SLOT_REF2="ts1192">
                <ANNOTATION_VALUE>ke:mah, ta: welia se: na:nahtsi:n ompa ne: nemia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a688" TIME_SLOT_REF1="ts1193" TIME_SLOT_REF2="ts1195">
                <ANNOTATION_VALUE>Wa:n kihtowa:ya *que** ne:chne:xtili:s pero nehwa a:mo nikchi:w *cuenta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693" TIME_SLOT_REF1="ts1205" TIME_SLOT_REF2="ts1206">
                <ANNOTATION_VALUE>A:mo, ika ko:mit, ika ko:mit, ika ko:mit *porque** ika ko:mit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694" TIME_SLOT_REF1="ts1207" TIME_SLOT_REF2="ts1208">
                <ANNOTATION_VALUE>*porque** n' tepos tiketsas yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695" TIME_SLOT_REF1="ts1209" TIME_SLOT_REF2="ts1210">
                <ANNOTATION_VALUE>molo:..., molo:ntos komo tikoihkak wa:n komo tiki:xtih, ne:paka xketsa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696" TIME_SLOT_REF1="ts1211" TIME_SLOT_REF2="ts1212">
                <ANNOTATION_VALUE>ompa se:wi wa:n ko:mit a:mo. Ko:mit tiki:xti:s momolokatok wa:n ne: tiko:nketsas wa:n molo:ntok ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a697" TIME_SLOT_REF1="ts1213" TIME_SLOT_REF2="ts1214">
                <ANNOTATION_VALUE>Wa:n i:n tepos se:wtiki:sa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698" TIME_SLOT_REF1="ts1215" TIME_SLOT_REF2="ts1216">
                <ANNOTATION_VALUE>*por eso** neh *más** nejó:n nikwelita nikwis ko:mit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699" TIME_SLOT_REF1="ts1217" TIME_SLOT_REF2="ts1218">
                <ANNOTATION_VALUE>Ke:mah, *hasta** nochi yehwa n' ke:meh yo:n nimitsilia tamal nikmana nochi ika ko:mit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700" TIME_SLOT_REF1="ts1219" TIME_SLOT_REF2="ts1220">
                <ANNOTATION_VALUE>*porque** yeh ma:ski wehka:was yetos, pero yo:n yowak tiktise:wili:s *[por]que** oksik a wa:n yo:n okyowatika tiwa:lme:was,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a701" TIME_SLOT_REF1="ts1221" TIME_SLOT_REF2="ts1222">
                <ANNOTATION_VALUE>tikwa:lkwi:ti:w *como siempre** toto:nik wa:n tepos i:pa se:wik a, *porque** yeh ne:nke:n se:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a702" TIME_SLOT_REF1="ts1223" TIME_SLOT_REF2="ts1224">
                <ANNOTATION_VALUE>Wa:n komo a:mo miak a:t tikte:kilih pos no: tatas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a703" TIME_SLOT_REF1="ts1225" TIME_SLOT_REF2="ts1226">
                <ANNOTATION_VALUE>wa:n i:n ko:mit a:mo, yeh tamachi:wtok tikte:kili:s n' a:t wa:n a:mo, wa:n a:mo tata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a704" TIME_SLOT_REF1="ts1227" TIME_SLOT_REF2="ts1228">
                <ANNOTATION_VALUE>*Por más, porque** yeh tila:wak n' ko:mit wa:n tepos ne:nke:n, pos kanaktik ihsiwka wa:ktiki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a705" TIME_SLOT_REF1="ts1229" TIME_SLOT_REF2="ts1230">
                <ANNOTATION_VALUE>Ne:nke:n nejó:n tami n' a:t wa:n *cuando** tikma:ahsiki:w pos i:pa tatak a: ne:n tamal, a:mo *igual** ok we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706" TIME_SLOT_REF1="ts1231" TIME_SLOT_REF2="ts1233">
                <ANNOTATION_VALUE>Wa:n ika ko:mit a:mo, *más** ki..., *más** we:lik yeh *porque** pos neli ka:n niman se:wi, nohma toto:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a708" TIME_SLOT_REF1="ts1235" TIME_SLOT_REF2="ts1238">
                <ANNOTATION_VALUE>Ke:mah, kachi kwali ika ko:mit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a709" TIME_SLOT_REF1="ts1239" TIME_SLOT_REF2="ts1240">
                <ANNOTATION_VALUE>Ke:mah ika ko:mit kwaltia *porque** neli n' tepos no: kwaltia pero komo tikitstok yo:n tikets[tok]ompa tikitstok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a710" TIME_SLOT_REF1="ts1241" TIME_SLOT_REF2="ts1242">
                <ANNOTATION_VALUE>a:mo mimilowis, pero komo tiko:ntaka:wilih *cuando** ne: tiahki i:pa mimilowiko ya *porque** ne:nke:n poso:niki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a711" TIME_SLOT_REF1="ts1243" TIME_SLOT_REF2="ts1244">
                <ANNOTATION_VALUE>Wa:n ko:mit no: *igual**, pos yeh *cuando** yo:n tikitas molo:niki a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a712" TIME_SLOT_REF1="ts1245" TIME_SLOT_REF2="ts1246">
                <ANNOTATION_VALUE>no: x'tsi:nki:xtili a ne:n kowit, *porque** komohkó:n tika:wa ne: mah ye:kkowtaxo:tato kwaltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a713" TIME_SLOT_REF1="ts1247" TIME_SLOT_REF2="ts1248">
                <ANNOTATION_VALUE>*cuando** yo:n nejó:n poso:niki a pos no: te:ta:ni *porque** ko:mit a:mo se:wtiki:sa wa:n komo yo:n tikita yekin pe:wa molo:ni entó:s x'tsi:nki:xtili wa:n ompa tikitstok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a714" TIME_SLOT_REF1="ts1249" TIME_SLOT_REF2="ts1250">
                <ANNOTATION_VALUE>*cuando** tiki:xtia ne: pos ka:n teh *pasarowa** ok, a:mo mimilowi ok, pero tepos se:wtiki:sa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a715" TIME_SLOT_REF1="ts1251" TIME_SLOT_REF2="ts1252">
                <ANNOTATION_VALUE>ne: tiko:nketsas wa:n ompa tamik, a:mo molo:ntok ok wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a716" TIME_SLOT_REF1="ts1253" TIME_SLOT_REF2="ts1254">
                <ANNOTATION_VALUE>*lo que es** nochi ko:mit a:mo iwki, yeh kwaltsi:n. *Hasta** se: *cazuela** ti..., ika t'chihchi:was motapalo:l no: kwaltsi:n ki:sa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a717" TIME_SLOT_REF1="ts1255" TIME_SLOT_REF2="ts1256">
                <ANNOTATION_VALUE>*porque** kawa:ntok nohma, *hasta** ne: tiko:nketsas wa:n kawa:ntok wa:n tepos a:mo *igual**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a718" TIME_SLOT_REF1="ts1257" TIME_SLOT_REF2="ts1258">
                <ANNOTATION_VALUE>Ke:mah, nochi tepos *lo que es** ika kokxitia mahyá: a:mo kwaltsi:n kokxitia, mahyá: xo:lotik sah ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a719" TIME_SLOT_REF1="ts1259" TIME_SLOT_REF2="ts1260">
                <ANNOTATION_VALUE>Wa:n ika ne:n *cazuela** yeh a:mo, yeh kwaltsi:n ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a720" TIME_SLOT_REF1="ts1261" TIME_SLOT_REF2="ts1263">
                <ANNOTATION_VALUE>Se: pio:tet tiktsoyo:ni:s no: kwaltsi:n ki:sas *porque** kawa:ntok kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724" TIME_SLOT_REF1="ts1270" TIME_SLOT_REF2="ts1272">
                <ANNOTATION_VALUE>Ke:mah weh, ta: neli kwaltsi:n ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726" TIME_SLOT_REF1="ts1274" TIME_SLOT_REF2="ts1277">
                <ANNOTATION_VALUE>A:mo teihsá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728" TIME_SLOT_REF1="ts1281" TIME_SLOT_REF2="ts1283">
                <ANNOTATION_VALUE>kwaltia. Ke:mah, ta: kwaltsi:n nikilia neh mah se: mone:xtili nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730" TIME_SLOT_REF1="ts1287" TIME_SLOT_REF2="ts1289">
                <ANNOTATION_VALUE>*Mientras que** se: pa:ktok nikilia neh *porque** komo sepa te:ahsik kokolis pos a:mo *igual** ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732" TIME_SLOT_REF1="ts1293" TIME_SLOT_REF2="ts1295">
                <ANNOTATION_VALUE>Ke:mah, pero de se: pa:ktok nikilia neh mah se: mone:xtili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734" TIME_SLOT_REF1="ts1299" TIME_SLOT_REF2="ts1301">
                <ANNOTATION_VALUE>María Salazar Osollo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737" TIME_SLOT_REF1="ts1306" TIME_SLOT_REF2="ts1309">
                <ANNOTATION_VALUE>A:h, *bueno**. De San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
