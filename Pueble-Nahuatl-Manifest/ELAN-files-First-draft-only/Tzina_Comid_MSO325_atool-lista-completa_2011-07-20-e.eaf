        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733" TIME_SLOT_REF1="ts1296" TIME_SLOT_REF2="ts1298">
                <ANNOTATION_VALUE>*Este** xine:chtapowi ke:ní:w moto:ka:y.</ANNOTATION_VALUE>
