                <ANNOTATION_VALUE>Pos ke:mah, neli nikaki mahyá: a:m..., mahyá: a:mo semi owih, mahyá: a:mo semi owih, soh *que** neli tikihtowa ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
