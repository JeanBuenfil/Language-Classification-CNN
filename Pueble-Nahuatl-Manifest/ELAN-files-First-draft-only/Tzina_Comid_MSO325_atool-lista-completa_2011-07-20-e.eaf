        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>sepatsi:n nitai:ka pero a:mo nikmati ke:ní:w se: kichihchi:wa,</ANNOTATION_VALUE>
