        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675" TIME_SLOT_REF1="ts1166" TIME_SLOT_REF2="ts1167">
                <ANNOTATION_VALUE>Ke:mah. Pos miak tasohka:matik ne:, tine:chtapowih ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a676" TIME_SLOT_REF1="ts1168" TIME_SLOT_REF2="ts1170">
                <ANNOTATION_VALUE>a:mo n'mati tehwa:tsi:n xa: tiweli ne: tikchihchi:wa yo:n a:xokoato:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689" TIME_SLOT_REF1="ts1196" TIME_SLOT_REF2="ts1197">
                <ANNOTATION_VALUE>A:xka:n ne:, nikneki ne:, tine:chtapowih ya nochi i:n miak taman, taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a690" TIME_SLOT_REF1="ts1198" TIME_SLOT_REF2="ts1199">
                <ANNOTATION_VALUE>ato:l tein teh tiweli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a691" TIME_SLOT_REF1="ts1200" TIME_SLOT_REF2="ts1201">
                <ANNOTATION_VALUE>Ye:wa tikihtowa:ya *que** ke:man se: kichihchi:wa n' tamal ika ko:mit okachi ahwiya:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692" TIME_SLOT_REF1="ts1202" TIME_SLOT_REF2="ts1204">
                <ANNOTATION_VALUE>wa:n i:n ato:l, ika tikchihchi..., ika tikchihchi:wa ko:mit oso yo:n tein ekintsi:n ki..., kinamakah ya ne:n tepos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707" TIME_SLOT_REF1="ts1234" TIME_SLOT_REF2="ts1237">
                <ANNOTATION_VALUE>Entó:s tehwa:tsi:n tikihtowa *que** okachi ne:, okachi kwali n' ko:mit mah se: kikwi ika se: kichihchi:wa n' ato:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a721" TIME_SLOT_REF1="ts1264" TIME_SLOT_REF2="ts1265">
                <ANNOTATION_VALUE>Wa:n i:n ato:l komohkó:n ika ko:mit, ¿no: kachi ahwiya:k?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a722" TIME_SLOT_REF1="ts1266" TIME_SLOT_REF2="ts1268">
                <ANNOTATION_VALUE>Ke:mah, no: *más** ahwiya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723" TIME_SLOT_REF1="ts1269" TIME_SLOT_REF2="ts1271">
                <ANNOTATION_VALUE>Pos miak tasohka:matik ne: ihkó:n tine:ch..., tine:chtapowia. Ke:man nikchihchi:was noato:l no: ika ko:mit nikchihchi:was a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725" TIME_SLOT_REF1="ts1273" TIME_SLOT_REF2="ts1276">
                <ANNOTATION_VALUE>Ke:mah. Pos miak tasohka:matik tine:ch..., tine:chyo:lmela:w. Ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a727" TIME_SLOT_REF1="ts1278" TIME_SLOT_REF2="ts1280">
                <ANNOTATION_VALUE>a:..., a:xá:, a:xá: nimomachti:s se:meh de i:n ato:l tein teh tine:chtapowih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a729" TIME_SLOT_REF1="ts1284" TIME_SLOT_REF2="ts1286">
