        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656" TIME_SLOT_REF1="ts1120" TIME_SLOT_REF2="ts1123">
                <ANNOTATION_VALUE>Pos tikmolo:ntia itech koma:l, a:mo teh t'tapechtia</ANNOTATION_VALUE>
