        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660" TIME_SLOT_REF1="ts1130" TIME_SLOT_REF2="ts1132">
                <ANNOTATION_VALUE>Para pahti. ¿Ton pahti, ton kokolis kipahtia?</ANNOTATION_VALUE>
