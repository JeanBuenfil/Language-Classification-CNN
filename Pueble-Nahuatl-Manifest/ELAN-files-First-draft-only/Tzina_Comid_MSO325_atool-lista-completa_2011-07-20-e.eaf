        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a640" TIME_SLOT_REF1="ts1083" TIME_SLOT_REF2="ts1084">
                <ANNOTATION_VALUE>Ne:, tine:chtapowih ya i:n miak taman ato:l tein teh tiweli wa:n tih..., ti..., titai mocha:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
