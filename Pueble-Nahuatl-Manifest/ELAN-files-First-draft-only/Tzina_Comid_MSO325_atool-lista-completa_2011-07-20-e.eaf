                <ANNOTATION_VALUE>Wa:n tixti ki..., ki..., ompa kite:mah koma:li:xko tikihtowa kimolo:ntiah oso tao:l *o**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
