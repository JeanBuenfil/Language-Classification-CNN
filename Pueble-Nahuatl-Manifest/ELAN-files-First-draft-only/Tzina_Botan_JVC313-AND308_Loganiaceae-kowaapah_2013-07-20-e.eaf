    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="José Ernesto Vázquez Chanico" TIER_ID="José Ernesto Vázquez Chanico">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>We:noh pos a:man ke sepa nika:n timona:mikih no: nikneki nimitstahtani:s ox tiki:xmattok yo:n seki xiwit mochi:wa ata a:mo, a:mo wehkapantia, ke:meh se: *cuarta** wa:n tahko, o:me *cuarta** telwekapan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>ata ma:ahalaxtik wa:n achi *medio** ma:..., xoxoktik pero teltihti:ltik kachi *más** i..., xiwit, itapalo ti:ltik semi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>wa:n xoxo..., xoxoktik pero a:mo xoxoktik, a:kostik *si no que** ye:kkwaltsi:n xoxoktik semi i:n xiwtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>Wa:n metsahalaxtik wa:n imetskowyo tepitsi:n *medio** tihti:ltik imetskowyo ata, ne: komoke tein ta:lte:noh tihti:ltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>wa:n moxo:chio:tia ne: iyo:la:n ya ka:mpa tamiti a ne:n ine..., ineketsalis wa:n poso:ni sah, we:noh moxo:chotia pos ki:sa ne: i..., ix..., ikowyotsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>*arquito** wa:n ompa motekpa:ntiw a ne: pané: kokotsitsi:n ompa ki:sa ata xo:chitsi:n ata ihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>Yehwa yo:n ox tiki:xmattok, yo:n xiwit ta: neh nikte:kakilih ke kwaltia para, para kowa:p..., ki:..., mo..., ki:xmatih kowa:pah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>*porque** kwali, ke:meh i:n pilimeh pos ko..., kowa:tih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>yehwa kininmaniliah wa:n kintai:ltiah pilimeh wa:n kintamo:tah okwilimeh, ihtikowa:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Yehwa ika tikiliah kowa:pah,yehwa nikneki nikmatis no: ox, ox tikmattok ke para yehwa sah yo:n kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
