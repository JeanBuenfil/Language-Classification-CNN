        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>Wa:n yo:n se: *vez**, we:noh ki..., no: kwali nehjó:n kekexikilit ne: ikamohyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>Kitehtekih ihkó:n kwaltsi:n, yohyowaltik kitehtekih ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Wa:n ika te:pepechowiliah ka:mpa ne: wa:n koma:mo no: ki..., kichichinowah ne:pa ka:mpa ne: te..., te:..., te:kwi ne:n okwilin, te:..., te:k[ua].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>Wa:n ompa kita:liliah, kichichinowah ika tit para mah tata ne:n ite:na:yo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n kwali ne:n ki..., se: kita:lilia para nehjó:n kachi yo:n yohyowaltik wa:n se: kipepechowilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>*o** bien kip..., kipaya:nah, nochi kwaltsi:n kwe:chowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>wa:n tikpepechowiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>Nehjó:n ne:n kekexikilit ikamohyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>Xa: no: tikmati wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>*Porque** ne:n, ne:n *veneno** tein ne: kitamo:ta ne:n okwilin, kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>Kostik, kampeya:wa ne:n no:, ke:meh nekti kampeya:wa wa:n yehwa yo:n te:..., pos se: miki koma:mo te:pahtiah, pero *antes** tota:tahwa:n ika ki..., mopahtia:yah nehjó:n kin..., para yo:n *de malas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>Ke:meh i:n se: tekiti pos ompa se: moahxi:ltia nehjó:n okwilin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>Pero yo:n tein okwilin tein na:weya:kas, yehwa ya ne:n kowa:we:wentsi:n oso mia:watsi:n, no: yo:n *gual** nochi kipiah nehjó:n *veneno**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>Na:wi, a:, na:wi kohkoyoktik iekatsol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
