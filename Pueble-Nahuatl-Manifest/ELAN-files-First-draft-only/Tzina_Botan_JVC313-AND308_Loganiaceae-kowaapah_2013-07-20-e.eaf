    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="Anastacio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>Tiko..., wa:n pos ... Wa:n yehwa i:n tikneki tikmatis pos, pos ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Semi kwali a de ke timona:mikih itech nehjí:n ohti, ke:masá: nika:n timoahsih, *siempre** timona:miktinemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Pos no: kwali a ke tine:chtahtania ox niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>No niki:xmati yo:n kowa:pah xiwit kiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Yo:n yehwa kinmakayah kone:meh de ke kinkwi yo:n kowa:meh, tak ompa moskaltia itech se:, se: ihtik ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>de ko..., se: *cada**, se: kone:t wa:n yehwa yo:n kwi:li:tih ne:n kowa:pahxiwit wa:n ki..., kimanah wa:n yehwa yo:n kintai:ltiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>wa:n yo:n pos no: kima:nelowah ke:masá:, ne: ke:man kima:nelowa:yah yehwa yo:n iwa:n yo:n epaso:t no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Epaso:t no: ki..., kisemanayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Wa:n kitai:ltia:yah ne:n kone:t *porque** yo:n ki..., ika e:wa, oso ika se: e:wa ne:n moskaltihtiowih yo:n kowa:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Yo:n kowa:meh ka:mpa yetokeh yehwa yo:n kintai:ltiah para wetsi ne:n, ka:sá: ika kihtowah incha:n kit se: *bola** yetokeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>wa:n yehwa yo:n ne:n te:kokoh se: ihtik, kinkokowa kone:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>wa:n nehjó:n no: yeh tsikitsitsi:n, a:mo semi wehkapantia nehjó:n kowa:pahxiwit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>pero neh no: niki:xmattok seki kiliah yo:n teposihya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>Yo:n kihtowah iwa:n no: kima:nelowah oso no: se: ... Kimanah no: kwaltia para n' kowa:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts78">
