        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>Tsikitsi:n, *o sea** ni:nipaka momahma:yo:tia pero miak mota:lilia ima:i.</ANNOTATION_VALUE>
