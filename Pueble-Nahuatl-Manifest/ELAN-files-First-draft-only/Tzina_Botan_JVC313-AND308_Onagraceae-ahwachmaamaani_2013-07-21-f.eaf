        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>Soh ke semi tsikitsitsi:n, para se: kia:ketsas a:mo, a:mo kwaltias tak pero pos yo:n *solamente** para tapala:n, kihtowah ke no: kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>No: kwaltia nehjó:n xo:chitsi:n soh ke pos a:mo onkak nowya:n, ta: sayoh e:wi ka:mpa se:, ihkó:n se: tato:ka pos ompa ne: e:wi itsi:ntan mi:ltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Ompa ne: yetok wa:n pos ompa a:mo nikihto:s semi we:i mota:lia, ta: tsikitsitsi:n.</ANNOTATION_VALUE>
