        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Pos kwaltsi:n, nochi se: kita nehjó:n xo:chitsi:n, yo:n itsi:ntan mi:l no: se: kita ne:n yetok, e:wi.</ANNOTATION_VALUE>
