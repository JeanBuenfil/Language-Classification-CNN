                <ANNOTATION_VALUE>Ompa ne: itech ohte:noh ka:mpa ne: tato:kalah. Ahwachma:ma:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Pos kwaltsi:n ne: yo:n, soh tsikitsitsi:n, a:mo semi telwehwei i:n xo:chit, ihkó:n de weh..., a:mo semi moskaltia.</ANNOTATION_VALUE>
