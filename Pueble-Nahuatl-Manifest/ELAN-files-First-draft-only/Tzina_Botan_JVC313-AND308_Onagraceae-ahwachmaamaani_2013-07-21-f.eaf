        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>Pos kwaltsi:n no: ne: i..., ke:mah ne:. Pos no: kwaltsi:n se: momati:ltia ihkó:n de ke:meh ihkó:n no: tikmattok nika:n timona:mikih pos timotapowiah katí:n xo:chitsi:n ika ne:n nehjó:n se: ki..., se: kita *porque** de eti:ya pos wetsiti a ne:n xo:chitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts266">
