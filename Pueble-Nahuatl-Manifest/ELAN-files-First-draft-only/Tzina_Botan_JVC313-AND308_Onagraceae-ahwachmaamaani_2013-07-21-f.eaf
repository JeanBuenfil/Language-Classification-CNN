        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Entó:s pero yo:n a:mo kanah nikita ne:wí:n kowtah, ne: ox onkak *o** kahfe:ntah</ANNOTATION_VALUE>
