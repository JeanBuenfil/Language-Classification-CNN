            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>Miak mota:lilia wa:n kwaltsi:n ni:nipaka ne: mochi:wa ne:n xo:chit.</ANNOTATION_VALUE>
