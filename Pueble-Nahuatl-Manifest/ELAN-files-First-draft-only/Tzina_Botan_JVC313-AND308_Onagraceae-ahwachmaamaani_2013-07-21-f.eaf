        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Pos ihkó:n ti..., nochi moka:wa itech ne:n x..., xo:chitsi:n *o** itech ima:yo, *porque** ima:yo ne:n ...</ANNOTATION_VALUE>
