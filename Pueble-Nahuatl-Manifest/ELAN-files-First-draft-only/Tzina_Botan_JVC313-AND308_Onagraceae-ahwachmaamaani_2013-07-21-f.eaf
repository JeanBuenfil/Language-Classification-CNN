        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Mona:nakasikata:lia *por eso** kiliah ahwach..., ompa mo..., a:mo ihxi:ka.</ANNOTATION_VALUE>
