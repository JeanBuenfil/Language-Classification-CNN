                <ANNOTATION_VALUE>pero kwali no: tine:chilwi:s teh xa: ka:sá: ika tikita ne:wí:n kahfe:ntah oso ka:sá: ika kwowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts123">
