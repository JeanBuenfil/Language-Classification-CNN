                <ANNOTATION_VALUE>A:man pos sepa ne: tiknekih xite:chtapowi, ox tiki:xmattok yo:n xiwit kiliah ne:n kwamo:so:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
