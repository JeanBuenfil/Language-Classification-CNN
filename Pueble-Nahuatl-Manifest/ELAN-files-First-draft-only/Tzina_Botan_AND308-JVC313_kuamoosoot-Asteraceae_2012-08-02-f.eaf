                <ANNOTATION_VALUE>Yo:n no: kwaltia no: para ne:n kinta:liliah in..., inkwitapan pilimeh wa:n in..., inimpoxko kinta:liliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>Wa:n nehjó:n kimahmá: kit mahyá: kite:tehtekih para ki:s..., ki:sa nexwitil wa:n yo:n nexwitil niman, niman kimatih te:moma:wa:n de ke kení:w, ke:ní:w para kimatih yo:n nexwi..., nexwi..., moxwitiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
