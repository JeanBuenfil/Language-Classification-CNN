                <ANNOTATION_VALUE>ka:sá: ika se: kitas *hasta** ne:nentokeh ihkó:n pata:nte:wah, ikwa:ko de yo:n xiwtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Entó:s neh niki:xehekowa no: kwe:liliah xa: a:mo, a:mo chichi:k eski, xa: achi tsope:k *o** xa: ahwia:k</ANNOTATION_VALUE>
