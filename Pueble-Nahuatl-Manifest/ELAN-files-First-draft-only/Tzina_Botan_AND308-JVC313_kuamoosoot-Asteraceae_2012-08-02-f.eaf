        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Pero ka:sá: ika ihkó:n mi:lah a:mo, a:mo kachi se: kita. A:mo kachi se: kita wa:n ....</ANNOTATION_VALUE>
