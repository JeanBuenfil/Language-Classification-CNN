            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Ke:mah moskaltih ke..., yo:n a:mo ika *tiempo** poso:ni, yo:n poso:ni ke:m..., ke:man ahsi ineke..., [mo]iskaltiaitech n' kowit</ANNOTATION_VALUE>
