                <ANNOTATION_VALUE>Ka:n no: kachi nikmati pero nehjó:n no: tikma..., no: t'te:kakiliah ke yo:n kwomo:so:t nehjó:n ki..., takwe:chol wa:n ki..., ki..., kite:kiliah yehwa n' *aceite**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>seki yo:n tikihto:..., kowachxiwit kita:li..., ika te:ta:liliah *o** seki ika yo:n, yo:n a:ko:kohxiwit iwa:n kit kita:liliah no:.</ANNOTATION_VALUE>
