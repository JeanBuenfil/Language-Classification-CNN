        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Te:..., te:..., kima:xakwalowah kwaltsi:n ihkó:n wa:n te:ta:liliah.</ANNOTATION_VALUE>
