        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Ke:masá: pos tepampi:kih se: *ilomo** os ka:sá: ika se: ima:ko wa:n pos yo:n kwali, kwali nexokoli:lpan wa:n pos teh no: tine:chili:s xa: kachi tikmattok de ke nehjó:n ox yehwa sah para yo:n pahti de ka:mpa se: moxokolia.</ANNOTATION_VALUE>
