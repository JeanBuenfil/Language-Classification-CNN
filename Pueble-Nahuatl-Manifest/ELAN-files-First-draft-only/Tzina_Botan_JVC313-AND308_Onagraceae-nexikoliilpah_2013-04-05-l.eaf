        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>Wa:n ti:le:wi wa:n yeh te:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>Te:kokoh wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>Pos nehjí:n nexokoli:lpah miak kite:mowah, miak kite:mowah *porque** kimattokeh ke de i:n semi kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>Pahti no:, yehwa ne:n, yehwa *solamente** yehwa yo:n nexokoli:xpah kiliah *porque** ne:n ka:mpa se: moxokolia pos yehwa ne: se:, se: kite:mo:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Pero neh a:mo nikmati *más** ox ne: ... Teh xa: kachi tikmattos para ton seki ne:n kikwih, xa:, os sayoh ka:mpa se: moxokolia oso *más** okseki, okseki kokolis ka:mpa se: mo..., teisá: te:..., te:ahsi. Ox te:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Wa:n yo:n kitsompi:kihya para mi..., mah mi:to:[ni].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>A:mo se: kimati, pero ekintsi:n kwaltsi:n no: ti..., timomati:ltiah, ke:masá: tiknekih para nen topi:pilwa:n oso ke:meh i:n okseki kone:meh ihkó:n te:chiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>Pos kwali se: kite:mos wa:n kwali se: kichi:was nehjó:n se: ki... kina:lpi:chi:s i:n kone:meh oso *hasta** se: yehwa ke:meh i:n se: wetsi no:, ma:ski se: wehwei:n pero no: se: momowtia. Se: momowtia wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>Pos yehwa yo:n kwali no: se:, no: se: tai:s oso kwali te:ohxili:skeh, te:a:lpi:chi:skeh no:, se: itsontekon, se: ipoxko, se: imetsko, nochi kwali, nochi no: te:na:mikis ta: yo:n a:mo nikihto:s se: kikowati, se: kite:moti ne:w..., ne:pa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Se: kite:mo:ti ne:wí:n ka:mpa n' tehtetah, ne: ka:mpa kisa:lohtokeh tet oso ka:mpa *calzada**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>Ompa se: kahsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>Ompa se: kahsi wa:n yehwa yo:n mah se: kite:mo:ti:w, semi kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>Pos nehwa nimo..., nimono:tsa Anastacio Nicolás Damián, niwi:tsa de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>Mm, tasohka:matik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
