            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>Mm, a: we:noh. Entó:s meh na:no xke:waya ne:n tasa:ltsi:n wa:n mah niow *porque** tayowati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Tayowati. Ke:ní:w timono:tsa na:no chika. A:. a:ah. Tepango.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Neh ko..., [...]ka:n ke:masá: tikahsika:matisneki ke:niwkitik noma..., noma:tachihchi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>*Este** kwali tine:chtsi:ntokas *por, por** noto:ka:i, nimono:tsa Francisca Rivera Pérez.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Aha, iwki nimono:tsa.</ANNOTATION_VALUE>
