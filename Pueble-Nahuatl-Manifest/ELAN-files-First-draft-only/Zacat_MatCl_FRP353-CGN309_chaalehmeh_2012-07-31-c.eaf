        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>Mm, ne: xitatsi:ntoka ne: Tepango ke:man tiahsis ka:ni nimoahsi.</ANNOTATION_VALUE>
