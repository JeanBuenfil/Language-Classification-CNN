        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>Ompa mitsi..., mitsilwi:skeh *porque** no: ne:chi:smattok miakeh towa:mpoywa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>Mm, we:noh na:no telmiak tasohka:matik mah niow wa:n sepa nikitaki:w tein moka:wa ok no do..., notaahsika:yo:w.</ANNOTATION_VALUE>
