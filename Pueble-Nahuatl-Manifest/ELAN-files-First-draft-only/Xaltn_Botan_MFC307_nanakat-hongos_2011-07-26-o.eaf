    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="Eleuterio Gorostiza Salazar">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Ekintsi:n na:nah pos *este** tite:chnohno:tsati i:n ta:taman nanakat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>tein nika:wí:n kowtahpa mochi:wa oso kaltsi:ntan oso ohte:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>Mah tipe:wte:waka:n ika i:n xo:no:nanakat, te:chili ke:ní:wki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>ka:ni mochi:wa, ke:maniá:n mochi:wa wa:n ke:ní:w se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Ke:niwki i:n nanakat, ti:ltik, kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>*Bueno** a:man, ne:, tite:chtapowih ya xo:no:nanakat, ekintsi:n xte:chilwi ke:niwki i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>tein teh t'to:ka:ytia ma:tananakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>¿I:n oksé: nanakat mono:tsa ka:walpox, i:n ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Wa:n yehwa ne:n i:n ka:walpox, ¿ton kowyo yeh n' ke:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>I:n nanakat, tikihtowa iwkitik a ma:tananakat, sayoh achi tihtila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>¿I:n tiltik, kostik, oso ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>Wa:n ma:tananakat yeh n..., ne:si ihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>A:man, tipano:tih ika i:n oksé: taman nanakat, i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>monotsa alakcho, ¿ka:nachi taman onkak?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Yehwa ne:n ti:ltik a:mo wel se: ki..., se: kimana oso se: kikwa chi:lposo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>¿Wa:n i:n ton kowyo ne:n ke:wa, yehwa i:n ti:ltikalakcho?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>¿Wa:n tein chi:chi:ltik?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Wa:n yo:n alakcho nochipa ya n' onkak *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>etok sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>Yehwa i:n chi:chi:ltik, ¿ke:ní:w se: kikwa komo se: kikwa:sneki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>*Bueno** ne:, ekintsi:n mah tipano:ka:n ika i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>se: nanakat, teh t'to:ka:ytia xopitsa, ¿ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>Wa:n yeh i:n xopitsa, ¿ke:ní:w ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>ke:niwki, ihista:k, kohkostik wa:n ke:ní:w se: kikwa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>Wa:n yehwa i:n xopitsa, ¿ke:ní:w se: kikwa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Wa:n, a:man xite:chilwi de i:n seki nanakat, teh tikilwia ichpo:chnanakat, ¿ke:niwki yo:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>¿I:n no: kwali se: kikwa chi:lposo:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>A:man i:n oksé: nanakat mono:tsa chikinte, ¿yeh ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>I:n nanakat, ¿ke:niwki? Ista:k, chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts498">
                <ANNOTATION_VALUE>¿I:n nanakat, etok sah n' ke:man onkak *o** nochipa ya n' onkak?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>A:man i:n to:tolko:skat, ¿ka:nachi taman?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts558" TIME_SLOT_REF2="ts560">
                <ANNOTATION_VALUE>Nochi n' o:me taman, nochi we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>I:n to:tolko:skat i:pa ta:a:man sah se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>¿Ton xiwyo kwali se: kikwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>A:man, ne:n, ¿chi:ltaxkal ka:nachi taman onkak?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>Yo:n tein tik..., tikihtowa tsikitsitsi:n, ahkwa:kopa wa:le:wa, ¿ton kowyo yeh n' ke:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>Yehwa i:n okonanakat, ¿ka:ni mochi:wa, itech katí:n xola:l?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>¿Katí:n San Juan, Las Lomas *o**...?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts676">
                <ANNOTATION_VALUE>Wa:n yehwa ne: i:n chi:ltaxkal nochi iwki sah se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>I:n oksé: nanakat mono:tsa pi:sih, i:n, ¿ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>¿Wa:n yehwa i:n pi:si:n, no: kwali se: ki..., kikwe:cholia tomat wa:n chi:l?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>¿Kati:yeski chi:l *o** yetok sah n' chi:l?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts749">
                <ANNOTATION_VALUE>A:man ne: i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>oksé: nanakat, i:n mono:tsa xilwananakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts763">
                <ANNOTATION_VALUE>I:n xi...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts765" TIME_SLOT_REF2="ts767">
                <ANNOTATION_VALUE>i:n xilwananakat, ¿ke:niwki yeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts777">
                <ANNOTATION_VALUE>I:n a:mo nika:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts785">
                <ANNOTATION_VALUE>Yehwa i:n xilwananakat, a:mo tikmati ton kowyo n' ke:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>Yehwa i:n, ¿ke:niwki ne:n itapalo, kostik, chi:chi:ltik *o** ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>Wa:n i:n tikilia kosawik, ¿ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts831">
                <ANNOTATION_VALUE>Wa:n yo:n *este**, ¿ka:ni ne:n mochi:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>¿Wa:n i:n ke:ní:w se: kikwa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts855" TIME_SLOT_REF2="ts857">
                <ANNOTATION_VALUE>Yeh a:mo wel se: kikwa chi:lposo:yoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts873">
                <ANNOTATION_VALUE>Ompa tikakik no: i:n to:ka:it kosawik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts893">
                <ANNOTATION_VALUE>A:man i:n oksé: nanakat, *este** teh t'kilia seknanakat, ¿ke:niwki i:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>Wa:n i:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts921">
                <ANNOTATION_VALUE>¿Yo:n, chi:lposo:n a:mo we:lik?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts947" TIME_SLOT_REF2="ts948">
                <ANNOTATION_VALUE>Ye:wa tite:chilih *que** ne:n ahkwa:kopa ka:mpa tikihtowa ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts949" TIME_SLOT_REF2="ts950">
                <ANNOTATION_VALUE>San Juan mochi:wa seki kiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts951" TIME_SLOT_REF2="ts952">
                <ANNOTATION_VALUE>okonanakat, tikihtowa *que** mehmetseh ke:meh xo:no:nanakat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts953" TIME_SLOT_REF2="ts955">
                <ANNOTATION_VALUE>tamatisneki. ¿Yo:n ka:ni mochi:wa, itech kowit oso ta:lpan nochi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts989" TIME_SLOT_REF2="ts991">
                <ANNOTATION_VALUE>¿Yeh yo:n nanakat ke:ní:w se: kikwa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a564" TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1004">
                <ANNOTATION_VALUE>Teh tikwa:ya a:koloh wa:n yehwa:n ke:ní:w n' kikwa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts1013" TIME_SLOT_REF2="ts1015">
                <ANNOTATION_VALUE>¿Wa:n tika:ko:lwia:ya, t'ta:lilia:ya no: teihsá: xiwit?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts1025" TIME_SLOT_REF2="ts1027">
                <ANNOTATION_VALUE>Nika:wí:n no: mochi:wa seki nanakat, a:mo n'mati ox tiki:xmati n' teh, yo:n kiliah xi:yo:nanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts1031" TIME_SLOT_REF2="ts1033">
                <ANNOTATION_VALUE>Neh a:mo niki:xmati pero teh kwali tite:chili:s ke:ní:wki, komohkó:n i:xtohtohmiyoh, ox kostik, ti:ltik, ¿oso ke:ní:w?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts1059" TIME_SLOT_REF2="ts1061">
                <ANNOTATION_VALUE>Yo:n a:mo wel se: kikwa chi:lposo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts1075" TIME_SLOT_REF2="ts1077">
                <ANNOTATION_VALUE>Yehwa i:n xi:yo:nanakat, ¿ton kowyo n' ke:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts1087" TIME_SLOT_REF2="ts1088">
                <ANNOTATION_VALUE>*No** pos pané: nochi a ne: i:n nanakat tein nika:wí:n onkak, tasohka:matik, tite:chtapowih ke:ní:w ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>kwali se: kikwa:s, moto:ka:y wa:n moxola:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
