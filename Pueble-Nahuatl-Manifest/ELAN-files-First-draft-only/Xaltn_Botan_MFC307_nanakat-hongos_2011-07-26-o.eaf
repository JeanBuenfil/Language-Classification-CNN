        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>o:me taman, o:me taman. Onkak ye:ktihti:ltik wa:n onkak ye:..., *medio, medio**, ke:meh eskia chi:chi:ltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>wa:n yeh n' ti:ltik ahalaxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>Komo ko:kone:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>pané: *medio** pantehtenextik wa:n komo wehweyak mochi:wa *hasta** ihko:kó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>we:i mochi:wa ihkó:n, mahyá: *cucharita**, mahyá: se: *plato** ihkó:n mota:lia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>ye:k..., ke:mah komo tikahsik wa:n timotekilih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>yo:n kwali t'tewa:tsa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>T'tewa:tsa ihkó:n, tikpoye:lia, tikpa:ka wa:n tikpoye:lia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>wa:n t'ta:lia itech n' koma:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>ompa timo..., tike:kepa ya, kwaltsi:n no: tewa:ki ihkí:n moehke:w kwaltsi:n, kwaltsi:n mochi:wa ke:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>ke:meh se: taxkaltsí:n tewa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Ke:mah, xtakwa ya, xikwa ya no:, ika taxkaltsí:n *o** t'neki tikwa:s iwki pos iwki tikwa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Ke:mah, yehwa ihkó:n se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>kwali se: kimanas, kwali se: kimanas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>No: weli se: kimanas, komo se: kineki pos se: kimana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Se: kimana ne:n nanakatsí:n wa:n no: t'ta:lilia ne:n tomatsí:n sake:ra se: *o** o:me,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>komo *dios** mitstayo:kolia wa:n ke:mah tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>tikta:lilia n' *a ver** kati:yeh tikwi, tikneki xiwtsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>epaso:t *o pimienta** pos nochi kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Ti:ltikalakcho ke:wa yehwa ne:n, no: ke:wa ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>kahfe:nkowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>kahfe:nkowit tein yo:n kowte:n pala:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>se: kowtsí:n ihkó:n mochi:wa wa:n ke:mah ompa moi..., moewalo:ltia ike:span.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>Ike:span *o bi...,bien** itsi:ntan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>*o bien** inalwayo, ompa mochi:wa yo:n nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>Tein chi:chi:ltik no: mota:lia itech yehwa n' chalawih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>No: ohonkak kahka:ni mota:li:s. A:mo no: *como...**, ke:meh eskia a:mo no: eliwis sah mota:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>Ohonkak tohton kowyo n' ke:was wa:n katí:n kowit kita:li:s no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Neh n'mattok *porque** neli ihkó:n nmoahxilia:ni wa:n neli, tein katí:n ya eski kowtsí:n tikahxili:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Pero yehwa chalawih *o bien** xokokowte:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>Xokokowte:n *porque** yeh kihtowah *que más** kipia ke:meh eskia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>kipia *fuerzas para** kita:li:s yo:n nanakatsí:n o:me taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Ke:mah, *porque** yeh takwa:wak wa:n a..., ke:meh eskia ahwia:k n' ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>No: ika *tiempo**, ke:meh a:man, ke:meh a:man mochi:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>I:n agosto no: mochi:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>Ip..., i:n pe:wati a no:, mochi:wati a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Neh nimomaka *cuenta porque** nokowtah nochi yehwa mochi:wa *cuando** ke:meh yo:n kiowi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>Se: *viaje** kahsik *noseñortsi:n** semi se:, se: *morral**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>Kihtowa ox tikwa:s. Nikilia nikwa:skia nikilia pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>*pero mejor** nikilia xka:wati ka:ni n' tika:wati:w nikilia *porque** wel te:ihtikokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>Yo:n semi te:ihtikokoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>n' alakcho, ke:meh seknanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>Seknanakat no: *igual** ye:ktelte:kokoh, te:ihtikokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Pos komo tikneki no: t'chi:wa ne: chi:lposo:n neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>Pero komo t'mattok *que** mitsihtikokowa pos *mejor** a:ksá: x..., a:ksá: x'maka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Sake:ra ohka:n, e:xka:n xki:xti tepitsitsi:n wa:n mah kikwa:ka:n yehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Ke:mah, *porque** iwki kichi:wa ne: no..., nota:tahtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>*Porque** a:mo kineki kikwa:s. Kihto:s mitsihtikoko:s *o** ne:chtsihtikoko:s, mah n'wa:nti yehwa i:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Nikili:s *bueno**. Ke:meh kimpia pi:pil, kinimahmaka ipilwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Xopitsa ihista:k</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>wa:n tsikitsitsi:n ke:meh *sombrilla**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>Wa:n imetstsi:n, komo *que** ke:meh i:n xikwi n' imetstsi:n wa:n m..., x'posteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>ye:kkwatsi:n pané: yo:n, pané: o:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>pané: yo:n nejó:n xawaktik n' imetstsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>Yo:n *que** semi ke:wa kopalaktsí:n kwal...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>ke:meh eski kwopalaktsí:n pero semi ke:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>Yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Ihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>Ihista:k, ihista:k ne:n xopitsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Nikmattok *porque** ihkó:n neh n' wehka:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>nopi:pilwa:n nikimpiaya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>pos nota:tahtsi:n a:mo ahsi para *kinimanteneros** ika n' tapa..., tap...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>tapalo:l, kinkowili:s et, kinkowili:s teihsá: tein wehwe:lik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>entó:s yehwa yo:n neh nikte:mowa:ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>wa:n nikinchihchi:wilia:ya nopiliwa:n ika, ika chi:ltamo:taltsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>Nikchi:wa n' chi:ltamo:ltaltsí:n wa:n nikinte:milia nanakatsí:n mah kikwa:ka:n ika n' taxkaltsí:n, kikwa:yah noko..., nopi:piltsitsi:n ihkó:n ke:meh eskia *taquitos** ika yehwa yo:n nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>Ki:xpihpi:kih wa:n takwah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>Tehwa:n nimitsilihtok *que** yehwa:n ika kikwa:yah nopiliwa:n ika chi:ltamo:ltal tatewa:tsal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>Komo moneki se: kimanas, no: *igual** n' a:tsí:n ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>ahwia:k, ahwia:k n' a:tsí:n no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>No: onkas, n' ampo:wí:n no: mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE>Soh *que** a:mo se: momaka *cuenta**, onkak kihtowa i:n xa: *veneno**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Pero yo:n a:mo *veneno**, niman t'matis tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>ika se: ttila:na wa:n t'posteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>komo postek ke:meh ne: sese:kpahxiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>ihsiwka posteki wa:n *hasta** kakisti, yehwa ne: xopitsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Entó:s x'teki, komo tikahsi se: *bola** kwali pos tikteki wa:n tikwa:lkwi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>Ke:mah, no: telahwia:k, we:lik no: nanakatsí:n. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Ichpo:chnanakatsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>ichpo:chnanakatsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>yeh mochi:wa ihkó:n wehkapan wa:n kwaltsi:n mota:lilia ihkó:n mahyá: *sombrilla**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Wa:n komo tikahsiti, ihkwí:n x'chi:wa ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>pos ompa mahyá eski:stiki:sa, mahyá: eski:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>Entó:s yehwa ya ne:n ichpo:chnanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>*Porque** onkak no: achi, no: achi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>wa:n imetstsi:n xahxawatik no:, metstohtoma:wak ke:meh nomahpil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>Ke:meh nomahpil metstohtoma:wak ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>ichpo:chnanakat, pero ne..., ni..., mochi:wa wehwei</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>ihkó:n. Wa:n komo mochi:was a:mo miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>Ka:mpa mochi:was *solamente** mochi:was sake:ra chikwase:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>chikwase:n nanakatsí:n mochi:was,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>pos yo:n se: kwali tapalo:l a komo tikmolo:ntih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts421" TIME_SLOT_REF2="ts423">
                <ANNOTATION_VALUE>pos yeh ti:le:wi n' a:tsí:n, pero we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>Weli, nikwa: chi:lposo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Weli, weli ke:meh t'nekis tikwa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>Chikinte yeh ne:, yeh komo timoahxilih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>pos xikchipa:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>wa:n komo tikpia n' etsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>xik..., tiketsa ma:s ika se: *bolita**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>wa:n komo tikpia n' a:ko:lin, 'pankwe:choli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>'Pankwe:choli n' a:ko:lin, x'pankwe:choli wa:n ne:n xikpante:kilia ne:n a:emo:ltsí:n komo oksik a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>wa:n ke:mah xmotamaka, 'motamaka ya komohkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>I:ksá: tikpiah totaxkal sese:ktsi:n, pos titakwah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Ata tehtenextik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts457" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>Ta: nika:n onkak i:n yekin tikwa:lpanawihkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>tehtenextik ata, tsikitsitsi:n, ihko:ko:ntsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>Wa:n ka:mpa mochi:wa miak no: mopa:pata:wa tepitsi:n ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>Tehtenextik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>wa:n wahwa:kkatik. Yo:n komo tikahsik wa:kik, 'teki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>'Teki wa:n tepitsi:n x'a:palo para kwali t'chipa:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>Ke:mah, kwali t'chipa:wa wa:n tikmana ya. Komo tik..., t'neki tikwe:cho:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>*mejor** tikwe:chowa. Tikneki ta:ká:n tikneki tikwa:s ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>ika taxkaltsí:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>o:me taxkal tiktaxkalowa wa:n tiki:xte:kilia ya n' chi:ltamo:ltal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>wa:n ompa t'te:ma ya nanakatsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>wa:n ke:mah sepa t'te:..., tikta:lilia ya sepa nika:n chi:ltamo:ltaltsí:n wa:n ihkó:n t'chi:wa ya n' tixtsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts482">
                <ANNOTATION_VALUE>wa:n t'ta:lia ya n' koma:lko ka:mpa takawa:ntok, kwaltsi:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>kwaltsi:n ne: mo..., mokepa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>Ke:mah. Wa:n ke:mah ne:, ox..., ohpa, e:xpa xkehke:kepa, xkehke:kepa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>mah a:mo tata. *Ave maría** ika ahwia:k nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>Komo t'neki tikwa:s emo:l, pos tikwa emo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>T'neki tikwe:cho:s pos xkwe:cho.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Yo:n nochi kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>N' a:mo, yeh ke:mah *porque** yeh komo titamo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>tkow..., tikowte:xi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>semi ke:wa ne:n kwoma:it,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>wa:n semi ke:wa ne:n chakay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Wa:n komo a:mo kakate.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>Kakatekowit semi ke:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>E:yi kowit semi ke:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts513" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>Wa:n komo tikahsik pos xik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>ximotekili, a:mo moneki mota:lpan, ma:s te:ta:lpan pero komo tikahsik nanakatsí:n pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>i:pa para se: kimahse:was. *So...., solamente** komo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>ne:wí:n, ta:ká:n tato:kalah, ta:ká:n chi:lah pos a:mo wel se: kalaki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>*Porque** chi:lah *o** etah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts525">
                <ANNOTATION_VALUE>kihto:skeh et nikteki, a:mo kihto:skeh komo nanakatsí:n nimotekilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>Ne:, onkak yo:n *bola** ata telsehseltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>pané:, pané: tokotsyetok pané: telamas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>ika se:, ahsis se: tapalo:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>wa:n yo:n seki ata *medio** ihko:ko:ntsitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts538">
                <ANNOTATION_VALUE>panchihchi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>Yo:n ata semi pahti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>katka, a:man pos komo tepitsi:n *timorayaroh**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>wa:n tieski:sa pos tiowih tikitatih ne: koyo:tapahtihkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>wa:n ihwa:k a:mo. Tikoto:na se: *pedazo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>wa:n tikwi i:n a:matsí:n, ika t'tetekwinowa, ika tikilpia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>Tikte:nkalakilia *mocor...**, motatek ka:mpa timokokowa, yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>Wa:kkatik wa:n yo:n *polvito** ompa moka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>Yo:n *polvito** yehwa ya mitspahti:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>Yo:n semi pahti, para ne:, komo timokokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Nochi we:lik, nochi n' e:yi, n' o:me taman, e:yi taman nochi we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>*Porque** yo:n seki ata mahyá: motokotsta:lia wa:n komo se: kiteki wa:n se: kichipa:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>mahyá:, mahyá: xolkopi:ni sah n' itsi:ntayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Yo:n tein *medio** ih..., tel ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>Ti..., komo tikahsik kahfe:ntampa, kahfe:ntah mochi:wa ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>Wa:n we:lik. *Lo que es** yehwa yo:n nanakat wa:n tein yo:n onkak ixta:wat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>no: *igual**. Komo timo..., [ti]kahsik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>tiahsi wa:n x'chipa:wa wa:n x'pantamo:tili n' epaso:t wa:n mah eto n' taxkal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Soh pos xpa:kto, a:mo xmoihtikoko ke:meh ekintsi:n neh nimoihtikokowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>Pos komo se: kineki, komo se: kineki pos wa:n komo a:mo pos tikwa ya iwa:n ne:n chi:lposo:ntsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>*O mismo** chi:ltamo:ltaltsí:n t'pante:kilia mah koko:ya ne: itech n' ko:ntsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>Wa:n t'panta:lilia *a ver** ton xiwyotsi:n tikneki iahwia:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>Pos tikwi n' epaso:t wa:n yehwa ya ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>*siempre lo más pimienta, siempre lo más pimienta** n' tehwa:n tikma...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>ti..., tikwah kalihtik wa:n epaso:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>Neh semi nikwelita iwa:n epaso:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>Chi:ltaxkal, onkak ata yo:n wehwei,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>kie:wa ne: awa:kwowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>wa:n onkak yo:n achi *regular**, kie:wa pa:wakwowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts611" TIME_SLOT_REF2="ts612">
                <ANNOTATION_VALUE>Wa:n onkak yo:n tein ne:wí:n ah..., parahko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>onkak ihko:ko:ntsitsi:n, mahmalakachtsitsí:n ihko:kó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Pero ompa motsi:nke:tsa wa:n ompa momalakachowa wa:n *chi:chilito** ke:meh chi:le:wat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>Yehwa ya n' tikteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>kwaltsi:n tikchipa:wa *parejo** wa:n ke:mah tika:tsetselowa ihsiwka mah ki:sa n' ta:l wa:n tiktikoketsa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Ke:mah ne:, t'nekis tikwa:s chi:loh pos tikwa chi:loh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>T'neki tikwa:s iwki pos tikwa:s iwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts626">
                <ANNOTATION_VALUE>Soh xpa:kto ika mopoxtsi:n wa:n x..., mah xte:we:lia sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts629">
                <ANNOTATION_VALUE>Tikwe:lili:s, ttakwa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>A:wa:tampa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>a:wa:tampa n' onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>Ka:mpa pala:ntok n' a:wa:xiwit *o** yo:n oko..., okoma:it,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>no: motelchi:wa, itech okoma:it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts641" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>*o** yehwa ya n' a:wa:t. Nikmattok *porque** ke:meh ompa ne: ninemia se: *t...**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>se: to:nal, o:me to:nal pos nikmattok ke:ní:w n' ompaka motachi:wa ika nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts645" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>Wa:n ompa onkak kiliah okonanakat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>okonanakat ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>kwaltsi:n no: ke:meh xo:no:kowit inanakayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>sayoh *que** yeh mehmetseh, ihko:kó:n mehmetseh wa:n no: we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>No: se: kichihchi:wa chi:ltamo:ltaltsí:n *o bien** tikwe:cholia ne:n *chilito**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts655" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>wa:n t'chihchi:wa no: chi:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>chi:lposo:n, ke:mah wa:n titakwa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>Ompa ne: ah..., ompa ne: San Juan [Tahitic]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>San Juan nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts669" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>San Juan Tahitic. Ke:meh ompa ne: neh nite:..., nite:siwa:mon pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>*Por eso** n'mattok, n'mattok kati:yeh nanakatsí:n ompa onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>*Bueno** ke:meh ya, ke:meh se: kinekis, ke:meh se: kinekis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>Tikele:wi:s ne: ika *chilito** pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>koko:li wa:n para tikwa:s, *siempre lo más**, komo tipa:ktok pos *siempre lo más** achi nochi koko:ktsí:n se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>pos se: motamaka ika *porque** pos tikwe:lilih, tikwe:lili:s ika ne:n *chilito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>*Siempre, siempre lo más**, yehwa ne:n xiwtsí:n, yehwa ne:n epaso:t tikta:lilia *o bien** komo tikchi:lwih ika ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>chi:lwa:ktsí:n pos tikta:lilia *mimientita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>Yo:n ne: ti:ltik, yo:n ke:mah ti:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>Ti:ltik mochi:wa itech teswakapolin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>Ka:mpa yo:n pala:ni n'teswakapolin, pos mota:lia se: kowte:ntsi:n ihkó:n ompa ihkwí:n itsi:ntan mota:lia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>Mochihchi:wa se: *hasta** ihkó:n, we:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>We:i mochi:wa wa:n ke:mah x...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>komo tikmattok *que** sepa niman tikitati:w, entó:s tikechteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>Tikechteki ihkó:n, tiktekilia ne:n ke:meh i:n ka:mpa e:wtok n' itsi:n..., ka:mpa e:wtok n' ipata:wka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>wa:n ke:mah ne: tikwi:ka ya ne:n nanakatsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>itech na:wi to:nal sepa tikitati, sepa kipia se: kwali *pedacito** nono.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>Kipia kwali *pedacito** wa:n selontsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>Ye:k ahwi:yak, ye:k ahwia:k, ahwia:k yo:n nanakatsí:n, yo:n ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts716">
                <ANNOTATION_VALUE>komo chika:wak a, kohkoto:na n' ite:mpayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts718">
                <ANNOTATION_VALUE>ke:meh ka:mpa ton *tanto** yema:nik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>wa:n tiki:xtilia ya yo:n takwa:wak, ke:mah tikokototsa ya yo:n tein takwa:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>wa:n tikwe:chowa ya, tikwe:chowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>wa:n komo tikwe:choh, entó:s yo:n tein yema:nik tiktikoketsa ya n' tein kikwe:chowah wa:n x'tikoke..., ompa mah yowi a n' tein takwe:chol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts726">
                <ANNOTATION_VALUE>Wa:n ye:k neli we:lik mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>Ne: ke:man n'mattok motelchi:waya nika:wí:n, ekintsi:n a:mo n'mati ox mochi:wa *porque** ke:meh a:mo no: sake:ra niwi:tsa nika:wí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts733" TIME_SLOT_REF2="ts734">
                <ANNOTATION_VALUE>Ke:mah, chi:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts735" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>chi:l sah, a:mo se: kita:lilia ne: tomat yeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>Mah a:mo se: kita:lili, m' pi:sinnanakat mah a:mo se: kita:lili tomat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts741">
                <ANNOTATION_VALUE>Chi:l sah. Komo a:mo xko:ya sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts745" TIME_SLOT_REF2="ts747">
                <ANNOTATION_VALUE>Chi:lwa:ktsí:n *o** se: chi:lxoxowik 'tehtekili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts753" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>Pos *ay dios**, yo:n ke:mah *para que** tikitas yo:n we:lik tein tiknekis iwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>Tiknekis iwa:n kwa:koweh, iwa:n kwa:koweh. T'nekis iwa:n *pollo**, iwa:n *pollo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts757" TIME_SLOT_REF2="ts759">
                <ANNOTATION_VALUE>T'nekis chi:lposo:n ika pitsonakat iwa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts764">
                <ANNOTATION_VALUE>pitsonakat. Yo:n ke:mah, miak kipia n' iahwia:kka, soh *que** mah onka n' tomi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts768" TIME_SLOT_REF2="ts769">
                <ANNOTATION_VALUE>Ata mahyá: xilwa, neli mahyá: xilwa, ta: mo..., i:n domingo nikitaka te:ntoya pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts770" TIME_SLOT_REF2="ts771">
                <ANNOTATION_VALUE>pos tsikintsi:n, ihkwi:ntsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts772" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>mahtak *peso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts778" TIME_SLOT_REF2="ts779">
                <ANNOTATION_VALUE>A:mo nika:n. *Igual** n' kosawik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>nochi ne: ahko, *igual** n' chi:ltaxkal, nochi ne: ahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts786" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>Xilwananakat mochi:wa ne: ka:mpa pala:ni ne:n a:wa:t, *este** ne:n okot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>Ka:mpa pala:ni n' okot ompa moyewalo:ltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>Wa:n iwki, iwki momoya:wtiw, momoya:wtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a471" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts793">
                <ANNOTATION_VALUE>Mahyá: ta:li:xko mochi:wa pero momoya:wtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts794" TIME_SLOT_REF2="ts795">
                <ANNOTATION_VALUE>Nikmattok, ta: pos mochi:wa ne: ka:mpa nte:siwa:mon.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>Ke:mah, *por eso** n'mattok ke:ní:w ne:n..., wa:n niwa:le:w itech se: agosto, i:pa onkak a xilwananakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>Ata *medio**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts805">
                <ANNOTATION_VALUE>*medio** a:chi:pechi:chi:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts806" TIME_SLOT_REF2="ts807">
                <ANNOTATION_VALUE>aha:chi:petik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts809">
                <ANNOTATION_VALUE>wa:n telahwia:k, ahwia:k, ahwia:k, [ke:]meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts810" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>iwki a nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts817">
                <ANNOTATION_VALUE>Yeh kohkostik neli mo..., wa:n yeh no: mahyá: se: *sombrilla** ihkó:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts818" TIME_SLOT_REF2="ts819">
                <ANNOTATION_VALUE>ihkó:n wa:n te:mpan..., te:mpankostik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts821">
                <ANNOTATION_VALUE>wa:n ka:mpa *mero ilomo** mahyá: ne: *sombrilla i..., ipunta** ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts822" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>we:i *mancha** ihkó:n pero chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts824" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>Kitelkowa ata koyo:meh, ma:ski,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>pati:yoh pero kikowah, kitelwelitah yehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts833">
                <ANNOTATION_VALUE>Ompa no: ne: kowtampa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts834" TIME_SLOT_REF2="ts835">
                <ANNOTATION_VALUE>kowtampa no: mochi:wa. Yo:n ke:mah ta:li:xko mochi:wa pero ka:mpa tapala:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>Mah pala:ni xiwit, mah pala:ni ne:n okoma:it *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts838" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>*o** yo:n a:wa:ma:it mah pala:ni, ata ka:sá: ika pala:ni ka:mpa a:mo akah ne:nemi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>wehkapan ihkó:n, ompa kwaltsi:n mocha:molowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>Ne: pos yeh ne: yo:n komo se: kineki se: kikwa:s iwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts848" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>iwa:n ne:n, se: kitsoyo:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts851">
                <ANNOTATION_VALUE>Yo:n kwaltia se: kitsoyo:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>Mahyá: mochi:wa mahyá: pio:tetsí:n iwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>Tak weliskia komo..., neh n'mattok sah *que** yehwa sah neh nika..., n' ompa ne: yehwa:n kikwa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts861">
                <ANNOTATION_VALUE>Kitsoyo:niah n' chi:l wa:n ompa kipante:mah ya nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts863">
                <ANNOTATION_VALUE>Iwki, iwki yehwa:n ne:chpano:ltihkeh n' ta:tahmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts864" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>ka:mpa *dios** kimpia. A:mo ke:man nikihto:s ne:chtatasohtilihkeh *o** tehsá: tapalo:l, mah kihto:ka:n a:mo we:lik, a:mo xkwa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts866" TIME_SLOT_REF2="ts867">
                <ANNOTATION_VALUE>*o** a:mo xtakwa *o** a:mo xtai kahfe:n. A:mo, kwaltsi:n ne:chpano:ltihkeh m' *pobres** om..., no...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts868" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>notakpamona:ntsi:n, ka:mpa *dios** kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts874" TIME_SLOT_REF2="ts875">
                <ANNOTATION_VALUE>Ompa nikakik n' kosawik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>Wa:n n'neltoka pos neli kosawik *porque** pos neli kostik, kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts878" TIME_SLOT_REF2="ts879">
                <ANNOTATION_VALUE>Ihkó:n *sombrillahtik** mochi:wa wa:n wehkapan ihkwí:n moketsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts880" TIME_SLOT_REF2="ts881">
                <ANNOTATION_VALUE>Wehkapan moketsa wa:n kwaltsi:n ite:mpan kostik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts882" TIME_SLOT_REF2="ts883">
                <ANNOTATION_VALUE>wa:n ka:mpa *ipunta** ya, i:n ikwa:pan, wehka n' kos..., chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts884" TIME_SLOT_REF2="ts885">
                <ANNOTATION_VALUE>Chi:chi:ltik pero chi:chi:ltik nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts886" TIME_SLOT_REF2="ts887">
                <ANNOTATION_VALUE>Se: ihko:ntsi:n kita:liah pané: *veinte pesos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts888" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>Wa:n xtahtani sah, a:mo tikihto:s nimitskahkaya:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts894" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>Yeh ata mochi:wa diciembre,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts896" TIME_SLOT_REF2="ts897">
                <ANNOTATION_VALUE>itech ne: sempowal wa:n ma:kwi:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts898" TIME_SLOT_REF2="ts899">
                <ANNOTATION_VALUE>Sempowal wa:n ma:kwi:l diciembre,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts900" TIME_SLOT_REF2="ts901">
                <ANNOTATION_VALUE>wa:n komo a:mo *candelaria**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts902" TIME_SLOT_REF2="ts903">
                <ANNOTATION_VALUE>*Candelariahtika** talwiti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts904" TIME_SLOT_REF2="ts905">
                <ANNOTATION_VALUE>ihwa:k mochi:wa semi. Pero mi:xkwi, ata mi:xkwi ta:li:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts906" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>Ta:li:xko moi:xkwi kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts910" TIME_SLOT_REF2="ts913">
                <ANNOTATION_VALUE>*de agua**, yeh kwali se: kikwa tamaltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts914" TIME_SLOT_REF2="ts915">
                <ANNOTATION_VALUE>Tikma:nelowa iwa:n tixtsí:n, tikwiti:w iswatsí:n, t'pihpi:ki ke:meh tamaltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts918">
                <ANNOTATION_VALUE>ke:meh yo:n nakatamaltsí:n t'pihpi:ki ika n' tixti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts922" TIME_SLOT_REF2="ts923">
                <ANNOTATION_VALUE>We:lik, chi:lposo:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts924" TIME_SLOT_REF2="ts925">
                <ANNOTATION_VALUE>Ke:mah, ta neh nochi, no:, neli n' ke:meh nimitsilwihtok, *que** neh nochi niki:xmati ke:ní:w n' takwalis de yehwa yo:n nanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts926" TIME_SLOT_REF2="ts927">
                <ANNOTATION_VALUE>Ekintsi:n niki:xmati, ¿ke:yeh?, *porque** pos neli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts928" TIME_SLOT_REF2="ts929">
                <ANNOTATION_VALUE>iwa:n nnemia *nohermana** nika:n San Miguel, *nohermana**, a:mo no:má:n pero iwa:n ninemia ampó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts930" TIME_SLOT_REF2="ts931">
                <ANNOTATION_VALUE>Wa:n yehwa n' iwa:n ni:xpano:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts932" TIME_SLOT_REF2="ts933">
                <ANNOTATION_VALUE>Wa:n ika nia:yane:chte:molti:ti, mah nikwiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts934" TIME_SLOT_REF2="ts935">
                <ANNOTATION_VALUE>Mah nikwiti ne: a:n..., mah n'te:mo:ti nanakat *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts936" TIME_SLOT_REF2="ts937">
                <ANNOTATION_VALUE>pero yo:n nik..., yo:n n'chihchi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts938" TIME_SLOT_REF2="ts939">
                <ANNOTATION_VALUE>oso *mejor** kinamaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts940" TIME_SLOT_REF2="ts941">
                <ANNOTATION_VALUE>I:ksá: nikahsia se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts942" TIME_SLOT_REF2="ts943">
                <ANNOTATION_VALUE>se: chikiwit ihko:ntsi:n, tahko tantok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts944" TIME_SLOT_REF2="ts946">
                <ANNOTATION_VALUE>Ke:mah, yowi a kinamakati nokni:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts956" TIME_SLOT_REF2="ts957">
                <ANNOTATION_VALUE>Ko..., itech kowit, yehwa n' okot itech mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts958" TIME_SLOT_REF2="ts959">
                <ANNOTATION_VALUE>Ka:mpa yo:n pala:ni ne:n okot, yehwa n' itech mochi:wa, no: moyewalo:ltia, ka:mpa yo:n ie:wayo kipia ne:n okot,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts960" TIME_SLOT_REF2="ts961">
                <ANNOTATION_VALUE>ka:mpa ita:kka no: mota:lia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts962" TIME_SLOT_REF2="ts963">
                <ANNOTATION_VALUE>*o** itampa mota:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts964" TIME_SLOT_REF2="ts965">
                <ANNOTATION_VALUE>Moyewalo:ltia, moyewalo:ltia wa:n ke:mah no: panki:sa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts966" TIME_SLOT_REF2="ts967">
                <ANNOTATION_VALUE>N'mattok *porque** i:ksá: kihto:s ne:n, yehwa notakpamona:ntsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts968" TIME_SLOT_REF2="ts969">
                <ANNOTATION_VALUE>neh n'te:mo:ti nanakat. A:, pos neh no: niow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts970" TIME_SLOT_REF2="ts971">
                <ANNOTATION_VALUE>Pos ne: kanah, xietoni a, xtapa:ka ya. Pero n' ta: tiwi:tseh, nitapa:ktehko *o** mah ntapa:ka wa:n tia:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts972" TIME_SLOT_REF2="ts973">
                <ANNOTATION_VALUE>A:mo semi tiowih kihto:s komo tiá:s tikitatih, semi tiowih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts974" TIME_SLOT_REF2="ts975">
                <ANNOTATION_VALUE>Tiowih t'te:mo:tih, tikahsih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts976" TIME_SLOT_REF2="ts977">
                <ANNOTATION_VALUE>Tikahsih wa:n tiehkoh pos te:chmanil..., ne:, kimana ya se: *nocuñadita** ka:mpa *dios** kie:wtok ekintsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts978" TIME_SLOT_REF2="ts979">
                <ANNOTATION_VALUE>Wa:n neh n'chi:wa ya ton n'chi:wati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts980" TIME_SLOT_REF2="ts981">
                <ANNOTATION_VALUE>Ta:ká:n ntahtsomas, ta:ká:n ntapa:ka:s, ta:ká:n teihsá, *a ver** ton n'chi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts982" TIME_SLOT_REF2="ts983">
                <ANNOTATION_VALUE>yeh ne:htamanihtok a n' tapalo:l, yehwa nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts984" TIME_SLOT_REF2="ts985">
                <ANNOTATION_VALUE>*Cualquier** nanakatsí:n tikahsis pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts986" TIME_SLOT_REF2="ts988">
                <ANNOTATION_VALUE>yehwa sah yehwa:n kwelitayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts992" TIME_SLOT_REF2="ts993">
                <ANNOTATION_VALUE>Pos yo:n ke:meh tiknekis, neh ompa nikwa:ya a:ko:loh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts994" TIME_SLOT_REF2="ts995">
                <ANNOTATION_VALUE>Yehwa:n a:mo wel kikwa:yah n' a:ko:loh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts996" TIME_SLOT_REF2="ts997">
                <ANNOTATION_VALUE>A:mo wel kikwa:yah yehwa:n *porque** ke:meh a:mo mopoxmattokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts998" TIME_SLOT_REF2="ts1000">
                <ANNOTATION_VALUE>Wa:n a:ko:lin te:poxkokoh de a:mo se: momati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts1002" TIME_SLOT_REF2="ts1005">
                <ANNOTATION_VALUE>Yehwa:n kikwa:yah *caldito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts1006" TIME_SLOT_REF2="ts1007">
                <ANNOTATION_VALUE>ika epaso:t, ika yo:n chi:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts1008" TIME_SLOT_REF2="ts1009">
                <ANNOTATION_VALUE>*chi:lcera**, kipankahka:wiliah o:me *chilcera**, iwa:n oksi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1012">
                <ANNOTATION_VALUE>motamakah ya m' *pobrecitos**. Semi we:lik mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts1016" TIME_SLOT_REF2="ts1017">
                <ANNOTATION_VALUE>Ke:mah, yehwa n' epaso:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts1018" TIME_SLOT_REF2="ts1019">
                <ANNOTATION_VALUE>Epaso:tsí:n *porque** ompaka a:mo onkak *pimienta**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts1020" TIME_SLOT_REF2="ts1021">
                <ANNOTATION_VALUE>ompa iwki, ompa onkak *solamente** n' epaso:t onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts1022" TIME_SLOT_REF2="ts1024">
                <ANNOTATION_VALUE>Komo yo:n tikpia n' epaso:tsí:n pos xikwiti wa:n x'ta:lili, ompa ke:man no: ttakwa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts1028" TIME_SLOT_REF2="ts1030">
                <ANNOTATION_VALUE>Xi:yo:nanakat ke:mah, yo:n i:xtohtohmiyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts1034" TIME_SLOT_REF2="ts1035">
                <ANNOTATION_VALUE>I:x..., *medio, medio** i:xchihchi:chi:ltik n' tein kwali, tein kwali xi:yo:nanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts1036" TIME_SLOT_REF2="ts1037">
                <ANNOTATION_VALUE>Yehwa ya ye:wa name:chilihtok komo se: kahsi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts1038" TIME_SLOT_REF2="ts1039">
                <ANNOTATION_VALUE>*ay dios** ka:mpa onkak, onkaya, ekintsi:n a:mo no: we:i tei, ekintsi:n o:me tikahsis, e:yi tikahsis wa:n yehwa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts1040" TIME_SLOT_REF2="ts1041">
                <ANNOTATION_VALUE>De yo:n ka:mpa nikahsi n'teki wa:n nikoma:lta:lia wa:n nikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts1042" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>Yo:n a:..., a:, ekintsi:n a:mo mochi:wa, a:it ke:yeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1045">
                <ANNOTATION_VALUE>Pero yo:n onkak wa:n no: mochi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts1046" TIME_SLOT_REF2="ts1047">
                <ANNOTATION_VALUE>onkak seki ista:k, yeh kiliah *cimarrón**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts1048" TIME_SLOT_REF2="ts1049">
                <ANNOTATION_VALUE>*Cimarrón porque** ihista:k, i:xtohtohmiyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts1050" TIME_SLOT_REF2="ts1051">
                <ANNOTATION_VALUE>Wa:n i:n seki yeh a:mo, yeh kahkanaktsitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts1052" TIME_SLOT_REF2="ts1053">
                <ANNOTATION_VALUE>wa:n yemaxtsí:n pero ihko:ntsi:n mochi:wa, ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts1054" TIME_SLOT_REF2="ts1055">
                <ANNOTATION_VALUE>Yehwa yo:n telwe:lik komo se: kichichi:wa ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts1056" TIME_SLOT_REF2="ts1058">
                <ANNOTATION_VALUE>ke:meh se: kikwe:chowa wa:n se: kichi:wa ta:ta..., tamaltsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts1062" TIME_SLOT_REF2="ts1063">
                <ANNOTATION_VALUE>Weli. *Lo que es, lo que es, lo que es** nanakat tein tiknekis nochi we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts1064" TIME_SLOT_REF2="ts1065">
                <ANNOTATION_VALUE>Nochi we:lik soh *que** xpa:kto wa:n kwali x'tolo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts1066" TIME_SLOT_REF2="ts1067">
                <ANNOTATION_VALUE>*Para que es** wa:n pos tikpia ne:pa tapalo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts1068" TIME_SLOT_REF2="ts1069">
                <ANNOTATION_VALUE>T'pia nanakachi:lposo:n, t'pias nanaka...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts1070" TIME_SLOT_REF2="ts1071">
                <ANNOTATION_VALUE>*nanakacaldito**, pero komo a:mo wel titakwa, i:pa a:mo tikwa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts1072" TIME_SLOT_REF2="ts1074">
                <ANNOTATION_VALUE>Wa:n i:n a:mo, kwaltsi:n mah se: ki...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts1078" TIME_SLOT_REF2="ts1079">
                <ANNOTATION_VALUE>Chini:nah, chini:nah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts1080" TIME_SLOT_REF2="ts1081">
                <ANNOTATION_VALUE>Ka:mpa onkak, ka:mpa wetsi n' chini:nah *o** komo wetsik, ne: kitamo:tah ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts1082" TIME_SLOT_REF2="ts1083">
                <ANNOTATION_VALUE>kakate ompa mochi:wa *o** chakay,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts1084" TIME_SLOT_REF2="ts1086">
                <ANNOTATION_VALUE>yehwa n' semi kwelita ke:was. Yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts1092" TIME_SLOT_REF2="ts1093">
                <ANNOTATION_VALUE>Pos niwa:le:wak nika:n Xaltipan wa:n nimono:tsa María Ocotlán.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts1094" TIME_SLOT_REF2="ts1095">
                <ANNOTATION_VALUE>Pos ka:n teihsá:, tasohka:matik ke:mah, komo nankolo..., nankololohkeh i:n no...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts1096" TIME_SLOT_REF2="ts1097">
                <ANNOTATION_VALUE>notahto:ltsi:n wa:n yehwa sah name:chkaya:..., name:chilwihtok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a606" TIME_SLOT_REF1="ts1098" TIME_SLOT_REF2="ts1099">
                <ANNOTATION_VALUE>pero yo:n tein name:chilihtok a:mo name:chkaya:wtok, *lo que es** ka:mpa neh nipano:k, ka:mpa neh nimotekipanoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts1100" TIME_SLOT_REF2="ts1101">
                <ANNOTATION_VALUE>ekintsi:n a:mo semi nikihto:s wehika nimotekipano:ti ok, xa: niman niwa:lpanki:sas *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
