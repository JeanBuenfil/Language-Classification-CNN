        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1435" TIME_SLOT_REF1="ts2271" TIME_SLOT_REF2="ts2273">
                <ANNOTATION_VALUE>Ne: komo ke mahyá:, a:mo tik..., nikihtowa neh, a:mo topo:nik mometstsitsi:n *si no que**.... A:mo, a:mo teh t'machilih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1437" TIME_SLOT_REF1="ts2275" TIME_SLOT_REF2="ts2278">
                <ANNOTATION_VALUE>nió:n teyi, nió:n teyi, nikpahti ika xiwit wa:n ke:mah pe:wak pahti, *entre más** nikita ke pahti a wa:n kwali *más** nitaksa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1439" TIME_SLOT_REF1="ts2280" TIME_SLOT_REF2="ts2283">
                <ANNOTATION_VALUE>Wa:n tikmati ne:n de ke a:mo no: se: mose:wia pos no: ihkó:n ya momati ne:n se: i..., se: imetstsitsi:n komo ke, se: imets kahkawa:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1441" TIME_SLOT_REF1="ts2285" TIME_SLOT_REF2="ts2286">
                <ANNOTATION_VALUE>Entó:s iwki a, iwki a se:, iwki a se: momati ne:n ka:mpa se: te..., ka:mpa se: moteki, komoke a:mo se: ki..., ka:n no: se: ki..., nikihtowa neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1442" TIME_SLOT_REF1="ts2287" TIME_SLOT_REF2="ts2288">
                <ANNOTATION_VALUE>A:mo se: sehse:wi *si no que** kawa:ntok se: imetstsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1443" TIME_SLOT_REF1="ts2289" TIME_SLOT_REF2="ts2290">
                <ANNOTATION_VALUE>Ke:mah. *Por eso** se: momati a de se: tekiti pos komoke a:mo, a:mo tikneta:li..., a:mo timose:wi:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1444" TIME_SLOT_REF1="ts2291" TIME_SLOT_REF2="ts2293">
                <ANNOTATION_VALUE>Wa:n komohkó:n timoteik wa:n a:mo kanah tiow, komoke se: momati no:, se:..., se:..., metssehsese:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1445" TIME_SLOT_REF1="ts2294" TIME_SLOT_REF2="ts2297">
                <ANNOTATION_VALUE>Ke:mah, ehe, *merito**. A:mo *porque** pos, pos tak iwki a se: kim..., se: mo..., ihkó:n se: moe:waltia, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1447" TIME_SLOT_REF1="ts2299" TIME_SLOT_REF2="ts2300">
                <ANNOTATION_VALUE>Pero komo neli ne: ke:meh yo:n se: moteki wa:n a:mo se: k...., mopia, komoke, no: iwki a se:momati, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1448" TIME_SLOT_REF1="ts2301" TIME_SLOT_REF2="ts2303">
                <ANNOTATION_VALUE>Se: ki..., se: iwki se: tekiti, iwki se: tekiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1449" TIME_SLOT_REF1="ts2304" TIME_SLOT_REF2="ts2306">
                <ANNOTATION_VALUE>*Hasta** iwki tikelka:was [ko]mo se:..., e:soleh, *hasta** se:..., ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1451" TIME_SLOT_REF1="ts2308" TIME_SLOT_REF2="ts2311">
                <ANNOTATION_VALUE>Mm, ka:n no: n'chi:wa kwe:ntah, sayoh nikpi:kia, ke:mah, niki:xpi:ki ihkó:n para a:m..., para a:mo i:xta:lkalakia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1453" TIME_SLOT_REF1="ts2313" TIME_SLOT_REF2="ts2316">
                <ANNOTATION_VALUE>E:soleh, ke:mah, ke:mah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1455" TIME_SLOT_REF1="ts2318" TIME_SLOT_REF2="ts2321">
