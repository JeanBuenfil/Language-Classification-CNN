        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1432" TIME_SLOT_REF1="ts2263" TIME_SLOT_REF2="ts2266">
                <ANNOTATION_VALUE>A:mo ke:man timoka:wak.</ANNOTATION_VALUE>
