            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a829" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>Taya:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a831" TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>*Porque** tikmati tak mahyá, neh nikilia neh pahti *porque** nochi *cuestión** tein tikwah, seko sah ne: ahsi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a832" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts785">
                <ANNOTATION_VALUE>entó:s ne:n se: kihto:s de se:, se: inekalawi:l</ANNOTATION_VALUE>
