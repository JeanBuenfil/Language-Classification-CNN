            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a821" TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts759">
                <ANNOTATION_VALUE>ne: komo mitstipi:nih yo:n okwilin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a822" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>cha: tikmati ata ne: tein ika se: mopahtia:ya, a:mo tikmati.</ANNOTATION_VALUE>
