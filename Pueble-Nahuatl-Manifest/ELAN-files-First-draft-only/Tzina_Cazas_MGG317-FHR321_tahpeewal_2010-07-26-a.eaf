                <ANNOTATION_VALUE>Iwki se: kihyowia. E:soleh wa:n titekitia iwki, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1459" TIME_SLOT_REF1="ts2327" TIME_SLOT_REF2="ts2330">
                <ANNOTATION_VALUE>E:soh, ehe, *andale**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1462" TIME_SLOT_REF1="ts2335" TIME_SLOT_REF2="ts2338">
                <ANNOTATION_VALUE>Yehwa ne:n wi:tsiki, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1464" TIME_SLOT_REF1="ts2340" TIME_SLOT_REF2="ts2341">
                <ANNOTATION_VALUE>A:mo nochi se: kimati wa:n ma:ski neli tikihtowah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1465" TIME_SLOT_REF1="ts2342" TIME_SLOT_REF2="ts2343">
                <ANNOTATION_VALUE>de a:mo tiki:xmatih ika timopahtihkeh pos neli a:mo, a:mo se: ki:xmati, pero yehwa yo:n witsikite:mpi:l pos neli i:pa tik..., yehwa ika timopahtiah nan..., achto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1466" TIME_SLOT_REF1="ts2344" TIME_SLOT_REF2="ts2346">
                <ANNOTATION_VALUE>Yo:n tepisti:n se: moteki ata yehwa ya se: kichachalachilia wa:n pahti, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1467" TIME_SLOT_REF1="ts2347" TIME_SLOT_REF2="ts2350">
                <ANNOTATION_VALUE>No:, no:, no: neli k..., ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1469" TIME_SLOT_REF1="ts2352" TIME_SLOT_REF2="ts2353">
                <ANNOTATION_VALUE>Wa:n yo:n seki mo:so:t ata onkak, komo ke no:, no: kikwa:yah ata tokni:wa:ntsitsi:n, xa: tikmati teh. Kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1470" TIME_SLOT_REF1="ts2354" TIME_SLOT_REF2="ts2355">
                <ANNOTATION_VALUE>Se:..., ompa ne: tehwa:n, se: ta:tosti:n, te:chpale:wia:ya wa:n tia:yah ne: tomi:lah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1471" TIME_SLOT_REF1="ts2356" TIME_SLOT_REF2="ts2357">
                <ANNOTATION_VALUE>Ta: tikitah tehwa:n 'kwihkwiti a yo:n, yo:n pané: tikiliah ista:kmo:so:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1472" TIME_SLOT_REF1="ts2358" TIME_SLOT_REF2="ts2359">
                <ANNOTATION_VALUE>Wa:n pe:wa, pe:wa, pe:wa kikwi ika takwa, nikilia "*a poco** ka:n chichi:k" kihtowa "Kanah, pero ta: i:n" kihtowa "pahti",</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1473" TIME_SLOT_REF1="ts2360" TIME_SLOT_REF2="ts2361">
                <ANNOTATION_VALUE>nikilia "pero de toni" "ke:mah" kihtowa "pahti, ta: i:n i:pa tikwah" kihtowa. Wa:n acha ne: kikwik se: *rollo** [wa:n]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1474" TIME_SLOT_REF1="ts2362" TIME_SLOT_REF2="ts2363">
                <ANNOTATION_VALUE>kikwa wa:n kiteki, kikoto:na itaxkaltsi:n ika seki ihkó:n motehte:we:liltia. Nikilia "wa:n i:pa tikwa" "i:pa nikwa:ni" kihtowa. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1475" TIME_SLOT_REF1="ts2364" TIME_SLOT_REF2="ts2366">
                <ANNOTATION_VALUE>Yehwa yo:n ista:kmo:so:t pero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1476" TIME_SLOT_REF1="ts2367" TIME_SLOT_REF2="ts2370">
                <ANNOTATION_VALUE>E:soleh, mi:lahmo:so:t, aha.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1478" TIME_SLOT_REF1="ts2372" TIME_SLOT_REF2="ts2375">
                <ANNOTATION_VALUE>Pero tak neli, chi:..., se: chi:chiko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1480" TIME_SLOT_REF1="ts2377" TIME_SLOT_REF2="ts2380">
                <ANNOTATION_VALUE>Pos iwki nikitaya neh kikwa:ya, a:mo se: kikwa, ke:meh yo:n ekintsi:n onkak ne:n pa:pa:lo:kiltsi:n, de mela:w onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1482" TIME_SLOT_REF1="ts2382" TIME_SLOT_REF2="ts2383">
                <ANNOTATION_VALUE>Pero pos neli tein a:mo te:na:miki komo ke pané: mahyá:, nikilia neh mahyá: se: toskatata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1483" TIME_SLOT_REF1="ts2384" TIME_SLOT_REF2="ts2386">
                <ANNOTATION_VALUE>Se: toskaxokoya. Te:toskaxokoltih, pero tak i:n se: kokolisyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1484" TIME_SLOT_REF1="ts2387" TIME_SLOT_REF2="ts2389">
                <ANNOTATION_VALUE>Mm. Mela:w n' onkak ompa ne:wí:n tehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1486" TIME_SLOT_REF1="ts2391" TIME_SLOT_REF2="ts2393">
                <ANNOTATION_VALUE>Onkak, onkak. Mi:lah, mi:lah, ke:meh i:n ka:mpa xa:lah, mela:w onkak ne:n pa:pa:lo:kiltsi:ni, pa:pa:lo:kil....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1488" TIME_SLOT_REF1="ts2395" TIME_SLOT_REF2="ts2398">
                <ANNOTATION_VALUE>Pa:pa:lo:kiltet a, ta: ekintsi:n chika:wayak a, chika:wayak a, onkak miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1491" TIME_SLOT_REF1="ts2403" TIME_SLOT_REF2="ts2404">
                <ANNOTATION_VALUE>Ki..., kitekih *o** ke:meh i:n kahokwih ya para *semilla**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1492" TIME_SLOT_REF1="ts2405" TIME_SLOT_REF2="ts2406">
                <ANNOTATION_VALUE>kipi:kih ika se:, se: ihkó:n, ika se: tasa:ltsi:n *o** se: *bolsa de naylon**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1493" TIME_SLOT_REF1="ts2407" TIME_SLOT_REF2="ts2408">
                <ANNOTATION_VALUE>Ompa kipanta:liah wa:n tepitsi:n ki:xwa:tsah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1494" TIME_SLOT_REF1="ts2409" TIME_SLOT_REF2="ts2410">
                <ANNOTATION_VALUE>ke:mah, ki..., kinemiliah kitepe:wati:w, 'kwite:wah ya, yowih kitepe:watih para ompa ixwa. Kita..., sayoh kitai:xohololowiliah, ompa kimoya:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1495" TIME_SLOT_REF1="ts2411" TIME_SLOT_REF2="ts2412">
                <ANNOTATION_VALUE>Ke:meh tikita ne: sempowalxo:chit se: kimoya:wa, iwki no: ne:n pa:pa:lo:kilitsi:n kichi:wah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1496" TIME_SLOT_REF1="ts2413" TIME_SLOT_REF2="ts2414">
                <ANNOTATION_VALUE>*Después** de ixwa ya pos se: monamakilia tepitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
