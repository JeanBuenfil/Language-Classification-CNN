        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a911" TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts976">
                <ANNOTATION_VALUE>Ka:n mati, neh a:mo niahka namowa:n, mm. Pero ompa yo:n te:chwi:kayah, tia:yah ihkó:n komo *cerca, cerca**, a:mo wehkatsi:n, se: yowih, nika:n *cer...,**, tiowih, a: pos tiowih.</ANNOTATION_VALUE>
