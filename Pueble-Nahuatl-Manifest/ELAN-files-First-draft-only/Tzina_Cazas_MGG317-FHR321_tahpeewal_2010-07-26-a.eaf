        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a912" TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts979">
                <ANNOTATION_VALUE>Mm, Ti:ltika:t, Xaltipan, ne:, ne: nehje:n ka:mpa n', ka:mpa yo:n, *mero** ne:, *mero** ne: Xaltipan tanitsi:n, tein mona:miki iwa:n ne:n tixa:tawa:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a914" TIME_SLOT_REF1="ts981" TIME_SLOT_REF2="ts983">
                <ANNOTATION_VALUE>A:tmona:miki, ompa yo:n se: wa:n oksé:, oksé: A:tmona:miki oksé: tein, tein ne: tein wi:tsi tikiiah Xo:ki:staha:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a916" TIME_SLOT_REF1="ts985" TIME_SLOT_REF2="ts988">
                <ANNOTATION_VALUE>*Hasta** Reyes tanitsi:n, ka:mpa yo:n se: *puente** kita:lihkeh, we:i</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a918" TIME_SLOT_REF1="ts990" TIME_SLOT_REF2="ts993">
                <ANNOTATION_VALUE>A:a, ompa *mero, hasta** ompa tia:yah tehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a920" TIME_SLOT_REF1="ts995" TIME_SLOT_REF2="ts997">
                <ANNOTATION_VALUE>Yowak, yowak tiwa:ltehkoh, *a ver hasta** titane:sih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a922" TIME_SLOT_REF1="ts999" TIME_SLOT_REF2="ts1002">
                <ANNOTATION_VALUE>Pero neh nimomatia *porque cuando** neh ni..., niweli, pe:wak niweli nikinkwia yo:n, *primero** nikinkwia yo:n tsikitsitsi:n, ihko:ntsitsi:n, yo:n ista:kxilimeh. Ista:kxilitsi:n, ihko:ntsitsi:n nikinahsia, yehwa *más** nikinkwia.</ANNOTATION_VALUE>
