            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a925" TIME_SLOT_REF1="ts1007" TIME_SLOT_REF2="ts1010">
                <ANNOTATION_VALUE>Mm, pero *después** seki:n ne:chiliah tein iwa:n niow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a927" TIME_SLOT_REF1="ts1012" TIME_SLOT_REF2="ts1014">
                <ANNOTATION_VALUE>"Wa:n tein wehwei:n" kihtowa "ka:n tikinita" nikilia "ke:mah" "pos xikinkwi"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
