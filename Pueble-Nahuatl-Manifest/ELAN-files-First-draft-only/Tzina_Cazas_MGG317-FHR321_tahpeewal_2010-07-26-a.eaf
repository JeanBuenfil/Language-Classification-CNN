                <ANNOTATION_VALUE>"E:mah, yehwa ika tiwi:tsa" kihtowa "ika xikinkwi tein wehwei:n, yo:n ihko:ko:nkeh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
