                <ANNOTATION_VALUE>Iwki ti..., iwki, iwki titekitia, ti..., mo:stah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1423" TIME_SLOT_REF1="ts2240" TIME_SLOT_REF2="ts2243">
