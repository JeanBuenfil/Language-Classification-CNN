        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1640" TIME_SLOT_REF1="ts2781" TIME_SLOT_REF2="ts2782">
                <ANNOTATION_VALUE>Iwki a ekintsi:n no: nio: ka:n, ka:n ya sikie:ra nimotato:kia, nitato:kati ok no:.</ANNOTATION_VALUE>
