        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770" TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
