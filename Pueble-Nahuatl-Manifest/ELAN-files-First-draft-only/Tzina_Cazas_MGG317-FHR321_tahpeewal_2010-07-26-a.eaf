        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a773" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>Nehwa, *este**, pos neh *solamente** nikmati, mah nimitsilwi ta:ká:n, ne: i:pa ekintsi:n tiwa:lahkeh, i:n *rato** timoka:waskeh, nika:n timonohno:tsatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a774" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>*Este** pos ne:h de ihkó:n, timono..., timonohno:tstoyah ye:wa tikihtoh tikelna:mikkeh yo:n ne: xilitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>Neh yehwa yo:n ne: ika ne:, ika nitekitik se: *tiempo** no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>nehjó:n nia:ya nitama:tawi:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>Tiki:xmatik yo:n ika se: kininki:tskia ma:tat tikiliah teh..., ma:tat, se: kits..., ata se: kiewalowa se: kowtsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a779" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>ompa se: ki..., tikihilpihtiw wa:n ke:mah ata se: yowi a ne: a:taw, se: moahkotetekwinowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a780" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>Wa:n se: mokalakia ya ne: a:ihtik wa:n pe:wa ya se: kihi:xkepa tetsi:n, entó:s se: kwa:lpe:wati a ata ne: xilitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>Ta ne: ampó:n ne: wi:tsa ya, mokalaki:ti itech se: ima:tsitsi:n, yo:li:k se: kiahokwi a, se: ki:tskia ya ista:kxilitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a782" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>se: kipankalakia itech se: *imorraltsi:n**, ke:mah, entó:s ne: iwki yo:n neh ne:n, ne:, ne: *tiempo** ika nimoskaltih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a783" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>Wa:n pos iwki a tepitsi:n tikwa:yah, ihkó:n tein nikita ne:, nikihitaya, nikinihitaya tein yo:n wehweitsitsi:n nikiwa:tsaya wa:n nimoinnamakilia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>Ke:mah, *este** wa:n neli ke:meh yo:n ika se: motekipanowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a785" TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>Yo:n tein tsikitsitsi:n pos tikwah ya tehwa:n, michka:ldoh tikiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a786" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>Cha: no: tikmati ne: ihkó:n telwe:lik ata michka:ldohsti:n *komo** sepa wa:n tepitsi:n epaso:t kita:liliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a788" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>Se:, se tomatsi:n kipanpitsi:niliah ata</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a789" TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>wa:n entó:s ne: te:chiliah ke mah se:, xa: se: kieko:s sah, ox ke:ní:w, ox, ox poye:k, ox we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a790" TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>Pos neli se: tem..., te:wa:lte:kiliah ya ika ne:n kaxtsi:ni ata wa:n se: mote:ntia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a791" TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>Wa:n ya: n' okseki pos yehwa ne:n kitipawa:tsah wa:n ti..., kininemi:lti:tia ne: *nofamilia**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792" TIME_SLOT_REF1="ts692" TIME_SLOT_REF2="ts695">
                <ANNOTATION_VALUE>Ke:mah ika ihkó:n ika se: to:tomo:chtekomatsi:n tehwa:n tikiliah, sintsi:n ie:wayotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>Ihkó:n ahachichi, se: ki..., se: kita:lihtiw, ma:mahtak..., ma:mahtakti xilitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a795" TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>Iwki a tehwa:n tikiliah ne: "ampó:n xite:ilwih kemeh ya tiknamakak, ta: ka:n mitsmakah se: ma:kwi:l *peso por** se: mahtakti xilitsi:n".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>Entó:s ne: iwki nikilia ne:n "mah ma:ski iwki a xika:wa" nikilia "*porque** pos sikie:ra tepitsi:n ika timopale:wi:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797" TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>Yeh ke tepitsi:n komo ki..., ko..., monamakili:s sikie:ra se: sempowal wa:n mahtakti pe:sohtsi:n pos se: mo..., no: se: mowelita ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>ta:ka:n tao:ltsi:n ika timo..., timoma:patili:tih ya ne:n totomi:tsi:n ika yo:n tech..., tein, yehwa ya ke:meskia mahyá: tite:tekitilia:yah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a799" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>Nochi a, se: xilitsi:n pos ika timopale:wiah, ompa yetok a sakie:ra se: almo:n tao:ltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a800" TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>se:, ke:ra, ke:ra i:n tehwa:n tikiliah se:, se: xapohtsi:n ika timokowiliah, tepitsi:n ne:n yo:n tsope:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801" TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>Entó:s para no: titai:skeh ke:ra tsiktsi:n kahfe:ntsi:n, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a802" TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>Neh yehwa yo:n no: nik..., yo:n no: tein ne: tehwa:n ne: wehka:wkayo:..., timo..., timotekipano:koh, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a803" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>No:, e..., ke:mah, se:, e:soh, xilitsitsi:n, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a805" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>To:naya:n *porque** yowak a:mo weli *porque** tikita i:ksá: *este** ompa ne: komo owihka:n a:te:noh ata wa:n entó:s mota:lia ne:n yo:n a:kowa:t tikilia, ¿Tiki:xmati a:kowa:t?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a806" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>*Este** ke:mah, a:..., a:naweyak tikiliah, a:na:weyak, ehe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808" TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>Wa:n entó:s a:mo, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>*Este** yo:n chi:wi komohkó:n se:, ata a:ksá: se: kwa:nti wa:n mah nimitsye:kilwi claro ata yo:n tein, tein tikihtowah tehwa:n se: a:ksá:ts....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts743">
                <ANNOTATION_VALUE>Yehwa ya, de ma:ski a:mo teh tikchi:wa pero komo ko..., ne: *nofamilia** kwa:ntik ne: siwa:tsi:n se: o:me xilitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814" TIME_SLOT_REF1="ts744" TIME_SLOT_REF2="ts745">
                <ANNOTATION_VALUE>wa:n tikita ne:n oksé: siwa:tsi:n a:mo kimati ke:ní:w nemi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a815" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts747">
                <ANNOTATION_VALUE>entó:s ne:n tein kinohno:tsa kilwi:s "Ka:n tikwik i:n xilitsi:n, xikwa se:, xa: tikwa".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a816" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts749">
                <ANNOTATION_VALUE>Entó:s ompa ya ka:mpa se: yeh se: *motrampa:ro:ti** a ne:, *o sea, komo de malas te:wa:ltoca:ro:ti, al, al** sepa tiow ne: mo:stika titama:tawi:ti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a817" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts751">
                <ANNOTATION_VALUE>pero toni yehwa ya ne: okwilin mo..., ompa tetampa ya ompa etok, mose:wihtok wa:n *a ver** pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a818" TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>kipia de se: kima:tawia wa:n 'kapatstamo:ta ne:wí:n a:tawa:kpan para ompa se: kimiktia ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>para a:mo ne: te:tipi:nia, ta:, ta: *komo** te:tipi:nih i:pa a:mo xikihto tiwa:la:s ok, ta: ompa se: wetsi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts757">
