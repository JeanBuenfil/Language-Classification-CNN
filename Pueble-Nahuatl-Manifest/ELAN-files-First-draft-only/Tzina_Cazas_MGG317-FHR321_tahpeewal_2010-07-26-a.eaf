        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a834" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>wa:n yehwa yo:ni ne:n, yehwa yo:n ika ne: timo..., timopahtia:yah *porque** ne:, ne: *tiempo** tehwa:n ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a835" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>a:mo tixmati ne: ka:mpa n', se: ta:totsi:n nemia kilia:yah Eduardo, Eduardo Cárcamo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a836" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts793">
                <ANNOTATION_VALUE>ne:, ne: kwi..., ne:, tehwa:n 'talwiah *este** Tepe..., Tepe..., Tepetate.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a837" TIME_SLOT_REF1="ts794" TIME_SLOT_REF2="ts795">
                <ANNOTATION_VALUE>Ne: Tecuantepec nika:mpa, ompa ti..., te:chyo:le:wka ne:n yehwa ta:totsi:n kakta *komo ranchero** de Doña Jovita Cárcamo i..., *ipotrero**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a838" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts797">
                <ANNOTATION_VALUE>entó:s ompa te:chhilih mah 'pale:wi:tih wa:n se: a..., komo que *a:caño** etok wa:n yo:n se: kichipa:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a839" TIME_SLOT_REF1="ts798" TIME_SLOT_REF2="ts799">
                <ANNOTATION_VALUE>wa:n ompa ne: se: ta:katsi:n ne:, pos neli tikinahsiah yehwa yo:n wa:pohmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a840" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>pero ta: pos n' okwilin ne: ki..., kwa..., i..., ke:meh i:n a:chia:wit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a841" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>wa:n a:mo moitilih pos ipa taksak wa:n ata kitipi:nih nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a842" TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts805">
                <ANNOTATION_VALUE>Entó:s kilwi:to ne:n yehwa ne:n komo ke n' *ranchero** kilia "a:it ke:ní:w" kilia "tikita ne:chtipi:nih" kilia "i:n kowa:t"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a843" TIME_SLOT_REF1="ts806" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>kilia "pero wa:n ni..., nimintsi:n", kilia "ke:mah", "ekintsi:n" kilia "nikwiti pahti, titai:s sah" kilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a844" TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts811">
                <ANNOTATION_VALUE>Wa:n neli ta: kimakak yehwa yo:n, yo:n, yo:n se: inekalawi:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a845" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts813">
                <ANNOTATION_VALUE>kichihchi:wilih se: *vaso, lo de** se: *medio litro** ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a846" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>kima:neloh wa:n "a:mo xi..., a:mo xikihnekto, teh ke:meskia tia:miktok xitai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a847" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts817">
                <ANNOTATION_VALUE>Wa:n tepitsi:n ximose:wi" kilia "ne:pa wa:n pano:s* kilia "yo:n kokolis a:mo, a:mo, i:pa a:mo timikis" kilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a848" TIME_SLOT_REF1="ts818" TIME_SLOT_REF2="ts819">
                <ANNOTATION_VALUE>Wa:n neli ta: sepa towa:n tekitik, ih..., towa:n tio:takik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a849" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts821">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n a:kowa:meh nikihtowa kitipi:nih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a850" TIME_SLOT_REF1="ts822" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>Wa:n *cuando** ke:meh i:n kilia "name:chtipi:nia" kilia "kowa:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a851" TIME_SLOT_REF1="ts824" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>a:mo kanah xa:ka:n, nió:n no: ximomowti:ka:n, niman" kihtowa "mah mitschihchi:wili:ka:n yehwa yo:n se: inekalawi:l, yehwa" kilia " tehwa:n nika:n timopahtiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a852" TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts827">
                <ANNOTATION_VALUE>Wa:n kihtowa *este** ompa yo:n tikinahsiah wa:pohmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a853" TIME_SLOT_REF1="ts828" TIME_SLOT_REF2="ts829">
                <ANNOTATION_VALUE>pos ta: mia..., ne: a:chia:wit etok ata ne:, ke:meh nika:n etok ikaltsi:n wa:n ihkwí:n tanakastan ompa ya temowa n' a:t, iwa:n mona:miki a ne:n we:ia:t tikiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a854" TIME_SLOT_REF1="ts830" TIME_SLOT_REF2="ts831">
                <ANNOTATION_VALUE>entó:s *por eso** ne:n miak *este** wa:pomeh nemih, yo:n michpeta:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a855" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts833">
                <ANNOTATION_VALUE>entó:s ompa tikinahsiah, timoininwa:lkwilia:yah ya tio:tak, tiwi:tseh</ANNOTATION_VALUE>
