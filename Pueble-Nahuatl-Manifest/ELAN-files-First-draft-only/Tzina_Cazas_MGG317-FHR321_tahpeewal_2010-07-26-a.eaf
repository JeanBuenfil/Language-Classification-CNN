                <ANNOTATION_VALUE>seki ika timonepantahwia:yah, tikwa:yah iwki tapoye:li:l sah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a857" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>wa:n entó:s yo:n se: ta:tahsti:n ne:n nemi nika:n Reyes,</ANNOTATION_VALUE>
