        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1430" TIME_SLOT_REF1="ts2258" TIME_SLOT_REF2="ts2261">
                <ANNOTATION_VALUE>E:soh, entó:s *cerquita** katka, a:mo semi, a:mo wehka. *Andale**</ANNOTATION_VALUE>
