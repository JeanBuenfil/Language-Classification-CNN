        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747" TIME_SLOT_REF1="ts576" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>Nehjón a:yo:tochin semi we:lik, we:lkeh, we:lkeh ¡que cendiente!. We:lkeh. Pero pos teh tikihtowa teh a:mo wel tikinkwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>Neh a:mo wel nikinkwi, *o sea d..., de plano** neli a:mo, *hasta** a:mo nikinye:ki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>Pero nikitani ne: tein kininki:tskiah wa:n nikilia "i:n ka:n tikwik, ¿Ke:ní:w mono:tsa?" kihtowa "ihkwi i:ni" kihtowa ne:, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a751" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>Wa:n ika ti..., ika titekitik no: se: *tiempo**. Ik..., kowtah ti..., nanki:sayah, e:soh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts594">
