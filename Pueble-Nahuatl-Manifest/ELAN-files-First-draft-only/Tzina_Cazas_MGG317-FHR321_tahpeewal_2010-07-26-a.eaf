        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a824" TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>nika:n tiow wa:n mah mits..., niman mah, nika:n mitstipi:nih nika:n xik..., *a ver** ke:ní:w 'chi:wa pero *el chiste** ke tikahsis yo:n de n' o:me, ma:manelo kwaltsi:n, mote:nti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a825" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>Yehwa yo:n pahti katka ne: tiempo tehwa:n ompa ne, ne: tanikwa:kopa, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a826" TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>*Solo** yehwa de n'....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a828" TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>Yehwa ya tein nimitsilihtok ne:n to..., to..., tokalawi:l</ANNOTATION_VALUE>
