        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1367" TIME_SLOT_REF1="ts2095" TIME_SLOT_REF2="ts2098">
                <ANNOTATION_VALUE>A:ah, ne: *tiempo** yehwa yo:n kikwiah yo:n n' a:t, pero a:man a:mo, a:man okseki. A:man okseki a:t kikwih, a:it toni.</ANNOTATION_VALUE>
