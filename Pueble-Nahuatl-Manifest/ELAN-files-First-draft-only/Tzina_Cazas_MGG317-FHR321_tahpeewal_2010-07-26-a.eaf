        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Yeh, yeh i:pa *este** chia:wak, i:pa a:mo ke:man ne:, tikihtowah tehwa:n wa:ki, *si no que, lo más este** chia:wak sah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a742" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>wa:n a:mo, *o sea** tikihtowah tehwa:n a:mo ye:kwa:ki porin ni..., ni..., n' ichia:wka ne:n kipia miak, ke:mah, e..., e:soleh, e:soleh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts572">
