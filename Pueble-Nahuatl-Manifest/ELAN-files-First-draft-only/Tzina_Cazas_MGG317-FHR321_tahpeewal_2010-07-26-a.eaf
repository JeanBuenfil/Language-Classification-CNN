        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a833" TIME_SLOT_REF1="ts786" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>komo ke mahyá: nochi pahti *porque tikalakiliah toni, istat, chi:l, tein eski,</ANNOTATION_VALUE>
