        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Ke:mah, owihkeh neli, e:soh.</ANNOTATION_VALUE>
