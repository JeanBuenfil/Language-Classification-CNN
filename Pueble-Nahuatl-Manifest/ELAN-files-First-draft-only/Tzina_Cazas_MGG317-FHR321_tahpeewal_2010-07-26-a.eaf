        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1398" TIME_SLOT_REF1="ts2176" TIME_SLOT_REF2="ts2178">
                <ANNOTATION_VALUE>Ke:mah, kite:moh iselo, kwa:lkwik iwa:n ya, pe:wak kima:xakwalowa, kima:xakwalowa kwaltsi:n ihkó:n.</ANNOTATION_VALUE>
