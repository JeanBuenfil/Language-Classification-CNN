        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>Pané: *nailon**, se: kiki:xtilia ihkó:n wa:n ki:sa ya.</ANNOTATION_VALUE>
