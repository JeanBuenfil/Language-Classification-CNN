        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Wa:n ekintsi:n a:mo ne:si ok, ne: ke:maniá:n niahka a:mo ne:si ok, pero ne:paka parahko yetokeh seki *matas**.</ANNOTATION_VALUE>
