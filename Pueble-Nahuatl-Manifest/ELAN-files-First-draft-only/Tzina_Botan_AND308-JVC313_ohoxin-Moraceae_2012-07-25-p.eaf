        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a806" TIME_SLOT_REF1="ts1344" TIME_SLOT_REF2="ts1346">
                <ANNOTATION_VALUE>ne:n metsti de ne:n *caballo**, ne:n tapialtsí:n, n' ompa n..., ekintsi:n a:mo ne:si ok, pero ompa se: panki:sa para se: ya:s *hasta** ne: ahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808" TIME_SLOT_REF1="ts1348" TIME_SLOT_REF2="ts1350">
                <ANNOTATION_VALUE>Ke:mah, ka:mpa ne: yetok ne: itampa n' tepe:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a810" TIME_SLOT_REF1="ts1352" TIME_SLOT_REF2="ts1354">
                <ANNOTATION_VALUE>Ompakawí:n se: kitas, ke:mah, ka:mpa yetok ne:n kowxahxaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812" TIME_SLOT_REF1="ts1356" TIME_SLOT_REF2="ts1359">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814" TIME_SLOT_REF1="ts1361" TIME_SLOT_REF2="ts1364">
                <ANNOTATION_VALUE>Pos yehwa sah neh nik..., nehwa nijó:n nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a815" TIME_SLOT_REF1="ts1365" TIME_SLOT_REF2="ts1367">
                <ANNOTATION_VALUE>Nehwa ni..., nimono:tsa ne:n Anastacio de niwa:le:w de nika:n xola:l de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a817" TIME_SLOT_REF1="ts1371" TIME_SLOT_REF2="ts1373">
                <ANNOTATION_VALUE>A:, *bueno** pos *compadrito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
