        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a803" TIME_SLOT_REF1="ts1336" TIME_SLOT_REF2="ts1338">
                <ANNOTATION_VALUE>De sepa se: matis pos se: ya:s,</ANNOTATION_VALUE>
