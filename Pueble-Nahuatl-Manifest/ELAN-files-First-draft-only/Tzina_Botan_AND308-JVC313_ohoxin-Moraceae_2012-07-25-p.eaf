        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801" TIME_SLOT_REF1="ts1332" TIME_SLOT_REF2="ts1334">
                <ANNOTATION_VALUE>Pos kwali se: kitati:w wa:n se:, se: kololo:ti:w.</ANNOTATION_VALUE>
