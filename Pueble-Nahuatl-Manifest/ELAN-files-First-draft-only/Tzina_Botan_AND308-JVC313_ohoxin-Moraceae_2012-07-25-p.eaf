        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>ompa tikitayah ne:nentok ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>pata:nti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>ne:n yo:n kiliah te:na:ka:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>Ne:, *a lo mejor** no: kit..., kitolowa:ya *o** xa: kipipi:naya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>De yoksi a kipipi:naya eski, kiki:xtilia:ya ne:n, paxi:i:nia ne:pa sayoh n' e:watsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>Iteyo sah. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>ihko:kó:n de tila:wak kiki:xtilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>Entó:s kitamo:tayah sayoh ke:meh ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>n..., yehwa sah n' iteyo sah wa:n yehwa ya ne: tikitayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>wa:n pos a:mo, a:mo nikihto:s *que** kitekitih para k...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>teihsá: kalkowit *o** teihsá:, kikwiah sayoh para ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>sayoh para ne:n s..., se: ki..., se: kikwalia:ya n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>Yo:n se:..., yehwa sah, *pero demás** nikihto:s mehmela:wak kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>a:mo se: kitaya ox mela:wak *porque** ta: itech tepe:t mopampihpilowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Xa: tik..., kwali tine:chili:s, xa: tikmati *más** teh, xa: tikitaya, xa:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>*bueno** neh a:mo ke:man nikitaya n' ixo:chio, nikitaya n' iteyo xohxoxoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>Ke:mih yo:n na:ntsi:nkowit n' iteyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>na:ntsi:nkowit. Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Ke:mah, pané: ko:ntsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n neh nimitstahtania xa: kachi tikmati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>ki:niwki ne:n, yehwa ya ne:n ohoxiwtet, xa: kachi tikmati ki:ní:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>ta:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>Mohmoloxtik. Se: kipa:taya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>Pos ihkó:n no:, no: we:lik tamanal, pero seki kita:lilia:yah yehwa ya nijó:n, *para más** we:liaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>Kachi we:liaya. Pos no: welik ihkó:n, ke:meh eskia..., ke:meh kintsi:n nikakik ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>kihtohtoyah yo:n *papas**, yo:n kamoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>pos yo:n no: *igualito** de mohmoloxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>Yo:n kita:lia:yah yehwa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts555">
                <ANNOTATION_VALUE>ne:n tsope:k kite:te:kilia:yah wa:n se: kikwa:ya se: kipixkaya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>no: *igual** i:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts569">
                <ANNOTATION_VALUE>*Igualito**, no: se: kita:lia:ya wa:n se: kikwa:ya pos no: se: kwe:lilia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>pero ne: ke:man pos nijó:n de a:mo tei pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>ihkó:n tikwa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts576" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Ihkó:n tikwa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Ato:lkamoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>Pos nijó:n ne:n ke:meh kintsi:n *azúcar** yekin ok ne:sik, ta: yo:n *antes** nochi pane:lah katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>Pane:lah nochi kichi:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>Ihko:kó:n de pa:pata:wak wa:n kita:lia:yah itech se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>nijo:n ika se: kowit ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>wa:n ompa kitapechtia:yah, ompa kite:kayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>De ompa ke:mah kikohkoto:nayah n' owapach wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>kita:lilia:yah ihkó:n wa:n kwi:kayah de ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>xola:l. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts623">
                <ANNOTATION_VALUE>*Porque** intsi:n a:mo, a:mo tei ok de nijó:n, intsi:n ti..., yehwa yo:n tikwih ya ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>tsope:lik de n' *azúcar**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts631">
                <ANNOTATION_VALUE>de koyo:m..., pero pos *antes** yehwa yo:n tik..., tikwa:yah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts644" TIME_SLOT_REF2="ts647">
                <ANNOTATION_VALUE>A:mo se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>Ihko:ni sah. kwaltsi:n mohmoloxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>kwa:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts669" TIME_SLOT_REF2="ts671">
                <ANNOTATION_VALUE>[...]Itsi:ntan se: panowa:ya, ihkó:n se: panki:saya wa:n yetoya ne:n tet ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>Ompa yetoya, ompa yetoya ne:n *seña de** n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>N' ima:tekak. A:, tikitaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>Wa:n miak nijó:n ihkó:n te:chilia:yah, kihtowa xa:, xa: timati kihtowa ka:n yetok yo:n n' imetstekak ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts692" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>tapial ne:n *caballito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts695">
                <ANNOTATION_VALUE>A:, kit kiliah seki:n, ke:mah, neh nimattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>*Cuando** tiuweh para ne:, para ne: Ecatlán wa:n tik..., tikitah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts702" TIME_SLOT_REF2="ts703">
                <ANNOTATION_VALUE>n' imetstekak ne:n tapial, de ompa kó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>*porque** yo:n tak wehka:w hkó:n mochi:wak yo:n i:n, yewaltik wa:n ye:kne:stok ihkó:n ka:mpa taksak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>Ka:mpa taksak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>Ke:mah, hkó:n yahtoya ihkó:n ahko yahtok se: ohti wa:n se: nika:n yahtok n' ohti wa:n de nika:n i:n yahtok. Ompa yetoya ne: ke:man.Yo:n ya:ya para Xo:no:tah ya:ya yo:n ohti se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>Para ne: Jonotla ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts726">
                <ANNOTATION_VALUE>kwi:kayah ompa ne:n, tayewalowa:yah ke:masá: kwi:kayah pane:lah de nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>Ya:yah tak ke:mansá: kachi ya:yah para ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts731" TIME_SLOT_REF2="ts734">
                <ANNOTATION_VALUE>Desionkopa, ompaka ya:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts735" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>wa:n ompa kitstiki:sayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>Kiliah, xa: timati ka:ni yetok yo:n imetstekak ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>tapialtsí:n ne:n *caballo**, kiliah ke:mah, nimattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a564" TIME_SLOT_REF1="ts741" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>Ke:mah, kihtowa ompa nipa panki:sa para ne:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>Ka:mpa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts745" TIME_SLOT_REF2="ts747">
                <ANNOTATION_VALUE>tayewalowa:yah seki:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts749" TIME_SLOT_REF2="ts751">
                <ANNOTATION_VALUE>a:t ke:yeh, tak porin kachi, kachi tamanis ihkó:n ya:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts753" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>Ohti, kwali etoya, pero ekintsi:n nochi tawehweliw ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>*Hasta** kipanawia:yah yo:n ka:mpa n' a:tsí:n, ne: ahko ne: kiliah *coro**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>yo:n tepe:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts772" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>Ompa yetok yo:n, tahpixtok yo:n, ki:ní:n kiliah, ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts776" TIME_SLOT_REF2="ts779">
                <ANNOTATION_VALUE>se: kwaltsi:n ihkó:n ke:meh eskia se: tet kwaltsi:n chihchi:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts781">
                <ANNOTATION_VALUE>Ke:meh eskia se: kowxahxaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>Nochi kita:lilihkah n' ii:xtololowa:n wa:n ite:noh, ie:katsol,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>n' ii:xpi:lwa:n, inakaswa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>nochi etoya, a:chá: nankiteka:kilia:yah *que** etoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts799">
                <ANNOTATION_VALUE>N' ima:ko nochi kichihchi:wkeh n' imahpilwa:n wa:n ihkó:n yetoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>Entó:s ne:n, nochi ke:meh eskia se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>ihkó:n se: tokni:w kichihchi:wka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts806">
                <ANNOTATION_VALUE>nochi, n' inakaswa:n, ii:xtololowa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts811">
                <ANNOTATION_VALUE>yehwa n' itsontsi:n no: kitehtekkah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts813">
                <ANNOTATION_VALUE>Itsontsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>wa:n i..., n' ie:katsol nochi n' i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>n' ite:noh, nochi n' ikechko, n' ikechkowyo nochi kichi:wkah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>Wa:n ne:, n' i..., n' ii:xpi:lwa:n no: kita:lilihkah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts824" TIME_SLOT_REF2="ts827">
                <ANNOTATION_VALUE>ihkó:n ki..., ki..., *kira:rayarohkah** ihko:ni, i:i:xtapal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts828" TIME_SLOT_REF2="ts829">
                <ANNOTATION_VALUE>nochi kita:lilihkah n' ii:xpi:lwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts830" TIME_SLOT_REF2="ts831">
                <ANNOTATION_VALUE>Wa:n ne:sia ke:meh eskia se: tokni:w ihkó:n k...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts833">
                <ANNOTATION_VALUE>kichihchi:wkah tak, yo:n i:pa yetoya yo:n tet,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts834" TIME_SLOT_REF2="ts835">
                <ANNOTATION_VALUE>*después** kie:kchihchi:wkah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>Wa:n ompa kita:lilihkah se: kawaktsí:n ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts838" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>se: a:matsí:n kawaktsí:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>ompa ne: tikitayah, ompa ne:n, ika n' a:t yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a606" TIME_SLOT_REF1="ts842" TIME_SLOT_REF2="ts843">
                <ANNOTATION_VALUE>a:t ka yo:n tikiliah ne: kowach n' i..., n' i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts844" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>n' ixiwyo, n' ikowyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a608" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>ika se: kikwia n' a:tsí:n ompa te:ktoya n' a:tsí:n ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609" TIME_SLOT_REF1="ts848" TIME_SLOT_REF2="ts850">
                <ANNOTATION_VALUE>wa:n ompa se: kikwia ihkó:n se: taya:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts855">
                <ANNOTATION_VALUE>Ke:masá: n' ikwa:ko no: mote:ka:ya n' a:t *porque** pan..., nika:n panchahchala:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612" TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts857">
                <ANNOTATION_VALUE>Panchahchala:nia ne:n a:tsí:n, mote:kaya ihko:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a613" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts860">
                <ANNOTATION_VALUE>wa:n om..., ompa ne:, ompa tikwiah ika yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>Ajá. Ko..., kowachma:it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617" TIME_SLOT_REF1="ts869" TIME_SLOT_REF2="ts871">
                <ANNOTATION_VALUE>T'tekiah ihkó:n, tiktekiah kwaltsi:n, tiktekiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a619" TIME_SLOT_REF1="ts873" TIME_SLOT_REF2="ts876">
                <ANNOTATION_VALUE>wa:n ke:mah ika tikwiah wa:n ika tikihyo:ti..., tila:nayah wa:n ttaya:yah yo:n a:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a620" TIME_SLOT_REF1="ts877" TIME_SLOT_REF2="ts879">
                <ANNOTATION_VALUE>Ompa ne:n, wehka:w ya ompa ne: tpanowa:yah, pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts884" TIME_SLOT_REF2="ts887">
                <ANNOTATION_VALUE>pos *más** onkaya ompa ne:n x..., xiwkowtet kilia:yah ompa *hasta** nika:mpa tani, ohohxiw, ka:mpa ma:ne:stoya ne:n tapial.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a627" TIME_SLOT_REF1="ts894" TIME_SLOT_REF2="ts896">
                <ANNOTATION_VALUE>Ke:meh, katka semi teltatso:la:n ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629" TIME_SLOT_REF1="ts898" TIME_SLOT_REF2="ts901">
                <ANNOTATION_VALUE>Tatso:la:n nochi, de panki:saya se: n' ohti nika:n wa:n se: nika:n ya:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630" TIME_SLOT_REF1="ts902" TIME_SLOT_REF2="ts903">
                <ANNOTATION_VALUE>wa:n se: ya:ya, wa:la:ya para nika:n, para nika:n xola:lpan ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631" TIME_SLOT_REF1="ts904" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>Ke:mah, wehka:w ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a633" TIME_SLOT_REF1="ts908" TIME_SLOT_REF2="ts911">
                <ANNOTATION_VALUE>Wa:n ikintsi:n ke:meh kichi:wkeh n' ohti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a635" TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>pos tawehwelohkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a636" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>Pos ne:n kowit kintsi:n a:mo se: kita ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638" TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>Neh nikitaka *hasta** ka:mpa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a639" TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>yo:n, yo:n etoya yo:n metsti de n' tapial ompa parahko nik..., nikitaka ok se: *vez**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a640" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts929">
                <ANNOTATION_VALUE>Ompa no: nikitaka ok wa:n pero kintsi:n ke:meh a:mo niahtok, nijó:n, yetos n' kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643" TIME_SLOT_REF1="ts934" TIME_SLOT_REF2="ts937">
                <ANNOTATION_VALUE>Niknemilihtok ke:masá: niá:s nikitati:w, xa: *siquiera** nikwiti:w *siquiera** se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a644" TIME_SLOT_REF1="ts938" TIME_SLOT_REF2="ts940">
                <ANNOTATION_VALUE>se: tahko *morral**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646" TIME_SLOT_REF1="ts944" TIME_SLOT_REF2="ts946">
                <ANNOTATION_VALUE>Ta: yo:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a648" TIME_SLOT_REF1="ts948" TIME_SLOT_REF2="ts951">
                <ANNOTATION_VALUE>We:li wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a649" TIME_SLOT_REF1="ts952" TIME_SLOT_REF2="ts954">
                <ANNOTATION_VALUE>*hasta** pi:piltsitsi:n kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a652" TIME_SLOT_REF1="ts959" TIME_SLOT_REF2="ts962">
                <ANNOTATION_VALUE>De tamanal kwaltsi:n we:lik wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653" TIME_SLOT_REF1="ts963" TIME_SLOT_REF2="ts965">
                <ANNOTATION_VALUE>pos nehwa nijó:n..., seki tokni:wa:n a:mo ki:xmatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a655" TIME_SLOT_REF1="ts967" TIME_SLOT_REF2="ts970">
                <ANNOTATION_VALUE>A:mo nochi ki:xmatih. Seki kihtowah toni i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>masá: neh nikinilia, niow nikte:mo:ti *ojite**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a657" TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts974">
                <ANNOTATION_VALUE>¿Toni? Nikilia pos yo:n kiliah ohohxiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658" TIME_SLOT_REF1="ts975" TIME_SLOT_REF2="ts977">
                <ANNOTATION_VALUE>Entó:s ne: nochi momakatokeh *cuenta** ki:ní:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660" TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts982">
                <ANNOTATION_VALUE>ki:n ito:ka:y ne:n, meh nika:n timolihtokeh ke:n ito:ka:y se: *semilla**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661" TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts985">
                <ANNOTATION_VALUE>Se: *semilla** kintsi:n miak taman *semillas** nochi ta:taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664" TIME_SLOT_REF1="ts990" TIME_SLOT_REF2="ts993">
                <ANNOTATION_VALUE>Ta:taman wa:n ta:taman ti..., titanohno:tsah ihkó:n, *mismo** tehwa:n ti:kni:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665" TIME_SLOT_REF1="ts994" TIME_SLOT_REF2="ts995">
                <ANNOTATION_VALUE>pero nochi ta:taman *de cada** ihkó:n tinemih itech se: xola:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666" TIME_SLOT_REF1="ts996" TIME_SLOT_REF2="ts997">
                <ANNOTATION_VALUE>xola:lpan, nochi, nochi ti..., tietokeh ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667" TIME_SLOT_REF1="ts998" TIME_SLOT_REF2="ts1000">
                <ANNOTATION_VALUE>seki taman tanohno:tsah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669" TIME_SLOT_REF1="ts1004" TIME_SLOT_REF2="ts1005">
                <ANNOTATION_VALUE>seki *igual**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670" TIME_SLOT_REF1="ts1006" TIME_SLOT_REF2="ts1008">
                <ANNOTATION_VALUE>Seki taman tik..., tikto:ka:ytiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1013">
                <ANNOTATION_VALUE>Ke:mah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
