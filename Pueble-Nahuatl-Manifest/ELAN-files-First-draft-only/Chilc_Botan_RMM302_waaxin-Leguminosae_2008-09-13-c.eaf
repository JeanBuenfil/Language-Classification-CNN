        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>kwali se: kimahse:wa n' tein selik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>A:mo chika:wak, selik se: kiteki n' kiliah wa:x..., wa:xselik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>wa:n mah se: kikwa ika n' taxkaltsí:n no:, no: taman we:lik, no: taman ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>¿*Porque** ke:yeh? N..., a:mo, a:mo iteyo sanoke se: kikwa nochi ka n' ie:wayo *porque** selik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts103">
