    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="CommentType" PARTICIPANT="Comments" TIER_ID="Comments">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>{Rubén Macario siempre dice 'ta:lmaliktsí:n' pero quizá es su manera de decir lo que otros llaman 'ta:lmaniktsí:n', 'superficie de la tierra'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>{Al posesionarse to:ka.it, pierde siempre la t. Hubiera dicho 'ito:ka:y'}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>{Dice oksekin, pero no dijo okseki:n, el plural para animados; no está claro si es n' okseki o nokseki. Lo mismo con n' oksé: o n' oksen vs. noksé: y noksen. Depende del análisis, si la /n/ representa la /n/ de /no:/ o la n' de un "determinador"}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>{la vocal "i" es corta, pero aquí la alarga al pensar en lo que va a decir}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>{Aquí se enreda, quizá quiso decir 'komo no: tiknekih tikte:ntekiskeh', dijo la segunda palabra bien en la que sigue}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
