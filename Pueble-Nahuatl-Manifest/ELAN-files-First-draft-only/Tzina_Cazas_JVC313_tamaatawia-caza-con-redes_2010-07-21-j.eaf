        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Komo t'neki nimitsilia *más, más** i:xwehwei</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>pos t'teki mohtaw pa:pata:wak, komo t'neki *más** i:xpisi:ltik pos pitsaktsi:n ohtatsi:n pero kwaltsi:n ki:sa *finito mo..., moma:taw.</ANNOTATION_VALUE>
