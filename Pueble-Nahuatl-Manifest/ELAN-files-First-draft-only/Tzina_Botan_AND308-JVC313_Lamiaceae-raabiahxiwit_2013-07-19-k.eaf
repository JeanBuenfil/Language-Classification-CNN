        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Nochi *morado** de yehwa yo:n nehjó:n a:mo mochi..., noya:n mochi:wa, yo:n yetok sah ka:mpa mochi:wa, ne: ka:mpa tehwa:n tietokeh mochi:wa semi.</ANNOTATION_VALUE>
