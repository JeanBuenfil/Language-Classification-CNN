        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Ke:meh ne: ke:man pos nochi tik..., yehwa ika te:chiskaltihkeh, te:ch..., a:mo ya:yah te:chwi:kayah tapahti:lo:ya:n, yehwa yo:n xiwtsitsi:n kikwitih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>Wa:n tak *más** kimatiah wa:n kwali ne: semi te:ch..., te:chna:mikia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>Pos ekintsi:n tehwa:n no: ti..., ke:meh i:n te:chiliah tota:tahwa:n pos no: tik..., no: tikmattiiowih ihkó:n de ke ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>Ke:masá: a:mo no: kina:mikis se: kone:tsi:n oso se: tokni:w ihkó:n pos se: motapowi:s wa:n se: ki..., se: kikwiti:w yo:n xiwtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>*O** se: kimanas wa:n se: kili:s yehwa i:n no: kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>Ke:masá: kachi te:na:miki ne:n ke:meh i:n xiwtsitsi:n tama:pah, se: kite:mohtinemi, se: 'kwiti ke:meh i:n se: mona:mikis se: mo..., molia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>katí:n kwali te:na:miki, katí:n a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Pos se: 'kwiti a *o** kwali se: kili:s, kihto:s ne:chkwi:li:ti wa:n nimitsmakas para teisá: para xkwiti nehjí:n xiwtsi:n, teh tiki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>Pos ihkó:n no: kwaltsi:n de ke se: mo..., molia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>Ke:meh ekintsi:n nika:n timona:mikkeh, itech i:n ohti pos nochi timo..., ke:masá: nochi kwali se: kitas ne:n xa: kwali de n' o:me taman se: kisenta:li:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>Nehjó:n pahti de n' ista:k, de neh niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Wan de teh tiki:xmat nehjó:n, se: kisenta:li:s ke:meh ekintsi:n tine:chilihtok, kwali ka:mpa se: metsoli:ni, se: mo..., mohxilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Pos kwali se: kisenta:lia nehjó:n xiwtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>No: *igual** ke:meh ne:, nimitsilihtok para ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Sa..., ne:n te..., kimanayah wa:n ika te:altia:yah para ne: toto:nik *porque** ne: ke:man semi tel wetsia ne:n to:nawis kilia:yah, yo:n se: sehse:wi, sehsekwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>Se: sehsekwia wa:n semi se: ko:kochkamacha:lowa:ya, yehwa yo:n kilia:yah to:nawis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>kilia:yah se: okwiltsi:n kit de te:tipi:nia:ya ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>se: ke:meskia mo:yo:t nemia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>pero ekintsi:n a:mo se, a:mo kanah se: kita nehjó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>A:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Ihwa:k ne:n ti..., te:chmakayah no: te:chilia:yah seki pahti, yo:n *pastillas**, te:chonkwilia:yah, kilia:yah *metoquina**, xa: tikmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>*Metoquina** pero *más** te:chna:mikia yehwa nehjó:n xiwtsi:n wa:n yehwa ya nehjó:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Yehwa yo:n ne:n wa:n yo:n ne:n tio:kowit i..., ie:wayo kionkwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Iwa:n kimanayah wa:n ika te:cha:ltia:yah, te:chmetspa:kayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>Yo:n kwali nehjó:n e:wat de n' tio:kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>Entó:s yehwa ekintsi:n miak tokni:wa:n a:mo kimatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Pero ekintsi:n ke:masá: pos ne:n, ke:meh ekintsi:n no: kwali a ke a:mo pano:tok nehjó:n kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>*Porque** yo:n kokolis ne:n ke:masá: yehwa ya te:chmakayah yo:n *pastillitas** ne:n mono:tsaya *metoquina**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>Yehwa yo:n te:chmakayah, te:chtai:ltia:yah wa:n 'neltoka ke:meh ne: no: tikmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>Ke:ní:w te:chmakayah ne:n tota:tahwa:n, ke:ní:w para ti:xpeta:niskeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>ihwa:k timota:lia:yah ihkó:n, ma:ski te:chtake:ntia:yah *hasta** tiwiwyokatokeh ompa ne:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>Tiwiwiyokayah *porque** tisekwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>Sehsekwi:lis wa:n se: ko:kochkamacha:lowa:ya wa:n se: kochisneki pero a:mo se: kochi, ta: se:, ye:k se:, se: toto:nik se: moka:wa, se: wiwiyokatok wa:n ika yo:n ne:n xiwit ne: kikonkwiah yehwa yo:n e:wat de ne:n tio:kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>Wa:n no: nikmatia de ke ika seki no: te:chi:lia:yah tota:tahwa:n kimaxakwalowa:yah nochi iwa:n yo:n chakaixiwit, yo:n iyo:lselo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>Entó:s nochi ika tamane:lowa:yah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Pero nehjó:n wa:n yehwa i:n xiwtsi:n nimitsilia tein niki:xmattok nehjí:n, in kowit, ne:n ra:biahxiwit pos yehwa no:, no: kwali iwa:n kima:nelowa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Wa:n sepa ke:meh ekintsi:n tine:chilihtok pos ne:n, pos a:mo se: kimati pero pos yehwa yo:n se: kitas ke:masá: *porque** no:, ke:masá: se: ki..., se: kineki pero no: kwali a ekintsi:n mah a:mo pano:skia nehjó:n kokolis de to:nawis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>*O** teisá: sa:wameh *porque** yo:n sa:wameh nochi te:ke:mih no: *hasta** kone:meh nochi wa:n pos se: yo:lpoliwi a katí:n ne:n ika se: ki..., kipahti:s se: kone:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>De katí:n te:chna:mikis, katí:n a:mo te:chna:mikis, a:mo, pos ke:masá: kachi te:chna:miki ne:n de i:n tama:pan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>De kowtahxiwtsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>Miak tikpanohwihtinemih teisá: ihkó:n itech ohti ne:n teisá: xiwtsitsi:n pero pos a:mo tikmatih, a:mo tiki:xmatih katí:n tein te:chna:mikis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts421" TIME_SLOT_REF2="ts423">
                <ANNOTATION_VALUE>Pero ekintsi:n tein tepitsi:n tiki:xmattokeh ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>Pos yehwa yo:n timoliah wa:n ti..., tikwitih wa:n ihkó:n kwaltsi:n timomati:ltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>Ke:mah wa:n neh, neh yehwa sah tein nik..., tein nikmati, nimitsilih wa:n ne: ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>Pos nehwa nimono:tsa Anastacio Nicolás Damián, neh niwa:le:w San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>A:, we:noh, tasohka:matik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
