        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>*Porque** tewi:tso:t a:mo teh ke:namih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>A:mo, a:mo ke:namih, ne:n..., a:, niú:n tei, a:mo, a:mo teh kipia pero, a..., wa:n yeh, yeh ahwiya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
