        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>Yehwa sah yo:n, ke:mah, yehwa sah yo:n ika timonohno:tsah wa:n ne:s...</ANNOTATION_VALUE>
