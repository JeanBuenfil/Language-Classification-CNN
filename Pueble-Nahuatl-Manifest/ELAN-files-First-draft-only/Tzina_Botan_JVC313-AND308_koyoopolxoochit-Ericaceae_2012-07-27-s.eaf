        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>Ka:n a:ki:n te:ilwia, pero de tikmattokeh, neh n'mattok *porque** yehwa n' ika nimopale:wih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>ika yo:n tataxis ni..., ne:..., ne:chkwika wa:n ne:chmakakeh nota:tahwa:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>yehwa ne:chna:mik, yehwa sah ne:chna:mik, a:mo teihsá: *más** ne:chna:mik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts666">
                <ANNOTATION_VALUE>Ye..., ye..., nie:ktatasia, ke:mah, yeh ka n'mattok yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>yo:n xiwtsí:n wa:n tewi:tso:t semi, semi kipia n' iwelitilis para te:pahti:s yo:n tataxis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>Ke:..., ke:mah, neh, neh nitai:ka, ni...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>nitai:ya sayoh, nitai:ya sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>A:mo, a:ah, nitai..., nitai:ya, nitai:ya yo:n a:tsí:n.</ANNOTATION_VALUE>
