        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>Tsokowa:ki.</ANNOTATION_VALUE>
