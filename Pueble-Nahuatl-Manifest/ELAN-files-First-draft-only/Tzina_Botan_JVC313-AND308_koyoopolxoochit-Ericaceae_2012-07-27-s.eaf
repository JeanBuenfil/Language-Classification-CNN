        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>Ma:s miak n' a:t kita:lilia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts703">
                <ANNOTATION_VALUE>¿Wa:n yo:n a:tsí:n a:mo, a:mo, a:mo chichi:k?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>kwaltsi:n no: ne:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>A:mo, chipa:wak. Wa:n xo:chitsí:n no: *igual**, a:mo no: chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>Ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>A:, *bueno**. Neh nimono:tsa Anastacio Nicolás Damián, niwi:tsa de ne: xola:l San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
