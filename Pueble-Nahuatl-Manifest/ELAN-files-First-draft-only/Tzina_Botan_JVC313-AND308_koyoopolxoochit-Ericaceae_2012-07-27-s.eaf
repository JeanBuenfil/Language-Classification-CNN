        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>E..., tsokowa:ki, tsokowa:ki, de k..., de kimanah se: *li...**, se: *litro de** a:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts695">
                <ANNOTATION_VALUE>sayoh tahko *litro** moka:wati wa:n ke:mah yehwa se: tai a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>Ke:mah, yehwa sah, ke:mah wa:n tai:ya mo:stah, mo:stah ntai:k sake:ra se: *semana** wa:n yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>Kanah, ka:n chichi:k, ahwiya:k ke:mah.</ANNOTATION_VALUE>
