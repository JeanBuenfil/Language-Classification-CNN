        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>Yo:n no: tatsetselo:l tixtsi:n, alaxtik wa:n se: kipankalakilia yo:n xo:chitsi:n teyin yo:n wahwa:kik a, teyi:n yo:n ahwia:k.</ANNOTATION_VALUE>
