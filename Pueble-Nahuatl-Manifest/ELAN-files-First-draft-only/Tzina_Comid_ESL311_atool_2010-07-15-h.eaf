        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>wa:n se: kipankalakilia ya, se: kitsope:lia, mah ahwia:ya.</ANNOTATION_VALUE>
