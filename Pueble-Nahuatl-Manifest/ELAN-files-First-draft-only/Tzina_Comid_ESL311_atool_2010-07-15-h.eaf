        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>wa:n iswat ompa paniá:n yowi, teisá: se: kipantsonke:ntia, tilmah oso naylon</ANNOTATION_VALUE>
