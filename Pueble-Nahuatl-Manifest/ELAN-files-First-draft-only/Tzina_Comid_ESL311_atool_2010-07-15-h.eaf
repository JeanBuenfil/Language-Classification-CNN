        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>Yeh no: niweli, se: kipa:ta kwaltsi:n.</ANNOTATION_VALUE>
