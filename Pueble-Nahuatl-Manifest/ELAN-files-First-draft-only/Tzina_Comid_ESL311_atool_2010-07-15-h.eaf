        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Ke:mah, no: se: kitsope:lia mahyá: e:lo:tamal.</ANNOTATION_VALUE>
