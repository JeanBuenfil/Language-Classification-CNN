        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>Yehwa sah ne:n, yehwa sah, de *más, más** ato:l, *solo** tein takowal a.</ANNOTATION_VALUE>
