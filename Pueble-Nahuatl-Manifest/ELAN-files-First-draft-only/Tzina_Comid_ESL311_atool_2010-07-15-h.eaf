        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Yeh no: se: 'kwe:chowa n' kamoh, kwaltsi:n se: kipa:ka, wa:n se: 'kwiti ka:mpa onkak wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
