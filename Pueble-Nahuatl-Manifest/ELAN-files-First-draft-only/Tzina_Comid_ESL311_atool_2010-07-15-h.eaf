            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>se: kitsetselowa tixtsi:n wa:n se: kiketsa itech se: ko:mit a oso *olla** wa:n</ANNOTATION_VALUE>
