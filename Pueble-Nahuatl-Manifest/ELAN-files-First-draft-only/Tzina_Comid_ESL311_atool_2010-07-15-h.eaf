        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>Yeh iwki sah se: kichi:wa, se: kita:lilia tepitsi:n *chili:toh** wa:n kwali a</ANNOTATION_VALUE>
