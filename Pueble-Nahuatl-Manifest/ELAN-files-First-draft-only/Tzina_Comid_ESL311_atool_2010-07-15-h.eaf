        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>Se: kwe:chowa se: we:i *rollo** wa:n ke:mah ika se: kiihtixakwalowa ya ko:mit</ANNOTATION_VALUE>
