                <ANNOTATION_VALUE>Panki:sa, iwki yo:n neh niki..., nikitak wa:n iwki yo:n neh nimopahtih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
