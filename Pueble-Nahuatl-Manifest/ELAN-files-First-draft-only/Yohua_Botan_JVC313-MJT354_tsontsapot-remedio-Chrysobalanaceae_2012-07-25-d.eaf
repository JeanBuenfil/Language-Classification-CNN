        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>ka:n akah ok ma:ski tiko:nmattoskiah tik..., te:chpahti:skia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>tikmattokeh kwali tapahtia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>Ke:mah, iwki yo:ni n' tehwa:n ta:to n' ompa ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>timopahtiyah. ke:mah. Ke:mah, mah se: mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>I:pa iwki pero ta: neli ne: mah se: mochi..., mone:ntamati ke:ní:w se: mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>mochi:was *porque** neli ke:meh i:n se: kimpia se: iixwi:tsitsi:n pos neli momowtiah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>se: sepatika n' ka:n kinekih kikwa:skeh n' taxkaltsí:n *porque** ka:n kwe:liliah *porque** yehwa yo:n nemowtil kinta:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>Yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>Ke:mah, ta: nochi *kimpasarowa** neli yo:n se: sepa mowetsi:ltiah oso neli tein *cuando** selkeh ok pos neli ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE>mowe..., mowetsi:ltiah wa:n momowtiah pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>yo:n no: kichi:wa *remedio** mah tehwa:n se: kinchi:wili no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>mah se: kite:ka itech *cama** m' pilitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>wa:n ke:mah mah se: *kimetsparejaro**, mah se: kitahtapechti kwaltsi:n ne:n ikwa:tsompal wa:n ke:mah mah se:, yo:li:ktsi:n se: kimets..., kimetskahokwi tepitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>*porque** neli *cuando** yo:n telseltsitsi:n, *apenas** ata kipiah *o** se: *quince días o veinte días**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>semi *peligro para** se: kimpahti:s wa:n yo:n se: sepa ata motelihso:tah m' pilitsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>*porque** neh nikinitani ne: nikimpia noxwi:tsitsi:n, ekintsi:n wehweykeh ya *gracia de dios, porque** pos ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>yo:lik mahkoktokeh ya nopiliwa:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>iwki sah nikimpahtia *porque** no: se: na:no no: ne:chmachtih, kihtowa ne: na:no, kihtowa n' ta: neh kihtowa a:mo nisenemis, kihtowa n' *dios** ne:chihkwani:s kihtowa wa:n mah moma:..., mah moma:ko moka:wa kihtowa i:n tanawati:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>xikita kwali kihtowa ke:ní:w nikpahti:ti kihtowa m' pilitsi:n wa:n no: uhki a kihtowa a:mo sepa ok kihtowa xne:chwa:lkwili kihtowa *porque** neh *dios** ne:chihkwani:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>Wa:n neli m' *pobrecito** no:, *nocomadrita** katka momikilih pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>a:man kihtowa, tehwa ya xne:ntamati kihtowa, *a ver** ke:ní:w n' tikinchi:wa m' pilimeh, neh a:mo nisenemis niú:n..., tekit nikitato ok m' *pobre** i:pa *mal** yetok a pero ne:chpahtilihka ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>Pero ekintsi:n kihtowa a:mo ok kihtowa, *este** a:mo xwa:lkwi ok kihtowa *porque** a:mo teh n'ye:kmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts421" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>teh x'chi:wa ya kihtowa ke:meh nimitsnawatia kihtowa, komo tikita mihso:ta kihtowa yo:n telka:nmoketsa kihtowa n' ihxo:ch,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>xikwi yo:li:ktsi:n kihtowa m' pilitsi:n wa:n xik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>mah, mah se: kihtowa n' kits..., kwa:tsi:tski ihkwí:n kihtowa ne:n pilitsi:n, kwaltsi:n mah kitsi:tski n' itsontekontsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>ihkwí:n kihtowa mah kikwa:tsakwilti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>wa:n yo:li:ktsi:n kihtowa n' itech..., x'metsmahma: ya kihtowa, imetstsi:n x'kahokwili kihtowa wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>xikto:ka:yti kihtowa m' pilitsi:n wa:n x'metspi:tsa, ihkwí:n *x'parejarowili** kihtowa n' imetstsi:n wa:n x'pi:tsa kihtowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>chi:ko:me *viaje** oso *ocho viajes** kihtowa x'pi:tsa wa:n tikitas kihtowa pahtis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>Mo..., mota:li:s kihtowa n' ikwa:a:w kihtowa nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>*Porque** neli pankalaki ata mahyá: se: tomi:n ata n' *cuando** tiseltikeh, pankalaki n' i..., ke:mih se: tomi:n ne:n ikwa:a:tsi:n. kwa:tekochtia, wehkatantia. Metschikotiah wa:n entó:s ka:n mo..., ka:n *moparejarowa** n' imets. Entó:s *hasta moparejarowa** kihtowa wa:n tika:was a kihtowa yo:n pilitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>*Moparejarowa** kihtowa kwaltsi:n ihkwí:n moka:wa kihtowa n' imetstsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>ihkwa:k ke:mah kihtowa a:mo x'pahti ok kihtowa, *porque más** kihtowa tikwehwelo:s tehwa sepa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>Tepitsi:n sah, *pero cuando** yo:n pilitsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>mah se: kinte:moli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>ke:mih *este** nika:n tipe:was n' ikwa:ko nika:n tatahko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>wa:n ompa nochi x'pi:chili nika:n italwayotsitsi:n, ke:meh yetok n' italwayotsitsi:n pilitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>kwaltsi:n x'pi:tsa wa:n ke:mah iwki pahti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Pahti a, pero nochi x'ne:nemi:ltili, a:mo sayoh seko sah ne:n tikchi:wili:s, sano telmiakka:n ya ne:n, *hasta** nika:wí:n ikechkochakya:n nochi mah se: kipi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts482">
                <ANNOTATION_VALUE>Entó:s iwki yo:n pahti a, n' ika sepatsi:n sah wa:n kwaltsi:n moka:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>Ke:mah, kwali moka:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>Ke:mah, *porque** pos yo:n nochi m' pahmeh i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>*porque**... I:pa iwki ta:to neli ta pos ne: para s..., ke:mah ta: para ne: mah...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>moka:wa totech *porque** pos komo a:mo ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>ne:, ne: miak taman ne:n tehsá: kowtetsitsí:n pahmeh *por eso** a:mo tikmatih sah. A:mo tikchi:wah *cuenta, *mismo** tehwa:n tika:wilohtokeh yo:n pahmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>Ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>timowe:ikokowah ya pos neli ne: mahyá: te:chta:nisneki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts525">
                <ANNOTATION_VALUE>Yeh yo:n a:mo kipahtiya, a:mo kipahtiya, pero ne: se: kimatililia pos tokni:wa:ntsitsi:n se: kinahchi:wilia n' kokolistsí:n tein ... Mihkwania we:..., we:i *dios** kichi:wa, tatio:chi:wa pos neli n' tein *dios**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>te:ihkwanilia iwki sah, ye:kneli n' iwki pero ta: nochi *dios** kitio:chi:wtok nika:n tinemih ta:ltikpak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>A:, *bueno** ta:to.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>Ka:n teihsá: a:ki nika:wí:n timoitakeh wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>Ne: nika:n timonohno:tstokeh, pos ne: ka:n tehsá: ne:, tasohka:matik de tehwa:tsi:n. ke:mah. A:, n' os neli wa:n neh nimono:..., neh nimono:tsa niMaría de Jesús Tecuaco wa:n niwi:tse de ne:ka Yohualichan. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
