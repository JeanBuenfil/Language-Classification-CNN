        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>pos neli nochi tomi:ntsi:n moneki wa:n ka:n se: kahxitia ok pos ta: moneki wa:n neli ne:n mah se: mone:ntamachi:wa para tehwa:n ya *porque** pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>kipia de mah no: se: momachti *porque** pos komo a:mo se: kichi:wa *cuenta** pos nochi s..., nochipa ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>se: na:no, se: ta:to no: *dios** kihkwani:s wa:n nipa ka:n</ANNOTATION_VALUE>
