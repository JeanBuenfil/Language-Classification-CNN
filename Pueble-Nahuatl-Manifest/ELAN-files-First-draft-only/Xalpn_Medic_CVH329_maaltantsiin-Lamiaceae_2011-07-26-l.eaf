        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>¿Wa:n ke:ní:w se: ki:xmati kati:ni ne:n ista:k, *chino** wa:n *morado** ne:n xiwtsí:n?</ANNOTATION_VALUE>
