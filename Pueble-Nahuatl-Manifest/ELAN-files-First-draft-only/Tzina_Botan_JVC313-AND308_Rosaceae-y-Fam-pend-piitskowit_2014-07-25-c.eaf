                <ANNOTATION_VALUE>Ke:mah wa:n nejó:n ... Neli ne: pampi:xowi n' iteyo wa:n ki..., kikwah chiktehmeh, seki [...], kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>pero ne: neh ka:n ke:man nikololowa ne:n iteyo pero nikita ke ke:ní:w ohololtik ke:meh yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
