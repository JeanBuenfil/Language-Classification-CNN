                <ANNOTATION_VALUE>Ke:mah, n'mattok *porque** ka:mpa tehtetah onkak yehwa yo:n kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Ke:mah, wa:n ... Ka:n n'mati wa:n mochi:wa wa:n takwa:wak ki:sa *porque** tehtetekwa:ko tak mochi:wa, takwa:wak semi ne: ... Tehtetsa:la:n monal..., monalwayo:tia wa:n takwa:wak ki:sa n' kowit yo:n,</ANNOTATION_VALUE>
