                <ANNOTATION_VALUE>ke:meh yo:n kapolin iteyo, ke:meh yo:n mochi:wa ixta:wat a, ixta:wakapolin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
