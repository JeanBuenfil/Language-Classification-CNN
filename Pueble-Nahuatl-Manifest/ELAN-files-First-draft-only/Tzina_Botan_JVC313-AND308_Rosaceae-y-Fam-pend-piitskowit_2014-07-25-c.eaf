                <ANNOTATION_VALUE>wa:n i:n [ni]mitsilia ma:pa:pata:wak wa:n de i:n seki pos ne: ma:pihpits..., ma:pihpisi:ltik wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
