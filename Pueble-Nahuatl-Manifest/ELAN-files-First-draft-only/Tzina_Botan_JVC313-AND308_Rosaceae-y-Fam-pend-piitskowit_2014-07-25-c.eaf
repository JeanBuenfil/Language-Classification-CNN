        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>A:, pos a:chá: ke:meh yo:n xa:lkapolin,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>xa:lkapolin, ihkó:n eski</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>Wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>chi:chi:le:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Wa:n yo:n kowit kwaltsi:n kichihchi:wah, nochi ne:n teisá: oso</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>alaxtia, a:mo te:ma:kokoh ok, ma:ski ika se: ki...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>Pos kwaltsi:n nejó:n kowit chi:chi:ltik sayoh ke a:mo nochi tikmatih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>A:mo nochi tikmatih, tiki:xmatih sayoh se: taman, pos no: kwalia ke: o:me taman se: ki:xmattok, ke:meh i:n se: mo..., nentinemi kowtah pos se:, se: kitstinemi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Se: kitstinemi wa:n pos kwaltsi:n no: de ke nika:n timona:mikkeh wa:n timo..., [timo]nohno:tsah pos nochi se: momati:ltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Pos neh nimono:tsa Anastacio Nicolás Damián, niwa:le:w de San Miguel Tzinacapan.</ANNOTATION_VALUE>
