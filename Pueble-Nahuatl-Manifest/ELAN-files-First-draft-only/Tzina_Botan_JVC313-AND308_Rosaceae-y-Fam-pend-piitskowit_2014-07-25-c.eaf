                <ANNOTATION_VALUE>wa:n yo:n, yo:n pi:tskowit semi mochi:wa ka:mpa tetah, ka:mpa tehtepe:yoh mochi:wa yo:n pi:tskowit ma:pa:pata:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
