        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>Ke:mah wa:n sayoh ne: te..., teyowa no:, teyowa nikitani no: neh. Teyowa *igual** ke:meh yo:n oksé:, oksé: pi:tskowit *igual**. Iwki no: ixo:chio, ixo:chio no: ista:k ixo:chio.</ANNOTATION_VALUE>
