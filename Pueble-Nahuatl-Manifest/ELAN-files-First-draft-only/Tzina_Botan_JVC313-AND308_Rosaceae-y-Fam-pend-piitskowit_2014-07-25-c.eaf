        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>[ko]moke o:me, o:me ima:i ima:tsi:ntan kipia, pero se: ima:i tsi:tsikitsi:n. Ke:mah wa:n i:n ... yo:n se: n' pi:tskowit yeh ma:pa:pata:wa:k,</ANNOTATION_VALUE>
