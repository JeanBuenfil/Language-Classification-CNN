                <ANNOTATION_VALUE>Chi:chi:le:wi kwaltsi:n, de a:paliwi, kwaltsi:n chi:chi:[le:wi], de a:mo a:paltik, a:mo chi:chi:ltik.</ANNOTATION_VALUE>
