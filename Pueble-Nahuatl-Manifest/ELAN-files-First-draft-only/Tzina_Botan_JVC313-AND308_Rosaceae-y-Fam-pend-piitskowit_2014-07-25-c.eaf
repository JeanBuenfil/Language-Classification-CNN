                <ANNOTATION_VALUE>nejó:n sentaman tein yo:n ma:pisi:ltik ne: yehwa mo..., ne: tiki..., tiki:xmatih ma:ihi:xo:me</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
