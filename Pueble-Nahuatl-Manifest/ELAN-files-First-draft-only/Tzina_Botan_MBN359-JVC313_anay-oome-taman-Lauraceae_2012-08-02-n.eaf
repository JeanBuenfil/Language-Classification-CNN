                <ANNOTATION_VALUE>Wa:n neli *este** komoke para n' kowtsitsi:n, para n' kowtsitsi:n tein kima:malti:tih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
