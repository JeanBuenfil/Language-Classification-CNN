                <ANNOTATION_VALUE>kisa:lowah wa:n yehwa yo:n ki..., kikwih kali kit, ki..., mahyá: kowtareah kitamachi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
