        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Ihkó:n ne:chtapowia:yah wa:n kilpia:yah ika yo:n, ika yo:n tata:wikmekat oso peto:lmekat ika kitili:ntia:yah, achi takwa:wak yo:n komekat, yo:n xoxoktik, ata peto:lmekat yo:n xoxoktik, mowila:na ta:lpan.</ANNOTATION_VALUE>
