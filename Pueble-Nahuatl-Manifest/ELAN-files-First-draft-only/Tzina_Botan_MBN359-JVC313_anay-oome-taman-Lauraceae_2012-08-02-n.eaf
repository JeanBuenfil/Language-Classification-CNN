        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>wa:n *hasta** iyo:la:n kikwa:tsakwatih wa:n ne:wí:n no:, ka:mpa ne:wí:n seko, no:, no: kisa:lowah para ki..., para tatahko kali kitsakwaskeh kit yo:n.</ANNOTATION_VALUE>
