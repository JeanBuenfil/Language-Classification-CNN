        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>yehwa:n a:mo te:makah. Te:makah para se: ke:meh i:n tehsá: ihkó:n pahti, pero para se: talna:mikis a:mo kimatih n' koyo:meh to:ni te:na:mikis para tikwis *más** talna:miki:lis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>wa:n yehwa yo:n te:, te:makayah tehwa:n te:chpahtia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Ekintsi:n a:mo ok moelka:w a n' *costumbre** yo:ni  ekintsi:n nochi mokoyo:pahtiah nochi tein yeski nochi tika:wkeh ya  tein...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>Tein tota:tawa:n te:chpahtia:yah ika nochi moka:w ipan t'taksatokeh ya wa:n a:mo *valerowa** ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>*valerowa** n' koyo:pah no:, ompa te:..., tiowih *importa** nochi n' tehsá: kokolis tataxispe:was k'kwitih *jarabe** k'kwitih *pastillas** k'kwitih miak taman</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>wa:n ma:ski a:mo te:n... Seki tena:miki seki pero tein timomattokeh timo... techakah pahti de, de masewalpah o xiwpah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>a:mo te:chna:mikis más t'tami:s *jarabe**. Neh a:mo ke:man tai *jarabe** neh *o inyección** neh *solamente** xiwpah ne:ch... Nimotalia o** n'tai yehwa sah ne:chna:miki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>se: ihxo:ch ne:chkwis se: tataxis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>n'tai tehsá: pahtsi:n sah wa:n ne:chka:wa a:mo ke:man *ne:chyectarowah** nió:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>*pastilla** n' tolohtok neh a:mo, *porque** a:mo timomatih n tehwa:n *tocuerpo**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>onkak, onkak sayoh ke tehwa:n a:mo tikchi:wah *cuenta** a:mo tika:hokwih ok tein tika:wkeh ya a:mo tikahokwih ok. Pero onkak mah se:  kichi:wa sah onkak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>onkak, ke:mah ekintsi:n ki:stok se: talna:miki:lis kipia n' *gobierno** ekintsi:n nochi mase:waltaamchti:lis tanemili:lis *hasta** totahto:l kahokwi *gobierno** ekintsi:n kwe:i chi:wtyok a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>wa:n yehwa yo:n *ojalá** eskia mochiwas... Mah sepa tikahokwika:n tein tika:wtokeh ya. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>ta:lokot. tatakxiwit mono:tsa  kitoka:ytiah seki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>yeh yeh ta... Yeh tsikitsitsi:n mochi:wa wa:n no: xoxoktik sah yo:n i..., ixiwyo wa:n imetskowyo xoxoktik wa:n mahyá: *tubito** ne:n ikwowyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>komo se: kiposteki ihtikoyoktik wa:n cho:kilohki:sa ata yo:n ista:k n' icho:kilo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>ke:mah yo:n no: se: yo:n. A:mo i:n ta:lokot no: se: i:n morrahrra:mahtia ihkwí:n sah mochi:wa se: *cuarta** de wehkapan wa:n moye:kmahmaxalowa wa:n i:n moahkokehketsa n' ixo:chiotsi:n iyola:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>moahokehketsa iyola:n wa:n... Wa:n ne: *color de rosita** ne:n ixo:chiotsi:n, chi:chi:ltik pero a:chi:petik sah *color de rosa**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>yehwa yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>wa:n ye:kahwia:k komo se: kwiwtak ye:kahwia:k n' inalwayo ke:meh *vaporrub**. Ihko:ni yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>yo:n pahti para se: motaweli:s komo se: kineki mah se: momachti tehsá: a:ken momachti:sneki mah kite:mo yo:n wa:n mah momaka wa:n kitas koma:mo te:pahtia. Yo:n te..., te:pahtia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Pos neh no: nimono:tsa niErnesto Vasquez niwa:le:wa San Miguel tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
