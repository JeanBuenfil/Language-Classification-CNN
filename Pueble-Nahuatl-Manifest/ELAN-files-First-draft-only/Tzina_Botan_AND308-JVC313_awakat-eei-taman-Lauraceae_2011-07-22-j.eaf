        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>Ke:mah, tak kita:liliah teihsá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n ika ni...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Pos neh nikmattok nika:wí:n ihkó:n tikwih wa:n tike:wah wa:n tiki:xtiliah n' ie:wayo wa:n tikwah nijó:n, [...]de nika:wí:n *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>pos nika:n tsikitsitsi:n ne:n awakat mochi:wa, a:mo semi wehwei mochi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>Kahkana:wak, a:mo tihtila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nochi ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>pos se:, no: taman ahwia:k de nika:wí:n awakat onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Nika:n ke:masá: se: kikwa ika chi:ltamo:ltal se: kipalohtiw wa:n se: kikwa yo:n awakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>Yehwa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>ke:mah  wa:n yehwa ya ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>n' ixiwyotsi:n pos we:lik, no: ahwia:k, yehwa yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>kkwe:chowah *o** kikokotochiliah yehwa ya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>etsí:n, yo:n kiliah chichime:koh pos ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>kketsah wa:n ki..., ka:ki:xtiah wa:n kikwe:chowah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>*antes** kikwe:chowa:yah ika metat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>ika metat kikwe:chowa:yah wa:n ompa niwa:n kikwe:chowa:yah ya ne:n xiwtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>awakai..., ne:n yehwa ne:n awakaiswat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>i:n o:me taman nikmattok para pahti, pos yehwa yo:n *cuando** se: moehekawia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts518" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>pos yehwa yo:n ika te:..., te:xakwalowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts525" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>Yo:n te:na:miki no:, yo:n no: kwali wa:n *aparte de** se: kikwa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>wa:n *aparte** para se: mo..., mopahtia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts545">
                <ANNOTATION_VALUE>Pos yehwa sah *compadrito**, yehwa nimitstahtania, yehwa sah *compadrito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts551">
                <ANNOTATION_VALUE>Pos neh nijó:n nimono:tsa Anastacio Nicolás Damián wa:n niwa:le:w ompa ne: San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>A:, *bueno**, tasohka:matik *compadrito**.</ANNOTATION_VALUE>
