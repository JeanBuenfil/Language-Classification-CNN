        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>te:ahsitiki:sa teihsá: kokolis se: kina:miki ne:n</ANNOTATION_VALUE>
