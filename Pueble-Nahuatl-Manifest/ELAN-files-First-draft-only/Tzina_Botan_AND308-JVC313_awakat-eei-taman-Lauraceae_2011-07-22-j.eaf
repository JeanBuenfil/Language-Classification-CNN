        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Kahkana:wak wa:n kachi we:weyakaxtik ihkó:n.</ANNOTATION_VALUE>
