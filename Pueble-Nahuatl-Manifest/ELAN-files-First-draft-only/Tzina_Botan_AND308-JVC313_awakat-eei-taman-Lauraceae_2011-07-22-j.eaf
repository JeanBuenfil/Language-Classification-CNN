        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>se: kitamo:ta n' iteyo *o bien** ne:wí:n se: kita:lia se: kito:ka.</ANNOTATION_VALUE>
