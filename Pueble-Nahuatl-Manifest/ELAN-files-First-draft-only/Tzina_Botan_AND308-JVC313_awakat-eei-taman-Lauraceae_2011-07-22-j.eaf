        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>No: pahti, pero n' ixiwyo no: we:lik kichihchi:wah, kikwe:chowah. Ke:mah, a:xka:n ne:n i..., iteyo ne:n awaka..., n' awakatsí:n pos yo:n,</ANNOTATION_VALUE>
