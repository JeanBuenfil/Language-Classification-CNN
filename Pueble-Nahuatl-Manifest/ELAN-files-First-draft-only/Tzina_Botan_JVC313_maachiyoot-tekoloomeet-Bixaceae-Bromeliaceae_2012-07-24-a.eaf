                <ANNOTATION_VALUE>*isuplente** kitohtokatok. O:men sah katka wa:n yetoyah ne:n tio:panmayo:lmeh wa:n tio:panto:pi:lehmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>Yehwa:n tatsilinia:yah, a:mo t..., a:mo tatsili:nia:ya *fiscal**, tatsili:nia:yah ne:n mayo:lmeh, tio:panmayo:lmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Pero kwalka:n tatsili:nia:yah, kwalka:n, de e:yi *hora** tane:si tatsili:nia:yah ya, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts240">
