        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>kito:kayah *por eso** nejó:n wa:n ihwa:k neli tanehnekiah n' ta:tahmeh wa:n kimattokeh *que mones...**, mokwia ke:meh yo:n ika se: tatapalwia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts350">
