        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>Kito:..., ki..., ki...,</ANNOTATION_VALUE>
