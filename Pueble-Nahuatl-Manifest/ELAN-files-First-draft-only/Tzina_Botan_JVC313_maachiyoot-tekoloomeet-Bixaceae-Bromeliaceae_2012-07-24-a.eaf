        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>Ke:mah, pero miakeh m' *po:pollos** tikchi:wah, miakeh, sake:ra ka:n se: mahtaktio:me:i *po..., pollos** ne:n kichihchi:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
