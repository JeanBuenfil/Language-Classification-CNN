        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>Wa:n i:xmohmoloxtik n' ima:xiwyo, ne: chi:chi:ltik n' itohmiyo, chi:chi:ltik a:chá: n' ii:xko ne: xiwtsí:n. Ke:mah.</ANNOTATION_VALUE>
