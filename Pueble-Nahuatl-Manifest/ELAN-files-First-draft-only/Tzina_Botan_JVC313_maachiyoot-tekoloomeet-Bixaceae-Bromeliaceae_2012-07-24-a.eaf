            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>Wa:n... Te:chtayo:kolia:yah, a:mo te:chnamaki:ltia:yah, te:chtayo:kolia:yah, se: tahtani wa:n te:chtayo:koliah.</ANNOTATION_VALUE>
