        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>ki..., kiki:x..., tikchihchi:wayah n' tehwa:n sake:ra oho:me *ku:cuchillomeh** oso *ma:machetemeh o martillos** ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>Ke:mah, sake:ra oho:me *cada** to:pi:leh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>Ke:mah. Wa:n mayo:lmeh kichi:wah yehwa:n *po:pollos** no: wa:n tehwa:n no: a:kin tik..., kinehnekis to:pi:leh kwali kichihchi:was no: m' *po:pollo** komo kineki.</ANNOTATION_VALUE>
