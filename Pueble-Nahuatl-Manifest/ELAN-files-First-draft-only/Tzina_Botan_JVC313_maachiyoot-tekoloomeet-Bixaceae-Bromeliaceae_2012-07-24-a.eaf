        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>Iteyo se: kikwi, a:mo se: kikwi i..., ixiwyo, soh iteyo. Yehwa tiko:ntekiah. ke:mah.</ANNOTATION_VALUE>
