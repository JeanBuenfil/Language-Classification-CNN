        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>*Bueno** pos ekintsi:n ne:, 'te:chnohno:tsa de yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>machi:yo:t kito:ka:ytiah, se: kowit ata nika:wí:n xola:lpankopa a:mo kachi tei tak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>mochi:wa xa: ne:wí:n tanikwa:kopa, nika:n a:mo kachi tiki:xmatih, pero ne: ke:man kihtowah semi kitatekiwtia:yah, xte:chilwi ke:niwki ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>ikowyo, ixiwyo, ixo:chio, tak no: xo:chiowa wa:n ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Tikihtowa ne:n machi:yo:t iteyo ne:n ika tatapalwia:yah, ¿wa:n yo:n kaha:wia:yah *o** iwki wa:kik?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Yo:n ihwa:k kikwiah n' tikihtowa yo:n kowtet tak aya:mo tei katka n' tapal tein a:man ne: kwesala:n nokta kinamakah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
