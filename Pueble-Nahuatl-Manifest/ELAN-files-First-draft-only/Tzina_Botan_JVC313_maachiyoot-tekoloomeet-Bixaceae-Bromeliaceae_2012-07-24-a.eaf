            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>para moi:xna:miktokeh n' i..., ii:xte:noh moi:xna:miktokeh m' *po:pollos** wa:n ne: ka:mpa ki...,</ANNOTATION_VALUE>
