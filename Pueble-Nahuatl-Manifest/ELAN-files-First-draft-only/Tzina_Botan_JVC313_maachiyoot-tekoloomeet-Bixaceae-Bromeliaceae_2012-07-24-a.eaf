        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Yehwa n' kichi:waltia, *palaciotekiwa:nih**.</ANNOTATION_VALUE>
