        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>A:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Posteki wa:n yehwa i:n nika:n timotahtanihtokeh nochi ne:n i..., n' ixiwyo pané: nikmati pané: a:mo we:lik ne:n para se: kikwi yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>wa:n, wa:n ma:olo:chtik ahko, ikechtan, ma:olo:chtik semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>N' i:ka:n ne: kahkakaltik wa:n tila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>Pos neh a:mo no: *más** niki:xmati sayoh yehwa yo:n kikwih para kowtati:l wa:n nikita ne: xi:ntok iteyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts313">
