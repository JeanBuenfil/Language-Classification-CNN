        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>Pos yehwa yo:n neh a:mo nikmati ke:maniá:n xo:chiowa, neh sayoh nikita iteyo, am...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>*cuando** panxi:ni a ne:wi:n ... se: kita ne:wi:n [mo]te:ma ne:n i..., iteyo pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
