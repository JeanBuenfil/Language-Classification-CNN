        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Wa:n a:mo posteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>Pos yo:n no: posteki kihtowah ka:mpa ii:x, ii:x.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts249">
