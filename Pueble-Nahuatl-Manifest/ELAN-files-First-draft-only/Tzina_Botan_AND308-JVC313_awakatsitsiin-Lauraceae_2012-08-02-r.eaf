            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>A:mo kikwah, yo:n nikita ka:sá: ika nio:nó: chechelo:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>[*por]que** ka:mpa kikwah chechelo:meh nochi kiteteitsah.</ANNOTATION_VALUE>
