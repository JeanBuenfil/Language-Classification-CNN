    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="Eleuterio Gorostiza Salazar">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>*Bueno**, pos ekintsi:n, *este**, na:nah xite:chtapowi ke:ní:w, ne:n, nankichi:wah, ne:n, tahmach.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>kwali 'te:chtapowi:s ke:ní:w, ne:n, se: kichihchi:wa n' tahmach, ke:ní:w se: kipe:waltihte:wa wa:n ke:ní:w ne:n se: ma:tamiti a para se: kinamaka ya se: kami:sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>¿Ka:nachi to:nal mitskwi:lia ne:n tikpe:waltihte:wa n' tahmach wa:n *hasta** tima:tamiti nochi ne:n mokami:sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>¿Wa:n k..., ka:nachi taman, ne:n, tein, *este**, okwilimeh *o** toni, ne:n, xo:chit tikta:lilia, ne:n, tahmachmi:sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Katí:n okwiltsitsi:n tein achto teh, *este**, tikihtowa tikpiaya ne:n tahmach wa:n tik..., tikpoloh, ekintsi:n a:mo tikpia ok. ¿Katí:n okwiltsitsi:n tikimpiaya?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>A:man tikihtowa yankwik *dibujo**, ¿Katí:n okwiltsitsi:n onkakeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>¿Ka:nachi taman kami:sas teh tiki:xmattok tein monamaka nika:wí:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>¿Wa:n, *este**, yo:n, yo:n kachi *más** e..., pati:yoh tein de *colores**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>¿Teh tiweli i:pa tein yo:n se: taman sah *color**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>¿Yehwa tein okachi kikowah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Wehka:w a:mo makia:yah de *colores**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Ta:ká:n teisá: *más** ok tiknekis 'te:chtapowi:s de ne:n, *este**, tahmach.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>Ta:ká:n t'neki tite:chtapowi:s, *este**, pos ke:ní:w, *este**, ke:ní:w kichi:wah n' okseki tilmah tein kikwih siwa:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Babe:roh a:mo tiweli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>Pos, *este**, ka:n n'mati, ta:ká:n, *este**, tikpia ok teisá: 'te:chtapowi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>A:, pos ekintsi:n, *este**, x'te:chtapowi ta:ká:n tikmati ke:ní:w ne:n ta:taman, ne:n, nakwih i:n tahmachkami:sah itech i:n xola:lmeh tein nika:wí: yetokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Mopata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>*Bueno pues, este**, komohkó:n a:mo tikpia ok *más, este**, toni 'te:chtapowi:s de i:n tahmachkami:sah, *pues este**, 'te:chilwi moto:ka:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>¿Ka:nachi xiwit tikpia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>¿Ka:n, ka:ni ne:n tiwa:le:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>*Bueno** pos tasohka:matik miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
