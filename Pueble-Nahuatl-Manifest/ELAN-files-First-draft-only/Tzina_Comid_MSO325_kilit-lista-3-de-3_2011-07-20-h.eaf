        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Komo i:pa yetok n' taktson de witsti pos mochi:wa *cuando** tekitih ya ke:mah panki:sa ya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>ne:n tein sehselik wa:n yehwa n' tikwitih yo:n tein sehseltsi:ni *porque** tein chika:wak ka:n no: oksi ok.</ANNOTATION_VALUE>
