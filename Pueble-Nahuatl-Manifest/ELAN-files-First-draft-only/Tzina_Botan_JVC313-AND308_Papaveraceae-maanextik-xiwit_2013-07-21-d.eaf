        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah pos yehwa no: tehwa:n tikitah ne: ke:masá: neli ki..., kikwitih, ke:meh pilimeh mokokowah, kikwitih wa:n ki..., seki kima:xakwalowah wa:n seki ihkó:n kipante:mah sah, kipanmomotsowah para ki:sa ne:n icho:kilo wa:n para ika kia:ltiah pilimeh ke:meh mo..., ke:meh yo:n tataxistih *o** toto:nikkwih ika kina:ltiah pilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>Wa:n ke:mah kisentetekwinowah ika n' a:ya:t wa:n ke:masá: *cuando, cuando** tamela:wa mokokowa sah, de tataxis toto:nik sah, niman kinina:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Kinina:miki, kina:miki yehwa yo:n. Yo:n tikitah, ke tehwa:n tiki:xmatih ke ma:nextikxiwit.</ANNOTATION_VALUE>
