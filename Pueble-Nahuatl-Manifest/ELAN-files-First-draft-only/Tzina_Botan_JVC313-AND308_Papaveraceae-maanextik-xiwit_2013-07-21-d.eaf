                <ANNOTATION_VALUE>Yo:n kostik ne: i..., ixiwyo wa:n ima:i, *casi** nochi ikowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Yo:n ka:sá: ika se: kita ne:wí:n ihkatok wa:n *siempre** no: kikwih ke:masá: para teisá: ki..., tapalo:l o ... We:noh, para teisá: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
