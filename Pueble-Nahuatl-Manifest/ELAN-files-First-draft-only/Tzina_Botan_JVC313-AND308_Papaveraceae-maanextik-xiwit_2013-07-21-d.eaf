        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>Ke:mah no:. Ke:mah de, de icho:kilo ya poso:ni. Yehwa, ke:mah.</ANNOTATION_VALUE>
