        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>kin ne:n no:, no: nikmati de yo:n ala:wakkowit *de que para** toni yo:n,</ANNOTATION_VALUE>
