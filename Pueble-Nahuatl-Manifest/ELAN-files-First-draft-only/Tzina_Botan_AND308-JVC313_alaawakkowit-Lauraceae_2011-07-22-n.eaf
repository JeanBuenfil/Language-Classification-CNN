        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Wa:niteyo tihti:ltik, kipia ke:meh eskia yo:n tamachi:w, yo:n,</ANNOTATION_VALUE>
