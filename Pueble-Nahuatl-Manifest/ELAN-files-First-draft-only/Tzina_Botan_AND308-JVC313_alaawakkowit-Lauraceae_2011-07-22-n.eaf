        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>kwaltia.</ANNOTATION_VALUE>
