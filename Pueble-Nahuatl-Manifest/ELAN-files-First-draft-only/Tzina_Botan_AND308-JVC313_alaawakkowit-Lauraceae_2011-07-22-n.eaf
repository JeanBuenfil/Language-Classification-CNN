        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Kipa:pata:nkawiah wa:n seki *hasta** kipánxi:i:niah.</ANNOTATION_VALUE>
