        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>Ixwa.</ANNOTATION_VALUE>
