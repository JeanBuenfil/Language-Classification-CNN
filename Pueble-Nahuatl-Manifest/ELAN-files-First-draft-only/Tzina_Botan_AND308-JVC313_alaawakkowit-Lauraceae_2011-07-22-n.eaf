        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>de a:mo n'mati ka:nikawi:ni niki..., n' tahko ne:n moka:wa tein yo:n xiiktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>A:mo n'mati ke:ní:w, a:mo ke:mah n'ta:lia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>a:mo n'ta:lia *cuidado** ke:ní:w, se: kite:nteki, a:mo n'chi:wa *cuenta** ka:nika n' to:nalki:saya:mpa, ka:nika to:nal..., tio:takia:mpa yetoya.</ANNOTATION_VALUE>
