        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>*Hasta** yo:n, se: *vez** ompa nikinahsito ne:ahko,</ANNOTATION_VALUE>
