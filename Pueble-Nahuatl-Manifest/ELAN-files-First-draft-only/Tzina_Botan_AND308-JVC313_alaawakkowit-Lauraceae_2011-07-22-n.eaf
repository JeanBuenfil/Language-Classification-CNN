        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>A:, wa:n pos neh no: nimitsili:ti *de que**,</ANNOTATION_VALUE>
