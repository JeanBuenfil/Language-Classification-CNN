        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>¿Wa:n tima:tami ka:nachi to:nal nochi a?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>Ne:n yo:n kowmimilmeh tikihtowa tikinkwi wa:n, *este**, ne:n tso:tsompa:s, ¿ton kowyo kikwih?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>¿Komimil no: yehwa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>¿Wa:n tso:tsopa:s no: yehwa yo:n kowit?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>Sayoh mah mela:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Aha, ¿Wa:n ne:n ..., ilpikat yeh a:mo kwi:ka pa:ki..., pa:kiyo:t?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>Yeh no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>¿Wa:n a:xka:n ke:ní:w tikita ne:n i:n ilpikameh, mo..., monamakakah ke:meh i:pa *o** ..., ne: wehka:w oso a:mo semi ok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Nochi achi welih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>kwaltsi:n tikinmachtia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>no: kwali a,  ihkó:n a:mo, ma:ski,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Kiowihitah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>Senwehweliwi a nochi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Entó:s moneki ika nehmach. Mah a:mo semi se: yo:lihsiwi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Ne:n ke:man pe:wa tiki:xchihchi:wa kwali tikwi katí:n yeh eski, *este**, ke:meh eski[k], ¿Ton, [ke:]meh toni tiki:xta:lilia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Wa:n ne:n *ara:biah ilpikat**, ne: ¿ke:niwki yeh chihchi:wtok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Yo:n tikihtowa ki:xpehpentiowih ¿ompa tein kitehte:kah ompa sah 'kwitiowih?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>¿Mah tikihto:ka:n xa: okachi owih yo:n tein teh tiweli?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>¿*Bolsas** tein yo:n i:n Cuesalan kininamakah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>Aha:, yehwa yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>Wa:n ekintsi:n se: wi:pi:l ¿Ke:meh ka:nachi ika t'namaka?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>¿Wa:n ilpikat?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>Okachi pati:yoh ilpikat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>¿Wa:n nika:kwí:n teh tikita ke okachi kiwelitah yo:n ilpikat oso no: kikwih i:ksá: de yo:n ara:bi:ailpikat oso ¿ka:ni tokni:wan nemih tein okchikikwih yehwa yo:n *ara:biailpikat**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>A:, nika:n San Miguel no: nankikwih?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>A:mo a:kin mitsmachtih pos teh ilpikat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>A:, pos, ma..., kwali tikihto:skeh ke yo:n ilpikat a:mo namoa:xka. Haha, a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Wehka wa:le:w wa:n namehwa:n ne: wehka:w [nan]kikwiah yehwa ara:biah nankikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>Pos pané: yehwa sah de ne:n tahkit, yehwa sah ne:n tikihtowa, ne:n, 'te:chtapowia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>Welis sepa 'te:chilwi:s ke:ní:w moto:ka:y,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>Ka:nachi xiwit tikpia wa:n ka:ni tiwa:le:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>¿Ka:nachi xiwit tikpia?</ANNOTATION_VALUE>
