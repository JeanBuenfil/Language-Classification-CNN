        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>Mm, *porque** weyak, de o:me ma:it wa:n tahko ki:sa, mm. Wa:n yehwa yo:n kipati:yo:tia.</ANNOTATION_VALUE>
