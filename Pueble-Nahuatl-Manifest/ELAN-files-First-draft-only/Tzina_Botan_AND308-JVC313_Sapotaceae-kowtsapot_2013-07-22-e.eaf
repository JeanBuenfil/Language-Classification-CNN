        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>Yehwa yo:n kine:xtia *que** chika:..., yo:n a:mo se: kita, yo:n a:mo kip..., a:mo kostia ipanko</ANNOTATION_VALUE>
