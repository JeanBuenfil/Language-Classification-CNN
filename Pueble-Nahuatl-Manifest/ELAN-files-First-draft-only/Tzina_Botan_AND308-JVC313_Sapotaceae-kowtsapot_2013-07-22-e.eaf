        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>Niki:xmattok yo:n kostik wa:n yo:n chi:chi:ltik.</ANNOTATION_VALUE>
