        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>A:mo nikita neh ke:masá: pos no: nikto:ktok ne:wí:n, pero a:mo nikmati neh tsikilitsitsi:n, wehka:wa tak, ma..., a:mo n'mati ke:maniá:n mochi:wa, yo:n a:mo a:mo, a:mo tikmatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Pos...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>Ta:kih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>Wa:n yo:n ka:mpa xo:chiowa ompa, ompa pe:wa mo..., moskaltihtiw tsikitsitsi:n. tsi:n..., tsi:nkohkopi:ni. Pero yewaltik i:n mochi:wa ke:meh ko:ntsí:n ne:n yewaltik n' i..., n' its..., tsi:nkohkopi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>E:yi xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>A:h.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>Moskaltihtiw ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>Para wehweia wehka:wa, e:yi xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>Pos yehwa yo:n a:mo se: kimati ki:ní:n, sa..., sayoh se: kita *que** onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>¿Wa:n nochi ihkó:n de n..., de e:yi taman, de e:yi taman *o de** n...? Nochi iwki, nochi iwki ne: wehka:wa moskaltia para...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>*Casi de** e:wi n' ixo:chiyo ompa ne:n ts..., tsi:nkopi:ni a ne:n n' itsi:nkaxyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>wa:n we:tsi a wa:n ke:mah moskaltihtiw ya ne:n..., moskal..., tsikitsitsi:n tsapotsí:n. Ihkó:n moskaltihtiw wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>Pos neh niki:xehekowa seki *hasta** xa: no: wetsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>Ka:ns ika se: kita tata:mpa no: xi:i:ntok ne:n tsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts697">
                <ANNOTATION_VALUE>Pos, pos xa: okwiltsitsí:n koli:niah wa:n *de repente o, o** tehsá:, *por eso** pawetsi wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>¿Wa:n yo:n no:, no: k..., no: kwaltia para ne:n, ne:n kali?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>kwaltia n' tein we..., tein weh..., tein wehweikowit ke:mah kwali kitsaya:nah no: kiki:xtiah ne: *viga para** kale:walmeh, taihtiyo:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>Eti:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>Pos yo:n no: nikmattok para ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>kowtati:l kikwih wa:n para nochi n' i..., n' imahma:yo, ne:n *ramitas** nochi kwaltia para kowtati:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>soh *que** yo:li:k ne:n wa:ki wa:n ka:mpa seki se: kitamo:ta pos itsmoli:ni no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts737">
                <ANNOTATION_VALUE>A:it ki:ní:n mochi:wa, ne: monalwayo:tia ka:mpa ta:lpan hkó:n tech tahsol se: kita:lia pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts738" TIME_SLOT_REF2="ts739">
                <ANNOTATION_VALUE>seki selia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>*Solamente** ka:mpa tekwa:ko se: kita:lia pos wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>Pero yo:n no: kwaltsi:n tata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>De...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>de wa:ki a:mo semi eti:k, pero ke:meh de xoxowik ihkó:n ye:ketiktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>Porin tila:wak no: n' ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts762" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>Tila:wak wa:n no: se: ki..., kiki:xtiliah n' ie:wayo ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>de n' tohtoma:wak se: kitehteki pos no: ki:sa ne:n, no: pochiktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts772" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>No: pochiktik wa:n seki kwaltsi:n tapa:ni wa:n seki a:mo nochi ye:ktapa:ni, tak porin ka:mpa kipia ne:n iitsmol,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>ka:ns ika seki se: kita ne:n ihitsmoleh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts778" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>Wa:n seki kwaltsi:n mehmela:wak, seki nió:n no: wel se: tehko para se: kitekis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts785">
                <ANNOTATION_VALUE>Wa:n seki kwaltsi:n se: panki:sa ka:mpa ihitsmoleh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts787" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>pos ompa se: moketstiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts791" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>Ompa se: moketstiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts802">
                <ANNOTATION_VALUE>Wehkapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts807" TIME_SLOT_REF2="ts810">
                <ANNOTATION_VALUE>We:wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>Wehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>Wa:n no: tihtila:wak n' ie:wayo tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts829">
                <ANNOTATION_VALUE>*Porque** seki kwaltsi:n ne: kahkamohtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>Kahkamohtik ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>entó:s se: kki:xtilia n' e:wat moka:wa sayoh n' inakayotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts844" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>A:mo okwiloh. A:mo telwehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>A:, mohmoloxtik kwaltsi:n a:mo, a:mo..., wa:n kwaltsi:n no: tsope:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts858">
                <ANNOTATION_VALUE>Ye:kkwaltsi:n, yo:n teltsope:k yo:n ne:..., n' tsapotsí:n teltsope:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts863">
                <ANNOTATION_VALUE>Ke:mah, a:mo, a:mo kah..., a:mo kahsi iwa:n ke:meh xokotsí:n a:mo *igual de** tsope:k wa:n ne:, ne: kwowtsapot teltsope:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts869">
                <ANNOTATION_VALUE>Teltsope:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts874" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>Pos no: kwaltsi:n we:lik de n' tsope:k no: se: kiwe:lilia sayoh *que** te:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts878" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>kihtowah seki de komo se: kitelkwah ihkó:n no:, no: te:a:miktih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts882" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>Te:a:miktih nijó:n, te:amiktih de tsope:k pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts886" TIME_SLOT_REF2="ts889">
                <ANNOTATION_VALUE>wa:n seki tikihtowah seki a:mo tsope:k, seki a:..., a:sese:k tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts895" TIME_SLOT_REF2="ts897">
                <ANNOTATION_VALUE>Pos neh nikita no: seki de n' yo:n tikekowah seki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>a:chi:petik no: a:sese:k *porque de que** aya:mo semi kwali yoksi tak *o** a:.., selik..., selikyoksi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts904" TIME_SLOT_REF2="ts907">
                <ANNOTATION_VALUE>Pero sepa chika:waya pos tsope:k ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>Pos kwaltsi:n no: *de que** nika:n timona:mikih wa:n nochi kwaltsi:n timotapowiah, *siempre** timona:miktinemih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts920" TIME_SLOT_REF2="ts921">
                <ANNOTATION_VALUE>pos nochi tikitah yo:n kowtsapot oso n' okseki yo:n chi:chi:ltik *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts922" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>ekintsi:n neh nik..., no: nikwelita tine:chilihtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts926" TIME_SLOT_REF2="ts929">
                <ANNOTATION_VALUE>pos miak taman tiki:xmati, de na:wi taman *o** e:yi taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts930" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>pos kwaltsi:n no: ke:masá: ne:wí:n pos no: kwali tine:chne:xtili:s ne:wí:n kowit, sepa timona:mikiskeh itech ohti *o** tikitaskeh ne:wí:n *o** xa: tikto:ktos, tikihto:s ne:pa nikto:ktok yeh i:n kowtsapot,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts940" TIME_SLOT_REF2="ts943">
                <ANNOTATION_VALUE>para ka:n wetstok se: pos kwali tik..., tikahokwih wa:n timowi:kiliah mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts944" TIME_SLOT_REF2="ts946">
                <ANNOTATION_VALUE>tik..., k..., mah yoksi wa:n tik..., tikyekowah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts950" TIME_SLOT_REF2="ts952">
                <ANNOTATION_VALUE>Entó:s ompa tik..., tikneltokah ya ika we:lik nijí:n kowtsapot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts954" TIME_SLOT_REF2="ts956">
                <ANNOTATION_VALUE>Tsope:k. Pos i:n semi kwaltsi:n timo..., timonohno:tsah wa:n timotapowiah, nejó:n a:mo *mal**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts958" TIME_SLOT_REF2="ts961">
                <ANNOTATION_VALUE>*Siquiera** mah tik..., mah tikneltokaka:n wa:n mah tikitstia:ka:n *de que** ki:ní:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts962" TIME_SLOT_REF2="ts964">
                <ANNOTATION_VALUE>seki kwali para pahti n' i..., n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts968" TIME_SLOT_REF2="ts969">
                <ANNOTATION_VALUE>Ke:meh kintsi:n nochi tik..., tikitakeh ya katí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts970" TIME_SLOT_REF2="ts971">
                <ANNOTATION_VALUE>kwaltia para ne:n nemowtil, katí:n para ne:n ke:meh i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts972" TIME_SLOT_REF2="ts974">
                <ANNOTATION_VALUE>tikpiah kone:meh oso se: yehwa, pos nochi n' *antes** nochi mopahtia:yah ika ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts976" TIME_SLOT_REF2="ts978">
                <ANNOTATION_VALUE>tokni:wa:n. Entó:s kintsi:n nochi ti..., timomati:ltiah, ke:meh kintsi:n no: nikmati, no: tikmattok n' teh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts980" TIME_SLOT_REF2="ts983">
                <ANNOTATION_VALUE>Pos ihkó:n kwaltsi:n ti..., ti..., ti..., timoliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts990" TIME_SLOT_REF2="ts992">
                <ANNOTATION_VALUE>Wa:n yo:n iteyo semi teltila:wak wa:n ye:ktakwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts994" TIME_SLOT_REF2="ts997">
                <ANNOTATION_VALUE>Yo:n takwa:wak, komo se: mometskalakilih pos no: tak te:tekis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1003">
                <ANNOTATION_VALUE>de tapa:ni a ne:n ie:wayo moka:wa sayoh n' iteyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts1005" TIME_SLOT_REF2="ts1007">
                <ANNOTATION_VALUE>Wa:n yo:n iteyotsi:n yehwa ya kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts1009" TIME_SLOT_REF2="ts1011">
                <ANNOTATION_VALUE>Yehwa ya kikwih, a:mo, a:mo kikwih ne:n ipa:ne:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts1013" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>E:ktakwa:wak yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts1018" TIME_SLOT_REF2="ts1020">
                <ANNOTATION_VALUE>Ka:ns ika se: kita tapa:ni wa:n komo se: metsiwki pos se: momets..., metstekis, te:metskokoh, se: imetsko kalakis no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609" TIME_SLOT_REF1="ts1022" TIME_SLOT_REF2="ts1025">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610" TIME_SLOT_REF1="ts1026" TIME_SLOT_REF2="ts1028">
                <ANNOTATION_VALUE>Pos neh nimono:tsa Anastacio Nicolás Damián. Niwa:le:w ne: San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612" TIME_SLOT_REF1="ts1032" TIME_SLOT_REF2="ts1034">
                <ANNOTATION_VALUE>A: *bueno**, tasohka:matik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
