                <ANNOTATION_VALUE>wa:n a:mo semi telwehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
