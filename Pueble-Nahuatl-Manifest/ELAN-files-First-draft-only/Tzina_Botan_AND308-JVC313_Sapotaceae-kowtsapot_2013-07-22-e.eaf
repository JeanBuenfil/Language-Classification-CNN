        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>oso chi:chi:le:wi, yo:n a:mo se: kimati yo:n, pero sayoh se: kita n' ima:xiwyo kite:..., kimaka *seña**,</ANNOTATION_VALUE>
