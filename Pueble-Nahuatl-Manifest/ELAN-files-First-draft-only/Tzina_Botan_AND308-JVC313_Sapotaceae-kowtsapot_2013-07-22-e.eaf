        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>chika:wak a n' tsapot wa:n, wa:n niman se: kita *que** nehnextik a n' tsapot eski wa:n komo se: kipehpen sake:ra o:me, e:yi a ne: ta:lpan,</ANNOTATION_VALUE>
