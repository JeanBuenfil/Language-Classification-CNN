        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>no: kkwiah para ne:n teihsá: ihkó:n ke:meh eskia i:n to...,</ANNOTATION_VALUE>
