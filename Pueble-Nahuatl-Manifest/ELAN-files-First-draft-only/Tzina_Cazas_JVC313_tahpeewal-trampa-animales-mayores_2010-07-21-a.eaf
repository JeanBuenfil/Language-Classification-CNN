    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="Eleuterio Gorostiza Salazar">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>*Bueno** pos ekintsin kwali, *este**, 'te:chtapowi:s ke:ní:w, *este**, kwali se: kinkwi ne:n okwilimeh tein nika:wí:n nemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>¿Kwali 'te:chtapowi:s ke:ní:w se: kichihchi:wa i:n tahpe:wal, ke:ní:w se: kipe:waltia *hasta que** se: ma:tami?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>Wa:n i:n nochi, ne:n, kowtsitsi:n tein se: kikwi, ¿ton kowyo, ne:n, se: kikwi? ke:meh ..., *bueno** nika:n t'te:chto:ka:ytilih ta:taman ito:ka:y, ¿ton kowyo, ne:n, kwali se: kikwi para i:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>¿Wa:n i:n tikilia tatsomo:talo:ni, yeh ton kowyo se: kikwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>No: tikihtowa nika:n moneki sake:ra mahtak oso kachi pano:s mahtak n' tet. ¿Katí:n tet i:n se: kikwi, katí:n eski?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
