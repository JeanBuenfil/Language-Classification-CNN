        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Itech yo:n kowit motsakwili:ti ompa wa:n ta:ká:n mokech..., mokechkwi:ltih ompa moka:wa, miki niman.</ANNOTATION_VALUE>
