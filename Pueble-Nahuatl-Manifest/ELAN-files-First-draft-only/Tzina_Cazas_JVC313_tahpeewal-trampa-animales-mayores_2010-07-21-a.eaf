        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Tein *hora** yahki se: koli:ni:to wa:n se: mokechkalaki:to iwa:n, pos ompa moka:wah ompa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
