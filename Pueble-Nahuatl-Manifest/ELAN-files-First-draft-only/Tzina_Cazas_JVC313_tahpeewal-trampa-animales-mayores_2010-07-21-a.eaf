        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Tai:kan tikchi:was wa:n ke:mah tikwi:pa:na ya n' kola:ltsi:n ihkó:n, kwaltsi:n tikilpia ke:meh a:mo,</ANNOTATION_VALUE>
