        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>de xokoya porke de, de sepa wa:ki a (i)hkó:n xokoya (i)hkó:n wetsi ne:n i, ie:wayo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>wa:n de pala:nia n' kowit komo wetstok ma:s ihkwi:n toma:wak (en)to:s ne:n wa:ki wa:n pala:ni pero moka:wa n' i(y)o:lo ihkón ye:ktakwa:wak n' i(y)o:lo wa:n ye:keti:k ne:n i(y)o:lo kostik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>ma:s se: kitehteki (i)ka *a:chah** pero 'kehkepa n' *a:chah** 'kehkepa oso *mache:teh** 'kehkepa porke ye:ktakwa:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>*por eso** kiliah ma:tankehxiwit yehwa yo:n, yehwa yo:n kiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>nijó:n pos nochi ta:taman ke:meh (e)kintsi:n timonohno:tsah pos seki (ih)ko:ni wa:n nochi ta:taman tik, tikto:ka:ytiah pero *mi:smo** se: taman sah, se: taman, se: taman sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>Se: taman sah n' kowit. a: we:noh (compa:dri:toh). A: we:noh. .</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
