            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Ke:mah, ke:mah, ye:kwitsyoh nochi nikilia neh, ke:mah.</ANNOTATION_VALUE>
