        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>¿Ne:n icho:kilo yehwa i:n, yehwa i:n tehtsonkilit icho:kilo? A:, no: kwali, no:... A:, pos neli onkak, onkak de mia..., ke:mah onkak de miak taman pahti mah se: mota:lili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Ke:mah, pos pané: yehwa sah neh ihkó:n tein, tein tine:chtapowih kit, a:mo teh *más** nik..., wa:n a:mo nikmati ox onkak miak taman, pané: i:pa no: sentaman s...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>Ke:mah *porque** niki:ita neli i:pa sentaman sah wa:n neli *de que** wa:ki ata nikilia neh, ta: yo:n *cuando** wa:ki a no: nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>no: mochi:wa ya mahyá: yo:n, se: i..., se: mokaya:was yo:n ipanko mahyá: yo:n eskowit mochi:wa ata n' ipanko. Ke:mah, pero de wa:kik a. Ke:mah, ye:kte:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>Ke:mah, *de que** wa:kik a ki:sa ya no:. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>A:mo teihsá:, yehwa ya n' tein ika timonohno:tskeh. Neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
