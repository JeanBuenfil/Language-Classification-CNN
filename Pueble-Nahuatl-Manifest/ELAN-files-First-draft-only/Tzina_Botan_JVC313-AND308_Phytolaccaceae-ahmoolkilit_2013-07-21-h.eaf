        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Timomati:ltiah nehjó:n kiltsi:n, yo:n no: we:lik, kim..., kia:manah wa:n ki..., kima:pa:tskah wa:n se: kikwa tama:pa:tskal ihko:ni de ke kita:liah tepitsi:n chili:toh *o** chi:ltekpin *o** teisá: ihkó:n de *verde** wa:n we:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
