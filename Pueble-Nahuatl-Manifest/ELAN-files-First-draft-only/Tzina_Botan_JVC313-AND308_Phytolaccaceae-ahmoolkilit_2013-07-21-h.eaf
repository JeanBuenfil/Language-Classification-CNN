        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Pos yo:n kwaltsi:n chi:chi:ltik nochi n' i..., imetskowyo nochi *hasta** ne:n ima:ko, kwaltsi:n ma:pehpetaktik *hasta** nalwat. A: ima:yo ihkó:n kwaltsi:n moma:yo:tia, kwaltsi:n moma:yo:tia, kwaltsi:n tatampa, yo:n tatampayohtok no:.</ANNOTATION_VALUE>
