        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>Kowtahwa:wkilit kiliah pero a:mo se: kimati ke:ní:w. Yo:n kachi wehkapantia tepitsi:n.</ANNOTATION_VALUE>
