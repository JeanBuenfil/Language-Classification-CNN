        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n neh a:mo nik..., a:mo nikmati n'... Pos para ne:n ihkó:n tiktekiah ne:n kowmeh, taihti:yo:meh, nochi ne: ta: itsmoli:ni nochi yo:n itsmol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Tein toma:wak, seki tein wehwei pos a:mo no: kwaltia, no: tel..., yo:n ye:keti:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Ye:keti:k, tila:wak i..., ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>Tila:wak wa:n pos yehwa yo:n pos neh a:mo nikmati taihtik ne:n, seki kihtowah ke kitapa:nayah wa:n ki..., kikwa:yah, kikwa:yah pero yo:n kihtowah ne:n sioh para se: mikis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>A:mo, a:mo se: kimati ox we:lik wa:n yo:n, pos yo:n kikwih *solamente** ke:meh ekintsi:n ne:n ki..., kite:mo:tih ne:wí:n tokni:wa:n ika tama:chihchi:wah yo:n ne:n, yo:n kita:liah ki..., kikwa:ta:liliah se: kowtsí:n wa:n yehwa yo:n ne: kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Pero *antes** ihkó:n ne:n sayoh tikitayah ne:wí:n ke:meh i:n tikowtahnemiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Wa:n a:chá: no: tikmattos ta: ne:h ... No:, no: tinemia ne:wí:n kowtah, ka:sá: ika ne: ompa 'kwahtokeh sayoh pe:someh wa:n ta:lpan ne: xi:ntok miak wehwetstok wa:n yo:n se: kimowilia:ya se: imetsko kalakis *porque** xahxakachtik, xahxakachitik. Te:mestkokowa *porque** kwaltsi:n ne:n xahxakachtik ihkó:n ke:meskia yo:n ilpitok ihkó:n wa:n yo:n oso paniá:n se: taksa ya de n', de n' aya:mo, ihkó:n ki:saya ie:wayo, a:mo tapa:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>Takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>*Solamente** de yo:n wehka:wak wetstok ihkó:n ipaniá:n se: taksaya, yo:n xama:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Xama:nia wa:n pos de i:pa pa:tia ya no: taihtik ne:n i..., iteyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Wa:n i:n seki pos no:, we:noh i:n de selik ok de ki:sa, *apenas** n' ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>Takwa:wak, ma:ski paniá:n se: taksa, a:mo, a:mo xama:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Takwa:wak, takwa:wak wa:n yehwa ne:n yo:n pos, yehwa yo:n ne: tik..., tikitayah nehjó:n ka:la:tsapot pos semi no:, no: kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>Ke:meh i:n para kowit no: pipi:nik ne:n kalkowit wa:n kwaltsi:n n' i..., itapalo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>kwaltsi:n itapalo ne:n ki..., *moradito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Wa:n yo:n ma:ski se: kihtowa ne: wa:kiti, xa: tatas, pero yo:n a:mo tataya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Ihkó:n *hasta** se: kitehtekia ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>Pos ihkó:n ne:n *moradito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n neh nik..., a:mo nikmati ox xa: no: kitekia para teisá: pero neh nikitstinemia ihkó:n i:pa ihkó:n yo:n seki ihkó:n tohtoma:waya wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Se: tanawa:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Wa:n no: tehtetsi:ltik, a:mo semi mela:wak seki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>Tein ihkwi:ntsitsi:n ne:n tohtoma:wak yeh yo:n kwaltia para kale:wal wa:n para taih..., taihti:yo:t no: kwaltia pero ne: tate:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>Para i:n de n', para ihkó:n de wehwei no: moi:xpilowa ya wa:n tak ne:, ne: a:mo kwaltia ok, ne: mochihkolowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Mochihkolowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>Wa:n no: ke:masá: ahkono: mota:lia ne:n, motahchihchi:wia ne:n tak ne: pe:soh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Ta: tak itapahsol tak kite:te:mo..., nochi yo:n miak tahsol, kima:teki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>Pos no: tikitani ompa ne: oso chechelo:t no: kita:lia ne:n i..., icha:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>Ompa kichihchi:wa kwaltsi:n, ompa kite:te:ma nochi n' tahsol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>Ta: tak yo:n nochi kiteh..., kitehte:molia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>Kitehtemolia wa:n kima:nelowa wa:n ompa kichihchi:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>Ompa kochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>Ompa kochi, ompa ne:n ke:masá: se: kahsia ne:n ahko ne:nentok ne:n pe:soh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Ompa ahko ne:nentok wa:n yehwa yo:n ne: se: ki..., se: kitemowia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Panwetsia wa:n se: ki..., se: kikwia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Wa:n ekintsi:n pos nehjó:n ompa ne: ki..., ke:meh ompa ne: talwiah ka:la:tsapotah *porque** nochi ompa ne:n, miak seki tsikitsitsi:n ihkó:n ne: se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>Wa:n ompa *más** tik..., no: ke:masá: te:chyo:le:waya mah tikwitih yo:n, yehwa ya n' kalkowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>Yeh tikonkwiah pero yo:n se: kwa:lkwi ihkó:n achi ihkwí:n nehjó:n eti:k, eti:k *porque** ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>*Más** de ihkó:n de achi toma:wak wa:n weyak ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>pos nehjó:n *más** eti:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>*Más** eti:k de n' toma:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>No:, no: se: ki:xehekowa:ya de se: kitekia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>pero tein achi pitsa:wak ke:meh se: kixi:ko:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>Ke:meh se: kixi:ko:s pos nehjó:n, pero no: teltoma:wak pané: te:chkokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>Te:kechkokoh wa:n pos a:mo no: se: taxi:kowa ne: se:, se: kwa:lkwi wa:n de achi pitsa:wak pos no: kwaltsi:n se: kimachilia, no: kwaltsi:n se: kwa:lkwi, a:mo, a:mo teleti:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>A:mo semi eti:k wa:n pos yehwa sah neh nik..., nikmati de yo:n ka:la:tsapot ne:n tikiliah. Neh niki:xamti sayoh se: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>Se: taman de yo:n wehwei mochi:wa iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>Wa:n komo tiki:xmati ne:n tsi..., oksé: tikita n' iteyo pos yo:n, yo:n oks..., no: se: taman eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>Xa:, xa: oksé: taman ompa, xa: se:..., seko sah ihkatos yo:n kowtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>Ompa *casi** moma:nelowa ya ne:n i..., iteyo, moma:nelowa ya, ompa seko sah ne:n wetsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>Pos ekintsi:n miak mote:ma ompa ne:wí:n wa:n seki kikololowah ihkó:n, kikwitih. Ekintsi:n a:mo ma:wilowa ok yo:n i..., iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>A:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Ompa ne:wí:n ki..., kite:m...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Pos ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>A:, na:wi tomi:n se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>Pos yehwa yo:n kihtowah ke kixta:wah na:wi tomi:n se:..., se:tsi:n. No: para se: kwa:lkwis no: tak eti:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>A:, tikine:xtilih ka:n tikwito yo:n ka:la:tsapot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>A:mo tikwito ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>A:, pos nehjó:n ta: ki:xmattokeh ekintsi:n *porque** ekintsi:n nochi kololowah nehjó:n, ne: ke:man a:mo tikmatiah ox kwaltiah para se: tama:chihchi:walis yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>Pero ekintsi:n pos nochi kinemilihkeh kwaltsi:n no: tokni:wa:n ne:n, pos nochi welih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>Wa:n yeh yo:n kwaltsi:n, niman kihtowah pos ekintsi:n tikte:mo:tih yah ka:la:tsapot iteyo, ne: tik..., tikitatih ne: xa:, xa: tikahsiskeh ne:n ka:la:tsapot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>Pos no: kin..., nehjó:n pos ekintsi:n no: te:ch..., te:chmatiltiah ya ne:n tokni:wa:n seki:n ke kwaltia pos wa:n tehwa:n pos tiki:xmattokeh sayoh iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>A:mo tikmatiah ox kwaltia ne:n i..., para se: tachihchi:walis ke:meh i:n tama:chihchi:walis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>Pero ekintsi:n nochi ne: ti..., ti..., nika:n timonohno:tstokeh, nochi timomati:ltiah de ke ke:ní:w de yo:n kwaltia de yo:n ka:la:tsapot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>Yo:n ka:la:tsapot semi kwaltsi:n ne:n *morado**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>Nochi *morado**. Ke:mah no: mora:dohtia wa:n no: achi wehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts568" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>Pero yehwa yo:n nimitsilia ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>Ke:meh chi:chiwala:yo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>Kahkana:wak, yo:n neh a:mo, a:mo no: ke:man tikita ke:niwki ixo:chiotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>Ox chi:chi:ltik oso ista:k, osokostik. Pos no: *igual** neh a:mo ke:man nikita ne: mah, mah niki..., nikahkoita mah xo:chioto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>Neh nikita sayoh iteyo ne: mopihpilowa ne:n, nehjó:n xohxoxoktik, ke:masá: se: kita tsikitsitsi:n wa:n sepa se: yowi se: kitati wehwei a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>Wa:n de wehwei a seki ne:n ta:lpan ya ne:, ne: wehwetstok, xi:ntok pero a:mo, a:mo tik..., a:mo tikmatih yo:n ox ise:lti tak de, de xokoya, xa: ise:lti ki:sa ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>*Porque** moka:waya sayoh yo:n pané: tsitsikiltik i..., iteyo se: kita, pantsitsikiltik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>Wa:n yo:n a:mo, ma:ski take:s ihkó:n se: kita, se: moxola:wa, a:mo se: wetsi, te:tsakwilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>Te:tsakwilia pero de ihkó:n kipia n' ie:wayo, nehjó:n se: moxola:wa sayoh para ika se: westi *porque** achi alaktik ne:n i..., iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>Inakayo, ne:, ne: i..., ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>Pero yehwa yo:n ne:n de ie:wayo tak pala:ni, de xokoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts621">
                <ANNOTATION_VALUE>Pos yo:n se: kimowilia porin ika se: wetsis, ta: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Ka:sá: ika te:ntok sikie:ra ma:kwi:l *o** chikwase:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>*O** chiko:me pos ompa ne: nochi yetok ke:masá: ompa se:, paniá:n se: taksaki ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>Ka:mpa i:x..., i:xtake:s ihkó:n, pos se:, se: moxola:wa wa:n se: wetsiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>Se: wetsiti wa:n niman se: kihtowa pos se:, se: mometskokowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>Ke:mah, yo:n ... Yeh yo:n ne:n kowtet neh no: k..., nikmattok sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>Pos xa: ompa ta:, xa: ompa *cer...** ompaka se: ka:m..., xa: a:mo wehka yetos ne: *matita** wa:n de panxi:ni a nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>*O** xa: yehwa:n pe:sohmeh kipanxi:niah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>Wa:n moma:nelowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts666">
                <ANNOTATION_VALUE>Mo..., mosenechikowa ya ne:n, ne:n kowtet wa:n ompa ya tak ne: xokoya wa:n ompa ne: wetstok a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts671">
                <ANNOTATION_VALUE>Ke:mah wa:n neh yehwa sah tein nik..., nikmati ne:n de yo:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>Yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>Pos neh kwali tine:chili:s ne:n moto:ka:i, ne: ke:ní:w timono:tsa wa:n ka:n tiwa:le:w, kwali tine:chili:s nehjó:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>Pos nehwa nimono:tsa Anastacio Nicolás Damián, no: niwa:le:w San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
