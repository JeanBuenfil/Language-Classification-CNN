                <ANNOTATION_VALUE>Pos yo:n nikita ne:wí:n no: kwaltsi:n nextik ie:wayo wa:n taihtik tein se: kixihxi:ma kwaltsi:n *moradito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
