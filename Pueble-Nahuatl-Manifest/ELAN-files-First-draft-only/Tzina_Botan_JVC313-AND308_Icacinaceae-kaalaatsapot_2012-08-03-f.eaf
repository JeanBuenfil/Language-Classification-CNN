        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>Pero *hasta** taihtik ihkó:n *moradito**, kwaltsi:n ne:n ke:meskia ti:ltik wa:n yo:n a:..., a:mo ki:sa.</ANNOTATION_VALUE>
