                <ANNOTATION_VALUE>Pero a:mo ke:man nikitas de ke:ní:w mah, mah xo:chowa, nochi nikita ne: pihpilkak i..., iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
