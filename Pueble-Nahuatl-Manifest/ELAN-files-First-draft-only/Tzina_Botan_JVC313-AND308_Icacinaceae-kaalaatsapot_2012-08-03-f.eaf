        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Pos yo:n nehjó:n de se: kitapa:na ihkó:n a:mo, a:mo kipia iyo:lo.</ANNOTATION_VALUE>
