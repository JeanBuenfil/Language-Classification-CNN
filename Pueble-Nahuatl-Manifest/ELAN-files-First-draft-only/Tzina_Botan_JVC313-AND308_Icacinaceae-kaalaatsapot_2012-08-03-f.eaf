        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Yo:n *hasta** wa:kik ihkó:n tatapa:n, ne:n *moradito**.</ANNOTATION_VALUE>
