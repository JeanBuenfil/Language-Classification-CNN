        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>Yo:n de mihmimiltik wa:n yo:n de n' eskina:doh kiliah, yo:n nika:n kipia ira:yah wa:n nika:n no: kipia ira:yah.</ANNOTATION_VALUE>
