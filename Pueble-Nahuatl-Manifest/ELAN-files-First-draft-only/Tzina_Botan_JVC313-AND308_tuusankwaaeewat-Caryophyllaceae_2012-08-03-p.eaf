        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Wa:n ke:meskia yo:n nehjó:n e:wititehko ihkó:n nochi.</ANNOTATION_VALUE>
