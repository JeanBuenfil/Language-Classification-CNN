        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n neh nik..., no: nikmattok de yo:n pero a:mo nikmati no: neh ke:maniá:n nehjó:n xo..., xo:chiowa.</ANNOTATION_VALUE>
