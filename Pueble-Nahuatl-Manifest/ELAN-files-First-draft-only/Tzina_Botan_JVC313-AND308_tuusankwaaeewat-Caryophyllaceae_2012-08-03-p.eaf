        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Xi:kawi a wa:n de yo:n xiwtsi:n kimaniliah ke:masá: iwki ne: mo..., mo..., a..., tamati:ya ya, mm. Tamati:ya ya ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Tamati:ya ya nochi ne:n ka:mpa oli:niah.</ANNOTATION_VALUE>
