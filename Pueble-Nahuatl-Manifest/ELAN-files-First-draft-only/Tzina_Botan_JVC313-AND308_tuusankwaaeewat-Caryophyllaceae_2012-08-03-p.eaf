        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>Pos yehwa yo:n ne:n, pos neh no: nik..., niki:xmati tepitsi:n yo:n tu:sankwa:e:wat, kiliah tu:sankwa:e:wat *porque** kwaltsi:n ihkó:n mowi:wila:na wa:n nalwayowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>Yo:n nalwayowa wa:n pos no: nik..., nikita ne:wí:n no: onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Ka:mpa achi ne:n ihkó:n, ne:n achi yema:nik n' ta:ltsi:n ompa moso:sowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Ompa moso:sowa yo:n [tusa:n]tankwa:e:wat kiliah wa:n pos no: nite:kakilia:ni ne: ke:man ke pos no: kwali pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>kwaltia para pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>Yo:n ke:meh moliah wa:n no: nikmattokka ke:meh yo:n tine:chilihtoya de ke *cuando** mokoko:sneki se:, oli:ni se: siwa:tsi:n ihkó:n ika ne:n se: kone:tsi:n pos kima..., *o** ke:masá: teisá: kele:wia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Pos yehwa yo:n oli:ni wa:n yehwa yo:n 'kwitih wa:n pos no: seki te:chilia:yah ke:meh ihkó:n seki ke kima:xakwalowa:yah wa:n kin..., kin..., nika:n kinta:lilia:yah iniyo:lpan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Wa:n no: kin..., kintai:ltia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>Wa:n ihwa:k ne: seki no: kita:lilia:yah kit iwa:n ne:n pimie:ntah pero a:mo se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>Wa:n no: nikmati yo:n *cilantro** yo:n tein wehwei, wehwei yo:n witsyoh kihtowah ke no:, no: iwa:n kita:lilia:yah, xa:, xa: tikmati no: de ke yo:n kita:lilia:yah iwa:n, kisenma:nelowa:yah para kintal..., kintai:ltia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Wa:n sepa ke:meh ne:n, ke:meh i:n ka:ltsi:n ki:xtilia:yah na:wi, ne: kalwi:ch, a: pos tikmattok no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Kalwi:ch ki:xtilia:yah wa:n kisema:nelowa:yah, kimolo:ntia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
