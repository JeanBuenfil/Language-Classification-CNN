        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>Pos yehwa yo:n neh nik..., niki:xmattok no: nehjó:n o:me taman sah.</ANNOTATION_VALUE>
