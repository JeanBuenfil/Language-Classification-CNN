    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Celina González Nazario" TIER_ID="Celina González Nazario">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>We:noh, ekintsi:n timonohno:tsatih de yo:n xa:lxokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>Onka..., onkati a i:n a:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>Ka:sá: ika onkak a yo:n kowti..., onkak ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>Nika:kwí:n tehwa:n aya:mo ya nehjó:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Aya:mo ya chika:waya, chikawayati ok i:n to:nalmeh, ya:ti a de... Xi..., xi:ntok a. A:, yo:n semi we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Semi welik kowtetsi:n wa:n we:lik, wa:n we:lik ato:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Ato:l no: se: kichi:wa yehwa yo:n, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Ke:mah, *porque** neh no: n'chi:chi:wani, ke:meh i:n a:mo wel tikwah ok ne:n xa:lxokotsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>de oksi, tahtakwa:wak a:mo teh totan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>*Mejor** tik..., tikchi:wah ato:l, se: kipaya:na, se: kipaya:na kit, tein teloksik a kwaltsi:n se: kixahxamania, ki:sa ne: ia:yotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>Wa:n koma:mo a:man ne:n pi:pil, kikwih nochi yo:n *licuadora**, yehwa itech kipano:ltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>Wa:n nehjó:n ki..., kitsetselowah wa:n pos titaih ya ika ne:n ato:ltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>Kemah nehjó:n we:lik wa:n no: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Para tehwa:n kwali yo:n no: ne:n okmase..., *este**iselo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>Iselotsi:n yehwa yo:n xa:lxokot, komo yo:n se: estsompi:lti, no: te:na:miki. Wa:n ie:wayotsi:n mah se: kimana no: *igual** te:na:miki, te:na:miki, a:mo nikmati teh ox no: tikmattok ke pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>Ixiwyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>Pos ke:mah, ta: nehjó:n mah nochi se: kimattiw ke:ní:w se: mopahti:s ke:meh i:n a:mo te:na:miki ke:meh i:n koyo:pahti se: 'kwiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>Ke:mah, i:ksá: a:mo te:na:miki, yehwa ya no: ne: te:na:miki ne:n ... Yehwa ya, yehwa ya ne: te:na:miki. Ke:mah, ta: yo:n ixo:chiotsi:n kwaltsi:n mochi:wa, pané: no: chi:ltekpin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Wa:n *cuando** poso:niti a kwaltsi:n pohposo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Ke:mah, ke:meh yo:n xi:lo:xo:chit ne:n iyo:lotsi:n moka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Wa:n yehwa ya ne:n mochi:wa ya ne:n *bolitas** para yehwa ya n'i..., n' i..., xa:lxokot mochi:wa. Ke:mah ne: ixo:chiotsi:n xi:..., xi:ni nochi n' ta:lpan, tel..., teltaahwia:ya ya ka:mpa xi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>Ke:mah, pos nehjó:n ... Iwki, telahwia:k, telahwia:k neli wa:n onkak o:me ... Neh niki:xmati o:me taman sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Ke:mah, yehwa ya ne:n ista:k wa:n tsina:kaxa:lxokot tikilwiah, a:mo nikmati teh ox i:pa yehwa sah. E:yi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>Ke:mah, ta: neli onkak. Neh no: niki:xmati e:yi taman, yo:n ne: parahko onkak seki tel..., telwehwei neli wa:n ye:ktahtakwa:wak iteyo wa:n ye:k, ye:k, ye:ke:wayohtihtilaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>Yehwa yo:n niki:xmattok no:, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>A:mo n'mati ox, ox *más** tiki:xmati ok teh, tikihtowa tiki:xmati *morado**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>*Porque** nika:kwí:n a:mo, a:mo onkak, onkak yehwa sah tsina:kaxa:lxokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Ompaka mochi:wa, pos ke:meh a:man onkas a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>A: pos neli, ta: nika:n tehwa:n no: chika:wayati a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>Ke:meh i:n *tiempo** de i:n chika:waya ya, i:n agosto, nikelna:miktok neh ne: no:ma:ntsi:n ke:meh i:n kichi:wtok, "tiowih ya tikwitih ne: xa:lxokotsi:n".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Tikwitih ke:meh de a lunes ye:k se:se: *canasta**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>tein ekin kahkama:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Para yo:n nehjó:n ahsi miércoles kwalka:n ne:chkwite:wa, 'namakatih Zacapoaxtla, te:chixta:wilia:yah se: *canasta** ihkwi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>Semi telpati:yoh *cuarenta pesos, cuarenta pesos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>Yehwa yo:n tikonka:wayah wa:n tiwi:tseh ya pos nehjó:n tikwa:lkwih ya toni ne:n ika timokowilia:yah, ahsia para timotakowia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Pero a:man tel a:mo, a:mo ahsi ok yo:n tomi:n. Teltapati:yoh wa:n a:man nikita ne:n, ne:n yo:n xa:lxokotsi:n oksitiw pero nochi ihtiohokwiloh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Wa:n ne: ke:man kwaltsi:n onkaya, ye:kkwahkwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Mochi:waya ye:kwehwei, ke:mah, ekintsi:n ye:kokwiloh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Wa:n ihwa:k ne: mochi:waya wehwei ne:n xa:lxokotsi:n wa:n a:mo okwiloh katka, a:mo n'mati ke:yeh tak porin ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Pero pané: i:pa tatikwi:ni, i:pa, neh ni:xpeta:n i:pa tatikwi:ni. *Eso** wa:n a:man a:mo kakisti ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>Pos yehwa yo:n no: timolwihtoyah i:n tiwa:lpano:keh itech *mes de junio**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Se: niman kihto:s ne:, ne: yo..., i..., nehjó:n poxtkwi:ntok ne:n a:we:wehcho.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>*Porque** yo:n *hasta** pané: tawiti..., tawiwiyokaya ne:n kakistia wa:n a:man a:mo kakisti ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Ka:n kakisti ok neli yo:n a:o..., ox a:okwiltsi:n toni yo:n katka. Wa:n neli teltatatsi:ni a a:man wa:n ne: ke:man neli no: tatatsi:nia pero neli *tiempo** de i:n junio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>Junio, teltatikwi:nia, julio, teltatikwi:ni, ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>*Hasta** agosto, agosto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Tami a ne:n tatikwi:ni wa:n tak yehwa ya neli no: kio..., kiokwilo:tiah ne:n, ne:n ... Nochi okwilowa ke:meh yo:n nehjó:n kowtsapot no: okwilowa ya *cuando** teltatikwi:ni. Ke:mah, neli a:it ke:yeh, kichi:wilia *mal**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Okwiloh ya, ke:mah, ta: porin teltatatsi:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Nochi kichi:wilia *mal** ne:n kowta:kilo:tsi:n *hasta** yo:n xokot no: ohohkwiloh seki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Wa:n achto katka ye:kkwahkwali, ta: ne: ke:man no: semi t'namakayah xokotsi:n, ka:n welik ok, ta: porin telxi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
