        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>Neh niki:xmattok ta:to yo:n chi:..., xi:kohtsapot pero we:i ata mochi:wa kowit wa:n *este**, ne: miak n' ita:kka tamatisneki ata n' tsapotsí:n mota:ki:ltia *mo que** mahyá: yo:n *manzana**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>Wa:n tsope:k ne:n iteyots..., n' it..., n' ita:kilotsi:n *mo que** wehwei n' ta:ki, ihkwi:kwi:ntsitsi:n ta:ki pero mahsitik ata ne:n *manzana, como que** yehyewaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>Sayoh *que** tein weh..., wehwei n' ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Ke:mah, iwki ne:n ta:ki, sayoh we:ikowit no: mochi:wa n' ka:mpa no: tak no:kiwelita, ne: neh, ompaka ne:wí:n ka:mpaka ninemi komo kiweyka:piyah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>E:mah, nikitstinemi, wehwei n' ta:ki wa:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>We:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>*(co)mo que** achi cho:kiloh, mahyá: cho:kiloh, ista:k n' icho:kilo ne:n ta:k..., ta:ki, n' ista:k ne:n, ke:mah, ke:mah, iwki n' tamatisneki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Wa:n nimolia tak xa: no: iwki n' tsapotsí:n pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>neli ne: we:lik, no: neh ne: se: sepa ne:chwa:ntih wa:n nimokowilia se: sepa pero ne: kwaltsi:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>We:lik, tsope:k. ke:mah, ta: pané: yo:n ka:n se: kikwa:sneki *pero, *fuerza**, mohkó:n ke:meh i:n a:mo *tiempo** ka:n teh tsapot onkak pos ne: se: kiekowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Ke:mah, tahtaman sah, mahyá: yo:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>Ke:mah, iwkitik, iwkitik ke:meh yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>no: ka:n teh iwki tamati ata ke:meh yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>iwki a ke:meh *manzana**, sayoh *que manzana** ne: *este**, ohololtik sah ta: ne: *mo que** ihti..., no: kipia n' ite:teyotsi:n. No: tamatisneki ata n' iteyotsi:n ke:meh *chirimoya, pero**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>a:mo iwkitik n' *chirimoya**, sano ne: e:wayohkahkana:wak ne:n tsapotsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>E:mah. Ke:mah, iwkiti..., ka:n se: sah n' iteyo, ta: taman sah, ta: ta:man. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Kahkana:wak n' iteyotsitsi:n. ke:mah, iwki neh no: niki:xmati ta:to yo:n ta:kilo:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>*Este**, a:mo tak, i:pa sayoh para se: kixo:taltia ta *mo que** cho:kiloh n' kowtsí:n. Cho:kiloh. Ke:mah, tahtamantik, *mo que** mahyá: yema:nik no: n' ikowyotsi:n, yema:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>Yema:nik, nikitak ne: kite:mpe:wkeh mahyá: ne:,</ANNOTATION_VALUE>
