        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Cho:kiloh. *Es...**, ke:mah, iwki ne:n ki:sa n' ia:yotsi:n no: mohkó:n ne: se: kitsontek.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Ke:mah, ta: tikita ya ke:meh i:n *cuando** se: pilimeh toné: se: ma:wiltihtinemi, no: se: kike:stehteki wa:n no: se: kichi:chia ne:n *chicle, ichi:chicleyo**, se: kite:te:ka ika xiwtsí:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Ompa mopepechowa ya no:.</ANNOTATION_VALUE>
