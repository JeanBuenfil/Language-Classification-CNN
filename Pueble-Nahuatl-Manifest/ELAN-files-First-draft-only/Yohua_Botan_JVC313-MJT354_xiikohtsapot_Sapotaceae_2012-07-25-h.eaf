        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>E:mah. ke:mah, yehwa ya no: ka se: kikwa:kwahkwa ya ta: ne: pati:yoh pero no: n' *chi:kileh** se: mokowilia wa:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
