            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Mahyá: yo:n tamatisneki, mahyá:, taman sah n' kowtsí:n, a:mo, a:mo ke:meh yo:n *mango**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Ta: *mango** ata no: taman.</ANNOTATION_VALUE>
