        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Para kowtati:l, no: kwaltia n' im..., ne:n ima:yo pero a:mo se...,</ANNOTATION_VALUE>
