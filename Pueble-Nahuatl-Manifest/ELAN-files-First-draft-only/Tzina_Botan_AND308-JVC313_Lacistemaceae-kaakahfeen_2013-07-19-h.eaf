        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Ka:mpa ne:n, ka:mpa nehjó:n, nehjó:n kowit, ne:n ka:kahfe:nkowit kiliah pos ompa ke:masá: se: kinahsiti ne:n, ne:n *palomitas**, ompa ne: ne:nentokeh.</ANNOTATION_VALUE>
