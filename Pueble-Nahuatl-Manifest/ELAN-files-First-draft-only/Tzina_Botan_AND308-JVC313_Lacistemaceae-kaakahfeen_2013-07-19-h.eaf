            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Yo:n kwaltia *solamente** para kowtati:l wa:n yo:n no: chihchi:chi:ltik ne:n i..., ikowyo, de se: ki..., de chika:waya ya.</ANNOTATION_VALUE>
