        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>ompa se: kalakia n' kowit, se: kichi:wa mahyá: se:, mahyá: se: ka:kaltsí:n</ANNOTATION_VALUE>
