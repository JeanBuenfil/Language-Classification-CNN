        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>wa:n paniá:n se: kita:lia ya ka:mpa motatsakwas.</ANNOTATION_VALUE>
