                <ANNOTATION_VALUE>ke:mah no: se: mowelitaya sake:ra sep..., sepa sah, n' ke:masá: *dios** tatio:chi:wa, tak no: *dios** te:ikne:lia, se: kikwa:sneki n' chiktehtsi:n wa:n ka:n wel tikmo:tah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah, pos ne: nejó:n neli mokwih ika yo:n wa:n</ANNOTATION_VALUE>
