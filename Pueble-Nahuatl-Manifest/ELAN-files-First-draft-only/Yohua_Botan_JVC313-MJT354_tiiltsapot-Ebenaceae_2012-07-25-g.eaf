        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>wa:n n'ta:lia takwalo:t n' taihtik wa:n nimo...,</ANNOTATION_VALUE>
