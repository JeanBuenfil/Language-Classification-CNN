        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Pero ne:n iteyotsi:n ata no: we:ro mochi:wa mohkó:n pa:ntepe:wik ne:n ita:kayo..., ita:kilotsi:n *mo que** ne: ixwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>Ixwa sah, a:mo mone:neki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>tikitas teh sa ihihkatok ne:n ikowtsitsi:n wa: sepa ompa pe:wa ya n' ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>iwki ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>wa:n yo:n ata n' i..., n' it..., n' ita:ka..., n' ita:kilotsi:n neli ne:n tein *cuando** sel..., seltsitsí:n ok ata wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>seki ata se: mochi:wa ata yo:n wehwei m' pochi:nia se: inakayotsi:n, se: ima:ko oso se: ikechtipan, ka:mpa ka yeski,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>mah se: kita:li tsiktsi:n tenexistat wa:n tsiktsi:n rehfi:noh mah se: ki:xte:kili ata yo:n pohpochi:nia nihnika:n se: ii:xko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Se: se:pa ata sa wehwei *mancha** ata ihkwi:kwí:n mochi:wa ata *ruehruedatik** wa:n pohpochiktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Tak mahyá: pihpine:t oso xi:yo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>Entó:s yo:n xi:yo:t kipahtia yehwa yo:n ti:ltsapot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>A:mo moneki ne: *tiendapahti** oso yo:n mah..., mahtia ne: timoohohsas, sano</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>Yehwa yo:n ne:n tehwa:n tikwih n' ompa ne: timopahtiah. Ke:mah, ta: koko:k ne:n tsapotsí:n. Xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Ke:mah, kwaltiya, kwaltiya ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Kini:xtayowaltiya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Kini:xtayowaltia, pero se: se:pa ata ka:n no: ye:kwe:lkeh yo:n iwki se: kichi:wa ne:n okwiltsitsí:n, no: taman we:liah ya. ke:mah, taman..., tamantiya, *mejor** a ne:n iwki sah se: moinki:tskilia *más** kwaltsi:n se: motamaka, komo se: *moa:jolwilih**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Neh iwki ne: nikitstiwi:ts ta:to ne: i:n ohte:noh nika:n nipano:tiwi:ts ne: ka:mpa onkakeh i:n tsapomeh, pos neli ne: kwaltsi:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>ta:ktokeh n' kanah ika xkita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Ke:mah, cha n' ta:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>Para ika se: kina:lkwa:taksaltia ata yo:n. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>A:, n' tehwa:n tikiliah ne: nejó:n ti..., posa..., *mo que** tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>tikposa:ltiah ata wa:n nejó:n ti..., tikta:liah ata ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>mekatsí:n para ompa mopilo:s a ne:n chiktehtsi:n. Entó:s ompa mopilowa ya ata yo:ni wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>ne: nejó:n sake:ra ka:n na:wi no: mowa:lpilowah, *cuando** no: maya:ntokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Ke:mah, ta: nochi mopilowa neli ta:... ke:mah, no: ne:nemi wa:n no: kikwa ya n' tsapotsí:n, kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Ke:mah, ta: n' ahko no: weli ata n' kihtowah, pero n' ke:meh i:n tehwa:n tisiwa:tsitsí:n ka:n wel tikowtehkoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>i:pa ta:lpan sah tikokolowah neli, te:..., tiko..., ti..., petstik nochi tikololowah para a:mo no: ka sepa takwa:ti:w *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>*Sólo** tein ahko ya wa:le:was powetsiki pos yehwa ya ne: mokwaltia ya ne: a:mo mopilo:ti ok ka:mpa tehwa:n t'ta:liah ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>towito:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Ke:mah, yo:n no: kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>Ke:mah, no: mo..., mokwi ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>A:, n' iwki yo:n. Tehwa:n no: taman tikchi:wayah ne: nokalihtik ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>itech n' toko..., kahfe:ntah *como que** ne: yo:n kanah ika *conejo** ata se: kimati no: yetok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>wa:n kanah ika mot..., n' *conejito** ata motetampakalakia wa:n kwaltsi:n m..., ka:mpa kochi no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>Entó:s tikwih se: koxta:l tehwa:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>tiki:xtapalta:liah yo:n koxta:l wa:n neli miak tikchi:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>tiki:xtapalta:liah yo:n koxta:ltsí:n wa:n t'ta:liah se: *lazo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>wa:n *cuando** taksaki:w a yo:n *conejo**, kalakiti a n' koxta:lko sepa sah ki:sasneki a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>sepa sah motila:nte:wa *lazito**, ompa ya moka:wa n' koxta:lihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>Ompa moka:wa ya, entó:s no: nokta ya n' timowelitah, tikwa:wihwi:tekih wa:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>tikxiw..., xi..., tikchichinowah ya wa:n ke:mah tikx..., tikpa:kah ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>no: se: tapalo:ltsí:n ya timochihchi:wiliah. N' ta: miak taman weh tehwa:n timoskaltihkeh tikchi:wayah ta:to tehwa:n. A:, miak taman se: kichi:wa *porque** se: kikwa:sneki ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>kowtahokwiltsí:n wa:n neli ne:, se:, ta: ne: *mo que** mochi:wa wa:n neli ne: kwaltsi:n no: onkakeh, kwe:man, ke:man onkakeh yo:n okwiltsitsí:n, ta: semi no: kichi:wa *daño**, ata ka:mpa se: kito:ka etsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>we:ro kikwah ne:n exiwtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Kikwah. Ke:mah, neh iwki nika:n no..., noetah nitachi:xtinemi neli ne: ta:to n' teh ox no: iwki n' titachi ne: mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>mo..., motah, moetah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Ke:mah, ta: n' ka:n te:ka:wiliah neli ka:mpa telonkakeh. Kanah, ta: kikechtantekih, kikechtantekih, ta: mahyá: ki..., kitekti..., kitekte:wah yehwa:n, ta: yehwa:n no: kimatih tak no: ika motekipanowah ya. ke:mah wa:n ta: tehwa:n no: timoto:kiliah para no: te:chpale:wi:skia timoilwiah no: tikmahse:wasnekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>Ke:mah, ta: ne:... Ka:n ta: te:cha:wilowiliah sah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Ke:mah, neli ta:to ta: nika:wí:n timoitakeh entó:s ne:, neh no: yehwa i:n tsapotsí:n nikahkoitstinemi ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>nitamekawi:sneki weh, pero ta: neli ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts427">
                <ANNOTATION_VALUE>teh tak no: yehwa n' tikte:mowa. Neli weh. Neh iwki yo:ni, ne: nik..., niki:xte:mohtok, nika:n, nika:n ninenntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Ke:mah ta:to.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>*Bueno, bueno** ta:to, ta:ká:n ne: kanah ika tikmati ne:paka n' kowta:kilo:meh, tine:chnawati:s. ke:mah ta:to.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>A:, n' ompa n' teh tikayo:t. Neh nika:n nikayo:t *este**, nika:n Yohualichan, nimono:tsa niMaría de Jesús Tecuaco.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>Ka:n tehsá: ta:to.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
