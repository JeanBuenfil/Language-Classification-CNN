        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>mokwi *hasta** yo:n *palomita o** chiktehmeh tein temowah ke:meh yo:n papa:n no: temowah ta:lpan, no:, no: mopilowa. Ke:mah, kikwa no:.</ANNOTATION_VALUE>
