        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>de ohtat se: kitehteki wa:n i:x...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>tepe:xo:no:t se: kitehteki ne:n kwowit ompa se: kikohkoyo:nia ika n..., ika,</ANNOTATION_VALUE>
