        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>¿ke:niwki, ka:ni mochi:wa wa:n toni se: kikwi?</ANNOTATION_VALUE>
