        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>No: tikmattokeh *que** ti..., tima:weli para tikchihchi:wa n' xa:yakmeh wa:n</ANNOTATION_VALUE>
