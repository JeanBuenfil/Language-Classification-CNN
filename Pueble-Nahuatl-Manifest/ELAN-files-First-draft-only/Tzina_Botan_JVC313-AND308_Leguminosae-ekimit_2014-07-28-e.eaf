        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts902" TIME_SLOT_REF2="ts905">
                <ANNOTATION_VALUE>A:mo chi:chi:ltik, nio:nó: ista:k, ta: nochi pané: nochi kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts910">
