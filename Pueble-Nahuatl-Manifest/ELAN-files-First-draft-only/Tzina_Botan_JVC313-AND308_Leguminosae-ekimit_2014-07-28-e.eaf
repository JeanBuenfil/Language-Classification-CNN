        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>wa:n para kitamachi:wah wa:n</ANNOTATION_VALUE>
