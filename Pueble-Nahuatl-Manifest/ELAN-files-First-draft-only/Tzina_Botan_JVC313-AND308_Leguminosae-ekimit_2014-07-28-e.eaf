        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>Pos ne: ke:man no: tikitayah ne: Kwesala:n kitamachi:wayah ika se: tamachi:w</ANNOTATION_VALUE>
