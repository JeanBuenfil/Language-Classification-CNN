            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>moka:wa sayoh ne:n kowtsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>Moka:wa, paniá:n te:ntok ne:n ...se: *bola** ne:n i..., iwitsio.</ANNOTATION_VALUE>
