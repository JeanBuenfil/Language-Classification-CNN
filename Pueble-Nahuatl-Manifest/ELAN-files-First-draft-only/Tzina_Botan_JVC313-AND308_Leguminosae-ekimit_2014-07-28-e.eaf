                <ANNOTATION_VALUE>Wa:n yo:n ton kita:liliah tanakastan ihkwí:n ka:mpa kisa:lowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
