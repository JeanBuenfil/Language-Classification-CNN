        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Pos kihtowah de n' toma:wak, ihkó:n ke:masá: kit no: kikwih para kowtati:l, kitapa:nah, kitahtapa:nah, pero a:mo kachi nikita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
