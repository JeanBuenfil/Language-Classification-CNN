        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>wa:n moka:wa mehmelaktik sah yo:n kowit pero a:mo kipia ok n' ie:wayo, alaxtik ke:meh xa:lxokokowit.</ANNOTATION_VALUE>
