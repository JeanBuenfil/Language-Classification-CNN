        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>wa:n ima:yo ne:n pané: ihko:kó:n we:weyak, pané: eheskina:doh ihkó:n.</ANNOTATION_VALUE>
