        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>kwaltsi:n ike:span, no: ihkó:n ke:masá: witsyoh wa:n yo:n a:mo witsioh, we:wehka sah.</ANNOTATION_VALUE>
