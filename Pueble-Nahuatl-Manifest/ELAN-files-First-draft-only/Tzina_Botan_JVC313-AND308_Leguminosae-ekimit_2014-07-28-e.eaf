        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>Wa:n yo:n a:mo nikmati ke:maniá:n, katí:n me:tsti ne:n xo:chiowa para se: ki..., se: ... sayoh neh nikita tein tikwitih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>Moma:itia ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>wa:n de xo:chiowa ya pos yehwa ya se: kiteki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>Pos ihkó:n nikita, neh nik..., nika:n timo..., no: timolihtokeh pos ihkó:n kwaltsi:n no: timomakah, timotapowiah, timomati:ltiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
