        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>Pos nikitak ompa tikpilohtok no: se:, no:, no: de k...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Wehweli, yehwa yo:n tikpiah se:, no: de ekimit, tak yo:n tikpilohtok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>A: pos neh niki:xmattok yehwa yo:n tein se: kikwa n' ekimit,</ANNOTATION_VALUE>
