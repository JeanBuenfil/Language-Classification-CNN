        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>pos ne: para n' xa:yak tak ihkwi:ntsi:n sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>pero para ne:n ahtapal de ne:n kikwih ne:n mihto:tia:nih kachi *más** we:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>No:, no: tapa:ni, teiktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>*Cuando** mopanawiah, kipostekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n tak no: tikmattos katí:n tepos, yo:n kwaltsi:n kite:tekpa:ntiowih, kitehtektiowih, kitehtektiowih *hasta** ma:tamih.</ANNOTATION_VALUE>
