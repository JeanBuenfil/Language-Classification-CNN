            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts747" TIME_SLOT_REF2="ts750">
                <ANNOTATION_VALUE>Se: mopahwi:s wa:n se:, se: ... Ne:nke:n se: mikis wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>pos ekintsi:n nochi tikmattokeh de n' katí:n ika tama:chihchi:walis wa:n katí:n tein a:mo kwaltia wa:n katí:n tein we:lik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>ekimimeh, n' oksé: pos nochi kwaltia para ekintsi:n pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>nochi tikmattokeh para *lindero o** para ne:n *poste**, para *corral</ANNOTATION_VALUE>
