        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Xa: no: k..., a:mo no: kwaltia de *kwomachete**, yo:n semi yema:nik. Yema:nik wa:n</ANNOTATION_VALUE>
