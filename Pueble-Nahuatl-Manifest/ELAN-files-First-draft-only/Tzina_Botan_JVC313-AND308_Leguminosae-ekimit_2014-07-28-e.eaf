        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>A:mo posteki wa:n</ANNOTATION_VALUE>
