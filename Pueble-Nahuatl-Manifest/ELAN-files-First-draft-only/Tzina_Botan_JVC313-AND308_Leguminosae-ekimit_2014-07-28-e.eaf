        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts735" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>Pos kihtowah se: *viaje** se: kone:tsi:n mopahwia:ya itech nejó:n, de yo:n xo:chit *porque** a:monochi se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts738">
