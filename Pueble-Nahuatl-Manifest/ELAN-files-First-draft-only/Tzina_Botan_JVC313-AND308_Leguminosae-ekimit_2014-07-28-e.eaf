        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts769">
                <ANNOTATION_VALUE>o** para tama:chihchi:walis, nochi tikmattokeh ya.</ANNOTATION_VALUE>
