            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts870" TIME_SLOT_REF2="ts873">
                <ANNOTATION_VALUE>Kwaltsi:n alaxtsi:n moka:wa de se: kixihxi:ma kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>Nikita yo:n tein tikpia ne: xa: kwaltsi:n alaxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts883">
                <ANNOTATION_VALUE>A:mo eliwis tetextik, alaxtik kwaltsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts888">
                <ANNOTATION_VALUE>wa:n kwaltsi:n kostik. Yo:n kostik ne:n i..., k..., kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts893" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>Pané: nochi de n' e:yi taman, nochi kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts897" TIME_SLOT_REF2="ts900">
