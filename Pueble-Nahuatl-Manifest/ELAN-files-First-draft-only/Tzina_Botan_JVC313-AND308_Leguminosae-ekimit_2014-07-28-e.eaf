        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>Wa:n yehwa neh ni..., neh ni..., nijó:n no: n'neki nimitstahtani:s yehwa kikwih para n' iahtapal ne:n *San Miguelito**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
