        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>Paniá:n sah de n' e:wat.</ANNOTATION_VALUE>
