        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>Se: panki:stiw ihkó:n wa:n kwali se: tehko.</ANNOTATION_VALUE>
