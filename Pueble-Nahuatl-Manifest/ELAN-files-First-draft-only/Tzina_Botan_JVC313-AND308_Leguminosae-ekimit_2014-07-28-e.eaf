        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>A:, yeh *porque** kisohsoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>Yo:n inkwa:ko nochi tikchihchi:wilia:ya, n' inkwa:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Inkwa:a:ka, mi:migue:les. Wa:n kiliah mi..., mi:migue:les, kiliah migueli:tos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts495" TIME_SLOT_REF2="ts498">
                <ANNOTATION_VALUE>Wa:n ke:meh tima:weli no: ke:ní:w tikchihchi:waya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>Pos tehwaya, tehwaya tikchihchi:..., sayoh tikwiti ne:n n' ekimit wa:n teh tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Tiktehteki, ne:si pané: ihkwi:kwí:n kohkoto:nah</ANNOTATION_VALUE>
