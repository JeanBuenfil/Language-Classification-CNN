        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>Pos kwaltis:n no: nika:n timona:mikkeh, timotapowihtokeh pos ekintsi:n timomati:ltihkeh ya no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>Wa:n a:ko..., a:koni mitsne:xtilih ne: para i:n xa:yakmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts807">
                <ANNOTATION_VALUE>¿Wa:n yo:n mitsne:ctilihkeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>A:, sayoh tikitak ke:ní:w chihchi:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts830">
                <ANNOTATION_VALUE>A:, no: weli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>Wa:n ke:ní:w kichi:wah yo:n, kitetsi:lohtiowih ke:meskia *violín**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts838" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>A:, ika *navaja** se: kitektiw, se: kitektiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>Pos neh nikita yo:n kow..., kowtsí:n de n' ekimit, ye:kkwaltsi:n pané: yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts861" TIME_SLOT_REF2="ts863">
                <ANNOTATION_VALUE>pe..., petaktik ne: *hasta, hasta** pané: kawa:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts869">
