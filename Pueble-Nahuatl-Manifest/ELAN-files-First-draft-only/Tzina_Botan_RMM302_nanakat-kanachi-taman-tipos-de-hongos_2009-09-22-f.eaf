        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>n' ekexi..., *este** yo:n kwopitsokilit tikiliah tehwa:n.</ANNOTATION_VALUE>
