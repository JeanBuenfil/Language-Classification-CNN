        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>*Porque** a:mo wel nimitsili:ti pos..., *no** pos *que** i:n kilit tikwa:tih *porque** onkak kilit tein mokwa wa:n onkak n' kilit tein a:mo mokwa.</ANNOTATION_VALUE>
