            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>a:mo wel tikihto:tih, *no** pos nim..., nikowati ne: *mercado** ta: yo:n</ANNOTATION_VALUE>
