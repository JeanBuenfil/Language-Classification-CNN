        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>*aparte** n' tein yo:n kilit kito:kah, tikihtowah tehwa:n yo:n kilit tein *de cultivo porque**</ANNOTATION_VALUE>
