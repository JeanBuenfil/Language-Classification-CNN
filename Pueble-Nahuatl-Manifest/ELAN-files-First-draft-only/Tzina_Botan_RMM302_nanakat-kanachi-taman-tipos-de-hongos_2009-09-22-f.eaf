            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Ahmo:lkilit, yo:n no: semi we:lik,</ANNOTATION_VALUE>
