        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>Mm, ta..., mah tapa:ni, ke:meh ne:n, ke:meh ne:n ....</ANNOTATION_VALUE>
