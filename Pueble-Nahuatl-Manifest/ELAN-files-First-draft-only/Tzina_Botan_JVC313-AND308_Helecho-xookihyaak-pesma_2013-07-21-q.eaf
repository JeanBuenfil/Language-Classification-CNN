    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="Anastacio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>A: yo:n xo:k..., xo:kihya:kpesma, yo:n ne:wí:n no: mochi:wa ne: ka:mpa taxiti:ni ompa onkak pero a:mo semi wehkapanKa:KAkkkk</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Yo:n se: ki..., se: kita ka:mpa se: koli:nia wa:n se: kihnekwi ye:kxo:kihya:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>*por eso** kiliah xo:kihya:kpesma,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>pos yo:n a:mo wehkapantia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>semi wehkapan ihkwi:ni mochi:wa, a:mo wehkapantia wa:n i:n okseki no:, no: *igual** pero i:n a:mo, a:mo xo:kihya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Tapacho:lpesma, yo:n onkak ne:wí:n no:, ka:sá: ika se: kita ne:wí:n kowtah ihko:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>nejó:n pero a:mo no: semi telwe:i mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Tsikitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>wa:n i:n se: tapacho:lpesma kiliah *porque** ... we:noh xo:kihya:kpesma</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>*porque** ne:s[i]ye:k xo:kihya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Xa: ka:sá: ika no: tikita timokwi:ltia wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>xo:kihya:kpesma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>Wa:n a:mo nikihto:s semi telwehkatan motohto:ka, ta: paniá:n. Paniá:n se: kita nahnalwayoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>Paniá:n sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Om..., ompa sayoh moskaltia ihkó:n ke:meskia ..., a:mo, ta: i:n a:mo, a:mo kikwih para kalikxit ihkó:n, i:pa sayoh xo:kihya:kpesma, sayoh ki..., ompa moskaltia wa:n seki tak wa:ki ihkó:n, moka:wa sayoh ihkó:n ne:n, ke:meskia kowte:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>Ihtikohkoyoktik de, de wa:ki. De n' o:me taman, nochi yehwa ne:n xo:kihya:kpesma, tapacho:lpesma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>Pos yo:n nochi ne:wí:n ka:mpa taxiti:ni sah onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Ka:sá: ika se: kitas ihkó:n a:mo kachi tei,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>a:mo kachi tei, ke:masá: seki *hasta** wiwiwti *porque** paniá:n yetok, yo:n paniá:n sah mota:lia ne:n nalwatsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>wa:n seki de wa:ki, moka:wa ke:meskia yo:n a:mo kipia iyo:lo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Ompa moka:wa, ihtikakawtik, yemaxtsi:n wa:n xaxawakatiw, ompa ne: se: ki..., paniá:n se: tahtaksa yo:n se: koli:nia pos yehwa yo:n pa:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n kiliah ne: ... ka:sá: ika se: ki..., se: kita wa:n se: koli:nia, ye:kxo:kihya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>Xo:kihya:k, *por eso** kiliah xo:kihya:kpesma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>Se: taman, sayoh ke no: kwali a ke nika:n ti..., timahsih, timoahsikeh wa:n timona:mikkeh pos timotahtaniah ke:ní:w, ox se: kita, ka:ni onkak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>wa:n kwaltsi:n no: timo..., timokwikeh, ekintsi:n timolihkeh pos ne: ompa ne:n xo:kihya:kpesma, *igual** ne:n tapacho:lpesma, *mismo** yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Sa[yoh]ekintsi:n pos no:..., nochi ti..., tiki:xmattok no: wa:n neh no: niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Pos neh nimono:tsa Anastacio Nicolás Damián, niwa:le:w ne: San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>A:, we:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="José Ernesto Vázquez Chanico" TIER_ID="José Ernesto Vázquez Chanico">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Pos a:man nikneki nikneki nikmatis se o..., ne: techtapowi, ne: iwki ..., n' ka:ni..., yo:n tikihtoh ne: ... we:noh tikihtowah ke onkak ne:n pesma ne: tapacho:lpesma wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>xo:kihya:kpesma, ke:ní:w teh tiki:xmati</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
