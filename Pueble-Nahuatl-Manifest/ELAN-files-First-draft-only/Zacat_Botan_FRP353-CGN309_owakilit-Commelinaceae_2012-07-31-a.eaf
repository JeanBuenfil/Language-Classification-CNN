            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Se: ki:xpachowani, pos neh *lo más** nikwa yehwa ne:, yehwa ne:n se: kipi:ki ika iswatsi:n, tamaltsi:n.</ANNOTATION_VALUE>
