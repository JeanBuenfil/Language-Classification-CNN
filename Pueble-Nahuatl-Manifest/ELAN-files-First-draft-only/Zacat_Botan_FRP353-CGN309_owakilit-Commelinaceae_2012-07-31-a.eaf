        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>We:weyaktsi:n, ke:mah tein telka:mpa *abonado** n' ta:lts:n pos mochi:wa no: ye:kwe:weyak ixiwyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
