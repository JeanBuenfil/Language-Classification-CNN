        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Ke:meh i:n talwiti ne: ka:mpa towe:itahtsi:n, ne:n Padre Jesústsi:n.</ANNOTATION_VALUE>
