        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Xo:chiotiw *hasta** mo..., xo:chiowa kwaltsi:n ne: ixo:chiotsi:n *morado**, a:mo niki:xmati iteyo.</ANNOTATION_VALUE>
