        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Pos neh nikmattok i:n sese:kpahxiwit nejó:n onkak ne:,</ANNOTATION_VALUE>
