        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts642" TIME_SLOT_REF2="ts643">
                <ANNOTATION_VALUE>No: pe:wak yowi ya nechiko:lismeh de kwesala:n, pe:wkeh timonechikowah.</ANNOTATION_VALUE>
