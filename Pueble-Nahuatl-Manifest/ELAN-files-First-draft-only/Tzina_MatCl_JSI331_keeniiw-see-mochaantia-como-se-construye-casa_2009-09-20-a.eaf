            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>wa:n moka:wak a:ltepe:ta:l a, wa:n *por eso** mochi:w n' *escuelas telesecundarias**, we:ika n' ta:l.</ANNOTATION_VALUE>
