        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Yehwa:n n' koyo:meh... yehwa:n a:mo kimatih komohkó:n... komohkó:n ye:kwehka:wa para kwaltia ne:n, ne:n xo:no:t.</ANNOTATION_VALUE>
