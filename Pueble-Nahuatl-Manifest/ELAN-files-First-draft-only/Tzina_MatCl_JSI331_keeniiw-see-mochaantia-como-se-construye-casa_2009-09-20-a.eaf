            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Chi:wik n' *telesecundaria**, chi:wik se: ta... kaltapahti:lo:ya:n, no: kite:mohkeh ika nepale:wi:l de seko,</ANNOTATION_VALUE>
