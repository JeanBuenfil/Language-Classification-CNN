        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>yo:n tekimeh kichi:wkeh, yo:n *a ni..., a nivel pueblo** wa:n no: *mismo** ihwa:k yo:lik a ne:n... yo:lik a ne:n *cooperativa**.</ANNOTATION_VALUE>
