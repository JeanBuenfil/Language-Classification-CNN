            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>Wa:n yo:[n]... wa:n koyo:meh tein wi:tseh kalpano:kih te:tahtaniah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>niman kihtowah telkwaltsi:n kwesala:n, kwaltsi:n *icostu:mbres**.</ANNOTATION_VALUE>
