        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>N' ta:l pané:, xa: se: ista:joh pano:s.</ANNOTATION_VALUE>
