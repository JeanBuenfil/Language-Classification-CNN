        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>*Ap..., ap..., aparte** ne:n to:nalpolo:lis de n..., de n' *artesano o de** ma:tachihchi:wkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>*Este**... kiowis, to:nas, yeh kite:mo:ti n' *imateria:l**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>Se: *tiempo** pano:k kikwiah tepe:xi:lo:t, tamik n' tepe:xi:lo:t. Ke:meh a:mo akah kito:ka tami n' kowtsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>Yekintsi:n yetok, kikwitokeh *para servilleteros** ohtat, n' ohtat tein xoxoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>Ee... wa:n a:mo sayoh yo:n, san tein a:motsitsí:n *pues**, nochi timosempale:wiah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>Taxkalpi:kilo:nimeh yeh a:mo kichi:wa se: *persona** sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>kichihchi:wa se: ka:n o:me oso e:yi:n, *porque** ki:xchihchi:wah, kihkwilowiliah ne:n ii:xkwalne:ska</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>Ta:taman, tein ta:taman tapaloh wa:n toni n..., toni n' kipias,</ANNOTATION_VALUE>
