        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>Wa:n yo:n ompa, *dueño de** yo:n ta:l, *este**, kipiaya se: *problema**, se: kwehmol iwa:n *banco**,</ANNOTATION_VALUE>
