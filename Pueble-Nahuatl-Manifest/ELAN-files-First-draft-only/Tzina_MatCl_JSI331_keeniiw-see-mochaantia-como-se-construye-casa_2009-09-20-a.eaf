                <ANNOTATION_VALUE>Yo:n kiliah n' koyo:meh *siglas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Entó:s yo:n koyo:meh etoyah, ihwa:k a m' pe:wkeh kite:mowah tomin</ANNOTATION_VALUE>
