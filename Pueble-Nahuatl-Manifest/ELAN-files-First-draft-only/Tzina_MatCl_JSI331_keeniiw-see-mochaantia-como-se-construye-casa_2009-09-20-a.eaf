        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts644" TIME_SLOT_REF2="ts645">
                <ANNOTATION_VALUE>A:mo timia:keh, San Andrés Tzicuilan, Cuetzalan, San Miguel Tzinacapan, Xaltipan, Ayotzinapan, Yohualichan, Pinahuista,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts647">
                <ANNOTATION_VALUE>pané: n' mati Santiago Yancuictlalpan, pané:, a:mo nikelna:miki. a:mo ta: *seguro** yehwa sah yo:nkes, *siete**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>Yehwa yekinikatsitsi:n pe:wkeh t'nemiliah, ke:ní:w t'chi:watih. *Por** yo:n *tiempos** pati:yoh katka n' *azúcar**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts650" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>Pero yo:n ihwa:k tits... tilucha:rohkeh *por** n' *azúcar, de** n' cooperati..., *para cooperativa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts653">
                <ANNOTATION_VALUE>Ihwa:k a n'... ika miak nekwehmolo:lis, pero telmiak nekwehmolo:lis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>n' koyo:meh a:mo kinekiah mah kita:li:kan se:... se: tanamakalo:yan de n' *pobres**, a:mo kinekiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>Onkaya miak kwehmol, telwehka:wak, pano:k xiwmeh, pano:k *meses**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>Wa:n tia:ya:yah nikmattok ma:ski ika kiowit, yo:n *tiem**..., yo:n *tiempo** ka:n akah kitaxta:wia:yah, yo:n *tiempo** tia:yah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>Ke:meh a:man domingo, imaní:n ay timoketsah kwesala:n, nechiko:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>Tikitaskeh ka:ni t'namakaskeh ne:n to..., tokahfe:n, topimie:ntah, toxokow, kowtsapot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>Yo:n ihwa:k kinamakayah, ko:namakayah, neh a:mo ke:man niah, pero... a:mo ke:man tiah ne:n tanamakalis wehka pero t'nechikowa:yah nika:wi:ni xokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>Niahka kowtsapot tika:ka:watoh México, *central de abasto, pero** ke:meh a:mo titanamakanih de kwali,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>wa:n a:mo ti..., a:mo katka titanamakanih de nochipa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts671">
                <ANNOTATION_VALUE>Ta: sayoh tiwetsiah de ke:meh eskia... ke:man weli sah n' tia:yah, no: ke:meh weli te:chkowilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>Ta:ka:mpa tanamakah wehwei:meh, kimattokeh ya ka:ni wa:le:wa, a:konimeh, kichi:wah ya, mahyá: se: *contrato**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>"i:n to:nal niknekis achi i:n de tanamak *pero para** nochipa ya".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>Wa:n tehwa:n nika:n a:mo weli *porque** n' toxokow sayoh *cada** xiwit n' ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>Mah te:chtahtani:ka:n xokot para abril, pos ka:n..., abril ka:n teh xokot, entó:s yeh ika yo:n a:mo weli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts680" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>Pero ihwa:k a ne:n... yahkah ke:meh o:me, e:yi xiwit *comisiones**, nikmattok iksá: ka:n monamaka ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts683">
                <ANNOTATION_VALUE>A:mo... iksá: ka:n akah takwaya, se: a:miki, se: maya:na, se: kochisneki, se: sekwi, tikihyo:wihkeh iwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>Pano:k yo:n, ihwa:k a ne:n... ne:n *cooperativa** yo:lik, yo:lik moahohktiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>Kichi:w miak, yeh *más** este ki... *más** ki... *más** kitekitilih n' kahfe:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>*Por eso** yekintsi:n kipia ne:n *beneficio seco, beneficio húmedo, beneficio seco**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>Kipia ya tanemachti:lo:yan, kipia o... ekintsi:n pané: kwa:..., kwali etok a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts692" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>*Pero treinta y tre... treinta y..., más de treinta años** wehka moskaltih, kichi:w miak a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts695">
                <ANNOTATION_VALUE>Nochi yo:n. A:mo nikelna:miki neh katí:n xiwit no: nik..., no: nikomisio:ntik ompa, mm,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts697">
                <ANNOTATION_VALUE>katka ni... *nicoordinador** de se: *proyecto** mono:tsaya 3839, de yo:n *fondo para niños de méxico**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>Yo:n se: *proyecto** kimpale:wia:ya *solamente** kilia:ya *afiliados de** yo:n *proyecto**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts700" TIME_SLOT_REF2="ts701">
                <ANNOTATION_VALUE>Pero onkaya se: kwehmol no: yo:n iwa:n *porque** tein... tein taeka:naya de n' *proyecto** a:mo iwa:n mowikaya de n' *cooperativa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts702" TIME_SLOT_REF2="ts703">
                <ANNOTATION_VALUE>*Entonces** n' *cooperativa** yeh kichi:wa:k iwa:n se: *convenio** iwa:n yo:n *fundación de niños de méxico**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts705">
                <ANNOTATION_VALUE>n... tein kimati de n' *fundación** monohno:tskeh, ihwa:k a ne:chkalakih neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts706" TIME_SLOT_REF2="ts707">
                <ANNOTATION_VALUE>Pero tehwa:n timota:lia:yah *de acuerdo** iwa:n, titekitiah, tisentekitiah iwa:n *cooperativa**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>Wa:n timopale:wia:yah *pues**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>Neh n'mattok iksá: n' *cooperativa** kihto:s "pos neh ka:n pia tomi:n ee.. te:chpale:wi tepitsi:n". "*Ah, bueno**". Pos iksá: t'pale:wia:yah tepitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts713">
                <ANNOTATION_VALUE>I:pa kipia miak tomi:n ne:n fundación,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts714" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>yo:n *tiempos** kinimakayah *más**. Ekintsi:n a:mo ok kihtowah, mopatak *políticas**, mopatakeh *gentes**, mopatakeh nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>Wa:n yo:n *este**..., yo:n tiempos neh nik... wehka:wak sayoh pané: se: xiwit wa:n tahko sayoh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>*porque** ne:ch... ne:ch..., ne:ch..., nehwa ne: mahyá: nikwehweloh ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts720" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>*porque** onkaya seki, seki xola:lmeh telkweh..., kwehmolmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts722" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>*Por ejemplo**, Xilo... Xiloxochico ki:sak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>3839 ki..., kitsakwaya Xiloxochico, Xochical, Cuauhtamazaco,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts726" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>yehwa sah, Xiloxochico, Cuahtamazaco, Xochical, Tenango, [...]*cinco comunidades**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>Sayoh *cinco comunidades** ki..., *kiabarcarowa:ya**, kimpale:wiayah. Yo:n ihwa:k kipiaya se: *médico**, kipiaya *enfermera, kin..., kinatenderowaya** m' pilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts731">
                <ANNOTATION_VALUE>Wa:n yo:n *cada** pili kitah... kitahkwilowilia:ya n' *ipadrino extranjero**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts733">
                <ANNOTATION_VALUE>nió:n io ki:xmati a:koni, sayoh moi:xmatiah ika, ika *retratos**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>*No, pues** ne:h ni..., kitahkwilowilia:ya n' *ipadrino**, ihko:ni nietok wa:n ihko:ni, mm, ihko:ni nocha:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts737">
                <ANNOTATION_VALUE>Wa:n ke:man kilia:yah m' *padrino, que** ihko:ni nocha:n, iko:ni ninemi, yehwa i:ni nikwa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts738" TIME_SLOT_REF2="ts739">
                <ANNOTATION_VALUE>m' *padrino** moyo:lyema:niaya wa:n kiniwa:lmakaya se: tomi:n mah kie:kchihchi:wa n' icha:n oso mah takwa kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts741">
                <ANNOTATION_VALUE>N' *programas** etoya *para nutrición, salud, nutrición, educación**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts743">
                <ANNOTATION_VALUE>wa:n tomi:n para yehwa katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts744" TIME_SLOT_REF2="ts745">
                <ANNOTATION_VALUE>Onkaya... onkaya tokni:wa:n ke kikwikeh para oksé *cosa**, kikwiah para...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts747">
                <ANNOTATION_VALUE>*Cuando** kinawatia:yah mah kikwi para icha:n kikwia para takwa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts749">
                <ANNOTATION_VALUE>*Cuando** kinawatia:yah ke mah [kikwi para]takwas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts751">
                <ANNOTATION_VALUE>kikwia para itasa:l, k'kowaya itasa:l *o para herramienta**. Onkaya kwehmol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>Nochi yo:n *para... para** tikye:kta:lia:yah, kipia ke tia:skeh re... nechiko:lis, kipiayah *reuniones**, ne: ke:man mochi:waya *reuniones** yowak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>*Hasta la una, las dos de la mañana** tiwi:tseh ya. Ka:n nikochia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>A:man a:mo, a:man mochi:wa *reuniones** to:naya:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts759">
                <ANNOTATION_VALUE>wa:n de yehwa yo:n *programa como siempre** yetok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>Wa:n yo:n 3839 kimpiak, kipiak ipilwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts762" TIME_SLOT_REF2="ts763">
                <ANNOTATION_VALUE>Yekintsi:n de 3839 mo..., ki:sak se: ipili mono:tsak...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>Ah, yo:n ihwa:k etoya se: 1741, yo:n mono:tsaya *desarrollo** Xaltipan, no: ipa etoya ya *después de 3839**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts767">
                <ANNOTATION_VALUE>Etoya se:ko Cuautlamingo, a:mo nikelna:miki kati:yeh yeh n' *inúmero**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts768" TIME_SLOT_REF2="ts769">
                <ANNOTATION_VALUE>Wa:n de 3839 poliw *entonces** ne:sik 1768, mm... *sede** Yohualicha:n, ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts770" TIME_SLOT_REF2="ts771">
                <ANNOTATION_VALUE>N' oksé: yehwa n' tein etoya Xiloxochico, Xiloxochico poliw, kipolohkeh *por política**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts772" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>No: Cuauhtamazaco ompa sede, katka... katka *afiliado** ompa, ekintsi:n ompa *sede**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts775">
                <ANNOTATION_VALUE>No: se: etok, mm... Yohualichan, Yohualichan, Xaltipan, Cuahtamazaco, Tenango,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts776" TIME_SLOT_REF2="ts777">
                <ANNOTATION_VALUE>Tenango pané: *mismo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts778" TIME_SLOT_REF2="ts779">
                <ANNOTATION_VALUE>Pero yetokeh seki, *por ejemplo** Paso del Jardín yo:n okseki:n, etokeh Huehuetla, pero yo:n okseki:n ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts781">
                <ANNOTATION_VALUE>Pero n' tein, tein powi iwa:n *cooperativa** i:pa sayoh de nika:n kayo:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>Ki... e:yi, e:yi *este... programas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts785">
                <ANNOTATION_VALUE>Neh niwehka:wak yo:n ihwa:k sayoh *año y medio**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts786" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>nikpiak kwehmol, seki kwala:nkeh *porque** kihtohkeh, ne:chpantihkeh ke nehwa nikwehweloh, a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>Yo:n kwehwelohkeh *desde** ahko, kihtohkeh: a:mo, i:n t'wehwelo:tih ya *porque** etoya daña:doh ya ne:n *gente**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>Sa:te:pan *moarrepentirohkeh, fuera de tiempo** wa:n tein k'kakkeh, tein kikakkeh n' *consejo**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts793">
                <ANNOTATION_VALUE>kwali ki:skeh, tei:n a:mo ihkó:n etok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts794" TIME_SLOT_REF2="ts795">
                <ANNOTATION_VALUE>*Después** neh nitekitik n' *cooperativa como promotor, hace años**, a:mo nikelna:miki katí:n xiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts797">
                <ANNOTATION_VALUE>mm... tikchi:wayah *reuniones**, tikpe:waltihkeh n' *caja de ahorro** nikmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts798" TIME_SLOT_REF2="ts799">
                <ANNOTATION_VALUE>No: te:chmachtia:yah ke:n tikchi:watih *pues, porque** tehwa:n pos ka:n tikmatih, tehwa:n titekitih kowtah, tehwa:n n' totekiw mm... kowtahtekit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>Pero tikchi:wayah o:me *cosa**, tikchi:wayah *reunión de cooperativa** wa:n t'chi:wayah *reunión de caja de ahorro**, o:me, o:me *cosa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>Pero ke:meh a:mo t'tai:xmatih n' tehwa:n, ka:n timomachtihkeh *más**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts805">
                <ANNOTATION_VALUE>ihwa:k a n' okseki kalakkeh *más** pi:pil tein tai:xmatih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts806" TIME_SLOT_REF2="ts807">
                <ANNOTATION_VALUE>Yehwa:n kipiaskeh tepitsi:n *por lo menos**, kimattoskeh tepitsi:n de tein kiliah *administración contable**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts809">
                <ANNOTATION_VALUE>*Entonces** tehwa:n yo:ni ka:n timomachtihkeh, mm... *por eso** tehwa:n timoka:wkeh *como promotores pero de, de cooperativa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts810" TIME_SLOT_REF2="ts811">
                <ANNOTATION_VALUE>Nikmattok a:konimeh etokeh *como siempre**, etok José Reyes *como siempre** ekintsi:n etok, Epifanio García etok *como siempre**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts813">
                <ANNOTATION_VALUE>Epifanio, mm... Francisco de..., de..., tikiliah chi:skoh de, de Zacatipan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>etok ne:n Emiliano Salazar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts817">
                <ANNOTATION_VALUE>Nochi yo:n katka *cooperativa, este**, ne:n.. katka *este, como promotores de, de caja,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts818" TIME_SLOT_REF2="ts819">
                <ANNOTATION_VALUE>al mismo tiempo de co..., de cooperativa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts821">
                <ANNOTATION_VALUE>Ekintsi:n yehwa:n mokepkeh *como**... n' okseki:n *mayoría, mayoría de** m' *promotores** tein moka:wkeh pos *como promotores de cooperativa** sayoh, *de orgánicos** n' oksé:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts822" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>*Pero* pues semi... semi tamayan ekintsi:n *porque** pos ekintsi:n mo..., motohtoka taxta:wi:l, ne: ke:man tipe:wkeh a:mo teh taxta:wi:l katka, iWwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts824" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>Wa:n no: kwali a *pues**, no: kwali a *que** onkak taxta:wi:l, de yo:n *manera**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts827">
                <ANNOTATION_VALUE>ka:n mati, se: no... se: nokni:w, se: *nopariente**, se: *cualquier novecino**, ta:ká:n ompa tekiti pos neh ne:chmaka tekit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts828" TIME_SLOT_REF2="ts829">
                <ANNOTATION_VALUE>yeh ompa kipale:wiah wa:n neh no: ne:chpale:wia ya, iwki de (yo:n) *manera** timosempale:wiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts830" TIME_SLOT_REF2="ts831">
                <ANNOTATION_VALUE>Wa:n *gente** ika kwala:ni, *fulano** ompa tekiti, ta:..., mm. ¿para toni?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts833">
                <ANNOTATION_VALUE>A:mo moneki mah se: kwala:ni, ka:n weli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts834" TIME_SLOT_REF2="ts835">
                <ANNOTATION_VALUE>Nochi tikpiah *derecho de** t'takwa:skeh wa:n tapata:wya:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>Ka:mpa neh nitekiti ekintsi:n nietok *a gusto**, nitekiti ompa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts838" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>wa:n *que bueno que** ka:mpa n'tekiti yo:n ompa kwali mowi:ka iwa:n *cooperativa**, telkwali, nikwelita</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>mm... *porque** a:mo motsahtsakwiliah ika n' tekimeh, nió:n... de nió:n se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts842" TIME_SLOT_REF2="ts843">
                <ANNOTATION_VALUE>N' oksé: kichi:wa oksé: *cosa** wa:n *cooperativa** kichi:wa oksé: *cosa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts844" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>*Claro** no kimanaka n' kahfe:n pero yo:n a:kin kipias *cliente, según cliente** ke:meh kwelitas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>Wa:n ekintsi:n pos we:i a n' *cooperativa**, we:i,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts848" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>kipia n' *icaja de ahorro, que** telwe:i a, yehwa *más** we:i, *más... más** aki:ltilo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts851">
                <ANNOTATION_VALUE>*Más a... más** aki:ltilo *porque** kalak..., etokeh siwa:meh, etokeh pilimeh, etokeh *abuelos**, etokeh... nochi etokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts853">
                <ANNOTATION_VALUE>*orgánicos** pos etokeh tein tekitih kahfe:n chipa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts854" TIME_SLOT_REF2="ts855">
                <ANNOTATION_VALUE>Wa:n okseki:n tein tekititokeh ompaka, ke:meh eski a... ke:meh eski a *talleres**, pos etok *de bambú**, etok *de artesanos**, etok de okseki:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts857">
                <ANNOTATION_VALUE>*comisiones de pimienta**, de kahfe:n. Pos kwali etok *pues,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>lo malo que**... pos a:mo wel tinochimeh ompa t'tekitih *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts861">
                <ANNOTATION_VALUE>pos a:mo ahsi... a:mo ahsi n' tomi:n. Neh n'mpia *seguro**, neh n'pia, nikpia... ni... ni... nietok *claro pues que... que cada... cada este..., cada lugar** kipia n' itekiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts863">
                <ANNOTATION_VALUE>No: ntekitik *como viverista** iniwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts864" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>Ompa ntekitik yo:n *vivero**, neh ne:chyo:le:wkeh yo:n ihwa:k *como injertador**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts866" TIME_SLOT_REF2="ts867">
                <ANNOTATION_VALUE>Nikwelitak no: wa:n *que bueno pues, gracias a eso** no: nimomachtih miak iniwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts868" TIME_SLOT_REF2="ts869">
                <ANNOTATION_VALUE>mm, *como injertador** neh nimoespesialisa:rohka *en macadamia, nuez de macadamia**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts870" TIME_SLOT_REF2="ts871">
                <ANNOTATION_VALUE>¿Tiki:xmattok? yo:n nika:n etok, ah, pos i:n etok, o:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts872" TIME_SLOT_REF2="ts873">
                <ANNOTATION_VALUE>I:n semi, semi *fino** i:n... i:n *nuez**, telwe:lik, a:mo iwki tein mexicano no: *inuez**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts874" TIME_SLOT_REF2="ts875">
                <ANNOTATION_VALUE>i:n *nuez australiano**, ¡eh! I:n... i:n i:kni:w a:wa:kowit tein nika:wí:n onkak, mm, *ipariente**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>soh ke n' a:wa:t tein nika:n pos no: taman ta:ki wa:n i:n telwe:lik n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts878" TIME_SLOT_REF2="ts879">
                <ANNOTATION_VALUE>*Lo malo que**, yo:n *tiempos** ke:man *cooperativa** kahoka ne:n yo:n... yo:n *proyecto de** n... de n' *macadamia**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts880" TIME_SLOT_REF2="ts881">
                <ANNOTATION_VALUE>a:mo akah k'kowaya, *como que** a:mo kipia.... a:mo kwe:... a:mo ki:..., a:mo ki:xmatiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts882" TIME_SLOT_REF2="ts883">
                <ANNOTATION_VALUE>Yekintsi:n ki:xmatkeh ya, ekintsi:n kwe:liliah ya, kichi:wah miak *cosas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts884" TIME_SLOT_REF2="ts885">
                <ANNOTATION_VALUE>Se: koyo:t ompa kwesala:n kichi:wa, kichi:wa *este**, a:it ke:ní:w n' kiliah... kichi:wa... takwalismeh de n... *de macadamia**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts886" TIME_SLOT_REF2="ts887">
                <ANNOTATION_VALUE>*Postres**, kichi:wa pan, kichi:wa miak taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts888" TIME_SLOT_REF2="ts889">
                <ANNOTATION_VALUE>Ma:se:walmeh no: kwali kichi:wah *pues**, sayoh moneki nemachtil tepitsi:n de i:n, *porque** telwe:lik *macadamia**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts890" TIME_SLOT_REF2="ts891">
                <ANNOTATION_VALUE>wa:n *este**, ne:n koyo:meh pos yehwa:n ke:meh welih pos momachtiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts892" TIME_SLOT_REF2="ts893">
                <ANNOTATION_VALUE>Tehwa:n ka:n tiwelih, pos ka:n wel timomachtiah *porque**pos cada** nemachtil kipia ipati:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts894" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>wa:n *lástima que** tamik yo:n *proyecto de** n' *macadamia porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts896" TIME_SLOT_REF2="ts897">
                <ANNOTATION_VALUE>ekintsi:n ka:n tei *macadamia** wa:n ekintsi:n *que** nochi:n... miak *gente** kite:mowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts898" TIME_SLOT_REF2="ts899">
                <ANNOTATION_VALUE>Tamik *porque** wa:lah yo:n te:tsa:w... tetsa:wit, te:tsa:wehekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts900" TIME_SLOT_REF2="ts901">
                <ANNOTATION_VALUE>miak wihwile:w, pohpostek, wehweliw m' *planta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts902" TIME_SLOT_REF2="ts903">
                <ANNOTATION_VALUE>A:man ka:n teh m... ka:n tei ok, *últimamente** neh nia... n'nohno:tsa n' tein kimati ompa ne:n n' totayeka:nka:w de n' tosepan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts904" TIME_SLOT_REF2="ts905">
                <ANNOTATION_VALUE>pero kihtowah ke yetok *pendiente**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts906" TIME_SLOT_REF2="ts907">
                <ANNOTATION_VALUE>Neh nikilihtoya *que** neh nietok *puesto otra vez**, sepa oksé: *viaje para** tik... tikchi:... tikchi:walti:skeh de n' *injertación**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts908" TIME_SLOT_REF2="ts909">
                <ANNOTATION_VALUE>*porque cuando** tamik a, *cuando** tamik katka, (ke)mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts910" TIME_SLOT_REF2="ts911">
                <ANNOTATION_VALUE>katka *buenos prendimientos** onkaya, katka... ahsia *hasta 80, 90% de prendimiento, buenos** a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts912" TIME_SLOT_REF2="ts913">
                <ANNOTATION_VALUE>Tehwa:n t'chi:wayah *solamente** tie:yi:n, *tikinjertarowayah** yo:n *tiempos**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts914" TIME_SLOT_REF2="ts915">
                <ANNOTATION_VALUE>wa:n a:kin eski ya:ya t'machtia:yah *pues**... a:kin eski ya:ya t'machtia:yah, ora... pos ora teh x'chi:wa, ihkó:n x... ihkó:n se: kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts917">
                <ANNOTATION_VALUE>A:mo ke:man kwali mah se: nexi:kol, ¿para toni?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts918" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>Neh nimikis wa:n komo nimikik nikwi:ka nonemachtil pero to:n servi:roh, *mejor** mah welika:n okseki:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts920" TIME_SLOT_REF2="ts921">
                <ANNOTATION_VALUE>¿Ton pasa:rohtok ekin... nika:n nopue:bloh? Onkak *danzas que** yehwa:n sah kimatih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts922" TIME_SLOT_REF2="ts923">
                <ANNOTATION_VALUE>a:mo n'mati ox a:mo kinmachtiah *o** ke:yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts924" TIME_SLOT_REF2="ts925">
                <ANNOTATION_VALUE>pero komo sie:mpreh yehwa:n, entó:s yehwa:n... yehwa:n kichi:wah, pos yehwa:n sayoh n' kimatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts926" TIME_SLOT_REF2="ts927">
                <ANNOTATION_VALUE>Pero komohkó:n nikimachtia *cien**, pos *mejor porque** pos yo:n nemachtil nochipa onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts928" TIME_SLOT_REF2="ts929">
                <ANNOTATION_VALUE>Ne:n... ne:n tein timonohno:tstoyahde n' *cooperativa, lástima que** yo:n ihwa:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts930" TIME_SLOT_REF2="ts931">
                <ANNOTATION_VALUE>ka:n... am... nikelka:w a:mo nimitstamiilwih *que** chika de n' *azúcar**, nejó:n we:iak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a471" TIME_SLOT_REF1="ts932" TIME_SLOT_REF2="ts933">
                <ANNOTATION_VALUE>We:iak de n' *azúcar porque** tikitayah *que** a:mo soh kichi:waya *falta azúcar**, ta: kichi:waya *falta** et,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts934" TIME_SLOT_REF2="ts935">
                <ANNOTATION_VALUE>kichi:waya *falta** mante:ka, kichi:waya *falta** tao:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts936" TIME_SLOT_REF2="ts937">
                <ANNOTATION_VALUE>Mm, n' tao:l onkaya we:i kwehmol ne: ke:man, kihtowah, tikmattkeh *pues, que** tein... tao:l tein k'wa:l... k'wa:lkwiah de... de a:na:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts938" TIME_SLOT_REF2="ts939">
                <ANNOTATION_VALUE>n' a:na:ltekos kikwiah *para... para** tapialmeh seki tao:l kostik, tahtapkyoh, pitsotik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts940" TIME_SLOT_REF2="ts941">
                <ANNOTATION_VALUE>Kimoya:wayah ne: ke:man sayoh kasá: ika, te:chmakayah mahtakti *kilo por familia**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts942" TIME_SLOT_REF2="ts943">
                <ANNOTATION_VALUE>iwki sah, wa:n para tikahxiti:skeh ne:n e:yi almo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts944" TIME_SLOT_REF2="ts945">
                <ANNOTATION_VALUE>pos kipia ke timoi:xpatayah, a:mo moka:waya oksé:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts946" TIME_SLOT_REF2="ts947">
                <ANNOTATION_VALUE>Wa:n *cuando** yo:n tikitayah *que** mochi:wa... kichi:wa *falta** oksé: cosa, tao:l, et, mante:ka, nochi yo:n *cosas**, xapoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts948" TIME_SLOT_REF2="ts949">
                <ANNOTATION_VALUE>ihwa:k a ne: pe:wkeh, ne:n nechiko:lis *de cooperativa** ihwa:k a m' pe:wak tehko wa:n temowa, pe:wak ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts950" TIME_SLOT_REF2="ts951">
                <ANNOTATION_VALUE>kiliah n' koyo:meh ki... pe:wak kichi:wa *gestiones** iwa:n... iwa:n *conasupo**, ne: ke:man yetoya n' *conasupo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts952" TIME_SLOT_REF2="ts953">
                <ANNOTATION_VALUE>iwa:n kichi:w yo:n *convenio**. Ekintsi:n nochi mopatak a, ee... n' *conasupo** kipia ya n' *imercancía**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts954" TIME_SLOT_REF2="ts955">
                <ANNOTATION_VALUE>N' *conasupo** i:pa kipiaya n' *itiendas** itech wehwe[i]xola:lmeh, pero n'... pero kowtah aya:mo onkaya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts956" TIME_SLOT_REF2="ts957">
                <ANNOTATION_VALUE>ihwa:k a ne:n... ne:n tosepan iwa:n kichi:w n' *convenio**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts958" TIME_SLOT_REF2="ts959">
                <ANNOTATION_VALUE>wa:n *primer bodega**, prim... ki..., ki..., *este**, kichi:wkeh *como**, mahyá: se: *programa piloto**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts960" TIME_SLOT_REF2="ts961">
                <ANNOTATION_VALUE>de yo:n *tipo de... de..., de..., de almacenes**, kil..., kito:ka:ytihkah ne: ke:man *conasupo coplamar**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts962" TIME_SLOT_REF2="ts963">
                <ANNOTATION_VALUE>Yekinikatsitsi:n *bodegas** nika:n kichi:wkeh, nika:n topue:bloh, nika:n etoya *bodega**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts964" TIME_SLOT_REF2="ts965">
                <ANNOTATION_VALUE>nika:n kisurti:rowa:yah nochi:meh, nochi n' *municipio, parejo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts966" TIME_SLOT_REF2="ts967">
                <ANNOTATION_VALUE>Ka:mpa yo:n achto nimitsilwih tikchi:wkah se: kahfe:nkowalo:ya:n de i:n *pueblo** San Miguel,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts968" TIME_SLOT_REF2="ts969">
                <ANNOTATION_VALUE>ompa k... ompa kipia se: *bodega kirentarohkah**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts970" TIME_SLOT_REF2="ts971">
                <ANNOTATION_VALUE>*Tikrentarowilihkah** ne:n *conasupo coplamar**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts972" TIME_SLOT_REF2="ts973">
                <ANNOTATION_VALUE>N' *sociedad de producción rural** ihkó:n mono:tsaya n' ka:mpa kahf... n' ka:mpa kahfe:kowayalo:ya:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts974" TIME_SLOT_REF2="ts975">
                <ANNOTATION_VALUE>pos yeh kixta:wilia:yah se: *renta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts976" TIME_SLOT_REF2="ts977">
                <ANNOTATION_VALUE>*Después** sa:te:pan ya mochi:w, *cuando** i:pa mo... tekititoya ya ne:n almacén de n' *conasupo coplamar**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts978" TIME_SLOT_REF2="ts979">
                <ANNOTATION_VALUE>kichi:wtoyah *al mismo tiempo** n' *almacén** tein ekintsi:n etok Cuetzalan *hasta** yekintsi:n yetok n' *almacén,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts980" TIME_SLOT_REF2="ts981">
                <ANNOTATION_VALUE>pero** nika:n pe:wak, nika:n e:wak. Ne: ke:man katka nika:n totie:ndah katka *tienda número uno**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts982" TIME_SLOT_REF2="ts983">
                <ANNOTATION_VALUE>wa:n sa:te:pan tawehweliw wehka *tiempo después de... veintitantos años, veintinueve años, veintiocho**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts984" TIME_SLOT_REF2="ts985">
                <ANNOTATION_VALUE>*kitoca:roko** ekintsi:n sepa n' *tienda número trescientó:s treinta y tres**, a:chá: *último** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts986" TIME_SLOT_REF2="ts987">
                <ANNOTATION_VALUE>*Pasaroh** miak *cosas**, tawehweliwka, nochi por a:mo timomachti:skeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts988" TIME_SLOT_REF2="ts989">
                <ANNOTATION_VALUE>nochi *por** a:mo timomachti:skeh kikwi... chi:wik *mala administración**, wa:n *de mala administración**, koto:nka n' *tienda**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts990" TIME_SLOT_REF2="ts991">
                <ANNOTATION_VALUE>wa:n ekintsi:n sepa moahkokkeh, sepa n' tein... tein *todavía** tein ke:man weli tiowih *reuniones de** n' *cooperativa**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts992" TIME_SLOT_REF2="ts993">
                <ANNOTATION_VALUE>sepa kiniyankwik a ahkokeh ne:n *tienda**, yekintsi:n mono:tsa *tienda diconsa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts994" TIME_SLOT_REF2="ts995">
                <ANNOTATION_VALUE>Mm... pané: sedesol ya n' ekintsi:n kihtowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts996" TIME_SLOT_REF2="ts997">
                <ANNOTATION_VALUE>*Bueno, total que de** yo:n onkak *azúcar**, onkak tao:l, te:chmakah tsikitsi:n semi, ahachichi te:chxelowiliah *porque** tapati:yoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts998" TIME_SLOT_REF2="ts999">
                <ANNOTATION_VALUE>Ekintsi:n ke:meh tiahtokeh n' *tiempo** tapati:yoh, nochi n' *gente** yetok, pos *este**, o:meyo:lohtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts1000" TIME_SLOT_REF2="ts1001">
                <ANNOTATION_VALUE>¿A:it ke:ní:w n' ti:xpano:tih? *Lo primero** tikihtowah mah a:mo poliwiskia tao:l wa:n mah a:mo te:chtekipacho, mah tipa:ktoka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts1002" TIME_SLOT_REF2="ts1003">
                <ANNOTATION_VALUE>*pero de** ay ne:paka etok owih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts1004" TIME_SLOT_REF2="ts1005">
                <ANNOTATION_VALUE>*Por eso** nochi n' kahf..., nochi n' kahfe:ntahmeh ekintsi:n etok *abandonado**, ka:n akah tame:wa semi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts1006" TIME_SLOT_REF2="ts1007">
                <ANNOTATION_VALUE>ma:ski no: tapale:wia ne: yo:n *consejo poblano del café**, tapale:wihkeh, pero a:mo ahsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts1008" TIME_SLOT_REF2="ts1009">
                <ANNOTATION_VALUE>Miak *gente** tein nemi *por** Zacapoaxtla, Zaragoza, Teziutlán, Puebla, niman kihtowah:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1011">
                <ANNOTATION_VALUE>"*zona Cuetzalan ricos porque** kipiah kahfe:n".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts1012" TIME_SLOT_REF2="ts1013">
                <ANNOTATION_VALUE>*Pero si** n' kahfen tikmattokeh, de n' kahfe:n tikmattokeh ke tein de *cien por ciento** tiknamakah, tein moexporta:rowa *cien por ciento**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts1014" TIME_SLOT_REF2="ts1015">
                <ANNOTATION_VALUE>¿a:it ka:ni moka:wa *noventa y tres por ciento**? N' *productor** kimakah *solamente siete por ciento****, yo:n t'mattokeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts1016" TIME_SLOT_REF2="ts1017">
                <ANNOTATION_VALUE>Kichi:wak se: nemachti:lis ne:n tosepan, *a través de** ompa yo:n te:chilihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts1018" TIME_SLOT_REF2="ts1019">
                <ANNOTATION_VALUE>¿Ka:ni moka:wa? *Por ejemplo** ekintsi:n tein t'mattokeh neli ke si... se: *libra de café** a:it ka:nachi dólares kiki:xtiah, telmiak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts1020" TIME_SLOT_REF2="ts1021">
                <ANNOTATION_VALUE>Ahsi *treinta y seis tazas** wa:n ¿ke:ní:w se: *taza valerowa**?, pati:yoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts1022" TIME_SLOT_REF2="ts1023">
                <ANNOTATION_VALUE>ka:n..., a..., ¿para a:konimeh t'tekitih?, t'tekitih para koyo:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts1024" TIME_SLOT_REF2="ts1025">
                <ANNOTATION_VALUE>wa:n a:mo teh *más** telsenka ya kwali eskia t'tekitiskiah para tehwa:n *mismo** tein tikwa:skeh, tein para t'namakaskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts1026" TIME_SLOT_REF2="ts1027">
                <ANNOTATION_VALUE>Miak *gente** ekintsi:n tein yo:n etok *ciudad** kihtowah... tein w.. etokeh wehwei xola:lmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts1028" TIME_SLOT_REF2="ts1029">
                <ANNOTATION_VALUE>*que** kachi kwali n' kowtah *porque** n' kowtah se: tato:k, se: tsapot, se: pahpata, se: xokot nika:wí:n onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts1030" TIME_SLOT_REF2="ts1031">
                <ANNOTATION_VALUE>Tikwah sah, tikwitih wa:n tikwah, wa:n tein nemi *ciudad para** ya:s kalan taxta:was, para takwa:s taxta:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts1032" TIME_SLOT_REF2="ts1033">
                <ANNOTATION_VALUE>Nika:n a:mo, para niá:s kalan pos a:mo n'taxta:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts1034" TIME_SLOT_REF2="ts1035">
                <ANNOTATION_VALUE>para nikwa:s se: xokot, se: ta:kilo:t nikwiti sah *o** ne:chwa:ntih *o** niktekiti ka:mpa neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts1036" TIME_SLOT_REF2="ts1038">
                <ANNOTATION_VALUE>¿a:mo n'mati ke:ní:w n' tikita i:n tein nimitstapowih?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts1042" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>Miak *cosas** a:mo nimitsilwih, miak cosas a:chá: nikelka:wak, miak pano:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1045">
                <ANNOTATION_VALUE>N' *historia de** n' *cooperativa** telweyakaxtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts1046" TIME_SLOT_REF2="ts1047">
                <ANNOTATION_VALUE>*treinta años son ..., treinta años** ihkón yo:lik pahpano:k, a:mo nochi n' mati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts1048" TIME_SLOT_REF2="ts1049">
                <ANNOTATION_VALUE>Miak pano:k, miak *cosas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts1050" TIME_SLOT_REF2="ts1051">
                <ANNOTATION_VALUE>Ekintsi:n n... tein nik..., nikwelkaktok no:, yankwixtok onkaya se: neta:ta:nilis de tapalo:lchi:walis de siwa:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts1052" TIME_SLOT_REF2="ts1054">
                <ANNOTATION_VALUE>Yo:n telkwali etok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts1058" TIME_SLOT_REF2="ts1059">
                <ANNOTATION_VALUE>Ah, neh nimono:tsa... ye:wa nimitsilih neh ni... ni... ni... ni... ni..., ni..., niyo:lik ne:pa Taxiti:mpan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts1060" TIME_SLOT_REF2="ts1061">
                <ANNOTATION_VALUE>nimono:tsa Antonio... José Antonio Salgado Isabel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts1062" TIME_SLOT_REF2="ts1063">
                <ANNOTATION_VALUE>Nikpia *cincuenta y qué... cincuenta y seis años, nicumplirotia**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts1064" TIME_SLOT_REF2="ts1065">
                <ANNOTATION_VALUE>Wa:n a:man nika:n ninemi Xo:pana:ko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts1066" TIME_SLOT_REF2="ts1067">
                <ANNOTATION_VALUE>Ee... nika:n tikowkeh i:n to... toluga:rtsi:n wa:n ampó:n ticha:nchi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts1068" TIME_SLOT_REF2="ts1070">
                <ANNOTATION_VALUE>Borrar</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
