        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>Para i:n ilwit a:it a,</ANNOTATION_VALUE>
