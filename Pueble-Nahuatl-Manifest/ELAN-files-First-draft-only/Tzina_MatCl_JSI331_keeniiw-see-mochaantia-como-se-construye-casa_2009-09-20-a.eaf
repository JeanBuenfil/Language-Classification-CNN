        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>xa: kipias se: siwa:t tatektok, xa: kipias se: siwa:t tanamakatok,</ANNOTATION_VALUE>
