        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>Ne: ke:man etoya ne:n *Plan Zacapoaxtla**, etoyah seki koyo:meh tein de n'... de n' *agrónomos**</ANNOTATION_VALUE>
