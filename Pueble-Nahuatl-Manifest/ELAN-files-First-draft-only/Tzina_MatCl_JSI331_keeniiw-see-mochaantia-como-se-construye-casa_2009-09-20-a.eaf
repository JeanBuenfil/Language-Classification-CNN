        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>Ya ne:n, no: tikitayah no: de n' oksekin tanamakmeh,</ANNOTATION_VALUE>
