            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>N' ekintsi:n ompa etok a n' *telesecundaria**.</ANNOTATION_VALUE>
