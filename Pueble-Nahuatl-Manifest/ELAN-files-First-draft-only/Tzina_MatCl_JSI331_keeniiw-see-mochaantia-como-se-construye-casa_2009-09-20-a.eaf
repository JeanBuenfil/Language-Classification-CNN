        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Nika:[wín]*cerca** a:mo kanah kahsikeh yo:n *tiempo**, a:mo akah kiselih.</ANNOTATION_VALUE>
