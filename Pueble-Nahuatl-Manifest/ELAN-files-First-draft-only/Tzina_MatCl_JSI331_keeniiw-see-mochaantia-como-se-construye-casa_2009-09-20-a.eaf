        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>ompa, *hasta** ompa mochi:wato, pané: ye:kwehka *telesecundaria** moka:wak *porque en primero**,</ANNOTATION_VALUE>
