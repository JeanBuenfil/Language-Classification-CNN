        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>Wa:n moka:wah itech intoskako wa:n yehwa yo:n moto:toskaketsah, a:mo wel ne:n tatolowah ok, ta: okseki ika mikih wa:n ika yo:n kihtowah kiki:xtiliah.</ANNOTATION_VALUE>
