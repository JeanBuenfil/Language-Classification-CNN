        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Chakxiiwt. Pos kwaltsi:n ke:meh i:n se: mo..., molia pos se: kineltoka wa:n komohkó:n te:..., neh no: pos nikihtowa te:mpa:waxiwit *porque** te:kwihkwi ke:meh i:n ka:sá: ika se:, ihkó:n se: yowi nochi te:kwihkwi itech se: ikalso:n *o** itech se: ikami:sah wa:n no: te:sohso.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Wa:n kipia pané: ikwitapi:l ihkó:n, yehwa yo:n te..., te:sohso wa:n pos ihkó:n kihtowah ke kwaltia nehyo:n para pio:tsitsi:n ke:meh i:n kitolowah teisá: okwiltsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>Yo:n chak..., chakmeh, ke:ní:w kiliah, tsikitsitsi:n, pisili:tos.</ANNOTATION_VALUE>
