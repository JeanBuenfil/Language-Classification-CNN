        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>De o:me taman kisema:nelowah wa:n kisemanah para, para kalanemi:lis pos kwali no:, entó:s pos yehwa yo:n nochi se: m..., molia, nehjó:n mah se: kimati nochi.</ANNOTATION_VALUE>
