        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>ke:ní:w se: kimachilia wa:n ke:ní:w se: mopahtia, toni ne:n ika kwali se: mopahti:s komohkó:n te:kwi i:n kokolis.</ANNOTATION_VALUE>
