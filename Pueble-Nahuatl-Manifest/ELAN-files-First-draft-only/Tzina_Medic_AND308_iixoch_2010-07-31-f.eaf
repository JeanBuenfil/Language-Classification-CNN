        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Tikihtowa ke i:n ihxo:ch te:kwi komohkó:n se: tahyalkwitok wa:n i:n tahyal, se: tahyalkwi, ke:yeh.</ANNOTATION_VALUE>
