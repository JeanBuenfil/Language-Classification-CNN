        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>de yo:n seki neli a:mo no: nikmati ke:ní:w ne: nejó:n ox, ox no:, ox no: we:lik neli n' ikamohyo pero neli pos n' ixiw... Yehwa sah, yehwa sah no: n' tein i:pa tiki:xmattok, neli se: kikwi, ke:mah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Pos ka:n se: kimati, ke:mah, *porque** neli pos *solamente** kikwah neli tapialmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Ke:mah. Pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>pos yehwa sah pos n' ika tein ika timonohno:tskeh, ka:n, ka:n teihsá: *más**, miak tasohka:matik ke:mah. Neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
