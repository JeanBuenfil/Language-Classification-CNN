        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>Porin semi tekiyoh, yo:n semi owih, moneki mah se: miakeh para se: mosempale:wi:s, se: ise:lti a:mo se: kichi:wa yo:n tekit, ika ka:wkeh yo:n panelita.</ANNOTATION_VALUE>
