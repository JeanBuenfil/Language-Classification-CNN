        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts391" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
