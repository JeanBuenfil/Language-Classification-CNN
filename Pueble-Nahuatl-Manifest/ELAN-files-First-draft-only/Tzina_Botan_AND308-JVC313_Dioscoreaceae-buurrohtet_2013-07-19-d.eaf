                <ANNOTATION_VALUE>De yo:n wehwei ihkó:n tiktewa:tsayah wa:n tikwa:yah, mohmoloxtik moka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>Mo:moloxtik ne: no: ti..., tikwa:yah nehjó:n tikonkwiah ika se:, ihkó:n, ika se: *bolsita**, ihkó:n tikonkwiah,</ANNOTATION_VALUE>
