        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>O:me e:yi a sah *pues**, a:mo tapa:tskah ok, ekintsi:n nochi *azúcar** a. Ke:mah, tamik a nochi. Ke:mah.</ANNOTATION_VALUE>
