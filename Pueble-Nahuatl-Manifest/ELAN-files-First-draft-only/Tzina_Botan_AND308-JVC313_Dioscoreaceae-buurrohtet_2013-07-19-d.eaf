            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>Kipolohkeh nochi a porin ...</ANNOTATION_VALUE>
