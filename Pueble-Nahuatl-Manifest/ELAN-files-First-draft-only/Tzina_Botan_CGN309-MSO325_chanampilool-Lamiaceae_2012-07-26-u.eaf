        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>to..., totapatalo:ni nikilia neh *porque** pos nejó:n nochi tikowah n' a:man. Nochi tikowah wa:n ne: ke:man nikilia neh, ka:n kikowayah n' tote:iskaltihka:wa:n teihsá: pos neli ke:meh i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Ke:mah, yo:n no: kwaltiaya neli. Ke:mah, moloxtsi:ni. Ke:mah, no: kwal... Ke:mah yo:n neli no: kwaltiaya, ke:mah *porque** ne: k...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Ke:mah, kwaltiaya neli *porque** pos neli yo:n ma:mohmoloxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Ke:mah, a:mo nikihto:s teh te:chchi:wilih, n' ta: neli nikilia neh pos a:man a:mo, a:mo tikwihyehwa ok *porque** a:man neli nochi tikowah ya, nochi tikowah *por eso** nej...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>Ke:mah, kwaltiaya neli yehwa. Ke:mah, pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>pané: yehwa sah katka n' tein i:n tine:chtapowih, miak tasohka:matik, pos ka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>ka:n teh *más** nejó:n tikmatililiah ok kit yehwa sah i:pa n' tein tikmattokeh pahti. Ke:mah, pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>ka:n teihsá:, pos kwali a *que** timonohno:tskeh, nika:n neh mono:tsa niMaría Salazar Osollo, niwi:sa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
