        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Nikilia, "Wa:n se: i:n yetok *paloma**". "Mikik a". "Mikik a".</ANNOTATION_VALUE>
