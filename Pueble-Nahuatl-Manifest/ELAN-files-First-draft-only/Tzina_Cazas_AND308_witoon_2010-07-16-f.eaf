        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Yo:n ke:meh *pollito** papatakatok ompa ne:. [Ni]kihtowa, "¡'Ya:ti!", nikilia, "i:n tewiyo:n". I:pa niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Kihtowa, "Ne:, a:mo ya:s", kihtowa, "ta: ki:n..., miktok a", kihtowa. "Kitektok n' *hilo**". Ke:meh se: *pollito*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>"¿Ox ne: no: tiki:xmati?". "Ke:mah, pos ta: tine:chne:xtilih ne: ke:maniá:n".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Entó:s ne:..., ne:paka nikita wetstok papatakak se: moh..., molpih takah se: *we:ipaloma** de yo:n *kwa:moradi:tos**.</ANNOTATION_VALUE>
