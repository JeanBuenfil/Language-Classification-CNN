                <ANNOTATION_VALUE>Pos yehwa i:n timonohno:tsa *cuando** ... Ke:masá: timotahtani:skeh wa:n kwali tine:chakas ne:n xina:ch, ne: sikie:ra o:me e:yi para se: kito:kas ne:wí:n wa:n ika se: kitas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Ika se: kitas komohkó:n ne:n tsope:k no: semi yo:n tikihtowa chi:..., chi:chi:ltik, chi:chi:ltik wa:n de n' pos i:n kostik nikmattok,tsope:k no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Pero okseki chi:chi:ltik a:mo nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>Wa:n iteyo no:, no: taman, no:, nochi iwki sah de n', de n' o:men, tein we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>Pe..., pero nochi achichi iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Kachi tohtoma:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>We:weyak sah wa:n tsi:n..., tsi:npihpitsaktik tikihtowa, kwa:pitsa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>Wa:n yo:n de xo:chiowa ompa, ompa ki:sa ya ne:n para mochi:wa tsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts524">
                <ANNOTATION_VALUE>Wa:n yo:n a:mo se: kimati ka:..., ka:nachi to:nal para mochi:wa, ka:nachi me:stmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>A:mo no: tikmati katí:n, katí:n me:tsti, katí:n to:nal ne:n xo:chiowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>Pos no: *igual** neh nikita okseki pos no: ke:meh ekintsi:n *tiempo** xo:chiohtok yo:n okich, xo:chiohtok a pero okseki a:mo nikmati, ne:n okseki ke:maniá:n xo:chiowa no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>Pos moneki no: xkita wa:n ke:meh i:n se: monohno:tsa, se: mona:miktinemi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>Pos kwali tine:chili:s ke:maniá:n ne:n xo:chiowa para no: nik..., nikmattiá:s, ke:meh i:n pos se: mo..., se: molia ya pos se: kimattiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>Pos ta: tak yo:n no: kwe:liliah ne:n pio:tsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts558" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>De pata:nkawi:skeh xa: postekis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Mokepa no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>Xa: de posteki a, a:mo, a:mo selia ok, ne: xa, xa: xokoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>Mokepa no:, a:mo teh ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>Ke:meh sempowalxo:chit, pos no:, no:, no: moke..., no: mone:neki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Porin we:lik no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>kwaltsi:n tsope:k, mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>Pos yehwa yo:n a:mo, a:mo se: kimati pero nika:n timonohno:tstokeh pos nochi mah timoli:ka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Ke:ní:w ta:ki, ke:ní:w mochi:wa oso ke:maniá:n wa:n pos ihkó:n no: kwaltsi:n timomati:ltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>Pos a:mo tikmatih ekintsi:n timolihtokeh ne: tikmattia:tih no:, katí:n de *cimarrón** wa:n katí:n de n' okich wa:n katí:n tein, tein mochi:wa kwaltsi:n wa:n katí:n tein, tein kwaltsi:n tso..., yehwa tein chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>Seki kit a:mo tikmatih pero ekintsi:n timoma:l..., timomati:ltiah pos ekintsi:n tikmattia:tih no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Xa: te:chtahtani:skeh pos no: tikmattiowih katí:n tein we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Yehwa sah neh nik..., nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>A: we:noh, neh nimono:tsa Anastacio Nicolás Damián, neh no: niwi:tsa de ne: xola:l de San Miguel Tzinacapan.</ANNOTATION_VALUE>
