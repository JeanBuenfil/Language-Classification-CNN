        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Mo..., panweyakiltia, iwki mochi:wa, *hasta** iwki mochi:wa ayohtsí:n, ke:mah mosa:lowa ihkó:n, ihkó:n mahyá: mopihpilowa, ma:we:weyakaxtik ayoh. Ke:mah, ne: mosempilowa sikie:ra, koma:mo telmiak e:yi oso o:me oso koma:mo se:sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>Komo se:sah mopiloh, ye:kwe:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Wa:n pitsakweyak sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>Ka:n powetsi, kanah pero se:, de kostia, se: kiteki a, ko..., tikita kostik a 'teki a wa:n wi:ka ne: kalihtik mah 'tali me:sahpan ka:mpa a:mo kitipi:ni:s piotsi:n para mah a:mo kixokoli para kwaltsi:n oksi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Yo..., kanah, oksi soh tein ..., soh mah se: ki:tski, se: kiteki kwali, se: ki:tski wa:n mah a:mo se: kima:petsko, komo wehwel..., komo powetsik, moxokolia *porque** yo:n yema..., yema:nik semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>A:mo ke:meh tsontsapot, i:n komo t'ma:petskoh wehweliw a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Yo:n se: kiteki ika yo:li:ktsi:n, ika nehmachka:yo:t wa:n se: kikwi ika se:, se: ika se: ta..., se: morra:ltsi:n *o** teisá: kwali tikwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>Tikteki a n' ayoh wa:n ke:mah ne: tikta:lia me:sahpan para mah a:mo teh kima:toka piotsi:n, komo kitipi:nih, kwehwelowa ya, a:mo oksi ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Yeh yo:n chi:chi:ltik nimitsilia ita:kka wa:n ye:ktsope:k no: wa:n i:n seki ne: *papaya** tein yo:n kwa:ohololtik yeh kostik, no: tsope:k pero yeh kostik, no: taman ne:n itapalo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Ke:mah, ihkó:n neli. Neh n'mattok *porque** nik..., nikpia o:me, e:yi kowit de yo:n, yo:n kowtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Ke:mah nikmattok wa:n chika:waya ompa *mismo** mopahpampilowa kie:ra e:..., e:yi yo:n pihpitsa:wak sah, yo:n chi:chi:ltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>kie:ra ka:n chikwase:n n'teki, sepa n'tekiti o..., ol..., kohkostia ne:n ayoh, ke:mah, kie:ra ka:n chikwase:n n'teki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>Miak niman kite:maka wa:n ta..., se: kowit ta:ki ke:meh ka:n ... Panowa e:yi powal mopiloh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>Ke:mah, wehwei, wehwei ko..., wehwei ayoh, we:noh wehweitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Iwki de wehwei wa:n moye:kye:yewalo:ltia ihkó:n.</ANNOTATION_VALUE>
