            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Tsikitsi:n, ihkwí:n sah de wehkapan, se:*metro** wa:n tahko wa:n pihpitsaktik ompa mopilowa ayohtsitsi:n.</ANNOTATION_VALUE>
