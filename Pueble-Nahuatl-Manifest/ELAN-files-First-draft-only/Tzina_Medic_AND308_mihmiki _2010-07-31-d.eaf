        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>A:mo se: kikwi, ikowyo a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>No: se: kikwi tepitsi:n tein selik para se: kimana,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>pero se: kima:xakwalowa yo:n iyo:lselo, iselo se: kima:xakwalowa, kwaltsi:n moka:wa, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>A:mo kwaltia ok, yo:n *solamente para se: kimana,</ANNOTATION_VALUE>
