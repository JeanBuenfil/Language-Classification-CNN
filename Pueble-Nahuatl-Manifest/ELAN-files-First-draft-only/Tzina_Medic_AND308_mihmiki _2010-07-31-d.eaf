                <ANNOTATION_VALUE>ke:man se: mokokowa ka:nachpa n' te:makah wa:n *o** se: ... Wenoh, ihkó:n ke:meh tite:chtapowih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts102">
