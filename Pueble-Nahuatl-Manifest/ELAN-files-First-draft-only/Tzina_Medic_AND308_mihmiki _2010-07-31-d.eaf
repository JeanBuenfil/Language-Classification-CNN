                <ANNOTATION_VALUE>kwaltsi:n poso:ni ne:n de n' selik, kwaltsi:n ihkó:n se: kichi:chi..., nio:nó: te:ma:kokoh, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Onkak ihkó:n itech n' ohti oso ne:wí:n ka:mpa ne:n kahfe:ntah ihko:ni, onkak nejí:n xiwtsi:n wa:n ne:wi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>ne:wí:n ihkó:n itech n' ohti, se: kita wa:n i:n miak, miak ki..., kitasohtah i:n xiwtsi:n *porque** i:n semi kwali, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>A:mo semi kite:xi:mah, ka:wah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Pos i:n xiwtsi:n sie..., yeh ne: nik..., nikelka:w yo:n, es ke:meh tine:chilwihtok ika yo:li:k para se: kelna:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
