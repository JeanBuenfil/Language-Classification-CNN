            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>De timotapowiah ya tikmattokeh ya, pos tikwitih ka:mpa onkak wa:n tikchihchi..., tikchihchi:wah ya, timota:liliah ya ke:meh nika:n timotapowihtokeh pos tik..., *¡Qué mejor!** ke neli mah tana:mik ki:sa yo:n *remedio** xiwpah *porque** semi kichi:wa *falta**.</ANNOTATION_VALUE>
