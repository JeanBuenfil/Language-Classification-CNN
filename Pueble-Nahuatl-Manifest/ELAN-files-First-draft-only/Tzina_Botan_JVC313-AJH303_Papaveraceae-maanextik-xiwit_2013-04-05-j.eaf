        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>pos ne:h no: n'mattok no: para toni servi:rowa pero nik..., nika..., ke:meh i:n nika:n timoahsih pos timotapowiah ya ke:ní:w de toni servi:rowah.</ANNOTATION_VALUE>
