        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Ihko:no mah se:, mah se: motapowi *porque** koma:mo *este** tikmattok wa:n ... Se: kimattok ke servi:ro:s *remedio** wa:n a:mo tikilwia ne: mo..., *movecino, nopariente, o moamigos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Ne:n toni pahti pos ta:ká:n tana:mikiskia, *mejor** mah se: moilwi wa:n a:mo mah, mah a:mo se: kie:wto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Ihko:ni *más seguro** ki:sa, pos yehwa yo:n *este** ne: timotapowiah nika:n *este**, a:chá: ox i:pa yehwa sah yo:ni tikmati teh servi:rowa *o** xa: oksentaman *más** servi:rowa *porque** ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>Pos no: *igualmente** nehwa nikmati no: iwki sah neli ki..., servi:rowa *porque** ne:, ne: ka:mpa neh nietok *este** yetok se: we:i *mata** ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Wa:n miak tokni:wa:n kio:ntekih wa:n *este** tahtanih pero nikinilia pos yo:n a:mo, a:mo, a:mo nika:n ok, para nika:mpa ok, oksé: ya *dueño** pero xiktekika:n nikilia de que a:mo yetok no: *dueño** pos x'teki[ka:n]. Tik..., tikenkih *porque** mokokowa topili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Pos i:pa n'mattok yo:n para toni servi:rowa yo:n opochehkaxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
