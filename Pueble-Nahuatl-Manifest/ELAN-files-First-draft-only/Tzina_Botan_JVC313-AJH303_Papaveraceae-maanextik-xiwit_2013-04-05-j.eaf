        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>Para *remedio** yo:n okseki xiwtsitsi:n wa:n neli timolwiah de ke:ní:w tiki:xmattokeh, ke:ní:w ne:n nochi ne:n chihchi:wtok.</ANNOTATION_VALUE>
