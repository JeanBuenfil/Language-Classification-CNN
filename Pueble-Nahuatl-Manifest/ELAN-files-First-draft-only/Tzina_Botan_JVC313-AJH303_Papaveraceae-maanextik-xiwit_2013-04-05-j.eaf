        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Pero nikmati no: neh ke no: para *remedio** yo:n xiwtsi:n, *este** pos tikita ya ke i:n se: tanohno:tsa ke:meh ekintsi:n nika:n timoahsih wa:n timotapowiah.</ANNOTATION_VALUE>
