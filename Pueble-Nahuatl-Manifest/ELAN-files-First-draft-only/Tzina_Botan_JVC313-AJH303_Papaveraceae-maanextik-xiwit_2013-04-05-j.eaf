        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>Yo:n iwki yo:n para *remedio** wa:n oksé: tein yo:n kowyohxohxoktik oksé:, yeh opochehkaxiwit no: .</ANNOTATION_VALUE>
