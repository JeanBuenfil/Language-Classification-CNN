        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Para ihkó:n se: moye:kahsika:mati:ltia *porque** i:ksá: te:chnecita..., te:chnecita:rohtiki:sa pos at..., to..., kokolis a:mo tikitah totech, ke:maniá:n te:chkwis.</ANNOTATION_VALUE>
