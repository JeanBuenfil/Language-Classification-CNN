        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>*hasta** kwaltsi:n molo:ni, moka:wa ne: *aceite** ya.</ANNOTATION_VALUE>
