        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>De kimanah ke:mah ki..., molo:ni, molo:ni, kine:nelowah, kine:nelowah</ANNOTATION_VALUE>
