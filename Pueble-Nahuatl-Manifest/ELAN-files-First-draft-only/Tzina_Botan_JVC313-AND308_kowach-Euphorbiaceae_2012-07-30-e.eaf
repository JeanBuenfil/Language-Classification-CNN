        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Yo:n nehjó:n kichi:wayah ke:meh itech ne: *todos santos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Ne: nikitaya neh nowe..., nowe:..., ta: xo:taya, nowe:ina:nah kichihchi:waya, kimanaya, onkaya kowach ne: kowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Wa:n nehjó:n a:mo kowayah ok yo:n ekintsi:n tikiliah *veladora o** ihwa:k kikwiah, kikowayah pero yo:n kostikse:rah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Yeh kikowayah para *todos santos**. A..., a:mo, kikwiah para tane:x, kets..., ketsayah me:sahpan ne: kostikse:rah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>Wa:n yo:n nehjó:n *aceite** kit..., kite:mowa:ya nehjó:n teisá: tapalkat ne:n no..., nowei..., nowe:ita:tah ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>wa:n ki..., kiketsaya ihkó:n, kite:kayah ihkó:n, kite:kayah ya n' *aceite** wa:n kite:mowa:yah oso yo:n, kitekia yo:n, yo:n *sardina bote**, kahkanaktik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>wa:n ke:mah kitehtekia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Wa:n yo:n po:xne, po:xneyo:lo:t kiki:x..., kite:mowa:ya, kikalakilia:ya se: kowit ki..., kiki:xtia:ya po:xne wa:n de ki:xtia:yah po:xne.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts91">
                <ANNOTATION_VALUE>Ki..., yo:n i..., itech yo:n, yo:n tepos ikapa:pa:lo:t kiteki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>kimahmaxalowah ihkó:n wa:n ke:mah kite..., kitsi:nkalakilia ya ihkó:n mahyá:, para mahyá: e..., ika pata:ntos wa:n ke:mah kita:lia taihtik se: *pavilito** ko..., ko..., kipanki:xtiah ke..., we:i, ke:meh ahsi itsi:ntan ne:n tapalkat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>yo:n *pavilo** kita:lilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>wa:n ke:mah ne: yo:n, yo:n po:xne para ika a:i:xko yetos, ihkwí:n yetos ompa, a:mo, a:mo pankalakis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>Yo:n para, para a:i:xko yetos ihkó:n yo:n po:xne ne: ke:meh yemaxtik *o** ahoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>Taksatok mahyá: paniá:n ika wa:n ke:mah ne: kite:liah ya ne:n *aceite** wa:n kixo:taltiah ya wa:n xo:tatok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>*Hasta** tami, komo tamisneki sepa se: kite:kilia yo:n. Kanah, a:mo se:wi ke:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>Yo:n, yo:n kwaltsi:n yo:n no: n' i..., ki..., kitatia:yah, a:mo kikowayah ne:n *veladora** sanoke *aceite** kitatia:yah *todos santos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>Nochi, no..., yehwa ki..., kikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>Ke:mah wa:n kikwiah no: n' tane:x pero *ceritas** pero n' kostikse:rah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Yehwa kikwiah, itech powi todio:s, we:noh, *ánimas** kihtowah *porque** yo:n kichi:wah yo:n okwiltsitsi:n ne:n, ne: ki..., kichi:wah yo:n tatsa:wakse:rah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>Kostikse:rah kwiah wa:n wehweinekmeh no yeh, no: ye..., yo:n kwaltsi:n no: tatsa:wakse:rah *porque** kwaltsi:n mochihkolowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>wa:n yo:n weh..., weh..., wehweinimeh kichi:wah inse:rah yeh no:, no: kichi..., no: ye:kkwaltsi:n kichi:wayah para, para kixo:taltia:yah no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Yo:n kikwiah nikita pero yehwa yo:n ... Ke:mah wa:n yehwa yo:n nimitsilia n' ko..., ne:n kowach, ne: nikiliah ne:n *aceite** kowach, iwki kito:ka:itiah *porque** kichi:wayah *aceite** achto, ekintsi:n a:mo tiki:xmatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>A:mo t'chi:wah kwe:ntah tik..., a:mo t'chi:wah kwe:ntah, a:mo t'matiliah ke:ní:w tikchi:waskeh, a:mo t'matih *porque** a:mo tiktsi:ntokah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Pero komo t'tsi:ntokah ke:ní:w kichi:wayah achto</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>Seki ta:tahmeh ke:meh tehwa:n tikmattokeh tiktapowiah mah, mah kichi:waka:n wa:n mochi:wa *aceite**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>wa:n iwki yo:n i:n seki:n nok..., noktakowach, tein yo:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>We:lik, ne: sentaman we:lik pero yo:n tein we:lik nehjó:n ohololtik sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Ohololtik yo:n, yo:n kowtet</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>wa:n *cuando** kostia ya ko..., kohkostik mochi:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Ke:mah komo tiktekiti kohkostik, tikpihpixka ne:nke:n tatapaka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>wa:n yo:n tein, yo:n kwaltsi:n se: kitewa:tsa no:, se: kwa:tsa wa:n ke:mah se: koma:ltewa:tsa, kwaltsi:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Iwki sah se: takwa ika, mahyá: ayohwach.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Wa:n yo:n se:ki onkak, seki onkak noktakowach te:pahwih, a:mo kwali se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Yeh telma:yohyowaltik wa:n yeh ekapitseh ihko:ni, komoke i..., ima..., ima:xiwyo i..., ehekapitseh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Ma:yewaltik wa:n yekapanpitsa:wak no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>wa:n ma:ti..., ma:tilaktik yo:n tein te:pahwih, ma:tila:wak tepitsi:n, ma:kahkakaltik ke:meh xi:kalkowit ima:i, ma:tilaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Telma:tila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>Wa:n i..., iteyo ne: ita:kka mochi:wa, tepitsi:n we:weyak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>we:weyak tepitsi:n, yehwa yo:n a:mo kwaltia para se: kikwa:s, yo:n te:pahwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Yo:n te:pahwih. Yo:n kikwih s..., a:it ke:ní:w pero te:pahwih, *porque** yo:n kikwih sayoh para no: *aceite** kichi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Para *aceite** kichi:wah no:, ta: i:n seki noktakowach nochi kwaltia para *aceite** *por eso** kiliah kowach</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>pero i:n seki kwali se: kikwa, se: kitewa:tsa, se: ikatakwa pero mo..., se..., komo kinekih kwali kwe:chowah wa:n no: kichi:wah *aceite** weli no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Ke:mah, pero tehwa:n tikwa:yah sah, kichi:wayah *aceite** yehwa ne:n yo:n kiliah *aceite** kowach, onkaya yo:n nextik wa:n onkak tein chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>*Porque** ne: kowtah tehwa:n onkaya yehwa yo:n, *hasta** ekintsi:n onkak ne:n xina:ch kowmeh, yetokeh wehweikomeh yo:n no..., noktakowach</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>yetokeh nohma pero yehwa tein we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Yetokeh, wehwei kowmeh mochi:wkeh, sehse: tanawa:l ne:n itsi:ntan, wehwei kowit, ke:meh yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
