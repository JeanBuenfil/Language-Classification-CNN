            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>Wa:n kilia:yah, kita:lia:yah kalkwa:ko para mah wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>Kita:[lia:]yah kalkwa:ko wa:n kitayah de, de, de wa:kia no: tsihtsili:nia ya, ihkó:n pané: ahoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>Ke:masá: iteyo no: tak wa:kia *hasta** iteyo, mokahka:wa wa:n achi tsihtsili:nia no:, ahoktia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>Yehwa yo:n tikitayah ke:masá: kiketsayah ahko ne: kito:nal..., kihtowah ne: nikto:nalwa:tsati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Entó:s ne: kito:nalwa:tsati, kita:liah ne: para mah kimaga ne:n to:naltsi:n, de me:yo:tsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>wa:n yehwa yo:n ne:n kwa:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>kwa:tsa wa:n *después** kite:tewa:tsayah, a:mo wehka:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Kima:manelowa:yah ika yo:n kowtsí:n wa:n pos ne:nke:n tewa:kia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>De tewa:kia pos yehwa yo:n ki..., ki..., ki..., kikwiah ya wa:n no: nikitaya neh *cuando** ki..., ki..., ki:xtilia:yah n' ie:wayotsi:n pos nehjó:n kikwechowa:yah itech metat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>Ki:sa ne:n ie:wayo, moka:waya yo:n ihista:k, sayoh iteyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>yo:n achi ne:nke:n te:wa:kia, kita:lia:yah ne:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>Wa:n kachi ne:nke:n tewa:kia, kima:nelowa:yah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>Pos no: kwaltia ihkó:n se: kwa:ya, seki ika se: ma:takwa:ya sah wa:n yo:n semi we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>Semi we:lik pero i:n seki pos no: kwiah para yehwa ne:n tane:x kikwiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>Pero a:mo nikmatia neh ox no:, ox no: we:lik semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>Yehwa kikwiah para ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>Ihkó:n no: nik..., nikitaya ihkó:n ne:n ki..., kichi:wayah wa:n yehwa yo:n, para yo:n ika se: mopahtia:ya yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>No: kwaltia para ne: se: mopahtia ke:meh i:n kone:tsitsi:n no: ke:meh i:n kipano:ltia:yah no: de in..., intakwal *o hasta** i:n tehwa:n komo tikpano:ltiah de totakwal, no: ti..., pos te:chchi:wilia *mal** pos yehwa yo:n pahti no:, no: kwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>Wa:n kita..., te:chta:lilia:yah *o** kinta:lilia:yah ne:n kone:tsitsi:n pos kina:mikia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>Kina:mikia soh ke kikwiah, kikwiah sikie:ra ka:n na:wi xiwtsi:n wa:n ika kite:tsi:lowa:yah nochi yo:n, no: kita:lilia:yah yo:n tikownex.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>No: kita:lilia:yah, entó:s ika te:poxpahpachowa:yah, nochi se: ipoxko, se: i:ka:n nochi te:pahpachowa:yah wa:n pos seki te:poxpi:kiah ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>Te:poxpi:kiah no:, pos yo:n no: kwali katka, yehwa yo:n neh sayoh nikmattok, teh xa:, xa: kachi tikmati ke:ní:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
