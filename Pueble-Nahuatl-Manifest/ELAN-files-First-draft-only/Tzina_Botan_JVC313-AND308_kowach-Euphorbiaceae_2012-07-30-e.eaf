        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Wa:n no:, no: se:ki kikwi pahti ke:meh yo:n moihtikokowah tokni:wa:n seki ihtiolo:nih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>no: kikwih, no: kwaltia ixiwyo, kiliah ne: yo:n, yo:n ko..., kowachxiwit ika ki..., tatahkotikonex kikwih wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>wa:n kia:lpi:chiah wa:n ika kimpahpachowah yo:n tein, tein, tein ihtioli:nih, no:, no pahti yo:n kikwih xiwit, yo:n xiwtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Wa:n nehhjó:n yo:n *aceite** kowach nimitsilia, nochi o:..., nochi o:me taman kikwih para kichi:wah yo:n chia:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Ki..., ki..., yo:n kitekih ne:n kowtet wa:n ki..., kito:nalwa:tsah wa:n nehjó:n ki..., kito:nalwa:tsah ki..., kitewa:tsah *o** kipihpix..., kipihpixkah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
