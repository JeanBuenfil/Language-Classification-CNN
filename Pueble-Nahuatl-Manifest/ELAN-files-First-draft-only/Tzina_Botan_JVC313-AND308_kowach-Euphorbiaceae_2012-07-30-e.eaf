        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>i..., tepitsi:n kite:liah a:tsí:n wa:n ke:mah kinelowah, kinelowah</ANNOTATION_VALUE>
