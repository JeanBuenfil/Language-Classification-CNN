    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="Anastacio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>Pos nejó:n pa:pa:lo:kowit neh nik..., nikmati no: de que pos nika:n tine:chtahtanihtok, nehhjó:n pa:pa:lo:kowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>pos wehkapantia, mochi:wa mela:wak wa:n wehkapantia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>Wehkapantia *cuando** ... Yo:n kiliah pa:pa:lo:kowit *porque** n' ima:i ya ke:meskia yo:n pa:pa:lo:t, yo:n kostikeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>*por eso kiliah pa:pa:lo:kowit pero yo:n pos no: kihtowah seki kwaltia para ne:n pahti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Entó:s iwa:n kima:nelowah ya okotsokowxiwit tikiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>entó:s kima:nelowah wa:n ki..., kim..., we:..., we:noh kima:nelowah *entre** n' o:me:n wa:n kimanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>Yehwa nejó:n neh niki:xmati *porque** pos ihkó:n tota:tahwa:n te:chilia:yah ke nejó:n semi kwali nejó:n pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Ke:masá: nejó:n niman se: kone:tsi:n ne:wi:n yetok wa:n kitapa:kiah itech se: na:nahtsi:n i..., ka:mpa itilmah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>wa:n kichi:wa ne:n, kichi:wilia ne:n, no: ki..., kokolispe:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Kiliah ne: netati:l</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Netati:l kilwiah yo:n mochi:wa *rueda** itech ihkó:n, nika:n se: ima:ko oso nika:n se: ipoxko pané: tehtewa:ki, a:pehpeyoltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>wa:n yehwa yo:n kiliah ne:n netati:l wa:n ika ne: kimanah nejó:n xiwit wa:n ika te:..., te:a:ltiah *o** ka:ltiah kone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>Entó:s *por eso** kiliah yo:n netati:l, nejó:n, nejó:n netati:l *porque** nochi se: ipoxko *o** se: ipanko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>yo:n ke:meskia nejó:n a:pehpeyoltia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Ke:mekia nejó:n tata, wa:ki, *por eso, por eso** kiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>*por eso** kiliah netati:l, netati:l *porque** tata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n kone:meh de *que** pos ke:masá: a:mo pahti ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>wa:n ekintsi:n pos yehwa yo:n pa:pa:lo:kowit tikiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>pos wehkapantia, pos ke:masá: no: kwaltia para kali se: ki..., kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Para kali de n' ihkwi:ntsitsi:n de no:, no: kwaltia, para kale:wal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Pero *demás** wehweya, wehkapantia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>Wa:n de sepa chika:waya nejó:n pa:pa:lo:kowit ixiwyo, mochi:wa kohkostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>De kohkostik, ke:mah de taeheka, xi:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>Pa:pata:ntiw, wehka wetsiti. Ke:masá: ta:lpan miak, miak mote:wa wa:kik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Miak mote:ma wa:kik wa:n yo:n pos *a veces** ke:masá: no: se: kimowilia, ke:masá: no: mota:lia yo:n kowa:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>Monepanowa wa:n yo:n soh xiwit pos yo:n pos no: *igual** pero yeh no: achi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Yeh ihkó:n se: kima:xakwalowa ya, ye:kse: kihnekwi, ye:kkwaltsi:n ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>kwaltsi:n ahwia:k yo:n xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>wehkapantia ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>wa:n ompa momahmaxalowa ya, momahmaxalowa ya wa:n pos mowe:ita:lia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>A:xka:n no: ke:ma:sá: pos se: kitekiti se: ihkó:n se: takechtil, ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>wa:n se: kwi:ka i:n, iwa:n se: kim..., [ki]ta:lilia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>Nejó:n ma:ta:nkehxiwit pos no: se: kwiti wa:n o:mekilit wa:n se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>se: kisemana ya iwa:n ya. Ke:mah, *hasta** ma:kwi:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>[y]ehwa ne:n, ne:n chakai, o:mekilit, ma:ltantsi:n, yo:n *escobilla** inalwayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>nejó:n tsi:tsika:s, yo:n de n' tsikitsitsi:n, tehtsonkilit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>wa:n yehwa yo:n ma:ltantsi:n wa:n pos seko sah nochi se:, se: kisenta:lia itech se: ko:mit ihkó:n se: kita:lia wa:n se: kimanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Se: kimanah, ke:mah ika ka:ltiah ya se: kone:t, *o** tsikitsi:n no: kwali kitai:ltiah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>Kitai:ltiah no: wa:n yo:n kiliah teahwach. Teahwach no: kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Xa: tiki:xmati teahwach. Yo:n teahwach e:wi itech tetsitsi:n ihkó:n, ihkwi:kwi:n de we:i, mahma:yeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Nik... nejó:n xoxoktik, yehwa yo:n teahwach iwa:n kima:nelowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>*Hasta ne:n pi:na:wits inalwayo no:, no: kikwih, *por eso** nochi yo:n okots..., okotsokowkowxiwit nochi kima:nelowah iwa:n pa:pa:lo:xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Entó:s yo:n ye:kmiak taman de yo:n xiwtsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Miak taman kima:nelowah wa:n pos kimanah ya, miak a se: ko:mit ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>wa:n achto kimanah, ke:mah mah se:wi, de mah se:wi, ke:meh ekintsi:n kimanah mo:stika ne:n ka:ltiah ya se:, se: kone:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>Konetsi:n, ke:mah ka:ltiah ya wa:n ke:mah kitasowiah wa:n ke:mah kite:katih ya pero tsikitsi:n no: kitai:ltiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>*porque** n' o:mekilit semi kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Semi. Pos nejó:n o:mekilit kwaltsi:n *cuando** a:mo se: maya:na, entó:s te:chilia:yah tota:tahwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>kwiti tsikitsi:n o:mekilit wa:n xkechili ne: pili, ne: kone:t mah tai *porque** a:mo maya:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>Entó:s ika yo:n o:me kilit, yo:n ika se: takwaliskwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Yo:n kwali no: se: kikwa ihkó:n, ampo:wi:n onkas nika:wí: kltsi:ntan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Pero pos yehwa yo:n nochi nejó:n neh nikmati, nikmati nejó:n okostokowxiwit, yo:n semi kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Wa:n pa:pa:lo:kowit kima:nelowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>Pero yo:n pos no: nochi a:mo se: kimati sah pero, pero *demás** nochi pahtsitsi:n pero para kisenchi:wah para yo:n netati:l</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts225">
                <ANNOTATION_VALUE>pos yehwa yo:n kina:miki ne:n kone:meh, kinina:miki. Nejó:n semi pos kina:ltiah *siquiera** ohpa *o** e:xpa kina:ltiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>wa:n seki ke:masá: kinka:wiliah nika:n inpa:nko, mah ompa moka:wa ne:n yo:n tsikitsitsi:n, xiw..., xiwpach.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>Nochi kinka:wiliah nika:n wa:n ki..., mah mote:kaka:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>pos yo:n yehwa ya ne:n ki..., kimpale:wia, pahtih. Nejó:n *después** ihkó:n wa:ktiw, wa:ktiw ya ne: kokotsitsi:n nochi nika:n yo:n nika:n yo:n wa:ki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Ke:mah, moka:wa achi, achi tahtaman, nika:n *ruedas** pané: yo:n yohyowaltik, ista:k wa:n chihchi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>Pero *después** sepa ihkó:n moka:wah, de pahti ya kwaltsi:n alaxtiaya. Al..., moalaxowah ya wa:n yehwa nejó:n ekintsi:n pos yehwa yo:n neh nik..., nikmattok *compadrito, aver** teh xa:, xa: kachi no: tikmatis de nejí:n pa:pa:lo:kowit wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>Pos neh nikmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Pos yo:n pa:pa:lo:kowit n' i..., ixiwyo, a:mo ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>Pero yo:n a:mo no: kimatiah, ta: yo:n ke:meh i:n se: monohno:tsa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>pos xkwiti ne: pa:pa:lo:xiwit wa:n ne: okotsokowxiiwit, xma:nelo wa:n okseki xiwtsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>Pos miak taman, sayoh mah a:mo se: kelka:wa ke:meh neh nika:n ... A:mo nikelka:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>A:mo nikelka:wa *porque** tikmatih topi:pilwa:n ke:ní:w para tikiskalti:skeh, nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>Ma:ta:nkeh, tehwa:n tikiliah ma:ta:nkehxiwit, yo:n iselo. Iselo se: kikwi wa:n chakaixiwit, o:me kilit, yehwa ya ne:n teahwach, ma:ltantsi:n, nochi wa:n pi:na:wits inalwayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>yo:n *escobilla**, ochpa:wa:s tikiliah inalwayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>yo:n tsi:tsika:s, yo:n tsikitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>n' tehtsonkilit iselo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>pos miak nochi se: tama:nelowa wa:n se: kiketsa, se: kiketsa itech i:n ko:ntsi:n, se: ko:mit ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Ompa se: ketsa wa:n te´pitsi:n moa:yohtokotsowa wa:n ke:meh ekintsi:n kimanah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>wa:n i:n mo:stika ya ne:n ika ka:ltiah se: kone:t, *no**, pos yo:n semi kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Yo:n kwali *porque** ke:..., ke:masá: pos ki..., se: kone:t no: taman</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>kitapa:kiah ne:wi:n okseko ka:mpa se: na:nahtsi:n, se: siwa:tsi:n motapa:kia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>wa:n mopolowah no: n' tapa:kanih pos kwi:kah ne:pa intilmahtsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>wa:n ke:masá: ye..., nejó:n itech nika:n se: i..., a:mo se: chika:wak pos te:kwi yo:n kokolis *por eso** kiliah netati:l. Pero nejó:n ekintsi:n yehwa nika:n ni..., nimitsilwihtok *compadrito**. Ke:mah wa:n kwali tine:chilwi:s nejó:n teh xa: kachi tikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>Ke:mah. A:, pero toni ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
