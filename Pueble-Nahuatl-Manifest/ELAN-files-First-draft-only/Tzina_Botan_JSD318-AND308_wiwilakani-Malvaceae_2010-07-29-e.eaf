        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>Pos nomoma:n ompa kisegui:rowilih yehwa yo:n pahti no:</ANNOTATION_VALUE>
