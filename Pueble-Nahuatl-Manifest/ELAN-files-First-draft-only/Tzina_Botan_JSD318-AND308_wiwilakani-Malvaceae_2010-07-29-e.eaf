        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Mah molo:ni, molo:ni, wehka:was, wehka:was, kichi:was se:, se: kwali *rato**.</ANNOTATION_VALUE>
