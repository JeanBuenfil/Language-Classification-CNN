        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Me:nohpero neh nimolia ke yo:n ista:kwiwilakani ke komohkó:n a:mo mitsna:mikik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>se: tein, tein onkak, tein kitekiti:wih yekinika,</ANNOTATION_VALUE>
