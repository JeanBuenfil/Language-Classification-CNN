        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>*O sea** tein nika:wí: te:chne:xtilihkeh wa:n a:kin a:mo kineltokak pos yehwa ya yo:ni komo kitilia tepisti:n teisá: kikokowa ipili.</ANNOTATION_VALUE>
