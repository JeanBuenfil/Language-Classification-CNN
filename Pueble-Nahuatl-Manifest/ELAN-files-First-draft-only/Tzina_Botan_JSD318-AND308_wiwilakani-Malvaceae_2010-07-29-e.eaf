        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts988" TIME_SLOT_REF2="ts991">
                <ANNOTATION_VALUE>Yehwa kichala:nili:skeh ya mokoko, mm wa:n i:xtewa:kis.</ANNOTATION_VALUE>
