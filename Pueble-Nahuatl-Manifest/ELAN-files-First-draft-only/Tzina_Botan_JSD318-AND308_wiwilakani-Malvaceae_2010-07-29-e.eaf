        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts974" TIME_SLOT_REF2="ts976">
                <ANNOTATION_VALUE>Wa:n komohkó:n, komohkó:n *este** a:mo mitsna:miki, kimanaskeh wa:n mitstai:lti:skeh tsiktsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts980" TIME_SLOT_REF2="ts981">
                <ANNOTATION_VALUE>A:xka:n komohkó:n tikokoti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts982" TIME_SLOT_REF2="ts983">
