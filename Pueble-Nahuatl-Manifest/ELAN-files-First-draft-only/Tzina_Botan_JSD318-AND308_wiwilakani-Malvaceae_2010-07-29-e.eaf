        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Wa:n seki ika yehwa yo:n pahtsitsi:n, de xiwit,</ANNOTATION_VALUE>
