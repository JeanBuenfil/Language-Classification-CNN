        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>Ika yo:n pahtsitsi:n tein, tein te:chne:xtilihte:wkeh towehka:wkayo:ta:tahwa:n.</ANNOTATION_VALUE>
