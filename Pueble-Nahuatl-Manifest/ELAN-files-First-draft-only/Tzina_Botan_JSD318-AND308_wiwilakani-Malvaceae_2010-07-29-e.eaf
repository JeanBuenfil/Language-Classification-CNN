        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts953" TIME_SLOT_REF2="ts956">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
