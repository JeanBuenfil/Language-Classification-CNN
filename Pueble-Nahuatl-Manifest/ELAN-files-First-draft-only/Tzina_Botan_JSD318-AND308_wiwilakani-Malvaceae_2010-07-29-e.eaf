        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>Wa:n tikita ya *cuando** tipilimeh a:mo teh tiktasohka:matih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>Entonces** nikilia no:má:n "*Mamá**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>"Wa:n ke:yeh tikna..., tikilwihtok ne: ta:wa:nkeh ke toni ne:chmaka, pos ox ne: ne:chmakati pahti"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>"Monka:n tikita tapahtihkeh ta: wintitok".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>Niktawe:lmat. *Entonces**, de ... Pero nomomá:n a:mo kichi:wak kwe:ntah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>Tein ke:mah yeh kichi:wak yo:n, kitewa:ts n' tao:l wa:n ne:chta:lilih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>Yeh kineltokak ke:ní:w ne: *porque** kia:bur..., ki..., kio:meyo:lo:tihtoya ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>Kio:meyo:lo:tihtoya ya, a:mo kimati a ok toni ne:chna:mikis,</ANNOTATION_VALUE>
