                <ANNOTATION_VALUE>Tikwah se: pahpata wa:n timaya:naya wa:n mitschi:wili:s *mal**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
