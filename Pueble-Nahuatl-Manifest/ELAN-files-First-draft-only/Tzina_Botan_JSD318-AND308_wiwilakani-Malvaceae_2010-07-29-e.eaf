        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts838">
                <ANNOTATION_VALUE>Pos nika:n tikihtowah ke yehwa yo:n timoyo:lmahxitiah.</ANNOTATION_VALUE>
