        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts921">
                <ANNOTATION_VALUE>Wa:n oksé: ma:talin yeh tamparaya:doh, mm.</ANNOTATION_VALUE>
