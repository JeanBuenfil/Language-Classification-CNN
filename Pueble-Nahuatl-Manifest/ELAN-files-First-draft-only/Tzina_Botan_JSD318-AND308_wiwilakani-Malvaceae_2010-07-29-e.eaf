        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>*porque** no: niman mo..., mo..., niman mone:xtili:s, *o sea** niman kitaskeh.</ANNOTATION_VALUE>
