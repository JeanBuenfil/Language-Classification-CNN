        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>wa:n yo:n se: *litro de** a:t kiwa..., kitsokowa:tsaskeh.</ANNOTATION_VALUE>
