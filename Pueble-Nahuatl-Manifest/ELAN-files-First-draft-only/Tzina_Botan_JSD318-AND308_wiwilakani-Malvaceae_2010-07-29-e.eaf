        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Wa:n ke:mah para te:chmakah ya tota:tahwa:n mah titai:ka:n</ANNOTATION_VALUE>
