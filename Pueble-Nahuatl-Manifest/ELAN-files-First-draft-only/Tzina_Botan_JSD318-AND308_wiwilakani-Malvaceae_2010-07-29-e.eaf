        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>Mm wa:n *entonces** yehwa yo:ni kite:mowah.</ANNOTATION_VALUE>
