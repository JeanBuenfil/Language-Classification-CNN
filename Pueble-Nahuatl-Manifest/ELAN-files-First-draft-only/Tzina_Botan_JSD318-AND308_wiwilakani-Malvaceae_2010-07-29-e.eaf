        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Mitskwis yo:n estsompi:l, iksá: tisekwis,</ANNOTATION_VALUE>
