        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>Tika:wati:w nochi esti, *puro** chi:chi:ltik *porque parejito** chi:chi:ltik *porque** esti.</ANNOTATION_VALUE>
