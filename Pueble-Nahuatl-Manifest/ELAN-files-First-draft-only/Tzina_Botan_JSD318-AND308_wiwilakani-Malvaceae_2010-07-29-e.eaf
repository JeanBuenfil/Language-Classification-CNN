        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>wa:n *siempre** komo mitsna:mikik no: niman momakah kwe:ntah</ANNOTATION_VALUE>
