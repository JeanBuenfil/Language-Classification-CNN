        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>Mah molo:nto, *una vez** moka:waki:w *o sea** un..., ke:meh moka:waki:w se: *taza** ya sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Se:, se: *este** tepitsi:n ya sah n' a:[t], kitaskeh ke a:mo semi miak ok, mm, *entonces** para mitsmakaskeh xitai a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>Wa:n ompa ke:mah kichiaskeh komo kitah a:mo tiow ok n', a:mo tiow ok kalan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>entó:s mitsna:miki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>A:mo wehka:wa sepa kikwiti:wih seki wa:n sepa seki kimanaskeh wa:n mits..., se..., mitstohtokaltili:skeh de xita:tai a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Sayoh ke a:mo titai:s kahbe:ntsi:n *porque** mitsilwi:skeh ke kahbe:ntsi:n mitschi:wili:s sepa yo:n kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Wa:n komohkó:n tipahtisneki pos no: timoxi..., no: timoihyowi:lti:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>We:noh, pero komo ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>Pero neh nikihtowa ke komohkó:n tiknelowa wiwilakani iwa:n oksé: xiwit tei no:, no: kit..., no: kihtowah no: tapahti:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>No: kiko..., koto:na yo:n kokolis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>pos a:mo tikmatiti ok kati:ni mitsna:mikik, kox wiwilakani oso yo:n oksé: xiwit tein kiwa:lkwitoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Wa:n para titakowtamatiskeh ke kati:ni ne:n pahti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>Pos monekis yehwa sah yo:n o:me:n tikimpataskeh *de mismo** to:ka:it kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>*De mismo** wiwilakanimeh ti:ltik, ista:k *o** chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Ka:n yehwa, ka:n yehwa ki:xmatih ta:la:mat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>*Porque** ta:la:mat no: se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>A:, ta:la:mat yo:n, yo:n se: kwiwita wa:n nika:n itsi:ntan kipia ke se: ihkó:n yewaltik pané: yo:n ikamohyo.Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>A:mo, ta: no: nalwayowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>Wa:n yo:n ta:la:mat no: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Pero neh nikihtowa ke ta:la:mat a:mo wel tikwiskeh iwa:n ya wiwilakani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>Tein ista:k wiwilokani*primero** se: kimanaskia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>wa:n *después** a n' tein yo:n, tein witsioh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>de yo:n ma:pa:pata:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>Wa:n *después** a oksé: tein yo:n tikihtowa tehko kowtikpak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>para ihkó:n timokas..., timo..., tik..., tiki:xmatis kati:ni mitsna:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>*Porque** komohkó:n tiknelowa iwa:n okseki, pos a:mo t'matiti kati:ni mitsna:mik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>wa:n kokolis es..., estsompi:l ta:taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Mitskwis chi:chi:ltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>*o** mitskwis yo:n achi, komoke wihwila:ni sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Wa:n mitskwis se: tein, [be], *este** sayoh ala:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>pero semi mitskokowa, semi te:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Semi te:kokoh, nochi senkopi:ni se: itahtahkoya:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>Mitskoko:s *hasta** motsontekon</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>*porque** ke:yeh yehwa yo:n, yehwa yo:n *este** tein tikmachilihtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>Ti..., ke:meskia yo:n mits..., mitski:tskihtok, se: titotomoka wa:n a:mo tikmati ok ke:ní:w eski</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>wa:n *hasta** mitskokolaki:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>nió:n *ganas**, nio:nó: tikpias chika:walis para tinehnemis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>A:mo tikpia chika:walis para sikie:ra tiwetstos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>nochi tiktatsiwilia timoketste:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Yehwa yo:n mits..., mits..., mits..., mitspechia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>Pos ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>*Por[que]...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>*Eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>Ne: wehka:w neli, a:mo kachi onkaya koyo:meh tein te:chmakaskiah pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>*Siempre** mokwehmolowa:yah sayoh tote:iskaltihka:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>Neh nikitak ihkó:n se: *tiempo** niwetsik itech yehwa yo:n kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>Nikchi:wak ke:manih se: sempowal to:nal *más**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>*cerca** se: me:tsti, nitamikokolaka ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts538">
                <ANNOTATION_VALUE>Wa:n nochi, nochi ke:meh tikihtowa wiwilakani,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>wa:n nochi yo:n tein ista:k, tein ti:ltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>wa:n yo:n ma:talin, sentane..., senta:tanemilihkeh pero sehse: kimanayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>Wiwilakani oso wiwilakani sehse:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>a:mo se: ne:chna:mik, ta:la:mat, a:mo se: ne:chna:mik, ihkó:n tein weli, ihkó:n pahtsitsi:n kin..., kinyo:lmahxitia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>para mah ne:chpahti:skiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>Wa:n ninohne:l katka ok, *entonces** a:mo ke:man n' kahxilihkeh toni ne:chna:mikis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>wa:n n' niow, niow kalan *cada ratito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>*Cada ratito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>Wa:n se: *tiempo**, se: *señor**, se: ta:tahtsi:n, wa:lah wa:n kochiko nokalihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts569">
                <ANNOTATION_VALUE>Nopopá:n kiwa:li:kak, ke:meh nopopá:n semi ta:wa:naya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>Entó:s kiwa:li:kak yo:n ita:wa:nka:ikni:w mah ompa kochiki *porque** yo:n ta:tahtsi:n katka de Tepetzintan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>Mo..., mo..., mo..., mo..., mono:tsaya Agustín Amado Tepetzintan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>*Entonces** yo:n ta:tahtsi:n kimakakeh ya tapech wa:n mote:kak ihkó:n me:sahi:xte:nte:noh wa:n neh ke:meh ne: nikochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts586" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>Wa:n nomomá:n ompa ne:chkwida:rohtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>Wa:n *entonces** kilia "pos ki..., toni kilia mo..., kimaka mopili", kilia "pos ta: i:n estsompi:lti".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>"Estsompi:l" wa:n kilwia "pero semi kwali" kilia "na:nah wiwilakani".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>"Yo:n tein ti:ltik oso yo:n witsyoh oso i:n seki, i:n ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>¡Manili!". "Ka:n teh kina:miki ta:tah" kilia *porque** kit..., tiktamima:makakeh ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>nochi *hasta** ta:la:mat, xa:lxokoe:wat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts609">
                <ANNOTATION_VALUE>pero a:mo teh kina:miki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Wa:n xikita" kilia "tel *seguido** yowi, yowi kalan". "A: pos" kilia "xikchi:wa se:, oksé: taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>xiko:ya" kilia se: sinti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts619">
                <ANNOTATION_VALUE>Se:, mm, se: sinti" kilia "xiko:ya tein tsi:kat".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>"Wa:n xiktewa:tsa itech koma:l, tatewa:ts wa:n xika:lpi:chi ika, ika, ika refi:noh".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>"Wa:n yo:n refi:noh" kilia "ika xika:lpi:chi".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>Wa:n ihkó:n ke:meh tohtoto:nik" kilia, "ke:meh taxi:ko:s ika ihkó:n xikmahmaga" kilia "nika:n ikwitte:ntikpak *porque** sektok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>Tao:ltsi:n tatewa:ts, ta...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts643">
                <ANNOTATION_VALUE>Mm, a:mo. A:mo, a:mo ta: tatewa:ts.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts645" TIME_SLOT_REF2="ts647">
                <ANNOTATION_VALUE>Entó:s ka:lpi:chichi" kilia "ika refi:noh wa:n ompa ihkó:n" kilia ika x'mahmaga".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>"Nika:n"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>*Porque** mopili" kilwia "sektok".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>"*Cuando** kochi, *cuando kochi mo..., mopehpeta:wa".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>"Wa:n *por eso** sekwik"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>"Wa:n *entonces** ekintsi:n ..."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>"I:n mopili" kilia "a..., de a:mo teh kina:miki a nochi a i:n pahti tein xiwtsitsi:n tiki..., timits..., tikmatih no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>pos *ojalá**" kilia "dios kitio:chi:waskia mah kina:mikiskia ya".</ANNOTATION_VALUE>
