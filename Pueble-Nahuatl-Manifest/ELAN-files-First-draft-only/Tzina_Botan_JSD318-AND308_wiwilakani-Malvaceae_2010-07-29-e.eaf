        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>kitekitih wa:n te:chmaniliah neh nimol..., we:noh nikitaya.</ANNOTATION_VALUE>
