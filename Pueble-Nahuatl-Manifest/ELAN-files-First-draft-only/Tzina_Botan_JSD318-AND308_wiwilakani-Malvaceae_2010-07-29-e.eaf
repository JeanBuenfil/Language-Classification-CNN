        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts992" TIME_SLOT_REF2="ts994">
                <ANNOTATION_VALUE>A:mo moneki tapahtihkeh koyo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts999" TIME_SLOT_REF2="ts1001">
                <ANNOTATION_VALUE>Pos nika:n i:n, yehwa i:n timo:yo:lmahxitiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts1003" TIME_SLOT_REF2="ts1006">
                <ANNOTATION_VALUE>Ika i:n teisá: wa:n kipia de tikintapowi:skeh *hasta** topiliwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1011">
                <ANNOTATION_VALUE>*Porque** topi:piltsitsi:n ti..., *más** ne:paka, *más** tapati:yowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts1012" TIME_SLOT_REF2="ts1013">
                <ANNOTATION_VALUE>wa:n panki:sa de ipati:w teisá:, koyo:meh kite:tehkoltiah ipati:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts1014" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>*porque** yehwa:n pos ompa ya no: motekipano:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts1018" TIME_SLOT_REF2="ts1021">
                <ANNOTATION_VALUE>Wa:n topiliwa:n koma:mo kipiakeh tomi:n para mopahti:ti:wih ompa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts1023" TIME_SLOT_REF2="ts1025">
                <ANNOTATION_VALUE>Pos kipia de kite:mo:skeh yehwa:n yo:n xiwtsitsi:n wa:n para no: mopano:lti:ske. No: mokwida:ro:skeh ika, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts1027" TIME_SLOT_REF2="ts1030">
                <ANNOTATION_VALUE>Ihkó:n *mero**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>E:yi powal, e:yi powal xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts1045" TIME_SLOT_REF2="ts1048">
                <ANNOTATION_VALUE>ika e:yi xiwit *más*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a608" TIME_SLOT_REF1="ts1049" TIME_SLOT_REF2="ts1051">
                <ANNOTATION_VALUE>We:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610" TIME_SLOT_REF1="ts1055" TIME_SLOT_REF2="ts1057">
                <ANNOTATION_VALUE>Neh a:mo. Neh nimono:tsa Juan de los Santos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612" TIME_SLOT_REF1="ts1061" TIME_SLOT_REF2="ts1063">
                <ANNOTATION_VALUE>Nikpia e:yi powal wa:n mahtaktio:mo:me xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a614" TIME_SLOT_REF1="ts1065" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>Wehka:w ya nikinitilia:ya, nikinitilihtiwa:la:ya taskaltia:nih ke:ní:w moservi:rowah wa:n ke:ní:w mo..., ke:ní:w mpahtia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1070">
                <ANNOTATION_VALUE>Wa:n ihkó:n ke:meh se: kitaya pos ihkó:n tikchi:wtiwi:tseh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a616" TIME_SLOT_REF1="ts1071" TIME_SLOT_REF2="ts1072">
                <ANNOTATION_VALUE>seki te:chki:sa wa:n seki a:mo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617" TIME_SLOT_REF1="ts1073" TIME_SLOT_REF2="ts1074">
                <ANNOTATION_VALUE>pero de nochi, nochi pos kipia de tikpa:pataskeh, se: taman a:mo kina:miki, se: taman te:chna:mikis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a618" TIME_SLOT_REF1="ts1075" TIME_SLOT_REF2="ts1076">
                <ANNOTATION_VALUE>wa:n ihkó:n *hasta** kipia de moka:was kwali se: kokoxkeh tein moka:wa itech tapech *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a619" TIME_SLOT_REF1="ts1077" TIME_SLOT_REF2="ts1079">
                <ANNOTATION_VALUE>de se: wetstotinemis de miak to:nalmeh, te:yo:lahsis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a621" TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1083">
                <ANNOTATION_VALUE>Wa:n te:kokolakih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts1085" TIME_SLOT_REF2="ts1088">
                <ANNOTATION_VALUE>Pero ke:namih kichi:waskeh *este** se: *fuerza** tote:iskaltihka:w de te:chpahti:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a624" TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>Pos kite:mowah miak pahtsitsi:ni, xiwtsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1096">
                <ANNOTATION_VALUE>Wa:n kipia de te:chahokwiskeh, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
