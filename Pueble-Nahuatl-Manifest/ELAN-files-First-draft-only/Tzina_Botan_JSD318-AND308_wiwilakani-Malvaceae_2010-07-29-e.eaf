        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>*entonces** de ke ki..., ne:chta:lilih yo:n tao:ltsi:n ika ne:chtahtatih,</ANNOTATION_VALUE>
