        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts984" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>tein ki:sas ixiwyo, de n' icho:kilo ya.</ANNOTATION_VALUE>
