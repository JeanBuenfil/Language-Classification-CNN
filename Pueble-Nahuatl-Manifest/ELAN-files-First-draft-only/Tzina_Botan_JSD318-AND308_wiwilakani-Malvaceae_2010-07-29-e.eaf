                <ANNOTATION_VALUE>*porque** ihkó:n ke:meh onkakeh o:me, e:yi taman wa:n kokal..., kokolis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>ke:meh tikihtowa ke no: onkak o:me, e:yi taman.</ANNOTATION_VALUE>
