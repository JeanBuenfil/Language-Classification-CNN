        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>Xo:nokwowit n' ik..., n' ika e:wa i:n</ANNOTATION_VALUE>
