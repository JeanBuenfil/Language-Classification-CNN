            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a788" TIME_SLOT_REF1="ts1052" TIME_SLOT_REF2="ts1055">
                <ANNOTATION_VALUE>pero a:mo nikmati itech ton kowyo mochi:wa. ke:mah. ¿Wa:n i:n yeh, ke:ní:w n' tikwa n' teh, ke:ní:w n' tikmahse:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
