        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a916" TIME_SLOT_REF1="ts1379" TIME_SLOT_REF2="ts1380">
                <ANNOTATION_VALUE>n' mela:s onkak nikteki wa:n ke:mah *como que**,</ANNOTATION_VALUE>
