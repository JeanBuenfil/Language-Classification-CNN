        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a926" TIME_SLOT_REF1="ts1404" TIME_SLOT_REF2="ts1407">
                <ANNOTATION_VALUE>Yo:n no: mochi:wa n' to:tolko:skat ta:lpan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a927" TIME_SLOT_REF1="ts1408" TIME_SLOT_REF2="ts1409">
                <ANNOTATION_VALUE>wa:n mokwihkwitiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a928" TIME_SLOT_REF1="ts1410" TIME_SLOT_REF2="ts1412">
                <ANNOTATION_VALUE>Nehnepan..., kwa..., yeh nehnene:ts mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a930" TIME_SLOT_REF1="ts1416" TIME_SLOT_REF2="ts1418">
                <ANNOTATION_VALUE>Wa:n ata kwitanehnextik, kwitanehnextik n' to:tolko:skat, pan..., panehnextik mah tikihto:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a934" TIME_SLOT_REF1="ts1425" TIME_SLOT_REF2="ts1428">
                <ANNOTATION_VALUE>Ih..., i:pa iwki ata. N' ta: no: tiki:xmattok pero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a936" TIME_SLOT_REF1="ts1430" TIME_SLOT_REF2="ts1433">
                <ANNOTATION_VALUE>Ke:meh yo:n ta:lpan mochi:wa, weh..., ihkwí:n mooholo:chowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a937" TIME_SLOT_REF1="ts1434" TIME_SLOT_REF2="ts1436">
                <ANNOTATION_VALUE>wa:n nochi, *como que** miak a n' ihkó:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a939" TIME_SLOT_REF1="ts1438" TIME_SLOT_REF2="ts1441">
                <ANNOTATION_VALUE>Komo, komo miak me..., metsoholo:ch n' ihkó:n mochi:wa n' ta:lpan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a940" TIME_SLOT_REF1="ts1442" TIME_SLOT_REF2="ts1444">
                <ANNOTATION_VALUE>itech tahsolpalak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a943" TIME_SLOT_REF1="ts1449" TIME_SLOT_REF2="ts1452">
                <ANNOTATION_VALUE>Wehwei mochi:wa. Wa:n ne..., wa:n neli wehwei *kwa:bohbola** n' ka:mpa tawelita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a945" TIME_SLOT_REF1="ts1454" TIME_SLOT_REF2="ts1457">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a947" TIME_SLOT_REF1="ts1461" TIME_SLOT_REF2="ts1463">
                <ANNOTATION_VALUE>*Mismo** yeha, *únicamente** no: *que** ka:mpa tel..., tel...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a949" TIME_SLOT_REF1="ts1465" TIME_SLOT_REF2="ts1467">
                <ANNOTATION_VALUE>telmiak tahsolpalak te:ntok ompa yo:n kwahkwali mochi:wa. *Exacto**. Wa:n tein yo:n kwa:tsikitsitsi:n mochi:wa *como que**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a951" TIME_SLOT_REF1="ts1469" TIME_SLOT_REF2="ts1472">
                <ANNOTATION_VALUE>ka:mpa a:mo t..., *como que** ka:mpa a:mo teh *abonochi:wtok, como que** a:mo teh tahsolpalaktsí:n miak, tilaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a952" TIME_SLOT_REF1="ts1473" TIME_SLOT_REF2="ts1474">
                <ANNOTATION_VALUE>Yo:n no: weli mah iwa:n se: kikwa, no: weli yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a953" TIME_SLOT_REF1="ts1475" TIME_SLOT_REF2="ts1477">
                <ANNOTATION_VALUE>no: weli para iwa:n no: pio, pio, komo piotsi:nakatsí:n, *cualquiera** nakatsí:n kwali iwa:n se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a955" TIME_SLOT_REF1="ts1479" TIME_SLOT_REF2="ts1481">
                <ANNOTATION_VALUE>*Como que** no: chi:lposo:n *como que**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a957" TIME_SLOT_REF1="ts1483" TIME_SLOT_REF2="ts1486">
                <ANNOTATION_VALUE>Neh ompa nikpante:ma,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a958" TIME_SLOT_REF1="ts1487" TIME_SLOT_REF2="ts1489">
                <ANNOTATION_VALUE>mah kwaltsi:n se: kipa:ka wa:n ke:mah ompa se: kipante:ma, iwa:n chi:lposo:n se: kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a962" TIME_SLOT_REF1="ts1496" TIME_SLOT_REF2="ts1499">
                <ANNOTATION_VALUE>Iwki sah. *Eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a966" TIME_SLOT_REF1="ts1506" TIME_SLOT_REF2="ts1509">
                <ANNOTATION_VALUE>Yo:n no: mochi:wa no: ta:lpan. No: ta:lpan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a968" TIME_SLOT_REF1="ts1513" TIME_SLOT_REF2="ts1515">
                <ANNOTATION_VALUE>A:, yeh ata no: panehnextik ata nikin..., ne:si yeha nikihtohtok no: panehnextik wa:n itampa kohkostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a970" TIME_SLOT_REF1="ts1517" TIME_SLOT_REF2="ts1519">
                <ANNOTATION_VALUE>Wa:n tihtilaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a972" TIME_SLOT_REF1="ts1521" TIME_SLOT_REF2="ts1523">
                <ANNOTATION_VALUE>Tihtilaktik, achi i:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a974" TIME_SLOT_REF1="ts1525" TIME_SLOT_REF2="ts1527">
                <ANNOTATION_VALUE>A:mo. No: ta:lpan*como que** mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a976" TIME_SLOT_REF1="ts1529" TIME_SLOT_REF2="ts1532">
                <ANNOTATION_VALUE>A:mo, yo:n ta:lpan sah yo:n mochi:wa, itech, ka:mpa onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a978" TIME_SLOT_REF1="ts1534" TIME_SLOT_REF2="ts1536">
