                <ANNOTATION_VALUE>Ke:mah, pero yehwa ya i:ni komohko:ni tein ompa mochi:wa itech yo:n kowit ke:waltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Para mochi:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>¿Wa:n i:n ke:ní:w n' tikwa n' tikchihchi:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>¿Wa:n iwki sah, iwki sah tikwa oso kipia, teihsá: t'ta:lilia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Pos neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>A:mo, neh nejó:n, neh nikwa no: iwki sah, no: taa:man sah. Neh nikchihchi:wa no: taa:man sah, neli, ta:taman se: takwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Ke:mah, ke:mah. Neh nik..., neh nikwa no: taa:man sah, a:mo nejó:n, a:mo teh n'ta:lilia chi:l niú:n tei, iwki sah neh nikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>Ke:mah, ta: we:lik neli kihtowah mah se: kita:lili a:ko:lin, pero nejó:n neh nikchi:wa nochipa iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>Nochipa iwki sah. Ta:taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>A:, i:n ma:tananakat neh no: niknekia nikmatis ke:niwki yeh mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>ke:niwki ne:n, ¿ista:k *o** ke:niwki, *o** ke:niwki n' ipanko?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>A:, panehnextik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>Tsikitsitsi:n, metstsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>A:, pos neli, ta:t..., ta:taman kit, neh niki:ita nochipa ista:k, neh nikita nochipa ista:k sah komohkó:n no: taman seki n' ipanko mochi:wa. A:, pos neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Ke:mah. ¿Wa:n, wa:n nochi a pos i:ni n' tein i:pa iwki tiki:ta n' teh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>A:, *bueno. Entonces** ekintsi:n tpano:tih de i:n xo:no:nanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>Xo:no:nanakat, ke:..., yeh ton kowyo n' kie:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>I:pa xo:nokowit sah n' kie:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>A:, n' ompa ya mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>No: mets..., metstsikitsitsi:n no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>Pos neh no: iwki neli nikitani, no: yehwa n' itech yo:n, itech yo:n yehwa n' tikilia xo:no:kowit wa:n chi:kikis no: kie:wa neh niki:ita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Pero no: kie:wa de i:n xo:..., xo:no:nanakat, *porque** no: niki:ita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>Wa:n, wa:n yeh i:pa iwki sah no: ke:meh yo:n ihista:k tikilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>Xo:no:nanakat. A:, i:pa iwki sah. Wa:n ke:ní:w yeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>A:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Ke:mah, mi:miak yeh monehnepanowa. Ke:mah, ke:mah, no: iwki neh nikitani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>¿Wa:n yeh ke:ní:w n' tikwa, ke:ní:w n' teh tikchihchi:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>A:, no: iwki n' tikwa. ¿Wa:n teihsá: tikta:lilia no: oso iwki sah, i:pa yehwa sah a:ko:lin?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>A:, yehwa para kiahwia:lia. ahwia:k ne:n tikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>A:, pos neli, neh nikwa no:, no: iwki sah. Neh nikwa i:pa iwki sah no: taa:man sah, a:mo teh nikta:lilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>A:, yehwa sah. A:mo, neh, neh nikwa iwki sah. Iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>A:man, de i:n ista:knanakat, ¿katí:n kowit kie:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>A:, yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>A:, pos wa:n neh a:mo niki:xmati yo:n tikilia iwki yo:n kowit, a:mo niki:xmati neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>A:, semi kwelita. Yo:n metswe:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a564" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>A:, pos neli wa:n neh yo:n, neh ka:n niki:xmati yo:ni, niki:xmattok yo:n nanakat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>pero yehwa yo:n neh a:mo nikmati katí:n kowit kie:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>Entó:s yehwa... A:, yehwa. Wa:n, wa:n i...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Wa:n yo:n i:pa n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>Ke:mah, wa:n yo:n i:pa no: ista:k sah, a:mo teh ke:ní:w *más**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>A:, i:pa iwki sah. ¿Wa:n, wa:n tikwa no: iw..., no: iwki, no: tikta:lilia teihsá:?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>Wa:n no: yehwa ya n' iwa:n tik..., tikwe:chowa wa:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>tikpanta:lilia ya wa:n ke:mah tiki:xtia ya wa:n tikwa ya *después**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>No: ahwia:k kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>A:, pos neli. Pos neh de i:n a:mo, nikwahka sepa pero wehka:w ya pero a:mo nikelna:miki ke:ní:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>*porque** neh i:n ompaka ne: tehwa:n ka:n kachi mochi:wa. ke:mah, neh i:pa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts553">
                <ANNOTATION_VALUE>Mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>Ke:mah, pos ka:n nochi se: kikwa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>A:, pos yehwa sah i:ni. Wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>wa:n iwki a nochi n' tikwa tikihtowa ke:ní:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Ke:mah, pos neh nimitsilia *que** neh nejó:n nikwahka pero wehka:w ya. Ekintsi:n a:mo ke:man nikwahtok ok *porque** neh a:mo okachi nikita ompa ne:n tehwa:n ne:n nejó:n de yo:n nanakat i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>i:n ista:knanakat a:mo okachi nikita. ke:mah. A:man,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>i:n ka:walpox, ¿yeh itech toni n' te..., itech ton kowyo mochi:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>A:, no: mochi:wa itech eskowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>¿Wa:n yeh ke:niwki mochi:wa, no: iwki sah ke:meh i:pa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>A:, no: metsno:nohne:l. ¿Wa:n ipanko no: iwki sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Ke:mah, pos iwki a neh no: niki:xmattok neli yehwa yo:n tih...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609" TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>Ke:mah, wehwei mochi:wa neli wa:n neli *más, más** tihtila:wak, tihtila:wak. Ke:mah neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Ke:mah, neli tihtila:wak, ta: no: niki:xmattok neli wa:n neli yehwa itech yo:n kowit mochi:wa neli no: niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a613" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Wa:n pané: no: kie:wa ne:n xo:no:kowit:, no: kie:wa. ke:mah, no: kie:wa, neh iwki niki:itani. ¿Wa:n i:n ke:ní:w n' tikwa yeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a616" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>A:, no: iwki n' tikwa. No:, no: tikoko:lia *o**... A:, no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a618" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Pos neli nochi iwki tikwa teh koko:k. Wa:n neh nikwa no: iwki no: taa:man sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a620" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts635">
                <ANNOTATION_VALUE>A:, pos neli, ke:mah, *es que** tata:man se: takwa. A:mo, neh nikwa no: iwki sah, neh no: taa:man sah nikwa *porque** neli yeh ye:ktihtila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a622" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts639">
                <ANNOTATION_VALUE>*Porque** nikilia neh kwaltsi:n se: kikwa de yo:n sehselik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts643">
                <ANNOTATION_VALUE>pero komo chika:wak a neli pos takwa:wak a *porque** yeh tihtila:wak *más**, ka:n... ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
