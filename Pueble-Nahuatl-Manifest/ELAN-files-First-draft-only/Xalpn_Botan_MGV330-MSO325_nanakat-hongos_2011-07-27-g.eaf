        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a863" TIME_SLOT_REF1="ts1242" TIME_SLOT_REF2="ts1244">
                <ANNOTATION_VALUE>Nikwe:cholia *chilito** wa:n, wa:n no: n'ta:lilia n' tomatsí:n.</ANNOTATION_VALUE>
