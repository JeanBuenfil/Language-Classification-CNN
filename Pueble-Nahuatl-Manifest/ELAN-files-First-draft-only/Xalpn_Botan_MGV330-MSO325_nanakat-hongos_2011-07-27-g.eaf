        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a912" TIME_SLOT_REF1="ts1369" TIME_SLOT_REF2="ts1371">
                <ANNOTATION_VALUE>*Porque** yo:n ka:mpa e:wa neli i:xkich mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a914" TIME_SLOT_REF1="ts1373" TIME_SLOT_REF2="ts1376">
                <ANNOTATION_VALUE>Miak mochi:wa, yo:n ahsi *hasta** a:mo se: kitamia se: kikwa sano</ANNOTATION_VALUE>
