        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a988" TIME_SLOT_REF1="ts1560" TIME_SLOT_REF2="ts1563">
                <ANNOTATION_VALUE>Wa:n no: kipia epaso:t pero, pero a:mo okachi neli *porque** a:mo okachi mochi:wa i:n.</ANNOTATION_VALUE>
