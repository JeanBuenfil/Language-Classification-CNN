        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a879" TIME_SLOT_REF1="ts1283" TIME_SLOT_REF2="ts1285">
                <ANNOTATION_VALUE>Wa:n yo:n tein chik..., wa:n yo:n tein chika:wak a, nikwe:chowa no: itech metat iwa:n nikwe:chowa wa:n nikpante:kilia ya wa:n nikta:lilia *pimienta** wa:n iwki a tikwah n' tehwa:n.</ANNOTATION_VALUE>
