        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a971" TIME_SLOT_REF1="ts1520" TIME_SLOT_REF2="ts1522">
                <ANNOTATION_VALUE>A:, n' tihtilaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a973" TIME_SLOT_REF1="ts1524" TIME_SLOT_REF2="ts1526">
                <ANNOTATION_VALUE>A:, pos neli a:mo kie:wa itech kowit, a:mo, a:mo mochi:wa itech kowit, no: ta:lpan sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a975" TIME_SLOT_REF1="ts1528" TIME_SLOT_REF2="ts1531">
                <ANNOTATION_VALUE>Pos neh no: niki:xmattok pero a:mo nikmati ka:ni, toni itech mochi:wa, ox itech kowit oso ta:lpan sah, ne:h a:mo, a:mo ke:man niko:nkwi yo:ni, sepa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a977" TIME_SLOT_REF1="ts1533" TIME_SLOT_REF2="ts1535">
                <ANNOTATION_VALUE>Ka:mpa tapala:ntok no:. Ke:mah, pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a979" TIME_SLOT_REF1="ts1537" TIME_SLOT_REF2="ts1539">
                <ANNOTATION_VALUE>¿Wa:n i:n no: nochipa onkak?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a981" TIME_SLOT_REF1="ts1541" TIME_SLOT_REF2="ts1544">
                <ANNOTATION_VALUE>A:, pos neli. Ke:mah, *porque** neh niki:xmattok no: i:ni, no:, no: nikwahka sepa, pero a:mo nikmati ox itech kowit kikwitoh oso ox ta:lpan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a983" TIME_SLOT_REF1="ts1546" TIME_SLOT_REF2="ts1548">
                <ANNOTATION_VALUE>wa:n no:, no:. ¿Wa:n i:n tikchihchi:wa no: iwki no: chi:lposo:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a985" TIME_SLOT_REF1="ts1552" TIME_SLOT_REF2="ts1555">
                <ANNOTATION_VALUE>A:, no: iwki we:lik. No: iw..., no: iwki we:lik.</ANNOTATION_VALUE>
