        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a990" TIME_SLOT_REF1="ts1565" TIME_SLOT_REF2="ts1568">
                <ANNOTATION_VALUE>Kowtah, wehka ya. ke:mah, a:mo mochi:wa ne:n ka:hkaltsi:ntan oso ompa ne: *cerca**.</ANNOTATION_VALUE>
