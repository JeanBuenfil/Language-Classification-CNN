        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a741" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts936">
                <ANNOTATION_VALUE>We:lik iwki sah. Pos neh no: iwki nikchi:wa ke:meh yo:n tikihtowa neh nikwa, neli no: nikpisi:lkokototsa wa:n nikpuye:lia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a742" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts938">
