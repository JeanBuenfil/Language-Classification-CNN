                <ANNOTATION_VALUE>Ke:mah, itech chalawihkowtsí:n yeh n' e:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>*Eso**</ANNOTATION_VALUE>
