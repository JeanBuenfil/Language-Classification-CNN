            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a852" TIME_SLOT_REF1="ts1215" TIME_SLOT_REF2="ts1217">
                <ANNOTATION_VALUE>Teswakwowit, teswakwowte:n itech mochi:wa.</ANNOTATION_VALUE>
