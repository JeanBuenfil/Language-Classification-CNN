        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a846" TIME_SLOT_REF1="ts1202" TIME_SLOT_REF2="ts1203">
                <ANNOTATION_VALUE>Ata kohkostik n' ihkwí:n ite:mpan wa:n itampa ista:k.</ANNOTATION_VALUE>
