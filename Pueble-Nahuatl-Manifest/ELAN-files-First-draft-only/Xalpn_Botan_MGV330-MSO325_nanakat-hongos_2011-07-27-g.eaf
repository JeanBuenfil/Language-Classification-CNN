        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>nehnepantik, a:mo seh se:.</ANNOTATION_VALUE>
