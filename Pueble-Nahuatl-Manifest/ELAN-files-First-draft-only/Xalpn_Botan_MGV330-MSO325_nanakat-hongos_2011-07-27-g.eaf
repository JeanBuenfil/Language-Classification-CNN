        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a987" TIME_SLOT_REF1="ts1557" TIME_SLOT_REF2="ts1559">
                <ANNOTATION_VALUE>Ke:mah, ta: neh nikwahka neli no: chi:lposo:n.</ANNOTATION_VALUE>
