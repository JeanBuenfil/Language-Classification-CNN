            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Mi:miak mochi:wa. Monehnepanowa.</ANNOTATION_VALUE>
