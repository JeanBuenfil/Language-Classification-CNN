        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794" TIME_SLOT_REF1="ts1066" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>A:, n' kwaltia no: iwa:n. Iwa:n ne:, ¿wa:n yo:n ton nakayo?</ANNOTATION_VALUE>
