        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a894" TIME_SLOT_REF1="ts1321" TIME_SLOT_REF2="ts1322">
                <ANNOTATION_VALUE>Nochi n' a:wa:t. O:me taman a:wa:t, se: kiliah xi:kala:wa:t wa:n se: kiliah tein a:mo xi:kala:wa:t, tein yo:n *este**, tein a..., tein yo:n tsikitsitsi:n iteyo.</ANNOTATION_VALUE>
