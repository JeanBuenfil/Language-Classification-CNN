            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a910" TIME_SLOT_REF1="ts1364" TIME_SLOT_REF2="ts1367">
                <ANNOTATION_VALUE>Ke:mah. Yehwa sah yo:ni neh. Wa:n neli neh nikwa no: iwki no: chi:lposo:yoh wa:n no:, no: n'ta:lilia epaso:t.</ANNOTATION_VALUE>
