        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Se: kita:lilia iwa:n se: kikwe:cholia sake:ra se:, o:me yo:n chi:lpo:k kilwiyah.</ANNOTATION_VALUE>
