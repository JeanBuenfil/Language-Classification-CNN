            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1012" TIME_SLOT_REF1="ts1619" TIME_SLOT_REF2="ts1622">
                <ANNOTATION_VALUE>No: taman neli. Pos yehwa i:n neh a:mo niki:xmati wa:n no:n nio: nikmati toni itech mochi:wa, i:n neh a:mo ke:man nikita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
