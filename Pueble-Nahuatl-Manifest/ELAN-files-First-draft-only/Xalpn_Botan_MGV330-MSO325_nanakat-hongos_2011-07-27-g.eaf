        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1016" TIME_SLOT_REF1="ts1629" TIME_SLOT_REF2="ts1632">
                <ANNOTATION_VALUE>Nochi kwowtah. ¿Wa:n no: iw..., no: iwki ti..., *cuando** tikchihchi:wa no: iwki n' tikwa no:, no: chi:lposo:yoh *o** taa:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
