        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796" TIME_SLOT_REF1="ts1072" TIME_SLOT_REF2="ts1075">
                <ANNOTATION_VALUE>A:, m' piotsi:n. A:, yehwa n' iwa:n we:lik no:.</ANNOTATION_VALUE>
