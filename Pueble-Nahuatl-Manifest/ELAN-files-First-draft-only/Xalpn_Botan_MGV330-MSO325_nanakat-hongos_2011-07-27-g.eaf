        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>No: uwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>Pos no: nikta:lilia, n' ta:ká:nse: kita:lilia sake:ra se:, sen kechtsi:n yeh yo:n epaso:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>Ke:mah, para kahwia:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>Kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>Neh ke:mih yo:n nikajolwia wa:n no: nikta:lilia *como que** meh eski,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>ma..., mohkó:n miaktsi:n kikwi o:me *chilito** wa:n pos komo a:mo miaktsi:n pos *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>sake:ra se: chi:chi:lpoktsí:n nikwe:choliya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>A:, iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>Ka..., *este** mah tikihto:ka:n achi tasohti n' kwowtsí:n pero ika yeha ne:n nik..., n' e:wa, yo:n kiliah kaxti:la:nkwowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Yehwa n' ika e:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Ke:mah, yo:n mohkó:n tika:wa n' kanah ika mah we:ia n' kaxti:lankwowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>wa:n mah se: kite:mpe:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>itech yeha yo:n semi kiwelita n' ista:knanakat n' ompa e:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>Pero yeh metswe:weyak. Yeh metswe:weyak, yeh n' ista:knanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Kax..., kaxti:la:nkwowit n' ika e:wa. Semi kiwelita komohkó:n pa..., *medio** palaktik a ne:n kaxti:la:nkowtsí:n pos, pos semi ompa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>ompa e:wa wa:n metskehkeleh..., *como que** yeh metskehkelehtik, soh *que**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>kwaltsi:n pohpochiktik, pero tein i:pa ista:knanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>Yo:n i:pa sentaman sah, ista:knanakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts518" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>Yeh yo:n neh ke:meh i:n nik..., nikchihchi:wa ke:meh i:n *cuando** tik..., *cuando** mochi:wa nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>neh n'ta:lilia no: sepa no: n' *chilito** wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>*este** nikwe:cholia sake:ra se: o:me tomatsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>No: we:lia ya yo:n *como que** se: ki..., se: kikwa *chi:chilposonte**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>Pero kwaltsi:n no: we:liya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>*Exactamente**. Ta: yo:n chi:chiko n' tawelita mochi:wa tak, ta:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>neh name:chilwihtok, neh we:ro mochi:wa itech mayo we:ro mochi:wa neh m' pi:sin nokaltsi:ntan *porque** t'teh..., n'tehte:n..., n'tehte:mpe:wa n' kwowit wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>ompa itech yo:n kwowte:n ompa ya monehnepanowa n' ihkwí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>*Hasta** ompa tika:wilowah, ka:n no: nochi t'mahse:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts556" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>Pero bueno**, pero kwaltsi:n ne mela:w mochi:wa yo:n nikihtowa ne:n pi:sih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>Ta: seki semi tasohti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Yeh mochi:wa itech eskowit ata, itech eskowit no: mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>Mochi:wa itech eskowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>A:, yeh no: metstoh..., no: metsno:nohne:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>No: metsno:nohne:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>Ipanko ata no: nehnextik wa:n tihtila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a606" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts600">
                <ANNOTATION_VALUE>Ka:walpox tihtila:wak, yeh a:mo kahkanaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a608" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>Tihtila:wak, yeh mochi:wa *hasta** achichi i:n pa..., pa:pata:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>Wehwei, pa:pata:wak n' ka:walpox. Yeh tihtila:wak. Nochi nanakatsitsí:n kahkanaktik, pero wel yeh yo:n tihtila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts612">
                <ANNOTATION_VALUE>*Exactamente**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a614" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>No: kie:wa. Neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>Pos yeh no: ke:meh nikwa, ke:meh xo:no:nanakat nikwa, no: iwki nikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617" TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts625">
                <ANNOTATION_VALUE>No: iwki nikwa. No: tepitsi:n se: kite:nkoko:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a619" TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts631">
                <ANNOTATION_VALUE>A:, kanah, neh tepitsi:n nikoko:lia para mah we:lia ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a621" TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>*Eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a624" TIME_SLOT_REF1="ts641" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>Ke:mah takwah... Tihtila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>Tein..., *pero más** takwa:wak n' ma:tananakat, yeh *más** takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a628" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>Yo:n no: yehwa n' itech e:wa ne:n chi:kikis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>Itech chi:kikis yeh yo:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>Wa:n no: mochi:wa n' itech eskowtsí:n, no: k..., no: i..., no: kie:waltiya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a632" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>Wa:n no: mochi:wa itech *tarro**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>Itech, mochi:wa itech n' ohtat tikiliah *mexicano**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a636" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>No: ke:wa chakaykowit neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638" TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a641" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>Ke:wa neli, no..., nochi kie:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643" TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>Ke:mah, itech chakah no: neli kie:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a645" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>Yeh yo:n telwe:lik, yo:n no: mah kwaltsi:n se: kimomolotsa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>neh nikwa iwa:n etsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a648" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>Iwa:n etsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a650" TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>Pos neh sepa sah nikpanta:lia iwa:n etsí:n *porque** n' chikinte no: takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a652" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>Takwa:wak, yo:n no: mah momoloka iwa:n i:n etsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>wa:n ke:mah niktewa:tsa ya n' a:jojoli:n, ika, ika k..., ika koma:ltsí:n niktewa:tsa kwaltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a654" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>*cuando** kwaltsi:n tewa:ki a n' a:joltsí:n, kwaltsi:n se: kikwe:chowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts726">
                <ANNOTATION_VALUE>Wa:n *cuando** ne: molo:ni a, ihwa:k a n'pante:milia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658" TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>Pero wa:kik n' a:jol se: kipante:milia, a:mo se: kipa:ta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>A:ah, a:mo para ki:sa ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663" TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts743">
                <ANNOTATION_VALUE>A:x...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts751">
                <ANNOTATION_VALUE>A:ah. Neh n' ajo:joli niktewa:tsa, kwaltsi:n tewa:ki, niktewa:tsa ika se: *sar..., sartén, sarte:ntsi:n**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667" TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>kwaltsi:n no: n'tewa:tsa, ihkwí:n nikma:nelowa, ihkwí:n se: k..., se:, kwaltsi:n se: kima:nelowa wa:n de kwaltsi:n tewa:ki a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>ke:mah nikte:ma ya itech metat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>kwaltsi:n se: kikwe:chowa ya, *polvito** mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts763">
                <ANNOTATION_VALUE>Ke:mah. Yo:n achto se: kipa:ka metat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a673" TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>A:ah, yo:n *polvito** neh n'panta:lia, wa:n pos yo:n *cuando** yo:n molo:ntok a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674" TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>mah se: kipante:mili a ne:n i:n a:jojoltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675" TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>wa:n ke:mah se: kiki:xtia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677" TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>A:x..., *porque** semi ahwia:k ki:sa, *porque** kip</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>kipia *pol..., como que polvo**, a:mo s..., a:mo se: kipa:ta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>Nikpa:ta komohkó:n nikwe:cholih tepitsi:n *chilito**, nikwe:cholia ya n' *chilito** tepitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a682" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>wa:n ke:mah, yeha ya se: kipa:ta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>Ke:mah, n'pante:milia ya ne:n etsí:n wa:n ompa yowi a *como que** ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a684" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts793">
                <ANNOTATION_VALUE>*este** nik..., nikta:liya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a685" TIME_SLOT_REF1="ts794" TIME_SLOT_REF2="ts795">
                <ANNOTATION_VALUE>Nik..., mohkó:n achi i:ntsi:n ko:ntsí:n tein ika n'manak n' etsí:n wa:n, wa:n mo miak ne:n, i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a686" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts797">
                <ANNOTATION_VALUE>miyak ne:n nanakat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a687" TIME_SLOT_REF1="ts798" TIME_SLOT_REF2="ts800">
                <ANNOTATION_VALUE>*este** nikma:talia na:wi *hojita de** mimie:ntah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts805">
                <ANNOTATION_VALUE>Y..., yeh n'ta:lilia mimie:ntah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>[...]ke:mah. Neh n'ta:lilia n' ke:meh i:n nimitsilihtok wa:n n'ta:lilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts817">
                <ANNOTATION_VALUE>*primero** n'ta:lilia *como que** ne: nimitsilihtok n' a:jojoli</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695" TIME_SLOT_REF1="ts818" TIME_SLOT_REF2="ts820">
                <ANNOTATION_VALUE>wa:n ke:mah n'ta:lilia ya n' *chilito** wa:n de molo:ni se: kiki:xtia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a697" TIME_SLOT_REF1="ts822" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>kwaltsi:n ahwia:k ki:sa n' emo..., n' emo:ltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699" TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts831">
                <ANNOTATION_VALUE>Yo:n mochi:wa no: itech selikme:tsti, *cuando** ke:meh i:n we:ro kiowi, *cuando** tasese:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a702" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>A:mo nochipa, yo:n onkak *cada** xiwit sah, yo:n *cada** xiwit sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a703" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>*Cuando** semi tasese:ya, itech yo:n enero, febrero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a704" TIME_SLOT_REF1="ts842" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>iwki nochi mochi:wa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>Mochi:wa, *pero cuando** semi tasese:ya ihkwa:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts851">
                <ANNOTATION_VALUE>Seknanakat mo..., mo wehweia ata achichi i:n no: n' imets, metskehkelehtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a708" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts853">
                <ANNOTATION_VALUE>Wa:n *este**, mo..., *este, hasta** kwa:achichi i:n ata mochi:wa, neli kwa:pa:patakaxtik wa:n i:n no: tihtila:wak ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a709" TIME_SLOT_REF1="ts854" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>no: n' inanakayotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a711" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts860">
                <ANNOTATION_VALUE>Ta: yo:n ta:lpan mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a713" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>Ke:mah, no: mochi:wa itech seki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a715" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>*Cada** xiwit sah mochi:wa, *cuando** teltasese:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a717" TIME_SLOT_REF1="ts874" TIME_SLOT_REF2="ts876">
                <ANNOTATION_VALUE>Pero no: *cuando** selikme:tsti i:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a719" TIME_SLOT_REF1="ts880" TIME_SLOT_REF2="ts882">
                <ANNOTATION_VALUE>Pos ke:meh semi *nipobre como que**, neh n'chihchi:wa nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a721" TIME_SLOT_REF1="ts884" TIME_SLOT_REF2="ts887">
                <ANNOTATION_VALUE>no: uwki n'poye:lia itech se: kaxit ihkó:n nik..., nikchi:wa wa:n ihkó:n nikokototsa, tein yo:n, *como que** no: neh n'teki yo:n *bolitas, como que** tel, tel tein selik, ta: mochi:wa *kwa:kwa:bolitas**. A:mo, yo:n sehselik, neh nik..., nikteki yo:n sehseliktsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a722" TIME_SLOT_REF1="ts888" TIME_SLOT_REF2="ts889">
                <ANNOTATION_VALUE>wa:n sepa n'ta:lia itech, itech se: kaxtsí:n *o** se: *cazuelita** ompa ihkwí:n nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723" TIME_SLOT_REF1="ts890" TIME_SLOT_REF2="ts891">
                <ANNOTATION_VALUE>nik..., nik..., *primero** n'pa:ka, a:xka:n ompa ihkwí:n n'ta:lia ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724" TIME_SLOT_REF1="ts892" TIME_SLOT_REF2="ts893">
                <ANNOTATION_VALUE>wa:n se:pa n'ta:lilia n' istat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725" TIME_SLOT_REF1="ts894" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>Sepa n'ta:lilia n' istatsí:n wa:n ihkwí:n nikekowa ox poye:k a, komo poye:k a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726" TIME_SLOT_REF1="ts896" TIME_SLOT_REF2="ts898">
                <ANNOTATION_VALUE>kwaltsi:n poye:k, po:poyek ki:sa ya yo:n ne: xo..., nanakatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728" TIME_SLOT_REF1="ts902" TIME_SLOT_REF2="ts904">
                <ANNOTATION_VALUE>Kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730" TIME_SLOT_REF1="ts908" TIME_SLOT_REF2="ts909">
                <ANNOTATION_VALUE>Nikta:lia we:i taxkal, achi i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731" TIME_SLOT_REF1="ts910" TIME_SLOT_REF2="ts911">
                <ANNOTATION_VALUE>*como que** we..., we:i taxkal ke:meh *si fuera**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732" TIME_SLOT_REF1="ts912" TIME_SLOT_REF2="ts913">
                <ANNOTATION_VALUE>ompa ihkwí:n se: ki:xta:lia, se: kichi:chi:wa n' tikiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733" TIME_SLOT_REF1="ts914" TIME_SLOT_REF2="ts915">
                <ANNOTATION_VALUE>*mexicano** mi:koh se: kichi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734" TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts917">
                <ANNOTATION_VALUE>Mah se: kita:li itech taxkaltsí:n ompa se: ihkwí:n se: ki:xke:kepa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735" TIME_SLOT_REF1="ts918" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>mah itech taxkaltsí:n oksi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737" TIME_SLOT_REF1="ts924" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>Wa:n ihkó:n se:..., se:..., ihkwí:n se: ki:xtapowa ya oso uwki se: kitanteki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739" TIME_SLOT_REF1="ts928" TIME_SLOT_REF2="ts931">
                <ANNOTATION_VALUE>Ye:k..., ye:kwe:lik ki:sa ya *porque** nan..., nanakatsí:n poye:k wa:n a:momolokak a iwa:n ya n' taxkaltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740" TIME_SLOT_REF1="ts932" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>We:lik n' tepitsi:n kiko:ko..., se: kikoko:lia wa:n we:lik ma:s iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745" TIME_SLOT_REF1="ts944" TIME_SLOT_REF2="ts946">
                <ANNOTATION_VALUE>Ta: iwki nimitsilihtok neh n'chi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747" TIME_SLOT_REF1="ts948" TIME_SLOT_REF2="ts950">
                <ANNOTATION_VALUE>Neh nochi nikoko:lia tepitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749" TIME_SLOT_REF1="ts952" TIME_SLOT_REF2="ts954">
                <ANNOTATION_VALUE>Yeha yo:n ihkó:n mokwa yeh seknanakat, yeh a:mo se: kichi:wa emo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a751" TIME_SLOT_REF1="ts956" TIME_SLOT_REF2="ts959">
                <ANNOTATION_VALUE>Neh a:mo n'chi:wa emo:l, neh iwki a n' ke:meh name:chilia nikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754" TIME_SLOT_REF1="ts964" TIME_SLOT_REF2="ts967">
                <ANNOTATION_VALUE>Tak ke:mah, pero... *Eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a756" TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>Yo:n no: mochi:wa *como que** mah tikihto:ka:n ka:mpa ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a757" TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts975">
                <ANNOTATION_VALUE>kwowtah chi:wtok, [...], *como que** mochi:wa, ompa mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a759" TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts981">
                <ANNOTATION_VALUE>Mochi:wa ne: *como que** kahfe:ntah, pero ne: itech *rancho**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761" TIME_SLOT_REF1="ts985" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>Ompa ne: mochi:wa wa:n *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762" TIME_SLOT_REF1="ts987" TIME_SLOT_REF2="ts988">
                <ANNOTATION_VALUE>nikita yehwa n' tein monamaka kwesala:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a763" TIME_SLOT_REF1="ts989" TIME_SLOT_REF2="ts991">
                <ANNOTATION_VALUE>*como que** neh, mochi:wa no: kwowtah, *como que** ne: no..., *norancho**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766" TIME_SLOT_REF1="ts997" TIME_SLOT_REF2="ts999">
                <ANNOTATION_VALUE>O:me taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a768" TIME_SLOT_REF1="ts1003" TIME_SLOT_REF2="ts1004">
                <ANNOTATION_VALUE>Yeha yo:n o:me taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a769" TIME_SLOT_REF1="ts1005" TIME_SLOT_REF2="ts1006">
                <ANNOTATION_VALUE>Onkak seki ata kwaltsi:n koh..., kohkostik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770" TIME_SLOT_REF1="ts1007" TIME_SLOT_REF2="ts1008">
                <ANNOTATION_VALUE>*este** pané: *medio** ko:kohkostik kwaltsi:n ihistak ata kohkostik. Wa:n seki ata no: pa:panehnextik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a771" TIME_SLOT_REF1="ts1009" TIME_SLOT_REF2="ts1011">
                <ANNOTATION_VALUE>No: pa:panehnextik n' xilwananakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a773" TIME_SLOT_REF1="ts1015" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>*Este** no: mochi:wa itech, itech kwo..., kwopalak *pero hasta** a:mo no: n'mati katí:n kwowtsí:n *porque** ke:meh ne:, ke:mehm ke:meh kima:yawi ne:n ta:tahtsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a774" TIME_SLOT_REF1="ts1017" TIME_SLOT_REF2="ts1018">
                <ANNOTATION_VALUE>*cuan[do]** nikita neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775" TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1021">
                <ANNOTATION_VALUE>ompa, ompa i..., ipanko mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777" TIME_SLOT_REF1="ts1023" TIME_SLOT_REF2="ts1026">
                <ANNOTATION_VALUE>Ipanko mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1036">
                <ANNOTATION_VALUE>*Exactamente**. A:mo, ta: no: ika kowtsí:n mochi:wa. Mochi:wa itech yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a782" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1039">
                <ANNOTATION_VALUE>sa..., sen pa:nti nikwi:lihka itech mochi:wak yo:n kiliah a:tsi:tsika:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1044">
                <ANNOTATION_VALUE>Sayoh mah, mah palaktik yo:n a:tsi:tsika:skowit wa:n *cuando o:rah** yo:n kiowi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a785" TIME_SLOT_REF1="ts1045" TIME_SLOT_REF2="ts1047">
                <ANNOTATION_VALUE>Wa:n no: itech selikme:tsti mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a787" TIME_SLOT_REF1="ts1049" TIME_SLOT_REF2="ts1051">
                <ANNOTATION_VALUE>No: ihwa:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a789" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1056">
                <ANNOTATION_VALUE>Itech yeha yo:n mochi:wa, a:tsi:tsika:skowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a790" TIME_SLOT_REF1="ts1057" TIME_SLOT_REF2="ts1058">
                <ANNOTATION_VALUE>Yo:n no: we:lik *como que** yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a791" TIME_SLOT_REF1="ts1059" TIME_SLOT_REF2="ts1060">
                <ANNOTATION_VALUE>pos komo neli se: moye:ktekipanowa, *como que** mah tikihto:ka:n se: taahxitia yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792" TIME_SLOT_REF1="ts1061" TIME_SLOT_REF2="ts1062">
                <ANNOTATION_VALUE>yo:n kwaltia ika se: ki..., nejó:n se: kichi:wa chi:lposo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a793" TIME_SLOT_REF1="ts1063" TIME_SLOT_REF2="ts1065">
                <ANNOTATION_VALUE>wa:n kwaltia *hasta** iwa:n *como que** nakatsí:n mah se: kipanta:li.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a795" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1071">
                <ANNOTATION_VALUE>Piotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797" TIME_SLOT_REF1="ts1073" TIME_SLOT_REF2="ts1076">
                <ANNOTATION_VALUE>Piotsi:n. Piotsi:n iwa:n we:liya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801" TIME_SLOT_REF1="ts1083" TIME_SLOT_REF2="ts1086">
                <ANNOTATION_VALUE>Ke:mah, chi..., yo:n chi:lposo:n. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a804" TIME_SLOT_REF1="ts1091" TIME_SLOT_REF2="ts1093">
                <ANNOTATION_VALUE>Ke:mah, pero kwaltsi:n we:lik komo kipia *sabor**, ne:, *como que** ahwia:k ne:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a806" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1098">
                <ANNOTATION_VALUE>Yo:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808" TIME_SLOT_REF1="ts1102" TIME_SLOT_REF2="ts1103">
                <ANNOTATION_VALUE>¿N' xopitsa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a809" TIME_SLOT_REF1="ts1104" TIME_SLOT_REF2="ts1106">
                <ANNOTATION_VALUE>*Este, eso sí** yo:n xopitsa, *cualquiera** kowit itech mochi:wa, a:mo sayoh sentaman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811" TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1112">
                <ANNOTATION_VALUE>Tein yeski kwowit itech e:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813" TIME_SLOT_REF1="ts1114" TIME_SLOT_REF2="ts1117">
                <ANNOTATION_VALUE>*Porque** yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814" TIME_SLOT_REF1="ts1118" TIME_SLOT_REF2="ts1119">
                <ANNOTATION_VALUE>*cualquiera**, sayoh mah palaktik n' kowtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a815" TIME_SLOT_REF1="ts1120" TIME_SLOT_REF2="ts1121">
                <ANNOTATION_VALUE>Mah palaktik tepitsi:n n' kowtsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a816" TIME_SLOT_REF1="ts1122" TIME_SLOT_REF2="ts1124">
                <ANNOTATION_VALUE>wa:n ompa ya yo:n motekpa:na ihkó:n, *porque** yeh ihkwí:n mets..., metswe:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a818" TIME_SLOT_REF1="ts1128" TIME_SLOT_REF2="ts1130">
                <ANNOTATION_VALUE>Onkak achi no: seki tihti:ltik wa:n achi onkak seki *como que** achi no: telihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820" TIME_SLOT_REF1="ts1132" TIME_SLOT_REF2="ts1134">
                <ANNOTATION_VALUE>Wa:n yo:n no: sa... *Cualquiera** kowit itech yo:n, yo:n e:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a822" TIME_SLOT_REF1="ts1136" TIME_SLOT_REF2="ts1139">
                <ANNOTATION_VALUE>Yo:n *cualquiera** kowit itech mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a824" TIME_SLOT_REF1="ts1141" TIME_SLOT_REF2="ts1144">
                <ANNOTATION_VALUE>Wa:n seki nanakatsí:n yetok sah katí:n ika n' e:wa n' kow... Yo:n mochi:wa ma:s itech kahfe:nkwowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a826" TIME_SLOT_REF1="ts1146" TIME_SLOT_REF2="ts1149">
                <ANNOTATION_VALUE>Mochi:wa itech kahfe:nkowit wa:n mochi:wa itech chalawih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a828" TIME_SLOT_REF1="ts1153" TIME_SLOT_REF2="ts1155">
                <ANNOTATION_VALUE>Kie:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a830" TIME_SLOT_REF1="ts1159" TIME_SLOT_REF2="ts1161">
                <ANNOTATION_VALUE>No: se: kimomolotsa, yo:n no: se: kichi:wa *como que si fuera, como que** chi:chi:lposo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a832" TIME_SLOT_REF1="ts1163" TIME_SLOT_REF2="ts1165">
                <ANNOTATION_VALUE>No: chi:chi:lposo:n se: kchihchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
