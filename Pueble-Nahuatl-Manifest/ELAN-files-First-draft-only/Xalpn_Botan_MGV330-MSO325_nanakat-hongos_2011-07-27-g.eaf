        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a799" TIME_SLOT_REF1="ts1079" TIME_SLOT_REF2="ts1081">
                <ANNOTATION_VALUE>neh nikchi:wa no: iwki nikwe:cholia chi:l wa:n tomat wa:n</ANNOTATION_VALUE>
