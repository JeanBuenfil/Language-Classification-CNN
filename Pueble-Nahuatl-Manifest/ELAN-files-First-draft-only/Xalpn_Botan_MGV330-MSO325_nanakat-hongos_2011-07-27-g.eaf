            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1026" TIME_SLOT_REF1="ts1651" TIME_SLOT_REF2="ts1654">
                <ANNOTATION_VALUE>Pos neh i:n a:mo wel nimitsilia ke:ní:w nikwa *porque** neh i:n a:mo niki:xmati, a:mo ke:man nikita de i:n, ke:mah, a:mo nikita neh i:ni, a:mo, a:mo n'mati katí:n nanakat i:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
