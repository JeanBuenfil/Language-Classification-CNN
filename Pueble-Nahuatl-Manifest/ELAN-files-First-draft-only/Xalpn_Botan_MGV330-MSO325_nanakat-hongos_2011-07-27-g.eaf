        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a817" TIME_SLOT_REF1="ts1125" TIME_SLOT_REF2="ts1127">
                <ANNOTATION_VALUE>¿Wa:n i:n i:pa sentaman sah no: onkak *o** no: onkak o:me taman?</ANNOTATION_VALUE>
