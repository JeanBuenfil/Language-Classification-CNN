        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798" TIME_SLOT_REF1="ts1077" TIME_SLOT_REF2="ts1078">
                <ANNOTATION_VALUE>Ke:mah, pos neli ta:taman neli se: kikwa, *porque** neh i:n nikwa nikchihchi:wa neh,</ANNOTATION_VALUE>
