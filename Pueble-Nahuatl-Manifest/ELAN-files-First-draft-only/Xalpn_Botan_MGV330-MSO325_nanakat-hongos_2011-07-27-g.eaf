            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a933" TIME_SLOT_REF1="ts1424" TIME_SLOT_REF2="ts1427">
                <ANNOTATION_VALUE>A:, i:pa iwki wa:n...</ANNOTATION_VALUE>
