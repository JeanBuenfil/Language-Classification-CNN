        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a992" TIME_SLOT_REF1="ts1570" TIME_SLOT_REF2="ts1572">
                <ANNOTATION_VALUE>Wa:n i:n kostiknanakat, ¿ton itech mochi:wa i:n, no: itech kowit *o** ta:li:xko, ke:niwki i:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
