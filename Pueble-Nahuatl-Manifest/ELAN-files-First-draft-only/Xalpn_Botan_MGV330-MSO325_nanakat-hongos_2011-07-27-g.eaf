        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a882" TIME_SLOT_REF1="ts1288" TIME_SLOT_REF2="ts1291">
                <ANNOTATION_VALUE>Ke:mah, ta: yehwa nimitsilihtok kwaltsi:n ahwia:k ki:sa. Wa:n mah neli se: kimomolotsa *porque** yo:n no: *medio** takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
