                <ANNOTATION_VALUE>A:, pos neli, pos yehwa i:n neh a:mo, a:mo nimitsilia *que** toni itech mochi:wa, i:n a:mo niki:xmati neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1057" TIME_SLOT_REF1="ts1733" TIME_SLOT_REF2="ts1735">
                <ANNOTATION_VALUE>No: kwaltsi:n molo:ni.</ANNOTATION_VALUE>
