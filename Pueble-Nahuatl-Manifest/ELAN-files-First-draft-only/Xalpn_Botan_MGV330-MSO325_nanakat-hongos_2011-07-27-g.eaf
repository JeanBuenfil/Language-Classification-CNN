        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a854" TIME_SLOT_REF1="ts1219" TIME_SLOT_REF2="ts1221">
                <ANNOTATION_VALUE>Wa:n mohkó:n ta:ká:n ihkó:n wetstok t..., teswat *como que medio** palaktik a, nochi itech e:wa. Pero kwahkwali nanakat, sa tihtila:wak mochi:wa.</ANNOTATION_VALUE>
