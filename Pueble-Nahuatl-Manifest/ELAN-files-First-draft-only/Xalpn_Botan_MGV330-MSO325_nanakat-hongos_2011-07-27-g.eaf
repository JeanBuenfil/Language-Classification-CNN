        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a911" TIME_SLOT_REF1="ts1365" TIME_SLOT_REF2="ts1368">
                <ANNOTATION_VALUE>No: ke:wa.</ANNOTATION_VALUE>
