            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a859" TIME_SLOT_REF1="ts1231" TIME_SLOT_REF2="ts1233">
                <ANNOTATION_VALUE>Yeh yo:n no: *como que**, neh nikchihchi:wa no: *como que** chi:lposo:n.</ANNOTATION_VALUE>
