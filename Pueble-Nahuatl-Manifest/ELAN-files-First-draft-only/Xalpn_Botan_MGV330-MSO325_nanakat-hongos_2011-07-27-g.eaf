        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1069" TIME_SLOT_REF1="ts1764" TIME_SLOT_REF2="ts1767">
                <ANNOTATION_VALUE>A:, kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
