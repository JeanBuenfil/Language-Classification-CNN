        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a967" TIME_SLOT_REF1="ts1510" TIME_SLOT_REF2="ts1512">
                <ANNOTATION_VALUE>¿Wa:n i:n i:pa sentaman sah no: onkak?</ANNOTATION_VALUE>
