        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a847" TIME_SLOT_REF1="ts1204" TIME_SLOT_REF2="ts1205">
                <ANNOTATION_VALUE>Wa:n tapani yowi ata ihkwí:n ata ti:ltik.</ANNOTATION_VALUE>
