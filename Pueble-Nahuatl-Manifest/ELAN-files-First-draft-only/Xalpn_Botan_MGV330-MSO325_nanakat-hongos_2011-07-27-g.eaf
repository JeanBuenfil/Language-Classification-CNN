        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1020" TIME_SLOT_REF1="ts1639" TIME_SLOT_REF2="ts1641">
                <ANNOTATION_VALUE>A:, ¿tiktsoyo:nia *o** iwki sah? A:, t'tsoyo:nia, a:, t'tsoyo:nia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1022" TIME_SLOT_REF1="ts1643" TIME_SLOT_REF2="ts1645">
