        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a915" TIME_SLOT_REF1="ts1377" TIME_SLOT_REF2="ts1378">
                <ANNOTATION_VALUE>neh *cuando** ke:meh i:n *cuando** nikita onkak ne: *norancho** niki:sati,</ANNOTATION_VALUE>
