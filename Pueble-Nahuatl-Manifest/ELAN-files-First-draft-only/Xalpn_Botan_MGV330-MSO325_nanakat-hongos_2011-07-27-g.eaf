        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Takwa:wak, *como que** yo:li:k, yeh *como que** se: kimomolotsa kwali para se: kimahse:wa.</ANNOTATION_VALUE>
