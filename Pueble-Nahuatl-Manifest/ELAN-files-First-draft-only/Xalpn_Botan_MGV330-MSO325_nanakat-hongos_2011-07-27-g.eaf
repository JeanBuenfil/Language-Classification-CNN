        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1084" TIME_SLOT_REF1="ts1801" TIME_SLOT_REF2="ts1804">
                <ANNOTATION_VALUE>*Bueno** pos yehwa sah i:ni na:nah, miak tasohka:matik nochi tein tine:chilih, i:n seki neh a:mo nikihi:xmati i:n nanakat i:n timonohno:tskeh ika timotapowihkeh.</ANNOTATION_VALUE>
