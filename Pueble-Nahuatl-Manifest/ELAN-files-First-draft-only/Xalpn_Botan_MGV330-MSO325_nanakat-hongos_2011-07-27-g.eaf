        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>Pos, yo:n no: k..., no: ke...., no: ajolyoh se: kikwa.</ANNOTATION_VALUE>
