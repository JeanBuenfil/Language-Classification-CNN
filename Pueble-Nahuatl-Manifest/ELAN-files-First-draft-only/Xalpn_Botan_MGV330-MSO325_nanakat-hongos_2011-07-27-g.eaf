        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>O:me taman alakcho.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
