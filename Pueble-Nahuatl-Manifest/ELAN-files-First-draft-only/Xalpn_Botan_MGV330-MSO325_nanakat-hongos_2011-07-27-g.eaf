        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>I:n no: se: kimolo:ntia, *porque** i:n se: kimolo:ntia *porque** yeh takwa:wak.</ANNOTATION_VALUE>
