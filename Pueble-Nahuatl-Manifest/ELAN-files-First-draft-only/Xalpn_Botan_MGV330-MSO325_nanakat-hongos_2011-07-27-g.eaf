        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>Ne:n i:n, xo:no:nanakat ke:mah, yeh, yeh i:pa ihista:k. Wa:n yeh mochi:wa ata ne:nehnepantik.</ANNOTATION_VALUE>
