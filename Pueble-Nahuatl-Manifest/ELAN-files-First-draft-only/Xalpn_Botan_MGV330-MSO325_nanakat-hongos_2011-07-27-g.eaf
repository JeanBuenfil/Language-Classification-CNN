        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a924" TIME_SLOT_REF1="ts1400" TIME_SLOT_REF2="ts1402">
                <ANNOTATION_VALUE>Ta:lpan mochi:wa.</ANNOTATION_VALUE>
