        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a837" TIME_SLOT_REF1="ts1176" TIME_SLOT_REF2="ts1178">
                <ANNOTATION_VALUE>Yeha yo:ni se: kita:lilia no: tepitsi:n epaso:tsí:n, se: kih...,. se: ki..., para kahwia:lia.</ANNOTATION_VALUE>
