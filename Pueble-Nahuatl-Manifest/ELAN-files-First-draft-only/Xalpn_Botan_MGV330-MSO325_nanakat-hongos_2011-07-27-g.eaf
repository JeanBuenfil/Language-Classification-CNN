        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a969" TIME_SLOT_REF1="ts1516" TIME_SLOT_REF2="ts1518">
                <ANNOTATION_VALUE>A:, pos neli, ke:mah neh</ANNOTATION_VALUE>
