        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a843" TIME_SLOT_REF1="ts1194" TIME_SLOT_REF2="ts1195">
                <ANNOTATION_VALUE>¿M' pi:sih? I:pa iwki yeh yo:n, i:p..., i:pa sentaman sah tak mochi:wa, *lo más** mochi:wa *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
