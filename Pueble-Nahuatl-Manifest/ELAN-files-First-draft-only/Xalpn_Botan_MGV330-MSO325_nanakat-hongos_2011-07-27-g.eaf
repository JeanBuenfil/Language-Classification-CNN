        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a935" TIME_SLOT_REF1="ts1429" TIME_SLOT_REF2="ts1432">
                <ANNOTATION_VALUE>Niki:xmattok, no: niki:xmattok neh pero neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a938" TIME_SLOT_REF1="ts1437" TIME_SLOT_REF2="ts1440">
                <ANNOTATION_VALUE>Ke:mah, neh niki:x...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a941" TIME_SLOT_REF1="ts1445" TIME_SLOT_REF2="ts1447">
                <ANNOTATION_VALUE>Pos neh no: niki:xmattok neli i:ni wa:n neli no:, neh niki:xmattok *que** mochi:wa seki neli wehwei ta:lpan mochi:wa, ihkwí:n wehwei,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a942" TIME_SLOT_REF1="ts1448" TIME_SLOT_REF2="ts1451">
                <ANNOTATION_VALUE>Wa:n seki *más** wehwei mochi:wa wa:n onkak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a944" TIME_SLOT_REF1="ts1453" TIME_SLOT_REF2="ts1456">
                <ANNOTATION_VALUE>Ke:mah. Wa:n seki onkak pisi:ltik, tsikitsitsi:n ihkó:n moketsa no: ta:li:xko sah, neh iwki niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a946" TIME_SLOT_REF1="ts1458" TIME_SLOT_REF2="ts1460">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a948" TIME_SLOT_REF1="ts1464" TIME_SLOT_REF2="ts1466">
                <ANNOTATION_VALUE>Ompa *más, más** tawelita. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a950" TIME_SLOT_REF1="ts1468" TIME_SLOT_REF2="ts1471">
                <ANNOTATION_VALUE>Ke:mah. ¿Wa:n i:n ke:ní:w n' tikchihchi:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a954" TIME_SLOT_REF1="ts1478" TIME_SLOT_REF2="ts1480">
                <ANNOTATION_VALUE>A:, no: kwali iwa:n se: kikwa. A:, no: we:lik chi:lposo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a956" TIME_SLOT_REF1="ts1482" TIME_SLOT_REF2="ts1485">
                <ANNOTATION_VALUE>Pos neh no: n' i:pa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a959" TIME_SLOT_REF1="ts1490" TIME_SLOT_REF2="ts1491">
                <ANNOTATION_VALUE>Wa:n we:lik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a960" TIME_SLOT_REF1="ts1492" TIME_SLOT_REF2="ts1494">
                <ANNOTATION_VALUE>Pos neh i:n, neh neli no: niki:xmati i:ni wa:n no: nikwa pero no: iwki nikwa neh, no: taa:man sah, neh a:mo teh n'ta:lilia, iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a961" TIME_SLOT_REF1="ts1495" TIME_SLOT_REF2="ts1498">
                <ANNOTATION_VALUE>Iwki sah nikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a963" TIME_SLOT_REF1="ts1500" TIME_SLOT_REF2="ts1501">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a964" TIME_SLOT_REF1="ts1502" TIME_SLOT_REF2="ts1504">
                <ANNOTATION_VALUE>¿Wa:n i:n, i:n xo:chinanakat i:n, katí:n kowit kie:wa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a965" TIME_SLOT_REF1="ts1505" TIME_SLOT_REF2="ts1508">
