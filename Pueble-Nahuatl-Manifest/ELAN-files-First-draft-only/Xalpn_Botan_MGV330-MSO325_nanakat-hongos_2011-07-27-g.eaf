            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a922" TIME_SLOT_REF1="ts1394" TIME_SLOT_REF2="ts1396">
                <ANNOTATION_VALUE>Yeh yo:n mochi:wa, mochi:wa ta:lpan.</ANNOTATION_VALUE>
