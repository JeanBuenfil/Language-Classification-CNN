        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a876" TIME_SLOT_REF1="ts1276" TIME_SLOT_REF2="ts1278">
                <ANNOTATION_VALUE>Ke:mah, neh niki:xmattok no: i:ni neli wa:n no:, no: nikmahse:wa. Neh nikmahse:wa no: iwki ke:meh tikihtowa chi:..., pero neh a:mo nikwe:cholia tomat, neh nikwe:cholia sayoh yehwa se: chi:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877" TIME_SLOT_REF1="ts1279" TIME_SLOT_REF2="ts1281">
                <ANNOTATION_VALUE>Se: chi:lwa:k sah nikwe:cholia.</ANNOTATION_VALUE>
