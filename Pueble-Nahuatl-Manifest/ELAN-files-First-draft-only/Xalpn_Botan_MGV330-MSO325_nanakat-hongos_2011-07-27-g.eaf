        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a800" TIME_SLOT_REF1="ts1082" TIME_SLOT_REF2="ts1085">
                <ANNOTATION_VALUE>wa:n nejó:n nik... ke:mah. Wa:n nik..., wa:n nikpanta:lilia tsiktsi:n epaso:t. Yo:n neli nikwa no: iwa:n epaso:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
