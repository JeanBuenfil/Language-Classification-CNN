        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Pos nehjó:n ki..., kita..., ki..., kikwah, kitohtoloh, kitapoh wa:n ihkó:n nochi kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Nochi iteyo. Kwe:lilih *porque** tsope:..., yo:n kwaltsi:n tsope:k. Ehe, ahwia:k wa:n cho:kiloh de n' paniá:n pero taihtik a:mo cho:kiloh wa:n kwe:lilih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>Mopepecho:to taihtik wa:n a:mo wel ki:saya ok, a:mo wel mokalawia:ya ok, mopepechoh, motsakwak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>*por eso** ekintsi:n ti..., timotapowiah mah tik..., *cuando** yo:n tikwa:skeh kochonih ...</ANNOTATION_VALUE>
