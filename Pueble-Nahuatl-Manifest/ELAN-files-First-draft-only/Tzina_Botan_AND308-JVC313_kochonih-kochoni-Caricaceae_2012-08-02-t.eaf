        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>Ki..., ki..., kitapowa:yah wa:n kiki:xtilia:yah yo:n n' e:watsi:n, yo:n ista:k wa:n kinte:nyeko:ltia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Wa:n *porque** komo kinmakah yo:n kone:meh pos yehwa yo:n motsakwaya ne:n nika:n ikwitapan ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Ka:mpa inkwitako:n wa:n pos a:mo wel ki:saya ok, yehwa yo:n seki ika se:, te:ta:lilia:yah yo:n kwetax ne:n te:kwita:lilia:yah ihkó:n para se: mo..., ki:saya ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nikmattok yo:n semi no: tikwa:yah ihkó:n pero semi se: ki..., no: ki..., niman te:iliah ekintsi:n tikwa:s pero semi nehjó:n ximo..., mopixtiw ihkó:n de ke para a:mo mitschi:wili:s ne:n *mal**.</ANNOTATION_VALUE>
