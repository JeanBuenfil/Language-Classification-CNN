        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>Ahwia:k wa:n no: kihtowa:yah ne: *antes** ne: tota:tahwia:n ki..., kikwiah para ne: ima:i yo:n ima:xiwyo *porque** ima:xiwyo ihkó:n de we:weyak.</ANNOTATION_VALUE>
