        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Ike:span, pero a:mo semi wehwei, ihkwi:ntsitsi:n.</ANNOTATION_VALUE>
