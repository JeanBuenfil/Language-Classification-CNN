        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>Pos yehwa yo:n neh nik..., nikmattok yo:n kochoni no: we:lik katka semi, we:lik wa:n ekintsi:n pané: a:mo kachi se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
