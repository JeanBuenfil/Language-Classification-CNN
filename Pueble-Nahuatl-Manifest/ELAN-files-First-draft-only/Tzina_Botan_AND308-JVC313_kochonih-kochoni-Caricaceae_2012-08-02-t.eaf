        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Ka:mpa te..., te..., tepa..., tepa:patakax kilia:yah.</ANNOTATION_VALUE>
