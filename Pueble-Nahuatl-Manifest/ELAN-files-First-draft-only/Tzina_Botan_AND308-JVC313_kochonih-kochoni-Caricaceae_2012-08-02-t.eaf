        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts391" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>Wa:n pos yo:n no: ye:kkwaltsi:n ahwia:k n' i..., iteyo, kwaltsi:n ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>Wa:n yo:n yema:nik no: ie:wayo de se: kitapowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>Ololtik, ololtik wa:n yo:n kihtowah komo se: kitohtoloh iteyo ...</ANNOTATION_VALUE>
