        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>Icho:kilo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n ipaniá:n komo se: moxola:wa pos se: wetsiti a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts553">
                <ANNOTATION_VALUE>wa:n *cuando** yo:n nochi xokoya ihkó:n pos moka:wa taihtik achi poxa:wak a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>Poxa:wak a ne:n moka:wa, pero yo:n neh nikmattok i:pa a:mo no: kwaltia para nikihto:s teisá: se: kikwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>A:mo, yo:n i:pa tak xa: para tapala:n xa: kwaltias pero para nikihto:s takwahkwawi:l, yo:n a:mo kwaltia, wapachtik i:n taihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>Pané: pehpech yo:n ka:mpa se: ki..., se: ke:meh i:n tapialtsi:n kita:liliah pané: pehpech.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>Yo:n tak de, de wa:ki a, de chika:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>Pero yo:n no:, no: tila:wak ie:wayo tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>Ke:mah. Pos yehwa sah yo:n neh nikmati no:.</ANNOTATION_VALUE>
