        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>Pero yo:n semi kwa:yah tak takwatsitsi:n oso yehwa:n yo:n okwilimeh,kitahtapowa:yah.</ANNOTATION_VALUE>
