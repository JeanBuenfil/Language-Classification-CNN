        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Ika tapa:kayah, ta: pos no: tik..., no: tikmattok wa:n no: tik..., no: tikitaya oso mitsilia:ya ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n kochoni ke:masá: tak yo:n achi no:nohne:l ke:masá: se: kitaya yo:n chiktehtsi:n, yo:n papa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
