        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>A:mo onkaya wa:n ompa ne: mota:lia:yah, ompa ne: kixakwalohtokeh tilmahtsi:n ika nehjó:n wa:n, wa:n yo:n no: poso:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>No: poso:nia wa:n neh nikmati no: de n' semi kone:meh ok no: a:mo no: kinka:wilia:yah de nehjí:n tetsi:n, de nehjí:n kochoni.</ANNOTATION_VALUE>
