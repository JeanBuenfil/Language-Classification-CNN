        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>Tiktekitih ya wa:n tiktapowah wa:n kwaltsi:n tsope:k a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>Tikekowah tsope:k kwaltsi:n pero ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Pos a:mo wel niman se: kwahtiwetsi *porque** se: kimowilia mah se: kitolo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>Yo:n seki ne: kitanchichi:nayah sah wa:n kitamo:tayah, kwalia:yah sayoh ne:n tsope:k, tein tsope:k sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>Yo:n kitanchichi:nayah sah ihkó:n, sikie:ra se: *bola**, ka:sá: ika se: kita te:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>Yo:n kitam..., ki:x..., ne: mote:nakia:yah wa:n kiki:xtia:yah, kitamo:tayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>Wa:n pos ekintsi:n neh a:mo semi nikitstok ne:wi:n, a:mo kachi nikita yo:n, nikita seki kowtsitsi:n ihkó:n pero a:mo kipia ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>A:mo kachi ok mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts513" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>Pos yo:n ka:mpa kite:nxi:mayah no: tikitayah, no: semi tinemiah ihkó:n yo:li:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>*Porque** yo:n komo se: kite:nxi:ma wa:n a:mo se: kahchi:w ka:mpa se: ohtoka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>Se: wetsi wa:n yo:n ye:kalaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>Alaktik no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>Pero yo:n paniá:n sah alaktik, ta..., ta..., we:noh nika:n i:n taihtik, xahxakachtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>Nehjó:n xahxakachtik ne:n taihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>Pero paniá:n alaktik tak yo:n i..., icho:kilo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>*Porque** icho:kilo ne: no: ista:k.</ANNOTATION_VALUE>
