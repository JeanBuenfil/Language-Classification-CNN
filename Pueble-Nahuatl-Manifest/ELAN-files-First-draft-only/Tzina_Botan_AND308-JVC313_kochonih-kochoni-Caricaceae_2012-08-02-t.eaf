        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Pos no:, no: tehwa:n ne: ana:lpa ninemia pos ne:n yo:n tapa:kayah ne: ahko ka:mpa a:tpata:wa kilia:yah ne:n *lajas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>Ompa ne: kiliah ne:titapa..., tapa:kayah, kwi:kayah se: tana:palo:l ihkó:n yo:n xiwit, kina:palowa:yah wa:n ika ne: tapa:kayah nehjó:n xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Wa:n de ne:n kilia:yah *lajas, lajas** ne: ka:mpa *lajas** ne:n kihto:s tap..., titapa:katih kampa *lajas**.</ANNOTATION_VALUE>
