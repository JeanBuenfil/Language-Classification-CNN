        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>Mosama:wa ka:mpa se: ikwitaxkol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>Mo..., sama:waya wa:n yehwa yo:n para te:ki:xtilia:yah moneki mah te:..., se: taya:ya teisá: ihkó:n, xiwtsi:n se: taya:ya *o** a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Wa:n ke:masá: kihtowa:yah no: te: te:ohxilia:yah teisá: ne: xapoh *o** teisá: *mantequita** para se: ki..., seki tein cha:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>Para *aceite** de yo:n kowach.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>*Vaya**, te:ohxilia:yah para nehjó:n mah ki:sa ya nehjó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>*O** te:tai:ltia:yah kihtowa:yah no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>No: sentahmatiah pos ta: nehjó:n we:i mochi:waya se: i..., se: ipox, mosama:waya, mosama:waya wa:n yehwa yo:n ne:n kone:meh seki pos kinchi:wilia:ya *mal** pos kinkokowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>Kinkokowa:ya, yehwa yo:n seki tsahtsiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>Tsahtsiah wa:n ki..., yo:n no: nikneltoka we:i mochi:wa wa:n ni..., yo:n de pe:wa ihkó:n moskaltihtiw ihkó:n we:ixtiw wa:n ke:mah ike:span ya mochi:wa, yo:n a:mo mochi:waya itech ima:yo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>N' i..., iteyo, yo:n ike:span mo..., mosa:sa:lowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>Ke:masá: se: kita kwaltsi:n sa:sa:liwtok, ihkó:n tekpa:ntok, ihkó:n tekpa:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>Wa:n *hasta** ka:mpa, ka:mpa tamiti a, ompa tami a tak ne:n moskaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>wa:n ti..., de pe:wa, ihkó:n pe:wa koyo:titiw, koyo:titiw wa:n ihkó:n ne:n, tak ihkó:n chika:waxtiw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>*después**moka:wa nochi kostik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>Nochi kostik a wa:n yehwa yo:n tikihtowah pos ne: yoksitok a ne: kochoni.</ANNOTATION_VALUE>
