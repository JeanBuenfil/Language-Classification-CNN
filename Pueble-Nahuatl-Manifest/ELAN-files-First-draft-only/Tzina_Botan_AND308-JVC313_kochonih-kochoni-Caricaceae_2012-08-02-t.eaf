        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>Pos no: niki:xmati yo:n kowtet pero tehwa:n tikiliah kochonih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Kochonih *porque** moskaltia, moskaltia wehkapan tein wehwei kowit a mochi:wa sikie:ra e:yi *metro** de wehkapan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>wa:n, wa:n nehjó:n yo:n moskaltia wa:n mos..., iwki moskaltihtiw, moskaltia ita:kka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>wa:n ma:ski we:i a *siempre** ta:ki itech ikowyohke:span, moko..., mopihpilowa ke:meh kowxi:lo:t, soh ke ohololtik ke:meh yo:n xokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Wa:n eh..., ehekayeh no:, ihxihxi:pohyeh tikito:ka:n wa:n nehjó:n i..., ixo:chio</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>ne: mopepechowa ike:span kowit wa:n pané: yo:n ko:ko:ntsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>wa:n mochi:wa ma:kwi:l, ne: kwa:tapa:ni ixo:chiotsi:n, mahyá: i..., ima:te:mpayo xo:chitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>motahtapowa wa:n ompa ya ne:n mahyá: poso:ni a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>wa:n de poso:ni ne: powetsi ixo:chiotsi:n, moka:wa itsi:nkaxio wa:n moka:wa kowtetsi:n ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Ke:mah moskaltia, moskaltia yo:li:k *hasta** we:ia wa:n de chika:waya neli kostia, kostia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>wa:n nehjó:n komo se: kineki se: kikwa:s, se ... Yo:n we:lik neli wa:n ye:kahwia:k se: kiteki, se: ki:xtapa:na wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>se: kwalia ya iteyo pero [neli ke:meh nimitsilia]soh kipiah, sayoh, sayoh ipachio se: kikwa wa:n ipachio se: kitamo:ta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>*Porque** komohó:n se: kikwah iteyo, neli se:, se: mo..., moihtitsiko:ti:w ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>Yo:n moma:mahcha:na, a:mo *porque** mopepechowa sanoke n'matok ke de taihtik se: kipiaya, kawa:ni wa:n poso:ni yo:n ipachio,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>tein ipo:potoyo mahyá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Yo:n i:x..., mahyá: ichkatik ipane:wayo, ta: ne: iteyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>wa:n poso:ni wa:n ke:mah ne: wehweia, momahmacha:na wa:n a:mo wel se: mokalawia ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>mote:ntia se: ikwitako:nte:noh wa:n ompa moka:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Ke:mah, *después** ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>Mosama:wa, mosama:wa *por eso** ne: a:mo wel ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Ke:mah wa:n yehwa yo:n nehjó:n i..., ika se: mo..., mokwitatsikowa *porque** momahxa..., wehwei wa:n ika yo:n ka:mpa mahyá:, mahyá: pohposotik ompamokahkalakia, ompa momahcha:na wa:n a:mo ki:sa, a:mo mokahka:wa, mosenki:tskia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>Kineki senki:sas sepa sah wa:n a:mo weli sepa sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>ika yo:n, ika te:..., ika se: mokwitatsikowa yo:n, komo ... De se: pilimeh pos a:mo se: ... Se: kitohtolowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>pero se: kimattok mah se:, mah a:mo se: kichi:wa, se: kitolo iteyo sanoke mah se: kikwa ipachio sah, kwaltsi:n ahwia:k yo:n kowtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>Wa:n neli n' i..., ixiwyo kwaltia ika ne:, yo:n ke:man tapa:kayah ika, a:mo onkaya ne: xapoh *o** ke:meh i:n, xapoh i:pa onkak, yo:n pa:nxapoh kiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>pero ne:n xapoh ke:meh ekintsi:n ika ki:xtiah cho:kil a:mo, a:mo, a:mo moi:xmatia, yehwa ika ki..., taxakwalowa:yah yehwa yo:n xi..., ixiwyo ne:n kochonihxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>Kite:mowa:yah ne: ka:sá: mochi:wah kaltsi:ntan oso ne: ohti kite:mowa:yah, kahfe:ntah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>kitekiah na:nahmeh wa:n ika ki..., kwi:kayah ne: tapa:katih, ihwa:k tapa:kayah nochi ne:, itech we:ia:t, ne: atekohkomol oso nika:n pa:wa:pan oso ne: a:tpoliwi tapa:kayah, kwakwalacha:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>I:n a:tpoliwi tapa:kayah seki wa:n ki..., ahokopa yetokeh nika:n ko..., nika:n tsapotitan, ista:ktsapotitan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>nochi tein [sakatan]ya:yah tokni:wa:n tapa:katih ne:, tapa:katih ne: A:tpoliwi, koma:mo kwakwalacha:t, o:me a:y yetok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>wa:n nika:n tehwa:n tein tietoyah kali:ka:n, tapa:katih Pa:wa:pan, A:pi:pia:s *o** Atekohkomol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Yo:n e:yi a:t tapa:katih nochi tokni:wa:n, a:mo onkaya a:t ke:meh ekintsi:n ti..., tikoyo:tayih ya n' a:t itech *llave** kiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>lla:veha:t pero yo:n kachi pitsotik titayih a:t ekintsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Wa:n ihwa:k pos a:mo onkaya yo:n a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>wa:n a:..., a:tsí:n de nika:n a:meyal tikpiah ne:n San Miguel,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>yo:n kikwiah para tai:yah sah pero a:mo para tapa:ka:yah *porque** a:mo ahsiskia n' a:t kinemilia:yah ne:n tokni:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Ihkó:n tapa:kayah ompa intasa:k, ki:x..., ki:xa:wia:yah itech ne:n we:ia:t a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>ke:mah a:mo, a:mo tapa:kayah ne: kalihtik *porque** owih para se: kisaka n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Ompa neli kisakayah pero para in..., inkahbe:ntsi:n kimolo:ntiah oso tapalo:l kichi:wayah, yehwa sah ika ne: kisakayah n' a:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Ke:mah iwki, ke:mah ika yo:n. Ika te:chahsia n' a:t semi *porque** to..., ta..., ta:tahmeh *o** na:nahmeh a:mo ka:wilchi:wayah n' a:t ihwa:k, a:mo kimimilowa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
