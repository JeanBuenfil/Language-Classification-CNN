        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Kiitah n' kowtsí:n de achi kwali mah..., maxaltik.</ANNOTATION_VALUE>
