        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>wa:n *hasta** nika:n ne: senahsi *hasta** nika:n i:n wa:n nika:n mota:lia ya,</ANNOTATION_VALUE>
