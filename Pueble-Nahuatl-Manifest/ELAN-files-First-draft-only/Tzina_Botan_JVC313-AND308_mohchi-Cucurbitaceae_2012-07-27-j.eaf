        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>Wa:n *antes** tikilia:yah ika kilpia:yah yo:n *pabilo**,</ANNOTATION_VALUE>
