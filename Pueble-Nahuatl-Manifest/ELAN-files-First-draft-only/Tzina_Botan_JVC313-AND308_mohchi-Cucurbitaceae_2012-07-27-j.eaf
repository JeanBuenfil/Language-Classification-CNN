        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>Ke:meh ayohselik de mochi:wtiw</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>wa:n ihkó:n moskaltihtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>wa:n seki *que de** chika:waya pos wehweia, nehnextia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>De nehnextia ya niman se: kimachilia, se: kistekwi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>wa:n se: kita ne:, entó:s i:n chika:wak ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>Chika:wak ya i:n *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>se: kiki:xtia ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>pos nijó:n takwa:wak ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts391" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Wa:n de selik pos se: kichi:wa ihkó:n se: kistekwi ika se: iisti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>pos koyo:ni, ke:meh eskia mopa:tsowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>kana:wak ok n' ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Wa:n de n..., de sepa moskaltihtiw no: tila:waya n' ie:wayo, no: tila:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>ka:s ika no: onkak de o:me taman, ne:n *mismo** se: kita *mismo** yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>pero seki mochi:wa semi tsikitsitsi:n, ihko:ntsitsi:n de tsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>wa:n seki mochi:wa wehwei, wehwei ihkó:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>De yo:n wehwei pos yehwa yo:n kikwih seh se: sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Wa:n yo:n tsikitsitsi:n yehwa yo:n kikwih oho:me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>Oho:me, kintsi:n neh nikita kichi:wah seki si...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>oho:me wa:n seki tsikitsitsi:n, ma:nel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>Ma:nel kikwih wa:n *antes** tehwa:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>tota:tahwa:n tikitayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>miak ne:wí:n, ne: a:na:lpa ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>hkó:n ne:n pihpilkak, kikwitih wa:n kitahkote:tehtekih *o** kitamo:tah, kitamo:tayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>Ka:wilchi:wayah ne:wí:n, kihto:s i:n *para qué es** tikwiskeh, ta: i:n ye:kchichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>Ye:kchichi:k wa:n pos yo:n de wa:ki wa:n pala:ni ye:kne:nke:n tahtapa:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts457" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Sayoh kikwiah para yehwa ne:n to...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>n..., n' impah de i:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>yehwa:n de na:nahmeh ihkó:n, yehwa yo:n 'kwiah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>*Pero después**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>de kimatkeh ihkó:n, *de que** kintsi:n kikwih yo:n tama:chihchi:walis nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>nochi kichi:wah pos kintsi:n nochi kololowah ya. Entsi:n a:mo ma:wilowa ok nijó:n kowtetsí:n, yo:n mohchi, yo:n a:mo nikihto:s *que** tik..., tikwa:tih *o** we:lik ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Yo:n a:mo we:lik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>yo:n semi chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>Chichi:k semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Yo:n komo tikyekoh tepitsi:n, nochi te:ka:mpa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Te:pa nochi, nochi se: ite:noh, *después** se: chihcha chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nochi ne:n, yo:n miak taman, komo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>te:ma:kwik nika:n se: kipa:ka ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>pos nochi se: ima:ko moka:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>nochi se: ima:ko chichi:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>Yo:n moneki no: kwaltsi:n mah se: moma:pahpa:ka para se: takwa:s. Te:mapa, komo a:mo timomahtekih wa:n ihkó:n tikchipa:w ne:n mohchi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>wa:n komohkó:n titakwa:ti a ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>pos mote:noh moka:was nochi ne:n chichi:k, chichi:ya, se: chihcha nochi chichi:k. Wa:n yehwa yo:n *hasta** se: itoskakko moka:wa ya ne:n chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>Yehwa yo:n para se: kichipa:was yo:n no: semi miak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>miak nijó:n se:..., se: kimati ki:ní:n mah se: kichipa:was, komo a:mo se: kimati pos se: mo..., mochichi:li:s sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n neh nikmattok sayoh de se: taman para i:n pahti, no: pahti para ne:n kone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>Teh xa: kachi tikmatis ne:n para nejó:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>Pos tehwa:n no: nik..., nikitak ne:n..., nikneltoka n' ke:meh tikihtowa ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>[ek]intsi:n no: nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>*Cuando** moskaltihtiw ihkó:n moketsa ne:n i..., n' iteyo ke:meh ayoh, ihkó:n mok..., moketsa, ihkó:n moketsa ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>entó:s ompa ne: xoxoktik ne: mochi:wa wa:n yehwa yo:n ke:meh yo:n tikihtowa ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>n'mitse[nimitsilwia], ma:sá: mone:neki se: kone:tsí:n pos yehwa yo:n ika ki..., kita:liliah, pos kika:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts600">
                <ANNOTATION_VALUE>Kka:wa ya nimah, ma:s sepa ne: motoki:ti entó:s a:mo, a:mo kineki ok chi:chi:s, ta: ki..., kimachilih *que** n' ite:noh moka:wak yo:n, yo:n chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Wa:n pos yehwa neh nikitaya ne:n *antes** ke:meh no: ni..., mihto:tia:yah ihkó:n de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>de n' kwesaltinih pos nikta:lilia:ya *siquiera de** na:wi, na:wi taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>na:wi nika:n t'ta:lilia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts615">
                <ANNOTATION_VALUE>tapa:l, nika:n xoxok[tik], nika:n chi:chi:ltik, nika:n ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>Wa:n kintsi:n a:mo, kintsi:n ne:n nikita kikwih nochi ne:n ihko:ni sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts629">
                <ANNOTATION_VALUE>Wa:n yo:n ne:n, yehwa nijó:n nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>kwaltiaya, *pero antes** nochi tika:wilo:wa:yah, yehwa nimitsilia:ya ne: tika:a:tamo:tayah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>*o** t'ta:tahkotapa:nayah, ne:wí:n tika:wilchi:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>wa:n ke:meh kintsi:n miak ne:sik nochi tama:chihchi:walis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts642" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>pos kintsi:n tikololowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>Kintsi:n nochi ne:wí:n tikte:mo:tih, ne:wí:n *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts650" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>kintsi:n pos kwi:kah ne:wí:n wa:n kwaltsi:n kichihchi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>Sayoh kite:mo:tih yo:n kow..., kowmaxalmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>wa:n kixihxi:mah no: kwaltsi:n wa:n kitatekiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>wa:n ki..., kwaltsi:n moka:wa, se: kitsetselowa ye:kkwaltsi:n kakisti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>Wa:n moneki mah kwaltsi:n se: ki:xwa:tsa yehwa yo:n kowtet ne:n..., yehwa sah yo:n kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>No: kikwih seki yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>kihtowah temomox no: kikwih, pero yo:n *más** eti:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>Yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>Mike:ah..., a:, yo:n *pisilitos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>Yo:n we..., we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts716">
                <ANNOTATION_VALUE>Yo:n se: ki..., onkak o:me, motapowa:ya wa:n xi:i:nia i:n i..., itey..., n' exo:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>Pos yeh yo:n semi pisi:ltik. Pos neh niki:xehekowa kwaltsi:n kakisti *porque** pisi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>Se: ki..., wa:n mah wa:kik ne:n mohchi n' ie:wayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts731">
                <ANNOTATION_VALUE>pos se: kitsetselowa ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts733" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>wa:n kwaltsi:n kakisti, ke:meh es..., ke:meh eskia yo:n tsili:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>Pos yo:n de n' achi t..., achi wehwei se: kita:lilia yehwa nexkihit oso n' oksé: ne:n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>n' iswat... kakisti pané: yo:n a:paltik ne:n..., a:paltik ne:n mohchi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>Yo:n de n' tikihtowa *porque más pisili:tos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts763">
                <ANNOTATION_VALUE>E..., kakisti ke:meh nika:n wa:n ne:, ne: kahfe:nte:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>Te:nchika:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts773" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>A:, pos teh no: tikinchihchi:waya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts778" TIME_SLOT_REF2="ts781">
                <ANNOTATION_VALUE>mohchimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts786" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>Pos yehwa yo:n nochi se: molia ki:ní:n ti..., tipano:keh wa:n ki:ní:n tikchi:wayah yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>yo:n tikiliah a:wi:l, pero a:mo a:wil tikmawistiliah ne:n to..., de n' *mero** te:chi:xeka:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>Pero nijó:n, pos yehwa yo:n neh yehwa sah yo:n nikmati de yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>mohchi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>Ke:mah, yehwa sah a:mo teh *más** ne:n..., yehwa sah yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>Pos nehwa nimono:tsa Anastacio Nicolás Damián, ni..., niwa:le:w de ne: xola:l de San Miguel Tzinacapan no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
