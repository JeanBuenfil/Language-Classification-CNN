        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>*[por]que komo kita:liah se: toma:wak wa:n se: pitsa:wak pos ahko moka:wa.</ANNOTATION_VALUE>
