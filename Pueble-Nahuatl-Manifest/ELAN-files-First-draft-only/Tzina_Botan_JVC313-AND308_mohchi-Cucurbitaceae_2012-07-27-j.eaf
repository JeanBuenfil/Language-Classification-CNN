            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>Wa:n yo:n no: ma:pohposteki, no: n' ima:yo: n' im..., no: yema:nik n' ima:yo. Yema:nik wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Yo:n ka:ns ika n..., se: kita seki pohpochiktik n' ixo:chio wa:n ihkwí:n de we:weyak n' ixo:chiyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
