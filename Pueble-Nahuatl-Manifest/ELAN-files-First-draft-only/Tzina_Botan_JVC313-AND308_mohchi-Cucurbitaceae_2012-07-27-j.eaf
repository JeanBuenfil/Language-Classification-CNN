        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Kipepechowilia:yah para a:mo ki:saya ne:n iteyo, *tatsa:wakcera**.</ANNOTATION_VALUE>
