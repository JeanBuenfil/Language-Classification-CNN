        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>Wa:n komo a:mo yehwa ne: ika xo:no:t no: kikwa:ilpia:yah.</ANNOTATION_VALUE>
