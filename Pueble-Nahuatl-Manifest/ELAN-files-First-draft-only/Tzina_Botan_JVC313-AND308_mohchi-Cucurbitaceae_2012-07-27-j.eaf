            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>entó:s ki:sa kwaltsi:n, de ki:sa kwaltsi:n wa:n ki..., ke:mah kiki:xtiliah ya n' taihtik ne:n..., yeh ki:sa ya.</ANNOTATION_VALUE>
