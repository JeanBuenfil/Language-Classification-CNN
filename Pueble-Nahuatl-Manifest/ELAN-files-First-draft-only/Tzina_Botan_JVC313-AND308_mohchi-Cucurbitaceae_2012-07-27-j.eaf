        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Ka:mpa i..., we:ikoyoktik ihkó:n, ka:mpa kikoyo:nia:yah,</ANNOTATION_VALUE>
