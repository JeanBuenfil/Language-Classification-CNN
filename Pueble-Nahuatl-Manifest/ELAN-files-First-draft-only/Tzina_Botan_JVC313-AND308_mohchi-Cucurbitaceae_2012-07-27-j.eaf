        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>Yo:n tepe:xo:no:t kimali:nayah wa:n ika kikwa:ilpia:yah ne:n</ANNOTATION_VALUE>
