        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>wa:n kintsi:n neh nikita kikwih yo:n *hilo**, teihsá: *hilo** kilpiah</ANNOTATION_VALUE>
