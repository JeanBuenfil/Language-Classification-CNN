        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>kita:lilia:yah oho:me wa:n seki kita:lilia:yah seh se: sah.</ANNOTATION_VALUE>
