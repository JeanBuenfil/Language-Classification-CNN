        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>mohchi, kimanah para ne:nke:n ki:sa n' ie:wayo, *porque** yo:n ie:wayo xoxoktik wa:n</ANNOTATION_VALUE>
