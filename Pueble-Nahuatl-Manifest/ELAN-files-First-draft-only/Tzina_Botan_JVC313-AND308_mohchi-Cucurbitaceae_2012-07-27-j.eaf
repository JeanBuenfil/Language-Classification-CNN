        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>Seh se: kowtsí:n wa:n yehwa yo:n kita:lilia:yah.</ANNOTATION_VALUE>
