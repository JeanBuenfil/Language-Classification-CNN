        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Wa:n nika:n kintsi:n nehwa nikitstok ki..., achto kikoyo:niah wa:n ki..., kimanah nijó:n,</ANNOTATION_VALUE>
