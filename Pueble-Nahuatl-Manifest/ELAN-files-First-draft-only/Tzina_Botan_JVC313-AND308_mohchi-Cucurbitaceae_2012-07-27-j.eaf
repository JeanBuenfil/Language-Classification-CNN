            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>wa:n mo..., *así que** te:chi:chi:ti a ne:n kone:tsi:n pos nijó:n a:mo..., ni..., nika:n *como q...**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>moka:waya..., chichi:yaya. Entó:s niman kihto:skeh a:mo..., tsahtsia ya ne:n kone:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Entó:s a:mo, a:mo kinekia ok chi:chi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>Entó:s kika:waltia:yah nijó:n, *porque** seki ma:ski wehwei:n, ihkwi:kwí:n wehwei:n ya wa:n..., pero seki chi:chih ok *o** kikwitinemih ne:n te:momá:n, a:mo kika:wah, nió:n no: mah takwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Ika yo:n kikwitih yehwa ya ne: mohchi wa:n kitapa:nah ihkó:n</ANNOTATION_VALUE>
