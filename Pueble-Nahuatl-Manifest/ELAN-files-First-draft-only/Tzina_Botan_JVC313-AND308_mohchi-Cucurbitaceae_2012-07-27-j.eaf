        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Wa:n ne: ke:man tikwiah ka:mpa tepitsi:n panowa:ya yo:n tikiliah yo:n *cerita de** yo:n nekmeh,</ANNOTATION_VALUE>
