        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>wa:n kohxiliah ya ne:pa, kohxiliah, yo:n kwali para ne:n</ANNOTATION_VALUE>
