        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>yo:n kipia *que** kiki:xtiliah para no: kwaltsi:n kakistis, entó:s nochi kwaltsi:n nochi kihtichipa:wah wa:n yo:n</ANNOTATION_VALUE>
