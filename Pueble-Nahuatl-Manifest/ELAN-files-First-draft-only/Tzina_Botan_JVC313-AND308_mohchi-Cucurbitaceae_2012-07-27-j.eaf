        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Wa:n yo:n kintsi:n no:, no: seki nikita kite:mo:tih ne:wí:n kikwih nochi ne:n kowtsitsí:n, no:, no: kihitah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
