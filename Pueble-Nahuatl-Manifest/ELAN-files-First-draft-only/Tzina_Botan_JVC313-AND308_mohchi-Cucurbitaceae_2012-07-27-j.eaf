        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Wa:n pos no: seki kita:lilia:yah yo:n kwomaxal tikiliah,</ANNOTATION_VALUE>
