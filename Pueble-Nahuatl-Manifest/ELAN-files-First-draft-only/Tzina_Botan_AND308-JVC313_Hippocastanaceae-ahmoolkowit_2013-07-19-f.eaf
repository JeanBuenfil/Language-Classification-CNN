        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>Yehwa nimolia xa: yehwa iteyo yo:n, yo:n ahmo:lkowit, a:mo n'mati pero ke:meh ne: kowtah miak kowit onkak, a:mo se: kimati toni yo:n ompa te:ntok iteyo.</ANNOTATION_VALUE>
