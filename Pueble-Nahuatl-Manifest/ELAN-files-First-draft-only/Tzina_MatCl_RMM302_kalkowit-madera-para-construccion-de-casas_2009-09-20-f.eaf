        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>Sepa nika:n se:, nika:n se: wa:n nika:n tatahko se:, entó:s kwi:kati chikwase:n kalikximeh.</ANNOTATION_VALUE>
