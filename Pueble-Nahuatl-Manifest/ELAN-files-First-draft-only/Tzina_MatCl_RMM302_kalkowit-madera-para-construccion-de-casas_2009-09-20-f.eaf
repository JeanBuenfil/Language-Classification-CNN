        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>Yehwa ya n' tehwa:n tikihtowah se:, se: *metro.** Pero tehwa:n tikihtowa:yah ne:ka *tiempo** pos tikma:kpalwia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
