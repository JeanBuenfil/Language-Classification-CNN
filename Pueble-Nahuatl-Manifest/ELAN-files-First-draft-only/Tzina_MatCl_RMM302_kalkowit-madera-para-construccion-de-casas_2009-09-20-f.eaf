        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>Na:wi kalikximeh *o hasta** chikwase:n kalikximeh, e:yi ni:nipaka.</ANNOTATION_VALUE>
