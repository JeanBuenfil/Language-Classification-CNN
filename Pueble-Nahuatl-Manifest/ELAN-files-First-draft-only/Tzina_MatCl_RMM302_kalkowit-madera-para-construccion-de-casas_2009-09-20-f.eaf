        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>*Este**, tein tehwa:n, ne:..., ne:..., ne: ke:man a:mo tikwiah *metro**, ke:meh a:xka:n moi:xmati *metro**, tiktekiah se: kowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>wa:n yo:n kowit ika mismo n' toma:wa:n tiktamachi:wayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>mah tikihto:ka:n, ke:meh a:xka:n tikihtowah tehwa:n tikma:kpalwia:yah,</ANNOTATION_VALUE>
