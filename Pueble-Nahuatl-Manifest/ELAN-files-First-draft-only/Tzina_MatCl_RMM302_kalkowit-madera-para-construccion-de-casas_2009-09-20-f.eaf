            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>entó:s yo:n a:mo moi:xmatia *metro**, yo:n moi:xmatia, tikihtowa:yah tehwa:n *vara**.</ANNOTATION_VALUE>
