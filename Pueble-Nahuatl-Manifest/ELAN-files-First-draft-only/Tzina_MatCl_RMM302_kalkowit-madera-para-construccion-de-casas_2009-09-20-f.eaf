        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Tiketsatitsatih se: kali, *no pos**, tikihtowa:yah ne:ka, ne:ka *tiempo** kihtowa:yah n' to..., n' to..., n' towe:ita:twa:n, kihtowa:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts191">
