        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>tein iniwa:n, iniwa:n timo... iniwa:n kwaltsi:n timowi:kah, tein timoi:xmatih, *porque** nika:n tehwa:n toko... totalna:miki:lis nika:n tehwa:n San Miguel,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>timomakah, *este**, timoma:..., timoma:nawiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>*Cuando** tikchi:watih se: kali mah timonawati:ka:n sah nochi n' *tivecinos** tein nika:n San Miguel wa:n ke:mah wi:tseh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>timomakah *mano** para tikwa:lkwiskeh n' tokow *o** para tiketsaskeh n' tocha:n, nochi timo..., timoma:nawiah *parejo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>*Cuando** tikwitih *por ejemplo**... n' ekintsi:n niktekito ya n' kowit, niksentili:to a:xka:n wa:n mo:sta, o:me to:nal tiksentiliah para wi:ptika ke:mah tiks..., [tik]sakah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Seki kwi:kah kwa:kwehmeh, seki kwi:kah *caballos**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>wa:n seki n' tokni:wa:n pos, tein a:mo kipia tapial kiniwi:ka ne:n, kina:kom..., *bueno** kini..., mah tikihto:kan tehwa:n kimpale:witi a, kinima:pale:witi a n' tokni:wa:n tein, tein kipiah tapialmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>*Porque cuando** tikwitih, tikwitih se: kowit a:mo moneki *porque** tapial wa:n yehwa sah ne: ya:ti n' a:kin ia:xka kipia tikwi:kas oksé: n... oksé: tapale:wihkeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>*porque cuando** ne:n ok ..., ne:n tapale:wihkeh kwa:lte:wila:na ne: tapial.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>wa:n ne:n tein a:kin ia:xka yeh kitstiwi:ts, ne: kikahchi:wtiwi:ts n' kowit, kwa:ltitilatsa n' kowit ne:n kwa:koweh *o caballo**,</ANNOTATION_VALUE>
