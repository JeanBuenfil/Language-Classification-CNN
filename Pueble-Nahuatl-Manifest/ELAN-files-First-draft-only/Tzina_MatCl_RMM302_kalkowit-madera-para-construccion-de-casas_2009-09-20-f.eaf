        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>*entonces** kipia ke kitstiwi:ts para a:mo mokwa:tsihtsikowa *porque cada vez que** kwa:ltitilatsah n' kowit motsihtsikohtiwi:ts,</ANNOTATION_VALUE>
