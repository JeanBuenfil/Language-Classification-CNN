        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>para mokwa:se:wi:ti ya n' ompa ya ne:n ta:n..., n' tama:ma:nih ya mah tikihto:ka:n n' kwow..., *este**, n' kalkow..., kalkowtama:ma:nih ya, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
