        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Wa:n se: *metro** kwi:ka ma:kwi:l mak..., ma:kwi:l mah..., ma:kpal ika, yehwa ya n' kihtowah se: *metro**, *cien centímetros**.</ANNOTATION_VALUE>
