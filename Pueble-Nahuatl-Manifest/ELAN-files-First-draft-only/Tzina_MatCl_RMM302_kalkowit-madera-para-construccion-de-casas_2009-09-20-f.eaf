        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>*Este**, yo:n talna:mikilis *todavía** mowi:ka a:x..., *hasta** a:xka:n ok *todavía** moelna:miki ok yo:n, tami n' kaltsi:n, *por ej...**, mah tikihto:kan tima:tankeh ya i:n kali ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Tima:tankeh ya i:n kali, *antes que** tiktatatili:skeh *o**antes que** n' ompa ticha:nchi:waskeh, *primero** tikno:tsah tiki..., tikno:tsaskeh tokompa:leh se: *tocompadre**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Yo:n *tocompadre** tikiliah. "¿*Sabes que?** Ne:ch..., ne:ch..., xne:chcru:s..., xne:chkru:skechili nocha:n para mah ki:sa tatio:chi:wal n' kaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Entó:s ne:n *tocompadre** ki..., tikte:mowah, kikwiti a, kite:chihchi:waltia ya n' *cruz**, sa:ntakru:stsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>wa:n kwi:ka iwa:n ne:n totio:tsi:n. N' totio:tsi:n para mah ki..., para mah kite:tio:chi:walti:ti a ompa ne:n tio:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>entó:s kite:tio:chi:waltia, ompa ke:mah te:chwa:lkwilia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>Te:chwa:lkwilia ya pero yo:n tatio:chi:wal a n' tikihtowah tehwa:n, entó:s ompa yo:n kikechili:kih tikihtowah tehwa:n, kikru:s..., kikru:skechili:kih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Ompa ke:mah, *de una vez que** panowaya yo:n..., yo:n..., yo:n tatio:chi:walis, ompa ke:mah kwali tikalakih a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Tikalakitih ya, t'tatatiliah ya, ompa timo..., ompa timo..., ompa timopale:wiah ya *pues**, yehwa yo:ni nejó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Nejó:n talna:miki:lis *todavía hasta** a:xka:n, pos *todavía** moelna:miktiw ok *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>a:mo wel moelka:wa yo:n talna:miki:lis *sino que** yo:n *desde..., desde** ne:ka *tiempo** to..., to..., tota..., tote:iskaltihka:wa:n, *toabuelitos**, towe:ita:twa:n te:chka:wilihte:wkeh yo:n talna:miki:lis</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>pos *hasta** a:xka:n *todavía** tikelna:mikih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>tein, tein tikneltokah neli ika nochi n' toyo:lo wa:n tein a:mo *pues** iwkó:n panowa ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>ke:mah, yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>Oksé: talna:miki:lis xa: tikpia tine:chtahtani:s, ¡'ne:chtahtani!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>*Este**, kwi:ka, *cuando antes de que, antes de que** kiketsati:w yo:n sa:ntah kru:stsi:n, kwi:ka tatio:chi:wala:tsí:n wa:n kwi:ka xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
