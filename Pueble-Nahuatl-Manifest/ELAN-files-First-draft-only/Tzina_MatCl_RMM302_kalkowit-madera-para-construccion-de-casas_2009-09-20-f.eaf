        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>*Entonces** n' ompa yo:n tikihtowah, mahtakti, mahtakti tamachi:w, tikchi:watih n' tocha:ntsi:n de mahtakti tamachi:w,</ANNOTATION_VALUE>
