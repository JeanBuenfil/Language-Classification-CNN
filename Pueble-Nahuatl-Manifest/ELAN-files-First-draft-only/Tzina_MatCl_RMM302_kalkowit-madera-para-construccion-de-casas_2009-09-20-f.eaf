                <ANNOTATION_VALUE>*Primero** kitachihchi:wi:tih ne:n ka:mpa sa:nta kru:stsi:n kiketsatih kitachihchi:wiah ika chamakih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>wa:n kwi:ka tekolkaxit wa:n kopaltsi:n wa:n tekoltsi:n para kipopo:chwiah. *Primero** tapopo:chwiah nochi, nochi n' ke:meh yetok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>wa:n ke:mah ka:mpa ne: ki..., [ki]ketsatih ya sa:nta kru:s tapopo:chwiah wa:n kitachihchi:wiah kwaltsi:n ika chamakih, kwaltsi:n [...]. Ompa ke:mah 'ketsah ya xo:chia:ketsal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>wa:n ompa ke:mah de xo:chia:ketsal, 'ketsatih sa:nta cru:s wa:n kichi:wiliah se: *rosario**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Yo:n *rosario kitaresa:rowiliah** mah tikihto:ka:n yehwa n' tehwa:n ki..., ki..., kima:ktiliah ya ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>kima:ktili:tih ya n' a:kin ia:xka n' icha:ntsi:n pero a:mo iwki sah, kima:ktili:tih pero ika ne:n tio:tahto:l tikihtowahtehwa:n, eh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Tio:tahto:l yehwa n' tein totio:tsi:n italna:miki:lis, yehwa yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>Ke:mah yehwa yo:n, yehwa yo:n talna:miki:lis tehwa:n nika:n .... *Bueno** yo:n talna:miki:lis tikpiah nika:n tehwa:n tima:se:walmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>*Pues** miak nekwehmolo:lis *cuando** yo:n tehwa:n tikihtowah, *este**, tik..., te:ch..., tikchi:watih yo:n ilwitsi:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>*Porque** tehwa:n tikihtowah se: ilwitsi:n, se: talna:miki:lis de wehka:wkayo:t to..., to..., *toabue...**, towe:ita:twa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>kipia ke tikinchihchi:wah pio:tsitsi:n, *siempre casi** nika:n tehwa:n mowi:ka *más** pio..., pio:nakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Ne: ke:man, pos *cuando** ne: ke:man onkayah piomeh de, de, de kowtah tikihtowah tehwa:n, pos a:mo kinkowayah ke:meh a:xka:n nochi kinkowah pio... piomeh tein *de granja**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Ne:ka *tiempo** tehwa:n tikin..., kinte:kayah n' towe:ita:twa:n, towe:ina:wa:n pio:tsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>pos sayoh ompa kintila:nah wa:n kinimihmiktiah wa:n kichi:wah ya yo:n tapalo:l</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>para takwa n' tokompa:dreh wa:n a:mo sayoh tokompa:dreh takwa:ti, sanoke takwa:tih nochi n' *invitados** tein kiniwa:lkwi te:kompa:dreh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>*aparte** ne:n a:ki:n i:n..., de, de miak pa:kilis a, ne:n a:kin icha:n no: kin..., no: kin..., no: kinyo:le:wa o:me e:yi *icompadres**, o:me, e:yi i..., ikalpanohka:wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>wa:n n' oksé: ne:n tein ne: *te:compadrito** tein kwa:lkwi sa:nta kru:stsi:n yeh no: kwa:lkwi n' i:..., n' *iamigos, icompadres,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>hasta a veces, hasta** kwa:lkwi, *este**, tatsotsonanih, kichi:wah se: pa:kilis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>¿Ke:yeh yo:n pa:kilis?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>*Porque** mowelita ne:n tokni:w ke kiketsak a n' ikalekawiltsi:n, kimattok, pos, kwali moka:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>wa:n yo:n talna:miki:lis, yo:n talna:miki:lis tikpia tehwa:n pos *porque**, pos para a:mo, mah tikihto:ka:n tehwa:n mah ti..., mah kitaka:n tokni:wa:n ke ika miak pa:kilis tikin..., tikin..., tikin..., tikinselia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Ika miak pa:kilis tikseliah santa kru:stsi:n, ika miak pa:kilis tik..., tikseliah ne:n to:..., n' *tocompadrito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>Yehwa yo:n nejó:n talna:miki:lis nika:n tehwa:n tikpiah n' tima:se:walmeh. Ke:mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>A:mo nikmati ¿oksé: talna:miki:lis tikpia tine:chtahtani:s?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>¡Ah! Yo:ni, tehwa:n tikihtowah ite:n..., itate:n..., itate:ntatsakwil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>Yo:n para a:mo no: ..., *por..., porque** mah tikihto:ka:n tehwa:n *cuando** tikta:liah n' to..., totsi:ntsakwil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>*ya sea de** xo:no:kowit, *o ya sea de** kwomimil *o ya sea, este**,..., mah tikihto:ka:n *tablas**, ke:meh a:xka:n moi:xmati *tablas**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>Yo:n tikta:liliah ne:n ite:ntatsakwil wehka ihwa:k *cuando** kiowi a:mo a:paliwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>*Porque** komo ..., ton *pasa:ro:s** mah tikihto:ka:n: nikchi:wak a nocha:ntsi:n, pero mah tikihto:ka:n telte:ntsikitsi:n kali,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>entó:s *cuando** pe:wa wa:la:ti n' kiowit, entó:s pe:wa taa:paliwi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>wa:n ke:meh tikmattokeh, ke *puro** kowit sah mah tikihto:ka:n tehwa:n *ya sea, este**, tatsakwil de, de ohtat *o** tatsakwil de xo:no:kowit *o** tatsakwil *detablas**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>*entonces** yo:n pe:wa a:paliwi wa:n de a:paliwi pe:wa pala:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>*Entonces des..., des..., después de** yo:n pos te:ch..., te:ch..., te:chma:lchi:wa ya tehwa:n *porque** pe:wa pala:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>wa:n tikmattokeh *pues que, que** ..., ika miak, ika miak, *ora** mah tikihto:ka:n ika miak owihka:yo:t para tikchihchi:wah yo:n tokalekawiltsi:n wa:n *por eso** tehwa:n semi tiknehmachpiah se: kali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>*Porque** komo a:mo kali a:mo tietoskeh kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>Eh, yehwa yo:n tehwa:n tikihtowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>¿Yehwa sah? *Bueno**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="CommentType" PARTICIPANT="Comments" TIER_ID="Comments">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>{Al tratar de hablar como los de la Sierra Norte, resulta solamente parcialmente entendible esta frase. Quizá preguntaba por donde se cortaba esa madera}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>{Escrito como de Oapan, Guerrero, donde se palataliza la /t/ antes de /i/}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>{Aquí aunque Jeremías utiliza la forma correcta de la Sierra Norte, toni, usa el impersonal nokwa de Guerrero. En la Sierra Norte dicen toni se: kikwa}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>{Jeremías dice ite:nok e ite:n por lo que se dice ite:noh en la Sierra Norte de Puebla}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
