                <ANNOTATION_VALUE>*entonces** kipia ke t'kalakili:tih e:yi kalikximeh. Se: nika:n, se: nika:n, se: ne: wa:n se: tatahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
