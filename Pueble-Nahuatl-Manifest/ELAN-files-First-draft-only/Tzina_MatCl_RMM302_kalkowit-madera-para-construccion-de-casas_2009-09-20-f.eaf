        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>*porque** tehwa:n nika:n totalna:miki:lis tehwa:n tima:se:walmeh yehwa yo:n tikpiah, timoma:ma:nawiah, timoma:...,</ANNOTATION_VALUE>
