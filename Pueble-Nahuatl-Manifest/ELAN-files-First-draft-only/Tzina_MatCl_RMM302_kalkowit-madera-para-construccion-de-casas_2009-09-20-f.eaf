                <ANNOTATION_VALUE>ke:meh onkak ka:mpa... Onkak, kanah ika onkak ta:lkwa:it *o** kanah ika onkak kowte:n, kanah ika onkak tet,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>pos yo:n kowit mopihpilohtiwi:ts.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Wa:n para a:mo motsihtsikohtiwa:las: entó:s ne: takwitapan ..., se: tein kwa:lte:wila:na n' tapial wa:n se: tein kwa:ltohtoka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>para kahchi:wtiwi:ts ne:n kowit wa:n ihkó:n, pos no: ne:si ke no: tama:... no: tama:nawia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>*Después de** yo:n tiktamisakah n' tokow pos yeh nimitsiliah neh pe:wah tiktehkoltiah ya, tikchi:wah ya n' tocha:ntsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>para a:mo ke: ne: tikihto:tih pos te:chpale:wih tiksakakeh wa:n iwki a, yo:n kipia ke te:chmaka *mano** *desde**, te:chmaka *mano desde que** tikpe:walti:tih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>*desde** ta:li:xmela:walis, kowsakalis, *este**, n' kalkechi:lis, *hasta** tami.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Se:sepatika yowi *hasta siquiera** o:me to:nal, e:yi to:nal, na:wi to:nal te:chpale:wiah ne:n tokni:wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
