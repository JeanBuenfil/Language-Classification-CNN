        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Yo:n chikwase:n kalikximeh, yehwa ya n' ka:mpa nimitsiliah ne:h ka:mpa kinkwa:tahta:liah ya n' okseki kowit,</ANNOTATION_VALUE>
