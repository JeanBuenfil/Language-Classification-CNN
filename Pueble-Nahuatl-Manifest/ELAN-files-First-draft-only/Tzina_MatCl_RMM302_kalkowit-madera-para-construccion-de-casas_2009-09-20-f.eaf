        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>A:mo moneki n' a:kin te:chmachti:ki:w. A:mo moneki n' a:kin te:chmachti:s, *sino que** tehwa:n tikitah se: kali ke:ní:w: n' chihchi:wtok.</ANNOTATION_VALUE>
