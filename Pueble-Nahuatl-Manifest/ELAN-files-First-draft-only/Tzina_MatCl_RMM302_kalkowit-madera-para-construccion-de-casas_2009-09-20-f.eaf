        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>tikma:kpa..., tikma:kpalwia:yah, tiktalia:yah se: *metro** tiktali:liah ma:kwi:l, ma:kwi:l ma:kpal.</ANNOTATION_VALUE>
