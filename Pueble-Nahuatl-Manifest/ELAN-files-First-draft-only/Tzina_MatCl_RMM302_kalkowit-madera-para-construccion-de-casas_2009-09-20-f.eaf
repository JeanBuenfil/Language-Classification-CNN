        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>yehwa yo:n ika t'tamachi:wayah wa:n komo a:mo tikwiah *vara**, yo:n *vara** tikihtowah tehwa:n mokwia de na:wi ma:kpal ika na:wi mahpil,</ANNOTATION_VALUE>
