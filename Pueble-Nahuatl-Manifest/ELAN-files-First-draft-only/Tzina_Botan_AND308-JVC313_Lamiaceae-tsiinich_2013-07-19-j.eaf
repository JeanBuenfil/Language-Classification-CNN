            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Te:ihixka sah, mahyá: te:witswia. A:mo, porin witsio.</ANNOTATION_VALUE>
