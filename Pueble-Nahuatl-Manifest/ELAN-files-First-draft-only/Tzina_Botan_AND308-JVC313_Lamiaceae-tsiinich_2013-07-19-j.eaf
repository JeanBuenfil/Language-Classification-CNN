        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Ke:na:mo, neh no: niki:xmattok yo:n kiliah tsi:nich, ke:masá: itsi:ntan ... Ne: ohte:n onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>ke:masá: se: kita, we:noh kahfe:ntah moye:kchi:wa semi, koma:mo se: tawi:teki niman ye:kwehkapantia yo:n xiwit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>wa:n metstahtakwa:wak ikwowyo wa:n achi *me..., medio esquinado** ne: nahna:wi *esquina** kipia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>pero xahxakachtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Ima:xiwyo nochi ne: xahxakachtik ima:xiwyo ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Wa:n no: kwali komohkó:n ke:meh i:n se: motsonteki ne: tein iselo se: kima:xakwalowa wa:n se: kipa:tskilia ne:n ia:yo ka:mpa se: motsonteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Yo:n kipahtia wa:n a:mo te:malowa wa:n i:xpanki:sa niman yo:n se: ... Yo:n ye:kte:kokoh yo:n tsi:nich ia:yo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>tak chichi:k *por eso** ne: semi te:kokoh pero kipahtia komohkó:n se: motsontekik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>Ke:mah wa:n no: kwaltia pero para pahti yo:n se:, se: kita:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Ka:mpa se: moteki, se: ki..., se: kipa:tska ihkwí:n *fuerte** wa:n ki:sa ia:yotsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>ye:kte:kokoh, ye:kchichinaka pero nehjó:n pahti, a:mo te:malowa wa:n niman, niman i:xpanki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Chichi:k *por eso** te:kokoh, kachi *fuerte** te:kokoh wa:n nehjó:n neli a:mo, a:mo kwaltia para teisá: se: kitatekiwti:s ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>Para teisá:, para *corral**, i:pa xiwit sah, yo:n tako:t sah, se: kite:xi:ma wa:n pala:ni ompa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>A:mo teh kwaltia wa:n nehjó:n neli no: tahtakwa:wak semi ikowyo wa:n i..., iteyo, iteyo a:mo ... Tihti:ltik iteyo yo:n ata wa:n no: i..., iwki a ke:meh chalampilo:l mochi:wa pero mochi:wa ne:n i..., ikechtan mochi:wa iteyo wa:n *cuando** wa:ki a ye:k, ye:k, *hasta** te:sohso yo:n i..., i..., itsi:nkaxyo ne:n i..., iteyo ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Ke:mah, takwa:wak semi, yehwa yo:n no:, no: tiki:xmattokeh tsi:nich, *cuando** ... kwaltia para pahti yo:n para ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Wa:n no: kwaltia kihtowa para, para kokomeh, no: kwaltia se: kita:lilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>No: pahti yo:n.</ANNOTATION_VALUE>
