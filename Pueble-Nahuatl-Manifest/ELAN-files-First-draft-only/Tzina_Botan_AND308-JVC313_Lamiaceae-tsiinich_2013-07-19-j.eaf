        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Yo:n ke:meh tehtsonkilit, ke:meh tehtsonkilit. Tehtsonkilit *solo** iwki yo:n ne:..., yo:n nehjó:n tehtsonkilit ...</ANNOTATION_VALUE>
