        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Ke:mah, pos yehwa sah yo:n n'nekia nimitstahtani:s para mah timoli:ka:n nochi ke:ní:w tiki:xmatih, ke:niwki inketsalis wa:n ox wehkapania oso ke:níwki ima:i, moneki mah ti..., timotapowi:ka:n *porque** ta:taman tiki:xmatih.</ANNOTATION_VALUE>
