        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>Ihko:ni neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>Mm, a:mo ta: yo:n i:pa, i:pa tako:t sah wa:n yo:n se: kiwiwita wa:n ompa ma:wilowa, ompa ne: ka:mpa se: tame:wa, a:mo, a:mo, a:mo ki..., a:mo kikwih, no: ke:masá: om..., ompa *cerca** se: yetok wa:n se: ki..., se: monepantahwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>komo se: kitoto:nia taxkaltsi:n, se: kololte:ma wa:n se: kipohposteki wa:n se: kixo:taltia, ne:nke:n xo:ta yo:n de sepa wa:kik a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>Xo..., ye..., tsi..., ta..., tapala:n ya, ke:mah nochi pala:ni, ma:..., nochi kikwih para kitsi:npale:wia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>Pero, ke:mah pero kwaltia ne: kowtako:t para se: taxo:talti:s *porque** semi kahkakaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Xo:ta kwaltsi:n, kachi kwaltsi:n xo:ta ke a:mo ehkaw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Yo:n kwaltsi:n xo:ta, takwa:wak, takwa:wak, pipi:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>Wa:n neli xo:ta kwaltsi:n yo:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Xo:ta kwaltsi:n.</ANNOTATION_VALUE>
