        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>*Porque** neli nika:wí: taman, nika:wí: tehwa:n no: taman onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>Ne:wí:n para ahkokopa, neli ka:mpa ne:wí:n nimitsilia neh se: ta..., ta:l..., tasese:ya tepitsi:n ompaka, no: ta:taman, ta:taman kowta:kilo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts833">
                <ANNOTATION_VALUE>Ke:meh nika:wí: tehwa:n tikihtowah pos tein takawa:ni kina:miki wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts834" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>tein nika:n ta..., tein ne:wí:n parahko wa:lewa nika:n mah kito:kaka:n a:mo no: ta:kis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts837" TIME_SLOT_REF2="ts840">
                <ANNOTATION_VALUE>A:mo no: mochi:was, yehwa yo:n neli, ke:mah pos.</ANNOTATION_VALUE>
