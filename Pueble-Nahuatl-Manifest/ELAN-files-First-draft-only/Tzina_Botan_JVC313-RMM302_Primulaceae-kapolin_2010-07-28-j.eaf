        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts842" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>*Deveras**, telmiak tasohka:matik *don** Ernesto* i:n tatsi:ntokalis no: timo..., timonohno:tsah pos neli *este**, neli ke:meh nimitsilia neh *este** mah tik..., timoseni:xmati:lti:ka:n wa:n mah timolwi:ka:n tein neli *porque** ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts847" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>Kina:miki neli wa:n ke:meh i:n se:sepa nikilia neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>Tein a:mo tiki:xmatih pos ki:xmattok oksé: wa:n ihkó:n nochi se: momati:ltia kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
