        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>para toni kwaltia yo:n kapoltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Por, pos a:mo sayoh para tehwa:n sah, sanoke para chiktehmeh no: kikwah wa:n katí:n okwiltsitsi:n ka..., we:noh, ¿katí:n chiktehtsitsi:n kikwah yo:n kapolin?</ANNOTATION_VALUE>
