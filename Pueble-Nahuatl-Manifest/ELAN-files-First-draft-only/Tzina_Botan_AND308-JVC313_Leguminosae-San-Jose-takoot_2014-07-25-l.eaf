                <ANNOTATION_VALUE>yowi n' *iramita** ihkó:n wa:n mota:lia n' ikwa:pan xo:chit wa:n ompa tamia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
