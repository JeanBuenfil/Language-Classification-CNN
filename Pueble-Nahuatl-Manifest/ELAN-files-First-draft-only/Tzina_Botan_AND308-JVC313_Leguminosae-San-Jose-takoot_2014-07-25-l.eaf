                <ANNOTATION_VALUE>toto:nikta:lpan sah ka:mpa texa:lata:l ompa sah mochi:wa pero nikahkwí:n a:mo kanah tikitah mochhi:wayo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
