        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Nochi mochi:wa, nochi mochi:wa tein moskaltia n' itsmol pero a:mo miak n' itsmol mota:lia</ANNOTATION_VALUE>
