            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Wa:n a:mo, a:mo mochi:wa ka:mpa tiknekis nikahkwí:n osto:ka:pan *o** a:tepoliwi a:mo tikitas *o** kowtah ka:n mochi:wa nika:n sah ka:mpa</ANNOTATION_VALUE>
