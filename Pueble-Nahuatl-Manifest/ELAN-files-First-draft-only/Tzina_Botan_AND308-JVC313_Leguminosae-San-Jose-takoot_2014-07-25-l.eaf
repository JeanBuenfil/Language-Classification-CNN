        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>Pipi:nik yo:n pipi:nik a:mo posteki yo:n. Ke:mah kwaltsi:n yo:n.</ANNOTATION_VALUE>
