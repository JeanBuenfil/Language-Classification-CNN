                <ANNOTATION_VALUE>Wa:n ixo:chio nikitaya ye:kkwa:oholo:chtik n' ahko ye:kkwa:oholo:chitk ihkó:n mochi:wa wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
