        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Ne: pahti yo:n, yo:n xiwit nite:kakilia, we:noh ne: te:chilia:yah ta:tahmeh,</ANNOTATION_VALUE>
