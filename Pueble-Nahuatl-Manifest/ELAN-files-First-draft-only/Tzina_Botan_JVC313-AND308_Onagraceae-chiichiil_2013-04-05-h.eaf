                <ANNOTATION_VALUE>Onkaya pa:nxapoh ika kixakwalowa:yah. Ke:mah kohkostik, ye..., kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Kiliah ko..., kowtsapoxapoh kito:ka:itia:yah ne: ta..., ta:tahmeh.</ANNOTATION_VALUE>
