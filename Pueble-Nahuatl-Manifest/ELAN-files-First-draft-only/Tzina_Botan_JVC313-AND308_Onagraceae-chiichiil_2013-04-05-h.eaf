        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Yehwa ne: ika kina:ltia:yah, ika yo:n semi kwali pahti para yo:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Ke:mah, ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>Ke:mah wa:n kina:mikia ne:n, ne:n tapialmeh ki..., kina:ltia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Kilpia:yah, kilpia:yah para a:mo kinkehtsomas wa:n kika:ltiahwa:n kixakwalowah ika xapoh wa:n kite:te:kiliah n' a:t wa:n yowi kokolis pero ke:ra ka:n na:wpa ka:ltia, kika:wa yo:n kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Yo:n kwali pahti yo:n nite:kakilia wa:n tein tota:tahwa:n tikinkakilia:ya ke pahti yo:n no: xiwtsi:n, kiliah chi:chil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>pero ni..., ka:sá: ika mochi:wa ne: yo:n kow..., xiwit, ikowyo chi:chi:ltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>wa:n i..., ima:xiwyo ne:, ke:meh chi:ltekpin ima:xiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>Wa:n nehjó:n ixo:chio, ixo:chio pa:pata..., pa:pata:wak wa:n ma:i..., i:xse:sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Wa:n ma:kwi:l sah pané: motekpa:na xo:chitsi:n, moyewalowa ihkó:n moke kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Yehwa yo:n mo..., mo..., kanah meh...., mah.., mahyá: kiliah xo:chitsi:n, koyo:meh kiliah *petalos**. Mm, yehwa se: mota..., ma:kwi:l sah mota:lilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Yehwa sah yo:n mopata:wa ihkó:n pahpat..., pahpata:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Wa:n imets..., imetskowyo xo:..., ixo:chiotsi:n mahyá: yo:n *clavo** ne: tsi:npitsaktik wa:n ikwa:ko mota:lia xo:..., ixo:chio, ihkó:n *mero**, yo:n *clavo** pisi:ltik wa:n ne: wehwei, ihkwi:kwí:n we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Pos a:mo se: kimati ke:ní:w pero nepantah xo:chiowa ke:meh yo:n xo:no:ochpa:was, yeh nepantah xo:chiowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>pero yo:n, yo:n xiwit nimitsilia a:mo n'mati ke:ní:w tak xa: poso:ni *este** de kwalka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>*Porque solo** yetok sah tein x..., tein poso:ni nepantah yehwa ke:m..., ke:meh yo:n ala:wakochpa:wa:s yeh ke:mah poso:ni nepantah sah. Yehwa sah yo:n *hora** ta:tahmeh kipiayah yehwa inhora, komo poso:ni eski nepantah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Komo mixtah oso kiowtok ka:mpa, nepantah poso:nik a ne:n xo:chitsi:n. Ke:mah, yehwa inhora katka, ke:mah, yehwa yo:n pero ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Pero neli yo:n xo:chit a:mo n'mati ke:maniá:n poso:ni, tak poso:ni de kwalka:n ke:meh yo:n *cuando** chika:waya xo:chit pos poso:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah mah se: kin...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Mah se: kinina:lti ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
