        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>wan ika kina:ltiah wa:n ika xapoh kixakwalowa:yah ne: yo:n onkaya, ima..., ihwa:k kinamakayah ata yo:n pa:nxapoh, [a:mo ke:meh]ekintsi:n onkak *polvo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
