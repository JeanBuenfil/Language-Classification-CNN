                <ANNOTATION_VALUE>Pos neh no: niki:xmattok, kwali a ke tine:chtahtania wa:n pos tim..., timomati:ltiah ihkó:n de n' tikitstinemih ke:meh i:n kowtah tinemih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts13">
