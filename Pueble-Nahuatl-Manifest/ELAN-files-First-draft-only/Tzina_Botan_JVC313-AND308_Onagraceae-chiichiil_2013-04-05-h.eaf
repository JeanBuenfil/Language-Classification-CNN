        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Ke:mah, pos neh no: niki:xmattok ne: 'to:ka:itiah chi:chi:l ne: chi:chil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Chi:chi:l tikiliah tehwa:n *porque** mochi:wa mochi:wa chia:wit wa:n yo:n, yo:n chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Chichi:k wa:n nehjó:n yehwa yo:n no: kwali kihtowah kikwih para, para sa:watih itskwimeh ika kina:ltiah, pahti no: para sa:wameh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Yehwa yo:n pahti, ata seki itskwimeh ata kokoliskwih wa:n tein itskwinti tein servi:rowa, kiikne:liah kipahtiah ma:s[ki]sa:wati, kipah..., kipahtiah,</ANNOTATION_VALUE>
