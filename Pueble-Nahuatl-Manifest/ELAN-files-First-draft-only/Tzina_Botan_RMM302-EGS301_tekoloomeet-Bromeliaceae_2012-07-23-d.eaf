        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts741" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>mo..., motaka:wa nochi,</ANNOTATION_VALUE>
