        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>Pero yo:nno: kipia n' iwi:kal, ke:yeh yo:n ika tachihchi:wah.</ANNOTATION_VALUE>
