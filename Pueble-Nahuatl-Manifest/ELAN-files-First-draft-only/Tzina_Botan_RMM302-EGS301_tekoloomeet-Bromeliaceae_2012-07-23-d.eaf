        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>Tak tikmatis ke:meh ye:wa ya n' timonohno:tstokeh yekintsi:n yo:n ki..., yo:n talna:miki:lis *que** mah tikihtoka:n kelka:wtiwih ya m' pi:pil.</ANNOTATION_VALUE>
