        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>a:mo onkak, a:mo onkas nió:n teh nekwehmolo:lis, mah tikihto:ka:n pe:wah *desde n' jueves santo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts745" TIME_SLOT_REF2="ts746">
