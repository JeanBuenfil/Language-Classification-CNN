        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>Wa:n mah ihkó:n tikini:xeka:naka:n n' topi:pilwa:n para yo:n talna:miki:lis pos a:mo ke:man kelka:waskeh, nochipa ya...</ANNOTATION_VALUE>
