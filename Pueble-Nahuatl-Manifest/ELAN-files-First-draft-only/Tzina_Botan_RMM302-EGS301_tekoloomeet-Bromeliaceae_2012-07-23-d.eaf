        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts747" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>ne:, ne: ke:man kichi:wayah tahkoyowa:n, kihtowah ya yo:n moxelowa yowal,</ANNOTATION_VALUE>
