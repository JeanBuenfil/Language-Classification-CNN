        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts1144" TIME_SLOT_REF2="ts1145">
                <ANNOTATION_VALUE>Wa:n a:man a:mo, a:man tikitah neli n' tein teh tiki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts1146" TIME_SLOT_REF2="ts1147">
                <ANNOTATION_VALUE>tikihtowa tikitsi:n ilwitsí:n, we:i ilwit kichi:wah, we:i *gasto** kita:liah.</ANNOTATION_VALUE>
