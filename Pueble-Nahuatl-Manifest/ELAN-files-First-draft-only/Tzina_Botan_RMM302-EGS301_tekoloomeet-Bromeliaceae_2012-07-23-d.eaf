        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts1092" TIME_SLOT_REF2="ts1093">
                <ANNOTATION_VALUE>xa: n' okseki xola:lmeh ke:mah poliwtok ya, pero neli n' okseki xola:lmeh pos neli a:mo teh mihto:tia:nih, tiow n' teh n' ilwit pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts1094" TIME_SLOT_REF2="ts1095">
