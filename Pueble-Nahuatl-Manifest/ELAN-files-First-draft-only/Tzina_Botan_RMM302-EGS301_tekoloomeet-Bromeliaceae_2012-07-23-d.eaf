            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts1156" TIME_SLOT_REF2="ts1157">
                <ANNOTATION_VALUE>Yo:n, wa:n ika nochi yo:n, yo:n nimitsilia *bueno**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts1158" TIME_SLOT_REF2="ts1159">
