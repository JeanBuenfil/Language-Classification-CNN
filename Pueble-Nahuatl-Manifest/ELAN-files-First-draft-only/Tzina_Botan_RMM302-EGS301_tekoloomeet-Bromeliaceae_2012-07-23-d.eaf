        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Yehwa ya ekintsi:n, ke:meh ekintsi:n tine:chnohno:tstok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>teh tikmati sayoh para ika tachihchi:wah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Pero yo:n a:mo tikmatih toni yo:n kihto:sneki, ke:ní:..., ke:yeh yo:n.</ANNOTATION_VALUE>
