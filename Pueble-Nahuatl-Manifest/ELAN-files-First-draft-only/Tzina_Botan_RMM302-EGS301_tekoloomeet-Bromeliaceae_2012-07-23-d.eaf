        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts1199" TIME_SLOT_REF2="ts1200">
                <ANNOTATION_VALUE>miak talna:miki:lis tikel..., tikelna:mikkeh tein</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a624" TIME_SLOT_REF1="ts1201" TIME_SLOT_REF2="ts1202">
                <ANNOTATION_VALUE>tein ne:ka *tiempo** tikitstiwa:lahkeh wa:n tikitstiwi:tseh *todavía** axka:n i:n to:nal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a625" TIME_SLOT_REF1="ts1203" TIME_SLOT_REF2="ts1204">
                <ANNOTATION_VALUE>nikwelita kwaltsi:n timonohno:tstokeh wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts1205" TIME_SLOT_REF2="ts1206">
                <ANNOTATION_VALUE>neli ke:meh nimitsilia mah..., nikwelitaskia mah a:mo ke:man koto:niskia n' talna:miki:lis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a627" TIME_SLOT_REF1="ts1207" TIME_SLOT_REF2="ts1208">
                <ANNOTATION_VALUE>neli kemeh tine:chilia n' teh wi:tseh miak pi:pil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a628" TIME_SLOT_REF1="ts1209" TIME_SLOT_REF2="ts1210">
                <ANNOTATION_VALUE>talwichi:wakih *cuando**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629" TIME_SLOT_REF1="ts1211" TIME_SLOT_REF2="ts1212">
                <ANNOTATION_VALUE>talwi..., talwi:ti nika:n *San Miguel**, tikihtowah n' tehwa:n ilwiti ne:n *patrón**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630" TIME_SLOT_REF1="ts1213" TIME_SLOT_REF2="ts1214">
                <ANNOTATION_VALUE>towe:..., tow..., towe:ite:nkowyo mah tikihto:ka:n tehwa:n nika:n toxola:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631" TIME_SLOT_REF1="ts1215" TIME_SLOT_REF2="ts1216">
                <ANNOTATION_VALUE>kwaltsi:n kitalwiki:xtiliah wa:n mah tikihto:ka:n mah kisentokaskia, mah a:mo moelka:waskia ne:, yo:n talna:miki:lis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a632" TIME_SLOT_REF1="ts1217" TIME_SLOT_REF2="ts1218">
                <ANNOTATION_VALUE>mah tikihto:ka:n tehwa:n mah a:mo tikelka:waka:n tehwa:n titaskaltia:nimeh para a:mo no: kelka:waskeh n' topi:pi:lilwa:n mah tikini:xeka:naka:n ke:mih i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a633" TIME_SLOT_REF1="ts1219" TIME_SLOT_REF2="ts1220">
                <ANNOTATION_VALUE>ke:meh moneki. Neli n' ke:meh nimitsilia tak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634" TIME_SLOT_REF1="ts1221" TIME_SLOT_REF2="ts1222">
                <ANNOTATION_VALUE>*cada, cada** xola:ltsí:n kipia n' italna:miki:lis, ke:meh nika:n kwesala:n tikihtowah neli tak yo:n no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a635" TIME_SLOT_REF1="ts1223" TIME_SLOT_REF2="ts1224">
                <ANNOTATION_VALUE>no: koyo:meh intalna:miki:lis, no: koyo:meh intanemili:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a636" TIME_SLOT_REF1="ts1225" TIME_SLOT_REF2="ts1226">
                <ANNOTATION_VALUE>pero pos komo *kiseguiro:skia** ma:se:walmeh niki:ehekowa a:chá: no: moyeka:naskiah ke:meh *kiseguirowa** ke:meh nika:n tehwa:n ne:n toxola:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a637" TIME_SLOT_REF1="ts1227" TIME_SLOT_REF2="ts1228">
                <ANNOTATION_VALUE>Pos a:mo nikmati xa:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638" TIME_SLOT_REF1="ts1229" TIME_SLOT_REF2="ts1231">
                <ANNOTATION_VALUE>mo..., mo..., moelna:miki *más** talna:miki:lis, xa: yehwa sah, neh pané: nikmati kit mahyá: yehwa sah n' tein ika timonohno:tskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a662" TIME_SLOT_REF1="ts1279" TIME_SLOT_REF2="ts1280">
                <ANNOTATION_VALUE>Pos ke:mah, yehwa yo:n ika timonohno:tskeh neli n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663" TIME_SLOT_REF1="ts1281" TIME_SLOT_REF2="ts1282">
                <ANNOTATION_VALUE>mah tikihto:ka:n, *este**, n' tein ika tne:chtekpa:nilih, n' chamakih,, *este**, ne:n tek..., tekolo:me:t, sempowalxo:chit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664" TIME_SLOT_REF1="ts1283" TIME_SLOT_REF2="ts1284">
                <ANNOTATION_VALUE>yehwa yo:n tewi:tso:t, yo:n neli pano..., panowa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665" TIME_SLOT_REF1="ts1285" TIME_SLOT_REF2="ts1286">
                <ANNOTATION_VALUE>Nochi yo:n, pero n' chamakih neli yo:n ke:man, ke:man tikelna:mikih pos nochipa, noch..., *siempre, siempre** nochipa onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666" TIME_SLOT_REF1="ts1287" TIME_SLOT_REF2="ts1288">
                <ANNOTATION_VALUE>Sepa ne: xo:chia:ketsal yo:n a:mo ke:man koto:ni yo:n talna:m..., tanemili:lis, yo:n *siempre** nochipa tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667" TIME_SLOT_REF1="ts1289" TIME_SLOT_REF2="ts1290">
                <ANNOTATION_VALUE>ttanemiliah tika:ketsaskeh ma:ski a:..., ma:ski a:mo semi chihchikwe:ika, ma:ski kahkaxto:lika to:nal pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668" TIME_SLOT_REF1="ts1291" TIME_SLOT_REF2="ts1292">
                <ANNOTATION_VALUE>tiknemiliah tikpatas..., tika:pataskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669" TIME_SLOT_REF1="ts1293" TIME_SLOT_REF2="ts1294">
                <ANNOTATION_VALUE>*Pues** yehwa sah yo:n ika timonohno:tskeh, a:mo nikmati neh, *este**, pos semi kwaltsi:n, kwaltsi:n yetoya n' tosa:ni:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670" TIME_SLOT_REF1="ts1295" TIME_SLOT_REF2="ts1297">
                <ANNOTATION_VALUE>wa:n nochi tikelna:mikkeh kwaltsi:n talna:miki:lis wa:n mah tikchaskiah mah a:mo ke:man poliwiskia neli yo:n talna:miki:lis, pos neh pané: nikmati pané: yehwa sah n' tein ika timonohno:tskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678" TIME_SLOT_REF1="ts1313" TIME_SLOT_REF2="ts1314">
                <ANNOTATION_VALUE>*Pues** neh nikitaya ne:..., ne:..., ne:ka to:nal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679" TIME_SLOT_REF1="ts1315" TIME_SLOT_REF2="ts1316">
                <ANNOTATION_VALUE>pos neli, neli n' to..., totaskaltia:n..., toskal..., skaltia:niwa:n[tote:iskaltihka:wa:n]katka ne:n towe:ita:twa:n pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a680" TIME_SLOT_REF1="ts1317" TIME_SLOT_REF2="ts1318">
                <ANNOTATION_VALUE>tikihto:ka:n yehwa:n ke:meh i:n ki..., kite:mowa:yah ma:ski kowtahxo:..., kowtahxo:chitsí:n, ke:meh i:n nika:wí:n tehwa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681" TIME_SLOT_REF1="ts1319" TIME_SLOT_REF2="ts1320">
                <ANNOTATION_VALUE>onkaya tehtein weli xo:chitsí:n ki..., ka:ketsayah *siquiera** mah tikihto:ka:n, sake:ra mah kitaka:n kalihtik tas..., taselistok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a682" TIME_SLOT_REF1="ts1321" TIME_SLOT_REF2="ts1322">
                <ANNOTATION_VALUE>Wa:n a:man a:mo, n' a:man tikihtowah tehwa:n a:man nochi tikowah ya sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683" TIME_SLOT_REF1="ts1323" TIME_SLOT_REF2="ts1324">
                <ANNOTATION_VALUE>¿Ke:yeh? N' a:man wa:n miak xo:chitsí:n kwaltemo:ltiah de ne:wí:n parahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a684" TIME_SLOT_REF1="ts1325" TIME_SLOT_REF2="ts1326">
                <ANNOTATION_VALUE>Ne: ke:man onkaya, onkaya pero semi a:mo *ig...**, a:mo ke:..., a:mo ke:meh a:man tikitah n' tehwa:n onkak xo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a685" TIME_SLOT_REF1="ts1327" TIME_SLOT_REF2="ts1328">
                <ANNOTATION_VALUE>Neh nik..., neh nikita...,, nikitaya ne: ne:ka to:nal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a686" TIME_SLOT_REF1="ts1329" TIME_SLOT_REF2="ts1330">
                <ANNOTATION_VALUE>tikwelitayah n' tehwa:n semi xo:chitsí:n tik..., tika:ketsayah yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a687" TIME_SLOT_REF1="ts1331" TIME_SLOT_REF2="ts1332">
                <ANNOTATION_VALUE>yo:n te:ntso:n..., te:ntsonxo:chit kilwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a688" TIME_SLOT_REF1="ts1333" TIME_SLOT_REF2="ts1334">
                <ANNOTATION_VALUE>Te:ntsonxo:chit komo a:mo yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689" TIME_SLOT_REF1="ts1335" TIME_SLOT_REF2="ts1336">
                <ANNOTATION_VALUE>kiliah, *este**, n..., a:mo nikmati ke:ní:w mono:tsa ma:se:walkopa, yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a690" TIME_SLOT_REF1="ts1337" TIME_SLOT_REF2="ts1338">
                <ANNOTATION_VALUE>kito:kaytiah koyo:kopa *tulipán**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a691" TIME_SLOT_REF1="ts1339" TIME_SLOT_REF2="ts1340">
                <ANNOTATION_VALUE>A:mo n'mati ma:se:walkopa ke:ní:w mono:tsa yo:n a:..., oholo:chtik ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692" TIME_SLOT_REF1="ts1341" TIME_SLOT_REF2="ts1342">
                <ANNOTATION_VALUE>Yehwa yo:n ne: ne:k..., ne:ka to:nal semi tikwit..., tikteltekiah wa:n tikmattoyah *que** nika:wí:n tehwa:n *solamente** yehwa yo:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693" TIME_SLOT_REF1="ts1343" TIME_SLOT_REF2="ts1344">
                <ANNOTATION_VALUE>No: mochi:wa n' sempowalxo:chit ke:meh nimitsilia neh pero no: panowa sah, yo:n a:mo nochipa, olo:xo:chit no: panowa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694" TIME_SLOT_REF1="ts1345" TIME_SLOT_REF2="ts1346">
                <ANNOTATION_VALUE>Yo:n olo:xo:chit no: a:mo, a:mo nochipa onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695" TIME_SLOT_REF1="ts1347" TIME_SLOT_REF2="ts1348">
                <ANNOTATION_VALUE>Katí:n *siempre, siempre** onkak no: yehwa yo:n, yehwa yo:n te:ntsonxo:chit no: et..., no: etok, no: e..., to:nal sah, a:mo no: nochipa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696" TIME_SLOT_REF1="ts1349" TIME_SLOT_REF2="ts1350">
                <ANNOTATION_VALUE>Entó:s nochi yehwa yo:n tehwa:n tiksehsentilia:yah, ke:meh i:n to..., tokow..., kowtahxo:chitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a697" TIME_SLOT_REF1="ts1351" TIME_SLOT_REF2="ts1352">
                <ANNOTATION_VALUE>wa:n a:man a:mo, n' a:man, n' a:man nikita neh kwa:l..., miak xo:chitsí:n kwa:ltemo:ltiah de ne:wí:n parahko, n' a:man nochi yehwa t'tatekiwtiah, n' a:man nochi tikowah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698" TIME_SLOT_REF1="ts1353" TIME_SLOT_REF2="ts1354">
                <ANNOTATION_VALUE>Ne:n, ne:n ne:ka to:nal neli pos ke:meh tikihtowah tehwa:n pos tak a:mo te:chahsia n' taxta:wi:ltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699" TIME_SLOT_REF1="ts1355" TIME_SLOT_REF2="ts1356">
                <ANNOTATION_VALUE>tehtein weli xo:chitsí:n tiksentilia:yah nika:wí:n wa:n tika:ketsayah, *pero siempre** tikitayah mah taseli:l</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700" TIME_SLOT_REF1="ts1357" TIME_SLOT_REF2="ts1359">
                <ANNOTATION_VALUE>mah taselisto n' kalihtik, a:mo ke:man semi tika:wayah mah ta..., tawa:kto. Yehwa yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730" TIME_SLOT_REF1="ts1419" TIME_SLOT_REF2="ts1420">
                <ANNOTATION_VALUE>*Pues** tikmatis ke:yeh yo:n, a:mo, a:mo t.., a:mo semi *porque** tikihto:ka:n tehwa:n, *este**, tel...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731" TIME_SLOT_REF1="ts1421" TIME_SLOT_REF2="ts1422">
                <ANNOTATION_VALUE>a:mo onkak, *sino que** yeh a:mo wehka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732" TIME_SLOT_REF1="ts1423" TIME_SLOT_REF2="ts1424">
                <ANNOTATION_VALUE>Yo:n tein tine:chnohno:tstok, *hortensiaxo:chit** kilwiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733" TIME_SLOT_REF1="ts1425" TIME_SLOT_REF2="ts1426">
                <ANNOTATION_VALUE>yo:n a:mo wehka:wa, niman wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734" TIME_SLOT_REF1="ts1427" TIME_SLOT_REF2="ts1428">
                <ANNOTATION_VALUE>Komo a:mo, komo semi, semi wehka:was</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735" TIME_SLOT_REF1="ts1429" TIME_SLOT_REF2="ts1430">
                <ANNOTATION_VALUE>e:yi to:nal, na:wi to:nal wa:n pe:wa nojó:n mahyá: tikihtowah tehwa:n ma:kwehkwetawi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736" TIME_SLOT_REF1="ts1431" TIME_SLOT_REF2="ts1432">
                <ANNOTATION_VALUE>Oksé: yo:n xo:chit tein tine:chilia yeh n' *saliahxo:chit** a:mo no: wehka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737" TIME_SLOT_REF1="ts1433" TIME_SLOT_REF2="ts1434">
                <ANNOTATION_VALUE>*Por, por eso** yehwa:n kihtowah a:mo kikowah, a:mo ki..., a:mo kachika:ketsah ok n' a:man porin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738" TIME_SLOT_REF1="ts1435" TIME_SLOT_REF2="ts1436">
                <ANNOTATION_VALUE>pos ne: ke:man neli, pos tikihtowah tehwa:n a:mo, a:mo, a:mo semi monamakaya, nika:wí:n onkaya t..., yo:n xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739" TIME_SLOT_REF1="ts1437" TIME_SLOT_REF2="ts1438">
                <ANNOTATION_VALUE>pero no: poliwtiw a, n' *hortensiaxo:chit** tehwa:n nika:n i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740" TIME_SLOT_REF1="ts1439" TIME_SLOT_REF2="ts1440">
                <ANNOTATION_VALUE>ka:mpa ticha:nchi:wah nochi yehwa katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a741" TIME_SLOT_REF1="ts1441" TIME_SLOT_REF2="ts1442">
                <ANNOTATION_VALUE>Ke:meh i:n kahfe:ntah ka:mpa ttawi:tekiah nochi yehwa katka yo:n xo:ch..., xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a742" TIME_SLOT_REF1="ts1443" TIME_SLOT_REF2="ts1444">
                <ANNOTATION_VALUE>N' a:man ka:n..., ka:n kanah tei ok n' a:man, nochi wa:ktiw a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a743" TIME_SLOT_REF1="ts1445" TIME_SLOT_REF2="ts1446">
                <ANNOTATION_VALUE>Pos n' a:man yo:n onkas pero mah semi kinehmachpiaka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744" TIME_SLOT_REF1="ts1447" TIME_SLOT_REF2="ts1448">
                <ANNOTATION_VALUE>mah no: tikihto:ka:n kita:lili:ka:n tapala:n para no: onkas yo:n xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745" TIME_SLOT_REF1="ts1449" TIME_SLOT_REF2="ts1450">
                <ANNOTATION_VALUE>Nochi yo:n xo:chitsí:n tein tine:chnohno:tstok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a746" TIME_SLOT_REF1="ts1451" TIME_SLOT_REF2="ts1452">
                <ANNOTATION_VALUE>nochi yo:n, nochi poliwtiw a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747" TIME_SLOT_REF1="ts1453" TIME_SLOT_REF2="ts1454">
                <ANNOTATION_VALUE>Wa:n se:, s..., oksepa no: nimitsilia neh a:mo no: wehka:wa *por eso** a:mo no: semi kiteltatekiwtiah yo:n xo:chitsí:n ka:ketsaskeh *porque** a:mo wehka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748" TIME_SLOT_REF1="ts1455" TIME_SLOT_REF2="ts1456">
                <ANNOTATION_VALUE>*Mejor** no: etok sah n' xo:chitsí:n tein, tein moma:patiliah, timoma:patiliah ne: kwesala:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749" TIME_SLOT_REF1="ts1457" TIME_SLOT_REF2="ts1458">
                <ANNOTATION_VALUE>etok xo:chitsí:n tein wehka:wa tikwelitah, *porque** nimitsilia neh tein wehka:wa sake:ra kaxto:lto:nal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750" TIME_SLOT_REF1="ts1459" TIME_SLOT_REF2="ts1460">
                <ANNOTATION_VALUE>komo tiknemilih *que** tiktsi:na:pataskeh, tika:patah *siquiera** wa:n xo:chitsí:n ke:mih i:pa yetok xo:chitsí:n, wehka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a751" TIME_SLOT_REF1="ts1461" TIME_SLOT_REF2="ts1462">
                <ANNOTATION_VALUE>Yehwa yo:n tehwa:n tikitiliah, a:mo *porque** semi tikihtowah tehwa:n tel...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752" TIME_SLOT_REF1="ts1463" TIME_SLOT_REF2="ts1464">
                <ANNOTATION_VALUE>telkwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753" TIME_SLOT_REF1="ts1465" TIME_SLOT_REF2="ts1466">
                <ANNOTATION_VALUE>Sanoke tehwa:n tikitiliah *de que** wehka:wa xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754" TIME_SLOT_REF1="ts1467" TIME_SLOT_REF2="ts1468">
                <ANNOTATION_VALUE>Ika yo:n tehwa:n tikihtowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a755" TIME_SLOT_REF1="ts1469" TIME_SLOT_REF2="ts1470">
                <ANNOTATION_VALUE>Yo:n ne:wí:n parahko..., w..., wa:n a:xka:n mia:..., a:xka:n telmiak taman xo:chit kwa:ltemo:ltiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a756" TIME_SLOT_REF1="ts1471" TIME_SLOT_REF2="ts1472">
                <ANNOTATION_VALUE>seki telkwaltsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a757" TIME_SLOT_REF1="ts1473" TIME_SLOT_REF2="ts1474">
                <ANNOTATION_VALUE>pero yehwa ya n' ke:meh nimitsilia neh, seki wehka:wa, seki a:mo wehka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a758" TIME_SLOT_REF1="ts1475" TIME_SLOT_REF2="ts1476">
                <ANNOTATION_VALUE>Wa:n tehwa:n tikowah ma:ski tikihtowah tehwa:n, ma:..., ma:ski *medio** pati:yoh tikixta:watih pero tikmattokeh wehka:wati *siquiera** kaxto:l to:nal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a759" TIME_SLOT_REF1="ts1477" TIME_SLOT_REF2="ts1478">
                <ANNOTATION_VALUE>wa:n kipia n' tachialis ke:mih, ke:mih i:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a760" TIME_SLOT_REF1="ts1479" TIME_SLOT_REF2="ts1480">
                <ANNOTATION_VALUE>A:xka:n tehwa:n xo:chitsí:n tein nika:n, tein tine:chto:ka:ytilih yo:n xo:chitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761" TIME_SLOT_REF1="ts1481" TIME_SLOT_REF2="ts1482">
                <ANNOTATION_VALUE>a:mo wehka:wa, semi wehka:was tak se: na:wi to:nal wa:n ke:mah pe:wa ya ma:i..., ma:xi:i:ni a, komo a:mo wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762" TIME_SLOT_REF1="ts1483" TIME_SLOT_REF2="ts1484">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n tehwa:n tikitiliah, tehwa:n tikitiliah tein wehka:wa xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a763" TIME_SLOT_REF1="ts1485" TIME_SLOT_REF2="ts1486">
                <ANNOTATION_VALUE>Ke:meh a:xka:n te:chwa:ltemo:ltiliah de ne:wí:n parahko, pos yo:n xo:chitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764" TIME_SLOT_REF1="ts1487" TIME_SLOT_REF2="ts1488">
                <ANNOTATION_VALUE>wehka..., wehka:wa taxi:kohtok, *siquiera** komo tiknemilihkeh t'tsi:na:pataskeh, t'tsi:na:patah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a765" TIME_SLOT_REF1="ts1489" TIME_SLOT_REF2="ts1491">
                <ANNOTATION_VALUE>kaxto:l to:nal kipia tachialis ke:meh..., tachialis kwaltsi:n. Yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775" TIME_SLOT_REF1="ts1511" TIME_SLOT_REF2="ts1513">
                <ANNOTATION_VALUE>Pos semi kwaltsi:n, miak tasohka:matik. Neh nimono:tsa niRubén Macario Martínez, nipowi nika:n Chilcuauhta, Chilcuauhta *nivivirowa**, nipowi, nipowi nika:n *es...** San Miguel nicha:nchi:wa nika:n Chilcuauhta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
