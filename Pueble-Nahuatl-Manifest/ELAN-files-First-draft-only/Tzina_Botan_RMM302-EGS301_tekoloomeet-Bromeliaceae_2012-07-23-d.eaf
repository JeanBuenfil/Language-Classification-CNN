        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts878" TIME_SLOT_REF2="ts879">
                <ANNOTATION_VALUE>Ke:meh tikitstiwih kichi:wah, no: t'chi:wah n' tehwa:n wa:n neli yehwa i:n timonohno:tstoyah ika tekolo:met pos</ANNOTATION_VALUE>
