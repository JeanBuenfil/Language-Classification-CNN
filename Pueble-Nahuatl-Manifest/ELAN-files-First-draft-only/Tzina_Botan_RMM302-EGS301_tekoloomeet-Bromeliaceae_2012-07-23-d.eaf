            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts558" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>pos *este**, pos xa: a:mo kichi:waskeh ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>pero ke:meh, *este**, miakeh ne: tikitah, *bueno** neh nikita nika:n kachi *más** n' toxola:l San Miguel</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>timiakeh i:n achi..., ekintsi:n toma:se:waltilmah poliw nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>mah tkihto:ka:n pos, *este**, nochi i:n tein ompa tinemih, tein i:n tipi:pil ok nochi tko:koyo:tamatih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>pero pos ke:meh tikihtowah tehwa:n ne:n koyo:t sayoh ne:n totake:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts568" TIME_SLOT_REF2="ts569">
                <ANNOTATION_VALUE>pero ne:n toyo:lo, totanemili:l wa:n nochi n' ke:meh tinemih pos nohma tima:se:walmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>wa:n neh nimolia *que** yo:n, yo:n pos a:mo poliwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>Ke:meh i:n..., wa:n i:pa ka:mpa eski teh, teh tiá:s i:pa ka:mpa eski,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>kati:eski kali teh tiá:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts576" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>sayoh tein..., *bueno** pos neli kalaktok i:n okseki tanemili:lis tein a:mo taneltokah ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>entó:s yo:n yehwa:n, sayoh yehwa:n neli ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>no: taman n' tanemiliah, no: kipiah toni ne: kimatih, no: taman kitohtokah mah tkihto:ka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>pero pos kachi miakeh n' tein taneltokah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>ma:ski tiá:s katiye:ski kali n' teh pero i:pa etok ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts586" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>*santoi:xpan**, i:pa ka:mpa eski tiá:s,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>tikalakiti:w i:pa yekinika yetok yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Wa:n yo:n neh nki:xehekowa *que** yo:n a:mo, a:mo poliwis, tak xa: poliwis pero wehka:was ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>A:mo niman, *porque** tikita n' in..., ke:meh ekintsi:n i:n tein pi:pil nochi kipiah inchahcha:n pero nochi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>nochi:n kipiah yo:n *santoi:xpan**, nochi:n kipiah n' *artalkowit**, ma:ski tikihtowa n' teh a:mo kachi tachihchi:wah pero sake:ra sepa xiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>kita:liah xo:chit, ke:meh yo:n komohkó:n, *este**, pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>kanah ika kinyo:le:wah mah *mayordomotika:n** pos i:pa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>i:pa kichi:waltiah yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>chi:walis wa:n i:pa, i:pa kita:liah yo:n xo:chit, ta:ká:n neli xa: a:mo mokwis ok yehwa i:n timonohno:tstokeh tekolo:me:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>xa: neli i:xpoliwis yo:n kikwih porin kihto:snekih n' seki:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>kikow..., kikowah oso a:mo ke:mantih kite:mo:ti:wih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts609">
                <ANNOTATION_VALUE>Pero nimolia nochi yehwa i:n *pues**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>poliw..., poliwtiw, poliwtiw pero yo:li:k para poliwis, tein ke:mah neli poliwtok, a:man a:mo kachi kichi:wah ok, neh a:mo kachi nikita ok pero se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>te:kakilia ke:meh tikihtowa n' teh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts615">
                <ANNOTATION_VALUE>ne: wehka:w n' ke:meh yo:n itech *viernes santo** yo:n kilia:yah tai:xtsakwayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>X'mati ke:yeh yo:n, ihkó:n ki..., ihkó:n kihtowa:yah n' ta:tahmeh, tai:xtsakwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>wa:n a:mo, a:man pané: a:mo a:ki:n, tatsa:la:n ya sah kichi:wah, neh a:mo nikitak ok yo:n kihtowa:yah tai:xtsakwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>Wa:n ne:n, *bueno** ne:n tikihtowa neli tai:xtsakauah n' tio:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts720" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>ka:nika eski tio:pan tiá:s yo:n nohma,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts722" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>i:n ekintsi:n nohma, ompa ne: nika:n xola:lpan no:, no: nohma tai:xtsakwah, tio:pan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>Pero ne:n, tein neh nimitsilia ne: poliwtok a n' tai:xtsakwayah kihtowah wa:n yehwa yo:n neh a:mo nikitak ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts726" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>kalihtik. Kalihtik kihtowah no: tai:xtsakwayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>A:mo n..., tak xa: no: iwki n' ke:meh yo:n teh tikihtowa mitsilihkeh n' ompa ne: ka:ni teh tinemia oksé: xola:l wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts731">
                <ANNOTATION_VALUE>ke:yeh yo:n tai:xtsakwah n' tio:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts733">
                <ANNOTATION_VALUE>xa: yehwa no: ika ne:n nika:n xola:lpan ne:n inkahkalihtik no: tai:xtsakwayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>Pero yo:n a:mo n'mati ke:..., ke:maniá:n yo:n kita:lia:yah yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>tilmah wa:n ke:maniá:n sepa kiki:xtia:yah mah tikihto:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts776" TIME_SLOT_REF2="ts777">
                <ANNOTATION_VALUE>Pos i:n ika timonohno:tstokeh porin tekolo:me:t i:pa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts778" TIME_SLOT_REF2="ts779">
                <ANNOTATION_VALUE>tikihtowah i:pa ihwa:k sah n' tikwih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts781">
                <ANNOTATION_VALUE>tekolo:me:t ke:meh yo:n ye:wa timolwihtoyah, mahyá: sempowalxo:chit, i:pa sayoh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>*todos santos** n' tikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts785">
                <ANNOTATION_VALUE>Mahyá: no: iwki ne:n ke:meh tewi:tso:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts786" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>tewi:tso:t a:mo kikwih nochi xiwit mah tikihto:ka:n chihchikwe:ika, a:mo ta: tewi:tso:t kikwih sayoh ihwa:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>*cuan..., cuando** tikihtowah n' tehwa:n a:ltepe:ilwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>soh sepa xiwit wa:n nika:n i:n San Miguel, a:mo se: kimati n' okseki xola:lmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts793">
                <ANNOTATION_VALUE>pero nika:n i:n San Miguel kikwih n' tewi:tso:t sayoh mah tikihto:ka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts794" TIME_SLOT_REF2="ts795">
                <ANNOTATION_VALUE>yetok sah to:nal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts797">
                <ANNOTATION_VALUE>yo:n a:mo wa:n a:mo, a:mo akin eski ne:n kite:mowa, ta: no: etokeh n' tokni:wa:n tein kite:mowah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts798" TIME_SLOT_REF2="ts799">
                <ANNOTATION_VALUE>wa:n yehwa yo:n tein taeka:ntokeh ika yehwa i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>*mayordomotih** n' tokni:wa:n pos yehwa:n no: kimattokeh ya ke:ní:w yo:n motekpa:nte:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>*Que** mah tikihto:ka:n tehwa:n nika:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts805">
                <ANNOTATION_VALUE>nika:n San Miguel sayoh kita:liah n' tewi:tso:t i:pa pe:wte:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts806" TIME_SLOT_REF2="ts807">
                <ANNOTATION_VALUE>sayoh ihwa:k xiwit, *bueno** a:man,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts809">
                <ANNOTATION_VALUE>a:mo n'mati ne: ke:man, pero a:man se: kita itech</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts810" TIME_SLOT_REF2="ts811">
                <ANNOTATION_VALUE>*santos reyes** porin ompa ihwa:k ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts813">
                <ANNOTATION_VALUE>tikmattokeh *que** ompa se: to:nal sah mopatah ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>*pues este** seki:n taseliah, seki:n taka:watih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts817">
                <ANNOTATION_VALUE>wa:n, *este**, ihwa:k yo:n kipe:waltihte:wah n' a:man mah tikihto:ka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts818" TIME_SLOT_REF2="ts819">
                <ANNOTATION_VALUE>wa:n sepa kita:liah ihwa:k</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts821">
                <ANNOTATION_VALUE>*dos de** febrero, kiliah *candelaria** sepa kita:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts822" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>Wa:n ompa sepa kita:liah ihwa:k a *sábado de gloria** tikihtowa n' teh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts824" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>Wa:n sa:te:pan ke:meh i:n itech,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts827">
