        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>o:me, e:yi tokni:wa:n tein timonohno:tsah i:n, ke:meh i:n timonohno:tstokeh neh nikintapowia,</ANNOTATION_VALUE>
