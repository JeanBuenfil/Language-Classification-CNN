            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts900">
                <ANNOTATION_VALUE>yo:n tine:chnohno:tstok ika ne:n xo:chitsí:n, yo:n tachihchi:wah no: tein</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>wehweimeh, tikihtowah tehwa:n wehwei, *wehweimayordomomeh** sah tein,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts904">
                <ANNOTATION_VALUE>a:mo, a:mo nochi:n. Onkakeh n' tein xa:n..., xa:ntohkonemeh kinilwiah wa:n onkakeh xa:ntohmeh, tein taeka:ntokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>yehwa i:n kintachihchi:wiah ika nochi yo:n xo:chit, tikihtowah tehwa:n yehwa yo:n tewi:tso:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>Yo:n tewi:tso:t kitatekiwtiah neli n' ke:meh tikihtowa n' teh tein wehweixa:ntohmeh tein tayeka:ntokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts910">
                <ANNOTATION_VALUE>A:mo tein tatohtokanih, onkakeh tehwa:n tikihtowah tein tatohtokanih tikihtowah tehwa:n ke:meh yo:n xa:ntohkone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>Yehwa yo:n neh nimitsilia neli, yo:n talna:miki:lis yo:n mochi:wak a:mo tehwa:n tik..., a:mo yekinika yo:n mochi:wak n' talna:miki:lis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>ne:ka to:nal a *cuando** towe:ita:twa:n pe:wkeh i:xpeta:ntiwi:tseh, yehwa:n kinemilihtiwi:tseh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>ke:ní:w n' kichi:waskeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts918">
                <ANNOTATION_VALUE>Entó:s yo:n kwaltsi:n, semi kwaltsi:n yo:n talna:miki:lis *hasta** a:xka:n *todavía** moelna:miktiw ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>Pero kichi:wah yo:n tehwa:n ke:meh name:chilia neh kichi:wah, tikchi:wah tehwa:n tima:se:walmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts922">
                <ANNOTATION_VALUE>A:mo kichi:wah n' wehweikoyo:meh. ¿Timolia n' teh ne: kwesala:n...?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts923" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>Ompa a:mo tachihchi:wakih koyo:meh, ompa tachihchi:wakih toma:se:walikni:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>¿Ke:yeh yo:n toma:se:walikni:wa:n tachihchi:wakih? *Porque** yehwa:n, yehwa:n mah tikihto:ka:n kitohtokatokeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts928">
                <ANNOTATION_VALUE>kitohtokatokeh ok *todavía** ne:n mah tikihto:ka:n ma:se:waltal..., ma:se:waltalna:miki:lis, ma:se:waltanemili:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts930">
                <ANNOTATION_VALUE>Wa:n yehwa semi kwaltsi:n, ke:meh neh nimitsilwia mah nochi iwki nimochi:waka:n nika:n tehwa:n, nika:n toxola:n, nika:n *San Miguel**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>mah mo:sta wi:pta mah mokohkoyo:chi:waka:n ya topi:pilwa:n mah kihto:ka:n pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts933" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>a:mo tikini:xeka:natih ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
