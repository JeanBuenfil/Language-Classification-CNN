        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>ihwa:k a neh notech moka:w wa:n *hasta** axka:n neh a:mo nikelka:wa yo:n talna:miki:lis,</ANNOTATION_VALUE>
