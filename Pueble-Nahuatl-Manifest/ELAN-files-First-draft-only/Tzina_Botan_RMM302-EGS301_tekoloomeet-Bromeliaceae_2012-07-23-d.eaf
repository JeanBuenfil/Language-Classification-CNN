        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>nikelka:wtiw a ke:meh n' a:man neh a:mo okachi niktatekiwtia pero nikilia ne:ka *tiempo** neli [...]</ANNOTATION_VALUE>
