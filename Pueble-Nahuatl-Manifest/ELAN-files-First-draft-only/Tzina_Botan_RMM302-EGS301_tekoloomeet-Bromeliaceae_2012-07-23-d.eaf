        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>towe:ita:twa:n tachihchi:wayah, ne:ka to:nal tachihchi:wayah ika semi yo:n xo:chitsí:n.</ANNOTATION_VALUE>
