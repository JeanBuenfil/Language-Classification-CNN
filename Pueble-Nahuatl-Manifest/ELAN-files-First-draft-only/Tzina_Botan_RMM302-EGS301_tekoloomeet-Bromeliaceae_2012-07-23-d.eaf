        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>wa:n yo:n, pos neli ke:mehtikihtowa *este** panowa sah n' yo:n no: kitatekiwtiah, ke:meh i:n *cuando** mochi:wati *este** n' *viernes santo, semana santa cerca**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>yehwa yo:n ki..., ki..., ta..., tate:mowah, panki:sah n' tokni:wa:n kitekitih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>¿Ke:yeh? *Porque** mah tikihto:ka:n, yo:n se: talna:miki:lis de ne:ka, ne:ka to:nal kika:wte:wkeh n' towe:ita:twa:n, *hasta** a:xka:n i:n a:mo ke:man moelka:wa.</ANNOTATION_VALUE>
