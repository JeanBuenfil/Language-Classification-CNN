        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>toni n' kihto:sneki yo:n ika tachihchi:wah yo:n xo:chitsí:n.</ANNOTATION_VALUE>
