            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts1132" TIME_SLOT_REF2="ts1133">
                <ANNOTATION_VALUE>wa:n *como, como siempre** ke:meh yo:n komo kinyo:le:wkeh mah taseli:ka:n itech *santos reyes** pos kichi:waltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts1134" TIME_SLOT_REF2="ts1135">
                <ANNOTATION_VALUE>Wa:n kichi:waltiah, *este**, a:man se: kinkakilia ne:n tokni:wa:n a:man ma:ski n' tein yo:n ye:wa teh tikihtowa:ya se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts1136" TIME_SLOT_REF2="ts1137">
                <ANNOTATION_VALUE>*santokone:t** we:i ilwit kichi:waltiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts1138" TIME_SLOT_REF2="ts1139">
                <ANNOTATION_VALUE>*Porque** kihtowa:yah ne: ke:man a:mo,</ANNOTATION_VALUE>
