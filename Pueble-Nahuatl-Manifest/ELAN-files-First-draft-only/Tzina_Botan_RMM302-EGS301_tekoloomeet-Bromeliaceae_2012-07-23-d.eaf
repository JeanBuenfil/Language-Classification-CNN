        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>yo:n panowa ya yo:n tikihtowah ne: ne..., netayo:kol mah tikihto:ka:n ina:wak i:n *todiostsi:n**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts753" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>Panowa yo:n tayo:kol, *cuando** yeh kihtowah yo:n sábado s..., kit..., ata kihtowah, kihtowah n' koyo:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
