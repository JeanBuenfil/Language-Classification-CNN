        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts1102" TIME_SLOT_REF2="ts1103">
                <ANNOTATION_VALUE>motekpa:nte:wah entó:s yo:n kihto:sneki ika ma:ski, ma:ski</ANNOTATION_VALUE>
