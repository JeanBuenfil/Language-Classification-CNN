        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>*sábado de gloria**, yo:n *sábado de gloria** kihto:sneki ihwa:k *cuando** yeh</ANNOTATION_VALUE>
