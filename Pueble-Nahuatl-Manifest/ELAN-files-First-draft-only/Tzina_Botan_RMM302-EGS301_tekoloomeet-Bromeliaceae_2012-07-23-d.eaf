        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>A:mo ihkó:n tikitakeh, ke:meh tikihtowa:ya n' teh yo:n ye:wa.</ANNOTATION_VALUE>
