        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts1148" TIME_SLOT_REF2="ts1149">
                <ANNOTATION_VALUE>Wa:n pos nochi iwki ompakawí:n tipanowah, ta: teh mitsilwi:tih xchi:walti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts1150" TIME_SLOT_REF2="ts1151">
                <ANNOTATION_VALUE>kihtowah seki:n pané: yo:n a:mo se: mowelmatis tte:ilwi:s ka:n niweli.</ANNOTATION_VALUE>
