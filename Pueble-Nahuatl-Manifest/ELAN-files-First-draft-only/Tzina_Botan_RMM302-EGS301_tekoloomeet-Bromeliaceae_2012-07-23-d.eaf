        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts1152" TIME_SLOT_REF2="ts1153">
                <ANNOTATION_VALUE>I:pa t'chi:waltia *porque** tikihtowa n' a:..., a:man i:n n'chi:walti:ti, se: xiwit a:mo nehwa a:mo ok, se: xiwit sepa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts1154" TIME_SLOT_REF2="ts1155">
