        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Ka:ketsah.</ANNOTATION_VALUE>
