        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a577" TIME_SLOT_REF1="ts1106" TIME_SLOT_REF2="ts1107">
                <ANNOTATION_VALUE>pero nohma te:wantih, yo:n nohma te:wantih pos neh nimolia ika yo:n,</ANNOTATION_VALUE>
