        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658" TIME_SLOT_REF1="ts1270" TIME_SLOT_REF2="ts1271">
                <ANNOTATION_VALUE>Yehwa:n ne:n, pero kite:mowah, tak ma:ski kikowah ne:wí:n tanikwa:kopa ka:mpa kachi takawa:ni,</ANNOTATION_VALUE>
