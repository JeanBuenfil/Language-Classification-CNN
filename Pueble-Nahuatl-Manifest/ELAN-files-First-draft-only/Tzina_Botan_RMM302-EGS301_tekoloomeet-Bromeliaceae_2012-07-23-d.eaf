        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1087">
                <ANNOTATION_VALUE>momachti:toh, wa:n sayoh sake:ra sepa ne: ihwa:k talwiti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts1088" TIME_SLOT_REF2="ts1089">
                <ANNOTATION_VALUE>wa:ltemowah. Wa:ltemowah, wi:tseh nika:n, mihto:ti:kih n' to:nal n' ke:man</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts1090" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>ke:mah te:wa:ntih wa:n sepa yowi. Entó:s ompa neh yo:n nikita *que**</ANNOTATION_VALUE>
