            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts861">
                <ANNOTATION_VALUE>tsikitsitsi:n kitahta:liliah, sayoh ne:n tein kika:watih wa:n iwki a.</ANNOTATION_VALUE>
