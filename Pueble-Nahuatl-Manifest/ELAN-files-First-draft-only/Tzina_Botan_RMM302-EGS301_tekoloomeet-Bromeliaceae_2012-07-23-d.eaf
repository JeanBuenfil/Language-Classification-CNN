        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts1068" TIME_SLOT_REF2="ts1069">
                <ANNOTATION_VALUE>a:mo semi ma:se:walmeh ok, a:mo ye:ktikeh ma:se:walmeh,</ANNOTATION_VALUE>
