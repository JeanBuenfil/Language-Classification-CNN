            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts765" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>mah t'tapowihtia:ka:n ke:ní:w ne:ka *tiempo** tekitik, ne:ka to:nal tekitikeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>ke:ní:w ne:ka to:nal mowi:kaya n' talna:miki:lis, a:xka:n nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>talna:miki:lis mah tiktohtokaka:n, mah a:mo tikelka:wa:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>Ke:meh i:n tipe:wkeh, i:n sa:nil semi kwaltsi:n, nikwelitak no: neh, tipe:wkeh ika n' tekolo:me:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts773" TIME_SLOT_REF2="ts775">
                <ANNOTATION_VALUE>*hasta** ka:mpa titamikoh ika yo:n, ika yo:n ma:..., ika yo:n sani:ltsí:n tein talna:miki:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts895" TIME_SLOT_REF2="ts896">
