        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts1160" TIME_SLOT_REF2="ts1161">
                <ANNOTATION_VALUE>pos te..., teh t'to:ka:ytia ma:se:waltachihchi:walis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts1162" TIME_SLOT_REF2="ts1163">
