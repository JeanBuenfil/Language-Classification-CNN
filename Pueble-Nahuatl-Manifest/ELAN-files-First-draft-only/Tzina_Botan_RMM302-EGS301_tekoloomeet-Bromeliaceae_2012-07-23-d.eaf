        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>Tein *hora** tankeh ya nochi n' towehka:wkayo:ta:tahwa:n,</ANNOTATION_VALUE>
