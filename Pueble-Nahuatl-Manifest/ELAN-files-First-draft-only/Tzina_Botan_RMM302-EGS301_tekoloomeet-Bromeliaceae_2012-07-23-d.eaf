        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576" TIME_SLOT_REF1="ts1104" TIME_SLOT_REF2="ts1105">
                <ANNOTATION_VALUE>ne:machti:lehkeh m' pi:pil, ma:ski n' toni, ma:ski ko:koyo:meh,</ANNOTATION_VALUE>
