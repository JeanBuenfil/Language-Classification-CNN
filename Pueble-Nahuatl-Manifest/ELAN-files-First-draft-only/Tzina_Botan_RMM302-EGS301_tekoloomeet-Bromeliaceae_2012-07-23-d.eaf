        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts1122" TIME_SLOT_REF2="ts1123">
                <ANNOTATION_VALUE>*Porque** wehka:w a yo:n tikpiah wa:n a:mo,</ANNOTATION_VALUE>
