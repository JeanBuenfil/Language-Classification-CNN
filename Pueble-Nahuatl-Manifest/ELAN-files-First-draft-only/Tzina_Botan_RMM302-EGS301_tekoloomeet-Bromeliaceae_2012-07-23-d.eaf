        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>komo a:mo tikelka:wah n' tehwa:n yo:n talna:miki:lis *todavía** mochi:was ok.</ANNOTATION_VALUE>
