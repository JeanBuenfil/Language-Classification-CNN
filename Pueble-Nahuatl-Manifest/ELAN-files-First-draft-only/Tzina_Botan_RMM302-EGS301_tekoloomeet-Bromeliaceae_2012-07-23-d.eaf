            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts1074" TIME_SLOT_REF2="ts1075">
                <ANNOTATION_VALUE>pos te:chti:tankeh mah timomachti:tih pos timomachtihkeh wa:n nochi wa:n mah tikihto:ka:n pos a:mo tikowtahtekitih ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts1076" TIME_SLOT_REF2="ts1077">
