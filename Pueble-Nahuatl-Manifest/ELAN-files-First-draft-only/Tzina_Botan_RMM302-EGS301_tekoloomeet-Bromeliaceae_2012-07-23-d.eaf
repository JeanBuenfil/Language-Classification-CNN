        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts1126" TIME_SLOT_REF2="ts1127">
                <ANNOTATION_VALUE>*o** a:mo tak tehwa:n a:mo tika:wah mah poliwi.</ANNOTATION_VALUE>
