        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>Wa:n ompa sepa tachihchi:wakih itech, itech *combate**,</ANNOTATION_VALUE>
