        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578" TIME_SLOT_REF1="ts1108" TIME_SLOT_REF2="ts1109">
                <ANNOTATION_VALUE>a:mo poliwis, ihkó:n ke:meh yo:n ko:koyo:tamatih ya wa:n wi:tseh,</ANNOTATION_VALUE>
