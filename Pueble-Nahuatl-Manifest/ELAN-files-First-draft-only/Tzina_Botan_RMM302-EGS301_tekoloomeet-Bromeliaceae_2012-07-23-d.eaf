        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts1142" TIME_SLOT_REF2="ts1143">
                <ANNOTATION_VALUE>kihtowa:yah i..., iwki sah, ke:mehwelitsi:n sah.</ANNOTATION_VALUE>
