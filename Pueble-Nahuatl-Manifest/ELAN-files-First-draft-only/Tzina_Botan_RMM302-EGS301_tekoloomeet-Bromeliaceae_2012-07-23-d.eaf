        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts757" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>monema:ki:xtih wa:n tamik nochi yo:n tayo:kol tikihtowah tehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>*Cuando** yeh yo:..., yeh ki..., yeh yahki, miak mokaya:wkeh kihtowah kimiktihkeh wa:n kipachohkeh, pero a:mo neli, ta: yeh yahki n' ka:mpa yahki.</ANNOTATION_VALUE>
