        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>ke:meh tote:ma:ki:xtihka:tsi:n ne:ka to:nal ika ma:wiltihkeh,</ANNOTATION_VALUE>
