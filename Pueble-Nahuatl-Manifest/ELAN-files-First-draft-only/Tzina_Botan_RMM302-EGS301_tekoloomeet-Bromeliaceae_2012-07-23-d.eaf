        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>Yetok n' ka:mpa yetok, yehwa yo:n talna:miki:lis ki..., kipiah, neh ne:chtapowihka yehwa nimitsilia yo:n se: tokni:tsi:n tein,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts764">
