        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts1128" TIME_SLOT_REF2="ts1129">
                <ANNOTATION_VALUE>*Porque** no: iwki neh nimitsilia miakeh n' ompa ne:n xola:lpankah mah tkihto:ka:n, pos tein ko:koyo:tamatih ya mah tkihto:ka:n,</ANNOTATION_VALUE>
