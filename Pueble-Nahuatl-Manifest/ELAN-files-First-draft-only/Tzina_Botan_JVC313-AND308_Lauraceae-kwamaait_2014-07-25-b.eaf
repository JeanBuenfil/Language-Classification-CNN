                <ANNOTATION_VALUE>No: kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>No: pitsa:wak.</ANNOTATION_VALUE>
