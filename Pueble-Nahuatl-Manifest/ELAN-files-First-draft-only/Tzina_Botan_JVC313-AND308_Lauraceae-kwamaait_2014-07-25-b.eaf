        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>Iteyo ye:kkwaltsi:n, ke:masá: ne:n pos yehwa yo:n ki..., [ki]tila:nakih n' chiktehmeh wa:n kwi:kah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Pero pos yehwa ne: xa:, xa: kachi tikmattos, ne: kwali tine:chilwi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Ista:k.</ANNOTATION_VALUE>
