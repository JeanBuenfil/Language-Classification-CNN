                <ANNOTATION_VALUE>Yo:n a:mo *porque** ma:pisi:ltik, ma:pi:pitsakweyak sah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>Ke:mah. Pos yehwa sah yo:n ke nimitstahtania, tiki:xmattok wa:n no: tiki:xmati ke:meh niki:xmati, neli ke:meh nika:wí: sentekititi[nemih], tikitstinemih komeh ne: kowtahpa, pos tiki:xmattokeh</ANNOTATION_VALUE>
