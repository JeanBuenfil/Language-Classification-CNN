    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="Anastacio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>A:, no: tikneki tikmatis de nika:n timona:mikeh itech i:n kowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>pos no: kwalia: ke tine:chtahtania para no: teh, no: t'neki tikneki tikmatis wa:n no: tine:chtahtania ox niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Pos yo:n petaka:lkoma:it pos no: niki:xmattok *porque** ke:masá: ne:n ihkó:n kwaltsi:n no: mochi:wa, no: wehkapantai tepitsi:n wa:n semi kikwah chiktehmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>wa:n ima:tampa, ike:span, pané: achi yo:n ta:tahmach mochi:wa, nejó:n chi:chi:ltik n' i..., ike:span, yo:n tak ke:meskia moloxtik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>wa:n pos nejó:n no: kwaltia para teisá: kalkowit, ihkó:n no: kikwih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>wa:n pos no: *cuando** xo:chiowa ne:n kwaltsi:nno: panki:sa wa:n i..., iteyo xoxoktik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>wa:n mopilowa ke:meskia yo:n ... No: chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Sepa de yoksi a ne:n itsi:ntan ne:n mopihpilowa wa:n ke:mah seki ne:n de kikwah chiktehmeh kipanxi:niah, te:nkohkopi:ni ke:meh yo:n xi:ni itsi:ntayo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>wa:n ompa te:nkopi:ni ompa moka:waya itsi:ntayo, entó:s moka:wa, ompa moka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>Ompa moka:waya, wetsi a ne:n tet *o** kikwah, kitila:na:kih ne:n chiktehmeh, te:na:nka:lmeh *o** chechelo:meh no: kikwah *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>teisá: ihkó:n kwitatohtokmeh, miak. Yo:n wilikiso:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>ompa mopi:pilowah wa:n kipanxi:niah pos wehwetsi a, moka:wa sayoh ne:n, ne:n ko..., ke:meskia ne: ka:mpa te:mpilkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>Yo:n chi:chi:ltik, ke:meskia kostik ne:n mo..., ka:mpa te:naktok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Wa:n de xoxoktik pos ne: takwa:wak pero sepa de yoksik pos ki..., wetsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>Yo:n niki:xmattok no: wa:n ima:yo kwaltsi:n no:, no: ma:wehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Ma:wehwei wa:n pos yo:n no:, okseki kiliah no: kwama:it, okseki kiliah koma:it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Wa:n i:n sentaman pos petaka:lkoma:it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Ne: koma:it, no:, no: *igual**, no: i:n s..., i:n petaka:lkoma:it kachi, kachi pané: ista:k</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>Wa:n oksé: de n' koma:it, yo:n achi kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>Yo:n achi kostik no: pero yo:n no: taman ne:n i..., ikowyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>wa:n i:n okseki no: taman, ke:meskia ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Ke:mah, ikowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Ma:wehwei ikowyo wa:n ma:we:weyak, yo:n no: kwaltia para ne:si kowtati:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>Kowtati:l oso se: ki..., kikwih, ke:masá: kihtowa[h]no: kikwi..., [ki]tsaya:nah para n' teisá: ihkó:n ki..., kikwih para se: tatsi:ntsakwa, no:, no: kwa..., no: kwaltia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Wa:n *más** de se: kitahtapa:na, kwaltsi:n tapa:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Mehmela:wak, sayoh ne:n ista:k taihtik, ne: wa:n okseki de se: kitahtapa:na nochi kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>Kostik ne:n koma:it, kostik</ANNOTATION_VALUE>
