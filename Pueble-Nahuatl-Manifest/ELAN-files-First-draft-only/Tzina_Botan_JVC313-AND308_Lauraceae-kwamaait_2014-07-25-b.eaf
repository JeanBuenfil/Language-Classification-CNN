        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Wa:n yo:n ke:ní:w kichi:wayah ki:xkwa:ta:lilia:yah ne:n kaltsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>De n' kwama:it sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Pos neh no: nikitani *cuando** chika:waya ne:n ikowyo kostik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>entó:s ne: panxi:ni ne:n ... wa:n moka:wa n' ahko n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>Moka:wa sayoh kowtako:t n' ahko pero kipia ne:n iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>N' iteyo kipia wa:n *después** sepa, sepa de yankwik itsmoli:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>Yo:n de yankwik itsmolo:ni wa:n sepa ne:n momahma:yo:tia ya. Momahma:yo:tia ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>nejó:n ... yehwa nejó:n ki..., moma:yo:tia, ke:mah ihkó:n sepa moka:wa, nochi ima:yo ahalaxtik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts261">
