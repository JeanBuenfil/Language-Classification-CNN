        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>*porque** yo:n kwaltsi:n moma:..., [moma:]sohsowa tak no:.</ANNOTATION_VALUE>
