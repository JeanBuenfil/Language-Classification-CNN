        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Tikihtowa ke se: tsonxi:ni, nochi senxi:ni se: itson os..., *o** ka:n o:me e:yi tsonti sah, a:mo se: kwa:xipetstia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>Yehwa yo:n tikihtowa ke komo se: momowtih a:te:nte:noh, ompa yowi tapahtihkeh wa:n ompa te:no:tsati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>Ta:ka:n we..., telwehka nimomowti:ti, mah tikihto:ka:n ne: es..., neh nika:n ninemi Cuesala:n oso, oso ne: xola:lpan ka:mpa teh tiwa:le:wa wa:n nimomowti:to ne:kwí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>wehka, wehka, se: we:ia:t ka:mpa a:..., a:xa: atox nika:n achka yetok, mah tikihto:ka:n yetok ne:wí:n s..., mah se:, moneki mah se: ohtoka sikie:ra e:yi to:nal, na:wi to:nal, moneki ya:s tapahtihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>A:mo teh tikelna:miki ok, yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
