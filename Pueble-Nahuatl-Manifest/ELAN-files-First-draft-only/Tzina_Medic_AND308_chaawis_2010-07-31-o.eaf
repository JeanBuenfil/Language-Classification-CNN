        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>I:pa yehwa sah yo:n tein tehwa:tsi:n tikmattok, a:mo tikelna:ki oksentaman xiwtsitsi:n oso ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
