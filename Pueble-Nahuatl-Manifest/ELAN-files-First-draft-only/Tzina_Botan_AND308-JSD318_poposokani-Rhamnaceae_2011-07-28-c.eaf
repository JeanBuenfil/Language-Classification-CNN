        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>wa:n ka:n timokaya:wa de n' komekat tein ista:k tikihtowa,</ANNOTATION_VALUE>
