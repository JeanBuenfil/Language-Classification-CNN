        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>No: kikwiah n' komekat, ompa kite:kayah wa:n ke:masá: pos</ANNOTATION_VALUE>
