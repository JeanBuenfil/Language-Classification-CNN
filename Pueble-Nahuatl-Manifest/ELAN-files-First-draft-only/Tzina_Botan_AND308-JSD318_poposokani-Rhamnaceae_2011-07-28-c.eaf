        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Pero ekintsi:n miak taman kichihchi:wah, seki tikiliah yo:n</ANNOTATION_VALUE>
