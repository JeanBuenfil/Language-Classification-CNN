        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a684" TIME_SLOT_REF1="ts1291" TIME_SLOT_REF2="ts1292">
                <ANNOTATION_VALUE>n' a:mo tikihto:s tiktila:nati wa:n koto:ni:s, a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a685" TIME_SLOT_REF1="ts1293" TIME_SLOT_REF2="ts1294">
                <ANNOTATION_VALUE>A:mo koto:ni *porque** yo:n semi chika:wak ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a686" TIME_SLOT_REF1="ts1295" TIME_SLOT_REF2="ts1296">
                <ANNOTATION_VALUE>Teihsá: xiwit ihkó:n tiktila:nas ka:mpa ilpitok iwa:n wi:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a687" TIME_SLOT_REF1="ts1297" TIME_SLOT_REF2="ts1298">
                <ANNOTATION_VALUE>Iwa:n wi:tsa *hasta** se: kikoto:na ihkó:n, *porque** ke:yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a688" TIME_SLOT_REF1="ts1299" TIME_SLOT_REF2="ts1300">
                <ANNOTATION_VALUE>chika:wak ki..., kilpia. Kilpia yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689" TIME_SLOT_REF1="ts1301" TIME_SLOT_REF2="ts1302">
