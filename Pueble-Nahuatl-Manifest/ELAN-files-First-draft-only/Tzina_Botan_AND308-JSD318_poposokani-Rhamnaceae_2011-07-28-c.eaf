        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a579" TIME_SLOT_REF1="ts1078" TIME_SLOT_REF2="ts1079">
                <ANNOTATION_VALUE>Kipia se: kwamekatsí:n ka:mpa mopilowa ke:namih witskilit,</ANNOTATION_VALUE>
