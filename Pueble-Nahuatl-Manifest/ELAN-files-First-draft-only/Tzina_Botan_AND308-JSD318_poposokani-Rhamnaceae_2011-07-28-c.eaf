        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts1002" TIME_SLOT_REF2="ts1003">
                <ANNOTATION_VALUE>Wa:n yehwa ya niki:xmati n' chili:yoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543" TIME_SLOT_REF1="ts1004" TIME_SLOT_REF2="ts1006">
