        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a888" TIME_SLOT_REF1="ts1711" TIME_SLOT_REF2="ts1712">
                <ANNOTATION_VALUE>wa:n i:n talna:miki:lis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a889" TIME_SLOT_REF1="ts1713" TIME_SLOT_REF2="ts1714">
                <ANNOTATION_VALUE>ihkó:n ohtokas.</ANNOTATION_VALUE>
