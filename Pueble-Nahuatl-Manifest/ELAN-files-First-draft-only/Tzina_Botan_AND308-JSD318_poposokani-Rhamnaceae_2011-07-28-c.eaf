        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683" TIME_SLOT_REF1="ts1289" TIME_SLOT_REF2="ts1290">
                <ANNOTATION_VALUE>yo:n ka:mpa ne: kwaltsi:n kitetekwinohtiw,</ANNOTATION_VALUE>
