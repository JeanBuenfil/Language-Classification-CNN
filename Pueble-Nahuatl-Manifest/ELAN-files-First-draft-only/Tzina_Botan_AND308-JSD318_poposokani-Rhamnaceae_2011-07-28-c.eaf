        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>*Porque** a:mo teh onkaya yo:n, yo:n,</ANNOTATION_VALUE>
