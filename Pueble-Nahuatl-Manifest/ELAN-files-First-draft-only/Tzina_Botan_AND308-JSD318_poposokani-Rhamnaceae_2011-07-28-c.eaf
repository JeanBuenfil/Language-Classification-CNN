        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a786" TIME_SLOT_REF1="ts1500" TIME_SLOT_REF2="ts1501">
                <ANNOTATION_VALUE>ke:masá: itech tepe:t oso itech kwowit ne:wí:n se: kita wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a787" TIME_SLOT_REF1="ts1502" TIME_SLOT_REF2="ts1503">
                <ANNOTATION_VALUE>a:mo tei a:tsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a788" TIME_SLOT_REF1="ts1504" TIME_SLOT_REF2="ts1505">
                <ANNOTATION_VALUE>semi se: kele:wia n' a:tsí:n, *hasta** wa:ki se: i..., se: iyo:lpan, se: ichihchi, a:mo se: kipia ok se: ichihchi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a789" TIME_SLOT_REF1="ts1506" TIME_SLOT_REF2="ts1507">
                <ANNOTATION_VALUE>wa:n a:..., a:mo tei a:tsí:n se: kite:mowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a790" TIME_SLOT_REF1="ts1508" TIME_SLOT_REF2="ts1509">
                <ANNOTATION_VALUE>entó:s niman se: kihtowa nika:n yetok i:n texokomekat, niktekiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a791" TIME_SLOT_REF1="ts1510" TIME_SLOT_REF2="ts1511">
                <ANNOTATION_VALUE>Se: kiteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792" TIME_SLOT_REF1="ts1512" TIME_SLOT_REF2="ts1513">
                <ANNOTATION_VALUE>wa:n ke:mah se: kichichi:na, ihkó:n panchachalaka n' a:tsí:n, se: kichichi:na ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a793" TIME_SLOT_REF1="ts1514" TIME_SLOT_REF2="ts1515">
                <ANNOTATION_VALUE>Wa:n okseki de n' ke:masá: se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794" TIME_SLOT_REF1="ts1516" TIME_SLOT_REF2="ts1517">
                <ANNOTATION_VALUE>se: kita n' okseki, yo:n chi:chi:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a795" TIME_SLOT_REF1="ts1518" TIME_SLOT_REF2="ts1519">
                <ANNOTATION_VALUE>ka:nsá: ika mowi:wila:ntok, pero a:mo nochipa se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796" TIME_SLOT_REF1="ts1520" TIME_SLOT_REF2="ts1521">
                <ANNOTATION_VALUE>Yo:n, yo:ni, yo:n a:mo kipia a:tsí:n, yo:n wa:kkatik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797" TIME_SLOT_REF1="ts1522" TIME_SLOT_REF2="ts1523">
                <ANNOTATION_VALUE>Wa:kkatik wa:n achi ti:ltik ke:meh tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798" TIME_SLOT_REF1="ts1524" TIME_SLOT_REF2="ts1525">
                <ANNOTATION_VALUE>ti:ltik ihkó:n mowi:wila:na pero yo:n x..., tik..., xiktsonteki yo:n a:mo teh kipia a:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a799" TIME_SLOT_REF1="ts1526" TIME_SLOT_REF2="ts1527">
                <ANNOTATION_VALUE>Nijó:n ti:ltik a:mo kipia a:tsí:n, pero n' okseki texokomekat yo:n ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a800" TIME_SLOT_REF1="ts1528" TIME_SLOT_REF2="ts1529">
                <ANNOTATION_VALUE>Yo:n komo se: kits..., ktsontek, yo:n kipia n' a:tsí:n *hasta** se: ixwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801" TIME_SLOT_REF1="ts1530" TIME_SLOT_REF2="ts1531">
                <ANNOTATION_VALUE>Se: ixwi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a802" TIME_SLOT_REF1="ts1532" TIME_SLOT_REF2="ts1533">
                <ANNOTATION_VALUE>ke:masá: se: kitektiw ihkó:n e:yi ta..., e:yi ta..., ta..., tateki:l ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a803" TIME_SLOT_REF1="ts1534" TIME_SLOT_REF2="ts1535">
                <ANNOTATION_VALUE>ihkwi:ni de we:weyaktsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a804" TIME_SLOT_REF1="ts1536" TIME_SLOT_REF2="ts1537">
                <ANNOTATION_VALUE>tsikitsitsi:n se: kitehteki wa:n se: kikohkoto:ntiw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a805" TIME_SLOT_REF1="ts1538" TIME_SLOT_REF2="ts1539">
                <ANNOTATION_VALUE>oso ke:masá: ihkó:n wila:ntok ihkó:n ike:span kowit oso ke:meh ihkó:n itech tepe:t wi:wila:ntok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a806" TIME_SLOT_REF1="ts1540" TIME_SLOT_REF2="ts1541">
                <ANNOTATION_VALUE>*o** ka:nsá: se: tekititok ihkó:n itech yo:n teswakowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a807" TIME_SLOT_REF1="ts1542" TIME_SLOT_REF2="ts1543">
                <ANNOTATION_VALUE>*o** xi:kalkowit ike:span ka:nsá: ika yetok *o** hko:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808" TIME_SLOT_REF1="ts1544" TIME_SLOT_REF2="ts1545">
                <ANNOTATION_VALUE>se: kitso:nteki wa:n ye:k miak ki:sa n' a:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a809" TIME_SLOT_REF1="ts1546" TIME_SLOT_REF2="ts1547">
                <ANNOTATION_VALUE>Entó:s ompa se: tai a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a810" TIME_SLOT_REF1="ts1548" TIME_SLOT_REF2="ts1549">
                <ANNOTATION_VALUE>Ma:sá: timoahsih ne:wí:n ke:meh i:n tiowih kowtah, pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811" TIME_SLOT_REF1="ts1550" TIME_SLOT_REF2="ts1551">
                <ANNOTATION_VALUE>a:mo teh a:tsí:n. Niman kihto:s se:, a:mo teh a:tsí:n, tikte:mo:tih. Kihtowah, pos nika:n yetok texokomekat, tik..., tiktsontekitih wa:n tit...., titai:tih, i:n tikmattokeh kipia a:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812" TIME_SLOT_REF1="ts1552" TIME_SLOT_REF2="ts1553">
                <ANNOTATION_VALUE>Entó:s tiktekih wa:n titaih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813" TIME_SLOT_REF1="ts1554" TIME_SLOT_REF2="ts1555">
                <ANNOTATION_VALUE>Tita:ih nijó:n a:tsí:n, pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814" TIME_SLOT_REF1="ts1556" TIME_SLOT_REF2="ts1557">
                <ANNOTATION_VALUE>pos no:, no: kwali para se:, neh nikmattok *cuando** yo:n poposoka *de tanto** ki..., n' a:tsí:n tsikilitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a815" TIME_SLOT_REF1="ts1558" TIME_SLOT_REF2="ts1559">
                <ANNOTATION_VALUE>yo:n kwali nijó:n kone:meh te:iliah n' ta:tahmeh kita:liah nika:n se: ixi:kko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a816" TIME_SLOT_REF1="ts1560" TIME_SLOT_REF2="ts1561">
                <ANNOTATION_VALUE>Yo:n *cuando** se: mose:wihtok, de n' tayowa se: kone:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a817" TIME_SLOT_REF1="ts1562" TIME_SLOT_REF2="ts1563">
                <ANNOTATION_VALUE>pos ki..., ki..., yo:n te:..., te:..., se: mo..., nikihto:s se: mo..., mox..., moxi:xa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a818" TIME_SLOT_REF1="ts1564" TIME_SLOT_REF2="ts1565">
                <ANNOTATION_VALUE>Entó:s yo:n se:, se: kino:wia ihkó:n, yehwa yo:n ne:n no:, no: kwali,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819" TIME_SLOT_REF1="ts1566" TIME_SLOT_REF2="ts1567">
                <ANNOTATION_VALUE>se: ixi:kko te:ta:liliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820" TIME_SLOT_REF1="ts1568" TIME_SLOT_REF2="ts1569">
                <ANNOTATION_VALUE>Yehwa yo:n neh nikmattok, pero n' okseki ne: ke:meh ekintsi:n tine:chilihtok semi mah se: tai para n' oksé: taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a821" TIME_SLOT_REF1="ts1570" TIME_SLOT_REF2="ts1571">
                <ANNOTATION_VALUE>a:mo nikmati. *De veras** nika:n tehwa:n nochi ne:n ti..., timolihtokeh ekintsi:n kwaltsi:n *de que**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a822" TIME_SLOT_REF1="ts1572" TIME_SLOT_REF2="ts1573">
                <ANNOTATION_VALUE>nijí:n tikpia nijó:n nochi kintsi:n talna:miki:lis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a823" TIME_SLOT_REF1="ts1574" TIME_SLOT_REF2="ts1575">
                <ANNOTATION_VALUE>ke:meh tehwa:tsi:n, *igual** neh, nochi tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a824" TIME_SLOT_REF1="ts1576" TIME_SLOT_REF2="ts1577">
                <ANNOTATION_VALUE>tiknemilihtokeh ki:ní:w wa:n tikmattokeh ki:ní:w m' para ti..., timonohno:tsaskeh pos nochi timomakatokeh *cuenta** kí:ní:w n' tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a825" TIME_SLOT_REF1="ts1578" TIME_SLOT_REF2="ts1579">
                <ANNOTATION_VALUE>ki:ní:w ti..., ki:ní:w n' ti:xpanowah wa:n ki:ní:w n' tikitah ne: kwowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a826" TIME_SLOT_REF1="ts1580" TIME_SLOT_REF2="ts1582">
                <ANNOTATION_VALUE>ki:ní:w n' ton, ton te:ch..., [...]katí:nde n' te:chpale:wia, katí:n ika timoyo:litia *cuando** a:mo teh a:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a852" TIME_SLOT_REF1="ts1634" TIME_SLOT_REF2="ts1635">
                <ANNOTATION_VALUE>Pos yehwa yo:n se: mo..., mokaka *de que** ke:ní:w para se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a853" TIME_SLOT_REF1="ts1636" TIME_SLOT_REF2="ts1637">
                <ANNOTATION_VALUE>nemis, para se: mopale:wi:s, yo:n, ke:meh ekintsi:n timolwihtokeh miak taman te:chpale:wia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a854" TIME_SLOT_REF1="ts1638" TIME_SLOT_REF2="ts1639">
                <ANNOTATION_VALUE>Nijó:n *matita**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a855" TIME_SLOT_REF1="ts1640" TIME_SLOT_REF2="ts1641">
                <ANNOTATION_VALUE>pos yeh *we:imata** mochi:wa wa:n tohtoma:wak wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a856" TIME_SLOT_REF1="ts1642" TIME_SLOT_REF2="ts1643">
                <ANNOTATION_VALUE>pos a:mo nochi tikmatih katí:n te:chpale:wi:s, katí:n te:ch..., te:chyo:liti:s, te:chyo:liti:s wa:n katí:n de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a857" TIME_SLOT_REF1="ts1644" TIME_SLOT_REF2="ts1645">
                <ANNOTATION_VALUE>ika timopale:wi:skeh *cuando** timiktoskeh itech se: a:mik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a858" TIME_SLOT_REF1="ts1646" TIME_SLOT_REF2="ts1647">
                <ANNOTATION_VALUE>Entó:s semi kwali nijó:n, ekintsi:n nochi tikmattkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a859" TIME_SLOT_REF1="ts1648" TIME_SLOT_REF2="ts1650">
                <ANNOTATION_VALUE>wa:n neh pos yehwa sah de n...., de nehwa nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a874" TIME_SLOT_REF1="ts1680" TIME_SLOT_REF2="ts1683">
                <ANNOTATION_VALUE>*Entre** tio:me:n ta:taman tikpiah to..., toto:ka:y, talna:miki:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a885" TIME_SLOT_REF1="ts1704" TIME_SLOT_REF2="ts1707">
                <ANNOTATION_VALUE>Eski...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a893" TIME_SLOT_REF1="ts1722" TIME_SLOT_REF2="ts1725">
                <ANNOTATION_VALUE>Te:ch..., te:chilihkeh ihko:ni sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a895" TIME_SLOT_REF1="ts1727" TIME_SLOT_REF2="ts1730">
                <ANNOTATION_VALUE>Pos yehwa sah de yo:n poposokani, miak taman te:chpale:wia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a897" TIME_SLOT_REF1="ts1732" TIME_SLOT_REF2="ts1733">
                <ANNOTATION_VALUE>Nijó:n o:me komekatsí:n, yehwa ne:n texokomekat wa:n yehwa ya m' poposokani,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a898" TIME_SLOT_REF1="ts1734" TIME_SLOT_REF2="ts1735">
                <ANNOTATION_VALUE>pos nochi te:chpale:wia. Nochi yehwa yo:n kintsi:n ne:h,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a899" TIME_SLOT_REF1="ts1736" TIME_SLOT_REF2="ts1738">
                <ANNOTATION_VALUE>pané: yehwa sah. Kintsi:n no: kwali tine:chili:s ki:ní:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a900" TIME_SLOT_REF1="ts1739" TIME_SLOT_REF2="ts1742">
                <ANNOTATION_VALUE>moto:ka:y,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a902" TIME_SLOT_REF1="ts1744" TIME_SLOT_REF2="ts1746">
                <ANNOTATION_VALUE>ki:ní:n moto:ka:y wa:n ka: tiwa:le:w wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a904" TIME_SLOT_REF1="ts1748" TIME_SLOT_REF2="ts1751">
                <ANNOTATION_VALUE>tine:chili:s ki:ní:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a908" TIME_SLOT_REF1="ts1758" TIME_SLOT_REF2="ts1760">
                <ANNOTATION_VALUE>Neh nimono:tsa Anastacio Nicolás Damián wa:n nika:n xola:lpan San Miguel Tzinacapan ompa niwa:le:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
