        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>tein ihkó:n tikihi:xtapalta:lili:skiah para ika mochika:was wa:n mochi:wak.</ANNOTATION_VALUE>
