            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677" TIME_SLOT_REF1="ts1277" TIME_SLOT_REF2="ts1278">
                <ANNOTATION_VALUE>Nijó:n witskilit,</ANNOTATION_VALUE>
