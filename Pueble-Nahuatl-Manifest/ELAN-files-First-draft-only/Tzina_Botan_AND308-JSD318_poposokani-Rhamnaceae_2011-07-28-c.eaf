        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681" TIME_SLOT_REF1="ts1285" TIME_SLOT_REF2="ts1286">
                <ANNOTATION_VALUE>Xa: ke:meh e:yi,</ANNOTATION_VALUE>
