        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a680" TIME_SLOT_REF1="ts1283" TIME_SLOT_REF2="ts1284">
                <ANNOTATION_VALUE>N' ima:wa:n ka:mpa ne: kiki:tskihtiw.</ANNOTATION_VALUE>
