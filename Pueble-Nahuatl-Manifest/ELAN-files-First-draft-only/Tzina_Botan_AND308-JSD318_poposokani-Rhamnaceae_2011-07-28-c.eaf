        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>wa:n *cuando** tikpaxi:xihxi:mas moka:was n' ikowyo pochiktsí:n.</ANNOTATION_VALUE>
