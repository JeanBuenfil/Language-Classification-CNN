        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a890" TIME_SLOT_REF1="ts1715" TIME_SLOT_REF2="ts1716">
                <ANNOTATION_VALUE>Wa:n tein to:nal yehwa:n nemiskeh,</ANNOTATION_VALUE>
