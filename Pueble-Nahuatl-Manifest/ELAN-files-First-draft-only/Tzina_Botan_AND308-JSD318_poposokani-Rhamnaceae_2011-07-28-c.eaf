            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts1082" TIME_SLOT_REF2="ts1083">
                <ANNOTATION_VALUE>*Porque** witskilit no: kipia yo:n se: i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts1084" TIME_SLOT_REF2="ts1085">
                <ANNOTATION_VALUE>iisti wa:n ka:mpa mopilowa kitetekwinowa n' ii:kni:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a583" TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1087">
                <ANNOTATION_VALUE>wa:n yehwa ya n' ika mochika:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584" TIME_SLOT_REF1="ts1088" TIME_SLOT_REF2="ts1089">
                <ANNOTATION_VALUE>para panki:sa. Poposokani, no: iwki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585" TIME_SLOT_REF1="ts1090" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>no: kipia se: iisti ihkó:n wa:n yehwa n' kiki:tskia wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts1092" TIME_SLOT_REF2="ts1093">
                <ANNOTATION_VALUE>ika kitetekwinowa wa:n ompa mopilowa para panki:sa n' tein moskaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587" TIME_SLOT_REF1="ts1094" TIME_SLOT_REF2="ts1095">
                <ANNOTATION_VALUE>Ne:paka ohtoka sepa kiki:tskia oksé:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588" TIME_SLOT_REF1="ts1096" TIME_SLOT_REF2="ts1097">
                <ANNOTATION_VALUE>wa:n *por eso** moka:waki kwaltsi:n melaktsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589" TIME_SLOT_REF1="ts1098" TIME_SLOT_REF2="ts1099">
                <ANNOTATION_VALUE>wa:n yehwa yo:n *servi:rowa para** teihsá: ma:chi:walis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts1100" TIME_SLOT_REF2="ts1101">
                <ANNOTATION_VALUE>N' kwamekat miak taman onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591" TIME_SLOT_REF1="ts1102" TIME_SLOT_REF2="ts1103">
                <ANNOTATION_VALUE>pero yetok ke:ní:w mopale:wia no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592" TIME_SLOT_REF1="ts1104" TIME_SLOT_REF2="ts1105">
                <ANNOTATION_VALUE>ke:ní:w mochika:wa para ohtoka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts1106" TIME_SLOT_REF2="ts1107">
                <ANNOTATION_VALUE>*porque** yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts1108" TIME_SLOT_REF2="ts1109">
                <ANNOTATION_VALUE>*solamente** ika yehwa yo:ni, ima:nalwayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595" TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1111">
                <ANNOTATION_VALUE>ika mopilowa wa:n kitetekwinowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts1112" TIME_SLOT_REF2="ts1113">
                <ANNOTATION_VALUE>*Porque cada** se:m..., se:meh de nochi i:n tein ta:ltikpak onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts1114" TIME_SLOT_REF2="ts1115">
                <ANNOTATION_VALUE>yetok tonika mopale:wia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts1116" TIME_SLOT_REF2="ts1117">
                <ANNOTATION_VALUE>Ke:mih witskilit mokechahokwi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599" TIME_SLOT_REF1="ts1118" TIME_SLOT_REF2="ts1119">
                <ANNOTATION_VALUE>kiki:tskia se: i..., se: kahfe:nkwowtako:t oso teihsá:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts1120" TIME_SLOT_REF2="ts1121">
                <ANNOTATION_VALUE>ompa mopilowa wa:n yowi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601" TIME_SLOT_REF1="ts1122" TIME_SLOT_REF2="ts1123">
                <ANNOTATION_VALUE>Ne:paka sepa kilpia oksé:, ahko kilpia oksé:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts1124" TIME_SLOT_REF2="ts1125">
                <ANNOTATION_VALUE>ka:mpa kimachilia, *o sea** ka:mpa kimati a *que** yeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts1126" TIME_SLOT_REF2="ts1127">
                <ANNOTATION_VALUE>kwali kine:xtili:..., te:chne:xtili:s a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604" TIME_SLOT_REF1="ts1128" TIME_SLOT_REF2="ts1129">
                <ANNOTATION_VALUE>toni n' ta:kilo:t kite:makas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts1130" TIME_SLOT_REF2="ts1131">
                <ANNOTATION_VALUE>mota:lilia ya n' ixo:chiotsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a606" TIME_SLOT_REF1="ts1132" TIME_SLOT_REF2="ts1133">
                <ANNOTATION_VALUE>mometstia wa:n xo:chiowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts1134" TIME_SLOT_REF2="ts1135">
                <ANNOTATION_VALUE>wa:n mota:lilia ya n' iwitsyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a608" TIME_SLOT_REF1="ts1136" TIME_SLOT_REF2="ts1137">
                <ANNOTATION_VALUE>Pos *lo mismo** m' poposokanimekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609" TIME_SLOT_REF1="ts1138" TIME_SLOT_REF2="ts1139">
                <ANNOTATION_VALUE>yeh mopilohtiw wa:n yowi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610" TIME_SLOT_REF1="ts1140" TIME_SLOT_REF2="ts1141">
                <ANNOTATION_VALUE>*hasta** ka:mpa tami n' kwowit n' tein itech mopilohtiw</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts1142" TIME_SLOT_REF2="ts1143">
                <ANNOTATION_VALUE>wa:n ompa ke:mah ompa moso:sowa ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612" TIME_SLOT_REF1="ts1144" TIME_SLOT_REF2="ts1145">
                <ANNOTATION_VALUE>wa:n a:mo kanah wel yowi ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a613" TIME_SLOT_REF1="ts1146" TIME_SLOT_REF2="ts1147">
                <ANNOTATION_VALUE>*o** a:chá: ke:mah weli mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a614" TIME_SLOT_REF1="ts1148" TIME_SLOT_REF2="ts1149">
                <ANNOTATION_VALUE>momaxalo:s sepa wa:n ya:s ne:paka ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts1150" TIME_SLOT_REF2="ts1151">
                <ANNOTATION_VALUE>pero a:mo iw..., a:mo iwki ok ke:namih ka:mpa e:wte:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a616" TIME_SLOT_REF1="ts1152" TIME_SLOT_REF2="ts1153">
                <ANNOTATION_VALUE>Ka:mpa e:wte:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617" TIME_SLOT_REF1="ts1154" TIME_SLOT_REF2="ts1155">
                <ANNOTATION_VALUE>itech se: sah n' ka:mpa imamá:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a618" TIME_SLOT_REF1="ts1156" TIME_SLOT_REF2="ts1157">
                <ANNOTATION_VALUE>Imamá:n yeh se: kwamekat toma:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a619" TIME_SLOT_REF1="ts1158" TIME_SLOT_REF2="ts1159">
                <ANNOTATION_VALUE>wa:n ompa n' ixwas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a620" TIME_SLOT_REF1="ts1160" TIME_SLOT_REF2="ts1161">
                <ANNOTATION_VALUE>Wa:n para ki..., panki:stias wa:n no: kitohtokas ka:mpa ika yahki n' imomá:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a621" TIME_SLOT_REF1="ts1162" TIME_SLOT_REF2="ts1163">
                <ANNOTATION_VALUE>pero yehwa ke:meh nimitsilwia neh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a622" TIME_SLOT_REF1="ts1164" TIME_SLOT_REF2="ts1165">
                <ANNOTATION_VALUE>*que** kilpi:s ika yo:n iisti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623" TIME_SLOT_REF1="ts1166" TIME_SLOT_REF2="ts1167">
                <ANNOTATION_VALUE>wa:n ya:s wa:n kahsiti:w *hasta** ka:ni n' tamito n' imomá:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a624" TIME_SLOT_REF1="ts1168" TIME_SLOT_REF2="ts1169">
                <ANNOTATION_VALUE>wa:n no: momahmaxalo:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a625" TIME_SLOT_REF1="ts1170" TIME_SLOT_REF2="ts1171">
                <ANNOTATION_VALUE>wa:n no: xo:chiowas</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts1172" TIME_SLOT_REF2="ts1173">
                <ANNOTATION_VALUE>wa:n kita:li:s n' ixo:chiotsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a627" TIME_SLOT_REF1="ts1174" TIME_SLOT_REF2="ts1175">
                <ANNOTATION_VALUE>pero a:mo ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a628" TIME_SLOT_REF1="ts1176" TIME_SLOT_REF2="ts1178">
                <ANNOTATION_VALUE>Neh ihkó:n niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630" TIME_SLOT_REF1="ts1180" TIME_SLOT_REF2="ts1183">
                <ANNOTATION_VALUE>*Porque** neh nitekitik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631" TIME_SLOT_REF1="ts1184" TIME_SLOT_REF2="ts1185">
                <ANNOTATION_VALUE>De wehka:w, nikwik yehwa yo:n poposokani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a632" TIME_SLOT_REF1="ts1186" TIME_SLOT_REF2="ts1187">
                <ANNOTATION_VALUE>Wa:n no: nik..., no: niki:xmatik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a633" TIME_SLOT_REF1="ts1188" TIME_SLOT_REF2="ts1189">
                <ANNOTATION_VALUE>ke:yeh yo:n kwopoposokani tikihto:skeh yo:n kwomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634" TIME_SLOT_REF1="ts1190" TIME_SLOT_REF2="ts1191">
                <ANNOTATION_VALUE>te:chpale:wia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a635" TIME_SLOT_REF1="ts1192" TIME_SLOT_REF2="ts1193">
                <ANNOTATION_VALUE>*porque** onkak oksé: kwowit ok *más**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a636" TIME_SLOT_REF1="ts1194" TIME_SLOT_REF2="ts1195">
                <ANNOTATION_VALUE>kachi ok para te:chilwi:skeh *que** i:n ihkwí:n tikchi:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a637" TIME_SLOT_REF1="ts1196" TIME_SLOT_REF2="ts1198">
                <ANNOTATION_VALUE>Wa:n ika yo:n nikchihchi:waya neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a712" TIME_SLOT_REF1="ts1348" TIME_SLOT_REF2="ts1349">
                <ANNOTATION_VALUE>Pos *por eso** nimitsilia, ekintsi:n nimitstamiilwih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a713" TIME_SLOT_REF1="ts1350" TIME_SLOT_REF2="ts1351">
                <ANNOTATION_VALUE>*que** ika yo:n iistiwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a714" TIME_SLOT_REF1="ts1352" TIME_SLOT_REF2="ts1353">
                <ANNOTATION_VALUE>yehwa n' ika mopilowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a715" TIME_SLOT_REF1="ts1354" TIME_SLOT_REF2="ts1355">
                <ANNOTATION_VALUE>wa:n ika yo:n mo..., ika yo:n mo..., moohtokaltia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a716" TIME_SLOT_REF1="ts1356" TIME_SLOT_REF2="ts1357">
                <ANNOTATION_VALUE>mopilohtiw wa:n ohtokas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a717" TIME_SLOT_REF1="ts1358" TIME_SLOT_REF2="ts1359">
                <ANNOTATION_VALUE>*hasta** ka:mpa tamiti:w n' ineskaltilis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a718" TIME_SLOT_REF1="ts1360" TIME_SLOT_REF2="ts1361">
                <ANNOTATION_VALUE>Kahsiti:w n' imomá:n wa:n ompa ya miak mowi:wila:nas ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a719" TIME_SLOT_REF1="ts1362" TIME_SLOT_REF2="ts1363">
                <ANNOTATION_VALUE>sentakwis a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a720" TIME_SLOT_REF1="ts1364" TIME_SLOT_REF2="ts1365">
                <ANNOTATION_VALUE>para kihtowa *que** yeh no: ompa tami a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a721" TIME_SLOT_REF1="ts1366" TIME_SLOT_REF2="ts1367">
                <ANNOTATION_VALUE>Kemih tehwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a722" TIME_SLOT_REF1="ts1368" TIME_SLOT_REF2="ts1369">
                <ANNOTATION_VALUE>te:chiskaltihkeh wa:n timoskaltiah wa:n *hasta** ka:mpa tiwe:wehtito.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723" TIME_SLOT_REF1="ts1370" TIME_SLOT_REF2="ts1371">
                <ANNOTATION_VALUE>Pos no: ihko:ni yo:n kwomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724" TIME_SLOT_REF1="ts1372" TIME_SLOT_REF2="ts1373">
                <ANNOTATION_VALUE>Poposokanimekat niki:xmati *que** kipia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725" TIME_SLOT_REF1="ts1374" TIME_SLOT_REF2="ts1375">
                <ANNOTATION_VALUE>seki *cuando** tiktsontekis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726" TIME_SLOT_REF1="ts1376" TIME_SLOT_REF2="ts1377">
                <ANNOTATION_VALUE>kipia seki a:tsí:n pe:wa chahchala:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a727" TIME_SLOT_REF1="ts1378" TIME_SLOT_REF2="ts1379">
                <ANNOTATION_VALUE>wa:n, wa:n yehwa yo:n, wa:n yo:n mono:tsa poposokanimekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728" TIME_SLOT_REF1="ts1380" TIME_SLOT_REF2="ts1381">
                <ANNOTATION_VALUE>Wa:n texokomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a729" TIME_SLOT_REF1="ts1382" TIME_SLOT_REF2="ts1383">
                <ANNOTATION_VALUE>no: tiktsontekis wa:n yehwa yo:n neh niki:xmati *que** poposokani n' i..., n' icho:kilo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730" TIME_SLOT_REF1="ts1384" TIME_SLOT_REF2="ts1385">
                <ANNOTATION_VALUE>n' texokomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731" TIME_SLOT_REF1="ts1386" TIME_SLOT_REF2="ts1387">
                <ANNOTATION_VALUE>Pero texokomekat kikwih para pahti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732" TIME_SLOT_REF1="ts1388" TIME_SLOT_REF2="ts1389">
                <ANNOTATION_VALUE>yo:n texokomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733" TIME_SLOT_REF1="ts1390" TIME_SLOT_REF2="ts1391">
                <ANNOTATION_VALUE>a:mo tikmatih tehwa:n ke:ye: yo:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734" TIME_SLOT_REF1="ts1392" TIME_SLOT_REF2="ts1393">
                <ANNOTATION_VALUE>pero se: okichpil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735" TIME_SLOT_REF1="ts1394" TIME_SLOT_REF2="ts1395">
                <ANNOTATION_VALUE>*cuando, cuando** kimachilia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736" TIME_SLOT_REF1="ts1396" TIME_SLOT_REF2="ts1397">
                <ANNOTATION_VALUE>kwata..., *este** talka:wa oso ki..., ki..., *como que** ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737" TIME_SLOT_REF1="ts1398" TIME_SLOT_REF2="ts1399">
                <ANNOTATION_VALUE>kitalka:wiltia n' a..., ox iyo:lo n' a:mo taxi:kowa *o** ke:ní:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738" TIME_SLOT_REF1="ts1400" TIME_SLOT_REF2="ts1401">
                <ANNOTATION_VALUE>pero yo:n texokomekat kitsonteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739" TIME_SLOT_REF1="ts1402" TIME_SLOT_REF2="ts1403">
                <ANNOTATION_VALUE>wa:n kipipi:na,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740" TIME_SLOT_REF1="ts1404" TIME_SLOT_REF2="ts1405">
                <ANNOTATION_VALUE>wa:n kipale:wia yo:n, yo:n tokni:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a741" TIME_SLOT_REF1="ts1406" TIME_SLOT_REF2="ts1407">
                <ANNOTATION_VALUE>Wa:n yo:ni sah yeh n' ika moyo:litia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a742" TIME_SLOT_REF1="ts1408" TIME_SLOT_REF2="ts1409">
                <ANNOTATION_VALUE>Wa:n *por eso, que** neh kihtowa nikita,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a743" TIME_SLOT_REF1="ts1410" TIME_SLOT_REF2="ts1411">
                <ANNOTATION_VALUE>wa:n nikihtowa *porque** nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744" TIME_SLOT_REF1="ts1412" TIME_SLOT_REF2="ts1413">
                <ANNOTATION_VALUE>Pero komohkó:n a:mo mo..., komo a:mo ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745" TIME_SLOT_REF1="ts1414" TIME_SLOT_REF2="ts1415">
                <ANNOTATION_VALUE>komo a:mo kitai:lih yo:n a:t tein kipia i..., n' icho:kilo tein kipia yo:n texokomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a746" TIME_SLOT_REF1="ts1416" TIME_SLOT_REF2="ts1417">
                <ANNOTATION_VALUE>pos weli kichi:was mah ika i:xpoliwi a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747" TIME_SLOT_REF1="ts1418" TIME_SLOT_REF2="ts1419">
                <ANNOTATION_VALUE>*porque** ta:l, nika:n itech i:n ta:ltikpak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748" TIME_SLOT_REF1="ts1420" TIME_SLOT_REF2="ts1421">
                <ANNOTATION_VALUE>onkak miak kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749" TIME_SLOT_REF1="ts1422" TIME_SLOT_REF2="ts1423">
                <ANNOTATION_VALUE>Wa:n ihkó:n ke:meh onkak miak kokolis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750" TIME_SLOT_REF1="ts1424" TIME_SLOT_REF2="ts1425">
                <ANNOTATION_VALUE>onkak miak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a751" TIME_SLOT_REF1="ts1426" TIME_SLOT_REF2="ts1427">
                <ANNOTATION_VALUE>pahti tein ika timopale:wi:skiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752" TIME_SLOT_REF1="ts1428" TIME_SLOT_REF2="ts1429">
                <ANNOTATION_VALUE>pero a:mo nochi tikmahmatih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753" TIME_SLOT_REF1="ts1430" TIME_SLOT_REF2="ts1431">
                <ANNOTATION_VALUE>a:mo nochi tikmahmatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754" TIME_SLOT_REF1="ts1432" TIME_SLOT_REF2="ts1433">
                <ANNOTATION_VALUE>N' texokomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a755" TIME_SLOT_REF1="ts1434" TIME_SLOT_REF2="ts1435">
                <ANNOTATION_VALUE>o:me taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a756" TIME_SLOT_REF1="ts1436" TIME_SLOT_REF2="ts1437">
                <ANNOTATION_VALUE>Se: tein ti:ltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a757" TIME_SLOT_REF1="ts1438" TIME_SLOT_REF2="ts1439">
                <ANNOTATION_VALUE>wa:n se: n' tein chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a758" TIME_SLOT_REF1="ts1440" TIME_SLOT_REF2="ts1441">
                <ANNOTATION_VALUE>Tein chi:chi:ltik n' texokomekat onkak *solamente** ne: tanikwa:kopa por Xaltipan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a759" TIME_SLOT_REF1="ts1442" TIME_SLOT_REF2="ts1443">
                <ANNOTATION_VALUE>Ayotzinapan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a760" TIME_SLOT_REF1="ts1444" TIME_SLOT_REF2="ts1445">
                <ANNOTATION_VALUE>ompa onkak pero itech n' tepe:yoh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761" TIME_SLOT_REF1="ts1446" TIME_SLOT_REF2="ts1447">
                <ANNOTATION_VALUE>texokomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762" TIME_SLOT_REF1="ts1448" TIME_SLOT_REF2="ts1449">
                <ANNOTATION_VALUE>Wa:n texokomekat onkak tein ti:ltik, nika:n por Tahchiktekopa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a763" TIME_SLOT_REF1="ts1450" TIME_SLOT_REF2="ts1451">
                <ANNOTATION_VALUE>Ompaka tikahsis texokomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764" TIME_SLOT_REF1="ts1452" TIME_SLOT_REF2="ts1453">
                <ANNOTATION_VALUE>pero tein ti:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a765" TIME_SLOT_REF1="ts1454" TIME_SLOT_REF2="ts1455">
                <ANNOTATION_VALUE>Wa:n tein chi:chi:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766" TIME_SLOT_REF1="ts1456" TIME_SLOT_REF2="ts1457">
                <ANNOTATION_VALUE>weli no: tikta:li:s *cuidado** wa:n tikitas nika:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767" TIME_SLOT_REF1="ts1458" TIME_SLOT_REF2="ts1459">
                <ANNOTATION_VALUE>Ayotzinapan ka:mpa se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a768" TIME_SLOT_REF1="ts1460" TIME_SLOT_REF2="ts1461">
                <ANNOTATION_VALUE>se: ta:l kilwiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a769" TIME_SLOT_REF1="ts1462" TIME_SLOT_REF2="ts1463">
                <ANNOTATION_VALUE>Tahsoltepe:yowaltitan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770" TIME_SLOT_REF1="ts1464" TIME_SLOT_REF2="ts1465">
                <ANNOTATION_VALUE>ompaka n' onkak yo:n kwomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a771" TIME_SLOT_REF1="ts1466" TIME_SLOT_REF2="ts1467">
                <ANNOTATION_VALUE>Wa:n tein ti:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a772" TIME_SLOT_REF1="ts1468" TIME_SLOT_REF2="ts1469">
                <ANNOTATION_VALUE>nika:n Tahchiktekopa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a773" TIME_SLOT_REF1="ts1470" TIME_SLOT_REF2="ts1471">
                <ANNOTATION_VALUE>por A:tehkohkomol *o por** we:ikwowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a774" TIME_SLOT_REF1="ts1472" TIME_SLOT_REF2="ts1474">
                <ANNOTATION_VALUE>ompaka tikahsis texokomekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776" TIME_SLOT_REF1="ts1476" TIME_SLOT_REF2="ts1479">
                <ANNOTATION_VALUE>Pero m' poposokani,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777" TIME_SLOT_REF1="ts1480" TIME_SLOT_REF2="ts1481">
                <ANNOTATION_VALUE>ka:mpa tiknekis onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778" TIME_SLOT_REF1="ts1482" TIME_SLOT_REF2="ts1483">
                <ANNOTATION_VALUE>*hasta** neh itech nota:lpan no: onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a779" TIME_SLOT_REF1="ts1484" TIME_SLOT_REF2="ts1485">
                <ANNOTATION_VALUE>*Por eso** niki:xmati itech yo:n, yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a780" TIME_SLOT_REF1="ts1486" TIME_SLOT_REF2="ts1487">
                <ANNOTATION_VALUE>tato:k, ta:kilo:t *o** mochi:wa sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781" TIME_SLOT_REF1="ts1488" TIME_SLOT_REF2="ts1490">
                <ANNOTATION_VALUE>pero onkak wa:n tekiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a783" TIME_SLOT_REF1="ts1492" TIME_SLOT_REF2="ts1495">
                <ANNOTATION_VALUE>Pero x'chi:walti, xikchi:walti para mochi:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a827" TIME_SLOT_REF1="ts1583" TIME_SLOT_REF2="ts1584">
                <ANNOTATION_VALUE>Pos te:chpale:wia yehwa yo:ni, *cuando** tikita a:mo onkak a:tsi:ni ka:mpa teh tinemi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a828" TIME_SLOT_REF1="ts1585" TIME_SLOT_REF2="ts1586">
                <ANNOTATION_VALUE>wa:n itech, te:chchi:wilia *falta** miak para tehwa:n tipano:skeh sayoh *porque** telto:na wa:n a:mo nimowi:kilih a:tsín,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a829" TIME_SLOT_REF1="ts1587" TIME_SLOT_REF2="ts1588">
                <ANNOTATION_VALUE>yehwa yo:n tapale:wia neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a830" TIME_SLOT_REF1="ts1589" TIME_SLOT_REF2="ts1590">
                <ANNOTATION_VALUE>Ika yo:n timoyo:lchika:was tepitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a831" TIME_SLOT_REF1="ts1591" TIME_SLOT_REF2="ts1592">
                <ANNOTATION_VALUE>*mientras** tikahsiti:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a832" TIME_SLOT_REF1="ts1593" TIME_SLOT_REF2="ts1594">
                <ANNOTATION_VALUE>ka:ni n' a:..., ka:ni n' onkak a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a833" TIME_SLOT_REF1="ts1595" TIME_SLOT_REF2="ts1596">
                <ANNOTATION_VALUE>Ne: wehka:w kichi:wayah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a834" TIME_SLOT_REF1="ts1597" TIME_SLOT_REF2="ts1598">
                <ANNOTATION_VALUE>a:tekochmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a835" TIME_SLOT_REF1="ts1599" TIME_SLOT_REF2="ts1600">
                <ANNOTATION_VALUE>wa:n ompa mosentilia:ya n' a:tsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a836" TIME_SLOT_REF1="ts1601" TIME_SLOT_REF2="ts1602">
                <ANNOTATION_VALUE>wa:n ika yo:n timop..., timoyo:lchika:wayah, timopale:wia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a837" TIME_SLOT_REF1="ts1603" TIME_SLOT_REF2="ts1604">
                <ANNOTATION_VALUE>Pero komo wehka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a838" TIME_SLOT_REF1="ts1605" TIME_SLOT_REF2="ts1606">
                <ANNOTATION_VALUE>ke:ní:w n' ika timotalo:ti ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a839" TIME_SLOT_REF1="ts1607" TIME_SLOT_REF2="ts1608">
                <ANNOTATION_VALUE>titai:ti *hasta** ompa wa:n ta:ká:n wehka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a840" TIME_SLOT_REF1="ts1609" TIME_SLOT_REF2="ts1610">
                <ANNOTATION_VALUE>ihwa:k tiehkos ne: motekipah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a841" TIME_SLOT_REF1="ts1611" TIME_SLOT_REF2="ts1612">
                <ANNOTATION_VALUE>i:pa kiowi a, tiwa:lpano:tiki:sa ya sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a842" TIME_SLOT_REF1="ts1613" TIME_SLOT_REF2="ts1614">
                <ANNOTATION_VALUE>Wa:n para a:mo yo:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a843" TIME_SLOT_REF1="ts1615" TIME_SLOT_REF2="ts1616">
                <ANNOTATION_VALUE>ika yehwa yo:n kwamekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a844" TIME_SLOT_REF1="ts1617" TIME_SLOT_REF2="ts1618">
                <ANNOTATION_VALUE>'tahkoteki wa:n x'pipi:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a845" TIME_SLOT_REF1="ts1619" TIME_SLOT_REF2="ts1620">
                <ANNOTATION_VALUE>Pero yo:n a:mo timochi:wilihtok se: *mal**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a846" TIME_SLOT_REF1="ts1621" TIME_SLOT_REF2="ts1622">
                <ANNOTATION_VALUE>sanoke yo:n nimitsilwia *que** yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a847" TIME_SLOT_REF1="ts1623" TIME_SLOT_REF2="ts1624">
                <ANNOTATION_VALUE>yo:n cho:kilo:t tein kipia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a848" TIME_SLOT_REF1="ts1625" TIME_SLOT_REF2="ts1626">
                <ANNOTATION_VALUE>tapale:wia. Neh nimitsilwia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a849" TIME_SLOT_REF1="ts1627" TIME_SLOT_REF2="ts1628">
                <ANNOTATION_VALUE>*porque** se: no..., nomontika:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a850" TIME_SLOT_REF1="ts1629" TIME_SLOT_REF2="ts1630">
                <ANNOTATION_VALUE>ika yo:ni mopale:wihtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a851" TIME_SLOT_REF1="ts1631" TIME_SLOT_REF2="ts1633">
                <ANNOTATION_VALUE>A:it toni n' kipia de kokolis, pero ika yo:ni i:xpeta:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a860" TIME_SLOT_REF1="ts1651" TIME_SLOT_REF2="ts1652">
                <ANNOTATION_VALUE>*Pues** tehwa:n timohmo:tstokeh *sob...**, e..., itech i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a861" TIME_SLOT_REF1="ts1653" TIME_SLOT_REF2="ts1654">
                <ANNOTATION_VALUE>tehwa:n timonohno:tstokeh itech i:n talna:miki:lis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a862" TIME_SLOT_REF1="ts1655" TIME_SLOT_REF2="ts1656">
                <ANNOTATION_VALUE>de poposokani,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a863" TIME_SLOT_REF1="ts1657" TIME_SLOT_REF2="ts1658">
                <ANNOTATION_VALUE>wa:n ke:mah tikpatakeh ya, ti..., tina:ltaksakeh ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a864" TIME_SLOT_REF1="ts1659" TIME_SLOT_REF2="ts1660">
                <ANNOTATION_VALUE>iwa:n texokomekat, *pero mismo, mismo** yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a865" TIME_SLOT_REF1="ts1661" TIME_SLOT_REF2="ts1662">
                <ANNOTATION_VALUE>Pero, ekintsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a866" TIME_SLOT_REF1="ts1663" TIME_SLOT_REF2="ts1664">
                <ANNOTATION_VALUE>neh nimitsilwih ya kati:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a867" TIME_SLOT_REF1="ts1665" TIME_SLOT_REF2="ts1666">
                <ANNOTATION_VALUE>wa:n toni nepale:wi:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a868" TIME_SLOT_REF1="ts1667" TIME_SLOT_REF2="ts1668">
                <ANNOTATION_VALUE>Pero m' poposokani no: tapale:wia pero yehwa ya para ke:meh i:n teihsá: ma:tachihchi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a869" TIME_SLOT_REF1="ts1669" TIME_SLOT_REF2="ts1670">
                <ANNOTATION_VALUE>Wa:n para i:n texokomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a870" TIME_SLOT_REF1="ts1671" TIME_SLOT_REF2="ts1672">
                <ANNOTATION_VALUE>pos i:n no: oksé:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a871" TIME_SLOT_REF1="ts1673" TIME_SLOT_REF2="ts1674">
                <ANNOTATION_VALUE>*como que** mah tikihto:ka:n, neh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a872" TIME_SLOT_REF1="ts1675" TIME_SLOT_REF2="ts1676">
                <ANNOTATION_VALUE>wa:n teh, teh no: se: wa:n neh no: se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a873" TIME_SLOT_REF1="ts1677" TIME_SLOT_REF2="ts1679">
                <ANNOTATION_VALUE>Teh tiTacho wa:n neh niJuan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a875" TIME_SLOT_REF1="ts1681" TIME_SLOT_REF2="ts1684">
                <ANNOTATION_VALUE>Teihsá: talna:miki:lis tikpiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a876" TIME_SLOT_REF1="ts1685" TIME_SLOT_REF2="ts1686">
                <ANNOTATION_VALUE>pero ta:taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877" TIME_SLOT_REF1="ts1687" TIME_SLOT_REF2="ts1688">
                <ANNOTATION_VALUE>Pero a:mo, ta: ompa tio..., ompa tioweh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a878" TIME_SLOT_REF1="ts1689" TIME_SLOT_REF2="ts1690">
                <ANNOTATION_VALUE>ompa tioweh para timosenyo:lmahxitiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a879" TIME_SLOT_REF1="ts1691" TIME_SLOT_REF2="ts1692">
                <ANNOTATION_VALUE>toni n' onkak itech nejí:n xola:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a880" TIME_SLOT_REF1="ts1693" TIME_SLOT_REF2="ts1694">
                <ANNOTATION_VALUE>toni n' onkak itech i:n xola:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a881" TIME_SLOT_REF1="ts1695" TIME_SLOT_REF2="ts1696">
                <ANNOTATION_VALUE>toni n' weli tikchi:waskeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a882" TIME_SLOT_REF1="ts1697" TIME_SLOT_REF2="ts1698">
                <ANNOTATION_VALUE>wa:n toni mah a:mo tikchi:waka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a883" TIME_SLOT_REF1="ts1699" TIME_SLOT_REF2="ts1700">
                <ANNOTATION_VALUE>*Porque** tein a:mo kwali motas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a884" TIME_SLOT_REF1="ts1701" TIME_SLOT_REF2="ts1703">
                <ANNOTATION_VALUE>mah a:mo t'chi:waka:n wa:n tein kwali motas, yehwa mah tikwika:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a886" TIME_SLOT_REF1="ts1705" TIME_SLOT_REF2="ts1708">
                <ANNOTATION_VALUE>ke:namih tein onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a887" TIME_SLOT_REF1="ts1709" TIME_SLOT_REF2="ts1710">
                <ANNOTATION_VALUE>*hasta** topi:piltsitsi:n weli tikinimakaskeh,</ANNOTATION_VALUE>
