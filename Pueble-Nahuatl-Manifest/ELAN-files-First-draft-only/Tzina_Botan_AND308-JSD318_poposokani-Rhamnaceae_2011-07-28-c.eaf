        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679" TIME_SLOT_REF1="ts1281" TIME_SLOT_REF2="ts1282">
                <ANNOTATION_VALUE>*Porque** ne:n poposokani ke:meh eskia yo:n ima:wa:n.</ANNOTATION_VALUE>
