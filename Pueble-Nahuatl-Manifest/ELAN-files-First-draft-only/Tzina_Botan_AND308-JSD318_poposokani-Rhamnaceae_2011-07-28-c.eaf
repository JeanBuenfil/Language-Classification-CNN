            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a690" TIME_SLOT_REF1="ts1303" TIME_SLOT_REF2="ts1304">
                <ANNOTATION_VALUE>ompa mochika:waltihtiw, tak yo:n para ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a691" TIME_SLOT_REF1="ts1305" TIME_SLOT_REF2="ts1306">
                <ANNOTATION_VALUE>ke:meh ne: yo:ltok no: *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692" TIME_SLOT_REF1="ts1307" TIME_SLOT_REF2="ts1308">
                <ANNOTATION_VALUE>komo sepa se: kitekik ne:n tani, ta:lpan, pos ahko nochi wa:kiti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693" TIME_SLOT_REF1="ts1309" TIME_SLOT_REF2="ts1310">
                <ANNOTATION_VALUE>Yo:n komo, komo se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694" TIME_SLOT_REF1="ts1311" TIME_SLOT_REF2="ts1312">
