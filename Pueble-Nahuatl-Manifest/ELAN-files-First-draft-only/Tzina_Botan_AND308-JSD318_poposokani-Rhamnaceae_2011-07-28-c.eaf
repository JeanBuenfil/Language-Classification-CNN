        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707" TIME_SLOT_REF1="ts1337" TIME_SLOT_REF2="ts1338">
                <ANNOTATION_VALUE>motehtetsi:lowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a708" TIME_SLOT_REF1="ts1339" TIME_SLOT_REF2="ts1340">
                <ANNOTATION_VALUE>pos *fuerte** ihkó:n moki:tskia ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a709" TIME_SLOT_REF1="ts1341" TIME_SLOT_REF2="ts1342">
                <ANNOTATION_VALUE>wa:n a:mo wel se: kitila:na wa:n de sepa momahma:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a710" TIME_SLOT_REF1="ts1343" TIME_SLOT_REF2="ts1344">
                <ANNOTATION_VALUE>*mismo** ya ne:n i..., n' ima:yo de n' kowit kitsakwilia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a711" TIME_SLOT_REF1="ts1345" TIME_SLOT_REF2="ts1347">
                <ANNOTATION_VALUE>kitsakwilia ya, a:mo, a:mo wel nijó:n, a:mo wel taneki:sa ok *porque** yehwa kitsakwilia ya. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
