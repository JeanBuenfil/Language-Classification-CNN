        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>nijo:n e:yi taman neh niki:xmattok, o:me de n' ista:k,</ANNOTATION_VALUE>
