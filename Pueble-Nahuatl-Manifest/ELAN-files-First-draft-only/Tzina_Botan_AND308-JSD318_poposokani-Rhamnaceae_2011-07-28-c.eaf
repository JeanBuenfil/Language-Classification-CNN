        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts996" TIME_SLOT_REF2="ts997">
                <ANNOTATION_VALUE>A:mo pala:ni, pero *xicuidaro**.</ANNOTATION_VALUE>
