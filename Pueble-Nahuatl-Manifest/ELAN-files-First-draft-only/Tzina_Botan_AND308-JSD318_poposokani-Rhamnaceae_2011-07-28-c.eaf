        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678" TIME_SLOT_REF1="ts1279" TIME_SLOT_REF2="ts1280">
                <ANNOTATION_VALUE>ke:meh eskia kipia n' i..., n' imahma:yo ihkó:n tehtetsi:ltik ke:meh ne:n poposokani.</ANNOTATION_VALUE>
