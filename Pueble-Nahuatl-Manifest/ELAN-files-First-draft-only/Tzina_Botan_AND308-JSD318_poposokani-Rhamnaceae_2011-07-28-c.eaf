        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts655" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>tiki:xchihchi:wayah ika seki kwowe:wat tein onkaya no: *mismo** ompa ka:mpa onkak m' poposokani,</ANNOTATION_VALUE>
