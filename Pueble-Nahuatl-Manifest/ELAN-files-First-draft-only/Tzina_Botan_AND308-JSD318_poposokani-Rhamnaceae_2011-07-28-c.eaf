        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>De n' chi:chi:l..., de n' ista:k yeh nimitsilia ta:lpan mowi:wila:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>*Porque** ne:n texokomekat no:, no: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>Nochi, nochi tata:man. Pero i:n ne:n neh niki:xmattok e:yi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>Yehwa ya de n' chi:chi:ltik wa:n yehwa ya n' o:me, *porque** de n' ista:k se: te:tehko, ihkó:n mowi:wila:na</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>ahko, itech, itech kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>Wa:n oksé: yeh, ta:lpan ihkó:n mowi:wila:na,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>ka:sá: ihkó:n pa:nki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>Entó:s kwaltsi:n mehmela:wak no:, no: taman ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>No: taman, nehwa niki:xmattok de e:yi poposokani, de n' o:me de n' ista:k yo:n te:tehko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>yo:n kwaltsi:n se: kiki:xtilia n' ie:wayo wa:n ki:sa yo:n de n' te:tehko ne:n ke:meh ne: ike:span de n' kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Wa:n oksé: achi kohko..., se: kipihpixka ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>se: kipihpixka ika se: iisti, se: imahpil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>wa:n kohkoto:ni, ihkwi:ntsitsi:n sah ki:stiw n' ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>Yo:n nimitsilia de n' ta:lpan moso:sowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>Yo:n seki kipia ne:n inalwayotsi:n tata:mpa, de moso:sowa se: kiki:xtilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>Nika:n i:n moso:wtiw wa:n ni..., nika:n ipoxta:mpa ne: kipia n' inalwayo, n' inalwayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>Wa:n oksé: a:mo, yo:n kipia n' itsi:ntan sayoh n' inalwayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>wa:n pa:nki:sa ihkó:n itech kowtsí:n, yo:n a:mo kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts497">
                <ANNOTATION_VALUE>Wa:n ihkwi:kwí:n de we:weyak ka:mpa ne:n itsmol,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>n' ii:x ihkwí:n de we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>Wa:n yo:n de n' chihchi:chi:ltik yo:n semi *cecerca** ihkwí:n, a:mo we:wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>Semi ye:ktehtepitsitsi:n ihkó:n kipia, ke:meh eskia motohtokatok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>Ke:meh eskia motohtokatok wa:n ne:n de n' oksé: ista:k, ne:n ista:kpoposokani,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>yo:n no: *igual**, no: we:weyaktsitsi:n ihkó:n kipia ne:n itsmol ka:mpa ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>itsmoli:ni ka:mpa ne: kipia ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>ompa ne: e:wa ya para ihkó:n momahma:yo:tia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>Yehwa yo:n neh niki:xmattok, xa: tikita nika:n ka:mpa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>nika:n i:n ixta:watatsi:ntan, de ne: Tahchikteko paratani ompa semi telonkaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>N' ompa neh niko:nkwika *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts518" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>pos ne:n nosiwa:mon no: semi tekiti de yo:n chi:walis wa:n neh ompa nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>niko:nkwika yo:n komekatsí:n de m' poposokani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Ke:masá:, *antes** a:mo weliah nantahkwilowa:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>A:, tikchihchi:wka se:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>Oksé: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>A:, wahkal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>Pos yehwa yo:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>nika:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts735" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>Ke:mah. Pos yehwa yo:n nimitstahtania, no: nik..., ke:mah de yo:n ti..., ka:mpa tikihtowa:ya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>tata:wikmekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>Pos yo:n ne: tikmattokeh, yo:n no: mochi:wa ne:, no: tech kwowit *o** ka:nsá: ika itech tepe:t mowi:wila:na,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts741" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>wa:n yo:n se: kixihxi:wa wa:n i:n poposokani pos se: ki..., kehke:wa, se: kehke:wa, se: kiki:xtilia n' ie:wayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>wa:n yo:n tata:wikmekat pos yeh yo:n se: ki..., kixihxhi:ma yo:n yeh cho:kiloh no:, yo:n no: kwaltia n' ista:k no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts745" TIME_SLOT_REF2="ts746">
                <ANNOTATION_VALUE>Wa:n sepa n' oksé: taman, no: de wahkal, ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts747" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>yo:n kiliah chili:yohkowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts749" TIME_SLOT_REF2="ts750">
                <ANNOTATION_VALUE>wa:n yo:n kwesalme..., ik..., se:, se: kiliah no:, no: para wahkal kwesalmekat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>Nijó:n no:, no: kwaltia, kiliah kwesalmekat *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts753" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>ihkó:n tsa:tsaya:ni, se: kiki:xtilia n' e:wat kwaltsi:n tsaya:ntiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>Wa:n yo:n chi:li:yohkowit yo:n a:mo semi wel we:weyak ne: mochi:wa mehmela:wak, achi ihkó:n tehtetsi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts757" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>Yo:n ike:span de ne:n kowit, no: mo..., achi chihchi:chi:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>pihpitsa:wak pero we:i, mowe:ita:lia *mero** ka:mpa moskaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>Yehwa yo:n nochi niki:xmattok yo:n, yo:n komekatsí:n pero i:n pos yehwa ya ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts764">
                <ANNOTATION_VALUE>yeh nimitsilia n..., a:mo yehwa, a:mo nimopolowa ta:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts765" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>niki:xmattok yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>*porque** neh nijó:n no: ni..., nikwiti ne:wí:n ne:chyo:le:wah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>niki:xmattok de e:yi taman poposokani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>Yehwa de n' ista:k wa:n a:mo n' tikihtowa *de que** xa:, xa: wiwilakani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts773" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>Wiwilakani a:mo kwaltia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>yo:n a:mo kwaltia nikihto:s wiwilakani a:mokwaltia para teihsá: ma:tachihchi:w se: kiewalo:s, yo:n a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>Kati:yehwa i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts779" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>nijo:n yehwa i:n neh niki:xmattok de e:yi taman ne:n poposokani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>Yeh o:me taman de n' ista:k wa:n de n' ista:k pos yo:n no: taman monalwayo:tihtiw, de n' ta:lpan moso:sowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts784">
                <ANNOTATION_VALUE>Wa:n de n' oksé: no: de ista:k, yo:n ke:..., ka:s ika se: kita ike:span de n' kowit oso tech tepe:t ompa tehkotok, se: kitila:na wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>pos ke:masá: *mismo** yeh se: kikwi, ika se: kilpia ya ka:mpa se: *kimanota:lia** ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts787" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>se: kitetekwinowa wa:n se: *kimanota:lia** komo a:mo teh se: kita ne:n komekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts789" TIME_SLOT_REF2="ts790">
                <ANNOTATION_VALUE>pos se: kiki:xtilia n' ipane:wayo wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts791" TIME_SLOT_REF2="ts792">
                <ANNOTATION_VALUE>ma:sá: ihkwi:kwí:n ki:sa pos ika se: kitahkoilpia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440" TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>I:n *serbirowa, pero** yo:n chi:chi:lkomekat, yo:n ma:ski tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts795" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>tik..., tikihto:s *que** tikwiti n' ipane:wayo, yo:n a:mo kwaltia, kohkoto:ni, *igual** n' oksé: de n'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts797" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>n' oksé: de nmitsilwia ta:lpan e:wi ne:n, ta:lpan moso:sowa m' poposokani,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts800">
                <ANNOTATION_VALUE>yo:n hkwi:kwí:n se: kehke:wa kohkoto:ntiw, yo:n i:pa a:mo kwaltia para se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts801" TIME_SLOT_REF2="ts802">
                <ANNOTATION_VALUE>nikihto:s se: talpi:s pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts803" TIME_SLOT_REF2="ts804">
                <ANNOTATION_VALUE>yehwa yo:n nikitak ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts806">
                <ANNOTATION_VALUE>no: yo:n kwaltsi:n mokweta:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts807" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>Pero i:n chi:chi:ltik komekat, yo:n komo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts810">
                <ANNOTATION_VALUE>ka:mpa ne:n ii:x tik..., tikwelpacho:ti, ne:nke:n pohposteki, yo:n a:mo, a:mo kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts811" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>*Igual** para se: ki..., *cuando** wa:ki se: kitehteki yo:n semi tel..., teltakwa:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts814">
                <ANNOTATION_VALUE>teltakwa:wak no: ne:n poposokani *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>seki mochi:wa ye:kwehwei, *hasta** ihko:kó:n de tohtoma:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts817" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>mochi:wa m' poposokani de n' chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts819" TIME_SLOT_REF2="ts820">
                <ANNOTATION_VALUE>Wehwei mochi:wa, ihkó:n mehmela:wak, kitehtekitioweh, ke:masá: *siquiera**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>na:wi tatek se: kite:ki, para se..., ma:sá: se: kikwelpachowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts824">
                <ANNOTATION_VALUE>*Siquiera** na:wi tatek se: kikwelpacho:sneki yo:n poposokani chi:chi:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts825" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>pero a:mo kwaltia, posteki. Ka:mpa se: kikwelpachowa ihkó:n se: kitamachi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>wa:n se: kikwelpacho:ti a, posteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts830">
                <ANNOTATION_VALUE>Wa:n oksé: ke:meh eskia yo:n de n' ista:k, se: kichi:wa ihkó:n, mokweta:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts832">
                <ANNOTATION_VALUE>Mokweta:nia, pos a:mo, a:mo posteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts833" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>Mokweta:nia, yehwa ya nijó:n se:, se: kikwi, yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>yo:n semi kwaltsi:n tapale:wia. Pero i:n okseki a:mo, a:mo, a:mo nochi se: kikwi, ke:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts837" TIME_SLOT_REF2="ts838">
                <ANNOTATION_VALUE>yo:n imahma:yo de n' para se: kikwi yo:n pihpitsa:wak, a:mo kwaltia, pohposteki no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts840">
                <ANNOTATION_VALUE>kwaltia *pero selo..., solamente** se: kiewalowa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts841" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>Se: kiewa:lowa sah, a:mo se: kikwelpachowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>Ne: ke:man pos nochi tikwelpachowa:yah, pero kintsi:n seki kiewalowah sah, yo:n tak a:chá: welis pero n' imahma:yo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts845" TIME_SLOT_REF2="ts846">
                <ANNOTATION_VALUE>*Pero mero** toma:wak pohposteki wa:n oksé: yeh ne:n ista:k n' o:me, yo: weli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467" TIME_SLOT_REF1="ts847" TIME_SLOT_REF2="ts848">
                <ANNOTATION_VALUE>Se: kikweta:ni ihkó:n, se: kikweta:nia, entó:s moka:wa kwaltsi:n ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts849" TIME_SLOT_REF2="ts850">
                <ANNOTATION_VALUE>Kipia, nijó:n se: kitamachi:wa ihkó:n i:xtapal wa:n se: kikweta:nia, pos a:mo posteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469" TIME_SLOT_REF1="ts851" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>pero i:n, i:n seki pohposteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>I:n 'tsilihtok *igual** ne:n tata:wikmekat no: seki a:mo posteki, ma:s se: kichi:wa ihkó:n se: kikwelpachowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a471" TIME_SLOT_REF1="ts855" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>Wa:n yo:n no:, no: kikwih semi para kiewalowah yo:n ye:kkwaltsi:n ki:sa ne:n ie:wa..., ne:n kowtsí:n *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts857" TIME_SLOT_REF2="ts858">
                <ANNOTATION_VALUE>kixihxi:mah kwaltsi:n ika se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts859" TIME_SLOT_REF2="ts860">
                <ANNOTATION_VALUE>tateki:lo:ni se: kikwi yektsikilitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts861" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>wa:n se: kixihxi:ma. Se: kixihxhi:ma kwaltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts863" TIME_SLOT_REF2="ts864">
                <ANNOTATION_VALUE>entó:s kwaltsi:n pochiktik ki:sa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts865" TIME_SLOT_REF2="ts866">
                <ANNOTATION_VALUE>kwaltsi:n pochiktik ki:sa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts868">
                <ANNOTATION_VALUE>*igual** ne:n kwesalmekat, yo:n se: kite..., kiti:tila:na ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts869" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>se: ki..., se: kiki:xtia n' e:wat kwaltsi:n ki:stiw, kwaltsi:n ihkó:n pahpankalaktok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts872">
                <ANNOTATION_VALUE>Pahpankalaktok yo:n nika:n nochi. Wa:n sepa ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts873" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>yo:n xi..., yo:n a:mo no:, a:mo no: wel semi se: kihto:s se: kiki:xtili:ti n' ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts876">
                <ANNOTATION_VALUE>Yo:n no: se: kihxi:tiw, se: kixi:n..., ika se: tateki:lo:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts877" TIME_SLOT_REF2="ts878">
                <ANNOTATION_VALUE>kwaltsi:n se: kixihxi:tiw, se: kixihxi:ntiw, se: kikwalti..., yo:n no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts879" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>no: kwaltsi:n se: kiewalowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts882">
                <ANNOTATION_VALUE>Se: kiewalowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts883" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>yo:n nijó:n a:mo n'mati kox kwali se: kikwelpachowa, pero yo:n se: kiewalowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>Se: kichi:wa ihkó:n se: kiewalowa wa:n se: kina:miktia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487" TIME_SLOT_REF1="ts887" TIME_SLOT_REF2="ts888">
                <ANNOTATION_VALUE>De ompa ke:mah, ompa se: kiso ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488" TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>Ompa se: kiso ya, nijo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts892">
                <ANNOTATION_VALUE>mochi:wa para se: ki..., kehe:witita:lia ya ne:n kowtsitsí:n wa:n se: kita:lia ya ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490" TIME_SLOT_REF1="ts893" TIME_SLOT_REF2="ts894">
                <ANNOTATION_VALUE>de i:xo:me, pero ne:n okseki a:mo, a:mo *igual siempre** wa:n yehwa yo:n neh nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts895" TIME_SLOT_REF2="ts896">
                <ANNOTATION_VALUE>niki:xmattok yo:n wa:n pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts897" TIME_SLOT_REF2="ts899">
                <ANNOTATION_VALUE>komo a:mo, ti..., ti..., *bueno** a:mo tiki..., tiki:xmattok sayoh de o:me taman, pos nika:n neh nimitsilihtok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts900" TIME_SLOT_REF2="ts903">
                <ANNOTATION_VALUE>wa:n ke:masá: ne:wí:n ti..., timoahsiskeh, ke:meh i:n nochi tikowtahnemih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495" TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>teh no: tiow ne: mokowtah wa:n neh no: niow para ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>nimitsne:xtili:s katí:n *o** nimits..., nimitska:wili:ti:w kalihtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497" TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts910">
                <ANNOTATION_VALUE>katí:n de n' ista:kkomekat de n' o:me,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>para tin..., ti..., tikmatis no:, para no: tikneltokas nikwi:kas se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>ihkó:n se:, se: takoto:n, seh se: takoto:n de e:yi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>De e:yi taman para ke:masá: ke:meh i:n no: tima:tachihchi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts918">
                <ANNOTATION_VALUE>tikchihchi:wa mochi:walis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>pos no: kwali a *de que** tikchi:wa *lucha** para tikchi:wa mochi:walis para mits...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503" TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts922">
                <ANNOTATION_VALUE>ika timotekipanohtok, ika ne: mah mitspale:wi no: kwali,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts923" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>pos no: ke:masá: no: kwali tikihto:s, pos nika:n ne:chne:xtilih i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>tatahtsi:n *o** ke:meh i:n, Anastacio Nicolás,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts928">
                <ANNOTATION_VALUE>yehwa i:n yeh ki:xmati de e:yi taman i:n poposokani,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507" TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts930">
                <ANNOTATION_VALUE>pos ekintsi:n niow nikte:mo:ti ne: nokowtah, ompa a:chá: onkas, ta: nikita *que** i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>e:wtok seki n' ike:span de n' kowit, xa: yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts933" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>Entó:s ompa ne: tikitas wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts936">
                <ANNOTATION_VALUE>n' ima:yo achi ma:..., ma:nehnextik, achi ma:pohpototik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts938">
                <ANNOTATION_VALUE>n' ima:i:ka:n wa:n okseki a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts939" TIME_SLOT_REF2="ts941">
                <ANNOTATION_VALUE>Yehwa yo:n neh nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts991" TIME_SLOT_REF2="ts994">
                <ANNOTATION_VALUE>A:mo wehweliw, nochi ihkó:n yetoya, taxi:koh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts1007" TIME_SLOT_REF2="ts1008">
                <ANNOTATION_VALUE>Pos yo:n chili:yoh *a veces** ke:meh, ke:meh kwowit takwa:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts1009" TIME_SLOT_REF2="ts1010">
                <ANNOTATION_VALUE>Nijo:n neh nikneltoka *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546" TIME_SLOT_REF1="ts1011" TIME_SLOT_REF2="ts1012">
                <ANNOTATION_VALUE>ahko ne:n, de pe:wa ihkó:n de n' we:weyak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts1013" TIME_SLOT_REF2="ts1014">
                <ANNOTATION_VALUE>wa:n ahko miak mochi:wa n' itsmol. Miak mots...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548" TIME_SLOT_REF1="ts1015" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>mochi:wa n' itsmol wa:n mo..., moma:tahta:lia ihkó:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts1017" TIME_SLOT_REF2="ts1018">
                <ANNOTATION_VALUE>sepa ihkó:n ahko mochi:wa ihkó:n de weyak, mela:wak wa:n sepa parahko sepa mochihkolowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550" TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1020">
                <ANNOTATION_VALUE>oso itech ne:n kowit motetekwinohtiw, motetekwinohtiw ihkó:n kikwitiw, motetekwinohtiw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts1021" TIME_SLOT_REF2="ts1022">
                <ANNOTATION_VALUE>*hasta** ahko, *hasta** ka:mpa, ka:mpa tamiti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts1023" TIME_SLOT_REF2="ts1024">
                <ANNOTATION_VALUE>Itech se: kowit ka:mpa tamiti a, ompa tami a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553" TIME_SLOT_REF1="ts1025" TIME_SLOT_REF2="ts1026">
                <ANNOTATION_VALUE>pero kwaltsi:n, ke:mansá: motetekwinohtiw itech n..., ke:meh ne: komohkó:n mokwi:kwi:ltia, mokwi:kwi:ltia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts1027" TIME_SLOT_REF2="ts1028">
                <ANNOTATION_VALUE>*hasta** ahsi ahko. Wa:n ne:n kwesalmekat pos *por eso** ke:meh tikihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555" TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1030">
                <ANNOTATION_VALUE>wetstok ihkó:n, pero se: kiewalowa no: kwaltia para ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556" TIME_SLOT_REF1="ts1031" TIME_SLOT_REF2="ts1032">
                <ANNOTATION_VALUE>wahkal, yo:n yewaltikeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1034">
                <ANNOTATION_VALUE>Yo:n yewaltikeh ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558" TIME_SLOT_REF1="ts1035" TIME_SLOT_REF2="ts1036">
                <ANNOTATION_VALUE>ihkó:n se: kiewalowa, a:mo se: kiposteki, *porque** yo:n eski tikihtowa xama:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1038">
                <ANNOTATION_VALUE>Xama:ni, pero a:mo nochi xama:ni, no: yetok sah yo:n kwesalmekat *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560" TIME_SLOT_REF1="ts1039" TIME_SLOT_REF2="ts1040">
                <ANNOTATION_VALUE>pos yo:n kwaltsi:n no: ta:tahmachyoh ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1042">
                <ANNOTATION_VALUE>Ta:tahmachyoh *porque** ihkó:n i..., ki:sa ne:n e:wat, kwaltsi:n pahpantekochtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562" TIME_SLOT_REF1="ts1043" TIME_SLOT_REF2="ts1044">
                <ANNOTATION_VALUE>Motehkochowa nika:n, nochi ihkó:n yowi ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563" TIME_SLOT_REF1="ts1045" TIME_SLOT_REF2="ts1046">
                <ANNOTATION_VALUE>mehmelaktik se: kiki:xtia n' e:wat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a564" TIME_SLOT_REF1="ts1047" TIME_SLOT_REF2="ts1048">
                <ANNOTATION_VALUE>yo:n ke:meh eskia motekochowa, tsa:tsaya:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565" TIME_SLOT_REF1="ts1049" TIME_SLOT_REF2="ts1050">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n se: kikwi, ta:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566" TIME_SLOT_REF1="ts1051" TIME_SLOT_REF2="ts1052">
                <ANNOTATION_VALUE>pos yehwa yo:n neh nikmattok ne:n ka:sá: ika ne:wí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1054">
                <ANNOTATION_VALUE>nikita wa:n nikwa:lkwi ihkó:n. Ke:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568" TIME_SLOT_REF1="ts1055" TIME_SLOT_REF2="ts1056">
                <ANNOTATION_VALUE>i:n tama:chihchi:walis pos miak taman *siempre**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569" TIME_SLOT_REF1="ts1057" TIME_SLOT_REF2="ts1058">
                <ANNOTATION_VALUE>kichi:wah, ke:meh yo:n kichi:wah ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570" TIME_SLOT_REF1="ts1059" TIME_SLOT_REF2="ts1060">
                <ANNOTATION_VALUE>*trenzado** kiliah, yo:n i:xtapal kichi:wah, seki yo:n ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571" TIME_SLOT_REF1="ts1061" TIME_SLOT_REF2="ts1062">
                <ANNOTATION_VALUE>kima:..., kima:te:kpa:ntiuweh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572" TIME_SLOT_REF1="ts1063" TIME_SLOT_REF2="ts1064">
                <ANNOTATION_VALUE>wa:n pos yehwa yo:n kihilpihtiuweh, a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573" TIME_SLOT_REF1="ts1065" TIME_SLOT_REF2="ts1066">
                <ANNOTATION_VALUE>a:mo, a:mo posteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574" TIME_SLOT_REF1="ts1067" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>Wa:n pos yehwa yo:n ne:n, neh niki:xmattok sah yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575" TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1071">
                <ANNOTATION_VALUE>de yo:n kwomekat a:mo, a:mo wel *más** ni..., nimitsili:ti *porque** yehwa sah yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629" TIME_SLOT_REF1="ts1179" TIME_SLOT_REF2="ts1182">
                <ANNOTATION_VALUE>A:, wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638" TIME_SLOT_REF1="ts1199" TIME_SLOT_REF2="ts1200">
                <ANNOTATION_VALUE>Pos nijó:n yehwa yo:n neh no: nikmattok *de que**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a639" TIME_SLOT_REF1="ts1201" TIME_SLOT_REF2="ts1202">
                <ANNOTATION_VALUE>nijo:n neh nikmattok *de que cuando** ihkó:n yowi a, ihkwí:n mowila:na ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a640" TIME_SLOT_REF1="ts1203" TIME_SLOT_REF2="ts1204">
                <ANNOTATION_VALUE>Yo:n tikiliah poposokani *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a641" TIME_SLOT_REF1="ts1205" TIME_SLOT_REF2="ts1206">
                <ANNOTATION_VALUE>*cuando** tikchi:wah ihkó:n tikwelpachowah ki:sa pané: yo:n se: ichihchi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a642" TIME_SLOT_REF1="ts1207" TIME_SLOT_REF2="ts1208">
                <ANNOTATION_VALUE>Se: ichihchi: ki:sa *porque, por eso** tikiliah poposokani *porque** ihkwí:n *cuando** se: kikwelpachowa panki:sa ne:n cho:kil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643" TIME_SLOT_REF1="ts1209" TIME_SLOT_REF2="ts1210">
                <ANNOTATION_VALUE>ke:meh eskia poposoka, poposoka ka:mpa se: kikwelpachowa, se: kiki:xtilia n' ikomekayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a644" TIME_SLOT_REF1="ts1211" TIME_SLOT_REF2="ts1212">
                <ANNOTATION_VALUE>*por eso** tikilia poposokani, *porque** ke:yeh, ki:sa ke:meh eskia se: ichihchi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a645" TIME_SLOT_REF1="ts1213" TIME_SLOT_REF2="ts1214">
                <ANNOTATION_VALUE>Yo:n se: ichihchi nijó:n yehwa yo:n tikiliah poposokani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646" TIME_SLOT_REF1="ts1215" TIME_SLOT_REF2="ts1216">
                <ANNOTATION_VALUE>Poposokani wa:n ihkwí:n mowila:ntiw</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a647" TIME_SLOT_REF1="ts1217" TIME_SLOT_REF2="ts1218">
                <ANNOTATION_VALUE>wa:n ka:mpa nehkwí:n mopanwila:nati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a648" TIME_SLOT_REF1="ts1219" TIME_SLOT_REF2="ts1220">
                <ANNOTATION_VALUE>ta:ká:n yetok se: kwowit ne:wí:s pos ompa moma:yo:tia ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a649" TIME_SLOT_REF1="ts1221" TIME_SLOT_REF2="ts1222">
                <ANNOTATION_VALUE>yetok se: n' i..., n' ima:y ne:n kwowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a650" TIME_SLOT_REF1="ts1223" TIME_SLOT_REF2="ts1224">
                <ANNOTATION_VALUE>wa:n ompa moma:yotia ya, yowi a itech oksé: kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a651" TIME_SLOT_REF1="ts1225" TIME_SLOT_REF2="ts1226">
                <ANNOTATION_VALUE>Itech oksé: kowit ihkó:n nochi mo..., mowi:wila:na ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a652" TIME_SLOT_REF1="ts1227" TIME_SLOT_REF2="ts1228">
                <ANNOTATION_VALUE>Ka:sá: ika ye:k miak ihkó:n ima:yo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653" TIME_SLOT_REF1="ts1229" TIME_SLOT_REF2="ts1230">
                <ANNOTATION_VALUE>mowi:wila:na ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a654" TIME_SLOT_REF1="ts1231" TIME_SLOT_REF2="ts1232">
                <ANNOTATION_VALUE>yo:n no:chi, nochi, nochi kwaltia ne:n i..., n' ima:tako:yo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a655" TIME_SLOT_REF1="ts1233" TIME_SLOT_REF2="ts1234">
                <ANNOTATION_VALUE>Nochi kwaltia n' ima:ta..., kiliah n' ima:tako:yo *porque** pihpitsa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656" TIME_SLOT_REF1="ts1235" TIME_SLOT_REF2="ts1236">
                <ANNOTATION_VALUE>A:mo *porque** tikiliah ima:tako:yo de okseki kowit. A:mo, nochi de poposokani pero mehmela:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a657" TIME_SLOT_REF1="ts1237" TIME_SLOT_REF2="ts1238">
                <ANNOTATION_VALUE>Axka:n de ne:n ikwa:pan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658" TIME_SLOT_REF1="ts1239" TIME_SLOT_REF2="ts1240">
                <ANNOTATION_VALUE>yo:n ima:taka:yo a:mo no: nochi ye:kkwaltia ok *porque** chika:wayati a n' ahko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a659" TIME_SLOT_REF1="ts1241" TIME_SLOT_REF2="ts1242">
                <ANNOTATION_VALUE>N' ahko chika:wayati a, ka:mpa ne: tikihtowa se: yowih [i]wa:n imomá:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660" TIME_SLOT_REF1="ts1243" TIME_SLOT_REF2="ts1244">
                <ANNOTATION_VALUE>kwaltsi:n se: yoweh de selik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661" TIME_SLOT_REF1="ts1245" TIME_SLOT_REF2="ts1246">
                <ANNOTATION_VALUE>de selik, pero ahko *de que** moma:ma:yo:ti:ti a n' oksé:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a662" TIME_SLOT_REF1="ts1247" TIME_SLOT_REF2="ts1248">
                <ANNOTATION_VALUE>ihkó:n moma:ma:yo:tia ya chika:waya ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663" TIME_SLOT_REF1="ts1249" TIME_SLOT_REF2="ts1250">
                <ANNOTATION_VALUE>Chika:waya ya ne:n, yehwa yo:n neh nikmattok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664" TIME_SLOT_REF1="ts1251" TIME_SLOT_REF2="ts1252">
                <ANNOTATION_VALUE>ihkó:n ka:sá: ika yowi ihkó:n wa:n ka:sá: ika ihkó:n moma:pampilo:ti a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665" TIME_SLOT_REF1="ts1253" TIME_SLOT_REF2="ts1254">
                <ANNOTATION_VALUE>wa:n ke:mah yetok se: kowit ihkó:n, ompa moma:yo:tia sepa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666" TIME_SLOT_REF1="ts1255" TIME_SLOT_REF2="ts1256">
                <ANNOTATION_VALUE>Milpihtiw ke:meh yo:n tikihtowa n' ima:yo ke:meh ne:n witskilit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667" TIME_SLOT_REF1="ts1257" TIME_SLOT_REF2="ts1258">
                <ANNOTATION_VALUE>Pos no: ke:meh witskilit wa:n ke:meh n' ayohtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668" TIME_SLOT_REF1="ts1259" TIME_SLOT_REF2="ts1260">
                <ANNOTATION_VALUE>N' ayoh no: *igual**, no: ka:mpa no: ihkó:n mowila:ntiw,[...]ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669" TIME_SLOT_REF1="ts1261" TIME_SLOT_REF2="ts1262">
                <ANNOTATION_VALUE>wa:n no: milpihtiw, *igual** ne:n witskilit *porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670" TIME_SLOT_REF1="ts1263" TIME_SLOT_REF2="ts1264">
                <ANNOTATION_VALUE>witskilit yeh no: moma:yo:tihtiw ke:meh eskia kilpihtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671" TIME_SLOT_REF1="ts1265" TIME_SLOT_REF2="ts1266">
                <ANNOTATION_VALUE>Teihsá: xiwtsí:n ihkó:n kilpihtiw para ompa mochika:wilihtiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672" TIME_SLOT_REF1="ts1267" TIME_SLOT_REF2="ts1268">
                <ANNOTATION_VALUE>Axka:n yo:n, yo:n ka:mpa kilpihtiw ke:meh eskia ika yo:ltok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a673" TIME_SLOT_REF1="ts1269" TIME_SLOT_REF2="ts1270">
                <ANNOTATION_VALUE>komo tikoto:nilih yo:n ima:yo ihkwi:ntsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674" TIME_SLOT_REF1="ts1271" TIME_SLOT_REF2="ts1272">
                <ANNOTATION_VALUE>komo tikechkoto:n pos wa:ki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675" TIME_SLOT_REF1="ts1273" TIME_SLOT_REF2="ts1274">
                <ANNOTATION_VALUE>Yo:n ke:meh eskia y..., yehwa ompa moyo:litihtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
