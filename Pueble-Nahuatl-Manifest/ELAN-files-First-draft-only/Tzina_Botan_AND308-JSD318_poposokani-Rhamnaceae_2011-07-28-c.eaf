            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a903" TIME_SLOT_REF1="ts1745" TIME_SLOT_REF2="ts1747">
                <ANNOTATION_VALUE>Yehwa sah neh nikmati wa:n yehwa sah neh nimitsyo:lchika:wa ika.</ANNOTATION_VALUE>
