            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a697" TIME_SLOT_REF1="ts1317" TIME_SLOT_REF2="ts1318">
                <ANNOTATION_VALUE>nochi mowi:wila:na ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698" TIME_SLOT_REF1="ts1319" TIME_SLOT_REF2="ts1320">
                <ANNOTATION_VALUE>ke:masá: se: kita sake:ra e:yi kwowit ihkó:n ka:mpa mowi:wila:na, ta: we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699" TIME_SLOT_REF1="ts1321" TIME_SLOT_REF2="ts1322">
                <ANNOTATION_VALUE>We:weyak, xa: tikita ka:nsá: ika nijó:n ihkó:n mo... mote:..., mowi:wila:na, mowi:wila:na,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700" TIME_SLOT_REF1="ts1323" TIME_SLOT_REF2="ts1324">
                <ANNOTATION_VALUE>wa:n *hasta** mahsi *siquiera** e:yi kwowit,</ANNOTATION_VALUE>
