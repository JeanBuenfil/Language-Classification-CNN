        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>Ista:k. *Ándale**.</ANNOTATION_VALUE>
