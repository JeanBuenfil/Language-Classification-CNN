        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts666">
                <ANNOTATION_VALUE>Neh nikchihchi:wak yo:n koy..., koyo:ikpal.</ANNOTATION_VALUE>
