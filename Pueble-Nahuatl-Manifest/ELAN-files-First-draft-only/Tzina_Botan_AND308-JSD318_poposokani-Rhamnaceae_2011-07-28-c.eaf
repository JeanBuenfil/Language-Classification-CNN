        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a891" TIME_SLOT_REF1="ts1717" TIME_SLOT_REF2="ts1718">
                <ANNOTATION_VALUE>niman te:chelna:mikiskeh ya no:,</ANNOTATION_VALUE>
