        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>para mah kochi, mah a:mo ihsa.</ANNOTATION_VALUE>
