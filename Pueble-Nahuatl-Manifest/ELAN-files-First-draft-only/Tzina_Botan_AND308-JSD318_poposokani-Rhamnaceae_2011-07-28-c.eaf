        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts974" TIME_SLOT_REF2="ts975">
                <ANNOTATION_VALUE>Yo:n *más** takwa:wak, ka..., kachi takwa:wak *que gue..., que**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts976" TIME_SLOT_REF2="ts977">
