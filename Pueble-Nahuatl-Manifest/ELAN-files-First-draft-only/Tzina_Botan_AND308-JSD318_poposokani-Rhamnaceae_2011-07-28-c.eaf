        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>Wa:n *desde** yo:n ihwa:k *hasta** a:man nikwa:ltohtoka i:n chi:walis,</ANNOTATION_VALUE>
