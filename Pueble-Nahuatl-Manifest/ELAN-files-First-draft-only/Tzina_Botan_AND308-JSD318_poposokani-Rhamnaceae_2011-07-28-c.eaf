        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a901" TIME_SLOT_REF1="ts1740" TIME_SLOT_REF2="ts1743">
                <ANNOTATION_VALUE>Pos ihkó:n sah.</ANNOTATION_VALUE>
