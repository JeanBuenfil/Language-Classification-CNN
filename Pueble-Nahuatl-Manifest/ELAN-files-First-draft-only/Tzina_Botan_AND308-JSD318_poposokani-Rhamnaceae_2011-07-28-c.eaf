        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>pos miak taman, miak taman welih ya ne:n tokni:wa:n,</ANNOTATION_VALUE>
