        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>Niksahsa:loh yo:n kwowit,</ANNOTATION_VALUE>
