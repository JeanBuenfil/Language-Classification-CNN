        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>Nijó:n no: ompa de kito:tope:wah, ihkó:n kwaltsi:n kine:nemi:ltiah, mopa:patah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>kwaltsi:n ihkó:n kine:nemi:ltiah ika nijó:n, kitake:ntiah ika n' ia:ya:w,</ANNOTATION_VALUE>
