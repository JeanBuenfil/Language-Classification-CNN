        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a682" TIME_SLOT_REF1="ts1287" TIME_SLOT_REF2="ts1288">
                <ANNOTATION_VALUE>e:yi de tama:n ihkó:n de ika kilpihtiw,</ANNOTATION_VALUE>
