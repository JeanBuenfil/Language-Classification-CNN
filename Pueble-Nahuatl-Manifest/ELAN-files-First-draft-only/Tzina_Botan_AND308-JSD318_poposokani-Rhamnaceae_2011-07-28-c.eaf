        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>wa:n ompa ya n' timopale:wi:skiah. Wa:n timopale:wiah *porque** neh nikchihchi:wka.</ANNOTATION_VALUE>
