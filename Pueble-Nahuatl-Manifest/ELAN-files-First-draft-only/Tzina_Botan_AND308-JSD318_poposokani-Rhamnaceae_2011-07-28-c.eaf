        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>tokowtati:l oso ne:wí:n t'te:te:mayah,</ANNOTATION_VALUE>
