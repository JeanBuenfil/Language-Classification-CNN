        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>*Porque** neh nima:tachihchi:w.</ANNOTATION_VALUE>
