            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>Yo:n pile:walo:ni, *porque** kiliah pile:walo:ni *porque** ika ki...., kine:nemi:ltiah, ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>kito:tope:wah, nijó:n kito:tope:wah yo:n pili para mah,</ANNOTATION_VALUE>
