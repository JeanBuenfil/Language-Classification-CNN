        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>i..., neh no: ni:xpeta:nik ke:man katka nipili i:pa ne:chilia:ya nowe:iná:n mah nikwiti xo:me:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Pero i:pa yeha yo:n xo:me:t, a:mo ih... Yeha, yeha. Neli.</ANNOTATION_VALUE>
