        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>Antó:s no: tikmattok yeha yo:n xo:me:t na:no. ¿Wa:n yo:n para toni n' kwaltia ne:n ikowyo?, teh tikwi n' i..., ke:man tami a yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>ke:man we:i, we:ikowit mochi:wa wa:n se: kima:teki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>nochi t'tekilihtiw n' ima:xiwyo, ata telwehkapantik wa:n telpitsaktik moka:wa.</ANNOTATION_VALUE>
