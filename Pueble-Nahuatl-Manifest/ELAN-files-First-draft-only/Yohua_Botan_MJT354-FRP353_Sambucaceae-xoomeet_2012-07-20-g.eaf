        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>¿Wa:n kowit para toni tik..., para ton teh tikwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts284">
