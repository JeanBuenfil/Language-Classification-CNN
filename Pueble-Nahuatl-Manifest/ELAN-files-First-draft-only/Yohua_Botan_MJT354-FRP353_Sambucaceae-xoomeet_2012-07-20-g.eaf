        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>pero yeha yo:n xo:me:t *siempre** tel..., tel..., teltayeka:ntok, telno:ya:mpa nikaki neh no: wa:n</ANNOTATION_VALUE>
