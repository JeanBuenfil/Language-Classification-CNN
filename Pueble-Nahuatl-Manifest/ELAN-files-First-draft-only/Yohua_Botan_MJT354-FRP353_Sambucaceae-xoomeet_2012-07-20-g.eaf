        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>i..., xo:chiowa wa:n ta:ki ne:n i..., xo:chit ata ihista:k wa:n ne:n i:n</ANNOTATION_VALUE>
