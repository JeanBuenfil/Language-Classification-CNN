        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>Yo:n a:mo mone:neki, yo:n tel..., tel...</ANNOTATION_VALUE>
