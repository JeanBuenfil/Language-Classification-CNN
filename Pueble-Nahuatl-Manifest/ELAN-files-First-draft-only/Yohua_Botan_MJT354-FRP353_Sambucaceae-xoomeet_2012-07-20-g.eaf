        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>Ke:mah, a:chá: ta: komohkó:n neli ne:</ANNOTATION_VALUE>
