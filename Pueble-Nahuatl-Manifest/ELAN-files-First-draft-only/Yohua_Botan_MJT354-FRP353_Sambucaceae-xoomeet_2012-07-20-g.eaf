        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>wa:n no: nikitak a, tel no:ya:mpa kikwitih xo:me:t, ka:mpa tiá:s se: ihkó:n *que, que** nikaki neh moilwiah xo:me:t,</ANNOTATION_VALUE>
