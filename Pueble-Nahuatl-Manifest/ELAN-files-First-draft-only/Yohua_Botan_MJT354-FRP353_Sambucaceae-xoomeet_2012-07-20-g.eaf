        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Yo:n i:pa iwki neli, mah se: ki...</ANNOTATION_VALUE>
