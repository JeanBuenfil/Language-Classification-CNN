        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>Pos ihkó:n kihtowah awakatsitsi:n yo:ni, pos yo:n a:mo, a:mo we:lik pero kwaltias para kowtati:l *o** para teihsá: kitatekiwtiah para se: i...,</ANNOTATION_VALUE>
