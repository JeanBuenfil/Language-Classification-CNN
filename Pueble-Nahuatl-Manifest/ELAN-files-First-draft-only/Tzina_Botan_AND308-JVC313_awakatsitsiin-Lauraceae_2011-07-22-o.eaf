        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>n' i..., n' itapal tak ne:n</ANNOTATION_VALUE>
