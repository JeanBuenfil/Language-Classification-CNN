        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Mm, se: taktson wa:n ika chikwe:i, chikwe:i xi..., chikwe:i xiw..., chikwe:i xiwit wa:n, chik..., chikwe:i wa:n kaxto:lomo:me xiwit.</ANNOTATION_VALUE>
