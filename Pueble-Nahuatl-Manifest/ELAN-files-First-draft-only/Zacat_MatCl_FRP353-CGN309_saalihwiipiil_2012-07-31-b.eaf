        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Pos nehjó:n a:mo wel nimitsilia ni..., nimitskwi:li:s *porque** neh, neh no: nimomachtih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>No: nimomachtih tepitsi:n sikie:ra para to..., toga:stoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Pos a:mo nimoyo:le:was, sikie:wa nehjó:n mah tikitaka:n ke:ní:w ne:n tachihchi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Ke:mah, ke:ní:w tikchi:wa teh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Pos nikwelita pero neli yehwa n' ipati:w a:mo te:chahsi.</ANNOTATION_VALUE>
