        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Neh niki..., i:n sa:lih *porque** i:n neli mosa:lohtiw ke:meh yo:n pehpech se: kima:wi:pa:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>Wa:n i:n neh nikilwia, i:n, i:n teh tikilia te:sa:lih, neh nikilwia ne: i..., i:xmahtsa:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>*Porque** nika:n xikita sah ke:man se: tachihchi:wa oho:me motetsi:lowa wa:n nika:n ke:man sepa itech ohpa titapehpenati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Nika:n mo..., moi:xmahtsa:lohtiw a n' *hilo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>*por eso** neh nikilwia i:xmahtsa:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
