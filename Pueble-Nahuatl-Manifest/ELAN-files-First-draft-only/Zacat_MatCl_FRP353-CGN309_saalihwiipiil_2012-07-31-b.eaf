        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Pos tehwa:n te:chmachti nehjó:n siwa:t se:, siwa:t ... *Primero** se: te:chmachti:skia mono:tsaya.</ANNOTATION_VALUE>
