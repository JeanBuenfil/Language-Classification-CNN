        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>Ampó:n s..., ampó:n nimitsachkawi:ko ya wa:n *este cuando** tikpias pa:kilis welis nimitsne:xtili:s ma:tachihchi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>Entó:s timonawatiah na:no, mah niow sepa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>*Porque** timotaskeh se: to:nal, a:mo n'mati ke:maniá:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>Entó:s ke:man sepa niwi:tsa xa: tine:chkowili:s a nowi:pi:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Wa:n ihwa:k nimi..., n'wa:lkwis sepa se: nowi:pi:l *más** kwaltsi:n wa:n tikwelitas. Xa: tikwelitas tein noma:tachihchi:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Xa: ihwa:k ok timoyo:le:was tine:chkowili:s, mm. We:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>A:mo teisá:, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>Mm, tasohka:matik, mo..., moto:ka:i pero xa: nikelka:was sepa, mm. Mah niow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
