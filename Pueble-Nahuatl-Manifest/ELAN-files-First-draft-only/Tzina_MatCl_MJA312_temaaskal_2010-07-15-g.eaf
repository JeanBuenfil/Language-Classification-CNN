            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts765" TIME_SLOT_REF2="ts767">
                <ANNOTATION_VALUE>Se: *matrona**.</ANNOTATION_VALUE>
