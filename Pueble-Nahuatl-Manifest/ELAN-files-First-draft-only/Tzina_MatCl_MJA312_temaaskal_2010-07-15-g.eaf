        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>Ke:mah, ke:meh yo:n *cuando** kiitah inimpiliwa:n ke kahkalanemih inimpi:piltsitsi:n nopi:pilwa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
