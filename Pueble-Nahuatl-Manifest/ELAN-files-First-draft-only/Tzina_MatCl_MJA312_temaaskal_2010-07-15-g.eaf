            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts676">
                <ANNOTATION_VALUE>Ihxo:ch. Pos nehjó:n ne: ke:man neli ke:meh nimitsilihtok ke a:mo ke:man nikiwi:kak neh tapahtilo:ya:n nopi:pilwa:n,</ANNOTATION_VALUE>
