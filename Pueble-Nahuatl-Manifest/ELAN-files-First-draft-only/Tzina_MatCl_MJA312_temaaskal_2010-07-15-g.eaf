        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Entó:s pos no: yehwa yo:ni ne:n ika se: kimpahtia ke:meh nimitsilwihtoya, mm.</ANNOTATION_VALUE>
