        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Pos *sólo** mm, pos ka:n tei yehwa ne:n n' kalanemi:lis wa:n ne: komo kinkwik yo:n mihmikilo:tataxis</ANNOTATION_VALUE>
