        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts645" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>Wa:n nik..., nikta:lilia:ya ne:n yehwa ya n' a:ko:kohxiwit wa:n n'ta:lilia:ya no: de nika:n wa:n i:n i:ka:mpa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
