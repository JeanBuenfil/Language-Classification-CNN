        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>Entó:s pos niktsetselowa sah, n'tsetselowa sah, nik..., nik..., yehwa sah yo:ni wa:n kina:mikia, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts690">
                <ANNOTATION_VALUE>A:mo ok, seki ke:mah pero a:mo nochi ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>Ke:mah *porque** pos ompa kinimakah siempre pahti, *eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>Nika:n ka:n, nika:n mahyá: a:mo, a:mo n' a:kah nikita mah kimolo:nti ok yo:n xiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>*hasta** neh nopi:pilwa:n a:mo. Ke:mah yo:n, yo:n xiwit de yo:n o:mikilit ke:mah kinimolo:ntiliah ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>pero yehwa sah yo:ni. Pero ke:meh i:n nimitsilwih xiw..., xiw..., [xiw]it de yo:n witsti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>a:mo ok. *Solamente** o:mikilit, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>*Hasta** pilimeh ika kina:ltiah ok pero yehwa yo:n o:mikilit, [yeh]wa sah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>Pero teisá: xiwpahmeh a:mo ok, *bueno** teisá: de yo:n witsmeh a:mo ok *porque** nikita ke:meh yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>noxwi:w a de ne:n Cheli ipili ka:n, ka:n teh mah ka:lti:skiah ika xiwit ok, *eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>Ika yo:n nimolia ekintsi:n a:mo kina:ltiah ok ika xiwit semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>Ke:meh yo:n o:mikilit ke:mah ika kina:ltiah ok, de nemih pilimeh *hasta** siwa:meh ika ma:ltiah ok. Pero yehwa sah yo:ni, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts716">
                <ANNOTATION_VALUE>Kimatih ke pahti tak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts718">
                <ANNOTATION_VALUE>pero a:mo kikwih ok *porque** kihto:snekih pos ne:pa yowih tapahti:lo:ya:n ya, ompa kinimakah pahti a, nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>Entó:s a:mo kikwih ok yo:ni, *eso**, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>Nochi ompa kinin..., kinimakah ya ne:n i:n teisá: nehjó:n, teisá: ne:n i:n pahti a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>ke:meh yo:n *ampolletas**, nochi yo:n ompa kiniwa:lmakah ya, tein tai:skeh nochi teisá: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>Entó:s de n' pahti de *natural** ekintsi:n a:mo kikwih ok, mm.</ANNOTATION_VALUE>
