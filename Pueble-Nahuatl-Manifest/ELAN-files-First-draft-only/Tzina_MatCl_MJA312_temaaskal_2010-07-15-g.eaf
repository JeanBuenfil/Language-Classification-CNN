            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>Pos yehwa yo:n tik..., se: *kilecha:rowa**, se: ki..., se: kichi:chiwalwia, tikiliah n' *mexicano**, ke:mah.</ANNOTATION_VALUE>
