        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>Moka:wa ke:meh se: ihkó:n de *tacita** tehkotok.</ANNOTATION_VALUE>
