        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>Wa:n de n', de nika:n i:n nikinkwa:ahketstipa:ka para ne: no: ika a:t xohxowik para kika:wa ya ne:n toto:nik, ke:mah.</ANNOTATION_VALUE>
