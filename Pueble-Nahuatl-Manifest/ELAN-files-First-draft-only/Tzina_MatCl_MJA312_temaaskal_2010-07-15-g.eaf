        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>Nikinte:tetekwinowa ika a:ya:t, ehekai:xko ihkó:n ni:nipaka tikwih. Nika:n neh nikwi wa:n nikwi n' a:ya:t *ipunta**.</ANNOTATION_VALUE>
