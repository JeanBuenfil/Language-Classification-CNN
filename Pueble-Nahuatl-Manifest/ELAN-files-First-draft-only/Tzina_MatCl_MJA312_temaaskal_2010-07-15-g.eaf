        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>I:pa sayoh motemayah ne:n siwa:meh *o** taya:yah teisá: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Ta:ka:n tikneki kwali 'te:chtapowi:s katí:n xiwmeh taya:yah wa:n ke:ní:w kichihchi:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>Wa:n sa:te:pan de nemia ya n' pili no: taya:yah xiwpahmeh *o** iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>Wa:n ka:nachi to:nalika tai:toyah yo:n pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>Para tima:ltia:ya no: mitsmanilia:yah xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Ye:wa tikihtowa:ya ika a:mo, teh a:mo timotokia:ya tikote:noh. Ka:n kwali se: siwa:t tein, *este**, yekin, ek...,, *este**, aya:mo wehka:w kipiak pili ne:n mah motoki tikote:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Ta:ka:n tikelna:mi ok teisá: de yehwa yo:n motemah *o** yehwa i:n, *este**, pili kiskaltiah, kwali tikihto:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>Ta:ka:n, *este**, tikelna:mikis teisá: kokolis ok tein kinkwi ne: pilkone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts602">
                <ANNOTATION_VALUE>¿Ke:ní:w mono:tsa yo:n kokolis tein yo:n, *este**, no: kinkwi pilimeh ihwa:k se:, *este**, te:na:n kawa:ntok wa:n kichi:chitia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>¿Oksé: kokolis tein kwali kintekipacho:s ne:n pilimeh wa:n ke:ní:w se: kimpahtia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>¿Toto:nik ke:ní:w se: kipahtia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>Tikihtowa:ya tikin..., tikinime:tspa:ka, ika toni tikimetspa:kaya?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>Ta:ka:n, *este**, se: pili kikwi ihxo:ch, ¿Toni ne:n kwali se: kimaka?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts683">
                <ANNOTATION_VALUE>*Bueno pues, este**, xa: teisá: tikelna:mikis ok de yehwa ne:n tein ekin timonohno:tstoyah de kokolis de pilimeh *o** de yehwa i:n, *este**...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>ke:yeh t..., tehwa:tsi:n tiki:xehekowa ke ika ekintsi:n pos, *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>ox nohma kikwih i:n xiwpahmeh siwa:meh, ma:ski tikihtowa yowih, *este**, tapahti:lo:ya:n pero mokepah ox nohma kikwih i:n xiwmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>¿Ke:yeh tiki:xehekowa ke a:mo kikwih ok i:n xiwit, ka:n kimatih ke pahti *o** a:mo kinekih sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>Ye:wa tikihtowa:ya ika pos *bueno**, ne: ke:man nochi, *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>nochi:n kinitayah ne:n siwa:meh seki na:nahmeh, ¿Ekintsi:n a:mo, ka:n okachi a:kin, *este**, siwa:ita ok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>Ekintsi:n kwali tikihto:skeh pos nochi ne:n siwa:meh a:mo, a:mo wel, *este**, kipale:wi:s oksé: siwa:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>¿Ke:meh itech katí:n xola:lmeh yetokeh ok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>Ta:ka:n, *este**, tikelna:miki, *bueno** tikmattok, *este**, ke:meh katí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts762" TIME_SLOT_REF2="ts764">
                <ANNOTATION_VALUE>ton chi:walis kichi:wa *pues, este**, se: siwa:t tein siwa:ita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts768" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>¿Ta:ka:n teisá: tikelna:miki ok oso nochi a?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts805">
                <ANNOTATION_VALUE>Nochi a. Entó:s, *este**, xite:chili moto:ka:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts810" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>¿Ka:nachi xiwit tikpia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>¿Wa:n xola:l ka:mpa tiwa:le:w?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts822" TIME_SLOT_REF2="ts824">
                <ANNOTATION_VALUE>*Bueno**, pos tasohka:matik miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
