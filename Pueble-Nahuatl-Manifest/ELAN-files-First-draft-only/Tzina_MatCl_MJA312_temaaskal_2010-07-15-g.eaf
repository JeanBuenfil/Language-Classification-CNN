            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts784">
                <ANNOTATION_VALUE>komo kwalka:n pos ki:ste:wa, yowi tapa:kati ok *porque antes** tapa:kayah nochi kowtah, *eso**</ANNOTATION_VALUE>
