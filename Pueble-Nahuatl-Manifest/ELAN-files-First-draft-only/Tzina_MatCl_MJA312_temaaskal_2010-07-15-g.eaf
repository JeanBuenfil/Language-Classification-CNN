        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts749" TIME_SLOT_REF2="ts750">
                <ANNOTATION_VALUE>Wa:n *matrona** a:mo no: kineki kipias [ih]kó:n se: *compromiso** de yo:ni. Entó:s mejó:r pos ompa yowi a, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>Ompa ya kwi:kah ya ne:n kokoxkeh, mm. Wa:n ekintsi:n mahyá:, we:noh yetokeh pero tein nika:n i:n San Miguel a:mo semi n' a:kah ok.</ANNOTATION_VALUE>
