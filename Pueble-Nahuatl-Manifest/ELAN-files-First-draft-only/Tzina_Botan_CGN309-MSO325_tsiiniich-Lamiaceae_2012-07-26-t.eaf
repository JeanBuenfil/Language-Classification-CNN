        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>A:, no: moketsa ika. Pos neh nikmattok *que** no: kwali komo yo:n pilimeh ata i:ksá: yo:n moyo:kolia ata kinkwi kokomeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Yo:n kikwi kokomeh n'mattok *que** no: kwali nejó:n mah se: kimana wa:n mah ika se:..., mah ika se: kini:xpa:kili ka:mpa yo:n mochi:wa yo:n kokotsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>wa:n yehwa yo:n ixiwyotsi:n ni..., ata yo:n ixiwyo nikilia neh ata pané:, pané: wihwitstik. Nochi ata nikilia neh mahyá: n..., xaxakachtik ne:n ixiwyotsi:n, mahsi n' chanampilo:l ixiwyo, pero yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>pero yeh i:n chanampilo:l ixiwyo nikilia neh ata yeh potoxtik wa:n yeh wihwitstik ne: nejó:n ixiwyotsi:n wa:n xteki ata ihkó:n se: koli:nia pero ye:k ahwia:k, ye:k ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Ke:mah, wa:n yehwa yo:n n'mattok *que** se: kimana mah se:, mah se: kmolo:nti ika se: ko:ntsí:n mah se: kimolo:nti wa:n ke:mah... Ke:mah, mah ne:pa se: kiketsa mah se:wi tepitsi:n, ke:mah ke:meh se: taxi:ko:s nikilia neh ke:mah mah ika se: kipa:ka ya n' kokotsi:ni,</ANNOTATION_VALUE>
