        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>Tikihtowa ke e:yi powal wa:n kaxtol *hilo** tik...,</ANNOTATION_VALUE>
