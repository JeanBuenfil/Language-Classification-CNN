        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Na:nah es..., tikihtowa tehwa:tsi:n tiweli tikihkiti ne: wi:pi:lmeh, ilpikameh. Xa: no: tiweli, a:mo nikmati.</ANNOTATION_VALUE>
