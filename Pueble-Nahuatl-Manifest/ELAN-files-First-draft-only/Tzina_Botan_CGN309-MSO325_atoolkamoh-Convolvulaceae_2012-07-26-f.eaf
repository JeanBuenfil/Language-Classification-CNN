        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>Iw..., iwki tsope:k a. Ke:mah, tsope:k a iwki. ¿Wa:n de yo:n ato:l tikchi:waya no: tikpaya:naya n' tixti *o** tik..., ti..., tixti alaxtik a tikwia?</ANNOTATION_VALUE>
