        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>A:, pos a:mo tikpaya:naya, a:, pos neli ta:taman se: kichi:wa, *porque** neh nejó:n, neh no: nikchi:waya yo:ni, neh nikpaya:naya. Neh n'paya:naya nextamal neli ke:meh yo:n neli. A:, nochipa ala..., tikwi. A:, pos nochi tein ne:n takwe:ch..., takwe:cholo:ya:n ya n' tikwi n' teh n' tixti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>A:, a:mo tikpaya:na. A:, pos neli, a:mo neh nikpaya:naya, ke:meh yo:n *cuando** n'chi:waya neh nejó:n nikpaya:naya, ke:meh yo:n neli niketsas nexko:mit totsoktsi:ni wa:n</ANNOTATION_VALUE>
