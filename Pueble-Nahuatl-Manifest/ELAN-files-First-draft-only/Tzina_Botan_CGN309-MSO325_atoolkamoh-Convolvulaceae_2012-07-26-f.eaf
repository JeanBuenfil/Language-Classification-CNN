        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>yehwa yo:n neli nikpaya:naya no: wa:n ke.mah no: nik..., no: niki:xkwi a ke:meh yo:n pachato:l i:pa se: kichi:wa. ke:mah wa:n nejó:n nik..., niki:xtilia neli wa:n ompa yehwa yo:n nikwe:chowaya no: n' kamohtsí:n nik..., kwaltsi:n niktehteki ihkó:n ika, ika nejó:n tatehteki:lo:ni,</ANNOTATION_VALUE>
