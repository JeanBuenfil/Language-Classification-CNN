            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Mm, yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Yehwa ya, yehwa ya yo:n. Yehwa, yehwa, yehwa ya neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Yehwa ya neli wa:n nikihtowa neh para ihkó:n pos se: ki..., *mientras** se: kitsakwilia wa:n oksentaman pahti sepa se: kite:mowa para se: mota:lilia, yo:n ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>Epaso:t yo:n no: semi kwali para n' ke:meh i:n se: motehteki oso se: mo..., se: kipia se: kokotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>Mah se: ki:xpa:ka n' epaso:t, epaso:t s..., miak taman pahti no: kipia yo:n, no: kwali, no: kwali, no: semi kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>No: semi kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Ke:mah, *este** yehwa yo:n neh nik..., nikihtowa pos kwaltsi:n mah timoma:ti:ltihtia:ka:n wa:n nik ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>Tasohka:matik miak ke tine:chtapowia no:, ke:meh tehwa:tsi:n, tein tehwa:tsi:n tikmati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>*pues** tionkakeh seki tikmattokeh, seki a:mo tikmatih pero ke:meh i:n timosenilwiah, timose:panixpantiliah, timo..., timomati:ltiah nochi kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>*Lo que** tein tehwa:tsi:n tikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Pos kwaltsi:n mah no: nikmati neh wa:n *lo que** tein neh nikmati neh nikmati, a:mo tikmati teh, mah tehwa:tsi:n no: nimitsmati:lti. Para ihkó:n pos *parejo** timo..., mah, mah tikihto:ka:n nochi timomati:ltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>Se: mosenyo:lchika:wa ya neli, ke:meh i:n seki tikihtowah tehwa:n pos ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>A:mo nikmati neh ke:meh i:n para toni, para toni kwaltia yehwa i:n xiwtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>Pero komo tehwa:tsi:n tikmati, *pues** kachi kwali xite:chye:kilwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>Para ihkó:n mah *parejo** timo..., mah *parejo** timomati:lti:ka:n, mah se: mopale:wi nochi a, ihkó:n pos neli tiksen..., timoseni:xpantiliah, ke:meh tikihtowah tehwa:n pos no: se: mosenyo:lchika:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>*Deveras** tasohka:matik miak *don** Ernesto *este** ....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>A:mo, timonohno:tskeh ika nehji:n pahtsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>Wa:n a:mo tikelka:waka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>Sek...,okseki ko..., okseki taman, taman pahtsitsi:n tein tikmattos kwali tine:chtapowi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Wa:n niktasohka:mati miak *don** Ernesto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
