        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>Pos se:, ke:meh i:n se: motsonteki, a:mo *porque** se: kinekiskia mah te:ahsi yo:n, yo:n te:kokoh se: motsonteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
