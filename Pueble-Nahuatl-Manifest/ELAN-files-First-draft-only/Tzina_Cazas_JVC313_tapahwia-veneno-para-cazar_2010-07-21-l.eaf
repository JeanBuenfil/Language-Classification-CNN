        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>ompa ke:mah nejó:n se: kitahkoxelowa tepitsi:n, ke..., kie:ra o:me almo:n se: kite:ma se: *en cada, cada bolsa**.</ANNOTATION_VALUE>
