        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Wa:n nejó:n kite:mayah itech, ne:n, yo:n a:pahkamoh tein takwe:chol ya.</ANNOTATION_VALUE>
