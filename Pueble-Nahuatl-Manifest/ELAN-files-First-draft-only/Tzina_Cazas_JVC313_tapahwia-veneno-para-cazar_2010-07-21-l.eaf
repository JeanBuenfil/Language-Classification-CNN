        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Wa:n nochi yo:n takwe:chol ya kikosta:lketsah wa:n komo kwi:kah ya ne: we:ia:t,</ANNOTATION_VALUE>
