            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Iwki n' tepe:t, tio:takia:mpa etok ne:n tepe:t Ti:ltika:t, wehkatan a:xoxowi:l.</ANNOTATION_VALUE>
