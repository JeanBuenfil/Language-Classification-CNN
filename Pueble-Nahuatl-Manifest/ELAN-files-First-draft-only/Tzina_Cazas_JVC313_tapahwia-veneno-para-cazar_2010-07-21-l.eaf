        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Iwki nikih..., se: kichi:wa no: n' a:pah..., a:pahkamoh.</ANNOTATION_VALUE>
