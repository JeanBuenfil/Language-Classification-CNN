        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Wa:n nejó:n ka:mpa yo:n a:t sese:xtok, ka:m..., nika:n ka:mpa moka..., moka:wayah nika:n Ti:ltika:t etok se:,</ANNOTATION_VALUE>
