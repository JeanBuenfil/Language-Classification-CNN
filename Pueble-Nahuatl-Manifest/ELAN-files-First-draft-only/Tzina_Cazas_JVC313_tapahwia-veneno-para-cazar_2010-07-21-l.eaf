        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Wa:n ke:mahnejó:n se: ka..., se: kaha:wixowa ihko:ni a, se: kichi:wtinemi a,</ANNOTATION_VALUE>
