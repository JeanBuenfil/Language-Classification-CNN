        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Ka:mpa La:jahi:xko ihkó:n nika:n ahkokopa e[tok], ne:n, a:xoxowi:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>Ompa mote:mpilo:tih ne:n michimeh. Wehwei ke se:se: mo:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Mote:mpilo:tih ke:meh sese:k n' a:t wa:n a:mo pahyoh, pa mote:mowa, mote:mpilo:tih ihkó:n i:xkich mosowatih n' a:..., itech n' a:xoxowi:l.</ANNOTATION_VALUE>
