        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Tikohkoyo:nia:yah ika *clavos** wa:n, wa:n yehwa yo:n tik..., tiki:xkepah, ka:mpa ika kohkoyoktik, ka:mpa wihwitsyoh</ANNOTATION_VALUE>
