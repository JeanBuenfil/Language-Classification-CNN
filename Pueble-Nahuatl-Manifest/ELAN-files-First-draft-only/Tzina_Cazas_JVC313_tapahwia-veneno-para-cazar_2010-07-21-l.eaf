        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Yo:n se: *caña** ki:sa na:wi, na:wi, na:wi *cohete**. Se: kitamo:ta, na:wi se: 'ki:xtiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
