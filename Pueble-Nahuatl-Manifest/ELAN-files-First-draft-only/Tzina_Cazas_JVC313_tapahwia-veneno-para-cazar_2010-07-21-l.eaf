        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Wa:n ke:meh yo:n kichi:wah, ne:n, ki..., kixi:mah ata yo:n, yo:n ¿ke:ní:w kiliah ne:n?,</ANNOTATION_VALUE>
