        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Yehwa sah yo:n se: kinimiktia ika a:mo, a:mo ki:sah ko:so:limeh.</ANNOTATION_VALUE>
