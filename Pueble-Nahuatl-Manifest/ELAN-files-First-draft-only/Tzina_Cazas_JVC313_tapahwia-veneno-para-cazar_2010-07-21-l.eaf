        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Ompa mote:matih ne:, wa:n nika:n La:jahi:xko ahkotsi:n etok no: se:,</ANNOTATION_VALUE>
