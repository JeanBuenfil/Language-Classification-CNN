        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts825" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>Pos ta:taman tikchi:wah, ke:meh i:n ta:taman tikchi:wah de n' tikwih de nijí:n xo:no:t, ke:meh teh pos tikihtowa ne: timo...,</ANNOTATION_VALUE>
