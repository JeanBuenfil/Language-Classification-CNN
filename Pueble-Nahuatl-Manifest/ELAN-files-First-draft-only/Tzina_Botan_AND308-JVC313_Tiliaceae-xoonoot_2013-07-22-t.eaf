            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts908" TIME_SLOT_REF2="ts909">
                <ANNOTATION_VALUE>Yehwa yo:n. Pos yehwa sah yo:n n'nekia nimitstahtani:s yo:n xo:no:t wa:n i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts910" TIME_SLOT_REF2="ts911">
                <ANNOTATION_VALUE>kwali a *que** timotapowihkeh para timomakah *cuenta** ke:ní:w n' tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537" TIME_SLOT_REF1="ts912" TIME_SLOT_REF2="ts913">
                <ANNOTATION_VALUE>tikchi:was para a:mo timosiowti:s semi yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts914" TIME_SLOT_REF2="ts915">
                <ANNOTATION_VALUE>para se: mopale:wi:s kwali ihkó:n, pero komo a:mo timoliah pos a:mo se:..., a:mo se: kichi:wa wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539" TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts918">
                <ANNOTATION_VALUE>Ne:, se: kihtowa, ne: se: ka:n mosiowtia *o** telchihchika:wak, a:mo telma:chika:wak *sino que** tikpia[kipia]*maña para** kehke:was n' kowe:wat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts922">
                <ANNOTATION_VALUE>Yehwa ya a:mo se: mosiowtia semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts943">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts947" TIME_SLOT_REF2="ts949">
                <ANNOTATION_VALUE>A:mo te:ma:teki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552" TIME_SLOT_REF1="ts950" TIME_SLOT_REF2="ts952">
                <ANNOTATION_VALUE>Ke:mah, ihko:ni. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts954" TIME_SLOT_REF2="ts957">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
