        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557" TIME_SLOT_REF1="ts962" TIME_SLOT_REF2="ts964">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a559" TIME_SLOT_REF1="ts968" TIME_SLOT_REF2="ts969">
                <ANNOTATION_VALUE>Neh pos yehwa sah yo:n n'nekia nimitstahtani:s wa:n sayoh 'ne:chili moto:ka:y wa:n</ANNOTATION_VALUE>
