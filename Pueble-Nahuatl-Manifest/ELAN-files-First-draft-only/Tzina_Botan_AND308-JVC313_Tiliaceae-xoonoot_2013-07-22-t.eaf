        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts833" TIME_SLOT_REF2="ts835">
                <ANNOTATION_VALUE>Ke:mah, kachi ihsiwka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>Kachi ihsiwka, *porque** neli te:ma:kokoh, kanah ik..., te:ma:kokoh *mejor** kachi kwali ihkó:n tetekwino wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts841" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>[...]wa:n niki:tskih i..., wa:n sentapal se: *ipuntita** iwa:n wa:n n'tila:na, a:mo x..., a:mo tomi *porque** niktetsi:lowa nika:n wa:n sepa n'tahkokwi:ltia ne:pa wa:n niki:tskia nika:n niman wa:n n'tila:na wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>yo:n ke:meh niktila:n sepa niktokihtiw n' kowit iwki *hasta** nima:tami ni..., tamiki:sa n' e:wat  wa:n ihsiwka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>Ihsiwka, ihsiwka. Ompa ne: t..., *como que** ne:wí:n yowi a ne:n e:wat, pipitskatiw ne:wí:n wa:n xo:no:t ne:wí:n nikololte:ma wa:n sepa se: nikta:lia, *primero** n' ik..., ikwa:payo niki:xtilia s..., ika se: *cachito** ke:meh nikitas kwali niktetsi:lo:s nokow</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts851" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>niki:xtilia, n' ika i..., ie:wayo niki:tskia wa:n de ki:sa n' e:wat ke:mah niktsonkepa ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>n'tetekwinowa wa:n nikalakia itech ne:n kowit a wa:n n'tila:ntiw wa:n n'tila:ntiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514" TIME_SLOT_REF1="ts855" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>Tein xo:no:t n' tikihtowa ki:sa notechka:kopa wa:n tein e:wat ki:sa ne:wí:n ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts857" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>Yo:n para kwali, kwali ki:sa n' tein se: kkowtsa:la:wia *que** komo yetok nika:n ka:mpa ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>kiteki n' kowit pos ki:sa nika:n *o** k..., nimantsi:n wi:tsa nika:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts864" TIME_SLOT_REF2="ts867">
                <ANNOTATION_VALUE>ki:sa yema:nik *porque** mochihkolohtiw wa:n kkahka:wa n' e:wat ihkó:n. A:mo wel kwa:tohtoka *porque** kakaltik wa:n yeh yowi para ne:wí:n e:wat wa:n xo:no:t wi:tsa para nika:mpa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
