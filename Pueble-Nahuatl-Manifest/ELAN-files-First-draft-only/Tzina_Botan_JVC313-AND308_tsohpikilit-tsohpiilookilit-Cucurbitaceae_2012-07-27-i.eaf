        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>kiltsí:n wa:n pos neh nikitak ampo:wí:n a:mo kanah kinmakah ne:n pio:tsitsi:n oso,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts697">
                <ANNOTATION_VALUE>oso pitsotsitsí:n, a:mo kanah nikita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts703">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
