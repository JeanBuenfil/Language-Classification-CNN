        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>nijo:n kitekiah, nika:wí:n se: kita ka:s ika miak onkak, a:mo, a:mo kitekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>Ka:s ika se: pano:tiki:sa se: itek[kita]ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>tekpa:ntok n' iteyo, se: koli:nihtiki:sa, se: kitas *hasta** ne:wí:n tsikwi:nik a n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>tsikwi:ni wa:n mo..., mix..., motetekwinowa ya, moka:wa ne: pochiktik ya n' ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>Wa:n nika:wí:n, pos ne:wí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>a:it ne:wí:n okseki ne:wí:n xa: kimattoskeh, pero nika:wí:n pané: a:mo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>ke:meh kintsi:n neh ampó:n niwa:lah a:mo nikmati ne: ox ki..., kikwah n' tokni:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>Ompa ne: nochi tikmattokeh *que** kikwah ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>Pos yo:n kwali no: ika se: kitas mah se: kiteki, mah se: ki..., para se: kineltokas mah se: kiteki wa:n mah se: ka:yohpata, ta: yo:n ka:yohpatah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>Tikihtowa ka:yohpatah. A:mo we:lik eski ihkó:n. E..., ke:mah, a:mo we:lik eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts558" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>A:mo we:lik wa:n yehwa nijó:n mah se: ka:yohpata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>We:lik kit, we:lik, yehwa yo:n ne:n de kima:pa:tskah wa:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>*Pues** nijó:n *siquiera** nika:n ti..., timoliah ki:ní:n ne:n de we:lik nijó:n kiltsí:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>tsohpikilit tehwa:n tikiliah wa:n namehwa:n no: taman nankiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>Wa:n neh nika:n name:chilih de a:mo kimatih,</ANNOTATION_VALUE>
