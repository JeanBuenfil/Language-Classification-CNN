        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts625">
                <ANNOTATION_VALUE>Yo:n se: koli:nia wa:n ke:masá: seki wiwiti.</ANNOTATION_VALUE>
