        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>¡Ne: xkwiti nexkolo:n! ¿Pero katí:n nexkolo:n? A:mo n[ochi]se: kimati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>De a:mo se: kimati wa:n yehwa yo:n kintsi:n ti..., timomati:ltiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>Ka:ns ika itech n' ikwa:ko de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>iintsi:n ne:n, pos iintsi:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>ka:ns ika ikwa:ko mowi:wila:na miak ihkó:n itech n' owasin,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>Yehwa yo:n kintsi:n ka:ns ika onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Selia wa:n yo:n semi paniá:n yetok nalwatsí:n.</ANNOTATION_VALUE>
