        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>mono:tsa Tozán ompa ne:n nochi kikwiah wa:n ka:manayah wa:n kima:...,</ANNOTATION_VALUE>
