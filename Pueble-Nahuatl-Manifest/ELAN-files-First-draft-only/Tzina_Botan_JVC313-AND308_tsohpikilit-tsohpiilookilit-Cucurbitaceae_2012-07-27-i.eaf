        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>Wa:ki, pero ne:n i..., yehwa yo:n iteyo, pero n..., pos a:mo nikelna:miki n' ixo:chio ke:niwki, kox,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>Pos n' iteyo neh nikita, pero n' ixo:chio a:mo ni..., a:mo nikitstok ne:n...</ANNOTATION_VALUE>
