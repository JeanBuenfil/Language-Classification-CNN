        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>Wiwiti wa:n</ANNOTATION_VALUE>
