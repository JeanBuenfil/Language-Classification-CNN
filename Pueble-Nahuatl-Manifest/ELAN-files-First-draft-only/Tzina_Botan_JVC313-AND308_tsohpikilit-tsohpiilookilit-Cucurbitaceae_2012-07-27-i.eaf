        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>Teihsá: ihkó:n kita:mpawia *porque** wehka nochi mo..., mowi:wila:na ihkó:n</ANNOTATION_VALUE>
