        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Yo:n ke:mah, yo:n... Ke:mah. Paniá:n mowila:na nalwat.</ANNOTATION_VALUE>
