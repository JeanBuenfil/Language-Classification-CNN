        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>*hasta** ihkó:n mowi:wila:na,</ANNOTATION_VALUE>
