        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts713">
                <ANNOTATION_VALUE>Se: taman, nochi *mismo** se: taman sah ne:n</ANNOTATION_VALUE>
