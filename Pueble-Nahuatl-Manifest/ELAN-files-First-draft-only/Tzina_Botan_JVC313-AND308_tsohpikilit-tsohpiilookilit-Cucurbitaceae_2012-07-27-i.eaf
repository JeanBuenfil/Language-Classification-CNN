        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>De nika:n nankiliah pos no: namehwa:n no: tso:tsohpi...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts491">
