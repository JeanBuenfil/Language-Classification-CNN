        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>*bola** wa:n se: kite:ma wa:n *siquiera** ne:wí:n se: kite:..., se: kite:tepe:wa.</ANNOTATION_VALUE>
