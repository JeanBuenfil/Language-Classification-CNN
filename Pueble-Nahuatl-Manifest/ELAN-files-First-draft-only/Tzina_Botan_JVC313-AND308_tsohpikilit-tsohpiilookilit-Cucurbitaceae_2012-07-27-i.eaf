        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Pos nika:wí:n neh nik..., nikitstinemi onkak a:mo a:kin kiteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>A:mo kitekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Wa:n ne: a:na:l kitekiah ne:n kiltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>Kitekiah ke:meh kimattokeh *que** we:lik,</ANNOTATION_VALUE>
