        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts671">
                <ANNOTATION_VALUE>Ke:mah, pos yehwa sah neh ni..., yo:n xa:, xa: kachi tikmati, no: kwali tine:chili:s ne:n ka:nachi taman *porque** neh nikmattok sayoh se: taman,</ANNOTATION_VALUE>
