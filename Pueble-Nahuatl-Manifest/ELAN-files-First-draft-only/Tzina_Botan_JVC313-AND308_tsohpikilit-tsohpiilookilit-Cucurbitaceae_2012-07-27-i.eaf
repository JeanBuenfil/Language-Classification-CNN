        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>Ma:kwi:lkilit ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Wa:n neh nikitani ke:meh i:n ka:ns ika ne:n..., pos ka:s ika tik..., tika:wah no: ka:ns ika i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>iwki we:i, ka:ns..., ke:meh yo:n yemaxtik semi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>Ye:manik. Yo:n se: kwiwita, ka:..., ka:mpa se: tato:ka itsi:ntan mi:ltsí:n ompa no: ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>Ompa ixwa wa:n ompa mowi:wila:na *o** ka:ns ika itech kowit ihkó:n oso itech kahfe:n nochi mo..., no: kita:mpawia n' kahfe:n, kita:mpawia oso ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
