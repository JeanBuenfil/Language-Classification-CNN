        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>Yo:n, yo:n wa:ki, ka:ns ika se: kikohkoto:na ihkó:n wa:ki wa:n moka:wa seki ne:,</ANNOTATION_VALUE>
