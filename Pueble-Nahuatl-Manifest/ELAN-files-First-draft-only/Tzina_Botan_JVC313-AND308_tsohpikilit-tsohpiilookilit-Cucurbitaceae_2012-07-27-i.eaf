        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>pos yo:n a:mo nikihto:s teihsá: tikwitih yo:n imekayo, yo:n i:pa sayoh ihkó:n wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
