        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>ihkó:n kima:pa:tayah wa:n kita:liliah tsikitsi:n istat wa:n</ANNOTATION_VALUE>
