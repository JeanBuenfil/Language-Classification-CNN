        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>wa:n de chika:waya ya pos nijó:n ma:xi:i:ni.</ANNOTATION_VALUE>
