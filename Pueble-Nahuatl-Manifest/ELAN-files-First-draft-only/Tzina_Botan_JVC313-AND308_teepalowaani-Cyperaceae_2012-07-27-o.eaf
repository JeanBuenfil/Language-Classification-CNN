        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>wa:n yo:n de n' achi chika:wak, se: kita chika:wak pos se:..., wila:ntok ne: wa:n komo se: mometskwi:ltih,</ANNOTATION_VALUE>
