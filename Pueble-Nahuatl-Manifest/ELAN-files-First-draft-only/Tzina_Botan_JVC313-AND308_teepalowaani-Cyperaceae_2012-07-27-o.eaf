        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>A:mo chichinowi.</ANNOTATION_VALUE>
