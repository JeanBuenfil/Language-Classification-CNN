        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Wa:n yo:n kwaltsi:n no: n' it..., n' iteyo ne:n,</ANNOTATION_VALUE>
