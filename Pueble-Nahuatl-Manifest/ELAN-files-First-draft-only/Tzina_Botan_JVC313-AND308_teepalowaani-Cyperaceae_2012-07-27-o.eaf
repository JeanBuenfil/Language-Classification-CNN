        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>i:n ka:s ika se: panowa pos te:kwi wa:n *hasta** mopilowa itech se: itilmah wa:n</ANNOTATION_VALUE>
