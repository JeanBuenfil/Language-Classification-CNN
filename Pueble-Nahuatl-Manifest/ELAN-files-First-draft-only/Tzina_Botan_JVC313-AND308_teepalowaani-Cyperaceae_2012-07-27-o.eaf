        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>A:mo ke:man nikita yo:n, sayoh ne: ke:masá: de, de wa:ki no: kichichinowah ya.</ANNOTATION_VALUE>
