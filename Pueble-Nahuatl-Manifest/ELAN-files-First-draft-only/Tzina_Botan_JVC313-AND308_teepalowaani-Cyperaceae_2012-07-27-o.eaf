        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>pos sa tekit se: kipanawia, ke:masá: se:,</ANNOTATION_VALUE>
