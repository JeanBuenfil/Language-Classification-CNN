        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>wehka ihkó:n mota:lia *mata**</ANNOTATION_VALUE>
