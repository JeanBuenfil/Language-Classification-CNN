            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>A:mo koto:ni ta: yo:n ye:ktakwa:wak wa:n</ANNOTATION_VALUE>
