        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>ne: titekitiah wa:n tikchi:wayah tekoltsí:n pos tikwitih se: ihkó:n</ANNOTATION_VALUE>
