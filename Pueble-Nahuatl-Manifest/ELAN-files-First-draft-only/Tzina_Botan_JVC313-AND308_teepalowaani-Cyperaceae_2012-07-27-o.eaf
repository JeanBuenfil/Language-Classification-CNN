        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Wa:n i:n seki ka:mpa ne:wí:n, itech n' kowtah se: kita ihkó:n itech se: kowit,</ANNOTATION_VALUE>
