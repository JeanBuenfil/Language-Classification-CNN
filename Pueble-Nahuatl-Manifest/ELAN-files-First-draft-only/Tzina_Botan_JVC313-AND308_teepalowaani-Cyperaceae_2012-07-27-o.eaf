        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>Ma:ski pa:pata:wak n' ahko pero a:mo te:teki *más**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>A:mo, yo:n te:..., niman te:teki se: ima:ko *o** se: imetsko wa:n yehwa yo:n te:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>se: chichinaka ka:mpa te:kwi wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>t..., *por eso** itech  se: itso:ntekon komo a:mo se: kwa:yaktok se: *isombrero**, n' ikwa:ko mopihpilowa. *Porque** yo:n ehke:wi n' ima:yo wa:n mopilowa itech se: ipa:nko oso se: i..., se: ipoxko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>itech se: itilmah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts401">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nochi ne:n nika:n timolwihtokeh, ke:meh i:n tikowtahnemih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>pos nochi tikmattokeh ne:n ki:ní:n yeski, ki:ní:n nijó:n te:palowa:ni, kox wehkapania, toni xiwit ko...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>wa:n yo:n neh pos no:, neh *siempre** nikita te:palowa:ni ihkó:n, yo:n a:mo, a:mo ke:man nikihto:s a:ksá: ki..., teihsá: kikwi para pahti *o** teihsá: ihkó:n, yo:n neh nikita i:pa sayoh mowi:wila:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Sakat sah, ihkó:n sakat sah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Ti:ltik n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>*Por eso** ka:ns ika se: kita tatampa ye:k miak ixwatok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>Ixwatok wa:n ihkó:n ke:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>de tsikitsitsi:n ihkó:n aya:mo te:teki, pero sepa de wehweia te:teki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>Te:teki a, ma:ski ihkwi:ntsitsi:n, ihkwi:kwí:n te:teki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>Ka:s ika se: yowi wa:n se: mometskwi:ltia, te:teki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>Te:teki wa:n no:, no: te:..., te:kwihkwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>Te:neh wa:n pos yehwa yo:n neh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>teh no: tikmattok, ke:meh tikowtahnemi pos no: tikmattok katí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>ki:ní:n taman de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>Te:palowa:ni, chi:chi:ltik oso ista:k, nochi ka:nachi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Pos no: para mah se: kimattiw, nika:n ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>timat..., tikmattiuweh no: tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>ti..., timoliah wa:n para no: se: kimattiá:s ki:ní:n so</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>*que** a:mo se: kie:kmatis pero kintsi:n nika:n timonohno:tstokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>nijo:n, ma:sá: se: kitas ne:n katí:n de n' te:..., te:ki:tskia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>Pos neh nimono:tsa Anastacio Nicolás Damián, de..., noxola:l de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>A:, *bueno compadrito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
