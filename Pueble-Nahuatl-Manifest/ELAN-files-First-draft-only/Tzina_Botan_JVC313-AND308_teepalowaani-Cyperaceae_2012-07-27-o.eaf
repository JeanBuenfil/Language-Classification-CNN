            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>moxola:wa no: se: mometsteki ma:ski yo:n de n' wa:kik wa:n e..., n' ikowyo ke:masá: se: mometsilpia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>Wa:n se: tak..., se: ne:wí:n, se: kimatis nijó:n chichinakatok ya, se: mometstek ya, te:teki yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>A:mo, a:mo koto:ni.</ANNOTATION_VALUE>
