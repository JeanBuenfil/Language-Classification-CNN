        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>pero nika:n itsi:ntan ke:meh eskia ne:n kipia n' ikamoh[ikamohyo], pero a:mo *porque** kamoh ta: ne:n na..., nalwat de ompa ne: pachti.</ANNOTATION_VALUE>
