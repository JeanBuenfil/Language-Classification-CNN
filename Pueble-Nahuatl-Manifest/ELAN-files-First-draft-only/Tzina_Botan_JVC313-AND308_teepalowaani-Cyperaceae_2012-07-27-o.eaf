        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Yo:n ke:masá:, *antes** tehwa:n ne:..., *bueno** ne: ke:man, wehka:w ya,</ANNOTATION_VALUE>
