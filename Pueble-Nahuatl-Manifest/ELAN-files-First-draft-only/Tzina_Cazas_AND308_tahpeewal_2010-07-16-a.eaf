        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts457" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>Entó:s seki chi:chi:..., n' achi *morado** n' ixo:chio.</ANNOTATION_VALUE>
