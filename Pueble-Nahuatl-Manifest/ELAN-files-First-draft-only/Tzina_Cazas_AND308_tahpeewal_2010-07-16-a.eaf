        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Ihko:ntsi:n mota:lia ne:wí:n a:te:n. Ke:masá: ekintsi:n nochi kikwih para n' *artesanias**, ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>Mm. Seki yehwa yo:n, yehwa yo:n tik..., tik..., tik..., tiktekiah *porque** mehmela:wak, tihti:ltik kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
