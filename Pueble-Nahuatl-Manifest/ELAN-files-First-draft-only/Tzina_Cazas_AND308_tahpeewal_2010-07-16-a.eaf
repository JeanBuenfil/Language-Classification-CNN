        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>*Cecerquitita** ihkó:n, *cecerquitita. Ke:mah.</ANNOTATION_VALUE>
