        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>Mm, ta..., ta..., a:xka:n para nika:n ti..., tikiliah tatsomo:talo:ni yehwa yo:n tikiliah chi..., chikikiskowit,</ANNOTATION_VALUE>
