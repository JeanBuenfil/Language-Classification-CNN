            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Mm, yeh tikwiah sa:wapahkowit.</ANNOTATION_VALUE>
