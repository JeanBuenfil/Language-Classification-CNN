                <ANNOTATION_VALUE>pos se: kitstinemi ke:meh i:n se:..., se: yowi [i]tech n' a:t se: kin... Ke:masá: ihkó:n *antes** tik... tia:yah [i]tech n' a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>Pos tikitayah yo:n tekowit. Wa:n timolia:yah i:n kwaltias para ne:n ma:tat tikchihkolo:tih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>ta: mela:wak seki n' ima:y. Sayoh *que** yo:n a:mo kwaltia para kowtati:l semi te... semi tel ye:ma:nik. Wa:n semi tsikitsitsi:n. tako:tik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>Pos ihkó:n *ya que** tine:chtahtania nika:n timona:mikkeh wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>moneki mah nochi timomatiltika:n para ne:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>Se: kitas se: ya:s [i]tech n' a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>pos se: ki... Ki:xte:mo:s ka:nika yetok n' tekowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Pos neh nimono:tsa Anastacio Nicolás Damián niwa:le:w San Miguiel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>*A bueno** tasoohka:matik.</ANNOTATION_VALUE>
