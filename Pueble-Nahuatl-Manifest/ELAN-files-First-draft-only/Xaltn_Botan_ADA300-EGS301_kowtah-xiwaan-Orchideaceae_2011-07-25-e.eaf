        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>A:mo ke:meh ne: *resistol, porque** i:ksá: ne: *resistol** tikta:lilia,</ANNOTATION_VALUE>
