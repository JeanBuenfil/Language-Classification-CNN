        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>T..., ne: i..., ika tikwiah, i:ksá: timomachtia:yah wa:n a:mo t'piayah *resistol**, i:ksá: ika t'pepechowa:yah ne:n a:mat</ANNOTATION_VALUE>
