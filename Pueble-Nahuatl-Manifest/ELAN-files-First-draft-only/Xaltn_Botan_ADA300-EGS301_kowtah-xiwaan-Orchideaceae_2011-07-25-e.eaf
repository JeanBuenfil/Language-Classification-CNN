        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>A:mo, a:mo ne: nejó:n, mahyá: a:mo a:yoh, *o sea** ise:ltihtsi:n kwaltsi:n mopepechowa wa:n a:mo niman ehke:wi.</ANNOTATION_VALUE>
