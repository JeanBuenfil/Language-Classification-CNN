                <ANNOTATION_VALUE>mahyá: tixtsí:n. Wa:n yehwa yo:n tixtsí:n ne:n, yehwa ya se: kikwi wa:n ihkó:n se: kita:lilihtiw ne:n a:mat iekapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
