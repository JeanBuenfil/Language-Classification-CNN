        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Yehwa:n ne:chne:xtilihkeh, neh ka:n..., ka:n, ka:n nia:ya iwa:n nokni:wa:n, ya:yah nochi okichpi:pil sah wa:n yehwa:n ko:nkwiah.</ANNOTATION_VALUE>
