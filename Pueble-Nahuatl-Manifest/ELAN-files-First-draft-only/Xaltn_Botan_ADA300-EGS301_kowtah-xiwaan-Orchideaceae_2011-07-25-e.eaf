        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>wa:n tikwi a ika moisti wa:n tikxola:wilia, ika mo..., mo..., mo..., moekap...,</ANNOTATION_VALUE>
