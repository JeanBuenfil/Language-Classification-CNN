        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Ne:, ke:man katka nipili ti..., tehwa:n tikwiah ika tikpepechowa:yah..., i:ksá: t'chihchi:wayah yo:n *globo** wa:n yehwa ika t'pepechowa:yah.</ANNOTATION_VALUE>
