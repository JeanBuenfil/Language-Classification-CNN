                <ANNOTATION_VALUE>wa:n se: taman ochpa:wa:s ala:wakochpa:wa:s no: ohte:n mochi:wa kasa:ika pero yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>ki... Bueno miak taman ineketsalis seki mo... M... Pané: mosowa sah ihkó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>wa:n seki mahkokehketsa sah ne: i... Ne:n ochpa:wa:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>wa:n ikwowyo tel xoxoktik yo:n wa:n ye:k, ye:kmetsmohmoloxtik n' ikowyo wa:n nochi n' ima, imai... Ii:xko n' ima:y ima:xiwyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>nochi mohmoloxtik semi ne:n, xiwit yo:n yehwa ya kiliah ala:wakochpa:wa:s wa:n nejó:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>Ne:, yo:n nejó:n telxoxoktik wa:n achi ma:wehweyi ma:pata:wak tepitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Wa:n i:n xo:no:ochpa:wa:s yeh seki yeh ma:pisi:ltik ata, ke:mah wa:n nokta mochi:wa seki... Yo:n a:mo kachi we:yi onkak eliwis i:n mochi:wa n' ala:wakochpa:wa:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>a:mo kachi... A:mo kachi mochi:wa e:n... Pero tel onkak i:n seki n' xo:no:ochpa:wa:s tel onkak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>wa:n kiliah xo:no:ochpa:wa:s porin kwali ehke:wi kwali ki:sa n' ie:wayo kita:lihkeh xo:no:ochpa:wa:s n' ta:tahmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>ihkwi kito:ka:ytiah xo:no:ochpa:wa:s. Wa:n se: taman onkak ne:n ochpa:wa:s yo:n ika se: tachpa:na *o** ika se: kichipa:wa *teja** yo:n ixta:wat onkak oso a:taw mochi:wa ka:mpa yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>weh... A:te:n ka:mpa wehka n' a:t no: mochi:wa yo:n. Yo:n mochi:wa *porque** a:mo se: tawi:teki yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>weh... A:te:n pos a:mo se: tawi:teki pos ika yo:n mochi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>*igual** ixta:wat no: mochi:wa ne:n ixta:wat ka:mpa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>ke:meh yo:n ixta..., ixta:wat ke:meh ne:wi:n ixta:wat ne: ahko nochoi yehwa ta n' ochpa:wa:s yo:n ixta:wat kilia ixta:waochpa:wa:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>yo:n semi kwali ika se: kichpa:na no:... Yo:n achto kichi:wayah kali de *teja** ika kichipa:wayah n *teja segun** kwaltia *por** takwa:wak ne:n ikowyo, nochi n' ima:xiwyo takwa:wak a:mo xi:ni *como quiera**</ANNOTATION_VALUE>
