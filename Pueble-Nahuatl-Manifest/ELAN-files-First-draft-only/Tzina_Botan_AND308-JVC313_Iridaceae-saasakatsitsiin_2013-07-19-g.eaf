        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>A:mo te:teki, ta: se: kita iekapan te:neh pero pos a:mo, a:mo te:teki eski *por eso** ne:n ompa mota:lia ne:n okwilin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>Ne: kowa:t, ta: ke:masá: yo:n na:weyak oso yo:n kowa:we:wentsi:n oso ompa nochi mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Ta: neli yehwa yo:n se: kimowilia pos yo:n de se: ki..., se: kiteki sah yo:n, se: kiteki ixoc:hio, ta: yo:n ka:sá: ika ye:kkwaltsi:n no: tachi:chi:le:wtok.</ANNOTATION_VALUE>
