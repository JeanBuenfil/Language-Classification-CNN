        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Se: kimowilia *porque** ke:masá: kihtowah ke ka:mpa yetok yo:n a semi se: ki..., mota:lia ne:n kowa:t wa:n xa: ka:mpa ne: ...</ANNOTATION_VALUE>
