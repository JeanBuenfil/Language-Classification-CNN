        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Ke:mah, iwa:n wi:tsa ne:n, se: kitila:na ihkó:n iwa:n wi:tsa ya ne:n, ke:meskia, ke:meskia ompa tak yo:n ikone:w oso mati ke:ní:w, itsi:ntan yetok.</ANNOTATION_VALUE>
