        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Pero komohkó:n tikilia ihkó:n pos tak ke:mah *porque** kipia ixo:chio.</ANNOTATION_VALUE>
