        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Tehwa:n, tehwa:n tikilia:yah ne:n sa..., sa..., sakat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Yehwa yo:n tehwa:n tikiliah ke:meskia sakat *porque** yo:n ma:..., ma:..., ma:tehte:neh ima:te:mpan de wa:ki.</ANNOTATION_VALUE>
