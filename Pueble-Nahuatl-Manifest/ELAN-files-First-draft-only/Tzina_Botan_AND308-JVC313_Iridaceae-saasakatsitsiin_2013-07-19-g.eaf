            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Ta:taman, tehwa:n tikitah xo:chitsi:n wa:n nochi ta:taman ti..., tik..., tik..., tik..., tikihtowah, ta:taman tikto:ka:itiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Pero *mismo, mismo** yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>*Mismo** yehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Neh nikwelita no: kwaltsi:bn de ke nika:n se:, [tein]a:mo se: molia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>Pos kie:ra ki..., se: motahtania ke:ní:w se: kito:ka:itia se: yehwa wa:n ke:ní:w oksé:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>Pos ihkó:n nochi se: ki..., se: kimattiw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Se:, se: kim..., se: kimattiw ke:ní:w ito:ka:i wa:n ke:ní:w neh nikto:ka:itia wa:n pos ka:ni mochi:wa, pos ihkó:n nochi se: mo..., se:  momati:ltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>Ke:mah wa:n pos neh a:mo no: nikmati *más** ne:n nimitsili:s, yehwa sah yo:n nik..., nikmattok ika se:, se: kikwi ika se: taa:ketsa wa:n a:mo wa:ki ma:ski se: kwiwita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>A:mo wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Kipale:wia kamoh,ke:mah pos nehwa, neh yehwa sah ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>Pos nehwa nimono:tsa Anastacio Nicolás Damián, niwa:le:w ne: San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>A: pos we:noh, tasohka:matik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
