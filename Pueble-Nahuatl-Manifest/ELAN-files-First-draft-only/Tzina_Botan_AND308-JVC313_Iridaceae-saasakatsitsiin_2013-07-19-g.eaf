        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>Pos yo:n de ma:ski se: kwiwitas wa:n ne: se: kitamo:tas wa:ki n' ahko.</ANNOTATION_VALUE>
