        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Tachi:chi:le:wtok wa:n yo:n a:mo no: nikmati neh katí:n, katí:n to:nal, katí:n ne:n me:tsti ne:n xo:chiowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>Sioh nikita xo:chiohtok ne:wí:n pero a:mo nik..., a:mo nik..., a:mo nik..., nikita ne:n, nikita, nikita pero a:mo nikmati ke:maniá:n, teh xa:, xa: tikmattok, kwali tine:chili:s, xa: tikits..., tikita ne:wi:n.</ANNOTATION_VALUE>
