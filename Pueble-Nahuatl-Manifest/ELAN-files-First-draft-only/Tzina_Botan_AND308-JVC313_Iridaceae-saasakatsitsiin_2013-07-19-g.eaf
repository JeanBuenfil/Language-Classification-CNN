        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Wa:n tiktekih wa:n yo:n ne:n i..., iteyo ihkwi:ntsitsi:n, nahnalwayoh iteyo, ihista:k.</ANNOTATION_VALUE>
