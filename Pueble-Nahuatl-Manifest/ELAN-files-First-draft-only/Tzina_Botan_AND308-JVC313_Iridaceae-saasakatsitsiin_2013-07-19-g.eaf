        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Yo:n ka:sá: ika se: mohtia nio:nó:, nio:nó: wel se: moh..., se: yowi, ta: te:tsakwilih oso ika se: wehwetsi.</ANNOTATION_VALUE>
