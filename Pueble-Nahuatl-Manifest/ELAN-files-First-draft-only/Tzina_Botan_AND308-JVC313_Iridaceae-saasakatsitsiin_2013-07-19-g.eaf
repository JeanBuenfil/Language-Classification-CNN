        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>Yo:n kipia ixo:chio ne:n chi:chi:ltik wa:n kwaltsi:n ihkó:n mo..., mokehketsa ihkó:n,</ANNOTATION_VALUE>
