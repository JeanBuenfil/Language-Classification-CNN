            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>kwali ki:sa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Kki:xtiliah n' ia:yotsi:n, ¿wa:n ompa sepa ka:yo:tiah seki ika?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>A:, nompa ne:n kipano:ltiah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>ahwia:k kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Ke:mah, yo:n nikekowa:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Yo:n, yo:n ke:mah nik...,chi:wani pero yehwa i:n seki kiltsí:n a:mo ke:man nikchi:wa pero neli i:pa, i:pa ihkó:n nikakini *que** we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Wa:n neli nikitani ka:mpa onkak ta: se: kita ye:kkwahkwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Pero a:mo ke:man, a:mo ke:man nikchi:wa ke:ní:w neli ne:n kichi:wah, pero ekintsi:n de i:n tine:chtapowihtok a pos no: kwali nejó:n nikchihchi:was wa:n nikeko:s, ta: neli se: kita ye:kkwahkwali ka:mpa onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>Wa:n neli yo:n ka:n mone:neki *porque** mochi:wa ka:nika eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Ne:, ke:mah, ta: nikitani neli, nikitani wa:n neli ihkó:n i:pa ne:chilia:ya note:iskaltihka:w, i:n kihtowa mono:tsa ahmo:lkilit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>pero neli a:mo, a:mo ke:man nejó:n ihkó:n mah nikmanak *porque** neli pos ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>ka:n nejó:n, tak a:mo kimahse:waya note:iskaltihka:w *porque** a:mo ke:man teh ne:chilwih ke:ní:w se: kichi:was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Ke:mah, pero neli nte:kakilia:ni i:pa *que** we:lik yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>A:, wa:n tikilwih ke:ní:w n' kichi:was. Ke:mah, pos de te:ilwiah se: welis, ke:mah, se: welis, mah te:ilwika:n sah ke:ní:w se: kichi:was wa:n se: welis. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>wa:n ke:mah ki..., kitsoyo:nih ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Kwe:lilih ya no:, ke:mah, pos sayoh *de que** a:mo se: kimati ke:ní:w nikilia se: kichi:was pos yeh ika a:mo se: kimati, pero de te:iliah pos se: kichihchi:wa wa:n neli we:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Ka:nah, ka:n, a:mo, ke:mah, ka:n ke:..., ka:n ke:man nikchihchi:wa, ka:n nikmati neli ke:ní:w se: kichihchi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>Ke:mah, *por eso** nejó:n nimitsilia neh *que** ne..., neli i:pa nikitani *que** onkak wa:n neli kihtowah *que** we:lik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>pero a:mo, a:mo ke:man nikchihchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Pos neh a:mo no:, neh i:pa ihko:ni sah nikmati n' ito:ka:y. Ke:mah, a:mo nikmati *más** ox kipias oksé: ito:ka:y, pero neh n'mattok *que** i:pa iwki sah kito:kaytiah ahmo:lkilit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>No: kwali pos, yehwa sah ika timonohno:tskeh, tasohka:matik miak. Neh nimono:tsa Rubén Macario, niwa:le:w de Chilcuauhta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>*Aja**, tasohka:matik tein tine:chilwih, a:mo nikmatia ke:ní:w se: kichi:wa, pero ekintsi:n de tine:chilwih ya, tasohka:matik. Neh nimono:tsa María Salazar Osollo, de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
