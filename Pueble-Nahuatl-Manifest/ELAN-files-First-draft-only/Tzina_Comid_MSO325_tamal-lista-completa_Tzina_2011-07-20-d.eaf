        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>Nochi i:n ma:k..., ma:kwi:l taman oso na:wi taman, ka:nachi tikihtowa:ya onkak, ke:meh i:n etixtamal...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>Ke:meh yo:n owakilit, ¿nochipa kwali se: kikwa:s?</ANNOTATION_VALUE>
