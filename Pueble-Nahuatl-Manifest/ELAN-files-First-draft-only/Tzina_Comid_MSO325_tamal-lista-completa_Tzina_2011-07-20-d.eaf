        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>Pos miak tasohka:matik, ne: xine:chili ke:ní:w moto:ka:y.</ANNOTATION_VALUE>
