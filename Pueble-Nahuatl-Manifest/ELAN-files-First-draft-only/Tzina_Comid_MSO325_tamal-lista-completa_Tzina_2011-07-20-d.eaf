        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts457" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>A:mo kwaltia nexkoko:kiswat oso ne:...</ANNOTATION_VALUE>
