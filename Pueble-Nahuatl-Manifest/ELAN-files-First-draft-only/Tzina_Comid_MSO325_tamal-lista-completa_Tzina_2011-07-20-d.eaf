        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts629">
                <ANNOTATION_VALUE>Wa:n e:lo:t...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts644" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>¿Wa:n e:lo:tamal?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>Pos semi nikwelkakik n' ke:meh tine:chtapowih, a:xa:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>ke:meh ihkó:n tine:chnohno:ts, nimolia xa: nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts668">
