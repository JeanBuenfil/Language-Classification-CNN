            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>wa:n no: kwaltia iwa:n a:ko:la:t.</ANNOTATION_VALUE>
