        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts669" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
