        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>¿ise:lti sah tikwa oso tikchihchi:wa oksé: tapalo:l ok?</ANNOTATION_VALUE>
