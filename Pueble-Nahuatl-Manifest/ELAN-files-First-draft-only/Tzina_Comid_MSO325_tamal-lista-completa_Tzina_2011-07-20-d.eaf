        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts555">
                <ANNOTATION_VALUE>Wa:n i:n e:lo:tamal, ¿yeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts556" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>toni no: n' kwali iwa:n se: kikwa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>I:n tamal tikchihchi:wa, ¿ke:man eski oso etoksah to:nal ke:maniá:n tikwa:s *o** tikwa?</ANNOTATION_VALUE>
