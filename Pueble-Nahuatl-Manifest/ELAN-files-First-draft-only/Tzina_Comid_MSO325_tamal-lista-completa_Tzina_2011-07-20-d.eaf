        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>Wa:n owakiltamal, ¿yeh toni n' kwali iwa:n se: kikwa no:?</ANNOTATION_VALUE>
