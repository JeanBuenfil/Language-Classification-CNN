        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>*Bueno** pos miak tasohka:matik. Neh nimono:tsa Amelia Domínguez.</ANNOTATION_VALUE>
