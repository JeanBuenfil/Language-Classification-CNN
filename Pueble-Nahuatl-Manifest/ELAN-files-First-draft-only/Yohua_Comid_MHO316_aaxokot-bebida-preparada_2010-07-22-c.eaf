        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Ka..., katí:n xola:lmeh ne: no: weli kichi:wah i:n a:xokot.</ANNOTATION_VALUE>
