        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Yo:n ko:mit i:pa para yehwa sah a:xokot, a:mo wel se: kikwi.</ANNOTATION_VALUE>
