        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>Wa:n komo se: tai:k yehwa i:n a:xokot tein teh tikilia *este** chika:wak a, ke:níw ne:n, te:poxkokoh *o**....</ANNOTATION_VALUE>
