        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Yo:n ko:meh se:, se: kikwi etok sah ko:mit *o** katí:n eski ko:mit kwali ika se: kixokolti:s.</ANNOTATION_VALUE>
