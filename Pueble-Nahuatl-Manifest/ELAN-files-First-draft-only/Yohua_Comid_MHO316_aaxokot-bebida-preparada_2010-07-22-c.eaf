        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>Pero ompa sah ne: moxola:l *o** no: tiki:sa okseki xola:lmeh titapale:witi.</ANNOTATION_VALUE>
