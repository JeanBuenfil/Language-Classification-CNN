        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>Wa:n i:n, i:n *este** chiwalis kichi:wah ta:taman xola:lmeh, xiwit i:pa nochi yehwa sah kikwih *o** mopa:pata xiwit.</ANNOTATION_VALUE>
