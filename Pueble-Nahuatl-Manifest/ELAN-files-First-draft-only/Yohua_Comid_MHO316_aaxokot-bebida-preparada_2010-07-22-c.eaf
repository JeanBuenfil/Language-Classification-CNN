        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Wa:n no: taman we:lik komo sayoh se: xiwit se: kikwi.</ANNOTATION_VALUE>
