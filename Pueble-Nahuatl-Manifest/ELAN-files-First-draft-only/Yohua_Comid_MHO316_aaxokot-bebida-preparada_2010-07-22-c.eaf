        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>Mah tikihto:ka:n, tiktamikwi tike:wa wa:n *hasta** sepa tikwiti.</ANNOTATION_VALUE>
