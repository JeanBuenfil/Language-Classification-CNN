        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>Wa:n tein a:mo tami ne:n a:xokot kwali kimo:..., kimo:molo:ntihtokeh wa:n ke:wtokeh oso wehweliwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>Tehwa:tsi:n ke:yeh tiki:xehekowa ika tikihtowa a:man pi:pil a:mo kinekih ok tai:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Ne: wehka:w pos ka..., kachi ne:, okachi taia:yah tokni:wa:n ke:meh yo:n tikihtowa tekitiah kowtah, mo:stah.</ANNOTATION_VALUE>
