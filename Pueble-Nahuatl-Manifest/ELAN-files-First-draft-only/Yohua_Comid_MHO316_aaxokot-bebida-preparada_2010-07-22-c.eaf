        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>Wa:n i:n, i:n a:xokot kwali tai a:kin eski oso *delicado** ihkó:n a:ksá: mah tai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>Ke:ní:w mochi:wa komohkó:n.</ANNOTATION_VALUE>
