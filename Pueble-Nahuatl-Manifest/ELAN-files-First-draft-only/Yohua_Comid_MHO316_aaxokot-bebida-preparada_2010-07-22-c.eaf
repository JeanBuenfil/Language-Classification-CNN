        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>Wa:n yo:n teh tikilia chika:waya ke:ní:w mochi:wa ke:meskia *este** tai:la:t moka:wa *o** ke:ní:w.</ANNOTATION_VALUE>
