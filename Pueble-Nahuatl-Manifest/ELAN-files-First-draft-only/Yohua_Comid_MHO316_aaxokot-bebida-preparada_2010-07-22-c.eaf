        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>Wa:n yehwa i:n ko:mit tein *este** tikihtowa tikihtitapalwia, wehwei ko:meh.</ANNOTATION_VALUE>
