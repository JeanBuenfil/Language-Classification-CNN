        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Tehwa:tsi:n tikine:xtilia okseki *este** tokni:wa:n tein pi:pil ok mah no: kichihchi:waka:n yo:n ato:l.</ANNOTATION_VALUE>
