        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Yo:n a:mo se: kipahpa:ka ok ko:mit, iwki a.</ANNOTATION_VALUE>
