        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>Okseki xala:lmeh tein ka:mpa teh tik..., tikmattos no: okseki na:nomeh no: welih kichi:wah i:n ato:ltsi:n.</ANNOTATION_VALUE>
