        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>Wa:n tikihtowa ti..., tikine:xtilia mopi:pilwa:n wa:n aya:mo nochi welih, ekin se: weli, ke:yeh aya:mo welih, tel owih se: kichihchi:wa.</ANNOTATION_VALUE>
