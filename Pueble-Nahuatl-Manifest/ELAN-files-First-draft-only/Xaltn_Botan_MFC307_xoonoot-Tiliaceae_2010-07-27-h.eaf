    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="Eleuterio Gorostiza Salazar">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>A:man xite:chnohno:tsa de i:n xo:no:t, *este**, ta:taman xo:no:t nika:wí: onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>ekinika xite:chnohno:tsa tein i:n xo:no:t tikihtowa pi:xowi ixo:chio, ke:niwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>I:n tein tikihtowa pi:xowi ixo:chio ke:niwki ne:n ixo:chio, ¿ke:ní:w se: ki:xmati?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>Yehwa i:n tein tikihtowa xo:chiowa ke:meh santísimo, yehwa tein teh no: t'to:ka:itia to:nalxo:no:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Wa:n no:, no: *este**, no: mahsi ke:meh santísismo *o** ke:yeh ihkó:n t'to:ka:itia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>I:n to:nalxo:no:t tikihtowa ke:meh to:nal ne:n ixo:chio, ¿Ke:niwki tapaloh xo:chit?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>To:nalxo:no:t komo se: kehke:wa i:ksá: no: ki:sa *este** ista:k wa:n chi:chi:ltik xo:no:t *o** i:pa se: taman sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Wa:n i:n *este** teh t'to:ka:itia kowxo:no:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>kati:ni ne:n, ke:niwki ne:n ixo:chiotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>No: se: xo:no:t i:n tehwa:tsi:n t'to:ka:itia ma:pisi:ltik ¿Ke:niwki i:n xo:no:t?.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>I:n no: we:ikowit mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>¿Wa:n ixo:chio?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>I:n tein ta:taman *este** xo:no:..., xo:no:kowit tite:chtapowih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>ixo:no:yo sah i:pa se: kikwi, ixiwyo a:mo teh, a:mo teh kwaltia pahti oso ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts338">
