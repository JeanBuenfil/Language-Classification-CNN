        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Wa:n i:n, i:pa se: .... Yo:n i:pa, i:pa se:sah, okseki xo:no:t a:mo teh kwaltia ixiwyo.</ANNOTATION_VALUE>
