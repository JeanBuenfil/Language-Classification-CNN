                <ANNOTATION_VALUE>Wa:n *semillitas tike:wtipowih ixa..., iteyotsi:n wa:n tikwa:tsah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
