        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Telwe:lik ihkó:n taxkaltsí:n, kichihchi:wa iwa:n tixtsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Mochi:wa ke:meh *tayollitos**. Semi we:lik iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>Wa:n ahwia:k, x'ta:lili, x'ta:lili sayoh ahwia:kka:yo:t, awakaxiwit wa:n ke:meskia tikwahtoskia exoyema:n *tayollitos**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Mm, tehwa:n ihkó:n tikwah ompa ne: tani, ihkó:n. Tiko..., ti..., ipanakayo tikwaliah ne:n n' ichkatsitsi:n tein kipia, itsope:kka ke:meskia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
