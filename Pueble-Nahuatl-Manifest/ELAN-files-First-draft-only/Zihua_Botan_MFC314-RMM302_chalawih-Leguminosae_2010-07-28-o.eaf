            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>'kwi yo:n, kimana ne: na:notsi:n wa:n kikwe:chowa wa:n kita:lilia n' awakaxiwtsi:n wa:n se: chilito,</ANNOTATION_VALUE>
