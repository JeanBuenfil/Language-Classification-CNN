        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>komo se: kineki wa:n koma:mo se: kimana iwki ihkó:n xohxowik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Tikmana wa:n ti.., tikwa ne:n, ne:n ta:kilo:t ko..., ko...., mahyá: .... Semi we:lik n', n' iteyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>wa:n koma:mo tikeneki ne:n tikwa:s iwki sah pos mah kwe:cho na:no, mah kwe:cho na:no kwaltsi:n wa:n kwali t'chi:wa ke:meski ta..., *tayollitos**.</ANNOTATION_VALUE>
