        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>Pos yehwa sah yo:n nimitstahtania:ya, tiki:xmattok wa:n soh ne:chilwi moto:kai wa:n ka:ni tiwa:le:wak.</ANNOTATION_VALUE>
