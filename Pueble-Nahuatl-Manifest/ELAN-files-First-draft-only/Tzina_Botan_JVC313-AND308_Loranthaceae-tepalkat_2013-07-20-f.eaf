        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>Yo:n tak wa:li tata, de wa:kik kwaltsi:n tata pero itaktsoyo ka:mpa e:wtok pos kitachihchi:..., kichi:waltiah para i:n ma:tachi:wah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Soh kichipa:wah kwaltsi:n wa:n kiek..., e:k...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
