        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>Ke:mah, ihko:ni.</ANNOTATION_VALUE>
