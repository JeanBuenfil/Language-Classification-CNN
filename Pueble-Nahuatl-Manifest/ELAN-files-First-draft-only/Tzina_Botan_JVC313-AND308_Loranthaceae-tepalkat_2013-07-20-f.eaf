        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Wa:n ke:ní:w kihilpiah, ke:ní:w kiwi:pantiowih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>Yehwa i:n timolihtokeh de ke no: kwali a nika:n timona:mikkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>Ke:meh i:n tikitah ke no: kwaltia para ne: se: tachihchi:wa ne: sa:ntohi:xpan, pos kwali se: kitekis wa:n se: kia:ketsas oso ika se: kilpi:s ne: itech itech n' se: iartali:toh, ka:mpa ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>Nehjó:n se: kilpi:s, mah ika se: kita, ta: nika:n tehwa:n pos a:mo, tehwa:n *solamente** tikwih ne:n chamakih. Chamakih *o** teisá: xo:chitsi:n ihkó:n tikwih pero yeh yo:n a:mo ke:man tikitaskeh ne: tio:pan a:ksá: ihkó:n mah kita:lihto, a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>Ke:mah, pero yo:n xo:chitsi:n pos ne:n ne: [tein]te:chkwida:rohtok nochi, nochi kwelitah yeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>Nochi kwelita sayoh ke tehwa:n a:mo tikmatih de ke ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>Pero ekintsi:n nika:n timolwihtokeh komo tikitak ne:wí:n ka:mpa tachihchi:wtokeh pos no: kwali se: kitekiti:w nehjó:n to..., tepalkat wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>Ka:sá: ika wetstok, ka:sá: ika ne: selistok kwali se: kitekis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>Chi:chi:le:wtok wa:n pos yehwa yo:n nochi a:mo tikmatih ox kwali para teisá:, teisá: pahti *o** kwali para teisá: ihko:ni.</ANNOTATION_VALUE>
