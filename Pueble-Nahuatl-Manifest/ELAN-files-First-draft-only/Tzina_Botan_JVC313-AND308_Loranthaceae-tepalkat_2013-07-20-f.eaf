            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Kanah, yo:n a:mo, a:mo, a:mo, a:mo te:kakilia ox pahti pero, pero nehjó:n ne: ... kwaltia, kwaltia, ta: yo:n kwali tata semi, ke:mah, kwali tata.</ANNOTATION_VALUE>
