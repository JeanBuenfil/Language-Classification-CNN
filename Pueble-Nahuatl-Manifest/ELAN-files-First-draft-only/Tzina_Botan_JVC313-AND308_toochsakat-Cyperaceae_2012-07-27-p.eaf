            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>Sayoh ne:n a:mo se: kimati ne:n to:tolin oso piotsi:n kox no:</ANNOTATION_VALUE>
