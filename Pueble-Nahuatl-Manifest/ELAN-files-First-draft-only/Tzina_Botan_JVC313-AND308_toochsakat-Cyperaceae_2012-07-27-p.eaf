                <ANNOTATION_VALUE>Moto:chta:lia wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Pos yo:n sayoh mokehketsa ihkó:n, tepitsi:n ihkó:n mo...,</ANNOTATION_VALUE>
