        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Seki, seki kohkostik mochi:wa yeha yo:n no:, tein kahfe:ntahxo:chit mah tikihto:ka:n, yo:n a:mo, a:mo tato:kal, pero no: kwaltsi:n poso:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>*Exacto**. Ke:mah, kipia ikamohyotsi:n. *Eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>Nochi nika:ketsa.</ANNOTATION_VALUE>
