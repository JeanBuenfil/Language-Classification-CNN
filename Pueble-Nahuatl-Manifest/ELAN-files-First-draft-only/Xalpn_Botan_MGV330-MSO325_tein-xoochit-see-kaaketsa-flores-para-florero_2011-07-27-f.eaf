        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>miak xo:chitsitsí:n, *como que** a:mo nochi n'to:ka:ymati pero nikwelita, nikowa m' *planta** wa:n nikah..., wa:n poso:ni,</ANNOTATION_VALUE>
