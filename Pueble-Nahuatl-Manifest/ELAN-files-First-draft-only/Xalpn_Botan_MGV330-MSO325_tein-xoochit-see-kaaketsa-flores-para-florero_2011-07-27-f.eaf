        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Pos seki yeha ya de yo:n nimitsilia *azucena**.</ANNOTATION_VALUE>
