        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Ke:mah. Pos yehwa sah yo:ni na:nah nimitstahtanihtoya n' tein tiki:xmati tine:chilih, tasohka:matik miak. Neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
