        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>nikowa. Yehwa ya nika:ketsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>No: mochi:wa, *como que** seki yeh nimitsilia kohkostik mochi:wa,</ANNOTATION_VALUE>
