        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>A:, yehwa. Pos xa: yehwa ya neh niki:xmattok. Yo:n seki, seki mochi:wa ata kahfe:ntah.</ANNOTATION_VALUE>
