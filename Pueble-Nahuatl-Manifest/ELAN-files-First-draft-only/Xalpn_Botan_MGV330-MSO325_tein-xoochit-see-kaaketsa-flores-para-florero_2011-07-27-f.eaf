        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Pero neli nejó:n yeh mochi:wa neli kahfe:ntah wa:n kwaltsi:n ima:tsitsi:n ihkwi:ni xohxoxoktik wa:n pihpitsa:wak ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
