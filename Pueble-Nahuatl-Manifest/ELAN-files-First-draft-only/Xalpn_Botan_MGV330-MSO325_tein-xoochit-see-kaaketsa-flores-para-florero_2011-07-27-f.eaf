        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>A:, wehka:wa taxi:kowa pos no: mah se: ka:ketsto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>A:, sepa seki xo:chitsí:n. Nankahchi:wah ya yo:ni wa:n sepa seki nankita:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>Xa: yehwa ya neh no:, yo:n tikihtowa ihkó:n ixo:chitsi:n ohololtsitsí:n, xa: yehwa ya neh niki:xmattok neh *que**, n' tehwa:n tikto:ka:ytiah *sanjosen..., sanjoseniswat** ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>A:, pos neli. Miak taman ito:ka:y. Neh niki:xmattok iwki i:pa kiliah *que sanjoseniswat** i..., wa:n neli ixo:chio neli yo:n no: niki:xmattok, no: neli ihkwí:nwehwei wa:n neli i:ihkwí:n, neli kwaltsi:n neli poso:ni. Ke:mah, pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>pero komohkó:n tika:ketsa n' teh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>Ke:mah, kwaltia neli, ke:mah ta: ye:kkahkanaktik, kwaltsitsi:n neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Ke:mah, ta: niki:xmattok. Yehwa eski n' tein teh tikto:ka:ytia no: taman wa:n neh no: taman nikto:ka:ytia. Ke:mah, ta: niki:xmattok. ¿Wa:n yo:n, yo:n tein kiliah nejó:n yo:n koyo:po:lxo:chit, no: tiki:xmattok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>Ke:mah, *porque** tehwa:n ompa ne: ka:mpa neh ninemika:n mochi:wa. Mochi:wa pero wehka ya kowtah, kowtah ya mochi:wa no:, ke:mah, kowtah ya *porque** yeh mochi:wa wehweikowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Wa:n mochi:wa no: seki tsitsikitsitsi:n, a:mo semi tel, tel *de a tiro** ihkó:n tsitsikitsitsi:n, pero ta:ki niman, *bueno** poso:ni n' ixo:chiotsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>wa:n no: kwaltsi:n se: ka:ketsa, pero tehwa:n tiki:xmatih koyo:po:lxo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>A:mo, ta: i:n xo:chitsi:ni achi nejó:n mahyá:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>chihchi:chi:ltik, a:mo nikelna:miki ke:niwki wel pero nejó:n kwaltsi:n no: poso:ni wa:n se: ka:ketsa neli no:. Yo:n neli no: nika:ketsani neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>Pero yehwa kiliah koyo:po:lx...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Xa: yehwa ya pos i:n tein nikihtowa neh. *Porque** neli wehweikowit mochi:wa wa:n seki *más** wei mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>A:, ¿n' kohkostik? A:mo, ta: ne: mochi:wa n' ixo:chiotsi:n, no:, no: nejó:n mahyá: chihchi:chi:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts505">
                <ANNOTATION_VALUE>pero nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>yeh neli no: wehweikowit ne: moketsa, ka:mpa moketsa wa:n tehwa:n neli n' ompa ne: kaltsi:ntan a:mo d...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts508" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>ta: onkak ompa *hasta** nehkwí:n, kowtahpa ya n' tehwa:n titalwiah, kowtah ya no: n' onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>Ke:mah. A:,, no: kowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>Tak no:, no: xo:chitsí:n. A:xá: no: taman. Pero yo:n no: kwaltia se: kiteki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>A:, no: kwaltia. No:, no: kwaltia ika se: taa:ketsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>Ke:mah, pos ta: nochi kwaltia, kati:yeski xo:chitsi:ni komo se: kwelita pos kwali se: ka:ketsas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>Wa:n pos yo:n, yo:n seki kiliah, tehwa:n tiki:xmatih kiliah kwa:kwa:nakatsitsi:n, ¿teh ka:n tiki:xmati?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>Yo:n, yo:n chihchi:chi:ltik wa:n, wa:n yeh no:, no: niman, no: niman nejó:n ma:ski tsitsikitsi:n ok n' kowit wa:n no:, no: taki wa:n ixiwyo mahyá: ma:kahkakaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>Xa: tikixmttos no:, pero xa: no: taman t'to:ka:ytia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>Ke:mah, tsitsikitsitsi:n, i:ihkwi:ntsi:n imets..., imetskowyotsi:n wa:n pihpitsaktik wa:n ikwa:pan kipia ya xo:chitsí:n. Ke:mah, yehwa yo:n neh no: niki:xmattok pos komohkó:n no: tiki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts552" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>Ke:mah, pero neli tehwa:n ompa ne: para nikihto:s ne: tokaltsi:ntan a:mo tei, no: onkak no: kowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>*Bue...**, a:mo semi wehka ompa sah ne: ka:mpa neh nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>ne: tehwa:n ne: tota:lpan no: onkak pero pos nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>kowtah ya *siempre**, a:mo semi telkaltsi:ntan, pero mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Mochi:wa. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>Wa:n pos yo:n seki xo:chit, yo:n kiliah a:yo:iswat, no: tiki:xmattok yo:n ih..., yo:n ixo:chio yo:n mochi:wa ata ka:sá: ika a:taw mokehketsa ata ye:kmiak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>¿no: tiki:xmattok, yo:n seki ista:k no: xo:chit, no: tiki:xmattok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>Ke:mah, yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>No: tiki:xmattok. ¿Wa:n yo:n i:pa sentaman sah no: onkak, i:pa nejó:n ista:k sah ata? Ke:mah, *porque** no: ye:kmiak ata poso:ni. Ke:mah. Wa:n ye:kahwiya:k no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>A:, no: tika:ketsa n' teh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>Nochi tika:ketsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>A:, nochi tikaketsa n' tein tikwelita x:chitsi:ni. Ke:mah, pos ta: se: kitstok *que** xo:chit, kwali se: ka:ketsas nochi. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Pos yehwa sah yo:ni nimitstahtanihtoya na:nah, a:mo teihsá: *más**, yehwa sah tein tine:chilwih wa:n tein neh no: nimitsilih, tasohka:matik miak ke:mah. Neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
