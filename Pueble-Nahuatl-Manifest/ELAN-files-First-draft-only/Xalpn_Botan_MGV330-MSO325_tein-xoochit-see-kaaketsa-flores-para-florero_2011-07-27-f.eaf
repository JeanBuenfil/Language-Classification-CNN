        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>A:, ta:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>Wa:n seki, yo:n seki te..., tein kaltsi:ntan xo:chit sah nochi ma:s tikiliah *medio corriente**, yo:n *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>yo:n seki, yo:n achichi i:ntsitsi:n sah ata mokehketsa, yo:n kwaltsitsi:n poso:ni, seki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>seki tikiliah i..., ixkwaltsitsi:n wa:n seki ke:meh yo:n ata, ke:meh yo:n kwaltsi:n chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Wa:n no: onkak n' ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>E:yi taman, eyi, e:yi ta...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>A:, ne: mokehketsa ma:ma:yehyewaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>No: taman. Wa:n e:yi *color** poso:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>E:yi *color** poso:ni xo:chitsitsí:n, a:mo we:wehkapania, achichii:ntsitsi:n sah mochi:wa. A:mo, a:mo wehwei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Miak taman. E:yi taman. E:yi taman, onkak *medio panmoradito** wa:n onkak n' tein kwaltsi:n *como que**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>nik..., ox nikihtowa n' *color de rosa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>A:, pos neli. Ta: nejó:n miak taman onkak xo:chitsi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>wa:n onkak *moradito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>A..., *eso**, ta:taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>A:mo se: ki:xmati. Pos, a:mo tehsá: i:pa ihkó:n timotapowi:skeh para,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>mah tikihto:ka:n timomakah *cuenta** tohto:ni xo:chitsitsí:n onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>Tasohka:matik, neh nimono:tsa niMaría Guadalupe Vázquez, Xalpantzingo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Pos yo:n *cuando** poso:ni no: yo:n xo:chitsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>wa:n ka:n mah..., *bueno** yo:n mah tikihto:ka:n pos kanah ika kipiah wa:n kanah ika a:mo t'piyah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>Pero komo se: motahtania ka:mpa kipiyah, *como que** se: kikowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>No: se: kikowa *porque** telkwal..., yo:n kwa:miyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>kwaltsi:n, kwaltsi:n kwa:miyak ne:n poso:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>O:me taman, yo:n o:m..., o:me taman, onkak ista:k wa:n onkak *como que** chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Nochi iwkitik, *únicamente porque**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>*como que** ista:k wa:n chi:chi:ltik. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts303">
