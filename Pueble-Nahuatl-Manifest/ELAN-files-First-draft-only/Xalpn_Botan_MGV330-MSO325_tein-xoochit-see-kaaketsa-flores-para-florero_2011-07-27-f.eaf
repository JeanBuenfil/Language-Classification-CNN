        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>Ke:mah, nejó:n, ke:mah ke:meh nejó:n teh ne: ka:mpa tinemi pos no: taman ompa n' onkak wa:n, wa:n ma:ski *mismo** yehwa pero a:mo se: ki:xmati.</ANNOTATION_VALUE>
