        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>Ke:mah, niki:xmattok yehwa yo:n *azucena** yo:n chi:chi:ltik wa:n yehwa yo:n seki yo:n pané: iihtik ata yo:n *rosita**,</ANNOTATION_VALUE>
