            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>A:, no: onkak istak. A:mo niki:xmati neh. A:, e:yi taman no:. A:mo niki:xmati. Neh tein nimitsilia, yehwa sah yo:n tein i:pa niki:xmattok.</ANNOTATION_VALUE>
