        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Wa:n okseki yo:n mahyá: sakat ata ne:n ixiwyotsi:n, no: kwaltsi:n poso:ni, ¿yo:n no: tika:ketsani?</ANNOTATION_VALUE>
