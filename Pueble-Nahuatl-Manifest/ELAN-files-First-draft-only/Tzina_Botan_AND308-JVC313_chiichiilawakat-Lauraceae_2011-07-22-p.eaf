        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>No: tata wa:n oso se: kitahtapa:na ihkwi:ntsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>no: tahtapa:ni.</ANNOTATION_VALUE>
