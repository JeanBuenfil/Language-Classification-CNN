        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>Ke:mah, yehwa sah *compadrito** niki:xmattok ne:n chi:chi:lawakat, se: taman sah, a:mo onkak o:me taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>I:pa se:, se: taman sah *compadrito** yo:n. Ke:mah, se: taman sah *compadrito**.</ANNOTATION_VALUE>
