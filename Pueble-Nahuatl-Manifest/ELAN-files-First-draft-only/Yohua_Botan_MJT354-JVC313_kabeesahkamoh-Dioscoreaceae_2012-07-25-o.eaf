            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Pos neh, neh nimono:tsa ne: niMaría de Jesús Tecuaco wa:n niwi:tse ne: Yohualichan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts307">
