        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>Ke:mah acha.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>Ke:mah, ta: yehwa sah ta:to yo:n nimitstahtanih *porque** neli ne: ka:n nochi yeh tikmahmatih ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>totanamakwa:n wa:n... Ta:taman miak onkak nika:n ta:ltikpak. Ye:kneli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>Pos kwali a ne: nika:wí:n timoitakeh wa:n nika:wí:n timona:mikkeh, pos ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>senka ya n' kwali tasohka:matik ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
