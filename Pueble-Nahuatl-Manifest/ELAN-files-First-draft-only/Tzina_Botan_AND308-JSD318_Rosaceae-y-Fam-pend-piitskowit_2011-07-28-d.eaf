        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>*Pero a ver** ehkos to:nal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>tiseya:skeh wa:n tikitaskeh kati:ni i:n tikiliah pi:skowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>Tasohkamatik *que** tine:ch...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>tine:chilwia *que**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>tiki:xmatik wa:n neh no:, a:mo nikmati ox yehwa ya n' tein neh niki:xmati oso xa: no: se:.</ANNOTATION_VALUE>
