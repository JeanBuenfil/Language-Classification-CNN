        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts481">
                <ANNOTATION_VALUE>Pos eski ke:mah.</ANNOTATION_VALUE>
