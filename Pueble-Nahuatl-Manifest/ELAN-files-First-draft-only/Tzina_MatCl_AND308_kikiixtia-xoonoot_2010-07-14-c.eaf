        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Pos seki ompa ika se: tahtalpia *o** seki ihkó:n ika se: mo...,</ANNOTATION_VALUE>
