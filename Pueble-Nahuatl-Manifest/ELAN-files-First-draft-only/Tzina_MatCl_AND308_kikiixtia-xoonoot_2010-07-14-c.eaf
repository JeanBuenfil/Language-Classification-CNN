        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>se: motapilowilia ihkó:n ahko pos se: kita:lia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>wa:n yehwa yo:n tamali:n.</ANNOTATION_VALUE>
