        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
