    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="Anastacio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>Pos yo:n no: niki:xmati ne:wí:n kowtah ne:n pos a:kin tine:chtahtania no: wa:n xa: niki:xmati ne:n, ne:wí:n kowtah ke:meh i:n tinemih, tite:tekilihtinemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>*O** ne:wí:n tik..., tikwitih kowit pos tikitah ne:n ompa yetok, niman tikihtowah i:n chi..., chiko:ma..., chiko:mpah, tehwa:n tikiliah chiko:mpah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Nochi *igual** ki:sa. Wa:n ompa ne: ke:masá: ike:span yetok de yo:n xo:no:kowit, ompa pepechiwtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>Wa:n ihista:k ne:n i..., iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>Wa:n i..., ixo:chio tepitsi:n ki:sa nika:wí: ike:span wa:n moka:wa taihtik sah ne:n iyo:la:n, ista:k iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>Wa:n yo:n no: kihtowah no:, no: we:lik iteyo wa:n pos i:n xiwtsi:n no:, no: kwali kihtowah para pahti, ne:n ixiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Chiko:mpah ne:n, ne:wí:n nochi onkak ne:wí:n kowtah, ka:sá: ika se: kita ne:n ike:s..., yo:n ike:span mopepechowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Mopahpampilowa ihkó:n kos..., kowke:span, ompa ne: mo..., yo:n a:mo nikihto:s wehkapantia yo:n. *O** de ta:lpan e:wi, yo:n ike:span de n' kowit ompa mopepechowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Entó:s ompa mopepechowa wa:n pos ikwa:pan *cuando** ne:n i..., ima:xiwyo achi ma:pohpototik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Ima:xiwyo. Wa:n ka:mpa ne: tamiti a de n' ixiwyo kwa:..., kwa:chihchi:chi:ltik, de ne:n ahko ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>Wa:n ompa ke:mah ompa mosa:lohtiwi:ts a ne:n iteyo.</ANNOTATION_VALUE>
