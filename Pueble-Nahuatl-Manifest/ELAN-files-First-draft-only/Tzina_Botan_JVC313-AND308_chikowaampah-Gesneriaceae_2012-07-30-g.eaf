        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n neh nik..., nikmati sah wa:n tik..., no: xa: kachi tikmattos ne:n kowtsitsi:n ne:wí:n no: tikita wa:n yehwa yo:n  kowta:kka.</ANNOTATION_VALUE>
