        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>Pos yo:n neh a:mo ke:man nikita ne: mah panwetsi ne:pa, mah wetsto tatampa wa:n mah ixwa. Neh nikita nochi kos..., kowke:span ka:mpa ne:n itsmol de n' teisá: kowtsi:n, xo:no:kowit *o** teisá: katí:n eski kowtsí:n xi:kalkowit oso ...</ANNOTATION_VALUE>
