        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>Wa:n nehjó:n para i..., i..., impoxko kinta:liliah, de iyo:lpan kinta:liliah, ne: ika refi:noh kini..., ki..., kinelowah</ANNOTATION_VALUE>
