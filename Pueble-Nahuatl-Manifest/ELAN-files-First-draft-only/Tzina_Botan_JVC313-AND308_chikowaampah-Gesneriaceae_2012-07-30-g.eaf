        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>Ompa moskaltia ya wa:n yo:n tein chika:waya ya moahkoi:xkepa ya, paniá:n moka:wa ya yo:n iteyotsi:n ista:k, ista:k pochi:ntok.</ANNOTATION_VALUE>
