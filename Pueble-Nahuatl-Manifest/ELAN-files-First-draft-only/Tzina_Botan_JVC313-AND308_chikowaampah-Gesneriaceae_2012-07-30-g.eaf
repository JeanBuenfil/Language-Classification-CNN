        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
