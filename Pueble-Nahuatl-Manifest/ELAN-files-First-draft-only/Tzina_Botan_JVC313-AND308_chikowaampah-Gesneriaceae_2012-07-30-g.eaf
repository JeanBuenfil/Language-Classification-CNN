                <ANNOTATION_VALUE>Itech kahbe..., kahbe:nke:span mota:lia semi, ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Miakka:n onkak, yo:n a:mo mone:neki.</ANNOTATION_VALUE>
