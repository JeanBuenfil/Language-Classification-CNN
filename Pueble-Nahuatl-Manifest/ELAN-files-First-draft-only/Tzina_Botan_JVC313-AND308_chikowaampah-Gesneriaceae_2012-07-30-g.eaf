        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>Yo:n tepe:xo:no:t, kahfe:nke:span, ka:mpa a:mo wehkapan pos ompa ne: onkak nehjó:n, nenjó:n ne:n ata yo:n ...</ANNOTATION_VALUE>
