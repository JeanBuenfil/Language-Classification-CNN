        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>A:mo ke:man se: kita kikwah, yo:n nochipa se: kita ta:ktok ne:n kowtet. A:mo, a:mo kikwah yo:n chiktehmeh, nió:n tei.</ANNOTATION_VALUE>
