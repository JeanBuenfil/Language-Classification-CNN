        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>Iwki yo:n mochi:wa kowtetsi:n. Mm., a:mo, yo:n kowke:span nochi mochi:wa. Tak a:it ke:ní:w yo:n tak ox iteyo kwi:kah ne: kowke:span no:, mm, mm.</ANNOTATION_VALUE>
