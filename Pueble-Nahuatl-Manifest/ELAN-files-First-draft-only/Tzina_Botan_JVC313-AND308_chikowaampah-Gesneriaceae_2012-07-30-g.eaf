        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>Wa:n *cuando** a:mo se: kineki ihwa:k se: kahsi. Kowke:span mochi:wa, ke:mah kowke:span.Yo:n a:mo nikihto:s kito:katih, yo:n ike:span de, tsi..., kowke:span.</ANNOTATION_VALUE>
