        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>Ke:mah, nikitani ompa ne: itech kahbe:nke:span mochi:wa, ke:meh yo:n we:wehkabe:n, ka:n se: kichipa:wa, ompa, ompa ixwa yo:n ko..., yo:n xiwtsi:n.</ANNOTATION_VALUE>
