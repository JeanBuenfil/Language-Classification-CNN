        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Wa:n neh nimolia neh *que** iwa:n, pané: iwa:n no: tsiktsi:n *aceite**. Ke:mah, *porque** pos nimolia neh para nexwitil. Ke:mah, kihtowah yo:n nexwitil para kixiti:nia ya yo:n tikonex. Ke:mah, nejó:n neh n'mattok *que** iwki yo:ni neli ne:n nejó:n pilimeh mah se: kinta:lili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>A:, yo:n tikihtowa chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
