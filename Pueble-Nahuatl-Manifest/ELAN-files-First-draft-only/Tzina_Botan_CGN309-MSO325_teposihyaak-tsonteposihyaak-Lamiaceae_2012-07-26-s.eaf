        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>Ke:mah, ta: nejó:n, neli pos neh n'mattok neli *que** i:pa kiliah, neh n'mattok i:pa niki:xmatini i:pa nika:kakilia:ya note:iskaltihka:w i:pa kilia:ya teposihya:kxiwit, *porque** neli... Ke:mah neli ta: ta:taman nikilia neh se: kito:ka:ytia pero neli ata n' ixiwyo nikilia neh mahyá: ye:k... Wa:n ye:k ma:ahalaxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>wa:n ii:ka:mpa nikilia neh mahyá: yo:n pehpetaktik wa:n ii:xko no: taman. Ke:mah, no: taman, pero neli i:pa n..., i:pa mochi:wa neli ke:meh i:n ohohte:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Wa:n yo:n a:mo, a:mo nikihto:s akah kito:ka, yo:n mochi:wa sah. Mochi:wa sah, yo:n a:mo moneki nikilia neh mah se: kito:kto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Iwki... Ke:mah, mochi:wtiw *más**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Ke:mah, neli ta: wel... Ke:mah, nimolia neh pos neli yo:n a:mo, a:mo se: kito:ka. A:mo, wa:n nió:n no: nikihto:s nikilia neh *que** tikihto:skeh ka:n timopahti:skeh ika *porque** nejó:n tikowatih, yo:n a:mo se: kikowa. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>Ke:mah, tein sehseltik wa:n mah se: ki..., mah se:..., mah se: mopahti a ika nikilia neh *porque** pos sayoh *que porque** t'nekiskeh nikilia neh a:mo timokwili:ti:wih *porque** neli yo:n a:mo mokowalani. A:mo. Ke:mah, pos de onkak sah nikilia neh mah se:, mah se: kikwi para pahti wa:n mah te:na:mikiskia nikilia neh pos yehwa sah *más** moneki *porque** neli n..., neli neh n'mattok yo:n neh note:iskaltihka:w neli no: mota:liliaya pero yehwa yo:n a:mo nikelna:miki ox,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>ox kikwia yehwa sah xiwtsi:ni kikahkawa:ntia:ya wa:n ika motahtatia:ya pero neli no: kwali para se: imetswa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Kikawa:ntiah. Ke:mah, *porque** ta: tak... Ata neli toht..., ke:meh se: taxi:ko:s. Ke:mah, para mah nejó:n kahkawa:nika:n nikilia neh se: italwayowa:n tak. Ke:mah, *porque** ta: tak...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>yo:n nikilia neh mahyá: sese:xtok wa:n tak yo:n xiwtsí:n nimolia neh xa: toto:nik eski *por eso** te:na:miki. Ke:mah *porque** nikilia neh pos de nejó:n te:kokoh neli se: mota:lilia. Se: mota:lilia. Ke:mah pos ta: nikilia neh onkak miak taman xiwtsitsi:n, sayoh mah se: kimati sah tohtoni m' pahti.Se: mota:lilia. Ke:mah pos ta: nikilia neh onkak miak taman xiwtsitsi:n, sayoh mah se: kimati sah tohtoni m' pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>A:, yehwa:n i:pa, yehwa:n i:pa nió:n no: ki:xmatih ok n' ekintsi:n, ka:n ki:xmatih ok nikilia neh, se: ki..., se:..., *sólo** ki:xmatiskeh pero mah se: kinilwi nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Mah se: kinilwi pero ihkó:n para kitaskeh nikilia neh a:mo *porque** ke:meh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>A:mo *porque** ke:meh a:man i:n nikilia neh se: n..., se: teihsá: ke:meh i:n te:koko:s se: pilitsi:n oso akah nochi i..., te:talo:chtiah iwa:n ne: koyo:tapahtihkeh. Ke:mah wa:n ompa ya nikilia neh i:ksá: *hasta** ompa se: te:ilo:chtiah ya wa:n iwki a nikilia neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Kanah, *porque** pos nikilia neh a:mo tikwih yehwa ok ke:meh achto i..., tote:iskaltihka:wa:n kikwiah miak taman xiwpah. A:man a:mo iwki ok. A:ah, a:man nikil..., mopatak a neli nochi nikilia neh. Ke:mah, ka:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>Kanah, nochi yehwa sah wa:n yehwa de yo:n... Ke:mah wa:n de yo:n i:pa sentaman sah, tak a:mo onkak miak taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>Ata neli, i:pa sentaman sah. Ke:mah, i:pa yehwa sah, a:mo nikihto:s onkak ke:meh yo:n seki kihtowah miak taman onkak, o:me taman oso e:yi taman, i:pa s..., i:pa sentaman sah no: n' teh tikitani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Ke:mah, ta: neh neli i:pa no: iwki neli nikitani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Kanah, ka:n ki:xmatih ok neli, ke:mah. Pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>ka:n teihsá:, tasohka:matik miak *que** tine:chilih para toni no: m' pahti wa:n ihkó:n tikmatiskeh para no: t..., timo..., timota:lili:skeh nikilia neh. Ke:mah, pos... Ke:mah, pos miak tasohka:matik tein tine:chilwih. Neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
