            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Wa:n yo:n nimolia neh kimpo:xpikih ika se: tilmahtsí:n ihkwí:n kinkwi:ltiah. Ata neli.</ANNOTATION_VALUE>
