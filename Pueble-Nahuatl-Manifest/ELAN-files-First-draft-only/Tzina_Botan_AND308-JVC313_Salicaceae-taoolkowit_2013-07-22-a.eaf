        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>Wa:n, wa:n yo:n de n' tikihtowa pahpatachtik, xa: no: kwaltias xa: para kalkowit de n..., n..., n..., n' istmol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
