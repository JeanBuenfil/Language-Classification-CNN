        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>*bueno** nimolia pero tao:lkowit no: *porque** no: tao:lkowit wa:n no: iwki a n' ita:kilo, no: iwki n' ke:meh ta:ki, ohololtik wa:n ista:k, no: iwki a no: n' i..., n' in..., ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>Wa..., ke:mah, wa:n i:n seki i:n tein</ANNOTATION_VALUE>
