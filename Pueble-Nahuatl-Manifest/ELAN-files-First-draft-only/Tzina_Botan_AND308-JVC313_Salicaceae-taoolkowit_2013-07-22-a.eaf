        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Pos neh nikita ne: onkak ne: yo:n tao:lkowit seki, yo:n</ANNOTATION_VALUE>
