        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>mochi:wa tihti:ltik n' i..., nimitsilia n' imetskowyo no: iwki n' iteyo no: i...,</ANNOTATION_VALUE>
