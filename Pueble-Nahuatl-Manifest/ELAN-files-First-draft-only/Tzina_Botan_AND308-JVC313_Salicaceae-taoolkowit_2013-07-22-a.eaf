        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Wa:n yo:n no: a:mo kintakechiliah, ihko:ni tak ne:n</ANNOTATION_VALUE>
