        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>ke:meh kiliah tih..., tihti:ltik n' ipanko ata ne:n tao:lkowit tih..., tihti:ltik, *como que** mahyá: *medio**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>ke:meh yo:n ti:ltiksa:wapah, iwki n' ipanko no: n' tao:lkowit.</ANNOTATION_VALUE>
