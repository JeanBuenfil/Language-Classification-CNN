        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>Yo:n pala:ni sah. Ke:meh ehkaw sah yo:n nochi ne:n.</ANNOTATION_VALUE>
