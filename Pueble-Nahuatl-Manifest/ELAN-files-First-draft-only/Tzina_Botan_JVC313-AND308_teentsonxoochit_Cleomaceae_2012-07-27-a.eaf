        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>Wa:n okseki ne: seki kiliah kowtahwi:tsikitsitsi:n kachi wehwei:n, kachi wehwei:n, wa:n yo:n,</ANNOTATION_VALUE>
