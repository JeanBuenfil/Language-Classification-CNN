            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts643">
                <ANNOTATION_VALUE>Sepa ixwa, sepa ixwa wa:n...</ANNOTATION_VALUE>
