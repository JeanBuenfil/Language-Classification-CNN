        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>sake:ra ka:n o:men mota:liah n' ima:te:mpan wa:n komo a:mo yowih ne:wí:n pata:nih, ne:wí:n mota:li:tih, ma:ski tsikitsi:n ne:n kowtako:t,</ANNOTATION_VALUE>
