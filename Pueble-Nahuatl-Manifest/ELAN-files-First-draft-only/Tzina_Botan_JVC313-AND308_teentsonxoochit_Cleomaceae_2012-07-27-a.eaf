        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>Katí:n mopata n' ixo:chiyo, ne:n n' oksé: *mata**, i:pa n' oksé:, n' os..., n' oksé: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
