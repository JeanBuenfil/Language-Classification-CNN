        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>Semi se: kitope:wa ne:wí:n pos wetsiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>Ke:masá: se: taksa ipaniá:n pos mo..., mochihkolowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>Ke:mah, yema:nik wa:n yo:n neh nikmattok yo:n a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>a:mo se: kikwi para teihsá: kowtati:l oso se: kichichino..., yo:n,</ANNOTATION_VALUE>
