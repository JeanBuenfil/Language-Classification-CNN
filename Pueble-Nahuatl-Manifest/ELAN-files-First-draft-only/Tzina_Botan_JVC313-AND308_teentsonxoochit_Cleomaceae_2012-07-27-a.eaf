        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>Neh yehwa sah no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>Te:ntso:nxo:chit *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>kipia n' ite:noh ihko:ni we:weyak ne:n i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts731" TIME_SLOT_REF2="ts733">
                <ANNOTATION_VALUE>Ke:mah, n' ii:xpi:l, ke:meh eskia n' ii:xpi:l, ihkó:n we:weyak, ke:meh eskia n' ite:ntso:n we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts735" TIME_SLOT_REF2="ts737">
                <ANNOTATION_VALUE>pero pos nijó:n we:weyakaxtik, *por eso** kiliah te:ntso:nxo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>Wa:n *siempre** ihkó:n miak tokni:wa:n ihkó:n *siempre** ki..., kitah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>Wa:n pos ki..., ki:xmattokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>Wa:n no: tehwa:n pos no: tiki:xmattokeh wa:n nika:n ne: ti..., timonohno:tstokeh pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>kwaltsi:n no: tech i:n, nika:n tietokeh pos se: mo..., motapowia ki:ní:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>ki:ní:n yetok, ki:ní:n moskaltia nijó:n xo:chitsí:n.</ANNOTATION_VALUE>
