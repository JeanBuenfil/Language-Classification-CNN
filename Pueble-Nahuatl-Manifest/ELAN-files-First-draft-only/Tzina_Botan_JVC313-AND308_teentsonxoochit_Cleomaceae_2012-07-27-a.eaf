        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>meh nika:n i:n tietokeh, pos nochi kwaltsi:n mah timonohno:tsaka:n, nochi mah timotapowi:ka:n,</ANNOTATION_VALUE>
