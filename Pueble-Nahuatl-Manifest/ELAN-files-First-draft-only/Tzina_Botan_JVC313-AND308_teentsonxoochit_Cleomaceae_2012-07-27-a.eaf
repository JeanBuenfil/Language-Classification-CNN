        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>Wa:n sepa xi:i:ni a tak de wa:ki, nochi ne:wí:n xi:i:ni a, a:mo</ANNOTATION_VALUE>
