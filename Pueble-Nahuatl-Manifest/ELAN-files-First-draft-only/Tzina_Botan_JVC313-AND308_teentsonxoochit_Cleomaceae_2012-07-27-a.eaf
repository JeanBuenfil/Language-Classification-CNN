        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>A:mo se: kikwi, ta:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>Pos yehwa yo:n neh nik..., nikmattok yehwa sah, *a ver** teh xa:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts699">
                <ANNOTATION_VALUE>xa: *más** tikmati nika:n ne:n tietokeh, pos ti...,</ANNOTATION_VALUE>
