        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>pos tikitstinemih ki:ní:n yetok se: *matita**, ke:meh i:n xo:chitsí:n, pos nochi tik..., tikitah ki:ní:n,</ANNOTATION_VALUE>
