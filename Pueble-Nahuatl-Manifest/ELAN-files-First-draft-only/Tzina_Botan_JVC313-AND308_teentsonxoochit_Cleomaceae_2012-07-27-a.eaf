        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts644" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>Miak seki kitamo:tah wa:n yo:n semi teltsi:nyema:nik.</ANNOTATION_VALUE>
