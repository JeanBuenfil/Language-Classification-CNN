        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
