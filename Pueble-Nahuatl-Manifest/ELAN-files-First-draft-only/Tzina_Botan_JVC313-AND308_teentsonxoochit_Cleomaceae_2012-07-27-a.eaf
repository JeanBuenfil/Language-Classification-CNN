        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>seki se:..., ihkó:n i:..., i:pa a:mo kikwih, yo:n tak sayoh para tapala:n ne:n ki..., kita:liah wa:n a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts680" TIME_SLOT_REF2="ts682">
