        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>Sayoh nochi n' ima:yo, nochipa ne: xo:chitsí:n nochi achichi.</ANNOTATION_VALUE>
