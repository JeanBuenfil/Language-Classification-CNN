                <ANNOTATION_VALUE>Na:no, xite:chnohno:tsa achto de i:n ke:ní:w se: kikwi wa:n ka:ni mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>wa:n toni ika pahtia [wa:n toni n' kipahtia, wa:n toni ika tikpahtia]</ANNOTATION_VALUE>
