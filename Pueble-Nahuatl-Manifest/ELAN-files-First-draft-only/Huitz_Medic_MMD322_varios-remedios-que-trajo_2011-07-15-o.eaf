                <ANNOTATION_VALUE>Wa:n ika yo:ni sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>kwali tite:chtapowi:s ka:ni, ke:ní:w mota:lia yo:n xi:yo:t wa:n a:konimeh n' kinkwi, ox a:kin eski *o**, ox te:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
