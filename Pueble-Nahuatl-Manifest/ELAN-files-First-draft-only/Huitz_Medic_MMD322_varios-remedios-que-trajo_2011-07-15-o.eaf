        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Wa:n i:n ia:yo se: tai, ke:niwki, xa: tete:lik, koko:k, chichi:k.</ANNOTATION_VALUE>
