        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>I:n okma, kwali tite:chtapowi:s ox kowit, xiwit, wa:n ke:niwki n' ixo:chio.</ANNOTATION_VALUE>
