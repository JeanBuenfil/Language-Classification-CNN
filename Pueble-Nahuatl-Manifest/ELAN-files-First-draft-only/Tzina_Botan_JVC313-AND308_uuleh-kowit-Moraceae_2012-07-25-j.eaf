        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>n' iteyo *porque** n' iteyo chihchi:chi:ltik ihkó:n wa:n de, de panwetsi a,</ANNOTATION_VALUE>
