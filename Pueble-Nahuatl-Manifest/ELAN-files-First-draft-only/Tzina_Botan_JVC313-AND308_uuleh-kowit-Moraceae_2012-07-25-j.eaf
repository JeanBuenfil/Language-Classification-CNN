    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="Anastacio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>A:, n' *hulekowit**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Ke:mah, pos neh nik..., nimitsili:ti de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>niki:xmati se: kowit nika:n, yetok nika:n a:nalpa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>kwaltsi:n mela:wak, mela:wak yo:n kowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>wa:n pos yo:n a:mo, a:mo nikmati kox kwaltias para kowtati:l, ta:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>yo:n kikwih *solamente** ke:meh i:n kichihchi:wah ne:n *mangas** ihkó:n *de que**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>ke:masá: ika se: mopanta:lilia para a:mo se: a:paliwis yehwa yo:n kichihchi:wayah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>n' *antes**. Wa:n yo:n kike:stehtekiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>nika:n kitehtekiah nika:n wa:n ompa te:temowa:ya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>n' a:tsí:n ista:k n' icho:kil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>De ompa ke:mah kisentilia:yah wa:n ki..., kichi:wayah nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>para ne:n *manga** tikilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Ne:, wa:n no: kikwiah ke:meh yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>kone:meh, ka:wiltiah yo:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>ki:ní:n kiliah, kakohta:tamo:tah ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>yo:n itech i:n *cancha**, nikelka:w. Ajá, kwetax...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>kwetaxolol. Entó:s yehwa yo:n 'kwiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>wa:n kichihchi:wayah, kiki:xtia:yah ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>ihkó:n kitamachi:wayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>wa:n ke:mah kitetsi:lohtia:yah, kitetsi:lohtia:yah *hasta** ihkwí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>ki..., [ih]kwi:ni mochi:waya, se: ololtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>E:he, pané: xokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>Ololtik mochi:waya ke:mah kahkota:tamo:tah ya ne:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>*[Por]que antes** a:mo teh onkaya ke:meh kintsi:n yo:n ka:wiltiah yo:n wehwei, yo:n ista:k oso yo:n chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n kone:meh para ma:wiltia:yah ne:pa ka:mpa ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>ne: momachtia:yah, yehwa yo:n kikwiah, kololchi:wiah[kololchi:wayah], yo:n ohololtik kichi:wayah wa:n kahkota:ta:mo..., no: ahkotsikwi:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Pero yo:n semi kinkokowa:ya n' kone:meh, pos ta: ye:ktakwa:wak. Takwa:wak wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>yehwa yo:n neh nikmattok ne:n ya:ya n' ixo:chiyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>ya:ya ne:wí:n tama:te:mpan hkó:n wa:n mosa:lohtia:ya ihkwi:ntsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Mosa:lohtia:ya wa:n ke:mah de,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>de pa:wetsi a ihkó:n, ye:kpa:tia. Pa:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Wa:n nochi n' ima:yo ya:ya ihkó:n, nochi ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Pampi:xo..., pampi:xowa n' ima:xiwyo nochi, pampi:xowi a. kwowit sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>Kowit sah mochi:waya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>wa:n pos yehwa yo:n neh nikmattok, yehwa yo:n nochi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>*Hule..., hulecho:kil** kikwiah wa:n de wa:kia kwaltsi:n ololtik mochi:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>*Porque antes** neh nikitak ne:n kone:meh momachtia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>wa:n a:mo teh katka ne:n okseki, ke:mehkintsi:n yeh ka:wiltiah, nijó:n i..., kahkota:tamo:tah, seki ista:k seki chi:chi:ltik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>ke:mih i:n kikwih ka:mpa ne: momachti:tih n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>kone:meh pos yehwa yo:n ki..., kwi:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Wa:n *antes** a:mo teh katka yehwa yo:n kike:stehtekitih ne:n *hulekowit**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>kke:stehtekih wa:n wi:tsa ya, kichiayah ika se: xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>Ika xiwit *porque nailon** a:mo teh onkaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Ika se: xiwit, yo:n kikixikili..., x..., kikixikilit n' ixiwyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>*o** kikwiah okseki xiwit yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>nexkoko:kiswat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Kikwiah sake:ra ka:n o:me,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>wa:n ompa kite:nketsayah ne: wa:n ihkó:n 'kwiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>wa:n ke:mah de ki..., kwaltsi:n kita:lia:yah wa:kia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>De wa:ki a kiki:xtia:yah ihkó:n, ke:mah kitetsi:lowa:yah, kitetsi:lowa:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>entó:s mochi:waya kim..., ke:meh eskia xokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>ne: xokot. Ke:mah, kitayah ne:, kahkota:tamo:tayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>Ke:mah mota:tamoti:lia:yah ya n' kone:meh ihkó:n, pos yehwa yo:n 'kwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>Wa:n sepa para ne:nimitsilia ne:n *manga** kikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>Nochi kikwiah yo:n wa:n kichihchi:wayah nika:n, nika:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>kichi:wayah ne:, pero nika:n i:n kwesala:n a:mo, a:mo nikmati kox kichi:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>Pero ompa ne: kichi:wayah, pero kintsi:n a:mo no: nemi ok n' ta:tahtsi:n. Xa: tikmati, mikik ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>Yehwa yo:n kichi:wayah, neh nik..., neh nikitaya *porque** ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>ke:masá: nia:ya wa:n nikitaya ne: kichi:wtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>kichi:wtok, n' kwesala:n wa:ltanamakaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Kilia:yah ne:n Gaspar, pero kintsi:n pos a:mo nemi ok no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n wehka:w neh, neh nikitak ne: a:na:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>nika:wí:n pané: nikita a:mo kachi tei yo:n *hulekowmeh**, a:mo semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>Pero nika:n i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>nika:n nochi i:n a:na:lpa, nika:n Tozán, A:te:noh, nochi ka:mpa se: kinekis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts235">
