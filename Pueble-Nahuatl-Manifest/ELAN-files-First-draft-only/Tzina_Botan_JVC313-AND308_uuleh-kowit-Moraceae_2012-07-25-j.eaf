        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>A:, o:me taman.</ANNOTATION_VALUE>
