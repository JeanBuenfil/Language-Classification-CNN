        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>Wa:n i..., ipanko takwa:wak, mahsi yo:n o..., *aceitekowach**, mahsi, mahsi.</ANNOTATION_VALUE>
