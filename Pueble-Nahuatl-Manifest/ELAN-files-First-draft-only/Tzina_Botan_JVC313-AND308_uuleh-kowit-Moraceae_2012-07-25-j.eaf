        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>Pa:xi:i:ni a de tsahtsaya:ni, tapa:ni.</ANNOTATION_VALUE>
