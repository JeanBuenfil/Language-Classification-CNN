        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>Ih..., ihkó:n de wehwei ne:n i:n kowtet,</ANNOTATION_VALUE>
