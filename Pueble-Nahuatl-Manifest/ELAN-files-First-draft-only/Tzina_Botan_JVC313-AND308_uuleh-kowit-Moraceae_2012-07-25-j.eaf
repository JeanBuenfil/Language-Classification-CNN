        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>masá: moka:wa sayoh ne:n sayoh ahko ne:n i..., n' imahma:yo,</ANNOTATION_VALUE>
