        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>pero a:mo kipia ok n' ixiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n neh niko:nkwia no:, yo:n no: kwaltia para pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>Yo:n no: kwaltia para pahti, para se: itan wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>yehwa ya yo:n nikin..., nikino:nkwi:lia:ya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>tokni:wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>wa:n yeh ika mopahtia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Kita:liah, kikwiah seh se: tilmahtsí:n wa:n kita:liayah ka:mpa ne: te:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nimitsilia yo:n kikwiah semi ne:n, para ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>eh..., a:wil wa:n yehwa ika kchihchi:wayah ne:, para se: yo:n se: mopantsakwa ne:n *manga**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts345">
