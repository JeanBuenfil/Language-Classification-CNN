        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>pos se: kita:lia, se: kikwiti a n' cho:kiltsí:n wa:n, wa:n se: kita:lia.</ANNOTATION_VALUE>
