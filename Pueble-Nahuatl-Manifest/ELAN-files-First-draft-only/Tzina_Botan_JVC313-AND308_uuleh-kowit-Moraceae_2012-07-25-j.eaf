        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>Wa:n yo:n no: kikwah ne: chiktehtsitsi:n *o** chechelo:meh *o** chikteh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>Tahtakwa:wak no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>Wa:n yo:n, yo:n *de que** kisa:lowah, kikohkoyo:niah tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>Pos yehwa yo:n neh a:mo nikmattok, nikmattok yehwa i:n oksé: *hulekowit** yo:n, yo:n de m' pa:ti de paxi:i:ni a yo:n oh...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>pa:nxi:i:ni a wa:n pa:ti n' i..., n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Pero yo:n neh a:mo no: nikmati kox</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>kox kikwah ne:n chiktehmeh, ox, ox ch..., chechelo:meh, a:mo ke:man nikita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>Yo:n nochi ma:wilowa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Wa:n miak tokni:wa:n de nika:wí:n oso ne:wí:n, miak a:mo ki:xmatih, a:mo ki:xmatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>A:, tikto:ktok ne:n, ¿wa:n kwa:..., wa:n ka:nachi to:n..., ka:nachi xiwimeh kich..., kichi:wa para wehkapania?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>A:, ne: ke:man ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>Aha, ne: ke:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>Na: miakeh ompa..., wa:n ompa nochi nantatsi:ntokakeh de ki:n eski ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>Ekintsi:n miak...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>A:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>A:, n' wehka:w ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>Ne: ke:man ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>A:, *de pimienta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>Pos nika:n a:mo nochi kwaltia wa:n pos ne: *matita** de n..., de n' tikto:kak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>ekintsi:n we:i a, wey..., we:ikowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>Wehkapan ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>*A ver** wa:n yo:n a:mo se: kimati kox kikwiskeh n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>koyo:tsitsi:n, kintsin ts..., t...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>¿Wa:n yo:n ke:n kimatteh *que** kwaltia para ne:n ta..., tama:ta..., tama:chihchi:walis?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>*Casi** momoya:wak wa:n ki:sak nochi n' e:wat wa:n moka:wak sayoh n' te...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>n' itetsitsi:n[iteyotsitsi:n]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447" TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>Nochi kite:mo:toh ne: mokowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>Neh nikilih pero nik..., nikwalta:kat, niki..., neh a:mo n'neki tomi:n. Kite:mo:toh wa:n kichihchi:wah wa:n kinamakih nika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>W..., wa:n yo:n kowit a:mo ke:man tike:stehteki mah ki:sa n' icho:kilo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>*Porque** komo se: kike:stehteki, komo semi wehkatan se: kiteki no:, no: pala:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459" TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>Wehka:w ya, wehka:w ya nijó:n ne:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>Tikto:kak. ¿Wa:n yo:n tikto:kak katka *de bolsa o, o casi de** ihkó:n tawiwital?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>A:, n' iteyo, a:, n' iteyo wa:n ompa ixwak a itech n' ta:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a466" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>Ka:ns ika tikta:..., a:mo no: semi wehkatan tikto:kak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>Ke:meh eskia yo:n chalawih n' i..., n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a471" TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>Pos nika:n neh a:mo niki:xmati de yo:n, nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts745">
                <ANNOTATION_VALUE>niki:xmattok de i:n se: *hulekowit**, tein nimitsilia ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a475" TIME_SLOT_REF1="ts747" TIME_SLOT_REF2="ts749">
                <ANNOTATION_VALUE>chi:chi:ltik n' iteyo wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477" TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>panxi:i:ni pa:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>A:, no: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>No: taman, ke:meh i:n seki ma:we:weyak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts768" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Ma:weyak wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts772" TIME_SLOT_REF2="ts775">
                <ANNOTATION_VALUE>Wa:n panxi:i:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>Tahtapa:ni. Takwa:wak ne:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>ke:meh yo:n tio:kowit, yo:n mahtsaltio:kowit n' i..., n' iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>Teltakwa:wak *más**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>Yo:n yeh ise:lti tahtapa:ni, a:mo se:..., a:mo se: kitahtapa:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>A:, wetsiti ne:wí:n wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>Pos kwaltsi:n no:, sayoh *que** a:mo se: kimati, ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts810">
                <ANNOTATION_VALUE>ki:ní:n yetok n..., wa:n kwaltsi:n nika:n timo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts811" TIME_SLOT_REF2="ts813">
                <ANNOTATION_VALUE>timonohno:tstokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>nochi timomakah *cuenta** ki:ní:n, ki:ní:n yetok se: ta:kilo:t, ki:ní:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>kiní:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts828" TIME_SLOT_REF2="ts831">
                <ANNOTATION_VALUE>Ke:mah, yo:n *hulekowit** yeh nimitsilia ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>nochi kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>kwaltia para ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>*manga** wa:n kwaltia nimitsilia oholol..., oholol...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts844" TIME_SLOT_REF2="ts846">
                <ANNOTATION_VALUE>kwetax wa:n sepa para ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts848" TIME_SLOT_REF2="ts851">
                <ANNOTATION_VALUE>Ke:mah de yo:n no: kwali, se: kikwiti tsikitsi:n wa:n se: kpepechowilia ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts852" TIME_SLOT_REF2="ts853">
                <ANNOTATION_VALUE>ma:nsá: se: te:iliah, xa:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts854" TIME_SLOT_REF2="ts855">
                <ANNOTATION_VALUE>xa: tikmati katí:n ne:n para se: mopahti:s se: i..., se: itan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts857">
                <ANNOTATION_VALUE>ne:chkokowa se: notan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>Komo se: kimati, pos nimankihto:s nikmattok, entó:s xa: tiknekis xte:chkwi:li:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>Pos se: kikwiti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>Se: kikwiti a wa:n yo:n ka nochi se: momaka ne:n nika:n timonohno:tstokeh, nochi timotapowihtokeh, timomakah *cuenta** katí:n kwali wa:n katí:n de n' ika se: kichihchi:was teihsá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527" TIME_SLOT_REF1="ts874" TIME_SLOT_REF2="ts875">
                <ANNOTATION_VALUE>Katí:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>pi:pilmeh *o** tota:tahwa:n kimattoyah ihkó:n *de que** ki:ní:n, para ton nijó:n kwaltia wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts878" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>pos nika:n itech i:n xola:lpan, a:mo nochi tikmatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts888">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts891">
                <ANNOTATION_VALUE>Yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts895" TIME_SLOT_REF2="ts897">
                <ANNOTATION_VALUE>Entó:s neh, neh yehwa sah ne:n nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts905">
                <ANNOTATION_VALUE>No:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts909">
                <ANNOTATION_VALUE>Pos kwaltsi:n no: mah nochi se: kimati katí:n topah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>Masá: pos ne:wí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>tapahti:lo:ya:n se: kikwiti a:mo no: te:namiki, pero komo se: kimattok i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545" TIME_SLOT_REF1="ts920" TIME_SLOT_REF2="ts922">
                <ANNOTATION_VALUE>*hulecho:kil**. Kihto:s pos niow nikwiti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547" TIME_SLOT_REF1="ts926" TIME_SLOT_REF2="ts928">
                <ANNOTATION_VALUE>Sayoh mpó:n, mpo:wí:n, a:mo no: onkak nijó:n mpo:wi:ni sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549" TIME_SLOT_REF1="ts930" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>onkak no: wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts934" TIME_SLOT_REF2="ts937">
                <ANNOTATION_VALUE>Wehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554" TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts945">
                <ANNOTATION_VALUE>Pos neh nimono:tsa..., niwa:le:w de ne: xola:lpan San Miguel Tzinacapan, nimono:tsa Anastacio Nicolás Damián.</ANNOTATION_VALUE>
