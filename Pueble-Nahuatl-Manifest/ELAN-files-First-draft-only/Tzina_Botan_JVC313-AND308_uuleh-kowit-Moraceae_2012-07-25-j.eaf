        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>Wa:n</ANNOTATION_VALUE>
