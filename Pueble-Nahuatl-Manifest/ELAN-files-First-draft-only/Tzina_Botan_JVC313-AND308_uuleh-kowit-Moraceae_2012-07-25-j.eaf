        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>xa:, xa: tikmattos ampo:wí:n, xa: ka:sá: ika kichi:wah de yo:n *hule**.</ANNOTATION_VALUE>
