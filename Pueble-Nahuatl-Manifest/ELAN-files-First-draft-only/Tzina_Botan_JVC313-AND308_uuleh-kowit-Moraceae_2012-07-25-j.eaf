        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>E:.., tahta:wak n' ikowyo wa:n..., ke:mah i:xtapa:ni, mopiswia wehka wa:n wehwetsi a ne:wí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>Ekintsi:n nikita kololowah para kichihchi:wah n' a:wi:lmeh kinamakah ne: parahko, ko:ko:stak kichihchi:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>miak tokni:wa:n mololowili:toh ya nokowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>pero nejó:n iteyo kwaltsi:n pané: yo:n, kwihkwi:kwiltik ke:meh noktakowachtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Ihkó:n, ke:meh yo:n *aceitekowachtet**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>*Este** tak ka: n'mati ok teh..., ka:n teh kikwa ne:si *porque** de, de paxi:i:ni ta:lpan nochi kololo:tih n' tein yo:n tachihchi:wah wa:n kinamakah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>Takwa:wak wa:n wehwei yo:n kowtet, wehwe..., weh... kikohkoyo:niah ika yo:n tepos tak wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>kichi:wah ko:koskat wa:n kinamaki:ltiah n' koyo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>Yehwa yo:n i...,wak... Ke:mah, yo:n, yo:n kowit onkak, nika:n a:mo onkak. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>Pos pané: a:mo, a:mo teh kikwa, pero komo kikwa:skiah a:mo pampi:xowiskia, moa:wilo, n' ta: pampi:xowi wa:n ompa pa:ti nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n a:mo teh..., wa:n pané: a:mo teh iteyo, sayoh pampi:xowi sayoh n' ahalaktik wa:n ompa tami.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>Pero yo:n nimitsilia ne:n kowtet, ne:n *hule**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>ne:, ne: kowtah ne: pampi:xowi n' iteyo wa:n tatapaka wa:n kololo:tih ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>Yehwa yo:n nimitsilia ne: yo:n... Ka:n ki:xmatih, ka:n ki:xmatih *porque** neh ke:meh wehka niki:sani niki..., yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>yo:n ke:man katka tipi:pilmeh wehka tiki:sayah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>teihsá: xina:ch nikpehpena *o** kowtet nikwa:lkwi wa:n n'to:ka ka..., ne: kaltsi:ntan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts493">
                <ANNOTATION_VALUE>Nikto:ktok ompa ne: kow... Pos wehka:w ya *porque**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts495" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>wehka:w ya *cuando**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>nixiw..., *casi** ni..., katka *nicomité de cooperativa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
