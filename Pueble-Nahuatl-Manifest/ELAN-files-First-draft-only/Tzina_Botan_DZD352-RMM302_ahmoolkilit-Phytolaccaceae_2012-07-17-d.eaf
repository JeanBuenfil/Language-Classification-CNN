        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Pos a:chá: para se: kimahse:was sah m' *porque** pos neli tein a:mo ki:xmatih pos neli pos a:mo, a:mo kimahse:wah pero tehwa:n pos n' tein...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Niki:xmattok *porque noabuelita** katka kitekiah yo:n xiwtsí:n wa:n te:chne:xtilih *que** we:lik, pos tehwa:n no: tiktekih.</ANNOTATION_VALUE>
