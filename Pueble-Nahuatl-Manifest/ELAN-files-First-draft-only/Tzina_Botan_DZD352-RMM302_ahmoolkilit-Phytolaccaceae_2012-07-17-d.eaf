        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>¿N..., yo:n xiwit? No: onkak n' tein ista:k.</ANNOTATION_VALUE>
