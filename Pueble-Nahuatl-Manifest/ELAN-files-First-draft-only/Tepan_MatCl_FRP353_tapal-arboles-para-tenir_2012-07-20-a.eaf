        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>ke:meh yo:n koyo:ichkat, ¿tiki:xmattok n' koyo:ichkat? No: iwkitik mochi:wati a.</ANNOTATION_VALUE>
