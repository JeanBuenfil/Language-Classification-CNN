        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>wa:n ke:mah tiktapalwia ya, ke:meh ne: ke:man pos tikita ya ne:,</ANNOTATION_VALUE>
