        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Wa:n yo:n molo:ni a ke:mah i:xki:sa ya ne:n kwowe:wat,</ANNOTATION_VALUE>
