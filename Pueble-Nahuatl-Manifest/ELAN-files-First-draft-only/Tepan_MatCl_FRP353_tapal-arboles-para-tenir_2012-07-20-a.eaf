        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Entó:s komo tikita kwaltiak a, entó:s 'tehte:ka ya ne: *mohilo**, komohkó:n ista:k, komohkó:n ista:kichkat tik..., tiktsa:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>'tehte:ka ya mo..., mo..., mo..., n' *hilo**, moista:kichkaw,</ANNOTATION_VALUE>
