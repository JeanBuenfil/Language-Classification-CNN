        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>kikwiah na:nomeh, pos a:mo kkwiah s..., *cam...**, ne:n *[inin]camisahwa:n** oso yeha ihwa:k,</ANNOTATION_VALUE>
