        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>ma:ski ista:kichkat kwaltsi:n mochi:wa koyo:t.</ANNOTATION_VALUE>
