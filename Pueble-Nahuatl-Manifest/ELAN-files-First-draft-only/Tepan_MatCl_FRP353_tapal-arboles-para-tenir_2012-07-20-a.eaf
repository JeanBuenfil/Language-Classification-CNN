        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>Xne:chili moto:ka:y.</ANNOTATION_VALUE>
