            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>kwaltsi:n ki:sa yemaxtik *hasta** tiktamiki:xtili:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Wa:n kwaltsi:n para tawi:pa:nas ye:kkwaltsi:n yemaxtsi:n, kwali, yo:n kwali tiki:xehke:was komo tikneki koma:mo tikneki mah kipia i:n,</ANNOTATION_VALUE>
