        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Pero i:n seki ne:n nimitsilia xo:no:t, a:mo eheke:wi</ANNOTATION_VALUE>
