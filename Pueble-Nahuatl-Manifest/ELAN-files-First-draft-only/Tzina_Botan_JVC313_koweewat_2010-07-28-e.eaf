            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Wa:n komohkó:n se: kikwi para se: tawi:pa:nas sah,</ANNOTATION_VALUE>
