                <ANNOTATION_VALUE>Neh nikehke:wa ne:chne:xtilihkeh nota:tahwa:n ne: ki..., se: kiyema:nikehke:wa yo:n xo:no:..., yo:n xo:no:....</ANNOTATION_VALUE>
