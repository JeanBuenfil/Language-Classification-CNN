        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n ti..., chi:chi:ltik, tiki:xmatih ista:kxo:no:t,</ANNOTATION_VALUE>
