        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Wa:n okseki ixo:chio tein, tein ista:kxo:no:t tikiliah, tein kwaltsi:n ehke:wi, chi:chi:ltik ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
