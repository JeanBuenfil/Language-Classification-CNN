        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Komo mitsakwilia yo: e:wat pos x'tamo:ta wa:n xikwi soh xo:no:tsi:n sah, ye:kkwaltsi:n yo:nse: tawi:pa:na,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
