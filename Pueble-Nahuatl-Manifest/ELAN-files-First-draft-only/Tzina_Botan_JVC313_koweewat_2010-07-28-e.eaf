        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>wa:n yeh n' i..., ixo:chio chi:chilxo:not, kostik ixo:chio,</ANNOTATION_VALUE>
