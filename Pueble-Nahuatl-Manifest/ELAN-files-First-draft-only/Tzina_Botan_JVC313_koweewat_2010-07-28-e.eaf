        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Yo:n a:mo pala:ni niman wa:n a:mo, a:mo a:kalakis semi ihsiwka,</ANNOTATION_VALUE>
