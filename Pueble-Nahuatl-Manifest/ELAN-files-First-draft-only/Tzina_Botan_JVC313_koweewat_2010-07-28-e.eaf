        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Wa:n seki ne: kehke:wah iwki sah, kitila:nah wa:n ehke:wi ne:, yeh kita mah ehke:wi</ANNOTATION_VALUE>
