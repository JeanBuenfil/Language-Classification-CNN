        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Yo:n a:mo, a:mo se: kixtilia ie:wayotsi:n, iwki, iwki, kipale:wia yo:n semi takwa:wak, iwa:n ie:wayo.</ANNOTATION_VALUE>
