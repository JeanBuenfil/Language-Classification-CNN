        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>pero ne: i..., ixo:chiotsi:n ne: chi:chi:ltik.</ANNOTATION_VALUE>
