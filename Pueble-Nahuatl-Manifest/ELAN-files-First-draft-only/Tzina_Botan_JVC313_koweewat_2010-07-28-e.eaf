        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>Nochi tein eski kowe:wat ke:meh xo:no:kowit se: kehke:was mah se: kiki:xti ke:mah chika:wak me:tsti kit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>*Cuando** selik me:tsti kokotoka, ihkó:n kihtowah pero pos ke:masá: ka:n se: yowi *cuando** yo:n chika:wak me:tsti, se: yowi ke:meh, ke:man ya se: yahki kowtah.</ANNOTATION_VALUE>
