        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>wa:n se: kichi:wtiw a wa:n se: ima:i se: ki..., se: ki..., se: ki..., se: kipa:tskatiw mahyá:,</ANNOTATION_VALUE>
