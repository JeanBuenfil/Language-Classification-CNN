            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Yo:n se: ka:pachowa para se: kichi:was wahkal *o** tamali:n se: kichi:was *o** kwa:it, yehwa se: ka:pachowa.</ANNOTATION_VALUE>
