            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Pero mah se: kima:ni yo:n, no: taman wa:n pos se: kehke:wa sah ihkó:n</ANNOTATION_VALUE>
