        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Is..., chi:chi:ltik ixo:chio, ke:mah wa:n .... Pero tikto:ka:itiah ista:kxo:no:t *porque** kwaltsi:n ehke:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Wa:n nehjó:n ki:sa sa pohpochiktik xo:no:t komohkó:n se: ki..., se: kia:pachoh wehka:wa, sake:ra se: ka:lto:lika,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
