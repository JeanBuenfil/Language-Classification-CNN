        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>mm, nikonkaltia wa:n cuan..., ke:man n' neki nimochihchi:wilia wa:n ke:man a:mo pos ihkó:n no: i:ksá: nikowa nimokowilia nikan Cuetzalan,</ANNOTATION_VALUE>
