        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>wa:n ke:mah tikpa:ka ya kwaltsi:n tikpa:ka, wa:n ke:mah tikpante:ma itech in ko:ntsí:n no:, tikpante:ma ya wa:n tikma:nelowa kwaltsi:n kwaltsi:n *tikpatearowa** ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>mahyá: tikma:maka *vuelta** para ihsiwka pa:ti,</ANNOTATION_VALUE>
