        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>pos ke:meh nimitsilwih tikoto:na, se: *hojita** mochi:wa o:me, o:me *tamalito**,</ANNOTATION_VALUE>
