        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>Mah ehko wa:n nehwa nejó:n nimitsilwia kiltsín yo:n ne: nimitsne:xtilih nejí:n pata:wak,</ANNOTATION_VALUE>
