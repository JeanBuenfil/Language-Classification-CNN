        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>no: tikmanah wa:n de no: tikmanah ke:mah ne: tik..., timota:liah ya titamahse:wah ya *o** ehko ya moseñortsí:n t'tamaka ya ika nejó:n kiltsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
