        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>mm.</ANNOTATION_VALUE>
