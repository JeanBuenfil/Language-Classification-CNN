        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>*porque** semi tikwelitayah *porque** techse:wia itech toyo:lotsí:n ta:ká:n ne: seki tikihtowah tata toyo:lotsí:n *o**,</ANNOTATION_VALUE>
