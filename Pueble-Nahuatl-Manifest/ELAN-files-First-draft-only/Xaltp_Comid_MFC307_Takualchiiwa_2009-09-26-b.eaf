        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>*Igual** nochi yo:n se: **clase* sah kwika, tikma:nelowa kwaltsi:n, kwaltsi:n, kwaltsi:n wa:n ke:mah t'ta:lia ke:meh ne:,</ANNOTATION_VALUE>
