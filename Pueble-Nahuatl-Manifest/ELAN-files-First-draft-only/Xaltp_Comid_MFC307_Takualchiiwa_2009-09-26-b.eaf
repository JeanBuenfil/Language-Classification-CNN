                <ANNOTATION_VALUE>tenex tikihtowah, *mexicano** tenex wa:n *igual** i[n]*mexicano** ne:n kownex,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>yehwa *ceniza** mono:tsa, yehwa n' ika tikchipa:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>Ento:s yo:n tikchipa:wah ya wa:n tikekowah komamo kipia ok xoko:k,</ANNOTATION_VALUE>
