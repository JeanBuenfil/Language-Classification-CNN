        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>tiktekih ne:n ka:mpa semi seltsitsí:n wa:n seki semi kwahkwali ni..., nikowyotsí:n, pe:wa tikchipa:wah wa:n ke:mah ne: no: *igual** no: tikmanah,</ANNOTATION_VALUE>
