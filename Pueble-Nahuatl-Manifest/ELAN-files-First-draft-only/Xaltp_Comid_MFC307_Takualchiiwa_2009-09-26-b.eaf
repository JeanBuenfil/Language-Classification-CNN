        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>a:mo ke:man tikwiah tehwa:n nejó:n kakawtsí:n n' a:man tikwih, a:mo tehwa:n nochipa tikwiah de in, *posillo igual**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>mm, *posillo** tikwiah a:mo tikwiah ne:n, tein a:xka:n tikiliah *plástico**,</ANNOTATION_VALUE>
