            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>komo *saquera setenta**, *setenta** cin..., kisa *ciento, ciento**, tikihtowah *mexicano** se: *sientoh** wa:n o:mepowal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>ke:mah, se:, se: *sientoh** wa:n o:mepowal yehwa ya *ciento cuarenta**,</ANNOTATION_VALUE>
