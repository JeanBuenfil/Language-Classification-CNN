        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>ento:s tikwih ya wa:n tikte:miliah *tobrijolito** tikwe:choliah n' ta:ká:n tikiliah ne:n te:kwa:nenepil *o** tikwe:choliah ne:n nakastekilit,</ANNOTATION_VALUE>
