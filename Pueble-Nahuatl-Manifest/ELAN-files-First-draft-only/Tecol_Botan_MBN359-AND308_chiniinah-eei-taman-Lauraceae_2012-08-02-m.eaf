        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Ata mopahpampilowa, we:weyak, kitihtila:natih, panxi:ni wa:n ompa kiololowah ya wa:n ika yehwa yo:n kiwi:kayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>A:mo kilpia:yah ika *hilo**, a:mo onkaya *hilo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>Pos komo kahsih o:me taman, o:me taman, seki kiliah yo:n ki..., we:noh, tehwa:n tiki:xmatih *por** tekxo:chima:it ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Ke ki..., kitekih komekatsi:n, ki..., itech kowit mopihpilowa, ike:span</ANNOTATION_VALUE>
