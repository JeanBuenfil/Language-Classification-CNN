                <ANNOTATION_VALUE>wa:n *hasta** ma:tamiah *hasta** ahko. Ke:meh onkaya miak, ne: ke:man ya onkaya miak yehwa yo:n chini:nah wa:n pa:pata:wak ima:i</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>wa:n a:mo eliwis xi:ni *cuando** xohxowik kilpiah, wa:ki wa:n mopepechowa.</ANNOTATION_VALUE>
