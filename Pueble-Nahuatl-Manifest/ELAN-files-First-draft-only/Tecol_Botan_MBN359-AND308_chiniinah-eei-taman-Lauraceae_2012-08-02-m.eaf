            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>yo:n *paila** komo koyoktik no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>koyoktik, we:itsi:n ya koyo:nik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>wa:n a:mo tikpiah tonika tikpepecho:skeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>no: kwali ika se: kipepechowa wa:n se: kipanketsa sepa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>se: kitaxo:taltilia, tewa:ki wa:n a:mo ehke:wi ok, ompa mopilowa ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>wa:n servi:rowa sake:ra komo mo:stah se: kipanketsa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>servi:rowa sake:ra ka:n ma:kwi:lpa tikpanketsas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>Ma:kwi:lpa t'taxo:taltili:s, taxi:kowa, a:mo koyo:ni, a:mo ehke:wi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts456" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>tewa:ki sah kwaltsi:n wa:n moka:wa semi, semi *fuerte** mopilowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Yo:n no: servi:rowa ika yo:n tepos kikwi ne:n yo:n tapalkat tein ika titamolo:ltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>A:mo ehke:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>Tewa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>A:mo tata *porque** ke:meh ka:mpa kikwitok ne: tikiliah ne: nekkwa:tsi:n pos komoke yoksi sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>tata nika:n i:ka:mpa ka:mpa kikwi ne:n titsi:n pero nika:n, nika:n taihtikkopa, a:mo tata, yoksi sah, tewa:ki sah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>wa:n yehwa ya yo:n kipale:wia, a:mo ehke:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Entó:s yo:n semite:chpale:wia:ya, *porque** neh no: ihkó:n n'chihchi:wka wa:n kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>Ke:mah, a:mo nikmati ok, a:mo nikmati ok ta:tah pero yehwa sah yo:n neh nikmati de yo:n se: kipepechowa ika yehwa yo:n tepos tein titamolo:ntiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>wa:n kwaltsi:n moka:wa wa:n *hasta** ompa sah, yehwa sah nikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>Neh nimono:tsa niMartí:n Becerra Nazario,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>niwa:le:w Tecoltepec.</ANNOTATION_VALUE>
