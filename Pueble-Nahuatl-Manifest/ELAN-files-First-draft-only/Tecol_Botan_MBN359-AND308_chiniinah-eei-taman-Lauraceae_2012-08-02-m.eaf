        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Yo:n ne: kwowtah onkak, yo:n tehwa:n tikiliah kowke:smekat.</ANNOTATION_VALUE>
