        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>wa:n no: kwaltia. *Porque** de wa:ki a ne: ka:mpa kitaxo:taltili:tih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>a:mo ok ma:xi:ni, no: servi:rowa:ya pero pos a:xka:n a:mo ok kichi:wah *porque** pos kichi:wah tema:skalmeh pero de, no: taman ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>Ki..., kiwi:pa:nayah, no: ihkó:n kipahpampilowa:yah, kita:lilia:yah ihkó:n kiewalowah wa:n kiihilpihtiowih ika kwomekat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
