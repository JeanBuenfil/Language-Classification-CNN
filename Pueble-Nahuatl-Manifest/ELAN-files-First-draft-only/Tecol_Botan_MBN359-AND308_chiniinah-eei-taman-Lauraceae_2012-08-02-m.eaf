                <ANNOTATION_VALUE>wa:n kitekih ika *machete** wa:n kiahkotihtila:nah ya, no: iwki, no: iwki, no: *este**, no: iwa:n ya kihilpia, no: ki..., no: servi:rowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts245">
