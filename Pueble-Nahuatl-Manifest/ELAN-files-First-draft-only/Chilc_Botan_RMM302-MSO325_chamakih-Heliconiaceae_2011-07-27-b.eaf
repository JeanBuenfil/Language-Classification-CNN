        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>xa:n, inin..., *iminxa:ntoh**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>*xa:ntohkowtsí:n**, ke:ní:w kio..., kiilpiliah *o** ki:xtapa:nah oso iwki sah *o** ke:ní:w yo:n kichi:wah n' kihilpiah.</ANNOTATION_VALUE>
