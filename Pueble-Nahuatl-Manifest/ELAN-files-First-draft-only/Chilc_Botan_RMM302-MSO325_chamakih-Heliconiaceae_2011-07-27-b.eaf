        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Wa:n yo:n ke:ní:w n' kichi:wah, de tehwa:tsi:n xa: tikmattos ke:ní:w n' kichi:wah *cuando** ika tachihchi:wah ihkó:n ke:meh i:n ka:mpa ki..., kipiah *este** n' imin...,</ANNOTATION_VALUE>
