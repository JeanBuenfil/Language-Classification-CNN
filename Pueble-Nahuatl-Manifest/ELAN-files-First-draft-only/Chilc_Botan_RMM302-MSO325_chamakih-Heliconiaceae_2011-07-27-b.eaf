        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Wa:n yo:n senki:s xo:chitsí:n sah kihilpiah *o** kite:moliah teihsá: iswatsí:n *o** teihsá: xiwtsí:n ika kihilpiah *o**...</ANNOTATION_VALUE>
