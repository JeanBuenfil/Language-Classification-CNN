        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Wa:n yo:n no: kwali ika tachihchi:wah ke:meh i:n ka:mpa kih..., kihilpiah n' chamakih *o**... A:, no: kwaltia.</ANNOTATION_VALUE>
