            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>Ke:mah, *porque** neh niki:ita neli ne: nejó:n nota:kaw neli no: tachihchi:wa n' ahko, pero a:mo ke:man nimone:xtilia no:, pero tak komo se: mone:xtilih se: welis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>Se: welis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>A:mo, weli ke:man eski, ke:man se: kinekis kwali se: tachihchi:was, sayoh mah ne:si sah ne:n xo:chitsi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>A:mo, ta: weli ke:man eski se: tachihchi:was, ke:man se: kinekis, sayoh mah onka sah xo:chitsi:ni, yehwa yo:ni pos kwali se: tachihchi:was ke:man eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Pos ka:sá: ika kite:tayo:koliah wa:n ka:sá: ika no: mah se: kikowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>No: se: kikowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Pos kihto:snekih *de que** kito:kah, *porque** mah mochi:wa sah ihkó:n a:mo no: mochi:was, kipia de se: kito:kas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>A:mo nochipa semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Ke:mah. A:mo nochipa semi, *más** ye:konkak yehwa i:n okseki, yehwa sah ke:meh itech i:n mayo, pero yehwa de yo:n kiliah kowtah chamakih, ihwa:k ata motelchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>Pos yeh onkak ke:man eski pero a:mo no: okachi semi, pos onkak *siempre** pero ke:meh yo:n itech,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>itech diciembre a:mo kachi onkak, enero a:mo kachi. Se: kahsi pero, pero pos yo:li:k para se: kahsi, mah se: kite:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>A:mo, n' ta: ki..., *importa** mah se: kitapa:na, pos yehwa neli ke:meh yo:n nota:kaw 'kwiti yo:n nota:kaw neli kitapa:na wa:n komo a:mo pos yehwa yo:n kihto:s a:man nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>nitachihchi:w a, xitaa:ketsaya kichi:wtok, komo tikowato xo:chitsí:n xtaa:ketsa ya wa:n xtapopo:chwi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Ke:mah iwi:kal, ke:mah, komo, pos komo nochi tawa:kik a, pos no: tawa:kik a tein yo:n se: ka:ketsa, pos yeh i:pa tikowah xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Ke:mah, te:chwa:lkwiliah ne: toxola:l wa:n ompa tikowah, wa:n kihtowa, tikwito ya xo:chit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>ka:ke:tsa ya kihtowa wa:n ke:mah xtapopo:chwi a, wa:n xo:cha..., xikto:talti kihtowa se: tane:xtsi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Pos tak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>yo:n i:pa, i:pa iwki *desde** wehka:w...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>wehka:wkayo:meh ya, i:pa iwki kichi:wah n' tota:tahwa:n, i:pa, i:pa ihko:ni, i:pa nikitani neh *que**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>komo se: tamitachihchi:w mah se: tapopo:chwi a wa:n neli tei:liah mah se: kixo:talti se: tane:xtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
