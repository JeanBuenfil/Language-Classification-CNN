        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>no: *medio** panpohpo:ktik wa:n metswe:weyak.</ANNOTATION_VALUE>
