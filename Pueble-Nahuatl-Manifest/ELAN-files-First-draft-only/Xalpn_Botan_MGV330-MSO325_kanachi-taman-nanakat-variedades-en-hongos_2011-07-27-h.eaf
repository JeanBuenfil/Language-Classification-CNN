        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>Yeh mochi:wa itech a:wa:t, itech o:me taman a:wa:t nochi ompa e:wa.</ANNOTATION_VALUE>
