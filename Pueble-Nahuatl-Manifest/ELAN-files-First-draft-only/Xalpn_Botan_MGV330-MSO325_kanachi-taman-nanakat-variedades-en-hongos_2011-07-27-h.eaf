        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>To:tolkoskat no: sentaman sah wa:n yeh mochi:wa no: itech, itech n' tahsolpalaktsí:n, *como que** no: ta:lpan.</ANNOTATION_VALUE>
