    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="Anastacio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Pos nika:n timahsih nika:n tinentinemih pos no:, kwali tine:chili:s katí:n yo:n, ox tiki:xmati yo:n tekomatsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>ka:ni onkak wa:n ke:ní:w xo:chiowa wa:n pos no: kwali tine:chili:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>Ox kwaltia ika se: mopahtia oso a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Tekolotik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>O:me sah mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>A:mo se: kita ke ox ne: ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>Pos yehwa yo:n nehwa:n tikiliah ne:n, ka:n tiki:xmatiah tekomatsi:n *porque** o:me, o:me sah neh nik..., nikita ihkó:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>pos no: neh no: nikita taihtik kwaltsi:n ne:n *morado** wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>kwaltsi:n pampi:ktok wa:n ihkó:n de, de moskaltihtiw no: ihkwí:n, ihkwi:ntsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>De sepa we:ia ihkó:n we:i mochi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>we:i mochi:wa wa:n de chika:waya pos ihwa:k yo:n mahka:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>De mahka:wi pero a:mo ke:man nikitas mah nehjó:n ihkato wa:n itech xo:chit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>tak ne:n ke:meh a:mo no: nikchi:wa kwe:ntah sayoh nik..., nikita ne: yetok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>wa:n yo:n pos no: ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Ahwia:k ixo:chio pero yo:n a:mo semi no: nikihto:s weh..., wehkapania *o** we:ikowit mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Yo:n a:mo, yo:n sayoh panki:sa wa:n ompa ne: mo..., mopihpilowa i..., iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Kiliah iteyo, te..., tekomatsi:n iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Iteyo *porque** ihkó:n [mo]chi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>pero a:mo ke:man nikita ne:n iteyo mah, mah ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>Soh tikiliah iteyo ne:n tekomatsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Pero mah nikita ne:wí:n mah yeto tatampa mah moya:wto ihkó:n, mah ixwato tsikitsi:n ne: *matita**, a:mo ke:man nikita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Wa:n sepa yo:n neh nik..., a:mo no: nikmati ke:maniá:n nehjó:n ne:n ... xo:chitsí:n nikita ihkó:n ke:masá: tsikitsitsi:n wa:n pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>pero a:mo ke:man nikita mah ix..., mah e:wto itech ne:n i..., nika:n, ka:mpa ne: yetok ixiwyotsi:n, mah e:wto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Neh nikita achi wehwei a wa:n *hasta** wehwei a ihko:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Pos yo:n no: kwaltsi:n, pero yo:n a:mo, a:mo nikihto:s kikwitih para ika ta..., taa:ketsatih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>yo:n a:mo *porque** tsikits..., metstsitsi:n wa:n ohololtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>yo:n komo, komo se: koli:ni xi:ni, xi:ni ne:n ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>Xi:ni, yema:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Yema:nik ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>Wa:n pos yehwa yo:n kiliah tekomatsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>nehjó:n a:mo, a:mo wehwei pero yon neh nikmattok pané: a:mo kwaltia para ke:meh i:n se: ki..., se: ki..., se: kikwis para se: tai:s para topah, yo:n i:pa iwki xo:chitsí:n sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>Xo:chit sah wa:n teh xa: tikmattos para se: mopahtia oso xa: se: kimana oso ki..., ke:ní:w yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>*O** ke:ní:w xa:, xa: ika se: tachihchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Pos yo:n a:mo no: nowia:n mochi:wa, no: ka:sá: ika sah se: kita ihkó:n mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Pos ne:n onkas ne:wí:n se: ki..., ke:masá: kwali se: ki..., moyo:le:was wa:n kwali se: kite:mo:ti:w yo:n tekomatsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Se: kite:mo:ti:w *porque** yo:n kwaltsi:n ahwia:k, de sepa mahka:wi ne:n xo:chitsí:n kwaltsi:n ahwia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Ahwia:ya pero semi tsi:nyehyema:nik tak de xi:ni ixo:chiotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>Xi:ni wa:n pos yehwa sah yo:n neh nik..., nikmattok de yo:n xo:chitsi:n, a:mo no: *más** nikmati ne:n, nikmati ke:ní:w, ne: nikita sayoh ne:n yetok ihkó:n pero a:mo nikmati ke:maniá:n de e:wi ne:n i...,  ike:span, ke:ní:w ixwa, ixwa oso mo..., pepechiwtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>de ke:maniá:n poso:ni, soh nikita ne: kwaltsi:n ihkó:n *bo:lahtik** wa:n mahka:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Ke:mah, ne:n neh yehwa sah nehjó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Pero i:n ahwia:k sah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Pos koma:mo teh *más** tikmati no:, no: *igual** ke:meh ne: tik..., timonohno:tskeh pos kwali tine:chili:s ne:n moto:ka:i, ke:ní:w ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>Moto:ka:i wa:n ke:ní:w, ka:ni, ke:ní:w timono:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>A:, we:noh, neh nimono:tsa Anastacio Nicolás Damián, niwa:le:w San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="José Ernesto Vázquez Chanico" TIER_ID="José Ernesto Vázquez Chanico">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>Ke:mah, tekomatsi:n ne: niki:xmattok, yo:n kiliah tekomatsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>Tekomatsitsi:n *porque** mochi:wa o:me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>Wa:n i:n tekomatsi:n kiliah *porque** ohololtik mahyá:, mahya: tekomat kiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>ohololtik mochi:wa ke:meh, ihkó:n ke:meh se: xokot wa:n nehjó:n yo:n, yo:n pi:ktiwi:ts de ipanko ika ne: ima:..., ipane:wayo xo:chitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>wa:n *cuando** poso:ni a chika:wak a, motapowa ya yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Mi:xkepa ya ne: ixo:chio de, posos:ni mi:xkepa ya xo:chitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>wa:n ke:mah ki:sa ya yo:n pané: se: kowit ihkó:n pané: pata:wak tepitsi:n ihkwi:ni, mahyá:, mahyá: na:na:ltoktik ike:span.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>Wa:n kwa:kostik yo:n ne:n kipia yo:n, yo:n itskwinihkatok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>wa:n ke:mah nehjó:n om..., ompa inakastan yetok, i:xte:noh ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>se: pané: okwilin, ne: ihtitekochtik wa:n tsi..., metschihkoltik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>wa:n no: ihkwí:n yetok ne: pané: kwa..., i..., pané: itsontekon, kwa:pitstik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>wa:n yehwa pané: *icuerno** ikwí:n kichi:wtok ihkó:n, pané: kitolohtok ihkó:n se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>Wa:n ye:kwe:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Wa:n yo:n i..., yo:n ihtimora:doh wa:n imahma:yekapan tein yo:n nehjó:n ika pi:ktok a xo:chitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>a..., o:me, o:..., e:yi xo:chit ihkwí:n de wehwei,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>kahkanaktik wa:n tsitsikiltik wa:n nehjó:n tekolotik yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>Wa:n tein taihtik tein ne:, tein ka:mpa pampi:ktok ika ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>Ompa ke:mah ne: *moradito**, *ye:kmorado, morado**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>wa:n no: ye:kahwia:k ke:meh ko:kowa:tsi:n, ye:kahwia:k semi, pero a:mo miak mochi:wa, i:pa o:me sah mopampilowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>O:me sah, yo:n a:mo moahoketsa *porque** ke:meh ne: wehwei</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Mo..., ki:sa ima:tsa:la:n mopampilowa niman yo:n xo:chitsi:, ompa poso:ni a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>ke:mah wa:n pero a:mo teyowa, a:mo ke:man nikita ke:niwki iteyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>nikitani xo:chitsí:n mochi:wa pero a:mo ke:man nikita ki:x..., se: kisati:w pilkatok iteyo, a:mo.</ANNOTATION_VALUE>
