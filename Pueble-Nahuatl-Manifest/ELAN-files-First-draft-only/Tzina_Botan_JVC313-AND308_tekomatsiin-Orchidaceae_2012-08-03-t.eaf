        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Xo:chit sah wa:n, wa:n de ke chika:waya xo:chitsí:n pampi:xowi a wa:n nochi yo:n imetskowyo, pampi:xowi yo:li:k wa:n, wa:n ompa tami a xo:chitsi:n.</ANNOTATION_VALUE>
