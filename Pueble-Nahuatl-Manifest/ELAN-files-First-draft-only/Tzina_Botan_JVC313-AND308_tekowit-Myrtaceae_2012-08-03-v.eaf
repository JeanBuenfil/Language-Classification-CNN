                <ANNOTATION_VALUE>yo:n kiliah mimienta, mimie:ntahtekowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>wa:n yo:n nehjó:n ma:pisi:ltekowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>wa:n yo:n ma:pa:pata:waktekowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>wa:n yo:n kiliah xilitekowit, ma:kwi:l taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Ke..., ma:..., ma:kwi:l taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Ma:kwi:l taman, a:mo na:wi taman, ma:kwi:l taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>achto ne: ayo:chtekowit, ompa mimie:ntakowit, mimientah, mimie:n..., mimie:ntah, mimie:ntahtekowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>ompa yo:n ma:pisi:ltekowit, ompa ma:pa:pata:waktekowit, ompa ayo..., yo:n nimitsilia xilitekowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>yeh kiliah xilitekowit pero nochi tekowit, nochi tekowit, yo:n no: teltakwa:wak wa:n melaktik, kwaltsi:n tatapaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>wa:n i:n ista:k ikowyo wa:n ikowyo tahtamati ne:n ... Tahtamati ke:meh yo:n kowxi:lo:t ikowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Wa:n mochi:wa wehwei. Ke:mah, mela:wak wa:n wehkapantik, mochi:wa we:ikowit, se:, se: tanawa:l mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Wa:n yo:n ima:xiwyo ne: ma:pisi:ltik ke:meh xo:me:t ima:xiwyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>ma:pisi:ltik wa:n ma..., momahma:itia wa:n nipa ki:sa ima:xiwyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>wa:n iteyo mopahpampilowa ihkó:n ke:meh yo:n xi:kalkowtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>No: chi:chi:ltik iteyo ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>Yo:n yo:n kiliah xilitekowit, wehweixilitekowit. Ke:mah, yehwa yo:n niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>Nika:n mo..., nochi imi..., nochi yehwa sah mits..., se: mahyá: tikihto:ka:n nochi yehwa tekowit,tekowit nochi, sayoh ta:taman ito:ka:i wa:n ta:ta:man i..., ta:taman ne:n ima:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Ta:taman ikowyo wa:n ta:taman ineketsalis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>pero yo:n xilitekowit tikihtowah tein i:n sa:te:pan nikelna:mikik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Telwehkapantik mochi:wa, mochi:wa se: tanawa:l yehwa xilitekowit. We:i, tomaktik wa:n no: ye:k..., ye:kkwaltsi:n tata, ihwa:k ke:mah ye:keti:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Ye:keti:k yo:n kowit, ye:kkwaltsi:n tapa:ni, ma:ski 'tekis ye:kwe:weyak mokow pero kwaltsi:n 'pisi:ltatapatsas ke:meh yo:n tepe:chi:lkowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>yo:n kiliah xilitekowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>A:mo, yo:n kwaltsi:n tatapaka, ke:meh, ke:meh wa:xkowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Wa:n i..., ite..., ixo..., ixiwyo nimitsilia ke:meh xo:me:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>ke:meh xo:me:t, ma:pisi:ltik wa:n iwki, ke:meh xo:me:t *mero**, yo:n pisi:lxo:me:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>wa:n nehjó:n *cuando, cuando, cuando** teyowa mopahpampilowa ne:n iteyo, ke:meh yo:n, ke:meh yo:n xi:kalkowtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Wa:n nehjó:n i..., ixo:chio ista:k ke:meh teswat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>pero mopampilowa ihkwí:n n' i..., ite..., ixo:chio,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>ompa panki:sa ixo:chio, ompa wi:tsa ya iteyo</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>pero iteyo mochi:wa ihkó:n, mopahpampilowa chi:chi:ltik ke:meh yo:n xi:kalkowtet *cuando** chika:wak a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>Tsikitsi:n, tsikitsi:n pero ke:meh chi:chi:ltik ke:meh xi:kalkowtet mopampilowa ihkó:n ika, ika *sarta** tikihto:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>Mopampilowa ixo:chio, imahma:tsa:la:n ki:sa wa:n ista:k ikowyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Wa:n nehjó:n yo:n nimitsilia ma:p..., ma:pisi:l, ma:pisi:ltekowit, ma:pisi:ltekowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>yeh a:mo wehkapania, ta:lpantsitsi:n wa:n nehjó:n ye:kmetsahalaxtik no: yeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>Yo:n ma:pisi:ltekowit tein nika:n we:ikowtah mochi:wa, i:n nika:n, we:ikowtah *loma**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>ye:kma:pisi:ltik. Kwaltsi:n pané: *hasta** pané: ika se: tachihchi:wasneki ima:xiwyo, kwaltsitsi:n ima:xiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Ye:kma:pisi:ltik wa:n ima:te:mpan chihchi:chi:ltik, yo:n selontsi:n ok ima:te:mpan i..., ite:mpan ya xochi..., xiwtsi:n chi..., ekachi:chi:ltiki..., ite:mpa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>Chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Wa:n eka..., ehekapitseh semi, ye:keka..., yekapitseh ima:xiwyo. A:mo, tepitsi:n, a:mo tepitsi:n sah ne:n, tepitsi:n mahyá: tsi:nyewaltik wa:n yekapitseh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Ye:kekapitseh xo:chitsi:n, kwaltsi:n mota, ye:kekachahchaya:wtok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
