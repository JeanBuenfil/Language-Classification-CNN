                <ANNOTATION_VALUE>Ke:mah pos tekowit niki:xmattok ne:, neh niki:xmati yo:n a:yo:to:chtekowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
