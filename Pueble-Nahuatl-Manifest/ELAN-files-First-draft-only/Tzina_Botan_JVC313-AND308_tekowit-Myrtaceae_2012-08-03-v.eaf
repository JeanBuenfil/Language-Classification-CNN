    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián" TIER_ID="Anastacio Nicolás Damián">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Pos nika:n sepa tiwa:lahkeh wa:n timonohno:tsatih de yo:n teko..., tekowit, ka:nachi tiki:xmati, ka:nachi taman,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>*qué tal** wehkapantia oso xo:chiowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>para katí:n kwaltia pos teh no: tikmattos ke:meh no: tikowtahnemi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>pos kwali tine:chili:s, tine:chili:s katí:n tekowit tiki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>Ma:kwi:l taman tiki:x...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Kowxi..., kachi mela:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Xilitekowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>Wa:n yo:n ne: ki..., no: kiniwa:nti de n' tekowit, de n' okseki, yo:n ma:pa:pata:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>kachi we:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>A:mo ahaktok, *casi** kwaltis:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>A: pi..., tsikitsitsi:n iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>*Casi** we:weyak ihkó:n ima:te:mpan, ma..., achi pihpitsa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>Mose..., moso:sowa ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Moma:..., moso:sowa, momahmaxalowa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>No:, no: wehwei ke:meh ahkokowit ima:xiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Pisi:ltik kachi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Ma:kwi:l taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts225">
                <ANNOTATION_VALUE>Pos yehwa yo:n kwali ke tine:chtapowih yo:n, ne:n se: taman a:mo niki:xmati pero yo:n na:wi pos niki:xmattok no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Yo:n tekowit oksé: ne:n mochi:wa wa:n yo:n a:mo wehkapania.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>A:mo wehkapania, nochi nehjó:n kowtsitsi:n nochi a:mo wehkapaniah, yeh panki:sa wa:n mo..., moyewalowa, momahma:yo:tia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>wa:n ompa sah tami pero yo:n semi kwaltia para ne:n a:chahmets oso para salo:nkowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>no: kwaltia *porque** yo:n a:mo semi wehkapania, ihko:ntsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Ke:masá: se: kitas seki mela:wak, tak yo:n itsmol, mela:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Pero *más** ahko nehjó:n chihchi...,mochihchihkolowa wa:n yehwa yo:n se: kiteki no: para ne:n kamachal, ke:ní:w se: kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>wa:n ika se: kitila:na wa:n se: [ka:wilowa], yo:n a:mo, yo:n wehka:wak se: ke:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Wehka:wa se: ke:wtok, yo:n a:mo takwa:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Pero neh a:mo ke:man nikita yo:n nochi de nehjó:n, nochi yo:n kowtsitsi:n a:mo ke:man nikita i..., ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Ixo:chio ke:ní:w mochi:wa oso iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>Yo:n tekowit, nochi de nehjó:n, neh i..., nik..., nochi de na:wi niki:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Pos yo:n a:mo nikihto:s kikwitih para teisá: yo:n kowit kitsaya:natih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>yo:n kwaltia no: para kowtati:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Para kowtati:l semi pipi:nik no: para se: kitehteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>No: kwaltsi:n tata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>Tapa:ni no:, yo:n a:mo ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Yo:n tak ke:meh yo:n xa:lxokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Yo:n no:, pos neh nikmati yo:n kowit i:pa sayoh para yeh ne: se:, se: kikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>Para kowtati:l wa:n para a:chahmets no: se ki..., ta: seki ka:sá: ika se: kita ihkó:n, ihkó:n ne:n de wehkapan mela:wak ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>mela:wak ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Wa:n no: kwaltia para ne:n salo:nkowit ka:mpa ... Pero yo:n a:mo no: semi mela:wak mochi:wa, we:weyak, yo:n ihkwi:ntsitsi:n sah, pero ye:ktakwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Yo:n no: kwaltia ne:n se: kikwiti no: para yo:n kiliah yo:n tepos yo:n ne: *chuzo** se: kita:lilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>Yo:n no: taxi:kowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>Yo:n no: taxi:kowa *porque** tehwa:n tikitayah ne:n tota:tahwa:n kikwiah para ne: ika ta..., kichi:wayah ne:n, ne: tekoch ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>ika tahtachkwayah, a:moyekapa:tia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>Takwa:wak iekapan..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Pero yo:n a:mo nikmati ox xa: kipias ne:n iyo:lo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Wa:n yo:n nehjó:n ipane:wayo neh nikita ne: xi:ni seki ne:n de n' eheke:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>Mimie:ntah tekowit yo:n ki:sa ie:wayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>Pero n' okseki a:mo, a:mo ki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>A:mo ki:sa, tak yo:n takwa:wak, pepechiwtok i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>Xahxakachtik wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>Pos neh nikitak ne: pané:, nochi *igual** de pipi:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE>Takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>A:mo mehmela:wak, a:mo mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts390">
                <ANNOTATION_VALUE>Pos no: onkak okseki ma:pa:pata:wak ne: chechelo:tepe:tikpak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts391" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Ompa no: onkak yo:n tepe:t, tepe:kwa:ko, ompa ne: ke:meh i:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>Tikowtahnemiah pos ompa tikitayah, tiktekiah para yehwa yo:n ompa tani tik..., titame:wayah ihkó:n, titachipa:wayah pos tik..., tiktekiah yo:n. Yo:n taxi:kowa, yo:n wehka:wa se: kipixtok komo takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Yo:n takwa:wak pero yo:n a:mo nikihto:s weh..., we:weyak, semi mehmela:wak, yo:n achi tsikitsitsi:n ka:mpa i..., kipia i..., itsmol, tohtokotstik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>No: tohtokotstik pero yehwa nimitsilia no: kwaltsi:n para n' a:chahmets de yo:n takwa:wak no: wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Yo:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>Pos yo:n tik..., tikwelitayah ne:n chi:chi:ltik no: wa:n *porque** tahtakwa:wak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts425">
                <ANNOTATION_VALUE>Pero yo:n komo, komo se: kitsontawi:tek ye:kne:nke:n wehweliwi, senxama:ni, xama:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Xama:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Wa:n kwaltsitsi:n no: n' i..., ima:yo, *casi** ima:yo a:mo semi telwe:weyak pané: achi ma:..., ma:pihpitstik no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>No:, pero neh a:mo ke:man nikita ne: i..., iteyo, ke:niwki, ke ti:ltik oso xa: xoxoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>A:yo:to:chtekowit, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>Xoxoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>A:mo, a:mo tihtil..., a:mo ti:le:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>Wa:n yo:n no: tak kikwah ne:n chiktehtsitsi:n tak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>A:mo kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Mm, tsi:kat ne: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>*Casi** ke:meskia no: pata:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>Ke:mah, pata:ni de n' ahoktia ihkó:n, de ke:meskia wa:kkatik, pata:ni ne:wi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>Wa:n yo:n de wetsiti a ox ixwa ne:wí:n ya tak oso ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>Ixwa iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>Es ke ka:sá: ika se: kita tatampa ne: ixwatok ihkó:n, ihko:ntsitsi:n ne:n ... Yo:n niman se: ki:xmati ke yo:n, yo:n kowit *porque** nehjó:n ma:..., de, de pe:wa ne: moskaltia, ihkó:n pané: eliwis xahxakachtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts518" TIME_SLOT_REF2="ts521">
                <ANNOTATION_VALUE>Seki, aya:mo alaxtik ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts525">
                <ANNOTATION_VALUE>Yo:n kipia ata ne: ihkó:n ra:rayi:tas, ihko:ni te:temo:tok, nochi ima:yo..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>Niman se: ki:xmati yo:n kowit, yo:n semi telpipi:nik wa:n pos yo:n ma:ski nehjó:n se: kitehteki, ma:ski ima:yo, yo:n semi tel, teleti:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>Etiktik, eti:k.Eti:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>Eti:k nehjó:n kowit ne:n pos yehwa yo:n neh niki:xmattok yo:n kowtsitsi:n ne:n pero a:mo nikmati neh ox, ox ne:n seki moskaltia, neh nikita sah i:pa ke:meh yo:ni sah ne:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>Tsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>Mela:wak mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>A:, ke:meh xo:me:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>Pero no: taman iteyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>Wa:n yo:n no: kikwih ikowyo para teisá: kikwih para kow..., kowtati:l *o** para teisá: ihkó:n kitekih para kaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>Tata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>Wa:n no:, no: tapa:ni se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>A:mo ke:keski:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts601">
                <ANNOTATION_VALUE>Pos yehwa yo:n ne:n neh a:mo nik..., tak nikpanowia yo:n kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Pero a:mo, a:mo nikmati ke:ní:w ito:ka:i, ne: ke:masá: ne:wí:n nikpanowia eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>Pero ekintsi:n ne:n pos ke:masá: ne:wí:n tikwile:waskeh tik..., tinemiti:wih wa:n kwali tine:chne:xtili:s yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts615">
                <ANNOTATION_VALUE>Yo:n kowtsí:n *porque** ke:meh i:n se: yeh pos kwali se: moli:s katí:n ox nik..., niki:xmati yo:n kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts623">
                <ANNOTATION_VALUE>Niki:xmattok okseki pero yeh, yeh a:mo nik..., nik..., tak, taknikita ihkó:n pero a:mo nikmati ke:ní:w ito:ka:i wa:n yehwa yo:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Pos we:noh, okseki kowit pos nik..., nikmattok yo:n kwaltia para ne:n teisá: ihkó:n para kowtati:l, pero nikihto:s teisá: kikwitih ihkó:n para kaltsi:n, a:mo kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts635">
                <ANNOTATION_VALUE>Yo:n mo..., se: ahko moma:so:sowa wa:n pos a:mo, a:mo kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>Kikwih, tak no: kwaltiaskia komo mehmela:wak no: kwaltiaskia, ta: yo:n semi takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts645" TIME_SLOT_REF2="ts647">
                <ANNOTATION_VALUE>Takwa:wak wa:n pos yo:n kihtowah ne:n chika:wak semi, ne:n et..., eti:k no:, de sepa se: kitehteki ne:n komohkó:n kowtati:l yeketi:k para se: kisa:saka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts653">
                <ANNOTATION_VALUE>*Igual** ke:meh se:, ne:n eti:k ke:meh ne:n xa:lxokot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>Ihkó:n de eti:k wa:n pos neh yehwa sah de yo:n nik..., nehjó:n nikmatisah de yo:n tekowit wa:n pos no: wal..., kwal..., ta:ká:n tikmatia ok teh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>*más* de yo:n tekowit pos kwali tine:chili:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>No: yehwa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>Pos komo yehwa sah kwali tine:chili:s ne:n moto:ka:i, ke:ní:w timono:tsa wa:n ka:n tiwa:le:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>Pos neh nimono:tsa Anastacio Nicolás Damián wa:n niwa:le:w de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
