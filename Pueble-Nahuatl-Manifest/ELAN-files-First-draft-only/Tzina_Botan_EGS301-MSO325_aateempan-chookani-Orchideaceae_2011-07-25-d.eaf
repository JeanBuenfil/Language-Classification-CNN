        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Ke:mah, wa:n no: iwki no: ye:kkohkostik xo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Ke:mah, ta: kwali se: ka:ketsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Kati:yeh n' chechelo:kamoh, a:mo niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>A:mo niki:xmati, neh niki:xmattok seki yo:n ne: tokaltsi:ntan no: onkak, yo:n, ata yo:n kiliah yowalxo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>yeh neli no: mowila:na, we:i, we:i mochi:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>wa:n yeh neli no: telahwia:k wa:n *solamente** yowak m' poso:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>No: taman ata. ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Ke:mah, neli yowak poso:ni wa:n neli no: ye:kahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>¿Katí:n *Cote**? ¿No: kipia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>Ke:mah, pos tehwa:n ne: kaltsi:ntan no: onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Wa:n neli yowak, yowak m' poso:ni wa:n ye:kahwia:k kwaltsi:n neli wa:n ye:kkwaltsi:n poso:ni, wa:n tane:siki tami kwetaw, wa:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>A:mo para se: ka:ketsas, i:pa yowak sah poso:ni wa:n no: ye:kahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>¿Kinamakah no:?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>A:mo, ta: ihwa:k sah yowak poso:ni. Wa:n komo tika:ketsak i:pa sayoh tepitsi:n yetok wa:n motsonikapilowa wa:n ompa tamik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>Wa:ki niman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Pos ka:n se: kimati ke:ní:w nochi mono:tsa, ke:meh miak taman xo:chitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>Ajá.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>Pos yehwa sah neh no: nikmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts390">
                <ANNOTATION_VALUE>tein yo:n tine:chilwih, a:mo no: n'mati *más** ke:ní:w wa:n neh nimono:tsa María Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
