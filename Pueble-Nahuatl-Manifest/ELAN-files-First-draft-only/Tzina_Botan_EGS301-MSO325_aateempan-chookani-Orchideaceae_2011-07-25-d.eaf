        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Ye:kwe:weyakaxtik.</ANNOTATION_VALUE>
