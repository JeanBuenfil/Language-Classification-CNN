        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>Ke:mah, kikowah ta: ye:kwehwei ata mochi:wa.</ANNOTATION_VALUE>
