                <ANNOTATION_VALUE>Ke:mah, pos ta: de ahwia:xtok wehka, wehka se: kihnekwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts235">
