        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Okots..., okotsokowxiwit wa:n pos yehwa yo:n no: 'kwitih ne:n ki..., tama:nelowah, kiliah nechi..., nechiko:l, miak pahtsitsi:n de xiwtsitsi:n ki..., kichi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>Wa:n para kimanah wa:n ika kina:ltiah kone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>Nehjó:n para ne: yo:n netati:l *porque** netati:l yo:n se:, kihtowah netati:l no: se:, ke:meskia chi:chinowtiw, yehyewalti:le:wi wa:n chi:chi:le:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>Ika yo:n ne: taneki:sa, kinkwi ne:n toto:nik oso sehsekwih ihkó:n wa:n ke:masá: mota:lihtinemih sayoh nehjó:n tastiwih, yehwa yo:n kinkwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n 'kwitih yo:n xiwtsi:n, miak tama:nelowah, yehwa ya n'... Miak, miak xiwtsitsi:n ne:n, de n' ma:ltantsi:n *o** seki, okseki pahti ne:n xo:me:t oso seki yo:n o:mekilit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>Miak, miak kikwitih wa:n para kima:nelowah, *por eso** kiliah ne: tanechiko:lxiwit, no: kitekih yo:n seki ne: chakaixiwit, nochi mika, miak xiwtsitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
