        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>Ompa yowi a, ne:n ke:meskia nekti ne:n yo:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>Para mokahka:wa, para a:mo mokwihkwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>Chichi:k.</ANNOTATION_VALUE>
