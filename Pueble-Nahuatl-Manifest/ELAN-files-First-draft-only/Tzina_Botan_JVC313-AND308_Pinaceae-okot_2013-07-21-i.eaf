                <ANNOTATION_VALUE>Mookxitia wa:n ke:mah ki..., kitektiowih wa:n ke:meh xi..., oksitiw iwki kitektiowih, kitektiowih tanamakanih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>wa:n *por eso** tikitah kwa:lkwih tsikitsitsi:n, ne: a:mo we:weyak ke:meh kowtati:l, sanoke tsikitsitsi:n kitekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>Ke:mah oksitiw, kitekih wa:n kitapa:ntiowih wa:n ke:mah nehjó:n iwki, *hasta** iwki tiktamo:tah kowit ne:n, ne: kitamo:tah de ke, de ke oksi kwikeh pos ki..., kitamo:tah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>Wa:n sa:te:pan *más** nalwat kihichkwahya *porque** nochi oksi na..., inalwayo, nochi oksi. Nochi oksi, nochi kwaltia nalwat yo:n no. Ke:mah kitehtektiowih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>Iwki kitektiowih, *cachitos** wa:n yo:n ki..., pero yo:n kike:stahchinolwiah para, para oksi. Ke:mah ke:stahchinolwiah wa:n no: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>Ke:mah wa:n no: kiliah okotsot yehwa tein okot a, tein kitatapatsah n' okot</ANNOTATION_VALUE>
