        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Kikwitih se: okot ihkwí:n kixahxama:nia:yah, we:weyak wa:n ika ki..., se: mota:wilia:ya.</ANNOTATION_VALUE>
