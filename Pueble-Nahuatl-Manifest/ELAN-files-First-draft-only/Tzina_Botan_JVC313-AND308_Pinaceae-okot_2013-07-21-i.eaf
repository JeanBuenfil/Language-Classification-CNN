        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>Para ne:n *cinta**, ke:ní:w kiliah wa:n pos yo:n nochi te:servi:roh nehjó:n kowit se: kitstinemi pero ekintsi:n a:mo no:wia:n onkak, ekintsi:n sayoh nochi ka:sá: ika sah se: kita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>A:mo, a:mo pos ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
