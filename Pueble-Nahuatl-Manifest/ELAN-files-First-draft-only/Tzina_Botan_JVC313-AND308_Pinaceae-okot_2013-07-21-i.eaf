        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Pos yehwa yo:n a:mo, a:mo se: kimati ke:ní:w nehjó:n kowit, ke:ní:w, ke:ní:w kichi:wah yo:n kwa:lkwih oso kitipanta:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
