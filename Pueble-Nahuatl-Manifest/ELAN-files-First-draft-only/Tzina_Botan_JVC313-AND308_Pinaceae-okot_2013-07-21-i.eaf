        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>Ke:mah. Ka:n kikwa n' okwilin, chichi:k wa:n mah xaxawaka pos a:mo kwe:lilia ok n' okwilin,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Iwki kito:katih ne: ka:mpa tachkwah n' okwilimeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>no: kichkwah n' okwiltsitsitsi:n sikie:ra ka:n o:me, e:yi, *hasta** ma:kwi:l *mata** kichkwah pero kiekowah a:mo wel xaxawaka *mejor** ka:wte:wah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>Yo:n a:mo ika mikih soh ke pos xaxawaka a:mo kwelitah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts491">
                <ANNOTATION_VALUE>Wa:n taman chichi:k tepitsi:n, wel..., a:mo ika mikih yo:n okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Soh ke a:mo kwelitah *porque** xaxawaka, mahyá: te:skayoh ne:n ... Ke:mah, yehwa yo:n kimowiliah, a:mo kwelitah, yehwa:n kinekih kwa:skeh pero tein a:mo xaxawaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n kiliah o..., okotsot yo:n okotsot kiliah icho:kil de n'okot.</ANNOTATION_VALUE>
