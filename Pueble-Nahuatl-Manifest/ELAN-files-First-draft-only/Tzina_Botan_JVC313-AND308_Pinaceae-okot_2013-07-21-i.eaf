        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>Ke:ní:w kichi:wah, ke:mah. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>Ke:mah, se: molwia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts553">
                <ANNOTATION_VALUE>Wa:n tokní:w tein kinehneki pos ki..., kichi:waltia wa:n kikwi, kikwi para kimpahwia okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>Pero a:mo kimpahwiah, sanoke a:mo mikih, *si no** para, para a:mo kikwah ne:n okwilimeh, kintsakwiliah ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>Kipale:wia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>Kipale:wia. A:mo, de *porque** a:mo kita:liliah wehka tachkwah ya yo:n okwilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts569">
                <ANNOTATION_VALUE>Tap..., okwiltsitsi:n kin..., kintamiah wa:n kina:wilchi:wah sah, a:mo no: kinkwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>Wa:n kwaltsi:n yo:n de ke soh ... Yo:n soh se: kita:liliah sah para a:mo kikwa:s, pero a:mo se: kimiktia ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>Ke:mah, ihkó:n. Kachi kwaltsi:n yo:n se: kita:lilia pahti wa:n a:mo yehwa yo:n *veneno** kita:liah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>Soh mah machi:wa sah, mah ka:waka:n yo:n xina:ch, mah kite:motih seki ta:kilo:t ne:kwí:n wa:n a:mo kwa:ka:n xi..., xina:ch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>Ke:mah iwki yo:n. Chichi:k wa:n *aparte** xaxawaka yehwa a:mo kwelitah kwa:skeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n. Yehwa sah yo:n nimitstahtania:ya ne:n okot, de miak taman ne: ki:sa ya, de, de okotsot wa:n de okotsot de a:t wa:n okotsot tein kowit ne:n wa:n okoxa:l tein yo:n ista:kokoxa:l wa:n yo:n kiliah kostikokot, kiliah ma:pisi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>Yehwa yo:n, miak taman ki:sa ya, de, de e:yi taman *casi** okot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406" TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>Na:wi taman tein ika to:ka:itia okotsot, pero n' okotsot de a:t okotsot wa:n se: okotsot tein kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>Yo:n ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>Ne: ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts615">
                <ANNOTATION_VALUE>Ke:mah, tila:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts619">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts624" TIME_SLOT_REF2="ts627">
                <ANNOTATION_VALUE>Ke:mah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>Seki a:mo wehkapan, seki wehkapantia ka:mpa, ka:mpa ne:wí:n ne: semi tila:wtok kowyoh, wehkapantia ne:n okot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>*Porque** nika:n tehwa:n se: kito:kas paniá:n, momaxalowah niman, a:mo moskaltia wehkapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>A:mo wehkapantia, ke:mah, momaxalowa kwaltsi:n, ke:mah. Para se: kitekis ima:xiwyotsi:n, ke:mah kwali se: kitekilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
