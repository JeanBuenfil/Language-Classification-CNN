        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>Pos yeh nikita pané: oholo:chtik ne:n ... Yo:n semi se: kimowilia, de n' ta:lpan panxi:ntok, ne:n seki xi:ni tein wa:kik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Se: wetsisneki, ye:kalaxtik. Ye:kalaxtik se: moxola:wa wa:n pos yo:n nikitstoya a:mo no: semi telweh..., telmo..., wehkatan moto:ka pané: paniá:n yeh mota:lia sah nalwat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Paniá:n sah wa:n yehwa yo:n ne:n pos nika:wí: de yo:n ika ta..., nimitsilia kikwih para ika tachihchi:wah no: onkak nika:wí:, ka:mpa ika ne:n, nika:wí:, nika:wí:, a:mo semi telwehka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Ompa no: onkak wa:n nika:wí: pos ka:sá: ika a:mo, a:mo tei nika:kwi:n, onkak okseko, tak yo:n no: kito:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Pos wa:n i:n okseki, i:n tein nimitsilia no: kwali para pahti, yo:n tak no: kwaltia para ne:n kalkowit.</ANNOTATION_VALUE>
