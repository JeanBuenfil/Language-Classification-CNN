        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Ki..., ki..., yo:n kipia pané: kopal panko nochi, yo:n, yehwa yo:n kwali oksi n' okot wa:n ke:mah kwa:lkwih kitatapatsah ne:n ta:tahmeh, kitatapatsah wa:n ke:mah ki..., ki..., kis..., kwite:wah se: tso:tsokol ompa kite:mah ne:n yo:n, yo:n okot tein tamomoxo:l a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Wa:n kichi:wah ne:n tekol wa:n ke:mah kita:liah tatampa se:, se: ... Ekintsi:n pos *cazuelita** onkak, a:mo onkak kaxahpa:s, onkaya kaxahpa:smeh ata, kiliah libri..., libriyohmeh kiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>De ompa kitapachowa:yah wa:n ke:mah ne: kipante:miliah kowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts438" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>ki..., taxo:taltiah, ki..., pankawa:nia nochi ne:n tso:tsokol ke:mah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>de kawa:ni a pos seki cho:kilohki:sa ne:n okot, ne:n tatampa, ke:meh te:mpilkak ne:n tso:tsokol itech n' *traste**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>pos ompa ihxi:ka yo:n pané: nekti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>Ke:mah, ke:mah de ompa ne: ki..., ki..., kichiah ya wa:n ta..., de una vez tami a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>Kiki..., kiki:xtiah yo:n wa:n ki..., kite:miliah ne:n xina:ch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Wa:n iwa:n xa:l kinelowah porin ... Para yo:n para mokahka:wa, para mokahka:wa *porque** xa:l ne: ke..., ke:mah wa:n ke:meh yo:n okotsot sasaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Wa:n chichi:k semi, sasaltik wa:n chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>Yo:n nehjó:n para mokahka:wa kita:liliah xa:l para mokahkahka:wa ya pero komohkó:n a:mo kita:lilihkeh xa:l mosenkwis wa:n a:mo wel kihki:xti:skehok, sepa se:wi ye:ktakwa:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>Takwa:waya, ke:mah de mokwihkwi, a:mo wel se: kitapetsko:ltia ok xina:ch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>A:mo ki:sa ok *mejor** ne: kinelowah iwa:n xa:l.</ANNOTATION_VALUE>
