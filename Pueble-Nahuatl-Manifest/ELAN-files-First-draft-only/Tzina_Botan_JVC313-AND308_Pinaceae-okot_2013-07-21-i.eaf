        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>Takwa:waya wa:n mokwihkwis ne:n xina:ch. A:mo ki:sa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts478">
