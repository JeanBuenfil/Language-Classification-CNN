        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>N' okot oso para kichi:wah ne:n teisá: ko..., kowit ke:meh i:n kaltsi:n ne:n kitsahtsaya:nah *o** kwaltia no: para ne:n kalkowit nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts214">
