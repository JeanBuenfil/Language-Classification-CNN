        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Entó:s seki a:mo tikmatih ke:niwki ne:n iteyo *o** ke:ní:w ahko xo:chiowa.</ANNOTATION_VALUE>
