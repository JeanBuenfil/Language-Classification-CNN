        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>se: 'kwiti:w wa:n sepa oksé: pos no:, no: se: ki..., se: 'kwiti:w, ke:mah pos i:n a:mo kachi se: 'kwiti ok ta: pos *antes** yehwa ne: kikwiah ne:n tota:tahwa:n, n' okot.</ANNOTATION_VALUE>
