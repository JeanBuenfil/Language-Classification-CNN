        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Nehjó:n no: semi kwali *hasta** popo..., ne: i..., icho:kilo no: poposoka de, de tata ya.</ANNOTATION_VALUE>
