            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>wa:n ika yo:n nehjó:n kinina:miki a ne:n kone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Nehjó:n xiwit semi, okotsokowxiwt semi telkwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>Pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298" TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>Wa:n yo:n de ahko, de yetok, a:mo nikmati ekintsi:n, ox de selistok, kwaltsi:n ahko [...]</ANNOTATION_VALUE>
