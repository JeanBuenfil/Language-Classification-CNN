        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>Ke:mah, pos kwali teh xa: kachi tikmattok de ke katí:n, ka:nachi ne:n kowmeh, teh kachi tikini:xmattok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts385">
