        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>Pos yehwa yo:n kwaltsi:n se: ki.., se: ki..., se: motapowia ihkó:n de ke ke:meh ekintsi:n nika:n nochi timonohno:tstokeh itech i:n ohti pos kwaltsi:n ne: tik..., tikitah nehjó:n xiwtsi:n, yo:n kwali se:, se: 'kwiti:w.</ANNOTATION_VALUE>
