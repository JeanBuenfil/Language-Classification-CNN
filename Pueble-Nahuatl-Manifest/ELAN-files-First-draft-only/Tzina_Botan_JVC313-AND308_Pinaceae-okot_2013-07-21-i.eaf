            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>A:, nochi kwaltia ma:ski inalwayo, a: pos yo:n kitehtektiowih, ihkwi:ntsitsi:n, tsikitsitsi:n.</ANNOTATION_VALUE>
