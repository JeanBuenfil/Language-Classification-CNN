        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>No: poposoka ya pero yo:n no: semi kwaltsi:n para kowtati:l.</ANNOTATION_VALUE>
