        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>Selitok a wa:n pos no: kwaltsi:n yo:n kwowit sayoh ke pos ke:masá: se: kineki para pahti pos tak kwaltia ma:ski wa:kik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>kwaltias ta: no:, yo:n semi ahwia:k ne:n ixiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts363">
