        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Kilian oko..., wa:n se: okotsot kiliah pero yeh okotsokowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>Yehwa o..., okot sah. Pos mati a sah ke:ní:w yo:n pero neh nikaki, nikaki wa:n nikitani ke:ní:w kichi:wah yehwa yo:n o..., okotsot ki:xtiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>Pero ki..., mahyá: kimanah ne:n, ne:n okot tein tatapats, tein kwali okotaxiwityehwa ne: kimanah wa:n ki:sa n' a:yo ne: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>Ki..., kitatapatsah pisi:ltik wa:n kitso:tsokolketsahwa:n kitapachowah para ihxi:kas itech ne:n *traste** de n' cho:kil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts525">
                <ANNOTATION_VALUE>Iwki, iwki kichi:wah yo:n okot. Ke:mah, tehwa:n a:mo tikchi:wah nika:n pero neh nikitani *porque** ne: ahko nite:tekitilia wa:n nikitani ke:ní:w kichi:wah nehjó:n tokni:wa:n. Nikitani, nikitani ke:ní:w kichi:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>Se:sepa kwali nochi se: te:tekitilia, ka:sá: ika se: yowi wa:n se: momaka kwe:ntah toni kichi:wa para no: nite:ilwi:s a neh nika:n noxola:l</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>ta:ka:n ehko to:nal ne:chtatsi:ntokiah, nikili:s toni nikitato ne:kwí:n *o** toni nikmattok ke..., ke:ní:w kichi:wah okotsot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>Ke:mah, ke:mah.</ANNOTATION_VALUE>
