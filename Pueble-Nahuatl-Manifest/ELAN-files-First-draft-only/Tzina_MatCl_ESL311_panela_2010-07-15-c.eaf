        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>Mm, a..., ka:sá: ika *a veinticinco** se:hse: tomi:n kilia:yah, mm.</ANNOTATION_VALUE>
