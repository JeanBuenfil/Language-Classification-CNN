        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>Yo:n kihtowah neli no: semi kwali, yehwa yo:n no: te:ta:tapowia:ya tehwa:n towe:ita:t wa:n towe:ina:n kihtowa:yah ke:meh i:n *cuando** se: nohne:l, neli, *a veces**, se:sepatika te:ta:ni neli ne:n tapia:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Te:ta:ni wa:n yo:n te:ta:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>yehwa yo:n kihtowah *cuando** yo:n ki:stok yehwa yo:n ichihchi ne: *o** pohposoktik kowtsi:n, mah se: kikwi wa:n mah te:xi:kohohsaka:n nika:n ka:mpa se: ixi:ktipa:n ka:mpa ika ne:n se: ixi:ktsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
