        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>A:mo nikmati *este** xa: tiknekia *más es..., ** xa: tikpia *más** talna:miki:lis *o, o más** tiki:x..., tikmati okseki talna:miki:lismeh kwali tine:chtapowi:skia wa:n ta:ká:n i:pa yehwa sah pos niktasohka:mati miak.</ANNOTATION_VALUE>
