        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>*Pues** neh niki:xehekowa xa: eski no: pahti, ma:ski te..., ma:s[ki]chi:chika:wak a pero mah tikihto:ka:n tehwa:n a:xa: kwe:cho:skeh *porque** yo:n a:mo wel tikihto:tih tik..., tik..., tikpatatih ika tote:noh ke:meh tein selik, tein selik kwaltsi:n xiktsonkwahkwa wa:n pa:ti. Wa:n yo:n tein wa:kik, neh nikilia pané: telpipiktik.</ANNOTATION_VALUE>
