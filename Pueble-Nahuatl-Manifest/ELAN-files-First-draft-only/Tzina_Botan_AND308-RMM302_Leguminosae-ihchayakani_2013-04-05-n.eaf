                <ANNOTATION_VALUE>pero tak yehwa yo:n wehka:wkayo:t, wehka:wkayo:meh katka pos yehwa:n i:n okseki to:ka:it kita:lia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
