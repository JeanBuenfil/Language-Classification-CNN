        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Pipiktik, a:mo wel se: kitsonkwahkwa wa:n se: kitatapatsa, se: kitahtapa:nati ika se: kwe:cho:ti ika se: itawa:n, komoke mahyá: tikihtowah tehwa:n *este** takwa:wak.</ANNOTATION_VALUE>
