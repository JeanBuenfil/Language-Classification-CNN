        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Wa:n no:, no: kito:ka:itia ihchayakani *porque** no: iwki *cuando** nimitsilia, *cuando** wa:ki no: ihkó:n kakisti ke:meh okseki tein pisi:ltik.</ANNOTATION_VALUE>
