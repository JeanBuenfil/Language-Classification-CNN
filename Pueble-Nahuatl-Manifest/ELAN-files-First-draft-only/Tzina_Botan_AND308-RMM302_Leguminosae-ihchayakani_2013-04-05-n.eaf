        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>Wa:n yo:n niki:xmattok neh pané: o:me taman, *hasta** e:yi taman onkak yo:n xiwtsi:n, a:mo nikmati ox tehwa:tsi:n ox tiki:xmattok, yehwa tein pahti, yehwa yo:n tsikitsitsi:n tikihtowah.</ANNOTATION_VALUE>
