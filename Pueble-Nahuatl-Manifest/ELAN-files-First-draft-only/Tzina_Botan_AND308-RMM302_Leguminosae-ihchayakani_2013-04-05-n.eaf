        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Pos telmiak tasohka:matik, i:pa yehwa sah yo:n ika nimitsnohno:tsak.</ANNOTATION_VALUE>
