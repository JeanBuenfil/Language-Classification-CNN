        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Ke:mah pos yehwa yo:n ika timonohno:tskeh *este** tasohka:matik miak ke tehwa:tsi:n tein tikmattok tine:chtapowia wa:n no: tein neh nikmattok nimitstapowia para ihkó:n pos ...</ANNOTATION_VALUE>
