                <ANNOTATION_VALUE>wa:n nika:n ka:mpa ika se: itahkoya:n, nika:n i:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Komoke mah se: ki..., se: moohsa nika:n wa:n mah se: mohsa nika:n, *andale**, ihkó:n *mero**.Ihkó:n *mero**, neh niki:xehehkowa eski yo:n xa: porin kihto:snekih toto:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>Neh niki:xehekowa iwki eski *porque** ta: i:n *a veces** se:sepa yo:n kihtowah neli te:ta:ni kihtowah ne: se: itapia:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
