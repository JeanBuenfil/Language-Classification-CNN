                <ANNOTATION_VALUE>Entó:s yehwa yo:n neh nimitstahtani:snekia tehwa:tsi:n ni..., oksepa nimitsah..., nimitsahsika:tatsi:ntokia, yo:n tein tiki:xmattok tehwa:tsi:n tein wehwei kowtsitsi:n moskaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>Ox para pahti no: *o** a:mo teh kwaltia para pahti *porque** yo:n a:mo wel nimitsilwi:ti neh ke para pahti *porque** yo:n pané: semi ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>A:mo semi, a:mo semi tikitah nika:wí: tehwa:n, yo:n onkak *solamente** ne:wí:n *más** para ahkokopa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>A: yo:n, tehwa:n tikihtowah *cuando** ata a:paltik oso *medio** xohxowik tepitsi:n kowtsí:n kina:l..., kina:ltikota:liah wa:n pe:wa mahyá: yo:n tehwa:n tikihtowah chihchiki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Yehwa yo:n.</ANNOTATION_VALUE>
