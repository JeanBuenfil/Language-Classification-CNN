        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>Ke:mah wa:n pos yehwa yo:n nimitstahtania *compadrito** yeh, teh xa: kachi, xa: kachi tikmati pero no:, no: *igual** de ke pos se: kitstinemi ihkó:n de se: nemi nejó:n kowtah,</ANNOTATION_VALUE>
