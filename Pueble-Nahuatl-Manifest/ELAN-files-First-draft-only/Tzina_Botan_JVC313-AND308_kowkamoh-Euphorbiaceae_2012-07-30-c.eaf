        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n kitehtekia, ne: se: kichipa:wa ya wa:n no: te:chilia:yah, de mah se: ki:xtili n' e:wat</ANNOTATION_VALUE>
