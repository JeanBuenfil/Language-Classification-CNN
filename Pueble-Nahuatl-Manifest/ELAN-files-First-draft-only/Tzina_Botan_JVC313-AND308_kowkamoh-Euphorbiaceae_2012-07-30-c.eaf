        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Kachi ma:..., ma:pisi:ltik kachi., ma:pisi:ltik.</ANNOTATION_VALUE>
