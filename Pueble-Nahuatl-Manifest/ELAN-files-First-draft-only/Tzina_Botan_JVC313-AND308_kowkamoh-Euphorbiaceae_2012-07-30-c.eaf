        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>Chichinahwia:..., [chichin]ahwia:ya wa:n *después** a:mo, a:mo *igual** we:lik ok.</ANNOTATION_VALUE>
