        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>Wa:n de selik ihkó:n kwaltsi:n ne:n yoksi seki tsikitsitsi:n se: kita, se: kiahkotila:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>Wa:n ye:kkwaltsi:n ne:n nehjó:n selik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>Tsikitsitsi:n se: ki:xtilia pos ne:nke:n se: ki *hasta** ika se: ima:i se: kipohposteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>A:mo moneki tateki:lo:ni ta ika se: ima:i se: kipohposteki wa:n kita:lia ihkó:n pero a:mo nikmati, a:mo nik..., pané: a:mo nikitak ox ki..., kitapechtiah no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>Mm, kitapechtiah ika xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>Ompa moma:nelowa ya, de mo:molo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>Wa:n ki:xtiah wa:n se: ki..., te..., te:makah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts556" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>No: wa:n i:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>A:mo wa:n i:n pos neh nik..., nikitaya no:we:lik ia:yotsi:n de n' kowkamoh. No: tso..., tsope:lik n' a:t wa:n ahwia:k ne:n i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>Pané: nekti wa:n ahwia:k nochi ne:n ia:yostsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>Pero kamohtsi:n ye:kkwaltsi:n se: kitapa:naya wa:n kwaltsi:n moloxtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>Ke:mah, kwaltsi:n tsope:k, a:mo ... Wa:n seki kihtowah ke koma:mo se: ki..., se:, kie:kmanah pos mochi:wa a:sese:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>A:sese:ya. Wa:n seki kihtowah ke kita:lilia:yah ke:wayah ne:wí:n sikie:ra ka:n e:yi to:nal para mah *más** tsope:ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Pero neh ni..., neh nikitaya ke:masá:, seki ka:mpa se: kwi:ltia, se: kichkwaya ika yo:n kowit pos pala:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>Pala:ni ka:mpa se: k..., A:ah, se: koyo:nia:ya ihkó:n, pala:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Wa:n seki kihtowa:yah kachi kwali kwelitayah ke mah ihkó:n ke:wtokeh ne:wí:n wa:n para mah tsope:ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>pero a:mo ta: yeh *más** kichi:wilia ne:n, ke:masá: a:sese:yaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>A:mo *igual** we:lik ok katka, xahxawatia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts619">
                <ANNOTATION_VALUE>Pos yehwa yo:n neh nikmattok ne:n ke:ní:w se: kito:ka wa:n ke:ní:w se: kimana, no: tak, pos neh no: kwali tine:chili:s *más**, ta:ká:n *más** tikmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Pos no: *igual** nehwa nehjó:n nehwa sah ihkó:n nik..., nikmati sah, ne:n a:mo no: ke:man nikita mah se: kita ne:wí:n *matita** mah ixwato tatampa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>Neh nikita soh de ne: pihpilkak ihkó:n ne:n pero a:mo nikita ne:n tatampa ox wetsi wa:n ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts637">
                <ANNOTATION_VALUE>Ke:mah wa:n yehwa yo:n neh nikmattok sayoh de ke *cuando** chika:waya ya pos ki..., *cuando** kichkwah pos ne:n ma:xi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts642" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>*Después** sepa ye..., sepa de yankwik selia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>Komo se: kito:ka wa:n komo se: kwiwita, ompa ne:wí:n ka:mpa ne: se: kwiwita wa:n sepa se: kitsi:nta:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>Pos sepa selia, yo:n a:mo mone:neki. A:mo ta:ki kihtowah s...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>Ihkó:n kihtowah ta: seki:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>Kachi kwali mah se: kito:ka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts669" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>Pos neh no: ompa niwa:ke:w ne: xola:lpan San Miguel Tzinacapan, nimono:tsa Anastacio Nicolás Damián.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
