        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>Wa:n yeh ke:mah, wehkapantia wa:n moi:xtohto:ka kwaltsi:n seki wehwei, yo:n tak kiliah chakay, yo:n wehwei mochi:wa, pero n' oksé: taman, a:mo niki:xmati, neh nikita nochi de n', de n' o:me, o:me taman sah niki:xmati wa:n ...</ANNOTATION_VALUE>
