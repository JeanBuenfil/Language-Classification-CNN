        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts495">
                <ANNOTATION_VALUE>Ihwa:k ok, ihwa:k kipiaya ne:n kamoh ne:n taihtik wa:n seki nikita de n', de se: kito:ka ihkó:n wa:n a:mo wehka:wa kipiaya ma:s[ki]tsikitsitsi:n.</ANNOTATION_VALUE>
