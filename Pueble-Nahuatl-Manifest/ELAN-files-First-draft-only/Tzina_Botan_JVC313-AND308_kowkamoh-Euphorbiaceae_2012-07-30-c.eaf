        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Koma:mo se: ima:i tsa:tsaya:ni nehjó:n e:wat de n', de n' chakay n' i..., ie:wayo.</ANNOTATION_VALUE>
