        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Ke yo:n no: cho:kiloh</ANNOTATION_VALUE>
