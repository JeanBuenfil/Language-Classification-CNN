        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>No: cho:kiloh wa:n pos yo:n moneki mah se: kitehteki wa:n pos *antes** ne:n tota:tahwa:n kita:lilia:yah yehwa yo:n *panelita** ihkó:n, de n' tsope:lik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>*o** kwit..., konkwiah ihkó:n ne:n tein yo:n a:mo, te..., ihkó:n *panelita**, ke:masá: ne:n tsikti moka:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>Pos a:mo kwali, yehwa yo:n kita:lilia:yah, ne: a:na:lpa, ne:n kamoh, kichkwatoyah ne:n kamoh ihkó:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
