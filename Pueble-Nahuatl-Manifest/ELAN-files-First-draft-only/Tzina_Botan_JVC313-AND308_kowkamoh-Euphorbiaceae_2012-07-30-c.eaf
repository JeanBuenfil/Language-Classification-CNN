        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>A:mo kwaltia ok wa:n ma:ski se: kichkwa wa:n mah se: kitehteki, ihkó:n se: kixihxi:ma, a:mo, a:mo kwaltia ok, ta: a:mo *igual** we:lik ok.</ANNOTATION_VALUE>
