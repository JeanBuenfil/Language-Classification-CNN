        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>wa:n kwaltsi:n se: kikwa, mohmoloxtik kamohtsi:n.</ANNOTATION_VALUE>
