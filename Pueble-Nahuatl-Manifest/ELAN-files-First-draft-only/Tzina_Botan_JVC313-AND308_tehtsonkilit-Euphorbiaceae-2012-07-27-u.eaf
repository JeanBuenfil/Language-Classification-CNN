        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>xo:chit iwa:n oksi a wa:n</ANNOTATION_VALUE>
