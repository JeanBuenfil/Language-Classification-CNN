        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>soyokilit iwa:n se: kinelowa wa:n o:me, e:yi etsí:n wa:n tsiktsi:n tixtsí:n kini..., kita:liliah ne:n soyokilit ne:n iwa:n kinelowah n' ko:nko,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
