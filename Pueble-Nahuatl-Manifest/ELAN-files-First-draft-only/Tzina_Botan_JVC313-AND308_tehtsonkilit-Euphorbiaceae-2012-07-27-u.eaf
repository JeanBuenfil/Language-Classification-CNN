        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498" TIME_SLOT_REF1="ts812" TIME_SLOT_REF2="ts813">
                <ANNOTATION_VALUE>Wa:n se: *morado** n' ikowyo wa:n ima:tampa, ima:tampa ya xiwit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>tahtalwayoh e..., nochi *morado** n' italwatsitsi:n[italwayotsitsi:n], ka:mpa ikowyotsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500" TIME_SLOT_REF1="ts816" TIME_SLOT_REF2="ts817">
                <ANNOTATION_VALUE>Yehwa nikilwia italwayo, ima:tampa nochi tahtalwayoh mahyá: ikowyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts818" TIME_SLOT_REF2="ts820">
                <ANNOTATION_VALUE>wa:n nochi *morado** wa:n ye:kyekapitsaktik yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts824">
                <ANNOTATION_VALUE>Ye..., yo:n a:mo, yeh telahwiya:k yo:n, tel..., telchika:wak n' ahwiya:k wa:n, wa:n a:mo pa:ti ye:kkakaltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504" TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>Ista:k wa:n ma:yehyewaltik achi, ma:yehyewaltik, yehwa yo:n kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts830" TIME_SLOT_REF2="ts832">
                <ANNOTATION_VALUE>Yo:n t..., yo:n telwe:lik, a:mo semi ahwiya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508" TIME_SLOT_REF1="ts834" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>A:mo semi ahwiya:k wa:n i:n seki telahwiya:k, kipia semi se: ne:n ahwiya:kka:yo:t wa:n, wa:n semi kakaltik, a:mo, a:mo pa:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510" TIME_SLOT_REF1="ts838" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>Ke:mah. Para tapalo:l semi s...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts845">
                <ANNOTATION_VALUE>kwaltsi:n se: kimati moch..., se:..., mah se: kimati *este** ke:ní:w [...]tapalo:l kwali se:, se: motamaka ika wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts848">
                <ANNOTATION_VALUE>no: se: kichi:wa, se: a:mo weli pos se: moyo:lmahxitia wa:n kichi:wa ya no: wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>para ika motamakah ya. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts854" TIME_SLOT_REF2="ts857">
                <ANNOTATION_VALUE>se: kitstinemi ki:ní:n to:n totapalo:l, ne: ki:ní:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>Ke:mah. A:i... Yo:n kwali se: kao..., se: kitewa:ts..., yo:n a:mo teh kichi:wa se: mopahwia kwali se: kitewa:tsa, ahwiya:k ke:meh ayohtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522" TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts869">
                <ANNOTATION_VALUE>Ke:mah, ahwiya:k no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524" TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts873">
                <ANNOTATION_VALUE>Ke:mah, pero nejó:n i:n kiltsí:n semi ahwiya:k soyokilit iwa:n tehtsonkilit ye:kwe:lik n' tapalo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts877">
                <ANNOTATION_VALUE>Ye:kwe:lik. Ke:meh i:n koyo:meh se: kwa:lkwili:skia[kiniwa:lkwili:skia]nika:n kwelitaskiah kkwa:skiah, ye:kahwiya:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528" TIME_SLOT_REF1="ts879" TIME_SLOT_REF2="ts881">
                <ANNOTATION_VALUE>Ke:mah kwaltsi:n we:lik. E..., kanah, kit..., kimanah ihkó:n iwa:n..., i..., ka:yo:tiah tepitsi:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530" TIME_SLOT_REF1="ts883" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>Iwki se: ki..., komo se: kineki kilit sah se: kikwa:s, [se:]kipanki:xtia ika n' tahmolo kilit sah, ompa mah mota:li wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts888" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>teh t'mati ke:ní:w t'chi:was, komo tikoko:lia, xkoko:li, ke:..., ke:meh se: kinekis a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533" TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts894">
                <ANNOTATION_VALUE>Iwki yo:n se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts896" TIME_SLOT_REF2="ts898">
                <ANNOTATION_VALUE>A:, n' *chilito** kwe:liltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536" TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts901">
                <ANNOTATION_VALUE>Ke:mah, se: kipanta:lilia chi:l..., chi:ltekpin kwaltsi:n we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538" TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>kwaltsi:n se: te:welia, se: te:we:lia kwal... Ke:mah, ke:mah. Pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540" TIME_SLOT_REF1="ts908" TIME_SLOT_REF2="ts910">
                <ANNOTATION_VALUE>yehwa sah n' ika timonohno:tsah ika i:n takwalis ika ne:n tehtsonkilit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542" TIME_SLOT_REF1="ts912" TIME_SLOT_REF2="ts915">
                <ANNOTATION_VALUE>We:lik para se: kikwa, a:mo t..., a:mo teh kichi:wa. Ke:mah, we:lik. Pos yehwa sah yo:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544" TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>neh niwa:le:w nika:n San Miguel Tzinacapan wa:n nimono:tsa niErnesto Vázquez.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
