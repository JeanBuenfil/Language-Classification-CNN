        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>ke:meh niki:xmattok se: taman sah, pos tehwa:n tikwa:nih ne:n yo:n ixo:chio, tein tohtomoktsitsí:n, yo:n selontsi:n,</ANNOTATION_VALUE>
