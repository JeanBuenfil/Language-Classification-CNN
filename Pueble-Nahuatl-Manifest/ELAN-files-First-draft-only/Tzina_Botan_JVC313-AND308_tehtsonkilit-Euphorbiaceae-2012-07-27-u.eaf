                <ANNOTATION_VALUE>ki:xpa:ka wa:n se: kite:milia, 'pante:ma ya n' ko:nko wa:n ma:n..., 'ma:nelo wa:n iwa:n oksi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479" TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts767">
                <ANNOTATION_VALUE>Iteyo we:lik mah se: kitewa:tsa, pero ka:n..., ka:n wel se: kololowa, a:mo se: kiteki *porque** ye:kwitsyoh.</ANNOTATION_VALUE>
