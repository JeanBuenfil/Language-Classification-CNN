    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Amelia Domínguez Alcántara" TIER_ID="Amelia Domínguez Alcántara">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>A:xka:n niknekiskia xne:ch..., xne:chyo:lmela:wa, xa: tikmati ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>neh ni..., nikinte:nkak okseki tokni:wa:n kite:ne:wah se: kowit mono:tsa ma:tanka, ma:tankaxiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>Niknekiskia xine:chtapowi ne:, ¿ka:ni n' onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>ke:niwki n' kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>ox xo:chiowa, teyowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>toni n' kikwih?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>¿Ox i:ksá: t'tatekiwtia n' teh, toni n' tik..., toni n' tikchi:wilihka ke:man tiko:nkwika?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Ne: pos, ¿komohkó:n xiwyo ne: se: kitekiti wa:n se: kito:ka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>ka:n selia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Wa:n iteyo n' ixo..., iteyo ne: tikihtowa no: teyowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>I:n iteyotsi:n, ¿kwaltia ika se: mopahtia, kwali se: tai:s oso ika mota..., kikwah chiktehmeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>¿I:n kwowit n' ixo:chio ke:niwki?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>¿Entó:s teh tiknekiskia mah sepa se: kito:ka i:n kwowit?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Niknekiskia xine:chye:kyo:lmela:wa, ¿ke:yeh kiliah ma:tanka?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>A:xá: tikihtowa ka:mpa yo:n ekintsi:n ihkatok se: xa: ihkatoya se: kali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>A:, n' tatsakkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>Pos yehwa sah, miak tasohka:matik, ne:chtapowi moto:ka:y, ke:n timono:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>¿Ka:n tiwa:le:w?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
