        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>Yeh ika kinimpe:wayah kwa:kwehtsitsi:n, yehwa kwelitah porin weyak wa:n pihpitsa:wak wehka ahsi ne: ... Ke:..., ke:mah kwa:kowi:teko:ni kiliah, komo ka:sá: ika tayu:ntahwiah wa:n kitekih yo:n ki..., yehwa yo:n kowit kite:mowah.</ANNOTATION_VALUE>
