        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Ka:n tahmatiah, ka:n tahmatiah, mm. Ka..., a:mo tama:mah yo:n, aya:mo tama:mah, nió:n para se: kiniwi..., kiniwila:nah nikita, tahmatih, nentokeh ixta:wat soh nentokeh no: mowih kiniwi:kaskeh ka:sá: ika kinohtokalti:skeh.</ANNOTATION_VALUE>
