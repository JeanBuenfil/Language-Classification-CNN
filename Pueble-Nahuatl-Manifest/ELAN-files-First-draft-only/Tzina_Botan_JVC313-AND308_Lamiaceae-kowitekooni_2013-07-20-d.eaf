                <ANNOTATION_VALUE>"Pos achto" kihtowa "ke:meh nochi tokni:wa:n kipia kwa:kowtsi:n" kihtowa "kwi:kah kowtah, mah tatekiti, mah koh..., mah tatekiti ikowtah oso yowi tatekiti</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>kwi:ka ikwa:kow" kihtowa "wa:n ika kwi:tekiah, ki..., kitektiki:sa nika:n, *pobre** kwowit, kwextawiah ika ikwa:kow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>Ika tikta:lilihkeh, kita:lilihkeh ta:tameh kwa:kowi:teko:ni".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>I:ksá: onkak tako:tsi:n ata mochi:wa melaktik tako:tsitsi:n, ke:mah wa:n mehmela:wak mochi:wa wa:n pihpitsa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>Yehwa yo:n ..., "A: pos ika kitokah". "Ke:mah" kihtowa "ika kwa:kwehmeh kinwi:te:kiah" kihtowa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>wa:n ika ki..., kito:ka:itihkeh" kihtowa "ke kwa:kowi:teko:ni".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Ika tape:wayah, nochi ihwa:k pos tokni:wa:n ke:meh ihwa:k a:mo tapoliwia ke:meh eskintsi:n tachtekih, yeh a:mo, ekintsi:n a:mo wel se: kipia ok kwa:kweh ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>Wa:n t'piah ka:ni tikimpiaskeh pero ihwa:k kipiayah kwa:kwehtsitsi:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>kitama:maltia:yah, mahyá: itskwintsitsi:n kwi:katinemiah n' tapialmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>I..., i..., ikwa:ko kwa:ta:liliah kowtsí:n oso teisá: tama:maltsi:n kahsih, kahbe:ntsi:n oso teisá: tama:mal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Ikwe:rnohtikpak kita:liah wa:n kilpiliah ika tamali:n wa:n kwa:li:ka ya n' tapialtsi:n, kwa:lma:mahtiwi:ts. Ki..., kite..., *o** kipe:wah, ta: pos ihwa:k tapialmeh katka tamattokeh no:, kimpe:wayah no: i..., no: ika ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>A:mo onkaya cabayohmeh, nio:nó: ... *Burritos** sa..., yeh, yeh sa:te:pan pe:wak ne:si pero n' achto onkayah kwa:kwehmeh sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Yehwa sah. Kem..., komo tekititih *o** kinte..., kintekiti:ltiah wa:n komohkó:n kwowtah kwi:ka pero kwi:kah kwa:kwehtsi:n wa:n kowtsí:n kwa:lkwa:ta:liliah ya wa:n wi:tsa ya, kwa:lpe:wa ite:ko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>Iwki kichi:wayah ihwa:k, ikwa:ko ne:n ... Ke:mah, se: tama:maltsi:n kwa:lkwi ikwa:ko tapialtsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>Wa:n no: tamattoyah, ka:n ... kwali kwa:lkwia ikwa:ko ne:n tama:mal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Ke:mah, pero ekintsi:n a:mo. a:mo, a:mo tikitah ok yo:n, ekintsi:n nochi tehwa:n tikwa:ma:mah wa:n koma:mo pos kipiah tapialmeh kisakatih ika kowtsi:n, koma:mo itech *coche** ne:li 'kwitih ne:n tama:mal. Kintama:maltia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Wa:n moka:waya n' tapialtsi:n, no: moka:waya, [amo]no: ... Ki:xmattoya ite:ko pos moka:waya mah kwa:ilpili:ka:n kowit. Kanah ok, kanah ok wa:n ke:mah. Kimachtia:yah wa:n onkayah kwa:kwehmeh tein yo:n i:pa, i:pa de nika:n kwa:kwehmeh, i:pa para ne: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>A:mo koyo:kwa:kwehmeh, ekintsi:n wi:tseh koyo:kwa:kwehmeh, yo:n ahalaxtikeh, ista:keh *o** nextikeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>yo:n a:mo para tekit, yo:n soh para, soh para se: kikwa:s sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>Ke:meh, ye:konkayah nika:n, i:n *mismo** se:meh nika:n kikwiah yehwa:n ne: ki..., pos kwali para, para tekit katka yo:n, tekitiah *porque** kwali kipiayah inkwe:rnoh kwaltsitsi:n wa:n i:n seki pos ata seki a:mo, a:mo kwe:rnohyehkeh, kwa:tehtemolotikeh sah pos a:mo kwaltia para tekitis yo:n, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Yehwa ika.</ANNOTATION_VALUE>
