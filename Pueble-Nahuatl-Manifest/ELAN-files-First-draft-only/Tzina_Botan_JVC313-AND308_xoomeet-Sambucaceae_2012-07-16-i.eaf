        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Wa:n ye:kmay..., wa:n no: iwki ye:kma:wehwei, ye:kwe:weyak n' ima:kowyotsi:n wa:n ixiwyo ye:kma:wehwei no:</ANNOTATION_VALUE>
