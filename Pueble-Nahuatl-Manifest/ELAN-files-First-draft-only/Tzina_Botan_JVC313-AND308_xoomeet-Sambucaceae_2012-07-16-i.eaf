        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>[Ke:]mih i:n ke:masá: se: ehko nijó:n,</ANNOTATION_VALUE>
