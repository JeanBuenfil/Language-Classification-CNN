        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Mehmela:wak moso...</ANNOTATION_VALUE>
