        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>Yo:n wehweixo:met ye:kwehwei mochi:wa, tohtomaktik, ye:ktohtomaktik, seki mochi:wa tein wehwe:t a, *hasta** se: tanawa:l mochi:wa.</ANNOTATION_VALUE>
