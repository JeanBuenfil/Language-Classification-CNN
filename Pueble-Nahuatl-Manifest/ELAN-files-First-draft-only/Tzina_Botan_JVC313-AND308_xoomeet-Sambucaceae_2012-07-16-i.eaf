        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Wa:n komo semi kwaltia *para corral** yo:n, semi tako:wtamach kita:liah *corral, para esquinero** tikiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
