        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>Para a:mo xi:i:ni, *porque** kihtowah *que**,</ANNOTATION_VALUE>
