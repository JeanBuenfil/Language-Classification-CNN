            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>A:mo kachi ok.</ANNOTATION_VALUE>
