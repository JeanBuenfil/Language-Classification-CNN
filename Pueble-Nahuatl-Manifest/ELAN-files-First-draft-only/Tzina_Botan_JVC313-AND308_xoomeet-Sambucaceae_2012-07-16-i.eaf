        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts611" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>Ke:mah, pos</ANNOTATION_VALUE>
