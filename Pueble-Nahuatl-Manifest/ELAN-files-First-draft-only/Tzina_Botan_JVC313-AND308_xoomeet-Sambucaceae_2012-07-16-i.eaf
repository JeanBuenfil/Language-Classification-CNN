        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts568" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>*Igual** n' o:mekilit no: mokwa:ta:lilia:yah, no: iwa:n, *casi** no: kita:lilia:yah.</ANNOTATION_VALUE>
