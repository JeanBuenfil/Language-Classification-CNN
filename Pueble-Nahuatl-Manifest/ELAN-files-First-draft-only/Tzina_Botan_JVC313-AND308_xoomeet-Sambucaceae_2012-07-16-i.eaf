        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Se: yehwa a:mo se: kimachilia pero se:, se: kone:t kimachilia *porque** nohne:l, selik.</ANNOTATION_VALUE>
