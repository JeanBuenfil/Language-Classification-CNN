            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>yehwa nijó:n kinchi:wilia *mal**, ke:masá: se: ki...,</ANNOTATION_VALUE>
