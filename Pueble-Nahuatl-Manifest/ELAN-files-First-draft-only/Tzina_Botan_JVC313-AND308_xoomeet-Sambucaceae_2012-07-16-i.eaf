        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>tikmati pos kwali tine:chili:s nijó:n xa: tikmati ok *más** de i:n xo:me:t.</ANNOTATION_VALUE>
