            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>Wa:n ye:ktohtomaktik mochi:wa wa:n ye:kweyakaxtik.</ANNOTATION_VALUE>
