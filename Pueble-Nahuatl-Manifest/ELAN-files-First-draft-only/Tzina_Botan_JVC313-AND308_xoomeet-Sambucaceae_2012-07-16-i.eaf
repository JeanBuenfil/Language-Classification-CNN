        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>ti..., se: kone:tsí:n ihkó:n tsahtsi,</ANNOTATION_VALUE>
