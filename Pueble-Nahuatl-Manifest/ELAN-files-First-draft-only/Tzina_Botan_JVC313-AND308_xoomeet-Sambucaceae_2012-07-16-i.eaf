        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>pos yo:n nijó:n kahsi ehekat.</ANNOTATION_VALUE>
