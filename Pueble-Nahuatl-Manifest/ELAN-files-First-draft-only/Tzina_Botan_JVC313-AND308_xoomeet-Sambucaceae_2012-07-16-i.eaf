        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>pos ne:n *semillita** semi tihtilti:k, seki wehwei mochi:wa.</ANNOTATION_VALUE>
