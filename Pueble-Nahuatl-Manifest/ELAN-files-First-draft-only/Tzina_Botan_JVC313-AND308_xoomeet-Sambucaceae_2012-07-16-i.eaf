        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>wa:n nijó:n ki:sa ne:n ehekat.</ANNOTATION_VALUE>
