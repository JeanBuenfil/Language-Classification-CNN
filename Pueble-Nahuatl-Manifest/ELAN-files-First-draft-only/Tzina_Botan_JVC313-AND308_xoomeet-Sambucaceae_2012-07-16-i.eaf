        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>Pochi:ntok *cuando** mochi:wa ya ne:n,</ANNOTATION_VALUE>
