        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>Pos kintsi:n a:mo kachi kikwih ok.</ANNOTATION_VALUE>
