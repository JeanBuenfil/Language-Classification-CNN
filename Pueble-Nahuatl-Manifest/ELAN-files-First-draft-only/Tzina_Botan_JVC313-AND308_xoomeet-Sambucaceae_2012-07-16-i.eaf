        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>*Cuando** tehwa:n timoskaltihkeh ihkó:n te:chilia:yah, tikitayah ihkón ki..., ne: a:na:l kikwiah.</ANNOTATION_VALUE>
