        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>Pos achi, te:chipa:wah nochi de se: ii:xko oso se: ima:ko,</ANNOTATION_VALUE>
