        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>wa:n kwaltsi:n ne:n pochi:ntok.</ANNOTATION_VALUE>
