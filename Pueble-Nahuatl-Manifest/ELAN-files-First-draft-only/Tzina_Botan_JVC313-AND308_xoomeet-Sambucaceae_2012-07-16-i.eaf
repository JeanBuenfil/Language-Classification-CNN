        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>Para a:mo xi:i:ni ne:n tsonti.</ANNOTATION_VALUE>
