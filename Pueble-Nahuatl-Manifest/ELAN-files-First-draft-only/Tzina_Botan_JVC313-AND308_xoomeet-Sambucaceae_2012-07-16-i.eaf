                <ANNOTATION_VALUE>wehkatan kito:kah wa:n niman selia yo:n xo:me:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
