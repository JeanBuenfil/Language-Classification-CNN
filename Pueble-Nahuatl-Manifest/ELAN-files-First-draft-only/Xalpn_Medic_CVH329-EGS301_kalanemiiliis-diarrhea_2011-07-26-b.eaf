        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1136" TIME_SLOT_REF1="ts1969" TIME_SLOT_REF2="ts1970">
                <ANNOTATION_VALUE>Ke:meh i:n se: sepa teihsá: kikwah wa:n kinihtikokowa wa:n kalanemi:liskwih,</ANNOTATION_VALUE>
