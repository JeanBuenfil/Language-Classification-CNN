        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a654" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts863">
                <ANNOTATION_VALUE>Ke:mah, tikwi a wa:n tik..., de se:wik a t'ta:lia moma:ko ya,</ANNOTATION_VALUE>
