        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1085" TIME_SLOT_REF1="ts1853" TIME_SLOT_REF2="ts1856">
                <ANNOTATION_VALUE>E:mah, ihkó:n no: nikitaya neli kichi:wah pero a:man neli tikihto:s teh a:mo tikchi:wah ok.</ANNOTATION_VALUE>
