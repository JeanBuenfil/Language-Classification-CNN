        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts861">
                <ANNOTATION_VALUE>tiki:xte:ka kwaltsi:n ne:, mah yowi n' tein chipa:wak wa:n ne: tein ke:meh eskia tetsa:wak a moka:wak a nika:n.</ANNOTATION_VALUE>
