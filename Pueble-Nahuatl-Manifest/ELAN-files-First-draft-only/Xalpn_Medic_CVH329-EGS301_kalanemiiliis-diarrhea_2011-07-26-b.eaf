        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1130" TIME_SLOT_REF1="ts1957" TIME_SLOT_REF2="ts1958">
                <ANNOTATION_VALUE>Se: *rollito* se: kima..., se: taki:tskiltsi:n se: kimana,</ANNOTATION_VALUE>
