        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1154" TIME_SLOT_REF1="ts2010" TIME_SLOT_REF2="ts2011">
                <ANNOTATION_VALUE>wa:n, wa:n yo:n ne:chilihka yeha yo:n kokolis nikpiya,</ANNOTATION_VALUE>
