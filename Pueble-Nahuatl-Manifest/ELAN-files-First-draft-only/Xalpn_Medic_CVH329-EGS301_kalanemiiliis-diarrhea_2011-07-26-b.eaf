        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1150" TIME_SLOT_REF1="ts2002" TIME_SLOT_REF2="ts2003">
                <ANNOTATION_VALUE>*Porque** neh ne: se: *tiempo**,</ANNOTATION_VALUE>
