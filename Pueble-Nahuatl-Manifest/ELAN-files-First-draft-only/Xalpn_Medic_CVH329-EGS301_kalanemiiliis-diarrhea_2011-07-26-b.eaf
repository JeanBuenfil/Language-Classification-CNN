        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1161" TIME_SLOT_REF1="ts2024" TIME_SLOT_REF2="ts2025">
                <ANNOTATION_VALUE>ihkó:n i:pa pané: a:mo n'mati a:mo n'nekia nikwa:s yo:n pahti pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1162" TIME_SLOT_REF1="ts2026" TIME_SLOT_REF2="ts2027">
                <ANNOTATION_VALUE>ne:chiliwia ne: nota:to, kihtowa xikwa kihtowa, ta: tak ne: mitsakakeh xikwa.</ANNOTATION_VALUE>
