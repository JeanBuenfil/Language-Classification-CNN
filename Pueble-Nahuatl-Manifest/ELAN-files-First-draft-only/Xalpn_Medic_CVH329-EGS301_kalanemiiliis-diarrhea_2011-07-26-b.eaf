            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>*Tanto** ke:meh we:itokni:w tikpahtiah iwki, *tanto** ke:meh pili, *igual**.</ANNOTATION_VALUE>
