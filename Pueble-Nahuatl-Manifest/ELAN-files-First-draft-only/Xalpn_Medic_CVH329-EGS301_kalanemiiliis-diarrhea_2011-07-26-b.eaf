        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1140" TIME_SLOT_REF1="ts1979" TIME_SLOT_REF2="ts1980">
                <ANNOTATION_VALUE>Komo kina:miki a nikilia, pos a:mo tiow ok.</ANNOTATION_VALUE>
