        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a806" TIME_SLOT_REF1="ts1210" TIME_SLOT_REF2="ts1212">
                <ANNOTATION_VALUE>yehwa yo:n ika tahmolo ne:n kiki:xtiah,</ANNOTATION_VALUE>
