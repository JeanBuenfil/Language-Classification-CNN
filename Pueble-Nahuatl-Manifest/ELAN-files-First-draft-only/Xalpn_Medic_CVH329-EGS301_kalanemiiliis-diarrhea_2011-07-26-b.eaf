                <ANNOTATION_VALUE>a:man ne:, yekintsi:n a:mo nikwa:lik n' tein yo:n ke:mantika nikwa:lkwiya. Ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
