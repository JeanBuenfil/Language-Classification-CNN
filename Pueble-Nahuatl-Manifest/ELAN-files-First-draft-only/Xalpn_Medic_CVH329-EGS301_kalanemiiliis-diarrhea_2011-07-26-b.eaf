        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1163" TIME_SLOT_REF1="ts2028" TIME_SLOT_REF2="ts2029">
                <ANNOTATION_VALUE>*Pero a los** nochi nika:wa nikilia, *lo que** tein tikwa:skiah tapalo:l nikilia, a:mo sen taman ok nikwa:ti nikilia, iwki sah nietoti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1164" TIME_SLOT_REF1="ts2030" TIME_SLOT_REF2="ts2031">
