        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1282" TIME_SLOT_REF1="ts2269" TIME_SLOT_REF2="ts2272">
                <ANNOTATION_VALUE>Ahmo ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1287" TIME_SLOT_REF1="ts2281" TIME_SLOT_REF2="ts2283">
                <ANNOTATION_VALUE>Ke:mah, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1289" TIME_SLOT_REF1="ts2285" TIME_SLOT_REF2="ts2288">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1292" TIME_SLOT_REF1="ts2293" TIME_SLOT_REF2="ts2296">
                <ANNOTATION_VALUE>Miak, miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1295" TIME_SLOT_REF1="ts2301" TIME_SLOT_REF2="ts2303">
                <ANNOTATION_VALUE>Pos nochi owih, yo:li:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1297" TIME_SLOT_REF1="ts2305" TIME_SLOT_REF2="ts2308">
                <ANNOTATION_VALUE>Yo:lik, yo:li:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1299" TIME_SLOT_REF1="ts2310" TIME_SLOT_REF2="ts2313">
                <ANNOTATION_VALUE>Koyo:tapahtihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1302" TIME_SLOT_REF1="ts2319" TIME_SLOT_REF2="ts2320">
                <ANNOTATION_VALUE>*Como que** mah nikihto, tikowihitah a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1303" TIME_SLOT_REF1="ts2321" TIME_SLOT_REF2="ts2322">
                <ANNOTATION_VALUE>Tikowihitah para titekitiskeh kalihtik t'chi:waskeh yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1304" TIME_SLOT_REF1="ts2323" TIME_SLOT_REF2="ts2324">
                <ANNOTATION_VALUE>nepahti:lis, *mejor** tiowih seko.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1305" TIME_SLOT_REF1="ts2325" TIME_SLOT_REF2="ts2327">
                <ANNOTATION_VALUE>¿Pero to:n *pasarowa**? Ti..., tika:watih n' tomi:ntsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1310" TIME_SLOT_REF1="ts2336" TIME_SLOT_REF2="ts2339">
