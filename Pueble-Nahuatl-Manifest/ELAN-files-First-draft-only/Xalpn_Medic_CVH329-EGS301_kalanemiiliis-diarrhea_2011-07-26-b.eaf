        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1149" TIME_SLOT_REF1="ts2000" TIME_SLOT_REF2="ts2001">
                <ANNOTATION_VALUE>Koyo:pah pané: a:mo te:chna:mikis neh n'mati kit.</ANNOTATION_VALUE>
