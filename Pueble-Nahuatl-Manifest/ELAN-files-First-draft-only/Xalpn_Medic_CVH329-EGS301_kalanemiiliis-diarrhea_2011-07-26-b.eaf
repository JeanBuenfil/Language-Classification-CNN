            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a894" TIME_SLOT_REF1="ts1414" TIME_SLOT_REF2="ts1415">
                <ANNOTATION_VALUE>wa:n ompa x'pankalaki yo:n, yo:n *tejacachito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a895" TIME_SLOT_REF1="ts1416" TIME_SLOT_REF2="ts1417">
                <ANNOTATION_VALUE>Ompa x'panta:li ne: itech n' a:tsí:n, kwaltsi:n molo:nis, momolokas, momolokas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a896" TIME_SLOT_REF1="ts1418" TIME_SLOT_REF2="ts1419">
                <ANNOTATION_VALUE>Ke:mah ne: mah se:wi a n' a:tsí:n wa:n ne:, 'maka ya n' kokoxkeh, mah tai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a897" TIME_SLOT_REF1="ts1420" TIME_SLOT_REF2="ts1421">
                <ANNOTATION_VALUE>Wa:n komo a:mo kintamati:lih yeha yo:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a898" TIME_SLOT_REF1="ts1422" TIME_SLOT_REF2="ts1423">
                <ANNOTATION_VALUE>a:ohpana:t. Ata n' ta: ne: ke:man on..., onkaya *porque** ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a899" TIME_SLOT_REF1="ts1424" TIME_SLOT_REF2="ts1425">
                <ANNOTATION_VALUE>ke:meh yo:n tapiyalmeh telnemiah ata, ta: tik..., teh tikitaka ok eski ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a900" TIME_SLOT_REF1="ts1426" TIME_SLOT_REF2="ts1427">
                <ANNOTATION_VALUE>ka:mpa ma:tahtachkwah n' tapialmeh ata mote:ka n' a:tsí:n komo kiowik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a901" TIME_SLOT_REF1="ts1428" TIME_SLOT_REF2="ts1429">
                <ANNOTATION_VALUE>Entó:s yeha ya yo:n xikwiti ika se: tapalkatsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a902" TIME_SLOT_REF1="ts1430" TIME_SLOT_REF2="ts1431">
                <ANNOTATION_VALUE>wa:n x'maka n' kokoxkeh wa:n no: kwali tai:s, no: kina:mikis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a903" TIME_SLOT_REF1="ts1432" TIME_SLOT_REF2="ts1433">
                <ANNOTATION_VALUE>Komo a:mo kina:mikik i:n tein nikihtohtok, n' tapalkatsí:n tai:k. Wa:n komo a:mo kina:mikik yeha yo:ni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a904" TIME_SLOT_REF1="ts1434" TIME_SLOT_REF2="ts1435">
                <ANNOTATION_VALUE>ne:, tikwis nokta, noktapahpata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a905" TIME_SLOT_REF1="ts1436" TIME_SLOT_REF2="ts1437">
                <ANNOTATION_VALUE>Noktapahpata ne: xoxowik xikwe:cho, kwaltsi:n takwe:chol,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a906" TIME_SLOT_REF1="ts1438" TIME_SLOT_REF2="ts1439">
                <ANNOTATION_VALUE>wa:n xikmolo:nti, ke:meh eskia yo:n ato:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a907" TIME_SLOT_REF1="ts1440" TIME_SLOT_REF2="ts1441">
                <ANNOTATION_VALUE>Wa:n yo:n ke:meh eskia ato:l, yo:n molo:niti kwaltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a908" TIME_SLOT_REF1="ts1442" TIME_SLOT_REF2="ts1443">
                <ANNOTATION_VALUE>ke:mah, x'maka ya n' kokoxkeh mah tai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a909" TIME_SLOT_REF1="ts1444" TIME_SLOT_REF2="ts1445">
                <ANNOTATION_VALUE>De yo:n e:yi taman tikpan..., tikmakas komo, i:pa kina:..., ika se: taman i:pa kina:mikiti:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a910" TIME_SLOT_REF1="ts1446" TIME_SLOT_REF2="ts1448">
                <ANNOTATION_VALUE>Ihkó:n nikitaya nowe:ina:n katka tapahtia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a914" TIME_SLOT_REF1="ts1455" TIME_SLOT_REF2="ts1458">
                <ANNOTATION_VALUE>Koy..., koyo:..., koyo:ko ya se: yawi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a923" TIME_SLOT_REF1="ts1475" TIME_SLOT_REF2="ts1478">
                <ANNOTATION_VALUE>Ke:mah, ta: xo:tatiw pero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a932" TIME_SLOT_REF1="ts1495" TIME_SLOT_REF2="ts1498">
                <ANNOTATION_VALUE>No: n' ki...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a936" TIME_SLOT_REF1="ts1506" TIME_SLOT_REF2="ts1508">
                <ANNOTATION_VALUE>Ke:mah, xoxok..., xoxoktsí:n mochi:wa n' a:tsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a938" TIME_SLOT_REF1="ts1512" TIME_SLOT_REF2="ts1514">
                <ANNOTATION_VALUE>Ke:mah, yo:n no: telkwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a941" TIME_SLOT_REF1="ts1519" TIME_SLOT_REF2="ts1522">
                <ANNOTATION_VALUE>On..., on..., ne: ke:man noch..., nochi yeha n' ke:meh i:n tikihtohtokeh nochi yeha n' tikwiyah, n' wehka:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a942" TIME_SLOT_REF1="ts1523" TIME_SLOT_REF2="ts1524">
                <ANNOTATION_VALUE>Pero a:man tein neli *como que**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a943" TIME_SLOT_REF1="ts1525" TIME_SLOT_REF2="ts1526">
                <ANNOTATION_VALUE>a:mo okachi tikwih ok wa:n yeh ka tsa:la:n mo..., tikelka:wah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a944" TIME_SLOT_REF1="ts1527" TIME_SLOT_REF2="ts1528">
                <ANNOTATION_VALUE>A:mo ke:meh i:n, tein *más** pi:pil ok moskaltiyah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a945" TIME_SLOT_REF1="ts1529" TIME_SLOT_REF2="ts1530">
                <ANNOTATION_VALUE>a:mo kimatih ok *porque** nochi koyo:ko ya yawih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a946" TIME_SLOT_REF1="ts1531" TIME_SLOT_REF2="ts1532">
                <ANNOTATION_VALUE>Se: pili komo kokolispe:wak *o** se: we:itokni:w, tiowih ne: tikitatih n' koyo:tapahtihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a947" TIME_SLOT_REF1="ts1533" TIME_SLOT_REF2="ts1534">
                <ANNOTATION_VALUE>Nochi tomi:n ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a948" TIME_SLOT_REF1="ts1535" TIME_SLOT_REF2="ts1536">
                <ANNOTATION_VALUE>Wa:n ne: ke:man katka kanah, ne:, mah nikihto *como que** a:m..., a:mo tikowayah, tikte:mowah sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a949" TIME_SLOT_REF1="ts1537" TIME_SLOT_REF2="ts1538">
                <ANNOTATION_VALUE>Wa:n yeha yo:n ika ti..., timopahtiyah wa:n tikimpahtia:yah m' pilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a950" TIME_SLOT_REF1="ts1539" TIME_SLOT_REF2="ts1541">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah. Pos yo:n neli ke:meh tikihtowa teh, yo:n a:mo mokowa *porque** ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a952" TIME_SLOT_REF1="ts1543" TIME_SLOT_REF2="ts1546">
                <ANNOTATION_VALUE>E:mah, ke:masá: tapa:ni n' tapalkatsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a953" TIME_SLOT_REF1="ts1547" TIME_SLOT_REF2="ts1548">
                <ANNOTATION_VALUE>Wa:n neli *noticuidarowa:yah** weh, ta: nikin..., nika:kakia nowei:na:n katka te:chi:ilwia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a954" TIME_SLOT_REF1="ts1549" TIME_SLOT_REF2="ts1550">
                <ANNOTATION_VALUE>ta: n' *más** telwehka:w katka xiwtsi:ni n' kaltsí:n. Neh nikitaka ok xiwkal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a955" TIME_SLOT_REF1="ts1551" TIME_SLOT_REF2="ts1552">
                <ANNOTATION_VALUE>Wa:n yo:n *tejajtsi:n** komohkó:n ne: yetok ne:wí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a956" TIME_SLOT_REF1="ts1553" TIME_SLOT_REF2="ts1554">
                <ANNOTATION_VALUE>pero neli no: *xicuidaro**, xike:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a957" TIME_SLOT_REF1="ts1555" TIME_SLOT_REF2="ts1556">
                <ANNOTATION_VALUE>*porque** n' ta: yo:n pahti mitsilwi:s. Pero sayoh nimolwia:ya neh, ¿ke:ní:w m' pahti wa:n tapalkat?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a958" TIME_SLOT_REF1="ts1557" TIME_SLOT_REF2="ts1558">
                <ANNOTATION_VALUE>Pero neli *como que** se: pili ka:n se: tamati. Wa: nikilia:ya, ma:, nikilia, ¿pero ke:yeh pos i:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a959" TIME_SLOT_REF1="ts1559" TIME_SLOT_REF2="ts1560">
                <ANNOTATION_VALUE>ke:ní:w os t'chi:was ika timopahti:skeh? Ay nokone:w kihto:s, ta: yo:n ne: niktikota:li:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a960" TIME_SLOT_REF1="ts1561" TIME_SLOT_REF2="ts1562">
                <ANNOTATION_VALUE>N'tikota:li:s wa:n titai:s, a:mo x'ne:chkwala:nti ne:chwa:lilwihtos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a961" TIME_SLOT_REF1="ts1563" TIME_SLOT_REF2="ts1564">
                <ANNOTATION_VALUE>Pero ke:ní:w nikilia n' ta:is wa:n tapalkat, ta: takwa:wak, ¿ke:ní:w os n' tai:s?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a962" TIME_SLOT_REF1="ts1565" TIME_SLOT_REF2="ts1566">
                <ANNOTATION_VALUE>Ka:nah weh kihtowa ta: t'tikota:li:skeh mah xo:ta wa:n ne: tikta:li:skeh se:, itech a:tsí:n wa:n yeha titai:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a963" TIME_SLOT_REF1="ts1567" TIME_SLOT_REF2="ts1569">
                <ANNOTATION_VALUE>Wa:n neli iwki kichi:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a967" TIME_SLOT_REF1="ts1577" TIME_SLOT_REF2="ts1578">
                <ANNOTATION_VALUE>Komo, komo a:mo tei yeha ne:n ke:meh yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a968" TIME_SLOT_REF1="ts1579" TIME_SLOT_REF2="ts1580">
                <ANNOTATION_VALUE>tl..., tl..., wel a:man a:mo kanah tei, pero ne: ke:man onkaya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a969" TIME_SLOT_REF1="ts1581" TIME_SLOT_REF2="ts1582">
                <ANNOTATION_VALUE>seki xiwtsitsí:n ne: ma:..., ma:...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a970" TIME_SLOT_REF1="ts1583" TIME_SLOT_REF2="ts1584">
                <ANNOTATION_VALUE>ke:meh eskia ihko:ko:ntsitsí:n ima:tsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a971" TIME_SLOT_REF1="ts1585" TIME_SLOT_REF2="ts1586">
                <ANNOTATION_VALUE>Pero a:mo kanah nikitstok wel a:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a972" TIME_SLOT_REF1="ts1587" TIME_SLOT_REF2="ts1588">
                <ANNOTATION_VALUE>Yeha yo:ni mah se: kimolo:nti wa:n mah se: tai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a973" TIME_SLOT_REF1="ts1589" TIME_SLOT_REF2="ts1591">
                <ANNOTATION_VALUE>Pero ekintsi:n a:mo wel nikwa:lkwik *porque** a:mo kanah nikahsik n' ompaka ne:wí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a975" TIME_SLOT_REF1="ts1595" TIME_SLOT_REF2="ts1596">
                <ANNOTATION_VALUE>Ka:n sake:ra nikelna:miki ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a976" TIME_SLOT_REF1="ts1597" TIME_SLOT_REF2="ts1598">
                <ANNOTATION_VALUE>Kil..., kilwiah ta:l..., ta:lpanmowila:naxiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a977" TIME_SLOT_REF1="ts1599" TIME_SLOT_REF2="ts1600">
                <ANNOTATION_VALUE>ta: ta:li:xko mowila:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a978" TIME_SLOT_REF1="ts1601" TIME_SLOT_REF2="ts1603">
                <ANNOTATION_VALUE>Pero a:mo ne:, a:mo yeha n' ta:la:mat, no: seki, a:mo nikelna:miki ke:ní:w mono:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a980" TIME_SLOT_REF1="ts1605" TIME_SLOT_REF2="ts1608">
                <ANNOTATION_VALUE>Ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a981" TIME_SLOT_REF1="ts1609" TIME_SLOT_REF2="ts1610">
                <ANNOTATION_VALUE>ihista:k, mowila:na n' xiwtsí:n wa:n ne: tsikitsitsi:n ima:tsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a982" TIME_SLOT_REF1="ts1611" TIME_SLOT_REF2="ts1612">
                <ANNOTATION_VALUE>wa:n ista:k n' ixo:chiotsi:n. Ne: ke:man semi onkaya pero ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a983" TIME_SLOT_REF1="ts1613" TIME_SLOT_REF2="ts1614">
                <ANNOTATION_VALUE>tikita n' a:man ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a984" TIME_SLOT_REF1="ts1615" TIME_SLOT_REF2="ts1616">
                <ANNOTATION_VALUE>yo:n a:t ika tekitih, a:mo tei, poliwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a985" TIME_SLOT_REF1="ts1617" TIME_SLOT_REF2="ts1619">
                <ANNOTATION_VALUE>Ke:meh eskia nochi wa:ki wa:n a:mo selia ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a988" TIME_SLOT_REF1="ts1625" TIME_SLOT_REF2="ts1627">
                <ANNOTATION_VALUE>Yo:n ihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a990" TIME_SLOT_REF1="ts1631" TIME_SLOT_REF2="ts1633">
                <ANNOTATION_VALUE>Wa:n itech se: itasa:l semi te:kwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a993" TIME_SLOT_REF1="ts1638" TIME_SLOT_REF2="ts1641">
                <ANNOTATION_VALUE>Semi te:kwi, semi mopilowa itech se: itasa:l komohkó:n telonkak yo:n xiwtsí:n. Mowila:na wa:n ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a994" TIME_SLOT_REF1="ts1642" TIME_SLOT_REF2="ts1643">
                <ANNOTATION_VALUE>ka:mpa, ka:mpa yo:n yankwixtok tekiti:lah wa:n pe:wa taxiwyowa ya ata, neli sa kwaltsitsi:n ixiwyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a995" TIME_SLOT_REF1="ts1644" TIME_SLOT_REF2="ts1646">
                <ANNOTATION_VALUE>A:mo, a:mo nikelna:miki ke:ní:w mono:tsa, xa: neli mahyá: yehwa ya i:n tikihtohtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a998" TIME_SLOT_REF1="ts1651" TIME_SLOT_REF2="ts1654">
                <ANNOTATION_VALUE>Ke:mah, tikwa:lkwis, tikwa:lkwis. *Eso**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1001" TIME_SLOT_REF1="ts1659" TIME_SLOT_REF2="ts1662">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
