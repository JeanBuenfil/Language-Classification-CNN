        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1153" TIME_SLOT_REF1="ts2008" TIME_SLOT_REF2="ts2009">
                <ANNOTATION_VALUE>Ata yo:n te:..., te:ki:xtiliah se: iesyo ata nika:n se: i:mako,</ANNOTATION_VALUE>
