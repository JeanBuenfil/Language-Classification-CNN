        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812" TIME_SLOT_REF1="ts1224" TIME_SLOT_REF2="ts1225">
                <ANNOTATION_VALUE>wa:n ke:mah wi:tsa ya ne:n, kwali, komohkó:n a:mo tikpia ne:n</ANNOTATION_VALUE>
