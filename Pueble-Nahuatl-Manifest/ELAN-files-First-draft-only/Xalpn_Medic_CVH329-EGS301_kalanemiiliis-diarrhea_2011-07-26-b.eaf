        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1156" TIME_SLOT_REF1="ts2014" TIME_SLOT_REF2="ts2015">
                <ANNOTATION_VALUE>Se: wa:n tahko sah nikwa:ti n' taxkaltsí:n wa:n</ANNOTATION_VALUE>
