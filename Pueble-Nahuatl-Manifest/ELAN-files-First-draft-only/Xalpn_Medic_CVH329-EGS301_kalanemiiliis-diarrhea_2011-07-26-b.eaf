            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1166" TIME_SLOT_REF1="ts2034" TIME_SLOT_REF2="ts2035">
                <ANNOTATION_VALUE>wa:n *habas, pero** a:mo poye:k, iwki sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1167" TIME_SLOT_REF1="ts2036" TIME_SLOT_REF2="ts2037">
                <ANNOTATION_VALUE>Wa:n a:mo ke:man ntai:s ok tsiktsi:n teihsá: tsope:ka:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1168" TIME_SLOT_REF1="ts2038" TIME_SLOT_REF2="ts2039">
                <ANNOTATION_VALUE>Iwki ya yo:n, iwki n..., iwki nietok wa:n se: wa:n tahko n' taxkal nikwa:ti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1169" TIME_SLOT_REF1="ts2040" TIME_SLOT_REF2="ts2041">
                <ANNOTATION_VALUE>*Bueno**, pos iwki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1170" TIME_SLOT_REF1="ts2042" TIME_SLOT_REF2="ts2043">
                <ANNOTATION_VALUE>Wa:n ompa ne: a:it ke:ní:w ya, pero n' ta: nimaya:na pero, iwki ninemi, iwki ninemi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1171" TIME_SLOT_REF1="ts2044" TIME_SLOT_REF2="ts2045">
                <ANNOTATION_VALUE>wa:n pahti *n'seguirowa** nikwa. A:mo nankineltokaskeh, kwali nane:chili:skeh xa: name:chkahkaya:wtok, pero neh n'mattok *porque** neh *ne:chpasa:roh**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1172" TIME_SLOT_REF1="ts2046" TIME_SLOT_REF2="ts2047">
                <ANNOTATION_VALUE>Ne:, nikitaya ke:meh i:n tit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1173" TIME_SLOT_REF1="ts2048" TIME_SLOT_REF2="ts2049">
                <ANNOTATION_VALUE>komohkó:n yo:n yowak a wa:n xo:tak a n' tit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1174" TIME_SLOT_REF1="ts2050" TIME_SLOT_REF2="ts2051">
                <ANNOTATION_VALUE>ma:s iwki nikochik a, n' ta: ka:n ntakwa n'mattok, iwki nimote:k a, nikochi a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1175" TIME_SLOT_REF1="ts2052" TIME_SLOT_REF2="ts2053">
                <ANNOTATION_VALUE>Pero nihsatiki:sa n' ke:meh nimaya:na, pero nitelmaya:na tel senka ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1176" TIME_SLOT_REF1="ts2054" TIME_SLOT_REF2="ts2055">
                <ANNOTATION_VALUE>nikwa:skia ma:s sese:k, ma:s iwki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1177" TIME_SLOT_REF1="ts2056" TIME_SLOT_REF2="ts2057">
                <ANNOTATION_VALUE>Ne:, nime:wa wa:n nikita ne:n tit ke:meh ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1178" TIME_SLOT_REF1="ts2058" TIME_SLOT_REF2="ts2059">
                <ANNOTATION_VALUE>pero telwe:ika ihkwi:ni, pero tapochi:ntok ke:meh ne: a:mat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1179" TIME_SLOT_REF1="ts2060" TIME_SLOT_REF2="ts2061">
                <ANNOTATION_VALUE>Pero *we:irueda** ihkó:n yetok, tapochi:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1180" TIME_SLOT_REF1="ts2062" TIME_SLOT_REF2="ts2063">
                <ANNOTATION_VALUE>A:m..., to:n nikchi:waya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1181" TIME_SLOT_REF1="ts2064" TIME_SLOT_REF2="ts2065">
                <ANNOTATION_VALUE>n' ika nimoka:w a, komo nimikis mah nimiki a tak, a:mo ne: ni...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1182" TIME_SLOT_REF1="ts2066" TIME_SLOT_REF2="ts2067">
                <ANNOTATION_VALUE>nita:ya:ya ok, ne: a:mo nikwa:ya, nimoka:waya mah a:mo ntakwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1183" TIME_SLOT_REF1="ts2068" TIME_SLOT_REF2="ts2069">
                <ANNOTATION_VALUE>Nime:wtiki:sa wa:n nikwi n' taxkal ma:s sese:k</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1184" TIME_SLOT_REF1="ts2070" TIME_SLOT_REF2="ts2071">
                <ANNOTATION_VALUE>nik..., nikma:kelpachowa wa:n niktanteki yo:n taxkaltsí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1185" TIME_SLOT_REF1="ts2072" TIME_SLOT_REF2="ts2073">
                <ANNOTATION_VALUE>wa:n iw..., iwki weh nimosenka:w, komo nimikis mah nimiki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1186" TIME_SLOT_REF1="ts2074" TIME_SLOT_REF2="ts2075">
                <ANNOTATION_VALUE>Nikwahkalowa se: *pocillo** kahfe:n wa:n nitai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1187" TIME_SLOT_REF1="ts2076" TIME_SLOT_REF2="ts2077">
                <ANNOTATION_VALUE>Wa:n ika, ika yo:n taxkaltsí:n ika nikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1188" TIME_SLOT_REF1="ts2078" TIME_SLOT_REF2="ts2079">
                <ANNOTATION_VALUE>Nikwa se: taxkal, nikwa:s n'tami:s a,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1189" TIME_SLOT_REF1="ts2080" TIME_SLOT_REF2="ts2081">
                <ANNOTATION_VALUE>poliwi ne:n ke:meh yetok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1190" TIME_SLOT_REF1="ts2082" TIME_SLOT_REF2="ts2083">
                <ANNOTATION_VALUE>ihkó:n yowi, yowi. Ata ke:meh yo:n tila:wka:tamixowa wa:n tikitas pané: mahchi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1191" TIME_SLOT_REF1="ts2084" TIME_SLOT_REF2="ts2085">
                <ANNOTATION_VALUE>Ke:mah, ne:, nikwi o:me taxkal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1192" TIME_SLOT_REF1="ts2086" TIME_SLOT_REF2="ts2087">
                <ANNOTATION_VALUE>nikwa:s o:me taxkal ika se: *taza** kahfe:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1193" TIME_SLOT_REF1="ts2088" TIME_SLOT_REF2="ts2089">
                <ANNOTATION_VALUE>nitai:k a wa:n n'tamih yo:n taxkaltsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1194" TIME_SLOT_REF1="ts2090" TIME_SLOT_REF2="ts2091">
                <ANNOTATION_VALUE>moka:wa ke:meh yekintsi:n ntachi:xtok. A:mo nankineltokaskeh, yo:n pahti iwki nika:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1195" TIME_SLOT_REF1="ts2092" TIME_SLOT_REF2="ts2093">
                <ANNOTATION_VALUE>Iwki nika:w, a:mo nikwah ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1196" TIME_SLOT_REF1="ts2094" TIME_SLOT_REF2="ts2095">
                <ANNOTATION_VALUE>wa:n sepa niahka ok ne: ka:mpa niow *noconsulta**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1197" TIME_SLOT_REF1="ts2096" TIME_SLOT_REF2="ts2097">
                <ANNOTATION_VALUE>ne:chilia n' tapahtihkeh, kihtowa ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1198" TIME_SLOT_REF1="ts2098" TIME_SLOT_REF2="ts2099">
                <ANNOTATION_VALUE>ekintsi:n kihtowa a:mo teh *material** kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1199" TIME_SLOT_REF1="ts2100" TIME_SLOT_REF2="ts2101">
                <ANNOTATION_VALUE>mo:sta xiow kwesala:n kihtowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1200" TIME_SLOT_REF1="ts2102" TIME_SLOT_REF2="ts2103">
                <ANNOTATION_VALUE>wa:n ompa mitschi:wili:skeh n' *estudio** kihtowa *porque** nika:n kihtowa a:mo tei *material**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1201" TIME_SLOT_REF1="ts2104" TIME_SLOT_REF2="ts2105">
                <ANNOTATION_VALUE>A:, nikilia, ka:n tei. Kihtowa, a:mo, mo:sta xiow kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1202" TIME_SLOT_REF1="ts2106" TIME_SLOT_REF2="ts2107">
                <ANNOTATION_VALUE>Nikilia a:mo nikilia, nia:ti a:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1203" TIME_SLOT_REF1="ts2108" TIME_SLOT_REF2="ts2109">
                <ANNOTATION_VALUE>*Porque** a:man nikilia i:pa niow, nikilia. Yo:n nitahtanik *permiso** n' ka:mpa ntekiti ampó:n kwesala:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1204" TIME_SLOT_REF1="ts2110" TIME_SLOT_REF2="ts2111">
                <ANNOTATION_VALUE>ke:meh ne: ka:mpa tapahtia:nih ma:se:wal titekitih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1205" TIME_SLOT_REF1="ts2112" TIME_SLOT_REF2="ts2113">
                <ANNOTATION_VALUE>wa:n yo:n *rato ne:chtoca:rowa:ya noguardia**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1206" TIME_SLOT_REF1="ts2114" TIME_SLOT_REF2="ts2115">
                <ANNOTATION_VALUE>entó:s nikilia a:man niow *porque** nitahtanik *permiso, por eso** nika:n nietok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1207" TIME_SLOT_REF1="ts2116" TIME_SLOT_REF2="ts2117">
                <ANNOTATION_VALUE>*Porque** nikmattok a nipanowa nika:n *consulta**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1208" TIME_SLOT_REF1="ts2118" TIME_SLOT_REF2="ts2119">
                <ANNOTATION_VALUE>Kihtowa, ne:chihkwilowilih no: se: *pase**, kihtowa para mo:sta. Neh a:mo nimoka:w, ta: neh niwa:lah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1209" TIME_SLOT_REF1="ts2120" TIME_SLOT_REF2="ts2121">
                <ANNOTATION_VALUE>Wa:n niehkok ne: ka:mpa tapahtilo:niya:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1210" TIME_SLOT_REF1="ts2122" TIME_SLOT_REF2="ts2123">
                <ANNOTATION_VALUE>wa:n pe:wak nikilia ne: siwa:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1211" TIME_SLOT_REF1="ts2124" TIME_SLOT_REF2="ts2125">
                <ANNOTATION_VALUE>kihtowa, i:n kihtowa para mo:sta.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1212" TIME_SLOT_REF1="ts2126" TIME_SLOT_REF2="ts2127">
                <ANNOTATION_VALUE>Ke:mah, nikilia, pero ne:chilwihkeh para mo:sta, nikilia, pero ke:meh i:pa nitekitiki nika:n, nikilwia entó:s neh niwa:lah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1213" TIME_SLOT_REF1="ts2128" TIME_SLOT_REF2="ts2129">
                <ANNOTATION_VALUE>Entó:s kihtowa xpano ne:, *a ver** toni mitsilwia n' tapahtihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1214" TIME_SLOT_REF1="ts2130" TIME_SLOT_REF2="ts2131">
                <ANNOTATION_VALUE>Nipano:k. Kitak. ¿Wa:n ke:yeh?, kihtowa, ta: i:n para mo:sta twa:la:skia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1215" TIME_SLOT_REF1="ts2132" TIME_SLOT_REF2="ts2133">
                <ANNOTATION_VALUE>Ke:mah, nikilia pero ke:meh n'pia tekit nikilia n' ampo:ni a:man nikilia, entó:s ika niwa:lah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1216" TIME_SLOT_REF1="ts2134" TIME_SLOT_REF2="ts2135">
                <ANNOTATION_VALUE>Ne:chpano:ltih.Ne:chkwi:lih no:..., ne:chiki:xtilih noesyo wa:n kie:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1217" TIME_SLOT_REF1="ts2136" TIME_SLOT_REF2="ts2137">
                <ANNOTATION_VALUE>kihtowa ox niman tia:ti. Nia:s nikilwia *hasta las dos**, nikilia. Pero, ne: ke:man tiki:sayah *las dos**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1218" TIME_SLOT_REF1="ts2138" TIME_SLOT_REF2="ts2139">
                <ANNOTATION_VALUE>Ta: a:man tiki:sah *más** tayowa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1219" TIME_SLOT_REF1="ts2140" TIME_SLOT_REF2="ts2141">
                <ANNOTATION_VALUE>Tiki:sah *las cuatro**. A:, *bueno** kihtowa. Ne:, neli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1220" TIME_SLOT_REF1="ts2142" TIME_SLOT_REF2="ts2143">
                <ANNOTATION_VALUE>Ni...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1221" TIME_SLOT_REF1="ts2144" TIME_SLOT_REF2="ts2145">
                <ANNOTATION_VALUE>niahki. Kihtowa xiow..., xwi:ki *las dos** kihtowa. Nikilia *bueno**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1222" TIME_SLOT_REF1="ts2146" TIME_SLOT_REF2="ts2147">
                <ANNOTATION_VALUE>Pero yo:n ka:n nikmati,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1223" TIME_SLOT_REF1="ts2148" TIME_SLOT_REF2="ts2149">
                <ANNOTATION_VALUE>ox neli ihsiwka n' kiitak yo:n noesyo oso ke:ní:w yo:n, ka:n no: nmomaka *cuenta**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1224" TIME_SLOT_REF1="ts2150" TIME_SLOT_REF2="ts2151">
                <ANNOTATION_VALUE>ne:, niwa:lah yo:n tayowaya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1225" TIME_SLOT_REF1="ts2152" TIME_SLOT_REF2="ts2153">
                <ANNOTATION_VALUE>Kihtowa, ¿wa:n a:koni kihtowa mitsmakak i:n *estudio** mitschi:wilihtok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1226" TIME_SLOT_REF1="ts2154" TIME_SLOT_REF2="ts2155">
                <ANNOTATION_VALUE>Nikilia *doctor** ka:mpa *nopueblo**, Cuauhtamazaco, nikilwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1227" TIME_SLOT_REF1="ts2156" TIME_SLOT_REF2="ts2157">
                <ANNOTATION_VALUE>Kihtowa, wa:n ke:yeh kihtowa sayoh mits...., sayoh kihtowa mitsmakatok kihtowa i:n *receta** kihtowa wa:n a:mo neli t'pia kokolis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1228" TIME_SLOT_REF1="ts2158" TIME_SLOT_REF2="ts2159">
                <ANNOTATION_VALUE>Ka:n neli, kihtowa. ¿Ke:yeh kihtowa timotahyo:wi:ltihtok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1229" TIME_SLOT_REF1="ts2160" TIME_SLOT_REF2="ts2161">
                <ANNOTATION_VALUE>Wa:n pe:wak nikilwia ya ke:meh i:n teh nimitstapowihtok, ke:ní:w nikmachilia n' komo a:mo nitakwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1230" TIME_SLOT_REF1="ts2162" TIME_SLOT_REF2="ts2163">
                <ANNOTATION_VALUE>Ne:chilwia, kihtowa a:mo x'chi:wilihto *cuenta**, kihtowa, ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1231" TIME_SLOT_REF1="ts2164" TIME_SLOT_REF2="ts2165">
                <ANNOTATION_VALUE>teh xtakwa *parejo** kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1232" TIME_SLOT_REF1="ts2166" TIME_SLOT_REF2="ts2167">
                <ANNOTATION_VALUE>Takwa kihtowa, ke:meh tmotekipanowa i:pa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1233" TIME_SLOT_REF1="ts2168" TIME_SLOT_REF2="ts2169">
                <ANNOTATION_VALUE>Pero komo a:mo kihtowa, timikiti. Ekintsi:n kihtowa tikokoxkeh ya kihtowa. A:mo ihkó:n katka yekinika tiwa:la:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1234" TIME_SLOT_REF1="ts2170" TIME_SLOT_REF2="ts2171">
                <ANNOTATION_VALUE>Entó:s nikilia a:mo mela:. A:mo kihtowa, ki:sak chipa:wak kihtowa *mosangre**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1235" TIME_SLOT_REF1="ts2172" TIME_SLOT_REF2="ts2173">
                <ANNOTATION_VALUE>*Bueno**, pos iwki a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1236" TIME_SLOT_REF1="ts2174" TIME_SLOT_REF2="ts2175">
                <ANNOTATION_VALUE>*Hasta** yo:n to:nal a:mo, nika:w m' pahti *hasta para** a:man.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1237" TIME_SLOT_REF1="ts2176" TIME_SLOT_REF2="ts2177">
                <ANNOTATION_VALUE>Pero neh nitai:k,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1238" TIME_SLOT_REF1="ts2178" TIME_SLOT_REF2="ts2179">
                <ANNOTATION_VALUE>seki ne:, seki xiwit para yeha yo:n kokolis. Neh, a:mo n'mati ox n'piya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1239" TIME_SLOT_REF1="ts2180" TIME_SLOT_REF2="ts2181">
                <ANNOTATION_VALUE>pero ne: achto ya i:pa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1240" TIME_SLOT_REF1="ts2182" TIME_SLOT_REF2="ts2183">
                <ANNOTATION_VALUE>ne:chilwihkeh ika nikpia yeha yo:n kokolis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1241" TIME_SLOT_REF1="ts2184" TIME_SLOT_REF2="ts2185">
                <ANNOTATION_VALUE>neh nitaya:ya xiwpah. Nankimatiskeh ton xiwyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1242" TIME_SLOT_REF1="ts2186" TIME_SLOT_REF2="ts2187">
                <ANNOTATION_VALUE>ne:, a:mo nikwa:lkik, pero ne:, tiki:xmattokeh *porque** nochi nika:n tikayo:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1243" TIME_SLOT_REF1="ts2188" TIME_SLOT_REF2="ts2189">
