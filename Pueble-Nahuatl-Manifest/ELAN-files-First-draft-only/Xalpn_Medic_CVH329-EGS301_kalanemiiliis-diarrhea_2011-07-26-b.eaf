            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1244" TIME_SLOT_REF1="ts2190" TIME_SLOT_REF2="ts2191">
                <ANNOTATION_VALUE>tein yo:n ista:k n' ixo:chiyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1245" TIME_SLOT_REF1="ts2192" TIME_SLOT_REF2="ts2193">
