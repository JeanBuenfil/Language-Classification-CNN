        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762" TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1111">
                <ANNOTATION_VALUE>Yeha yo:n nimitsilwihtok yo:n</ANNOTATION_VALUE>
