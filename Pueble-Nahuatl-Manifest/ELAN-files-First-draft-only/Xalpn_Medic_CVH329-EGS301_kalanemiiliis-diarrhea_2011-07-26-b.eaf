        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1141" TIME_SLOT_REF1="ts1981" TIME_SLOT_REF2="ts1983">
                <ANNOTATION_VALUE>Wa:n ke:masá: neli *como que** yeha sah n' kimpahtia, a:mo kachi kiniwi:ka.</ANNOTATION_VALUE>
