        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1147" TIME_SLOT_REF1="ts1994" TIME_SLOT_REF2="ts1997">
                <ANNOTATION_VALUE>A:mo, n' ta: tak nimolia xa: neli *porque**,</ANNOTATION_VALUE>
