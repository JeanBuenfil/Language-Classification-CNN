        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761" TIME_SLOT_REF1="ts1106" TIME_SLOT_REF2="ts1109">
                <ANNOTATION_VALUE>Ne:, teha:n ihkwí:n n' tikchi:wah komohkó:n ne: we:itokni:w.</ANNOTATION_VALUE>
