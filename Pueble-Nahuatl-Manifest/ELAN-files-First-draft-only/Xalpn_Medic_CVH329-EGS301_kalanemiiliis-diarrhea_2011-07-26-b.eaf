            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1246" TIME_SLOT_REF1="ts2194" TIME_SLOT_REF2="ts2195">
                <ANNOTATION_VALUE>chi:kikisxiwit. Yeha yo:n mah se: kimolo:nti. Yo:n ne:chilwih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1247" TIME_SLOT_REF1="ts2196" TIME_SLOT_REF2="ts2197">
                <ANNOTATION_VALUE>se: ta:to ne:wí: kayo:t *por**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1248" TIME_SLOT_REF1="ts2198" TIME_SLOT_REF2="ts2199">
                <ANNOTATION_VALUE>pané: Buenavista, ox a:it ka:nika:wí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1249" TIME_SLOT_REF1="ts2200" TIME_SLOT_REF2="ts2201">
                <ANNOTATION_VALUE>Se: ta:to nemiya niki:itaya ne: tia:nkis, kinamakaya m' pahti de a jueves.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1250" TIME_SLOT_REF1="ts2202" TIME_SLOT_REF2="ts2203">
                <ANNOTATION_VALUE>A:man a:mo nikmati ox nemi ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1251" TIME_SLOT_REF1="ts2204" TIME_SLOT_REF2="ts2205">
                <ANNOTATION_VALUE>Ox wi:tsa, niwi:witsa neh de a jueves wa:n a:mo ke:man nikita ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1252" TIME_SLOT_REF1="ts2206" TIME_SLOT_REF2="ts2207">
                <ANNOTATION_VALUE>Ne:, yeha yo:n ne:chnawatih. Ne:chmakaka tahko *litro**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1253" TIME_SLOT_REF1="ts2208" TIME_SLOT_REF2="ts2209">
                <ANNOTATION_VALUE>nikowilih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1254" TIME_SLOT_REF1="ts2210" TIME_SLOT_REF2="ts2211">
                <ANNOTATION_VALUE>Wa:n *después** ne:chilwia, kihtowa ka:n *importa** tik..., tiwi:tsa kihtowa komohkó:n ne: a:mo tike:manti,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1255" TIME_SLOT_REF1="ts2212" TIME_SLOT_REF2="ts2213">
                <ANNOTATION_VALUE>yeha i:n wa:n yeha i:n x'te:mo kihtowa wa:n x'molo:nti wa:n xtai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1256" TIME_SLOT_REF1="ts2214" TIME_SLOT_REF2="ts2215">
                <ANNOTATION_VALUE>Komo tikpiya, komo a:mo tikpiya, kihtowa pero ika yo:n kihtowa a:mo ne:, a:mo tehsá: ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1257" TIME_SLOT_REF1="ts2216" TIME_SLOT_REF2="ts2217">
                <ANNOTATION_VALUE>mitschi:wili:s. A:mo te:kokoh kihtowa i:n xiwtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1258" TIME_SLOT_REF1="ts2218" TIME_SLOT_REF2="ts2219">
                <ANNOTATION_VALUE>Wa:n yeha sah nta:taya:ya, nta:taya:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1259" TIME_SLOT_REF1="ts2220" TIME_SLOT_REF2="ts2222">
                <ANNOTATION_VALUE>*Hasta** a:man, a:man, *hasta** no: wehka:w a nikelka:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1272" TIME_SLOT_REF1="ts2247" TIME_SLOT_REF2="ts2250">
                <ANNOTATION_VALUE>Ke:mah, yo:n...</ANNOTATION_VALUE>
