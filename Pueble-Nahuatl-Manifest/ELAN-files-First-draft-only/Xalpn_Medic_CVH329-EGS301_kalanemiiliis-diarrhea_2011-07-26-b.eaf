        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1120" TIME_SLOT_REF1="ts1931" TIME_SLOT_REF2="ts1933">
                <ANNOTATION_VALUE>tein no: telkwali weh yo:n *misto:nreal**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1122" TIME_SLOT_REF1="ts1935" TIME_SLOT_REF2="ts1938">
                <ANNOTATION_VALUE>Yo:n, pero ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1123" TIME_SLOT_REF1="ts1939" TIME_SLOT_REF2="ts1940">
                <ANNOTATION_VALUE>a:mo kachi, *como que** ne:, nikelka:w ekintsi:n ka:n n'wa:lik ta: neh nikpia *mata**.</ANNOTATION_VALUE>
