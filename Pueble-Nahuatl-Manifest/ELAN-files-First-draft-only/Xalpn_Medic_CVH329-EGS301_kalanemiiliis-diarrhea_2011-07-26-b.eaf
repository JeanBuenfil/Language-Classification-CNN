            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>Wa:n yo:n nochi tikpahpachoh a, nochi tikchi:wilih a wa:n newí:n seko kipahtihkeh a, sepa seko kipahtihkeh a, wa:n komo *si...**, ke:meh i:pa sah,</ANNOTATION_VALUE>
