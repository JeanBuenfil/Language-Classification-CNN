        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a800" TIME_SLOT_REF1="ts1196" TIME_SLOT_REF2="ts1197">
                <ANNOTATION_VALUE>tikitas n' teh tak *este** ma:ski tiowih *plaza** pero neli ke:meh i:n *este**,</ANNOTATION_VALUE>
