            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1315" TIME_SLOT_REF1="ts2349" TIME_SLOT_REF2="ts2351">
                <ANNOTATION_VALUE>Ke:mah, yeha n' ika te:chiskaltihkeh, te:chpahtia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1323" TIME_SLOT_REF1="ts2366" TIME_SLOT_REF2="ts2369">
