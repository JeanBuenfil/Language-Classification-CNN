        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368" TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>tikihtoskiah n' tehwa:n te:..., tikwis se: teihsá: wa:n</ANNOTATION_VALUE>
