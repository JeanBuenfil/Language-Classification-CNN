        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1152" TIME_SLOT_REF1="ts2006" TIME_SLOT_REF2="ts2007">
                <ANNOTATION_VALUE>teh tikpia kihtowa nejí:n kokolis. A:it, nikilwia. Kihtowa, ke:mah.</ANNOTATION_VALUE>
