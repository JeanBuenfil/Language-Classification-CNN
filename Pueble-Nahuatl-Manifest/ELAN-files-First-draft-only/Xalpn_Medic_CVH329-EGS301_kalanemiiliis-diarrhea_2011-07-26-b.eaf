        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a828" TIME_SLOT_REF1="ts1262" TIME_SLOT_REF2="ts1263">
                <ANNOTATION_VALUE>Ke:mah, *porque** se:, *bueno** neh nika:kakilia ompa ne:wí:n seki:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a829" TIME_SLOT_REF1="ts1264" TIME_SLOT_REF2="ts1266">
                <ANNOTATION_VALUE>*este** na:nomeh tein no: *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a830" TIME_SLOT_REF1="ts1267" TIME_SLOT_REF2="ts1269">
                <ANNOTATION_VALUE>pos wa:n seki ma:ski aya:mo semi na:nomeh ta: ke:meh i:n *este** pi:pil ok pero kimpiah pi:pil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a832" TIME_SLOT_REF1="ts1271" TIME_SLOT_REF2="ts1274">
                <ANNOTATION_VALUE>Ke:mah, ke:mah ika yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a834" TIME_SLOT_REF1="ts1276" TIME_SLOT_REF2="ts1278">
                <ANNOTATION_VALUE>Neh nikaka:kilia seki kihtowah kintohtopo:niah n' impiliwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a847" TIME_SLOT_REF1="ts1304" TIME_SLOT_REF2="ts1307">
                <ANNOTATION_VALUE>Wa:n yo:n kitohtopo:niah, ¿inkwetaxyo ne:n kitopo:niah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a853" TIME_SLOT_REF1="ts1318" TIME_SLOT_REF2="ts1319">
                <ANNOTATION_VALUE>Ke:mah, ke:mah pos neli ne:n ekintsi:n i:n timonohno:tskeh kit neli ne:n de i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a854" TIME_SLOT_REF1="ts1320" TIME_SLOT_REF2="ts1321">
                <ANNOTATION_VALUE>kalanemi:lis tein te:chkwi wehwei:n, pilimeh wa:n neli ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a855" TIME_SLOT_REF1="ts1322" TIME_SLOT_REF2="ts1323">
                <ANNOTATION_VALUE>kihtowah pilimeh ke:meh yo:n kwa:a:wetsih oso ke:meh i:n moxwitiah wa:n sepa i:n tiwehwei:n komohkó:n timoxwitihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a856" TIME_SLOT_REF1="ts1324" TIME_SLOT_REF2="ts1325">
                <ANNOTATION_VALUE>Pero se: sepa ata no: te:kwi n' kalanemi:li:s ke:meh yo:n ye:wa ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a857" TIME_SLOT_REF1="ts1326" TIME_SLOT_REF2="ts1328">
                <ANNOTATION_VALUE>ti..., timolwihtoyah i:ksá: se: tai</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a858" TIME_SLOT_REF1="ts1329" TIME_SLOT_REF2="ts1332">
                <ANNOTATION_VALUE>se: a:t *o** i:ksá: se: tai *este** teihsá: se: kikwa ne:wí:n wa:n te:ihtikokowa. Ke:mah yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a860" TIME_SLOT_REF1="ts1334" TIME_SLOT_REF2="ts1335">
                <ANNOTATION_VALUE>Pos yo:n no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a861" TIME_SLOT_REF1="ts1336" TIME_SLOT_REF2="ts1338">
                <ANNOTATION_VALUE>onkak miak taman xiwit se: kimolo:ntia wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a862" TIME_SLOT_REF1="ts1339" TIME_SLOT_REF2="ts1342">
                <ANNOTATION_VALUE>se: tai komo se: kalanemi:liskwik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a866" TIME_SLOT_REF1="ts1349" TIME_SLOT_REF2="ts1350">
                <ANNOTATION_VALUE>Ke:mah, pos *este** tehwa:n ompaka ne: ne:wí:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a867" TIME_SLOT_REF1="ts1351" TIME_SLOT_REF2="ts1352">
                <ANNOTATION_VALUE>tikwih ne: *manzanilla** wa:n se: kipanta:lilia yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a868" TIME_SLOT_REF1="ts1353" TIME_SLOT_REF2="ts1355">
                <ANNOTATION_VALUE>seki xiwit ata monamaka ne: kwesala:n, kiliah *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a869" TIME_SLOT_REF1="ts1356" TIME_SLOT_REF2="ts1359">
                <ANNOTATION_VALUE>*tecedrón**. *Porque** tehwa:n timoskaltihkeh komohkó:n a:ksá: kalanemi:liskwik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a871" TIME_SLOT_REF1="ts1361" TIME_SLOT_REF2="ts1363">
                <ANNOTATION_VALUE>*cuando** nemia ok ne: nowe:iná:n katka, yeh ya:ya ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a872" TIME_SLOT_REF1="ts1364" TIME_SLOT_REF2="ts1367">
                <ANNOTATION_VALUE>kwesala:n wa:n motakowia:ya. Yeh nochipa ya ne:n, kipiaya nochipa ya, ma:ski wa:kik yeh, pero kie:wtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877" TIME_SLOT_REF1="ts1376" TIME_SLOT_REF2="ts1377">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah wa:n yehwa yo:n nimitsilia neli pos *este** wehka:w pané: nochi ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a878" TIME_SLOT_REF1="ts1378" TIME_SLOT_REF2="ts1379">
                <ANNOTATION_VALUE>yehwa ne:n nowe:iná:n kipiaya yehwa yo:n xiwit wa:n kipiaya yehwa yo:n xiwit kiliah *tecedrón**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a879" TIME_SLOT_REF1="ts1380" TIME_SLOT_REF2="ts1382">
                <ANNOTATION_VALUE>Yo:n kinkowilia:ya na:nomeh tein ne: ahkwa:kopa ne:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a880" TIME_SLOT_REF1="ts1383" TIME_SLOT_REF2="ts1386">
                <ANNOTATION_VALUE>ki..., kiwa:l..., wa:ltemowah. Ke:mah yehwa yo:n, kwa:lkwiah yo:n xiwit wa:n yeh neli yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a882" TIME_SLOT_REF1="ts1388" TIME_SLOT_REF2="ts1389">
                <ANNOTATION_VALUE>o:me taman, o:me taman xiwit ne:n te:ch...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a883" TIME_SLOT_REF1="ts1390" TIME_SLOT_REF2="ts1392">
                <ANNOTATION_VALUE>te:..., te:..., te:chakaya nochipa ompa tiko:nkwiah wa:n yehwa yo:n x'mana wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a884" TIME_SLOT_REF1="ts1393" TIME_SLOT_REF2="ts1396">
                <ANNOTATION_VALUE>pos komo mitsna:miki mitsna:miki wa:n komo t'te:mowa toni ne: mitsna:mikis, pero onkak miak taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a911" TIME_SLOT_REF1="ts1449" TIME_SLOT_REF2="ts1450">
                <ANNOTATION_VALUE>Pero neh no:má:n no: kichi:wa ya ok. Ekintsi:n, *bueno** i:n a:man neli tikihto:s mopata ne:n *tiempo** wa:n a:man komo te:chkwik kalanemi:lis se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a912" TIME_SLOT_REF1="ts1451" TIME_SLOT_REF2="ts1453">
                <ANNOTATION_VALUE>se: *este** tsikwi:ntok ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a913" TIME_SLOT_REF1="ts1454" TIME_SLOT_REF2="ts1457">
                <ANNOTATION_VALUE>ne: xola:lpan se: kitati ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a915" TIME_SLOT_REF1="ts1459" TIME_SLOT_REF2="ts1460">
                <ANNOTATION_VALUE>koyo:ko. Pero no:má:n neh nikitaya kichi:waya ok yehwa yo:n tikihtowa ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a916" TIME_SLOT_REF1="ts1461" TIME_SLOT_REF2="ts1462">
                <ANNOTATION_VALUE>kitatiah neli tsiktsí:n *tejatapalkat**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a917" TIME_SLOT_REF1="ts1463" TIME_SLOT_REF2="ts1464">
                <ANNOTATION_VALUE>wa:n ompaka ne:wí:n a:mo n'mati ox no: nanki:xmattokeh nipawí:n se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a918" TIME_SLOT_REF1="ts1465" TIME_SLOT_REF2="ts1466">
                <ANNOTATION_VALUE>se: *este** kiliah texkaltet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a919" TIME_SLOT_REF1="ts1467" TIME_SLOT_REF2="ts1468">
                <ANNOTATION_VALUE>Texkaltet yehwa yo:n ki..., no: kitikota:liah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a920" TIME_SLOT_REF1="ts1469" TIME_SLOT_REF2="ts1470">
                <ANNOTATION_VALUE>neli tikihto:s tekoltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a921" TIME_SLOT_REF1="ts1471" TIME_SLOT_REF2="ts1473">
                <ANNOTATION_VALUE>Tekoltia wa:n ke:mah kipanta:liah ya itech ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a922" TIME_SLOT_REF1="ts1474" TIME_SLOT_REF2="ts1477">
                <ANNOTATION_VALUE>ne:n a:t *hasta** tehtsoyoka ne:n ompa se:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a924" TIME_SLOT_REF1="ts1479" TIME_SLOT_REF2="ts1480">
                <ANNOTATION_VALUE>Wa:n ke:mah kikwiti a yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a925" TIME_SLOT_REF1="ts1481" TIME_SLOT_REF2="ts1482">
                <ANNOTATION_VALUE>ta:la:mat, a:mo n'mati ox tiki:xmati yo:n ta:la:mat moso:sowa ta:lpan, yo:n ma:pisi:ltik yehwa yo:n kima:ye:ktia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a926" TIME_SLOT_REF1="ts1483" TIME_SLOT_REF2="ts1484">
                <ANNOTATION_VALUE>wa:n kikwi se: tama:tsol kwali wa:n kima:xakwalowa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a927" TIME_SLOT_REF1="ts1485" TIME_SLOT_REF2="ts1486">
                <ANNOTATION_VALUE>Kima:xakwalowa nochi yo:n wa:n yehwa ya ne:n *tejatapalkat** wa:n texkaltet pos ne: *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a928" TIME_SLOT_REF1="ts1487" TIME_SLOT_REF2="ts1488">
                <ANNOTATION_VALUE>a:pachiwtok a ompa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a929" TIME_SLOT_REF1="ts1489" TIME_SLOT_REF2="ts1490">
                <ANNOTATION_VALUE>Wa:n ompa soh kichia se: tepitsi:n ne: ika *mi...**, yehwa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a930" TIME_SLOT_REF1="ts1491" TIME_SLOT_REF2="ts1493">
                <ANNOTATION_VALUE>yo:n a:t tein ompa mote:ka yehwa ne:n ika kaha:wihtiw ne:nxiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a931" TIME_SLOT_REF1="ts1494" TIME_SLOT_REF2="ts1497">
                <ANNOTATION_VALUE>wa:n kima:xakwalowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a933" TIME_SLOT_REF1="ts1499" TIME_SLOT_REF2="ts1500">
                <ANNOTATION_VALUE>Wa:n ompa ne: kwaltsi:n kima:xakwalowa mahyá: yo:n *hasta** se:, ika se: ima:kpal ata ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a934" TIME_SLOT_REF1="ts1501" TIME_SLOT_REF2="ts1502">
                <ANNOTATION_VALUE>pané: yo:n se: kkwe:chowa kwaltsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a935" TIME_SLOT_REF1="ts1503" TIME_SLOT_REF2="ts1505">
                <ANNOTATION_VALUE>wa:n ke:mah ne: kisa ya, xoxoktia no: n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a937" TIME_SLOT_REF1="ts1509" TIME_SLOT_REF2="ts1511">
                <ANNOTATION_VALUE>Wa:n ompa ne: ki:xte:ka ya wa:n ke:mah mah tai a ne:n kokoxkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a939" TIME_SLOT_REF1="ts1515" TIME_SLOT_REF2="ts1517">
                <ANNOTATION_VALUE>Ke:mah, pero iwki n' ompaka ne:wí:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
