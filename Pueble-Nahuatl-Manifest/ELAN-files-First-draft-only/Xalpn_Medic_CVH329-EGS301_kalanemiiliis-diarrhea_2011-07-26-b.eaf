        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Ke:mah wa:n i:n, pos i:n kalanemi:lis achi</ANNOTATION_VALUE>
