        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813" TIME_SLOT_REF1="ts1226" TIME_SLOT_REF2="ts1228">
                <ANNOTATION_VALUE>toni ika t'tsetselo:s kwali tikwi tsiktsi:n tilmah,</ANNOTATION_VALUE>
