        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819" TIME_SLOT_REF1="ts1241" TIME_SLOT_REF2="ts1243">
                <ANNOTATION_VALUE>Ke:mah, wa:n ika yo:n pos no:</ANNOTATION_VALUE>
