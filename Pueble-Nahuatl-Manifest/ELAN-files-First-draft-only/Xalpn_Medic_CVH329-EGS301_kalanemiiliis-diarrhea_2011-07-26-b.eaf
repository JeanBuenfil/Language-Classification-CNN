            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1335" TIME_SLOT_REF1="ts2393" TIME_SLOT_REF2="ts2396">
                <ANNOTATION_VALUE>*Porque** komo a:mo se: kihtowa n' tein tikmattokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1336" TIME_SLOT_REF1="ts2397" TIME_SLOT_REF2="ts2398">
                <ANNOTATION_VALUE>ne: teha:n titamiskeh wa:n nochi tikwi:kah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1337" TIME_SLOT_REF1="ts2399" TIME_SLOT_REF2="ts2400">
                <ANNOTATION_VALUE>A:mo teh moka:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1338" TIME_SLOT_REF1="ts2401" TIME_SLOT_REF2="ts2402">
                <ANNOTATION_VALUE>Wa:n komohkó:n tikihtowah, ke:meh ekintsi:n nika:n titahtohtokeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1339" TIME_SLOT_REF1="ts2403" TIME_SLOT_REF2="ts2404">
                <ANNOTATION_VALUE>pos ne: tein teha:n tikmattoyah panowa itech se: *persona**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1340" TIME_SLOT_REF1="ts2405" TIME_SLOT_REF2="ts2406">
                <ANNOTATION_VALUE>i:n se: tokni:w a yeh kis..., kis..., kikwis a *porque** ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1341" TIME_SLOT_REF1="ts2407" TIME_SLOT_REF2="ts2408">
                <ANNOTATION_VALUE>teha:n a:mo tietokeh ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1342" TIME_SLOT_REF1="ts2409" TIME_SLOT_REF2="ts2410">
                <ANNOTATION_VALUE>Pero yo:n, yo:n nepahti:lis mah a:mo poliwi, mah a:mo tami.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1343" TIME_SLOT_REF1="ts2411" TIME_SLOT_REF2="ts2413">
                <ANNOTATION_VALUE>Ke:mah, yeh ka yo:n moneki mah se: motapowi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1345" TIME_SLOT_REF1="ts2415" TIME_SLOT_REF2="ts2418">
                <ANNOTATION_VALUE>Neh *siempre** nikinilwia ke:meh i:n akahsa:meh ne:chkalpanowah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1346" TIME_SLOT_REF1="ts2419" TIME_SLOT_REF2="ts2421">
                <ANNOTATION_VALUE>ompa nikinilwia tohto:ni n' kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1353" TIME_SLOT_REF1="ts2435" TIME_SLOT_REF2="ts2437">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1356" TIME_SLOT_REF1="ts2442" TIME_SLOT_REF2="ts2445">
                <ANNOTATION_VALUE>No: ke:meh nikinilia neh nopi:pi:lwa:n, nikilia pos n' teha:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1357" TIME_SLOT_REF1="ts2446" TIME_SLOT_REF2="ts2447">
                <ANNOTATION_VALUE>neh ni..., a:mo ninemis nochipa, pero nankimattokeh a toni wa:n toni n' tikwih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1358" TIME_SLOT_REF1="ts2448" TIME_SLOT_REF2="ts2449">
                <ANNOTATION_VALUE>amopili:wan sepa nikilia xkintapowi:ka:n nikilia para mah ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1359" TIME_SLOT_REF1="ts2450" TIME_SLOT_REF2="ts2451">
                <ANNOTATION_VALUE>miakiya, *porque** komo a:mo nikilia tamis wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1360" TIME_SLOT_REF1="ts2452" TIME_SLOT_REF2="ts2454">
                <ANNOTATION_VALUE>de neh nitami nikilia no: tami.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1366" TIME_SLOT_REF1="ts2465" TIME_SLOT_REF2="ts2468">
                <ANNOTATION_VALUE>Sa:te:pan ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1369" TIME_SLOT_REF1="ts2473" TIME_SLOT_REF2="ts2476">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
