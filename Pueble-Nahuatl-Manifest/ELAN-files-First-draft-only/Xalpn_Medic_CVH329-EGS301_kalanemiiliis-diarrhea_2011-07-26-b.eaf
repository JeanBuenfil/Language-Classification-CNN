        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1325" TIME_SLOT_REF1="ts2371" TIME_SLOT_REF2="ts2374">
                <ANNOTATION_VALUE>Se: kelna:miktok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1333" TIME_SLOT_REF1="ts2389" TIME_SLOT_REF2="ts2391">
