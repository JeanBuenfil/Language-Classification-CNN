        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a807" TIME_SLOT_REF1="ts1213" TIME_SLOT_REF2="ts1215">
                <ANNOTATION_VALUE>yowi ahachichi iwa:n tekol ok xohxo:tatok, sa tehtsoyoka ne:n ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a809" TIME_SLOT_REF1="ts1217" TIME_SLOT_REF2="ts1220">
                <ANNOTATION_VALUE>kipante:mah itech kahfe:n wa:n yehwa yo:n tikihto:s kwaltsi:n kima:nelowah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811" TIME_SLOT_REF1="ts1222" TIME_SLOT_REF2="ts1223">
                <ANNOTATION_VALUE>kimane:lowah, kichiah mah moi:xte:ka tepitsi:n,</ANNOTATION_VALUE>
