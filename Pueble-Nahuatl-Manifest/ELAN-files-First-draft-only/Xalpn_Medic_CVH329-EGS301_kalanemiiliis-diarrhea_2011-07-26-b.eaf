        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1139" TIME_SLOT_REF1="ts1975" TIME_SLOT_REF2="ts1978">
                <ANNOTATION_VALUE>Neh niki:..., niki:ilia neh ne: nosiwa:mon, nikilia, *mientras** titsikwi:ntos koyo:ko nikilia, achtopa xikmolo:nti ne:n pahti.</ANNOTATION_VALUE>
