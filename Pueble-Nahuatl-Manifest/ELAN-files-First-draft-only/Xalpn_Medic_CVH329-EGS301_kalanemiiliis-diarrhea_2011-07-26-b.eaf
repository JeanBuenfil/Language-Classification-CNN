        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801" TIME_SLOT_REF1="ts1198" TIME_SLOT_REF2="ts1200">
                <ANNOTATION_VALUE>pi:pil kelka:wtiwih ya ma:se:walyo:t, kanah ika a:mo ki:xmatih ok n' tekixkit.</ANNOTATION_VALUE>
