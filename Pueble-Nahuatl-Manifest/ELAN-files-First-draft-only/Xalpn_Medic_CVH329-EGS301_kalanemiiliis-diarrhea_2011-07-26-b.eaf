        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>te:kokoh ne: se: iihtik ata wa:n ye:kse:yo:yowi n' kalan a:achka,</ANNOTATION_VALUE>
