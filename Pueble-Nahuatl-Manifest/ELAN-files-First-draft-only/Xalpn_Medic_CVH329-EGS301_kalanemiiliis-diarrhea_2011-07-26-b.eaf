            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1165" TIME_SLOT_REF1="ts2032" TIME_SLOT_REF2="ts2033">
