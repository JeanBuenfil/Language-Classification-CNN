        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>ke:meh yo:n nejó:n, yo:n te:chnamaki:ltiah yo:n ahwia:k semi nikilia neh yo:n tel *fuerte** yo:n a:xox kiliah. Ih..., iwki at..., iwki ata n' ikamohyo, ke:mah i:ihko:ntsitsi:n ata wa:n nikilia neh</ANNOTATION_VALUE>
