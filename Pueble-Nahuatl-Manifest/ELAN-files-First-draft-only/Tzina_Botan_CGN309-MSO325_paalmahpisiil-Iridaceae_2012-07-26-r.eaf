        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>Ke:mah, ta: ka:mpa moye:kchi:wa neli nikilia neh no:, no: *hasta** pané: se: metsmowi *porque** nejó:n moye:kchi:wa neli tak ka:mpa tawe..., ta:lwelita nikilia neh pos no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>*mismo** yehwa neli n' ikamohyotsi:n ne: mochih..., mochi:wtiw wa:n nejó:n panki:stiw *más**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Pos neh ompaka neh, neh a:mo nimati. A:mo ke:man niow i:n tikihtowa n' ompaka. A:mo ke:man niow n' ompaka pero no: onkak n' tikihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>A:, yehwa tikwito wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Ke:mah. E:.., ke:mah, ta: ne: alaxtik n' ixiwyo. Ke:mah, alaxtik n' ixiwyotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Ke:mah neli, ta: pos neli neh i:pa nikitani neli ke:meh i:n neli ma:ski ohti onkak ompa ne: ka:mpa ika ne: nejó:n neh nimoskaltih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>ne:paka nejó:n talwiah ne: Xopana:ko, ompa neli no: onkaya ni..., o..., onkak *hasta** a:man nikitaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>Kanah, ka:n mone:neki, ke:mah, ta: neli on..., onkaya pero ekintsi:n a:mo nikchi:wtok *cuenta** a:it ox tei ok, pero ne: ke:man onkaya *porque** ke:meh yo:n kita:liah nikilia neh nochi yo:n pahti n' ompa nikilia neh nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>*que de** tame:waskiah kichi:wah yehwa yo:n pahti kita:liah, pos nochi poliwi a tein eski. Ke:mah, nochi poliwi tein es... Ke:mah, pero no: onkaya n' ompa yehwa ne: xo:chitsí:n ke:meh i:n nikilia neh ke:meh i:n tikelna:miktokeh ekintsi:n neli i:n tikiliah *palmapisi:l**, ta: neli iwki ne:n tiki:xmatiah. Ke:mah, ke:mah, tiki:xmatiah nik... Ke:mah, ta: neli *pisilitos**, ka:n iwki n' ke:meh yo:n okseki onkak nikilia neh wehwei, pos yeh tato:k a, pero i:n seki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>i:n seki nikilia neh tak xa: no: kito:kayah ne: ke:man *porque** pos yehwa neli wel tikwiah pero ekintsi:n pos a:mo no: nakah kichi:wa *cuenta** ok. Kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Ni..., ke:mah ta: pos nik... Ta: yehwa ika, ke:mah. Eh...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Kanah ok. Mochi:wa sah, nimolia neh *que** mochi:wa sah *porque** neli pos onkak ma:ski nikahkwí:n, nika:n i:n to..., tocha:nkopa nikilia neh mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Wa:n ompaka ne: ahkwakopa nikilia neh se: kita nochi yehwa. Ke:mah, ta: pos tak nejó:n tawelita no: n' ompaka ne: xo:chitsí:n. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>E..., ke:mah, ta: neli nikilia neh no: kwaltsi:n moka:wa ya nikilia neh ika se: taa:ketsaya wa:n, wa:n ne: ke:man nikilia neh tika:ketsayah neli xo:chitsí:n pero ka:n miak tikwiah *porque** ne: ke:man tika:ketsayah ata</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>ox no: tiki:xmat ok ika yo:n *topos** kikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Yeh..., yehwa ata ika tika:ketsayah. Nikilia neh, tsi:tsikitsi:n ihkwi:ni nikilia neh ihko:ntsi:n wa:n ke:mah ti... Ke:mah, wa:n ttaa:ketskeh ya nikilia neh n' ka:mpa n' ompa ne:n *toxa:ntohi:xpan**, pero neli yehwa ne: *pisilitos** tika:ketsayah wa:n neli no: kwaltsi:n moka:waya tika:ketsayah, pero neli a:man a:mo, a:mo nakah ka:ketsa ok. Kanah, ka:n akah ka:ketsa ok nikilia neh, ta: nochi poliwik a n' ekintsi:n tein... Kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Pos kanah nikilia neh wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Ke:mah, ta: neli ika, ika kipatayah. Pos nejó:n... Ke:mah, neli ahsi a. Ta: neli pos nejó:n kwaltsi:tsi:n no:, sayoh *que** neli *que** ekintsi:n tak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>neli nochi moelka:wtiw a, ka:n iwki ok kit ke:meh ne: ke:man katka nikilia neh tein tote:iskaltihka:wa:n kikwiah, a:man tehwa:n a:mo tikwih ok. A:man pos nochi kipatatiwih ya nikilia neh. Ke:mah, ke:meh... No..., nochi yehwa ya, ke:mah moelka:wtiw a n' tein nikilia neh achto i:pa tikwiah. Nochi ata yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>yo:n seki nikilia neh yo:n *ahazul** xo:chitsí:n nejó:n no:, no: yehwa nokta tika:ketsayah wa:n, wa:n a:man a:mo nakah ka:ketsa ok. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Ke:mah, ta: neli. Ke:mah. Pos...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>ka:n teihsá: na:nah, miak tasohka:matik tein tine:chilih, yehwa sah tein ika timonohno:tskeh. Neh i:pa n'matisnekia no: ox tiki:mxattok ke:n..., ke:niwki neli ne:n ixo:chiotsi:n wa:n ikamohyotsi:n, pos no: tiki:xmattok. Ke:mah, pos, pos miak tasohka:matik tein tine:chilwih, neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
