            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>I:ksá: nikwa:lkwia wa:n kihto:s ka:ni n' tikwik yo:n xo:chit, nikilia ta: i:n ka:mpa i:n tanipaka nejó:n na:nah nikilia nikwito.</ANNOTATION_VALUE>
