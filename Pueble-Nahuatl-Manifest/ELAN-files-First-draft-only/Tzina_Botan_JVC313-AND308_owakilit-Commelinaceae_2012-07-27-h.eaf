        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>a:mo:molo:ni wa:n a:mo we:lik ok n' taxkaltsí:n, ye:ktihtixtia.</ANNOTATION_VALUE>
