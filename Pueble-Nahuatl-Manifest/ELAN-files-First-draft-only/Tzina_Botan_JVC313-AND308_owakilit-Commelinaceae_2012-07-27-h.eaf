        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>de sepa se: kitahtapowa ihkó:n, se: kiki:xtilia ne: xiwtsí:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>Pos kwaltsi:n se: kita:lia ihkó:n wa:n ye:kahwia:ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>panki:sa ne: de popo:ka kwaltsi:n ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>se: kwe:lilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>Wa:n ke:masá: se: kikwa ika n' eh..., emo:ltsí:n oso ihkó:n ne:n se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>se:..., meh yo:n, yo:n a:mo moneki ne:n tapalo:l, ihkó:n se: kikwa sah, ka:n moneki tap..., iwki sah se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>se: kikwiti ne: *o** te:makah de toto:nik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>de toto:nik no: semi we:lik, se: kikoto:na yema:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364" TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>Pero yeh nimitsilia *de que** kintsi:n ne:n kitapechtiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365" TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>kitapechtia:yah n' *antes** ihkó:n ne:n, *hasta** kintsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>kitapechtia ika yehwa yo:n itech i:n me:liohko:mit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a367" TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>para nijó:n mah a:mo kwa:..., a:kwakwalaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Pero de a:..., *de que** a:mo kitapechtia:yah ihkó:n pos ke:masá: no: tsi:ntata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>A:ihtik moka:wa wa:n seki ne: tsi:ntata wa:n yehwa yo:n ne:n mopepechowa ya wa:n ma:sá: se: kita ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>no: taman ahwia:k *porque** tata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Nochi k..., nochi kipa. Wa:n yehwa yo:n n' ikintsi:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts498">
                <ANNOTATION_VALUE>pos tehwa:n no: tik..., tike:wayah ne: nikitaya ne: kichi:wa no:má:n pos ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>kie:waya ne:n nochi ne:n tikwiah ne:n oh..., ohtat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>Niman kihtowa:ya, pos i:n sepa tikwiskehi:n ohtat, mah tike:waka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Kihto:s sepa xne:chkwi:li:tih i:n owakilit *porque** i:n semi we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>No: tikilia:yah tehwa:n pos ne:n x'ta:li nijó:n miaktsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>wa:n timowili..., timowi:kili:skeh ne: ka:mpa titekitih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>Ompa ne: tik..., tikwi:kah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>pos ompa ne: tikchi:wah n' tsitsí:n wa:n tik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>tikte:tewa:tsah hkó:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388" TIME_SLOT_REF1="ts525" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>ch..., ompa ne: tikwih se: kowit wa:n tikoyo:niah wa:n t'te:tewa:tsah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390" TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>Pos ompa ya ne: tikwah no: kwalts..., kwaltsi:n n' ahwia:k, de sepa te:tewa:ki kwaltsi:n ahwia:ya n' takxaltsí:n, kwaltsi:n ahwia:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n ne: nik..., yeh nika:n ni..., timonohno:tstokeh, nimits..., nimits..., xa:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392" TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>xa: kachi tikmati ne:n ke:meh no: tikowtahnemi wa:n no: ika ti:xpanowah, te:chi:xpano:ltia:yah tota:tahwa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>pos no: kwali tine:chili:s ne:n ki:ní:n, ki:ní:n n' teh nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>ki:n de we:lik *o** ki:ní:n ahwia:k *o** ki:ní:n eski,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>A:mo *igual** ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>De xo:nokowit, pos yo:n ta:taman nochi tik..., tikmatih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>Yehwa n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Pos i:n ohtat i:n no: kwelitayah *porque** i:n a:mo a:chichi:na, i:n takwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>Takwa:wak no: wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>pos ihkwí:n de wehkapan tepitsi:n kita:lilia:yah para a:mo mah kahsi n' a:tsí:n ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426" TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>para a:mo a:kwakwalaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Ema:nia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts629">
                <ANNOTATION_VALUE>Wa:n no: seki kihtowa:yah *de que** ma:sá: kitayah..., si..., komo a:mo se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>se: kipa:panita ihkó:n se: kixo:xa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts637">
                <ANNOTATION_VALUE>Kixo:xah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>*Hasta** n' ixiwyotsi:n no: achi xoxoktia, nijó:n xoxoktik moka:wa, a:mo...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>Wa:n de sepa de kwaltsi:n nochi yoksik, kwaltsi:n se: taman, pos nochi *hasta** sen..., xiwtsí:n nochi kwaltsi:n, nochi tamanaltia wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445" TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>Pos yehwa yo:n kwaltsi:n moka:wa ya ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>taxkaltsí:n wa:n pos *de que..., de veras** nikneltoka *que de** a:mo kwaltsi:n kitekpa:nah kis..., to:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>pos nijó:n chi:chikoyoksi wa:n chi:chiko ne:n tahtakwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>Ke:mah wa:n de kwaltsi:n nochi kichi:wah nochi kwaltsi:n kisa:lowah, kwaltsi:n kitekpa:ntiuweh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452" TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>Pos no: kwaltsi:n yoksi n' taxkaltsí:n, no: kwaltsi:n se:, se: kwe:lilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>No: se: kwe:lilia wa:n yeh nikilia ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>de, de se:wi a pos a:mo semi popo:ka ok, de, de toto:nik kwaltsi:n popo:ka pa:nki:sa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>Ke:mah, kita:liah itech yo:n nijó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>teihsá: ihkó:n xi:kaltsí:n *o** teihsá: xiwtsí:n, ke:masá: ti..., tikwiah ne: xiwtsí:n, xiwtsí:n *mismo de** nexkihiiswat wa:n kita:lia:yah nika:n, ompa paniá:n kita:ta:lia:yah ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460" TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts701">
                <ANNOTATION_VALUE>Para se:wi a, ke:masá: se: kitohtoma wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts702" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>wa:ki a, *bueno** ke:meh eskia se: kita:lia ne:pa wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463" TIME_SLOT_REF1="ts706" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>se:wi a wa:n se: ki..., se: kimahse:wa ya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464" TIME_SLOT_REF1="ts710" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>pos niman ne:n tikihtowah ekintsi:n tik..., tikwa:tih, ke:masá: se: o:me:n *o** se: e:yi:n se: ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>se: kimahse:wa ya ne:n taxkaltsí:n, kwaltsi:n no: se:, se: i:xpanowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468" TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>No: *igual**, pos yehwa nika:n timohno:tstokeh, *casi** no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a470" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>no: kwaltsi:n de nika:n timonohno:tsah nochi ti..., tiki:xmatih wa:n nochi de n' a:mo tiki:xmatih pos nochi k..., ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472" TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts731">
                <ANNOTATION_VALUE>Se: motapowi, ke:masá: yo:n xiwtsí:n seki, seki kihto:skeh ne: a:mo we:lik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474" TIME_SLOT_REF1="ts733" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>Se: kite:xi:ma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476" TIME_SLOT_REF1="ts738" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>Pos ka:s ika ne:n..., de n' kintsi:n tik..., tikmattokeh *que** we:lik, ka:s ika ka:mpa tima:tame:wah pos tika:wtiuweh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a478" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>*porque**  tikmattokeh *que** i:n we:lik, *igual** ne:n nexkihiwtsi:n, *porque** nexkihitsi:n sayoh se: taman de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts749">
                <ANNOTATION_VALUE>ya para ika kipi:kih ne:n taxkaltsí:n kitetsi:lowah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481" TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>pos no:, *más** a:mo, a:mo teh, *solamente** yeh kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>Kikwih porin no: ahwia:k, kahwia:lia ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>taxkaltsí:n, kwaltsi:n kahwia:lia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489" TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>n' itapalo:lyo de ne:n nexkihit pos kwaltsi:n, kwaltsi:n we:lik, ihkó:n nochi ki:sa ya *hasta** n' ixiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts779">
                <ANNOTATION_VALUE>We:lik n' ita:kka, n' ixiwyo kahwia:lia, a:mo se: kikwa pero ke:meh eskia no: se: kikwa *porque** ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494" TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>Ke:mah n' ih...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496" TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>ahwia:k mochi:wa ne:n taxkaltsí:n, ahwia:k wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts794" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nochi se: kikwi para ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts798" TIME_SLOT_REF2="ts801">
                <ANNOTATION_VALUE>taxkaltsí:n kipi:kih, kitetsi:lowah, nochi, yehwa yo:n ki...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts804">
                <ANNOTATION_VALUE>yo:n tikwitih *porque** yo:n no:, no: ahwia:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505" TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>No: ahwia:k ne: xiwtsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506" TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>De kitsaya:nah ihkó:n moka:wa n' ikwa:ko wa:n kitsaya:nah ah..., ahwia:ya de kitsaya:nah yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>Moka:wa sayoh ne:n kiliah kowtako:tsí:n, kitamo:tah wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511" TIME_SLOT_REF1="ts824" TIME_SLOT_REF2="ts827">
                <ANNOTATION_VALUE>pos seki ne:n kitila:ntiuweh wa:n ne: wetsiti, kitila:ntiuweh ne: kiki:xtiliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts839">
                <ANNOTATION_VALUE>Pos ka:mpa wehka, ka:mpa a:mo se: kie:..., kie:kta:liah ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>ne:n kowtsí:n ihi:xtapal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts842" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>tatapo:tok ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520" TIME_SLOT_REF1="ts846" TIME_SLOT_REF2="ts849">
                <ANNOTATION_VALUE>Pos ompa kita:liah para mah kitsakwili n' xiwtsí:n, para mah kitsakwili i:n tapech, para a:mo mah pankalaki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523" TIME_SLOT_REF1="ts854" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>Ihkó:n mah kitsa..., para a:mo panki:sas n' a:tsí:n, para ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525" TIME_SLOT_REF1="ts858" TIME_SLOT_REF2="ts861">
                <ANNOTATION_VALUE>para a:mo a:kwakwalas. Yehwa yo:n ne:n..., yo:n nochi kipale:wia yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts864">
                <ANNOTATION_VALUE>yo:n no: kipohpostekih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529" TIME_SLOT_REF1="ts869" TIME_SLOT_REF2="ts872">
                <ANNOTATION_VALUE>Yo:n a:mo kitehtekih, kipohpostekih sah. Yema:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532" TIME_SLOT_REF1="ts877" TIME_SLOT_REF2="ts879">
                <ANNOTATION_VALUE>Ya:nkwik kichihchi:wah wa:n yo:n achi teiktik de n..., de moka:wa ya ke:meh eskia kowtako:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534" TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>Achiteik..., de ihkó:n kichi:wah posteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535" TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts887">
