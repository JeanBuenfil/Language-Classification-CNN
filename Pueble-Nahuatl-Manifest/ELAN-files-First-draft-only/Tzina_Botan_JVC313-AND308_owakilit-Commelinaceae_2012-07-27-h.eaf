        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>Ew... Xoxoktik moka:wa. De a:..., ka:mpa, ka:mpa tixtik moka:wa a:mo oksi ne:n xiwit nochi xoxoktik moka:wa.</ANNOTATION_VALUE>
