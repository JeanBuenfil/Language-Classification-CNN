            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts600">
                <ANNOTATION_VALUE>Komohkó:n sepa kikwih pos ompa sah n' kitemowiah.</ANNOTATION_VALUE>
