        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>Ke:mah, a:mo a:chichi:na. Ke:mah, a:mo a:chichi:na.</ANNOTATION_VALUE>
