        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411" TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>Ahko etok wa:n ika yo:n nejó:n kipale:wia kwali para i:n,</ANNOTATION_VALUE>
