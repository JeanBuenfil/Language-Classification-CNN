            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>a:mo iwki n' kisa:lowah oso ke:ní:w pero..., oso kixo:xah, pero neli seki kihtowah motixnepanowa ata,</ANNOTATION_VALUE>
