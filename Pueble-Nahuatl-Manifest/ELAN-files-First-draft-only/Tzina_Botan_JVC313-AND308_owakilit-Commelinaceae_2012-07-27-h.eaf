            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>Seki neli kixo:xah n' kihtowah, pero yo:n nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts638" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>Wa:n seki a:mo n'mati ke:ní:w, ox a:mo kie:ksa:lowah, a:mo wel kisa:lowah ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>ne:n taxkaltsí:n *cuando** kichi:wah, mo..., kihtowah motixnepanowa.</ANNOTATION_VALUE>
