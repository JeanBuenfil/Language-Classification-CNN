                <ANNOTATION_VALUE>Wa:n ika yo:n nejó:n kipale:wia n' tapech se: kita:lilia, neh n'ta:lilia yehwa de xo:no:kwowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>Yeh nik..., yeh n'te:tehteki kowtsitsí:n wa:n nik... Ke:mah, ih...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>Ke:mah, yehwa n'ta:lilia wa:n nejó:n para ika ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>iwki a itsi:ntapech moka:wa wa:n, wa:n no: kwali ki:sa yo:n, soh *que** yo:n a:chichi:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts596" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>pero de sepa kitamimanah ya n' tamaltsí:n, ki..., *o** tami n' tamaltsí:n pos kipa:kah n' kowtsí:n wa:n kipilowah mah ihxi:ka wa:n ompa yetok n' kowtsí:n sepa.</ANNOTATION_VALUE>
