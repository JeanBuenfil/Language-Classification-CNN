        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>Wa:n yo:n, yo:n kowit se: kita:lilia yo:n, yo:n tapech para kipale:wia, para ahko yetok de n..., de n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
