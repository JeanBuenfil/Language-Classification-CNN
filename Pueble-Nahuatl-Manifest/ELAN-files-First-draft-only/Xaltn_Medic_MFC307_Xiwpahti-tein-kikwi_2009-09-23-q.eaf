        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>wa:n nochi nejó:n *cubeta** nochi nikyewalo:ltia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>wa:n ompa yetok imetstsi:n wa:n komo tata niktampapechtia *cobija**, n' a:ya:t a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>wa:n ke:mah se: n'ta:lilianika:n ika:n wa:n se: n'ta:lilia nika:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>wa:n nika:n tiktsakwa ika tilmahtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Ke:mah wi:tsa ya nejó:n mi:to:ni:lis, wi:tsa ya, wi:tsa ya, wi:tsa ya, wi:tsa [ya],</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>*hasta** moka:wa ke:meskia moi:xa:mihtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>Ke:meskia mopa:ktok *icara, parejo, parejo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>ke:mah, yehwa nejó:n wa:n [komo]t'neki nimitswa:lkwilia nejó:n xiwit tein neh nikwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>Komo t'neki nikwa:lkwi, nikwa:lkwis wa:n nikchi:was,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>a:mo nikchi:wa de tamanal pero we:noh sikie:ra nimitsne:xtili:s ton, ton xiwyo wa:n ton ito:ka:i,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>*porque** kipia ke kiwi:kas kwitakowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>kwitakowit ista:k, kwitakowit ti:ltik wa:n kipia ke nochi tiki:xmatis kati:yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>ke:mah. Kipia ke tiki:xmatis kati:yeh kwitakowit ista:k wa:n kati:yeh ti:ltik wa:n kati:yeh n' ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>katí:n awakaiswat wa:n katí:n ne:n ... katí:n wa:kohxiwit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>katí:n ahtsomia:s wa:n kati:yeh ne:n o:mekilit, kati:yeh ne:n awa...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>kati:yeh ne:n ... yehwa ya kwi..., ne:n xo:met. Xo:me:t pos tiki:xmattok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>we:noh, ompa ya ya:s n' *ajo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>chiko:me tanti de *ajo**, tikxama:nia wa:n tikpanpahka:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>para *con eso** ki:sa nejó:n *vapor**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>mi:to:nia ya tikihtowah, moka:wa ke:meskia a:kah ki:xa:mihtok, ke:meskia a:kah ka:ltihtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>Nochi, nochi a:paliwi itilmah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>pero nejó:n a:tsi:n molo:ntoya, tiki:xtia itech tiko:mit, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>Ke:mah tik..., tik..., tik..., mo..., kihto:s "kwali a, nitata ya".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>Entó:s *mismo** ke:meh i:n ka:mahte:noh, a:mo wehka tikwi:kas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>entó:s tiki:xtilia se: *cobija** nika:n wa:n se: nika:n,</ANNOTATION_VALUE>
