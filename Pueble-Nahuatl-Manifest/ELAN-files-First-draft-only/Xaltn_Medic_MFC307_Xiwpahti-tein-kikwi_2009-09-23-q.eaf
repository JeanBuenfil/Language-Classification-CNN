        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>komo tika:lti:ti *paciente o** komo tiki:to:ni:ti *paciente**.</ANNOTATION_VALUE>
