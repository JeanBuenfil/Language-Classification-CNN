        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>ne: ihsiwkatsi:n ne: t'pano:ltia wa:n ompa tikpasowilia n' o:me n', o:me n' a:ya:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>'Pasowilia n' a:ya:t wa:n se: t'pechtia para ma:ski mi:to:nia wa:n ihxi:ka n' a:t ompa mochia nejó:n itech n' a:ya:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts91">
                <ANNOTATION_VALUE>Mm, kwaltsi:n moka:wa, *igual** komo nika:n mitskokowa i:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>komo mitskokowa nika:n, yehwa yo:n tikchi:wa, ke:mah. Tikchi:wa de yehwa yo:ni para *con eso** nochi mitska:was</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>*lo que** tein mitskokowa nochi *mocuerpo**, ta:ká:n tietok ti..., tikwahkwawtitok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>nochi tiyema:nias. Nochi tiema:nias de yo:ni wa:n *mocabeza** no: *igual**, komo mitskokowa *mocabeza**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>ompa tamati:ya:s komo ta:ká:n no: *por medio** de no: nekohkowti:lis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Mm, komo nekohkowti:lis yo:n pos no: tamati:yas *mocabeza** pero *lo que es** tein ke:meh nimitsilia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>nochi titamati:yas. Komo ti..., *o** komo tiposo:ni,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>ata seki poso:ni de n' imets, poso:ni nochi ke:meh yetokeh, *igualito**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>*Cuatro veces** tikchi:was nejó:n mi:to:ni:lis</ANNOTATION_VALUE>
