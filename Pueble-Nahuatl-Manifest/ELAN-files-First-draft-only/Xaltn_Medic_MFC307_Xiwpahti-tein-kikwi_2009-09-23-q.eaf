        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>'wa:lkwi nejó:n *canasta**, wa:lkwi ne:n *canasta** yo:n yetok,</ANNOTATION_VALUE>
