        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>nimitsilia wa:lkwi *canasta**. Nikta:lia o:me kowtsí:n nika:n, ihkó:n,</ANNOTATION_VALUE>
