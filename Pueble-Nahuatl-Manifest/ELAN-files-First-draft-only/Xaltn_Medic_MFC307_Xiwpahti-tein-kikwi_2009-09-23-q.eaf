        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>wa:n tikpantamo:tilia ka:mpa n' a:t molo:ntok</ANNOTATION_VALUE>
