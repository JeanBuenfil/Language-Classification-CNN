                <ANNOTATION_VALUE>nikakini pero a:mo niki:xmati i:n xiwit, nik..., nikitani ne: kowtah pero a:mo n'mati ke:ní:w mono:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Ke:mah, sayoh yehwa. Ke:mah. Mahyá: ka:n n'mati, ka:n niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Niki:xmattok, pero a:mo n'mati ke:ní:w mono:tsa neh. Yehwa sah yo:n nimitstahtania</ANNOTATION_VALUE>
