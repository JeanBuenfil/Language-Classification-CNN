        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>Yo:n wa:ki, wa:ki no: *porque**</ANNOTATION_VALUE>
