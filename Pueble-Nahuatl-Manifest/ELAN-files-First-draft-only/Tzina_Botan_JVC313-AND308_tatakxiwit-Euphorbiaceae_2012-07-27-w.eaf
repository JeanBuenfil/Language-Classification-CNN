        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>Ajá, pos, ke:mah, pos yehwa sah yo:n neh nimitstahtania *porque** neli neh</ANNOTATION_VALUE>
