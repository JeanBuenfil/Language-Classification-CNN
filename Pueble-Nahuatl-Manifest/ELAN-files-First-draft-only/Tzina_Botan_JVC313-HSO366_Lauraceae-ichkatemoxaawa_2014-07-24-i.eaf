        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Yehwa sah, yehwa sah yo:n niki:xmatok. Yehwa sah yo:n pero niki:xmattok para kowtati:l sah se: kikwi wa:n tein mehmelaktsitsi:n pos kwaltia para *siquiera kal..., kale:waltsitsí:n tein achi wehweyihtsitsí:n, ka:n mochi:wa *más** wehweikowit yo:n.....</ANNOTATION_VALUE>
