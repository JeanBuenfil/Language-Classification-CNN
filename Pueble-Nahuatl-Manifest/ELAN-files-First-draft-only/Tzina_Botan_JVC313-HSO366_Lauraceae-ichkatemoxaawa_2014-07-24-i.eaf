        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>*Bueno** Ernesto nika:n sepa ti..., timonohno:tsatih, ne: nikneki nimitstahtani:s ox tikmattok no:, tiki:xmattok yo:n ichkatemoxa:wakowit kiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
