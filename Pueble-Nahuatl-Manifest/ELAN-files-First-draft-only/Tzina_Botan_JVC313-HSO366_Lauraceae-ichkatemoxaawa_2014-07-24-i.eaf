        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>A: wa:n pos neh no: niki:xmattok no: ne:chilihka neli ke, ke ichkatemoxa:wa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>wa:n *este**, nikiita ke:masá: ka:sá: ika mahyá: chihchichimoltia ata n' ikechtayo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>*o** ne: wa:n mochi:wa pané: kokotsitsí:n mota:lia, tak no: cha:wis kikwi yo:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
