            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Pero wihwitsyoh, yo:n ye:k..., ye:kwehwei n' itsihtsi:n..., itsihtsi:ntayo, kwa:pihpitsaktik n' iwitsyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
