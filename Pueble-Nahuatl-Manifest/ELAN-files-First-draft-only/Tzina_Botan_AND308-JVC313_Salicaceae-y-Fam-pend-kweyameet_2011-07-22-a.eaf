        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Pos n' ixo:chio pané: no: *morado** n' ixo:chio yo:n, yo:n xiwit, i:n</ANNOTATION_VALUE>
