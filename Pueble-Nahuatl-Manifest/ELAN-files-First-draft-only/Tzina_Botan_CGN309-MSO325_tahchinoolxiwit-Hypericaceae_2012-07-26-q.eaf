        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>a:mo ke:meh a:man i:n nikilia neh tikwih nochi tikowah, n' ta: ne: ke:man ka:n tikowayah, timo:nkwi:lia:yah sah nikilia neh ompa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>Ke:mah. Wa:n ompa ya neli yo:n se: kitaya neli ye:konkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>A:, pos neli, ke:mah pos no: pahti, pos neli neh para toni nikihto:s neh a:mo nikmati komo no: kwali para pahti, pero neli i:pa nikitani neli onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>A:, n' ika kina:ltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Pos ka:n se: kimati ke:ní:w, pero nejó:n pos neli nikilia neh ka:n tikmahmatih sah, ta:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>neli nikilia neh ne:n tote:iskaltihka:wa:n yehwa:n kimattoyah neli ne: ke:man tohtoni *más**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>xihxiwpah ika se: mopahti:s *porque** ke:meh ne: ke:man yehwa:n ka:n ko:nitayah tapahtihkeh. A:, ka:n kanah ya:yah nikilia neh, yehwa:n kihtowah teihsá: kinkokowa:ya i:pa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>I:pa iwki sah mopahtia:yah ika xihxiwpah..., xiwpahtsi:ni wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>neli ke:meh yo:n nikilia neh, komo yo:n tikihtowa kwali para kokot, pos neli ne: ke:man nochi xiwit sah timota:lilia:yah, ika tiki:xpa:kayah xiwtsi:ni sah wa:n iwki a nikilia neh nejó:n timopahtia:yah, pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>a:man a:mo, a:man nikilia neh nochi nejó:n mah tia:ka:n ne: ka:mpa koyo:tapahtihkeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>A:man nochi ompa nikila neh, om...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Ke:mah, nochi ompa. Ke:mah, pos nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>yehwa sah katka i:n tein nimitstahtanih na:nah, miak tasohka:matik tein tine:chilwih, neh a:mo n'matia komo kwali para pahti, pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>yehwa ya tein ika timonohno:tskeh, miak tasohka:matik, neh nimono:tsa niMaría Salazar Osollo, niwi:tsa de San Miguel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
