            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581" TIME_SLOT_REF1="ts933" TIME_SLOT_REF2="ts936">
                <ANNOTATION_VALUE>xa: *más** tikmatis, teh no: kwali ti...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a582" TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts939">
                <ANNOTATION_VALUE>kwali tine:chili:s nika:n tietokeh, nochi tine:ntinemih kwowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586" TIME_SLOT_REF1="ts946" TIME_SLOT_REF2="ts949">
                <ANNOTATION_VALUE>tokalyekawiltsi:n, pos nika:n tietokeh nochi ti..., mah tikmatika:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590" TIME_SLOT_REF1="ts957" TIME_SLOT_REF2="ts959">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593" TIME_SLOT_REF1="ts964" TIME_SLOT_REF2="ts967">
                <ANNOTATION_VALUE>Ta:ká:n eh..., ehko to:nal tiknemiliah ke:meh i:n timosenohno:tstinemih,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594" TIME_SLOT_REF1="ts968" TIME_SLOT_REF2="ts970">
                <ANNOTATION_VALUE>pos kwali tikitati:weh yo:n, yo:n kowit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596" TIME_SLOT_REF1="ts972" TIME_SLOT_REF2="ts975">
                <ANNOTATION_VALUE>se: kitati:w ne: x..., se:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597" TIME_SLOT_REF1="ts976" TIME_SLOT_REF2="ts977">
                <ANNOTATION_VALUE>ke:masá: ke:meh i:n ne:wí:n tinentinemih, tisentekitinih, ne:wí:n timoyo:lchika:wah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598" TIME_SLOT_REF1="ts978" TIME_SLOT_REF2="ts980">
                <ANNOTATION_VALUE>niman tikihto:s, kintsi:n tik..., tike:mantih, tiowih ti..., tinemitih wa:n ika tikitatih ne:n kowtsitsí:n katí:n de n' se: kikwi para ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600" TIME_SLOT_REF1="ts982" TIME_SLOT_REF2="ts984">
                <ANNOTATION_VALUE>tokalyekawiltsi:n *o** katí:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602" TIME_SLOT_REF1="ts986" TIME_SLOT_REF2="ts989">
                <ANNOTATION_VALUE>parakowtati:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603" TIME_SLOT_REF1="ts990" TIME_SLOT_REF2="ts992">
                <ANNOTATION_VALUE>Entó:s nochi de se:, se: ki..., se: kimattiw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605" TIME_SLOT_REF1="ts996" TIME_SLOT_REF2="ts998">
                <ANNOTATION_VALUE>Ke:mah, ke:masá: se:, se: ki..., ke:mantis de n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607" TIME_SLOT_REF1="ts1000" TIME_SLOT_REF2="ts1003">
                <ANNOTATION_VALUE>se: nemiti a ika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611" TIME_SLOT_REF1="ts1010" TIME_SLOT_REF2="ts1013">
                <ANNOTATION_VALUE>Tamalwa:s, tehwa:n no: taman tik..., tikto:ka:ytiah *pero mismo** yehwa yo:n kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a613" TIME_SLOT_REF1="ts1015" TIME_SLOT_REF2="ts1017">
                <ANNOTATION_VALUE>Se: kowit sah, *que** nochi ta:ta:man sayoh tiki..., tikihtowah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615" TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1022">
                <ANNOTATION_VALUE>*pero mismo** yehwa. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a618" TIME_SLOT_REF1="ts1027" TIME_SLOT_REF2="ts1030">
                <ANNOTATION_VALUE>Pos nehwa nimono:tsa Anastacio Nicolás Damián, neh no: niwa:le:w xola:l de San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
