        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>mahyá: yo:n kwa:pata:wak wa:n tsi:npitsa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416" TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts525">
                <ANNOTATION_VALUE>Iwki, iwki mochi:wa ata yo:n xiwit yo:n. No:, no: ta..., istawa:t no: t..., no: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>No: iwki a, pero a:mo, no:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>Ke:mah wa:n yo:n nimitsilia metspihpitsa:wak n' ixiwyo wa:n kwa:..., kwa:panpata:wak wa:n ye:kapitsaktik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>nejó:n wa:n yeh moma:ytia ne:, moma:ytihtiw mo..., moyewalo:ltihtiw n' ima:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>Ke:mah. Wa:n ne: istawa:t yeh ki:sa i..., a..., we:wehka nijó:n, ki:stiw, ni:nipaka ki:stiw wa:n ne: a:mo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>Ne: ka:mpa i..., ima:e:kapan ya, yewaltik mochi:wa ne: kihki:sa, nochi kewalowa n' ima:xiwyo ki:sa ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>Ke:mah, molo:chowa ya, n' ta: i:n..., ke:mah iwki yo:ni mochi:wa. Ke:mah, iwki n' ki:sa n' ima:y.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts553">
                <ANNOTATION_VALUE>Wa:n ixo:chio ta..., ixo:chio achi *medio** a:..., a:kostik *porque** ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>ata no: mopahpampilowa ke:meh yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>no: ke:meh yo:n ahmo:lkilit n' ti..., n' ti..., soh *que** n' ahmo:lkilit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>iteyo n' ahmo:lkilit we:weyak wa:n ne:, ke:meh ihkwi:ni sah, ke:meh se: se: *jeme** de we:weyak n' i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>Ke:mah, mopah..., mopahpampilowa ihkwí:n ne:n i...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>Ihkó:n *merito**, ki:sa ne: xo:chit n' ima:tsa:la:n ne:n xo:chitsí:n wa:n mopampilowa n' imetskowyo ihkwí:n wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>se: kita pampi:xowi n' ta:lpan ata. Iwki yo:n mochi:wa n' iteyo we:..., we:weyak mahyá:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>ke:meh yo:n ke:meh nimitsilia i:n ahmo:lkilit we..., de mochi:wa, sayoh tel we:weyak yeh wa:n i:n tsikitsi:n sah n' i..., i..., iteyo n' ki:sa, n' ixo:chio, n' imetskowyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts577">
