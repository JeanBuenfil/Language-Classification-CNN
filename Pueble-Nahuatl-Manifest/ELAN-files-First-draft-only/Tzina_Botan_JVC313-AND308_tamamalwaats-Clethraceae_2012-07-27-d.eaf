        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts585">
                <ANNOTATION_VALUE>pané: ika, ika *sarta** mochi:wa ne:n ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts586" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>Yehwa yo:n. A:mo kikwah, yo:n a:mo kikwah yo:n, a:mo teh kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>Pos ompa ma:wiltiah sah, porin kwelitah porin...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>Ke:mah. Yo:n, yo:n kwelitah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts602">
                <ANNOTATION_VALUE>im..., yo:n kwelitah porin xaxakachtik, ika kwaltsi:n motakxiliah itech,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449" TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Xaxakachtik wa:n kwaltsi:n moistitohto:kah, yema:nik *por eso** pan..., panki:sah, ma:wiltiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451" TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>Ke:mah, pero... Ke:mah, pero a:mo kikwaliah n...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453" TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts615">
                <ANNOTATION_VALUE>Ke:mah inisti. Yo:n a:mo kikwaliah tei *porque**... Ke:mah.</ANNOTATION_VALUE>
