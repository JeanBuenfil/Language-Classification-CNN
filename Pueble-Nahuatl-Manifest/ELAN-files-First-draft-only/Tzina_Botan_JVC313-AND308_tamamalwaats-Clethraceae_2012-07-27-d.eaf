        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a455" TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts619">
                <ANNOTATION_VALUE>A:mo kikwaliah tei, sayoh kwelitah porin yema:nik ke:meh yo:n xo:no:kowit panki:sah wa:n motohto:ktiw wa:n a:mo me:waltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
