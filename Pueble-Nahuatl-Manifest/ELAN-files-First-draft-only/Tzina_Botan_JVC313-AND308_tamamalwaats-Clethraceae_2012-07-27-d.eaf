        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts769">
                <ANNOTATION_VALUE>N' okwiltsitsí:n ompa panka:kalakih wa:n sepa panki:sah para pa:ntemo:tih.</ANNOTATION_VALUE>
