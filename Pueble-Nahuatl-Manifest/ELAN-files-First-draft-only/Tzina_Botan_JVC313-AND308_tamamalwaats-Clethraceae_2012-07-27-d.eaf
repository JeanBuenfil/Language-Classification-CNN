        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518" TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>No: ompa no: mocha:ntia.</ANNOTATION_VALUE>
