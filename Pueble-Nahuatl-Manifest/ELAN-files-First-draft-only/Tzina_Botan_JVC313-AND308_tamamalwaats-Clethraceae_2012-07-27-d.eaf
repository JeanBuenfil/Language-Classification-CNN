        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499" TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>Yo:n kowtanchomeh nochi itech kowko:mit mochi:wah yo:n, a:mo, a:mo kwoma:pan mota:liah sah, itech kowko:mit mokalakiah, ompa n' incha:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts734">
                <ANNOTATION_VALUE>Neh nikitani ke:meh ne: kowtah ninemini, miakka:n, nikinki:xtia itech kowko:mit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502" TIME_SLOT_REF1="ts735" TIME_SLOT_REF2="ts737">
