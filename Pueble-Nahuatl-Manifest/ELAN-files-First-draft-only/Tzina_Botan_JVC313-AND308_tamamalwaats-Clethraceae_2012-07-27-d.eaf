        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>Se: kita n' ka:mpa ne: itampa te:ntok, yo:n metswe:weyak ne:n,</ANNOTATION_VALUE>
