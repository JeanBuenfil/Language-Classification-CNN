            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512" TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>ompa mo..., kihtiye:ktiah ya n' okwilimeh wa:n ompa moka:wah ya, incha:n ya.</ANNOTATION_VALUE>
