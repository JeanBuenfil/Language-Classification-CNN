                <ANNOTATION_VALUE>Ke:mah, mopihpilowah itech.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458" TIME_SLOT_REF1="ts624" TIME_SLOT_REF2="ts627">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah para moistitohto:kah, takwa:wak n' iisti.</ANNOTATION_VALUE>
