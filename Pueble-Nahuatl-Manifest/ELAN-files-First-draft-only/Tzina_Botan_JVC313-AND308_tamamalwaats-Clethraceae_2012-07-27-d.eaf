        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>Metspata:se:wtiwi:ts para... Wa:n *cuando** panki:sa iwki kichi:wtiw wa:n mopilohtiw no:.</ANNOTATION_VALUE>
