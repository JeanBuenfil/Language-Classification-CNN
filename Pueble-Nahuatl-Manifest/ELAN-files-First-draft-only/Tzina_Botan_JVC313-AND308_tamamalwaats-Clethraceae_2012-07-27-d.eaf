        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484" TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>ompa kem..., ompa kochih ya, ompa incha:n ya mochi:wa.</ANNOTATION_VALUE>
