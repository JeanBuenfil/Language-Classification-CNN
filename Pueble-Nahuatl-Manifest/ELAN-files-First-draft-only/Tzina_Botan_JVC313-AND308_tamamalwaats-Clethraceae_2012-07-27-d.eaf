        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509" TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>Ihtipala:ni wa:n de kwali n' ipankakawyo pos ne:,</ANNOTATION_VALUE>
