        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482" TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>N' i..., i:pa palaktik n' kowit, sayoh kiihtichipa:wah, komohkó:n *más de** kitah kwawa:nah wa:n</ANNOTATION_VALUE>
