        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519" TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>Yo:n a:mo mohka:t, yo:n te:chia mah se: kiki:tski. E:... yeh... Itech kowko:mit mokalakia, ke:mah. Nikita neh no:, nikita itech kowko:mit wa:litstok.</ANNOTATION_VALUE>
