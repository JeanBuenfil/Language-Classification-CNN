        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Wa:n p..., wa:n de wa:ltemowa ya yo:n pe:soh mokeptiwi:ts a n' im..., im..., i..., n' imets, *mo que** ki:xkepa ihkwi:ni a para mo..., tawawa:ntiwi:ts ihkó:n, temo:tiwi:ts ihkó:n.</ANNOTATION_VALUE>
