        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485" TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>Wa:n a:mo kalaki n' a:t *porque** ke:masá: i:xakata..., ihkak n' kowit wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>ka:mpa yo:n ima:..., ima:xal ne: mochi:wa ne:n kowit wa:n ihtikoyo:ni,</ANNOTATION_VALUE>
