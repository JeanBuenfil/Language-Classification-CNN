        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>Chihchayah *hasta** esti wa:n yehwa yo:n kin..., kin..., kima:nelowa:yah.</ANNOTATION_VALUE>
