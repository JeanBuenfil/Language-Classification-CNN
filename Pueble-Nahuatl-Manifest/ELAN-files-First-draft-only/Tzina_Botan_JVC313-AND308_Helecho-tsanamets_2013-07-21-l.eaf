                <ANNOTATION_VALUE>Ke:meskia ihkó:n wetsi ta:lpan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
