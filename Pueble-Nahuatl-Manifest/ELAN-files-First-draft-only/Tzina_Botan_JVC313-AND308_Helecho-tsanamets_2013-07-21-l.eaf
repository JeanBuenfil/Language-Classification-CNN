        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Yehwa yo:n kima:nelowa:yah wa:n okseki ne: xiwtsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Yehwa yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>No: kwaltia ne:n iselo, ne:n inalwayo ne:n yo:n ne:n xiwit de n' okseki yo:n ke:ní:w kiliah, ne:n nikelka:w ke:ní:w ne:n tepe:xi:lo:t. Tepe:xi:lo:t, yo:n no: kwali, no: kwali wa:n kowxiwit i..., kowxiwit i..., iselo, iselo wa:n ne:n inalwayo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>Kisema:nelowah, kiliah ne: tanechiko:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Pos kwaltsi:n no: de ke se: molia wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Pos kinna:miki a kone:meh, ke:meh ekintsi:n no: kwali a ke a:mo, mah a:mo ehkoskia nehjó:n kokolis *porque** pos ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>Ihwa:k a:mo ... A:mo yetoyah *más** tapahtia:nih, ma:ski ya:yah tapah..., tapahti:lo:ya:n, ne: kiniwi:kayah kone:meh pero a:mo kinna:mikia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>*Más, más** oli:nia nehjó:n kokolis, yo:n kokolis telfue:rteh ika te..., kimachilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>*Hasta** seki ika mikiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Pos tein kimatiah kite:mowayah nehjó:n xiwtsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Seki yo:n ixta:wat onkak no: kima:nelowa:yah wa:n yehwa ya ne:n tepe:xi:lo:t, miak nehjó:n ki..., kikwitih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Wa:n kisema:nelowa:yah ya, nochi miak, miak ne:n ki..., ki..., kitayah pero a:mo se: kimati ne:n ... Miak tikmatih wa:n miak a:mo tikmatih pero ke:meh ekintsi:n timomati:ltiah pos ihkó:n se: kichi:was ke:masá: a:mo teh, ke:masá:, *ojalá** mah a:mo teh pasa:ro:skia mah te:kwi i:n kokolis, *hasta** i:n tehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Pero komo teisá: ihkó:n te:chahsi oso se:meh kone:meh oso ... kwali se: kinkwi:li:ti:w nehjó:n a:mo, a:mo teh ... A:mo se: kowati, se: kikwiti sah ne:wi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Se: kite:mo:ti ne:wí:n tepe:yoh, yo:n tsanamets nochi ne..., nochi onkak ne:wí:n ka:mpa tehtepe:yoh, ita:mpa de n' tepe:t miak onkak nehjó:n xiwtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>Yo:n no: ye:ktahtakwa:wak ne:n i..., ikowyo. Tahtakwa:wak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Wa:n yo:n kikwih sayoh ne:n i..., ixiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>Ixiwyotsi:n, ikowyo a:mo no: kikwih ta: pos yo:n ka:mpa se: kite:xi:ma wa:n komohkó:n se: metsiwki, no: se: mometstsohtsopo:ni:s, se: mometstsohtsopo:nia, takwa:wak ikowyo wa:npos yehwa yo:n nochi ki..., kin..., kikonkwiah inalwayo yeh kowxiwnalwat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Ke:masá: kihtowah no: k..., no: kikwiah yo:n koyo:po:lin, koyo:..., koyo:po:lin, ke:ní:w kiliah..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Wa:n pos tama:nelowa:yah nochi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>A:mo, a:mo se: kimati ekintsi:n ne:n ox, ox miak a:mo ... Kimattokeh oso seki a:mo kimatih pero tehwa:n pos de nika:n timonohno:tstokeh pos tikmattokeh katí:n kwali para ne:n topah wa:n para kone:meh ihkó:n moskaltihkeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>Seki yehwa ne:n tikinta:lilia:yah, tikintai:ltia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>nehjó:n pahti semi yo:n tsanamets.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>Sayoh ke nochi ne:n tama:nelo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>A:mo se:sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>Pos no: tak kwaltias ma:ski se:sah, ta: pos de se:sah cha: no:, a:chá: no: kwaltias.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>Pero *más, más** kwaltia de tama:nelo:l, ihkó:n pero ke:meh mosenyo:lchika:wa ya nehjó:n pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>No: mosenyo:lchika:wa ya, no: ke:meskia mosenpale:wia ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>Ke:mah, a:mo se: kimati yo:n. Pos miak, miak pahtsitsi:n onkak sayoh ke a:mo tikmatih ne:n, ne:n ke:meh ne: ke:masá: seki se: kite:xi:ma ne:wí:n tepe:tsi:ntan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>Itsi:ntan tepe:t pero a:mo se: kimati ox pahti, ta: pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Tein tikmattiowih seki tik..., tika:wah mah onka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232" TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>Yo:n pahti, niman se: kihtowa ne: mah tika:waka:n *porque** ne: te:ch..., te:chpahtia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234" TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>se: 'kwiti wa:n mah se: kimana, se:, se: tai, yo:n a:mo teh nikihto:s ke chichi:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>kwaltsi:n sah, pané: a:mo ke:man nikita ne:n i..., ixo:chio, ke:ní:w ox moahkokehketsa *o** ke:ní:w.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Ma:i..., ma:i..., ima:tampa, ompa ki..., ompa kipia. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>Ixwa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>*O** ke:masá: kwali se: kitas ne:wí:n tepe:tsi:ntan, kwali se: nemiti:w wa:n se: ki..., se: kitas ke:niwki, ka:n..., ka:nika xo:chiowa *o** ke:ní:w, ka:nika ima:tampa xo:chiohtok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>Ka:nika kipia iteyo, nochi se: kitas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>Pos nehwa nimono:tsa Anastacio Nicolás Damián, niwa:le:w ne: San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249" TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>A:, we:noh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
