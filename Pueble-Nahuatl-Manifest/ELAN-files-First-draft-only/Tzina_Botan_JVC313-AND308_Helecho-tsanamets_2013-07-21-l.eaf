        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Ompa ta:ki a, o..., ompa panxi:ini a, seki a:mo se: kita *porque** tsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>Pos ke:masá: no: kwaltsi:n se ki..., se: kitas, ke:meh i:n se: nentinemi, ekintsí:n nika:n timonohno:tstokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>Pos kwali, kwali tikitaskeh ke:masá:, ke:niwki nehjó:n, ox kipia iteyo oso ita:kka o...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>*O** ke:ní:w, pos yeh tikmattokeh para yo:n xiwtsi:n pos ki..., kwali no: para pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Para nehjó:n tataxis, ne: ke:man semi nemia nehjó:n mihmikilo:tataxis.</ANNOTATION_VALUE>
