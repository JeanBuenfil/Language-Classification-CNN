        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>Wa:n kinamnilia:yah, kintai:ltia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>Yo:n a:mo chichi:k nehjó:n xiwit.</ANNOTATION_VALUE>
