        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Ke:mah pos neh nikita no: n' tsanamets mochi:wa ka:mpa tehtepe:tah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>ka:mpa tehtepetsi:ntan, tepe:tampa mochi:wa yo:n tsanamets.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Wa:n neli pahti kikwih yo:n xiwtsi:n wa:n, wa:n imetstkowyo tihti:ltik wa:n pané: *alambre** imetskowyo ata</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>wa:n ma:pisi:ltik ne:n xiwtsi:n wa:n ye:kma:kahkanaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>Ma:kahkanaktik wa:n kwaltsi:n mota *porque** kahkanaktik wa:n pisi:ltik ima:ixiwyo, kwaltsi:n mota.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Pero nejó:n i..., iteyo a:mo, a:mo mochi:wa iteyo, a:mo xo:chiowa, *sino que** a:it ke:ní:w mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>Yo:n k..., yon mo..., moxinachowa:cho:wa imahmata:mpa ki:sa ne:... paxi:i:ni mahyá: kohkostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Yo:n i..., pané:, pané: kohkostik pisi:ltik pero pisi:ltik e..., pisi:ltik ne:n itampa kipia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>Pané: kokotsitsí:n, yehwa yo:n i..., yehwa n' iteyo, yo:n ixwa n' ima:..., ima:tampa yo:n, yehwa yo:n tsanamets, pero yo:n *pesma**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>wa:n nochi, nochi m' pesma a:mo, a:mo t..., a:mo xo:chiowa, a:mo..., a:it ke:ní:w mochiwa a:mo xo:chiowa, a:mo..., wa:n a:mo kipia *iracimo**, mopampilowa kemeh pahpata, sanoke ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128" TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Nochi n' pesma nochi kipia ne:n i..., i..., moxinachowa imatampa itech xiwit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>Ima:tampa, ompa kipia pané: i:xtalo ya sah, itech ... Pané: kokotsitsi:n mochi:wa yo:n kohk..., yo:n kohkostik *hasta** kohkostik iekapan *después** tein chika:wak a, tile:wi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
