        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370" TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>tia:yah wa:n tikahsia yeh kwa:lkwitok. Wa:n sayoh yehwa yo:n kihtowa:ya neli ika mah ka:pataka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>A:mo mah se: kimana wa:n mah iwki se: kikwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a372" TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>Wa:n a:mo n'mati, yo:n ke:mah a:mo n..., ke:man n'tahtani ke:ní:w n' kikwa ox ta:a:man *o**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373" TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts713">
                <ANNOTATION_VALUE>no: kichi:lposo:wia ke:meh kantsili:n *porque** pos n' kantsili:n *este**, se: kikwa seki chi:lposo:yoh.</ANNOTATION_VALUE>
