        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>a:mo ke:man nikita ox xo:chiowa, ox teyowa, pané: nochipa nikita ikomekayo sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts483">
                <ANNOTATION_VALUE>Ke:mah *porque** ne:n oksé: no: komekat i:n tikihtowa telwitsyoh, yo:n ye:wa tikto:ka:ytih tekwetahwits,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts484" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>Yo:n tak mochi:wa ma:ski kahfe:ntah sah, pero yo:n ye:k neli ne:n witschachantik ke:meh a:it toni wa:n tihti:ltik achi ata n' iwitsyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>Wa:n ye:k..., ka:mpa ne:n tsi:ne:wtok ye:k neli ne:n chachane:wtok ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>witsti tihti:ltik. Wa:n iwki ke:meh mowila:ntiw iwki kwi:ka yo:n witsti, wa:n ata kipia no: ne:n..., iwki neli n' ke:meh tikihtowa, ke:meh kantsili:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272" TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>Soh *que** ne:n kantsi:li:n pos yeh tehkotiw, moihilpia ika ite:ntso:n itech ne:n kowit wa:n yehwa i:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>tekwetahwits yeh ata ta:lpan sah mahyá: ne: mowi:wila:na pero no: moihilpihtiw ika yehwa yo:n ite:ntson wa:n ye:k te:tech kalaki no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297" TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>Tel witsyoh wa:n ikowyo achi *más** pihpitsa:wak, yo:n no: se: ki:xmati. Pipi:nik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>Wa:n tekwetahwits tiki:xmattok n' ixo:chio, ox no: teyowa. Yo:n ke:mah, a:mo ke:man nikita.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316" TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>Ke:mah *porque** yehwa i:n witsti tikihtowa i:n *este** no: miakia, no: miak n' e:wa, pero ta:lpan ne:n ihtsmoli:ni wa:n neli ahko a:mo, a:mo momahmaxalowa ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>Tein teliwkitik no: n' kantsili:nwa:n yo:n neli n' tikihto:s teh kwali ika se: mokaya:was a:mo n'mati n' teh ox tiki:xmattok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319" TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>seki xiwit kiliah a:xiwke:nkech, yo:n neli telyehwa ne:n kantsili:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>Ke:meh yo:n ahmo:lkilit kihtowa ata no: ka:patah para se: kikwa, a:mo n'mati, nimolwia xa: *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338" TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>xa: *este** teihsá: kipias, teihsá: pahti ne:n yo:n xiwit, yeh ika yo:n yeh nochipa te:ilia:ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339" TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts639">
                <ANNOTATION_VALUE>komo kimanatih mah ka:pataka:n. Ka:patah wa:n ke:mah ika ne:n tein iohpaka:a:yo yehwa ne:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts643">
                <ANNOTATION_VALUE>kikwah. Tehwa:n a:mo ke:man tikwah. A:mo no: nimitskaya:was, yehwa i:n a:xiwke:nkech no:pá:n a:mo ke:man kiteki. I:pa tiowih kowtah wa:n tikitanih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342" TIME_SLOT_REF1="ts645" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>Pero neli nochipa komekat sah no: wa:n no: tehko ahko, ye:k yehwa n' kantsili:n, sayoh i:n nimitsilia se: ki:xmati *porque** pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343" TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>*este** kowyo..., kowyohtenexyoh wa:n ima:y pané: yo:n tehtenexyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>Komo *que este** achi, achi nextik tikitas ne:n, ne: *este** ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>ix..., ixiwyo ompa ne:, mahyá: yo:n wa:lpochi:ntok ne:n koma:pan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346" TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>Wa:n yo:n se: kitemowia no:, wa:n neli kihtowah ne:n ikechtayo wa:n ixiwyo tein tehselik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
