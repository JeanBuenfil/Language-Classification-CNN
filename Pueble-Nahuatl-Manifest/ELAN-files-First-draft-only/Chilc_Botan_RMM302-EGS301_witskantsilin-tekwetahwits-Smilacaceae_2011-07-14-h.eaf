        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391" TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>{Tal vez quiso decir "ximotanekti" que significa "ilusionarse" o tal vez "ximoi:xe:wi" que significa "atreverse"}</ANNOTATION_VALUE>
