        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>*Pues** para toni nimitskaya:was, a:mo ke:man, a:mo ke:man xo:chiowa yo:n, a:mo ke:man se: kitas mah xo:chiowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>Wa:n nió:n no: eliwis moskaltia, mah tikihto:ka:n mah semi telwehkapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307" TIME_SLOT_REF1="ts568" TIME_SLOT_REF2="ts569">
                <ANNOTATION_VALUE>Sanoke moskaltia, mo..., tamela:wa moskaltia sayoh se:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>se: ikowyotsi:n sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts573">
                <ANNOTATION_VALUE>wa:n a:mo xkihto momahma:..., momahma:tia[momahma:ytia]ke:meh ne: witskantsili:n, yo:n moskaltia sayoh ompa sah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>wa:n a:mo no:, a:mo, a:mo tikihto:tih mah mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts576" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>mah mochaya:wa *o** mah momoya:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Yehwa yo:ni, yehwa yo:n, yehwa yo:n neh nimitsilia, no: niman se: ki:xmati yehwa yo:n wits..., witsti *porque**...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts581">
                <ANNOTATION_VALUE>Wa:n a:mo para xte:nteki, teltakwa:wak ke:meh yo:n, ke:meh tepos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314" TIME_SLOT_REF1="ts582" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>ke:meh tepos ta: teltakwa:wak, moihilpia sah, nikilia neh. Mache:teh xikmaga ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>mahyá:, mahyá: mo..., mahyá: kahkotsikwi:naltia sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>Ajá:, ta:lpan. A:mo momaxalo:ti. Kanah. Kanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320" TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>*Pues** nik..., niki:xmat..., niki:xmati yehwa n' witskantsili:n pero ne:n a:xiw..., a:xiwke:nkech, ke:n tikihtowa mono:tsa a:mo, a:mo, a:mo nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts600">
                <ANNOTATION_VALUE>a:chá: ke:mah, xa: nikitani pero a:mo niki..., a:mo n'to:ka:yi:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322" TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts602">
                <ANNOTATION_VALUE>*Tal ve..., a lo mejor** xa: nikitani newí:n ka:mpa i..., ka:mpa onkak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323" TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>tikmatis ke:meh i:n tehwa:n timokaya:wah ke:meh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324" TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>tikihtowah tehwa:n *pues este** yehwa ya n' kantsili:n *o** yehwa ya witstololoh, ke:meh a:mo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>seki [...], seki a:mo se: kito:ka:yi:xmati kwali,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>pos neh a:mo wel nimitsilwi:ti *que**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327" TIME_SLOT_REF1="ts611" TIME_SLOT_REF2="ts612">
                <ANNOTATION_VALUE>keni:w mono:tsa yo:n kow..., kowtsí:n, yo:n komekatsí:n wa:n nió:n no: a:mo nikye:ki:xmati, para ton nimitskaya:wati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>¿Wa:n yo:n para toni servi:rowa, teh tikita yo:n, para toni kwaltia?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>I:n, i:n *este** no: we:lik n' kihtowah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330" TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>ta, tehwa:n te:chi:ilia:yah semi iwa:n tia:yah kowtah wehka:w, yo:n ta:tahtsi:n Carlos katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>Yehwa n' kihtowa:ya. Yeh nochipa *cuando** tia:yah ompa ne: Ista:ka:kopa, yeh kitekia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332" TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>*Porque** ye:kyehwa neli ne:n kantsili:n, sayoh i:n se: ki:xmati *porque** ne:n a:xiwke:nkech,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>n' ikowyo wa:n ixiwyo, mahyá: yo:n achi tehtenexyoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334" TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts626">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n kihtowa:ya *que** we:lik no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335" TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts629">
                <ANNOTATION_VALUE>soh kit..., yeh kihtowaya *que** komo se: kikwa mah ka:pataka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Ajá, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341" TIME_SLOT_REF1="ts641" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>Ajá. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts659">
                <ANNOTATION_VALUE>A:, no: iwkitik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>Ke:mah pero neh a:mo wel nimitsilia, neh soh nimitstahtania, nimitstahtanilia *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>a:mo ke:mah tikwa *pues**, *como que** no: mitsilihkeh sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>Yehwa yo:n tepitsi:n nikillia a:mo kwaltsi:n, *porque** mah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts667">
                <ANNOTATION_VALUE>te:chili:kan sah wa:n mah a:mo ke:man se: kimahse:wa wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353" TIME_SLOT_REF1="ts668" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>ta:ká:n i:pa, ta:ká:n i:pa sayoh te:kahkaya:wa sah n' tokni:w n' a:ki:n mitsilwih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354" TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>teh no: ximotahne:wi, wa:n xikteki wa:n xikwa ya, entó:s mah wa:l..., *después** mah mits...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355" TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts675">
                <ANNOTATION_VALUE>tikita ya *a veces** a:mo poliwi mah teihsá: mah mitswa:lkokoliskwi:lti *o** teihsá: mah mitschi:wili *mal** mah mitschi:wili wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356" TIME_SLOT_REF1="ts676" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>ke:meh a:mo se: ki:xmati a:mo eliwis mah se: mo..., mah se: kimahse:wa, *porque** neli yo:n ke:man, a:mo ke:man nik..., a:mo ke:man nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>a:mo niki:xmati, ma:..., *tal vez** tak, xa: ke:mah nikitstinemi pero a:mo ke:man nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358" TIME_SLOT_REF1="ts680" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>a:mo ke:man nik...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts683">
                <ANNOTATION_VALUE>nik..., nikita ihkó:n mah tikihto:ka:n mah tiktekika:n, mah tikwa:..., mah tikwa:ka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>Katí:n ke:mah i:pa tikmahse:wah nimitsilia yehwa ne: witstololoh,  yo:n a:mo wel nimitsili:ti *que** a:mo *porque** yo:n tehwa:n totapalo:l a ne: ka:mpa ne:..., ka:mpa tinemih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374" TIME_SLOT_REF1="ts714" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>Ke:mah. Ke:mah neli yo:n iwki se: kikwa, se: kimahse:wa chi:lposo:n, komo a:mo, komo a:mo miak pos neli se: kikoma:lixka oso se: kitikoixka wa:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375" TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>se: kimahse:wa. Yo:n no: kwaltsi:n we:lik neli nimitsilia neh a:mo impo:rtah semi *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>pos yo:n tikmat..., tikahsika:mattokeh ya neli *que** kwali se: kimahse:wa ke:meh yeski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377" TIME_SLOT_REF1="ts720" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>Pero neli n' ke:meh nimitsilia neh yo:n a:xiwke:nkech tikihtowa a:mo, a:mo niki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts722" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>a:mo niki:xmati pero a:mo nimitskaya:wati, a:mo niki:xmati neh. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>Ke:mah i:n tatsi:ntokalis neh nimitstahtanilia, *este** nikneki nikahsika:matis *porque** tikmatis *este**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts726" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>para ihkó:n no: ti..., tik..., tikmatiskeh n' tehwa:n *que** toni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381" TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>kati:yeh n' komekatsí:n we:lik, kati:yeh n' a:mo we:lik. Neh nimitsilia niki:xmattok *solamente** yehwa sah witskantsili:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts731">
                <ANNOTATION_VALUE>Wa:n ne:chtapohpolwi i:pa yehwa sah neh nimits...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts733">
                <ANNOTATION_VALUE>nimits..., nimitsilwia. Neh nimono:tsa niRubén Macario,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts735">
                <ANNOTATION_VALUE>ni..., nikayo:t nika:n Chi:lkowtah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385" TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>nika:n nipowi, nika:n San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
