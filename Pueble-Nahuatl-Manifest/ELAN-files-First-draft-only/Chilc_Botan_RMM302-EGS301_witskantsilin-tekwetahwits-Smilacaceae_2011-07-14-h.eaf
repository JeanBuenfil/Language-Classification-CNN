        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>{esta forma de pluralizar es rara, lo más común sería taskaltia:nih}</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
