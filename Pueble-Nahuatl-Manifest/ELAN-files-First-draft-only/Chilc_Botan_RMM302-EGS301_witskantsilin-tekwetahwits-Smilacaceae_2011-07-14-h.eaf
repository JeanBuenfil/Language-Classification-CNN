        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>A:mo n'mati ke:n tiki:xmati n' teh, neh niki:xmattok wits..., witstololoh. Kiliah witskantsili:n, witstololoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
