                <ANNOTATION_VALUE>we:lik. Wa:n no: iwki, no: kipia no:, no: te:ntsoneh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>A:mo i:n a:xiwke:nkech neli we:lik *porque** yo:n ta:tahtsi:n katka nochipa n' tia:yah kowtah yeh kwa:lma:ma:ya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
