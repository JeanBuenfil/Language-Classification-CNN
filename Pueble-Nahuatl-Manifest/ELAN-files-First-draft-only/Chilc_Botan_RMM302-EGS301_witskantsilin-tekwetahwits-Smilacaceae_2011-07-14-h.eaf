        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>kwa:lma:ma, pero tak *este**,</ANNOTATION_VALUE>
