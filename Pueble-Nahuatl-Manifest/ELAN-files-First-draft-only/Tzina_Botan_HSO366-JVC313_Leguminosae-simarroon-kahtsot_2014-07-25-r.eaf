        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107" TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>Tein kwahkwali se: kikowa wa:n kwaltsi:n, yo:n yema:nik pero yo:n wa:n ne: pos tahtakwaktik, yo:n takwaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>A:mo kwaltia tei yo:n i:pa sayoh, i:pa sayoh, ipa xiwit sah ke:meh *simarrón, i:pa xiwit sah se: kichkwa sayoh ke:meh i:n se: kita wa:n ke:masá: pos se: maya:na se: kikwas, pero *más** a:mo se:, a:mo se kikwi, a:mo se: kichkwa yo:n am..., wa:n a:mo monamaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>A:mo nikihto:s nikwiti wa:n namakati, yo:n a:mo kikowaskeh ta: pos ka:n kwahkwali. Ka:n se: ki:xmati, ka:n se: ki:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Pos neh nimolwia ke eski kito:kayah n' ta:tahmeh wehka:w *porque** ihwa:k a:mo tatsiwiah n' ta:tahmeh, kito:kayah ihwak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>de kito:kayah pos yehwa yo:n yekintsi:n pos wehka:wak pos *simarró:n** mokepak a, ke:mah mokepak ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Ke:meh yo:n sempowalxo:chit ka:mpa kitepe:wah sempowalxo:chit,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>e..., moka:wa *semilla** pero mo..., mokepa ya *después**, nochi, nochi nakastapal mochi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>no: iwki a i:n kamoh tikte:ne:wtokeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>No: iwki a, mm, ke:meh teyowa pos ika yo:n *como siempre kiseguirowa** onkak yo:n *semilla**, yo:n teyowa, ompa moa:wilowa n' iteyo, a:mo a:kin kiteki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>Momiakilia ya, momakilia, mopatatiw ya, ke:mah ihkó:ni yo:n kome..., yo:n kamoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Pos pané: yehwa sah. Yehwa sah niki:xmattok yo:n ka:n teh *más** ka:n *servi:rowa** tei i:pa se:..., i:pa sayoh komekat sah wa:n pos a:mo *servi:rowa porque** a:mo para se: monamakili:s wa:n para se: kikwas a:mo semi *porque** pos teltahtakwaktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>Kwali se: kikwa neli pero mah se: kitapa:na ika *machete**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>wa:n tayo:la:yo se: kikwa pero ipanko a:mo wel se kikwa *porque** nochi, pané: nochi nalwat kipanke:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Takwa:wak semi, se: kikwa sayoh iihtikyo sah komo se: kineki se: kikwas, ke:mah, yehwa sah yo:n nikmattok neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Pos neh nimono:tsa niErnesto Vázquez niwa:le:wak San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>A *bueno** tasohkama:tik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
