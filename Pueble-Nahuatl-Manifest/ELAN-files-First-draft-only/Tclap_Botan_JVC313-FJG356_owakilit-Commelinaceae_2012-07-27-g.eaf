        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Yo:n *que** a:mo kinekiah mah se: kikwi *porque** yo:n a:mo kit *porque** yo:n pa..., yo:n pané: n..., yo:n chika:wak *como que** mahyá: chichi:k, *mo que** chichi:k a yo:n ka:mpa chika:wak mahyá: chichi:k ne:n i...,</ANNOTATION_VALUE>
