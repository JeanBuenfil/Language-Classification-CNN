        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>wa:n neli pos n' tokone:wa:n mo..., kachi, kachi a:mo weliskeh komo a:mo tikimachtiah mah tahto:ka:n kwali, tein mela:wak tah...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>tahto:l, senki:s tein totahto:l. Ke:mah, nikita ihkó:n miakeh ta:tahmeh a:mo kihtowah ok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>A:mo, a:mo tahtowah kwali ok, nochi tahtowah kinelowah ya, *hasta** yo:n tio:tahto:l.</ANNOTATION_VALUE>
