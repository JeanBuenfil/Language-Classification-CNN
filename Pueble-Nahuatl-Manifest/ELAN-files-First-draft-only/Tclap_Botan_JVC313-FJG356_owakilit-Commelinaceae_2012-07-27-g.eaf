        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396" TIME_SLOT_REF1="ts662" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>tiknelowah iwa:n koyo:tahto:l n' totahto:l tehwa:n wa:n</ANNOTATION_VALUE>
