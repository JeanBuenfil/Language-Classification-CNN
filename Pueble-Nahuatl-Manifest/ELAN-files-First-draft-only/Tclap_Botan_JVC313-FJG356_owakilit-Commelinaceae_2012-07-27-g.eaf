        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts655" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>pos ka:sá: ika ke:meh i:n tamachtiah nejí:n kone:meh kinine:xtiliah ok ke:ní:w sake:ra para tahto:skeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394" TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>*porque**ekintsi:n nochi tikelka:wtiwih *hasta** totahto:l ti..., *hasta** tehwa:n ne:n ti..., tita:tahmeh ya timote:mpolowah n' totahto:l, a:mo nochi tikwih ok, tik..., tikoyo:tahto:snekih ya wa:n</ANNOTATION_VALUE>
