        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383" TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Kanah ok, a:..., ke:meh yo:n istatet a:mo ki:xmatih ok m' pi:pilmeh toni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
