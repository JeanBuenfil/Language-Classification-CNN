        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>tik..., tikwa:yah *sólo** nejó:n kil..., *sólo nejó:n ki...,</ANNOTATION_VALUE>
