                <ANNOTATION_VALUE>*Pues** yo:n nejó:n neh nik..., neh nikita nejó:n ihkó:n, ihkó:n, nehyo:n kiltsí:n kiliah owakiltsí:n *que** ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
