        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts621">
                <ANNOTATION_VALUE>Ke:mah, yehwa ika. Ihkó:n t..., ihkó:n ttakwa:yah n' achto, pané: a:mo moi:xmatia yo:n istat, istat *polvo** ekintsi:n.</ANNOTATION_VALUE>
