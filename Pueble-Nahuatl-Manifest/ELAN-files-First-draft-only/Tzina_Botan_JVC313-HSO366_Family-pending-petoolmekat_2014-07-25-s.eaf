        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>a:ksá: kichi:wa tahpe:wal k' yehwa no: ki..., kikwia, ekintsi:n nikita kikwih n' tahpe:wal *alambre** koma:mo *plástico**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
