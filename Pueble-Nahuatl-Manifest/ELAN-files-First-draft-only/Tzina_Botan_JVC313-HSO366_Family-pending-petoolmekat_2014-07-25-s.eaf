                <ANNOTATION_VALUE>pero yo:n komekat a:mo, a:mo koto:ni *porque** kipia n' taihtik miak ne: mahyá: tahkotsitsi:n, mahyá: yo:n *pita**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>iihtik yeh ika chika:wak, ika kipalewia wa:n a:mo koto:ni, xama:ni pero a:mo koto:ni yo:n.</ANNOTATION_VALUE>
