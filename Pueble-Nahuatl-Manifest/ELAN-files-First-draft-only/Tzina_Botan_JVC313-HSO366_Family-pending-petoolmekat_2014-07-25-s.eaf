        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>N' *solo** tehkoskia ahko nimolia xa: xo:chiowa seki ke:meh yo:n tata:wikmekat,</ANNOTATION_VALUE>
