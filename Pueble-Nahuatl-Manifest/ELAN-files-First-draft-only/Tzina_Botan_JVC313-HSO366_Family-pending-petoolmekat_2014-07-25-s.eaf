            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts91">
                <ANNOTATION_VALUE>ke:mah, kwaltsi:n [ika se: tawi:pana], taxi:kowa yo:n, yo:n a:mo koto:ni ke:meh okseki komekat, ke:meh te:sakamekat koto:ni,</ANNOTATION_VALUE>
