        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>onkak seki ke:meh i:n tehwa:n maski tita:tahmeh ya pero a:mo t'matih ke:ní:w titalpi:skeh ika komekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>ke:mah onk..., wa:n tionkakeh tiwelih titalpiah maski *tizohzonsitos** ihkó:n pero kwamekat kwali tikmatih ke:ní:w se: kilpi:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Ke:mah, yo:n tein takwa:wak n' komekat tein ke:meh yo:n tata:wikmekat, tein toma:wak,</ANNOTATION_VALUE>
