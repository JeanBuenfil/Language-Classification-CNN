        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts153">
                <ANNOTATION_VALUE>No:, nochi kikwiah yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Nochi kikwiah, n' ihwak n' komekat semi ki..., *más** kite:mowayah n' komekat n' ta:tahmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>*porque** a:mo kikwiah *clavos** ne: n' ke:meh ekintsi:n onkak *clavos** tik..., titatsiwinih ya, t'tatsiwiliah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>para t'te:mo:ti:wih n' komekat wa:n *a parte** a:mo wel titawi:pa:nah tehwa:n ekintsi:n, a:mo tiki:xmatih ke:ní:w se: tawi:pa:nas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Komo titalpiah tohtomi sah *porque** a:mo t' matiliah ke:ní:w titawi:pa:naskeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>yo:n moneki no: tawi:pa:na a:kin kimatilia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>N' ta:tahmeh kwali tawi:pa:nayah *porque** pos yehwa n' inchiwalis katka wa:n</ANNOTATION_VALUE>
