        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>se: kita xo:chiowa *porque** mo..., panki:sa itech kowit mo..., moma:malakochohtiw iwki yewaltik in kowit ihkó:n,</ANNOTATION_VALUE>
