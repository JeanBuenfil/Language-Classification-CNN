                <ANNOTATION_VALUE>xa: mo..., xa: momiakilia itech kamoh oso xo:chit a:mo ke:man nikita yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>A:mo ke:man nikita, pero nochi ta:lpan mowila:na.</ANNOTATION_VALUE>
