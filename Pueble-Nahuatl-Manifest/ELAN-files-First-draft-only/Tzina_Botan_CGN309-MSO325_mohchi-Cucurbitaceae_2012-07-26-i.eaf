        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>Wa:n seki tsikitstsi:n. Ke:mah. Ke:mah, ke:man ta: n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>Ke:mah neli, ta: n'mattok neli tikwiah neli tein yo:n ye:kwehwei pos komo yo:n tein ye:kte:nkoya:wak n' tso:tsokol yehwa n' kina:mikis wa:n tein yo:n te:nkopitstik n' tso:tsokol pos no: tein tsitsikitsi:n. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Ke:mah, ta: seki mochi:wa no: ye:kwehwei, ke:mah, ta: mochi:wah neli wehwei:n seki.</ANNOTATION_VALUE>
