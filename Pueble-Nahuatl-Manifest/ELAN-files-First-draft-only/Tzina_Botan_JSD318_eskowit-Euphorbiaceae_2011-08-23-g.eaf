        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>wa:n pe:wa kimali:nayah, mochi:wa tamali:n,</ANNOTATION_VALUE>
