        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>wa:n ika yo:ni yehwa *kiteje:rowa:yah** ihkó:n kihilpiah, kihilpiah,</ANNOTATION_VALUE>
