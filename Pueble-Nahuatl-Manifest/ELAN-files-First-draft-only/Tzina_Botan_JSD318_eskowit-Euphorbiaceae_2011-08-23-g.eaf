        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>onkak no:ya:n, itech kahfeta:lmeh onkak eskowit.</ANNOTATION_VALUE>
