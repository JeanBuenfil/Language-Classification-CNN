    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Amelia Domínguez Alcántara" TIER_ID="Amelia Domínguez Alcántara">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>A:xka:n na:nah nika:n, nika:n sepa timosenahsikoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>Ne: nikitstok i:n xiwit kiliah nexokoli:lpah xa: tikpati ne: ox pahti oso, oso xa: kikwah tapialmeh, n'neki xine:chtapowi *porque** neh nikita mahyá: nochipa xiwit sah pero kihtowah seki ke pahti, a:mo n'mati toni kipahtia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Wa:n ne: tikihtowa tein se:, se: kimolo:ntia, tikihtowa komo se: tai, mah se: kimolo:nti oso tama:xakwalo:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Ton achi taki:tskil se: kikwi wa:n ton achi n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>Sikie:ra se: mahtak kechti wa:n a:tsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Mah tsokowa:ki oso mah mo:molo:ni sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>Aha:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>Ke:mah, ne: pos neli a:mo nikmatia yo:n komohkó:n yo:n neli pahti wa:n neh nikita nochipa, ekintsi:n nikitstok nochipa, we:noh, nochipa nikita xiwit sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Ke:niwki iteyotsi:n oso, oso teyowa *o** ke:niwki wa:n ixo:chio.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>Wa:n yo:n xiwtsi:n no: kikwah tapialmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76" TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>Wa:n i:n kito:kah oso ixwa sah, mochi:wa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>Pos pané: yehwa sah, neh a:mo ne:, a:mo nikmati, neh i:pa a:mo nik..., niki:ita sah i:n xiwit pero a:mo nikmati ox pahti wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Ke:mah, pos telmiak tasohka:matik tine:chyo:kmela:w ne: ne:chilwi moto:ka:i, ta:ká:n teisá: sepa nikneki nikmatis nimi..., para nimitste:mos wa:n ka:ni tiwa:le:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Pos neh no:to:ka:i AmeliaDomínguez Alcántara wa:n niwa:le:w ompa ne: Xaltipan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Celina González Nazario" TIER_ID="Celina González Nazario">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>A: yo:n xiwtsi:n, yo:n semi pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>Semi pahti yo:n xiwtsi:n, komohkó:n yo:n nehjó:n se: wetsik wa:n se: nehjó:n tankwa:xoxowia, ata yo:n kiliah se: mora:dohtia, se: xoxowia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>Yehwa ya yo:n kikwe:chowah ika tepitsi:n istat, a:mo miak, *porque** kihtowah no: te..., teiktilia se: io:miyo,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>entó:s a:mo kwaltia mah te:ta:lili:ka:n semi ika istat, sem..., mah iwki sah kachi kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>Ika ne: [yeh]wa ne: se: kwe:chowa wa:n ika tepitsi:n refi:noh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29" TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>wa:n mah totoktsi:n, mah se: kita:lili ka:mpa te:kokoh wa:n pahti ika yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Wa:n no: semi kwali nehjó:n se: tai,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>se: tai ke:meh yo:n se: mogolpea:rowa, se: wetsiti ata, se: mopoxtamo:ta wa:n telte:kokoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>wa:n te:na:miki yehwa yo:n xiwtsi:n mah se: kima:mana, mah se: tai.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>Wa:n semi no: kwali yehwa ya ne: yo:n ta:tahtsi:n kiliah Lucio Flores</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>yeh kisentilia yo:n xiwtsi:n miak wa:n ka:pachowa ika *aceite**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>wehka:wa a:pachiwtok wa:n ke:mah para ne: kiboteyahkehketsa, kwaltsi:n xoxoktsi:n moka:wa yo:n pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Wa:n kiwi:katinemi semi, ka:mpa yo:n ihkó:n tapahpacho:ti ke:meh yo:n wetsih mo..., mokelo:niah kilwiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>yehwa yo:n kohohsah ompa wa:n pos kina:miki, kina:miki yo:n pahtsi:n wa:n onkak miak pahti, ta: yo:n kiliah ata yo:n *cola de caballo**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38" TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>se: *viaje** neh nimoma:wehwelohka, a:mo ne:chna:mik yehwa yo:n nexokoli:lpah takwe:chol,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>yehwa ya yo:n *cola de caballo** kilwiah ne:chkwe:cholihkeh wa:n ika tepitsi:n istat wa:n ika ne:chma:pi:kkeh wa:n yehwa ya neh n'matik ne:chpahtih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Yehwa yo:n *cola de caballo, porque** i:n nexokol..., nexokoli:pah ne:chta:lilihkah pero pané: a:mo yeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>pero pos no: semi kwali pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Yehwa yo:n mah se: ta:tai komohkó:n te:kohkoh ne: se: ihtik, ke:meh yo:n kihtowah se: mogolpea:rowa, se: i:xakawetsi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>A:mo, se: kimolo:ntia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Se: kimolo:ntia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>Se: olo:chtsi:n, se: olo:chtsi:n, ihkwi:ni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Ke:mah wa:n ... Ke:mah, mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>A:tsi:n sikie:ra se:, de se: *litro**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Pos onkak seki kitsokowa:tsah, taih sepa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Pero seki kimanah tai:tokeh, ke:man a:mikih yehwa taih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>ka..., ke:meh i:n tepitsi:n a:mikitih, kwa:lkwitih wa:n yehwa taih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Ke:mah wa:n onkak seki kitsokomanah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>Wa:n tai:tih sayoh tsikitsi:n ya sah pero neh nimolia kachi kwali ke:meh yo:n se: tai:tok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58" TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>ka..., ke:..., ke:man se: a:mikis mah yehwa se: momakato ika tahko *taza**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>Nehjó:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>Pos iteyotsi:n a:mo nikitstok pero ixo:chiotsi:n no: poso:ni kwaltsi:n, kapotsitsi:n mochi:wa ke:meh yo:n chi:ltekpin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>wa:n ke:mah poso:niti a *ye:krositas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Rositas** yo:n xo:chitsí:n wa:n iteyotsi:n a:mo niki:xmati</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>pero yehwa ya xi:ni sepa wa:n sepa ompa ixwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Ke:mah, semi telonkak yo:n xiwtsi:n ke:man ye:kseseltik pos kwaltsi:n se: ki..., kikwi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>komohkó:n ka:sá: ika te:kokoh pos yehwa ya neli se: kwe:chowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>Mm wa:n komo ika refi:noh kwaltsi:nika se: kimolo:ntia wa:n yehwa ya ika se: mometstahta:lilia ka:mpa ika te:kokoh, se: ima:ko, ka:nima eski.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>Yehwa yo:n se: kwe:chowa wa:n yehwa ne: se: mota:lilia ika ne:n nehjó:n refi:noh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>wa:n ika a:mat se: kipi:ki iwa:n ya wa:n tilmah se: kilpia para a:mo wetsis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>Wa:n tein te:na:miki yehwa ya yo:n ye:ktamanaltia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>a:mo xoxoktik ok, tamanaltik mochi:wa, ke:mah, yehwa yo:ni te:na:miki pahtsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>Pané: a:mo kikwah, a:mo, *porque** ka:mpa ihkak ompa ihkak *hasta** ompa wa:ki,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>ke:mah, yehwa yo:n xiwtsi:n a:mo n'mati ox xahxakachtik *o** ke:yeh *o** i:pa a:mo intakwal tapialtsitsi:n *porque** a:mo kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>Ixwa sah, ixwa sah, ka:mpa eski yo:n, ihkas yo:n xiwtsi:n wa:n kwo..., ixwas sepa de wa:ki, xi:ni iteyo se..., sepa ompa ixwa, *más** mo..., momiakilia ya, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79" TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>A:mo, ta: semi pahti.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Pos a:mo teisá:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Ke:mah, pos neh nimono:tsa niCelina Gonzalez Nazario, niwa:le:w San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
