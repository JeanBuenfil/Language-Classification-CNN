            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>Ka:n tehsá:, ka:..., *como que** a:mo ke:meh yo:n *morralmeh** ke:meh ne: kinchihchi:wah mahma:yehkeh, a:mo, sano ne:,</ANNOTATION_VALUE>
