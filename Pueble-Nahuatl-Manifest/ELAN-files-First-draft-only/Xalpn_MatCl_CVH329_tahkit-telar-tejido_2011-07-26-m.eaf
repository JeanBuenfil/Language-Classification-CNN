        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380" TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>I:pa para ma:mal oso palte:l.</ANNOTATION_VALUE>
