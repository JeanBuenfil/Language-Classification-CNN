        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>ki..., ki..., i:pa *carpintería** kichihchi:wah i:pa n' kowtsí:n,</ANNOTATION_VALUE>
