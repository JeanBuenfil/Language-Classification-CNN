            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a438" TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>A:mo moolo:cho:s, wa:n komo a:mo kipiya mo...., kipia de moolo:cho:s *porque** a:mo teh kipale:wia n' tani.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439" TIME_SLOT_REF1="ts795" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>Nochi iwki sah, nochi iwki sah, nochi se: sah n' xi:yo:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts800" TIME_SLOT_REF2="ts801">
