    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Eleuterio Gorostiza Salazar" TIER_ID="Eleuterio Gorostiza Salazar">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216" TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>A:man ne:, nochi ne: yo:n kowtsitsí:n tein teh tikinkwi ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>tikilia ohtamimil,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>neli ohtat ne:n tikwi *o** i:pa ihkwí:n sah mono:tsa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>¿Ka:nachi ne:n tikwi n' ohtamimil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>¿E:yi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244" TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>A:man, ne:n a:kasolo:ni, ¿neli a:kat *o** i:pa ito:ka:y sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>A:man ne:n, ti..., tikihtowa no: ne:n tso:tsopa:smeh, ¿yeh ton kowyo ne:n tikwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251" TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>¿Wa:n yo:n ka:nachi n' tikinkwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>Wa:n ihwa:k tima:tami a, ke:ní:w ne:n tik..., para a:mo wehweliwi ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257" TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>tein tikchihchi:w a, tiktehteki, tikte:nihtsoma oso ke:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>komohkó:n ne: tikchihchi:wah *como que** mah tikihto:ka:n ke:meh eskia yo:n se: ma:mal ika weyak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts391" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Wa:n ihwa:k tima:tamisepa tikta:lilia n' ite:ntasa:lo *o** iwki moka:wa ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Wa:n ta:ká:n, *bueno** yo:n tikihtowa *que** tika:wilia ne:n *como que** n' ie:kapayo para nmolia tak sa:te:pan tikte:nchi:wa komohkó:n ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>¿Wa:n tikte:nchi:wa ika moma:wa:n ya?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>¿Wa:n yo:n no: tikpo:wtiw?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287" TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>*Bueno** yo:n tikihtowa komo t'chihchi:wa ma:mal, ¿wa:n komo t'chihchi:wasneki wi:pil?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>¿Wa:n xi:yo:kowit, ton kowyo n'tikwi?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>¿Wa:n ne:n pakiyo:kowit tikilia, yeh ton kowyo?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313" TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>Wa:n yo:n teh tikilia ikpat, a:mo yehwa n' *hilo** no: taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315" TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>¿Ke:niwki ne:n ikpat?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325" TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>Wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>teh a:mo ke:man tikitak ox *este** ihwa:k teh timoskaltih ox tatsa:wayah ok na:nomeh yo:n kihtowah tatsa:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333" TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>A:mo no: tikmati ke:ní:w yo:n tatsa:wayah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336" TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts560">
