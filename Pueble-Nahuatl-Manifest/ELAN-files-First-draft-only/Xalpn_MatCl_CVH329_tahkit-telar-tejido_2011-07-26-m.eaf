        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>*como que** yetok sah n' ka:mpa kichihchi:wah, a:mo eliwis.</ANNOTATION_VALUE>
