        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>E:yi, e:yi tako:tsí:n kipia ya ne: *hilo**,</ANNOTATION_VALUE>
