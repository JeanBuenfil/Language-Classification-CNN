        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Ke:mah, wa:n a:ka:t nikta:lilih a, ka:mpa yekinikatsi:n nipe:wak,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>nikchihchi:w se: mahpiltsi:n ompa nikta:lilih a n' a:kat, teha:n tikilwiyah tika:kasoh.</ANNOTATION_VALUE>
