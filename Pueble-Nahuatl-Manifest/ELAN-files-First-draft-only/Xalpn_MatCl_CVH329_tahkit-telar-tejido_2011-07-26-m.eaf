        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223" TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>pos a:mo x..., a:mo tikmatih ton kowyo.</ANNOTATION_VALUE>
