        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427" TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts767">
                <ANNOTATION_VALUE>Ne:, o:me sah. Yeh a:mo kwi:ka miak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428" TIME_SLOT_REF1="ts768" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Ke:meh se:tsi:n xi:yo:t, o:me sah n' tso:tsopa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430" TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>E:..., i:pa e:yi, *porque** o:me ika t'tetsi:lohtiya:s wa:n se: yetos tatsontan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts781">
                <ANNOTATION_VALUE>No:. No: kipiyas n' ia:kayo *porque** ne:, komo a:mo moolo:chowa n' *hilo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433" TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>Wa:n kisa:s ch..., *como que** ololte:ntiá:s, a:mo ki:sas *parejo**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts785">
                <ANNOTATION_VALUE>Ta: n' a:kat ika se: kita:liliya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435" TIME_SLOT_REF1="ts786" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>para mo..., *mo que** ke:meh tikpe:walti:tiw,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts788" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>ke:meh pata:wak n' ikwo..., ne: itsontan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts791">
