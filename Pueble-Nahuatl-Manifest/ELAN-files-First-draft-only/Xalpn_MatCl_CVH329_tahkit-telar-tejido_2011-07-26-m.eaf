        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Ke:mah ne: nik..., ne: nopaki:yo:kow nikpia ya, kipia n' *hilo**.</ANNOTATION_VALUE>
