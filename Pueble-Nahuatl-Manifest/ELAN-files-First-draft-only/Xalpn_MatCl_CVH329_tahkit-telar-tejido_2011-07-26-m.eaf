        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>wa:n se: ko:mit we:i ika kimankeh,</ANNOTATION_VALUE>
