        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236" TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>yetok a i:n, i:n ihkwí:n yetok n' ohtamimil, ihkwí:n.</ANNOTATION_VALUE>
