        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>kwali ki..., ki..., ke:meh i:n ka:mpa tikowah, ka:mpa ne:,</ANNOTATION_VALUE>
