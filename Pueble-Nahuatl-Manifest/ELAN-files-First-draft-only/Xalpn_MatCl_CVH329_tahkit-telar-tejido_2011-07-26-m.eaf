        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360" TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>pero miyak, ihkwí:n wehkapan ne:n *bolsa** ika kwa:likeh,</ANNOTATION_VALUE>
