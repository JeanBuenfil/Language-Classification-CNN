        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>wa:n kipia e:yi a n' tso:tsopa:s.</ANNOTATION_VALUE>
