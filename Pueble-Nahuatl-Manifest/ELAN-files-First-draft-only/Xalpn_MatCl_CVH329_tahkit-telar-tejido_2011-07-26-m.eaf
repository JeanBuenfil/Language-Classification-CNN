        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418" TIME_SLOT_REF1="ts744" TIME_SLOT_REF2="ts745">
                <ANNOTATION_VALUE>Ke:meh  neh nisiwa:montikeh wa:n yetok a nopili,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts746" TIME_SLOT_REF2="ts747">
