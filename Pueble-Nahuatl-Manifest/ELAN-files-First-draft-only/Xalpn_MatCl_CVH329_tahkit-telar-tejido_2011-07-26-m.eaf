        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379" TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts653">
                <ANNOTATION_VALUE>A:mo ke:meh a:man tein weli tasa:ltsí:n ika titama:mah.</ANNOTATION_VALUE>
