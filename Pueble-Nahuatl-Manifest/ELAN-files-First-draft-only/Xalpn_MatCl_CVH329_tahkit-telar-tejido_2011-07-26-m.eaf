        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts804">
                <ANNOTATION_VALUE>E:yi n' ohtamimil *porque** i:pa kipiya de ika motetsi:lohtiya:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts810">
                <ANNOTATION_VALUE>A:, n' ta: nochi a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
