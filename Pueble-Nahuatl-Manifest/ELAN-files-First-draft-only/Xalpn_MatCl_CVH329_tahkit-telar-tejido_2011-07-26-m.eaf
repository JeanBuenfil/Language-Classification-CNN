        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>Se: sah.</ANNOTATION_VALUE>
