        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>Komo nikneki oho:me motohtokas oso ehe:yi,</ANNOTATION_VALUE>
