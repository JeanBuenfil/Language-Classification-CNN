        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363" TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>Yeh ka nikitaka se: yowal kimolo:ntihtokeh, kimolo:ntihtokeh,</ANNOTATION_VALUE>
