        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>*Hasta** ta:tomeh katka kinchihchi:wilia:yah ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>intomi:ne:walo:ni, ihkwi:ntsitsi:n, pa:palte:lkone:meh, tsitsikitsitsi:n, ika ke:wah n' tomi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts703">
                <ANNOTATION_VALUE>Ka:ni ke:meh a:man, ka:n t'piyah. A:man *nylon bolsa**, komo t'piaskiah no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403" TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>Tapaloh, ta: no: *mismo** yeha n' tein we:itasa:lpalte:l kichihchi:wah, *mismo hilo**.</ANNOTATION_VALUE>
