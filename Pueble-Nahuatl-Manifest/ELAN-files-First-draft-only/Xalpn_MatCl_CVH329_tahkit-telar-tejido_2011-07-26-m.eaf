        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts756" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>Ma:mal se: sah. Ta: miyak xi:yo:t kwi:ka ke:meh i:n towi:pil.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424" TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>Pero yeh ma:mal komo sepa tima:tan tikta:lilih se:, yeha ya.</ANNOTATION_VALUE>
