        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378" TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>*Porque** ne: ke:man timoskaltihkeh nochi ma:mal kikwiyah.</ANNOTATION_VALUE>
