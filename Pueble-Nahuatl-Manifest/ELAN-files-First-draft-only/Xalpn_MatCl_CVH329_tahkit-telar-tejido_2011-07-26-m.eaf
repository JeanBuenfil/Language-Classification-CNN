        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362" TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>wa:n kipahka ok neli n' ikpatsí:n.</ANNOTATION_VALUE>
