        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191" TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Entó:s ahsi e:yi, e:yi kowtsí:n ya.</ANNOTATION_VALUE>
