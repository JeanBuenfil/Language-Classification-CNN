        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>sepa n'chihchi:wa ihkó:n mopa:patatiw a, mopa:patatiw, mopa:patatiw para ne:,</ANNOTATION_VALUE>
