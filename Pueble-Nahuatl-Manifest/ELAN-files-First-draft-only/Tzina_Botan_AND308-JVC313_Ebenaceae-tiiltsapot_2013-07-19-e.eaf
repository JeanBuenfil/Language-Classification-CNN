        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408" TIME_SLOT_REF1="ts642" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>A:mo ke:mah ekintsi:n pos onkak ne:n pahti para nehjó:n sa:wat.</ANNOTATION_VALUE>
