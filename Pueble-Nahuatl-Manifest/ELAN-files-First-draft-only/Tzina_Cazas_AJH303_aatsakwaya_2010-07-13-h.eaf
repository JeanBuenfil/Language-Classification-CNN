        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>Semi kwaltsi:n se: kichkwa, seki we..., seki semi wehwe:i.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303" TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>Seki i:ihkwí:n se: kahsi, se: kitihtoka, se: kichkwa. Ke:mah.</ANNOTATION_VALUE>
