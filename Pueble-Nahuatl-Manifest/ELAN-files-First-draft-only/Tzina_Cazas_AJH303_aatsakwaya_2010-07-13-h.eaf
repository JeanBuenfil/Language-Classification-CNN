        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>A:kin *listo** kinkwi nohó:n tikihtowa xo:lo:tes *o** toni kiliah tokoxihmeh *o** kowa:michin wehwe:i,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
