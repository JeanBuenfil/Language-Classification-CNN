        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292" TIME_SLOT_REF1="ts558" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>A:mo, a:mo mikiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>Pos *ya, de ya**, name:chilwia, *este**, ki..., yehwa:n ki:sah pero ika ne: a:pahkamoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294" TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>Okseki. Tenex a:mo, a:mo kimachilia:yah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295" TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>No: moyo:niah pero *si..., como siempre vivos** yehwa:n moka:wtiki:sah *cuando** ne: mi:xte:kaya n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>A:mo, a:mo mikiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
