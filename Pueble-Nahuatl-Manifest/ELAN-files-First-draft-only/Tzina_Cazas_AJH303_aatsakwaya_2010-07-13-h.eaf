    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Amelia Domínguez Alcántara" TIER_ID="Amelia Domínguez Alcántara">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>A:man xte:chtapowi tikihtowa ke teh no: i:ksá: tikinonkwia xilimeh a:taw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>Neh niki..., neh nite:te:nkaki ke i:ksá: kihtowah kitsakwayah n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>¿Ke:ní:w kitsakwayah? ¿Toni kikwiah? ¿Ke:ní:w kichi:wayah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>Wa:n ox teh no: tiwelik yo:n kitsakwah n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>Wa:n ke:ní:w kichi:wayah ke:man ..., para kinki:tskia:yah xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Tikihtowa ne:n tekorra:l, ke n' a:ihtik, ¿Ka:n kisenkwi:ltia:yah pos, mahyá: ni:nipaka ihkó:n kisa:lowa:yah n' tet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Aha. ¿Wa:n nika:n ihti..., ihtiwahkaltik?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Ke:meskia o:me tepa:mit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Wa:n miak n' okwiltsitsi:n ne:n nankinki:xtia:yah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Entó:s e.... Ekintsi:n komohkó:n timo..., mah tikihto:ka:n tiowih t'tsakwatih n' a:t wa:n tikinte:mo:tih xilimeh ¿Timolwia tikinahsiskeh ok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Wa:n yo:n pahti, ne:n, kita..., *bueno** ne:n tenex nankikwiah, ¿kinsemiktia:ya oso kini:xtayowaltia:ya sah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>Teh timolwia ke yo:n tenex nakinte:milia:yah, a:mo kin..., yehwa kinsewehweloh timolia, yehwa ika a:mo semi onkakeh ok no:.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>Mm. *Este**, tikihtowa:ya ke ke:man komo nantapahwihkeh oso nankitsaktokeh n' a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>yowi se: siwa:t tein kokoxka:yetok oso ne: kipantamo:tiliah se: *peso** oso *o**, aha, se: tomi:n ne:n n' a:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>ma:ski mikkah ya n' xilimeh, i:x..., ¿sepa i:xpeta:nih oso ke:ní:w tikihtowa ke a:mo, ke no: kinwehwelowa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>Ma:ski 'tamo:tili:skeh tomi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>E..., teh ke ti..., tikini:xmati ne:n okwiltsitsí:n tein onkakeh ne:n a:ihtik,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>¿ka:nachi taman ok..., ne:n, onkakeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196" TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>¿Wa:n ke:ní:w se: kimpa..., se: ke:ní:w se: kimpahwia, se: kinin..., se: ka:te:ma tenex oso</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>se: kia:ma:nelowa wa:n ke:mah se: kipante:ka sah. Teh tikmattos ke:ní:w, ¡xite:chtapowi!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>¿Toni tikwia ke:man t'chihchiwa:ya ma:t..., ma:tat? ¿Ton ika t'chihchi:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Mm. Ye:wa tite:chilih ke onkak, *este**, ox kwi:kwiltikeh xilimeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259" TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts487">
                <ANNOTATION_VALUE>Okachi kwali teh 'te:chtapowi k..., *porque** neh a:mo nikini:xmati.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261" TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>'Te:chili:ka:n..., ke:niwkeh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Ke:ní:w mono:tsah, ne:n, yehwa yo:n okwilimeh *porque** neh nikinte:nkakia kihtowah seki onkak, *este**, kilwiah, *este**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264" TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>ox xo:lo..., a:mo n'mati, a:mo semi nikye:kmati. I:pah....{Probablemente debe ser simplemente "i:pa".} .... Aha, nochi yo:nkes onkayah wa:n ke ekintsi:n a:mo onkakeh ok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290" TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>A:, entó:..., entó:s ke:man nantapahwia:yah, *pescados**, ¿yehwa:n a:mo ki:sayah?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311" TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts602">
                <ANNOTATION_VALUE>Sepa yankwiká: 'te:chtapow`i moto:ka:y wa:n ka:ni tiwa:le:wa, ka:nachi xiwit tikpia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
