            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312" TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>Pos, pos neh noto:ka:y Andrés Martín Juárez ni..., ne: Xaltepec niwa:le:wa, ninemi a:xka:n de San Miguel Tzinacapan.</ANNOTATION_VALUE>
