        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts593">
                <ANNOTATION_VALUE>A:xka:n yo:n nochi, nochi poliwik a, ma:ski tak onkaskeh pero *gente** mowi a.</ANNOTATION_VALUE>
