        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417" TIME_SLOT_REF1="ts700" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>Teko:nkwa:ko wa:n yehwa ya ompa ne: Pa:wa:pan wa:n ne:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>ke:ní:w motano:tsa nejó:n..., Tsope:lika:t no: se: ko:nkwia n' a:tsí:n. Se: kima:ma ne:n tso:tsokol, pero semi se: nehmachya:ya ta: owihka:n wa:n</ANNOTATION_VALUE>
