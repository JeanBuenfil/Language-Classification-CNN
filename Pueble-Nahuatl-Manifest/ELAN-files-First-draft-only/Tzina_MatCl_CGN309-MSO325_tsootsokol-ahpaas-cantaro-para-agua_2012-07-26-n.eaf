        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444" TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>Se: moi:ka:nkepa wa:n se: kima:ma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446" TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Telwehwei:n katka wa:n tein se: kimachilia *que** se: kixi:ko:s para se: kima:ma:s,</ANNOTATION_VALUE>
