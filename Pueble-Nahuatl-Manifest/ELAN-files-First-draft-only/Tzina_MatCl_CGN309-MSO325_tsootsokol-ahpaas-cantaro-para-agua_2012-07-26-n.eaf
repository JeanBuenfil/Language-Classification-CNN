        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421" TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>Komo se: wetsik se: mopechti:ti se: itso:tsokol ompa tami a. Ompa tami a. Tapa:ni niman. Ka:n teh *kipasarowa** yo:n *plástico**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423" TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>Pero pos a:man a:mo no: tikma:mah ok, ta: de onkak kaltsi:ntan ya n' a:tsí:n.</ANNOTATION_VALUE>
