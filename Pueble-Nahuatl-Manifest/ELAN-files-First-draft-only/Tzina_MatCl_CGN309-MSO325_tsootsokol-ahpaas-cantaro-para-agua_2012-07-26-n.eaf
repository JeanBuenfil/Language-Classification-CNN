    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Celina González Nazario" TIER_ID="Celina González Nazario">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Pos ekintsi:n tikelna:mikitih de yo:n tso:tsokolmeh,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>ke:ní:w ne:n tikwiah n' achto *porque** a:man a:mo, a:mo kikwih ok akah semi *porque** nochi kalihtik a n' a:t tik..., t'tatekiwtiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>Ka:n akah ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>Pos se: a:takwia semi wa:n tik..., te:t...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>se: ta:tahtsi:n a:mo n'mati ox tiki:xmat wa:la:ya ne:n tso:tsokolnamakakeh, se: kitekowilia:ya yo:n tso:tsokolmeh *desde** tsikitsitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>iwki, iwki *hasta** wehwei, *hasta más** we:i tein ke:meh se: kixi:kowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Kiniwa:lkwia n' ta:tahtsi:n, *encargo**, ke..., *como que** se: kintekowilia:ya wa:n te:ka:wili:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>E:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Kkoh... A:mo, ta: wa:la:ya n' ta:tahtsi:n, neh ni:peta:n wa:la:ya, ke:meh i:n tapa:ni se: itso:tsokol pos sepa se: kitahtania mah te:wa:lkwili.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Kanah. Ne: kwesala:n. Pero...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>A:toto:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Ke:mah. I:pa onkak neli.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Pos ne: neh nejó:n para tikxapohwia:yah n' tso:tsokol achto, *aparte** se: kimanaya ika se: ko:ntsí:n tein a:mo se: kitatekiwtia *porque** pos xapoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Ke:mah, kimolo:n..., tikmolo:ntia:yah xapoh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>wa:n ke:mah se: kite:kilia:ya ne:n tso:tsokol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145" TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>wa:n se: kite:kilia iwki totoktik, se: kitse:tsetselowa para mah nochi kikwi xapoh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>Mah kikwi xapoh wa:n ke:mah nejó:n tepitsi:n se:wi a *pues** se: kite:ka tepitsi:n wa:n nochi kwaltsi:n se: kipaxakwalowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147" TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Wa:n ompa nejó:n yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148" TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>niman te:ilwia:yah, 'tikoketsa ne: tso:tsokol para a:mo a:chichi:na:s n' ika tia:takwis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149" TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Yo:n de tayowa ya tik..., tiktikoketsah yo:n tso:tsokol ika *mismo** sepa xapoha:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>tein tikwikeh t'xapohwihkeh n' ekinika,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151" TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>ika yo:n se: kitikoketsaya ompa ne: tekolah se: kita:lia,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>wa:n ompa molo:ntok yo:n xapoh, para mah takwa:waya ika kit yo:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Mah takwa:waya, mah a:mo a:chichi:na.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>kwaltsi:n ne: momoloka kwaltsi:n wa:n ke:mah nejó:n tane:si pos de se: me:wa ya, se: mo...,</ANNOTATION_VALUE>
