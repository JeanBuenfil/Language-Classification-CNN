        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429" TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>Ke:mah, ke:meh i:n se: ya:ya kowtah ye:kkwalka:n.</ANNOTATION_VALUE>
