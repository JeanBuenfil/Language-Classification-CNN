            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Ekintsi:n kihtowa kwaltias a kihtowa, ke:mah nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>tiki:..., kini..., pané: se:, se: mekapal, ke:meh ne: ke:man kkwiah ata mekapal nochi yo:n xo:no:t, ke:mah, no: nejó:n, no: kitekowa:ya ne: nejó:n no:ma:ntsi:n katka, yo:n neli kitekowa:ya ya, ata semi kinchihchi:waya yo:n ta:tahtsi:n, yo:n..., no: tiki:xmat ok, ne:n Pablo katka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>tein mikik a, yo:n Pablo Castillo kat... Ata, e..., telkwaltsitsi:n ata n' kinchi:waya mekapalmeh nikilia ye:ki:xpisi:ltik. Yehwa yo:ni ne:n kitahtania:ya ne: nejó:n no..., ne: note:iskaltihka:w, kitahtania:ya wa:n ke:mah ki..., kilia yo:n nejó:n yehwa ya ne: note:iskaltihka:tsi:n, a:man kilia xma:chihchi:wa ya kilia i:n para ika a:takwiti:w a kilia, neli kichihchi:waya ya wa:n ke:mah nejó:n tikwa:ytiah ya, yehwa ya yo:n *lazo** kita:liliah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>Ke:mah, nochi kwaltsi:n kihkitiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>Wa:n yehwa ya yo:n nejó:n ompa ne: tiahsih ne: ka:mpa n' a:tsí:n onkak pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>tikte:te:kiliah ata ne: ke:man nochi onkaya yo:n, yo:n tepos nikilia neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>Ajá, ke:mah, no:, no: tikwik ok. Pos neh yo:n no: nikwik ok, neli ta: monamakayah ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Ekintsi:n ka:n tein ok *porque** a:man nochi mop..., nochi, nochi mopatak n' a:man nikilia neh. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Ke:mah, a:man nochi: yehwa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>Ke:mah, se: kipaya:naya. A:mo, ta: neh n'mattok neli yehwa yo:n neli ika se: kite:te:kaya *porque** yo:n te:ilia:ya ne: note:iskaltihka:w,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>"¡'Wi:ka!", kichi:wtok, "Tikwiti a n' a:t para a:mo xma:aha:wi *porque** ta: mo yo:n nejó:n ye:kniman pala:ni:s n' ima:y *porque** tikma:aha:wi:ti, neli yehwa, neli n' ke:meh tikihtowa yo:n *bote** yehwa ika tikwiah ika tikte:te:kayah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>yo:n *esquinado** neli para a:mo mimilowi n' a:t. Wa:n neli pos yo:n no: tikwiti:w n' a:tsí:n nikilia neh komo *cuando** yo:n ta:a:wa:ki nikilia neh pos mah se: yowi ye:kkwalka:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts225">
                <ANNOTATION_VALUE>Ke:mah, kwalka:n, *siquiera** ne: ma:kwi:l *hora** nikilia neh oso chikwase:n *hora** kwalka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>kichi:wtok komohkó:n nejó:n nakkwiti:wih n' a:t xikwitih ya *porque** i:n nejó:n ne: nepantah tiahsitih kihtowa ka:n tei ok eski, *porque** ke:meh i:pa ompa sah tikwiah ne: nejó:n, ne: ka:mpa i:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>A:, pos ihwa:k *hasta** te:mimilowia ya nikilia ne:n a:me:yaltsí:n, ihwa:k ompa nikilia neh te:mimilowtok a nejó:n ihwa:k onkak miak a:t, *pero cuando** yo:n ta:a:wa:ki neli ye:kkwalka:n tehwa:n tiko:nkwiah wa:n neli pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>yehwa ya yo:n neli nikilia neh pos tikwi:kwitih, komo yo:n miakpa ya se: kkwi:kwito n' a:t, se: takepak sake:ra ka:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>ka:n nejó:n ma:kwi:l, ma:kwi:lpa se: kkwito pos nikilia neh yehwa yo:n tein... Ke:mah, ahsi a wa:n yehwa yo:n komo tein yehwa yo:n kichichi:na n' a:t n' yo:n tso:tsokol pos</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>Neli yektamia:..., tamia:chichi:na. Ke:mah, wa:n yehwa yo:n de se:, pos *tanto** se:, se: yo:wi a nikilia neh se: kkwiti n' a:t ompa ne: se:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226" TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>i:ksá: *cuando** yo:n se: mowita:tsowilia ata ihkwí:n, i:ksá: wa:lkwitatsaya:ni, ompa tapa:ni. Ke:mah, wa:n..., ke:mah wa:n pos ka:n teh se: kwa:lkwi ok a:t *porque** kihtowah *que**, iman te:ilia:yah, ¿toni *mitspasaroh**?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>Kilwi:skeh ta: nejó:n tak a:chichi:n i:n tso:tsokol pos ke:meh ihkó:n nimoma:maltia:ya nimowita:tsowilia:ya pos kwit..., kwitatsaya:n wa:n a:mo kwaltia ok, a:mo se: kwa:lkwi ok a:t. Ke:mah, *porque** pos ne:..., ke:mah, *de tanto**...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Ke:mah, a:chichi:na nikilia neh n' tso:tsokol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Pero neli nejó:n *cuando** yo:n se: kita neli a:chichi:na, pos yehwa yo:n neli ne:chilia:ya note:iskaltihka:w mah nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>mah tike..., mah t'tikoketsaka:n kihtowa ne:pa kihtowa, ekintsi:n tikochitih ya kihtowa nejó:n tekolah ya sah para a:mo po:kyowas, a:mo ti:lowas, xiktikoketsa kihtowa wa:n okyowa tiki:xti:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Neli iwki ne: tikchi:wayah, pero neli pos nejó:n kichichi:naya n' a:t. Wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Ke:mah, takwa:waya. Takwa:waya wa:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239" TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Wa:n nochi ata nikilia neh komo yo:n tikwitoh ya n' a:tsí:n wa:n ne: t'tsonkepah ya n' tein ka:mpa tiktsonkepah ya,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>yo:n se: ta:tai a se: k..., se: kie:kekowa:ya *que** ye:kxapohahwiya:k n' a:t. Ke:mah, *porque** nejó:n kihtowa ta: yo:n porin yankwik kihtowa *por eso** yo:n iwki kihtowa mochi:wa ne: nejó:n a:tsi:ni ahwiya:yak, i:ksá: *hasta** ne:chilia:ya seko xte:ka kihtowa *porque** yo:n nejó:n ika tikwito n' a:t kihtowa yankwik nejó:n a:mo..., ika ttapahpa:kaskeh wa:n tein titai:skeh ya kihtowa, nejó:n, ne:, se: ya ika tikwiti:w *porque** nejó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Ke:mah, te:nki:sak a kihtowa. Ke:mah, ke:meh ihwa:k nejó:n tia:takwiah pos nehwa wa:n ne: nokni:w se:, pos yeh kikwia se: tein i..., komo i:pa kipia pos yo:n yeh ka:n teh kipia ya ok. Ke:mah, kihtowa, teh yankwik kihtowa motso:tsokol..., ke:mah, nejó:n xte:ka seko kihtowa n' a:t,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>*Porque** yo:n kihtowa para ika ttapahpa:kaskeh, ika ttama:pa:kaskeh wa:n ne: n..., ne: oksé: mah kite:ka ne:pa ya para titai:skeh kihtowa *porque** xapoh..., xapohtsohya:k kihtowa n' a:t. Ke:mah, ta: neli iwki mochi:waya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247" TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>Ke:mah wa:n yehwa yo:n i:ksá: kihto:s, yo:n sepa ne:chilia, nejó:n nikowak kihtowa se: ahpa:s. Nikilia, ¿tikowak? Kihtowa, ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>Kihtowa, i:n kihtowa no: tikxapohwi:skeh. Nikilia no:, nikilia. Kihtowa, ke:mah, kihtowa. Pos yo:n nikilia, ka:n iwki se: kite:kili:s n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>Kanah, kihtowa, ta: nejó:n i:n kih... Ke:mah, no: a:chichi:nas kihtowa, i:n kihtowa nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252" TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Ne:, tikte:..., tikxapohwi:tih no: kihtowa wa:n no: tikwa:tsaskeh. Tak no: tiki:xmat ok n' teh yo:n ahpa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260" TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>Ke:mah,*porque** ke:meh, ke:meh se: kketsaya sokii:xko nikilia neh tsi:nalaktiaya no: *por eso** nejó:n se: kima:petskowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>Ke:mah, *porque** neli, yo:n nikilia neh *hasta** se: kixakwalowa:ya ika to:tomo:ch. Ke:mah, ika to:tomo:ch neli se: kixakwalowa wa:n ke:mah se: kite:kilia ya. Wa:n ox no:,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>ox no: iwki n' teh n' tiketsaya. Ka:mpa yo:n tiketsayah neh ne:chilia:ya ne: note:iskaltihka:w ka:mpa yo:n tiketsayah ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265" TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts343">
                <ANNOTATION_VALUE>mah se: kite:milia:ni yo:n, yo:n tenex, ata yo:n tein yo:n, tein yo:n se: kikwi a, yo:n tein,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267" TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>tein i:pa ika se: nexketska ya, yo:n, yo:n tein ki:sa ya, se: kipi:xowa ya, ompa t'te:te:milia:yah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>*porque** ke:meh ne: ke:man pos nochi iwki nikilia neh ta:li:xko ne: nejó:n tiketsayah ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271" TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>Ke:mah, ta: neli nejó:n kalakiah ata yo:n xoktsitsi:n, yo:n tsikitsitsi:n. Ke:mah, kikwiah komo a:mo tikte:milih yo:n tenex ento..., pos kikwih yo:n nejó:n xoktsitsi:n wa:n kihtowa i:n para a:mo kkwiskeh kihtowa yeh nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>mah t'te:mili:ka:n kihtowa wa:n *hasta** mochi:waya de tekochtsí:n ihkwi:ni ata ka:mpa se: kketsaya. Ke:mah, *porque**... Ke:mah, ompa nikilia neh tiketsayah yehwa yo:n kihtowa para a:mo nejó:n kikwis kihtowa ne: nejó:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>ne: xoktsi:n kihtowa, xik..., xikte:ma kihtowa i:n tenex, neli nikte:maya n' tenex wa:n neli pos yo:n neli no:, no: tik..., neli no: se: kwa:tsaya neli para se: kite:kilia:ya n' a:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>Wa:n neli onkayah ye:kwehwei:n *porque** nejó:n neh niki:xmat ok se:, se: ih..., mih ihkwi:ntsi:n wa:n ihkwí:n kwit..., kwitainachi katka,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>wa:n ite:noh mahyá: te:nko:kopitstik katka, te:chi:ilia:ya se: na:nahtsí:n katka, xa: no: tiki:xmat yo:n kiliah Kota:n Galindo katka ata.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>Yeh te:chilia:ya *que** nejó:n, *que** i:n kihtowa a:mo ahpa:s, ta: i:n kihtowa para yo:n kichi:wah kihtowa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281" TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>yo:n kiliah kihtowa a:xokoato:l. A:, ¿m' para yehwa? I:n, ke:mah, i:n para yehwa eskia kih... Ke:mah, kihtowa, i:n kihtowa para yehwa eskia. Nikilia, a: pos neli nikilia. Pero tehwa:n tikiliah nikilia ahpa:s. Pero i:n yehwa kihtowa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>A:, pos neli. Pos neh nikilia ka:n niki:xmati nikilia. Yehwa kihtowa. Ta: komo t'neki kihtowa nimitsne:xtili:ki:w ke:ní:w kihtowa n' tikchi:was. Nikilia, *bueno**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285" TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>Wa:n ka:n no: ke:man, ka:n ke:man nikchi:w *fuerza** nejó:n mah ne:chne:xtili:ki na:nahtsi:n, a:mo teh, a:mo no: teh nikilwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286" TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>Entó:s yo:n iwki nejó:n, iwki n' tika:wkeh ya yo:ni, nejó:n pe:wak tikte:kiliah a:t ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
