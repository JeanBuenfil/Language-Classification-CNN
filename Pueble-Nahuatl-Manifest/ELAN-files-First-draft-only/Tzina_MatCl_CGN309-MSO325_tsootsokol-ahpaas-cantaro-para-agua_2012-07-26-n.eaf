        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443" TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>yo:n nejó:n tein teleti:k, a:mo se: mowita:tsowilia:ya.</ANNOTATION_VALUE>
