        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431" TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>Kichi:wtok yo:n no:má:n, xkwi:kwiti a n' teh n' a:t wa:n neh nikta:li:ti a n' taxkal para tia:skeh n' kowtah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
