        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454" TIME_SLOT_REF1="ts787" TIME_SLOT_REF2="ts789">
                <ANNOTATION_VALUE>A:man a:mo, a:mo ki..., ka:n, *casi** ka:n ki:xmatih ok m' pi:pil.</ANNOTATION_VALUE>
