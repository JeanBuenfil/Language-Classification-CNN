        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415" TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>Onkas, pero...</ANNOTATION_VALUE>
