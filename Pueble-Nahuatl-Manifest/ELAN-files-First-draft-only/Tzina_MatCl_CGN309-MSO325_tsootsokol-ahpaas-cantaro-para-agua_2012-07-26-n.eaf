        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441" TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n ika se: a:takwi, komo se: kixi:kowa,</ANNOTATION_VALUE>
