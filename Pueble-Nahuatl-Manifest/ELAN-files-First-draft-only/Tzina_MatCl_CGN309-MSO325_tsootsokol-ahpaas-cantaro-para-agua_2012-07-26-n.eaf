                <ANNOTATION_VALUE>Ke:mah, 'saka ya n' a:t, kichi:wtok. Yehwa ok, yehwa n' taeka:ntok. A:mo weli. Ka:n se: kichi:wa ok. Ke:mah, n' ta:...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434" TIME_SLOT_REF1="ts738" TIME_SLOT_REF2="ts741">
                <ANNOTATION_VALUE>Ke:mah. Pos yo:n tso:tsokoltsitsí:n neli ti..., neli n' tikintapa:nkeh miakeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436" TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts746">
                <ANNOTATION_VALUE>[Ke:]mah iwki, ke:meh, ke:meh *desde** tsikitsi:n e:wa iwki wehwei *hasta** tein se: kitas, tein se: kixi:ko:ti:w</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
