        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425" TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>Nochi kalihtik a, ne: te:che:k..., te:che:ktatsiwka:chi:wakoh *porque** nochi kalihtik a. Ka:n teh se: kihyo:wia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
