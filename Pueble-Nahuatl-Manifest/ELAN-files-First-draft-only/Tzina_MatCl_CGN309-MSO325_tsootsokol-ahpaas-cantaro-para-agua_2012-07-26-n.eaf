            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>Wa:n yehwa yo:n nejó:n, ompa k..., ompa kitsonkepaya yo:n a:t,</ANNOTATION_VALUE>
