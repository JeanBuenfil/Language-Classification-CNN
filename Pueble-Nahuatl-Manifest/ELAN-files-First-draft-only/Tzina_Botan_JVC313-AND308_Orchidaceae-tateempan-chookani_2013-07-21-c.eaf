            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>kwali se: kia:ketsa, no: nikitak, neli nika:ketsak seki ke:mania:ntika, nikechpohpostek xo:chitsi:n wa:n nika:ketsak wa:n se: nikitak, se: taman poso:n, sepa se: moskaltih wa:n poso:nik no:, moto:tohtokah ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>Ke:mah, ka:n nikita ne: ... Pa..., pawesti ata, de ke kwetawi, pawesti a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Ke:mah, yehwa yo:n wa:n neli onkak eyi, niki:xmati e:yi taman ne:n i..., ne: xo:chitsi:n, seki, seki ista:k wa:n seki yehwa ne:n, yo:n achi *morado** wa:n ne:n kostik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>Ke:..., sayoh ke nika:kwi:n a:mo, a:mo, a:mo onkak, nika:kwi:n sah pos kowtah onkak soh se: taman sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Pero ke:meh i:n ke:masá: niki:sa, ne: ahkokopa niow, ninemiti, ke:man kohkoyo:ko</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>kip..., kipiah tein ne: tahta..., de tam..., de kostik wa:n ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110" TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>Yo:n ka:mpa kahkalte:noh kito:ktokeh, ne: ompa kipiah nikita ne:n ista:k pero nika:kwi:n tehwa:n a:mo tikitah i:pa se: *color** sah onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Nika:n se: *color** sah onkak wa:n ompa ne: onkak o:me taman, onkak *hasta** e:yi taman, onkak ne: yo:n nika:n tehwa:n onkak wa:n tein kostik wa:n ista:k, ke:mah, onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Ne: se: ... Eyi, e:yi taman, tein nika:n tehwa:n mochi:wa *mo..., morado, medio** chi:chi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>Wa:n yehwa sah wa:n ne: parahkokopa mochi:wa yehwa ne: kostik wa:n ista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
