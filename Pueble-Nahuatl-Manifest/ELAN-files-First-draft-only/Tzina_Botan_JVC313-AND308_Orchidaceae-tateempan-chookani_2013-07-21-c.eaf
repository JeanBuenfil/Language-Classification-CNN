                <ANNOTATION_VALUE>Nika:n parahkokopa, nika:n, *hasta** nika:n Cuesala:n kipiah kostik, nikitani no: neh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
