        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366" TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>Ke:mah, kachi chika:wak yo:n, yo:n telte:kwi kachi, telpitsotik.</ANNOTATION_VALUE>
