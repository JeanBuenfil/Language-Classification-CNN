        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>wa:n ke:masá: *conejo** no: se: kikwi:li:ti, yo:n no: k..., se: kite:milia n' iselo,</ANNOTATION_VALUE>
