        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Wa:n i..., iihtik, iihtik, iihtik, *telmorado** n' taihtik, pero taihtik ya, pero m' paniá:n nochi n' ima:te:mpan achi tepitsi:n sah *morado** ata.</ANNOTATION_VALUE>
