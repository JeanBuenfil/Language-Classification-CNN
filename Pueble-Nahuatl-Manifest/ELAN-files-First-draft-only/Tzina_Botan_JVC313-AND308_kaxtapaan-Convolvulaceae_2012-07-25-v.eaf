        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>kaxtapa:n ikwomekat yo:n ke:masá: tehko tech kahfe:n</ANNOTATION_VALUE>
