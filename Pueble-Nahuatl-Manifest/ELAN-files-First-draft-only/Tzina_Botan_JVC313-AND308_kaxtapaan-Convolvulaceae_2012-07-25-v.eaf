        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361" TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>Wa:n i:n seki no: ista:k n' icho:kilo pané: *leche, pero** i:n seki, ne: seki yo:n wehwei,</ANNOTATION_VALUE>
