        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>*Porque** wehka:w, semi *tipobres** ka[tka]tehwa:n a:mo, i:pa *tipobres porque** a:mo tikpiah para timokalcha:nti:skeh de kwahkwali koyo:meh tein ke:meh a:xka:n koyo:meh mocha:ntiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Tehwa:n i:pa timochihchi:wiliah pero tokaltsi:n pero de xiwkaltsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
