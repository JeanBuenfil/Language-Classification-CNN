                <ANNOTATION_VALUE>Ke:mah, ta: nika:n timoahsih iwa:n i:n toma:se:wakikni:wa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Para timotapowi:skeh ke:ní:w tehwa:n ne:ka tie:mpos ti..., ti..., ne:ka tonto:nal ke:ní:w timokalcha:ntia:yah, ke:ní:w tikchi:wayah no: se: tokali</ANNOTATION_VALUE>
