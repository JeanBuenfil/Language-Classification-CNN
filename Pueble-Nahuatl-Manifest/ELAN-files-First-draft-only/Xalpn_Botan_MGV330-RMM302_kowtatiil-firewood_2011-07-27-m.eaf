            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681" TIME_SLOT_REF1="ts1156" TIME_SLOT_REF2="ts1158">
                <ANNOTATION_VALUE>Onkak n' kowtahwa:xin tein kiliah wa:xin *cimarrón**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683" TIME_SLOT_REF1="ts1160" TIME_SLOT_REF2="ts1162">
                <ANNOTATION_VALUE>Wa:xin pero no: kimahse:wah, pero únicamente por** tsikitsitsi:n. Yo:n a:mo tato:kal mah tikihto:ka:n wa:n i:n seki tein 'tsilia tato:kal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
