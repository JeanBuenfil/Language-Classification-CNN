        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>*poco** se: kite:mpe:wa *porque** yo:n kikwih kalkowit.</ANNOTATION_VALUE>
