        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677" TIME_SLOT_REF1="ts1146" TIME_SLOT_REF2="ts1147">
                <ANNOTATION_VALUE>wa:n seki yo:n ta:ki achichii:ntsitsi:n, tein yo:n ta:ki mayo.</ANNOTATION_VALUE>
