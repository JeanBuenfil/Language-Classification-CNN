            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692" TIME_SLOT_REF1="ts1180" TIME_SLOT_REF2="ts1182">
                <ANNOTATION_VALUE>imets ne:n kalkone:t. Ke:mah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694" TIME_SLOT_REF1="ts1184" TIME_SLOT_REF2="ts1187">
                <ANNOTATION_VALUE>Ke..., ke:mah, nochi kwaltiya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696" TIME_SLOT_REF1="ts1191" TIME_SLOT_REF2="ts1193">
                <ANNOTATION_VALUE>¿I:n wa:xin? Yeh ata ihista:k.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698" TIME_SLOT_REF1="ts1195" TIME_SLOT_REF2="ts1198">
                <ANNOTATION_VALUE>Ihista:k n' ixo:chiotsi:n, *bohbolitas** mochi:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700" TIME_SLOT_REF1="ts1202" TIME_SLOT_REF2="ts1204">
                <ANNOTATION_VALUE>Yeh yo:n *bohbolitas**, n' ompa ke:mah ompa wi:tsa ya n' wa:..., wa:..., wa:xseltsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a703" TIME_SLOT_REF1="ts1210" TIME_SLOT_REF2="ts1212">
                <ANNOTATION_VALUE>¿I:n wa:xin?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a705" TIME_SLOT_REF1="ts1216" TIME_SLOT_REF2="ts1218">
