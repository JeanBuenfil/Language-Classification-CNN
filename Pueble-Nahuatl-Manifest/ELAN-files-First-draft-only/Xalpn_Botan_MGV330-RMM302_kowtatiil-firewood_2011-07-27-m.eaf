        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237" TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>de a:wa:kwowtsí:n, pos mah tikihto:ka:n, ke:mah, tikmattokeh ika yeha *más fuerte** n' kwowit neli,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238" TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>pero mah tikihto:ka:n semi tasohti *porque** nejó:n yo:n a:wa:kwowit a:mo semi *como quiera** onkak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240" TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>A:mo *como quiera** onkak, sano yo:n no: *como que** ka:mpa, ka:mpa kito:ktokeh pos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241" TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts116">
