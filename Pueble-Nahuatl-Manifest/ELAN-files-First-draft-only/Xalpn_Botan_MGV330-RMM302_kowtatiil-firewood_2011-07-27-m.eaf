        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626" TIME_SLOT_REF1="ts1021" TIME_SLOT_REF2="ts1024">
                <ANNOTATION_VALUE>A:, n' a:mo.</ANNOTATION_VALUE>
