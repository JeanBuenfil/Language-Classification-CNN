        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629" TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1032">
                <ANNOTATION_VALUE>A:, ka:mpa ihkak n' kwowtsí:n *de veras** kwaltsi:n ta:ki, mela:k kwaltsi:n ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630" TIME_SLOT_REF1="ts1033" TIME_SLOT_REF2="ts1034">
                <ANNOTATION_VALUE>wa:n nelika we:lik no: n' ita:kkayotsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631" TIME_SLOT_REF1="ts1035" TIME_SLOT_REF2="ts1036">
                <ANNOTATION_VALUE>Wa:n yo:n ikowyotsi:n i:pa sayoh para kowtati:l, *o** no: kwaltia para ki..., ki:xtsaya:nah ke:meh i:n para kalkowit *o para** wapaltsitsí:n?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a632" TIME_SLOT_REF1="ts1037" TIME_SLOT_REF2="ts1038">
                <ANNOTATION_VALUE>Tak no: kwaltia pero mohkó:n mah melatstik, mah kwaltsi:n ihka wa:n ta:ká:n ke:meh yo:n mo...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a633" TIME_SLOT_REF1="ts1039" TIME_SLOT_REF2="ts1040">
                <ANNOTATION_VALUE>motamimaxaltia n' kowtsí:n posa:mo no: kwaltia, sano</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634" TIME_SLOT_REF1="ts1041" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>*siquiera** yehwa n' ita:kkatsi:n *como que** ne:n ta:ki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a637" TIME_SLOT_REF1="ts1049" TIME_SLOT_REF2="ts1051">
                <ANNOTATION_VALUE>Ke:mah, nochi niki:..., ne:wí:n nochi onkak yeha yo:n kwowtsitsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a639" TIME_SLOT_REF1="ts1053" TIME_SLOT_REF2="ts1056">
                <ANNOTATION_VALUE>Yo:n no: kwaltia para, para wapaltsí:n, kiki:x..., no: ki..., wel ki:xtapa:nah mohkó:n tein</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a640" TIME_SLOT_REF1="ts1057" TIME_SLOT_REF2="ts1059">
                <ANNOTATION_VALUE>*como que** mah tikihto:ka:n toma:wak a.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a642" TIME_SLOT_REF1="ts1061" TIME_SLOT_REF2="ts1063">
                <ANNOTATION_VALUE>Ke:mah, para kwowtati:l *serbirowa**.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a644" TIME_SLOT_REF1="ts1065" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>A:, yo:n kinamakah, pero yo:n pati:yoh n' kinamakah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646" TIME_SLOT_REF1="ts1070" TIME_SLOT_REF2="ts1073">
                <ANNOTATION_VALUE>Yo:n ma:kwi:l *peso** se: tsapotsí:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a647" TIME_SLOT_REF1="ts1074" TIME_SLOT_REF2="ts1076">
                <ANNOTATION_VALUE>O:me ika *diez** kika:wah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a650" TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1084">
                <ANNOTATION_VALUE>Ne:n tein tikihtowa n..., ¿n' kwowtsapot?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a651" TIME_SLOT_REF1="ts1085" TIME_SLOT_REF2="ts1086">
                <ANNOTATION_VALUE>Pos a:mo x'mati, *porque** yeh yo:n ika e:wa tsikitsitsi:n, tsikitsitsi:n *hasta** iwki wehweia n' ita:kka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a652" TIME_SLOT_REF1="ts1087" TIME_SLOT_REF2="ts1088">
                <ANNOTATION_VALUE>mo..., mo..., mopehpechowa ata ihkwí:n ikehke:span ne:n *ivaritayo**,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653" TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1090">
                <ANNOTATION_VALUE>ompa, ompa tsohtsomoliwi, tsohtsomoliwi ke:meh eskia yo:n kahfe:nkone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a654" TIME_SLOT_REF1="ts1091" TIME_SLOT_REF2="ts1092">
                <ANNOTATION_VALUE>Wa:n ompa wehiya ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a655" TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1094">
                <ANNOTATION_VALUE>Neh wela:man, neh ihkak se: n' kalte:noh, wela:man teltsikitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656" TIME_SLOT_REF1="ts1095" TIME_SLOT_REF2="ts1097">
                <ANNOTATION_VALUE>Wa:n a:mo, a:mo teh nikita poso:ni, *únicamente** niman e:wa *como que** tsa:tsapokone:meh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658" TIME_SLOT_REF1="ts1099" TIME_SLOT_REF2="ts1102">
                <ANNOTATION_VALUE>Yo:n no: tamantik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660" TIME_SLOT_REF1="ts1106" TIME_SLOT_REF2="ts1107">
                <ANNOTATION_VALUE>*Hasta** a:mo nik..., nikta:lia *cuidado**, no: uwki sah weh n' e:wa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661" TIME_SLOT_REF1="ts1108" TIME_SLOT_REF2="ts1110">
                <ANNOTATION_VALUE>No: tsik..., no: tsikitsitsi:n mone:xtihtiw no: tsapotsitsi:n no: n' tsikilitsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663" TIME_SLOT_REF1="ts1112" TIME_SLOT_REF2="ts1115">
                <ANNOTATION_VALUE>Pané: a:mo poso:ni. A:mo x'mati. Nikelka:wtok. Nipanowa ne: *norancho**, wel yehwa yo:n a:mo n'piya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664" TIME_SLOT_REF1="ts1116" TIME_SLOT_REF2="ts1117">
                <ANNOTATION_VALUE>Nipanowa niow ne: *norancho**, ne: kwi:cha:te:noh wa:n nipanowa se:, se: no..., *nopariente** ita:lpan ihkó:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665" TIME_SLOT_REF1="ts1118" TIME_SLOT_REF2="ts1119">
                <ANNOTATION_VALUE>ihkak ohte:n o:me *mata**, nochipa ya nipanowa *cuando**</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666" TIME_SLOT_REF1="ts1120" TIME_SLOT_REF2="ts1121">
                <ANNOTATION_VALUE>tsikitsitsi:n, a:mo ke:man nikita ke:maniá:n xo:chit poso:ntok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667" TIME_SLOT_REF1="ts1122" TIME_SLOT_REF2="ts1124">
                <ANNOTATION_VALUE>Nikita *que** ta:ki a, ta:ki a n'*cuando** mopihpilowa tsikitsitsi:n *hasta** iwki wehweia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670" TIME_SLOT_REF1="ts1130" TIME_SLOT_REF2="ts1131">
