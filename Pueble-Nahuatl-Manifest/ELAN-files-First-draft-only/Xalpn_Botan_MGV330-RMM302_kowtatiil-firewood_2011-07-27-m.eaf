        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>Ke:mah wa:n yeha yo:n achi no: kwahnexyoh n' kwowtsí:n, pero para,</ANNOTATION_VALUE>
