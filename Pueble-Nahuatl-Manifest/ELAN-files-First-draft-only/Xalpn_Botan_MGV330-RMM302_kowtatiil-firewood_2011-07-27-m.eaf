            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671" TIME_SLOT_REF1="ts1132" TIME_SLOT_REF2="ts1133">
                <ANNOTATION_VALUE>komo tein yo:n ta:kik, tein kwali wa:xin mah tikihto:ka:n,</ANNOTATION_VALUE>
