        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a676" TIME_SLOT_REF1="ts1144" TIME_SLOT_REF2="ts1145">
                <ANNOTATION_VALUE>Seki yo:n *moradito** tein yo:n achichi i:n we:weyak wa:xin,</ANNOTATION_VALUE>
