        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>Seki mochi:wa no: ihkwi:kwí:n tohtomak, yeha yo:n nikihtowa kwali kwowit *porque**</ANNOTATION_VALUE>
