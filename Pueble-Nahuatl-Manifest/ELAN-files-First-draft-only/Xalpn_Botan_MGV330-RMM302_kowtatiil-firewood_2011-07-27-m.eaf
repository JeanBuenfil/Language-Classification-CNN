        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675" TIME_SLOT_REF1="ts1140" TIME_SLOT_REF2="ts1143">
                <ANNOTATION_VALUE>Ta: miak taman no: wa:xin ata. E:yi taman.</ANNOTATION_VALUE>
