        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Pos *este** no: *poco** onkak *porque** mah nikihto neh yo:n no:, no: kwali kwowit n' tikihto:skeh, pero</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
