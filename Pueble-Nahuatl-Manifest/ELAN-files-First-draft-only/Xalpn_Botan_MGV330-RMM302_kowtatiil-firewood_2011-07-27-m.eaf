        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678" TIME_SLOT_REF1="ts1148" TIME_SLOT_REF2="ts1149">
                <ANNOTATION_VALUE>Wa:n tein ta:ki *de todos santos** yeh we:weyak, achichi i:n, ata *mohmorado** wa:xtsitsí:n,</ANNOTATION_VALUE>
