    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="Anastacio Nicolás Damián " TIER_ID="Anastacio Nicolás Damián ">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>Pos neh no: nik..., ya:ken nika:n tine:chtahtania, timona:mikih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>wa:n timotahtaniah pos kwaltsi:n no:. Neh niki:xmattok soh de e:yi taman, ochpa:wa:s, i:n xo:no:ochpa:wa:s wa:n oksé: ochpa:wa:s wa:n yo:n ochpa:was mota:lia de ixta:wat, ika tachpa:nah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>entó:s de yo:n xo:no:ochpa:wa:s no: wehkapantia ihkó:n wa:n pané: xo:no:t se: kiposteki, no: tohtoma:waya ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>Se: kipisteki wa:n se: ki:xtia pané: xo:no:t.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>*Por eso** kiliah xo:no:ochpa:wa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Wa:n oksé: no:, no: ochpa:wa:s, no: kiliah ochpa:wa:s pero a:mo wel ika tachpa:nah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Yo:n kwaltsi:n mosa:sa:lowa xo:chit kostik, kostik ixo:chio no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>wa:n yo:n kihtowah de nepantah ne: xo:chiowa, moma:tahtapowa nehjó:n xo:chit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>Pero a:mo se: kimati wa:n oksé: pos ika no:, ke:meh *antes** ne:n ihkó:n tikpiah ne:n, ihkó:n ne: tikchi:wayah tokaltsi:n wa:n ika te:chtachpa:nia:yah ika yo:n konkwiah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>kilpia:yah ika se: *hilo**, se: kwomekat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>kolo:chilpia:yah *o** ika to:tomo:ch ihkó:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>Wa:n ika, ika tachpa:nayah i:n tokalihtik, *porque** ihwa:k ne:n ta:ltsi:n ne:n katka ne:n tota..., tokalihtik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>Ke:mah, a:mo ... Ta..., tatekochya:n katka, ihkó:n tai:xmela:wya:n pero katka ta:ltsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61" TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>entó:s ika tachpa:nayah nehjó:n kichi:wayah yo:n ochpa:wa:s, yo:n ma:pisi:ltik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62" TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>Onkak seki ne: ixta:wat wa:n ke:meh ekintsi:n pos ika, ika tachipa:wah ihkó:n ka:mpa kaltsi:n yetok, ihkó:n de n' teisá: ika ki:xchipa:wah no: ika tepitsi:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>kita:liah se: kowit wa:n ika ki:xkepah komo wehkapan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>wa:n yo:n ne:n pos yo:n a:mo wehkapantia, semi tsikitsi:n ne:n, a:mo wehkapantia nehjó:n ochpa:wa:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>pos neh niki:xmattok soh de eyi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67" TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>A:mo niki:xmati ne:n *más porque** yehwa sah yo:n xo:no:ochpa:wa:s wa:n oksé: ochpa:wa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69" TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Pero yo:n nochi ne:n kostik n' i..., ixo:chio, yo:n, yo:n a:mo, a:mo nikihto:s ne:n no: wehkapantia, ihkó:n mochi:wa,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70" TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>pos oksé: semi wehkapantia ne: xo:no:ochpa:wa:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71" TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>wa:n okseki a:mo semi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>A:mo semi wa:n yo:n no: kihtowah no: kwali para ne:n toremedioh ke:meh i:n ki..., kimanah no:, kiki:xtiliah nalwatsi:n wa:n no: kise:ma:ma:nelowah wa:n okseki pahti kise:..., no: kikwih.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75" TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Pero ne: komo kima:xakwalowah ihkó:n, no:, no:, no: kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>Entó:s yehwa yo:n ne: ekintsi:n no: nimits[tahta]ni:ti ox xa:, xa: kachi tikmati teh, ika i:n ton..., para toni se: kikwi nehjí:n ochpa:wa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Ma:mohmoloxtik pero ... Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86" TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Yeh ista:k ixo:chio wa:n ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Pos nika:n a:mo kachi se: ...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>Ompaka tak onkas ne:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Nika:n a:mo kachi se: kita pos yehwa yeh no: nikita ne:n se: de e:yi taman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98" TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Ma:wihwitsioh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100" TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>Pos yehwa yo:n nochi a:mo se: ki..., ki:xmati pero ekintsi:n neh niki:xmatok yehwa sah de n' e:yi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>Wa:n pos seki alak..., xo:no:ochpa:wa:s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Wa:n yo:n a:mo, a:mo semi, a:mo se: kimati ox no: kikwah iteyo ne:n chiktehmeh, yo:n pané: wihwitsioh *porque** a:mo kikwah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Wa:n nehjó:n pos kihtowah ke no: kwali para pahti ne:n i..., ixiwyo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109" TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>Pos no: de miak taman ne:n xiwitsitsi:n ne:n ki..., ika kipahtiah, kima:nelowah yo:n kiliah netati:l.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Pero yo:n de miak xiwtsitsi:n ki...,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113" TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>Ke:mah, [no]chi, [no]chi tanechiko:l,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>yehwa yo:n nochi ne:n ika kikwih no: de nehjó:n yo:n pos a:mo, a:mo se: kimati ne:n okseki n' ixiwyo, katí:n *más** pahti kwali.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116" TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Pero pos yehwa i:n neh nikmattok yehwa i:n ochpa:wa:s pos no: kwaltia para ika se: tachpa:na pera a:mo ... Yo:n seki ne:n xo:no:ochpa:wa:s yo:n a:mo kwaltia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>Pos neh nimono:tsa Anastacio Nicolás Damián, niwa:le:w de ne: San Miguel Tzinacapan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>A:, we:noh, tasohka:matik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
