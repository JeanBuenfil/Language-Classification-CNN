    <TIER DEFAULT_LOCALE="us" LINGUISTIC_TYPE_REF="UtteranceType" PARTICIPANT="José Ernesto Vázquez Chanico" TIER_ID="José Ernesto Vázquez Chanico">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>A:, pos a:man ke sepa timona:mikih nika:n ne: n'neki nimitstahtani:s ox no: tiki:xmattok yo:n ochpa:wa:s, ka:nachi taman onkak</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>ne *porque** seki neli a:mo tiki:xmatih katí:n ochpa:wa:s, onkak miak taman ochpa:wa:s ki..., kihtowah wa:n n'neki nimitstahtani:s ox no: tiki:xmattok miak taman ochpa:wa:s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts18">
