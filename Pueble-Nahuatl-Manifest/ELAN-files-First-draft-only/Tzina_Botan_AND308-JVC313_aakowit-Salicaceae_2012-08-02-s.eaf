        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>Ika se: mopilohtiw, ika se: mopilohtiw se: panowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206" TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>Ke:mah ihkwi yo:n niki:xmattok yo:n a:kowit pero nejó:n kihtowah no: pahti nika:n tanikwa:kopa ne: onkak yo:n a:kowit no:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
