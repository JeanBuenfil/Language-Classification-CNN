        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150" TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>Ke:mah pos neh no: niki:xmati yo:n a:kowit mochi:wa semi onkak ne: ka:mpa Tu:zanko pano:lo:ya:n tani</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152" TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>nochi yehwa wa:n ahkokopa nochi yehwa n' onkaya ke:meh pata:wak n' a:t ompa katka</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153" TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>iwtok pata:wak n' ekintsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Pero nejó:n onkak ok we:wehka nikita, ke:masá: tipantachiah wa:n onkak ne:n, ka:mpa yo:n pano:lo:ya:n tani e..., tekopi:lte:noh kilwiah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155" TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>nochi onkak ompa ne:n a:kowit wa:n a:te:n onkak. Wa:n i:nika:n A:wa:tepe:k ka:pa yo:n,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>yo:n nepal kowit we:i tekopi:lte:noh no: tani de n' tekopi:l wa:n yo:n ahko de n' tekopi:l ka:mpa yo:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>tepe:tsi:ntan ya ka:mpa pawetstok n' a:tsi:n tekopi:l tanitsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>no: se: yowal n' ihkak nochi yehwa n' a:kowit a:texa:lah nochi yehwa n' a:kowit ata ye:kwehwei ompa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159" TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>Wa:n ompa ya A:wa:, A:wa:tepe:c ka:mpa ne, nepalkowit nochi yehwa n' a:kowit *hasta** ne: ka:pa tenextet yetok ka:mpa n' Arrietas inta:lpan nochi onkak yo:n a:kowit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>Nochi onkak yo:n nikita, nejó:n maski we:i n' a:t pero a:it ke:ní:w mopale:wia ka:,ka:n kwiwita</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>se: (ki)tas se: ihkatok sepa n kowit wa:n selia itsmoli:ni niman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Wa:n yo:n neli tehwa:n no: tia:yah ompa tia:tawnemia ne: A:wa:tepe:c</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>tiktekia n' iitsmol yo:n melaktsi:n wa:n 'chihkolowa:yah wa:n taliliah n' toma:taw.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>'Ta:lia n' ma:tat wa:n tik, ki... Wa:n 'tama:tawia:yah (...) ika yo:n kowit tikwi:pe:wayah n' tet wa:n tikitskiah ne:n ma:xakatsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>...) Tikiliah 'tapala:nkahwiah. Wa:n nejó:n telonkayah ok n' ihkwak n' tehwa:n nimoskaltih onkayah ma, ma:xakatsitsi:n sama:wehwei yo:n okwilimeh yo:n tein okichmeh ye:ki:nachichi ata yekwehwei:n yo:n ma:... Yek, ye:kwehwei:n katka yo:n ma:xakatsitsi:n wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168" TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Wa:n nejó:n sate:pan niah ompa ne: kowtah ninemito, ompa n'nemia ya wa:n timo... Ye:kchi:wkeh n' kakltsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>ke:meh i:n taa:we:iyaya neli niktekia yehwa yo:n... Nikte:mowaya n' kowit ne: ka:mpa ionkaya:n nikonkwia n' iitsmol tein melaktsin wa:n...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170" TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>Yo:n tein ata moskaltia wa:n itsmoli:ni mahyá: mi:xto:ka ne:n kowit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171" TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>nikechtekia n' ka:mpa ne: kechtantok n' itsmol</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172" TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>ke:mah nikchihkolowa:ya para mah kwaltsi:n moka:wa metseh ya ne:n ma:tat kwaltsi:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>wa:n nikilpia:ya noma:taw wa:n neli ne:, ke:man we:ia n' a:t de sokiowa nik... Niow n'tama:tawi:tia ne: a:te:n</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>nikitskia:ya yo:n tepe:michimeh tikiliah tehwa:n yo:n, yo:n itech a:pitsak ne:nemih ma:lotsitsi:n nankiliah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>Tehwa:n tiki:xmatih tepe:michimeh. Ke:mah wa:n no: ka:mpa yo:n a:te:n ka:mpa yo:n posok mote:ma *o** yatok mote:mati ompa se: k'kwahkalo:ti ompa moyah... Motah n' okwilimeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178" TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Wa:n yo:n petakmeh yo:n kwaxakachmeh onkak petakmeh ata wa:n onkak kwaxakachmeh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179" TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>Yo:n kwa:xakachmeh yehwa n chiko:me in ahtapal kipiah iahtapalwa:n de miak taman tapal kipia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180" TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>yo:n, yo:n kwa:xakachmeh wa:n petakmeh no: seki:n yehwa:n pehpetaktikeh *cuando** mi:i:xkepah ne:nemih kwaltsi:n kakawakah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181" TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>yo:n yo:n mochi:wah ki:sayah nikitskia tepitsi:n ka:mpa wehkatan a:t, ka:mpa tehtetsi:ntan ompa mo, ompa mote:mayah nochi yo:n okwilimeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182" TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>a:tatsi:ntan nentinemih *cuando** mopale:wisnekih</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183" TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>pero ompa se: kitskia ya, yetok sah n' ka:mpa se: kitskia ne: a:te:n ompa a:mo ki:sah yehwa:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184" TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>N'mattok nikitskia:ya miakeh yo:n okwilimeh. Neli nimo, nimokwilia:ya n' okwilimeh pero a..., tein a:na:l yetokeh pos a:mo wel panowa:yah (...) n' a:t tate:mowa:yah a:na:lpa sah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185" TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>Wa:n nika:mpa nehwa sah n'tate:mowa:ya nikampa de n' a:t. Nehwa sah nietoya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>Nehwa sah ni, nikinte:mowa:yah nochi n' okwilimeh. Nochi nine:nemia hasta ne: ka:mpa *remolino** tate:noh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>*hasta** nika:mpa tani yo:n *tela:jahi:xko** nochi ompa nita:te:mowa *hasta** ne: ka:mpa n' pano:lo:ya:n ompa nion, niontate:mowa:ya nochi miak okwilimeh nikwia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Wa:n ne: a:nal tokni:wa:n pos mo, ye:kmiakeh mopa:panowihtokeh a:mo miak kikwiah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Wa:n neh miak nikwia n' okwilimeh. Nose:lti nik... Nose:lti nixo:panowa:ya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192" TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Nik, nikinkwia n' okwilimeh miak. Yehwa nikwia 'tsilia ne:n tepe:michtsitsi:n wa:n nikwia yehwa yo:n pehpetakmeh wa:n yo:n kwa:xakachmeh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193" TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>ka:mpa wehkatan yehwa nikwahkalowa, tatsi:ntan yetokeh pero yo:n. Se: ta:taxi:wahwia ompa wi:tseh ya ne:n petakmeh ye:kkwa, kwaltsitsi:n okwiltsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194" TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>Wa:n no: tatsi:ntan yetokeh yehwa yo:n ma:xaxakatsitsi:n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Neh nikitskia:ya miak *siquiera** ka:n o:me *morral** nikitskia:ya ne:nn, ne:n okwiltsitsi:n cuando yo:n taa:we:iaya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197" TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>Ke:mah wa:n neh niki:xmattok yo:n a:kowit kiliah wa:n neli de ima:xiwyo pisi:ltik wa:n ikowyo xoxoktik.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>Xoxoktik n' ikowyo wa:n alaxtsi:n, wa:n ye:kma:pisi:ltik ma:pisi:ltik, ma:pisi:ltik semi n' xiwit wa:n nejó:n iteyo ne:si n' ixo:chio achi a:kostik wa:n iteyo no: pisi:ltik semi takia</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200" TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>wa:n tak pampi:xowi pos ma:toktia yo:n a:mo, a:mo moka:wa yo:n pos ke:meh a:ihtik</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>pampi:xowi nochipa, nochi, nochipaya n' a:ihtik yetok yo:n kowit yetok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>nochipa n' a:ihtik ma:ski, ma:ski nejó:n onkak a:t wehkapan yetok kowtsi:n monalwayo:tia tatampa wa:n yetok ma:ski a:ihtik n' kowtsi:n ata. Ompa i:n pano:lo:ya:n tipanowa:yah ma:ski we:i n' a:t</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>itech se: mopilohtiw *cuando** we:i n´a:t ata te:pale:wih yo:n a:kowit.</ANNOTATION_VALUE>
