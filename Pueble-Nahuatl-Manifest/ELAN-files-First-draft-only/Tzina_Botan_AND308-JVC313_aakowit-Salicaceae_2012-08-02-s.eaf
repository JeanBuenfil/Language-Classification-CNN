        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310" TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>Yehwa sah yo:n, yehwa sah nimitstahtania wa:n nehjó:n soh ne:chilwi moto:ka:i ke:ní:w wa:n ka:n tiwa:le:w.</ANNOTATION_VALUE>
