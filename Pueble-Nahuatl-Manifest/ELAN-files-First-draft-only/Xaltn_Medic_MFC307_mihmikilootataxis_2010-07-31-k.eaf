        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>We:[noh]tite:chilih ya toni ne:n komohkó:n se: pili ne: kikwi m..., pe:wa mihmiki, tite:chilih ya toni kipahti:s</ANNOTATION_VALUE>
