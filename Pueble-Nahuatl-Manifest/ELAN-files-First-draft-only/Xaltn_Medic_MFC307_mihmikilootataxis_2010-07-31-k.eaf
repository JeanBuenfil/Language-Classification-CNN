        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35" TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Pos nehjó:n kokolis *cuando** pe:wah kinkwi ne:n ma:ski se: wehwei a, koma:mo mitskwitok</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36" TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>pe:wa titatasis pero a:mo titatasis se:, tepitsi:n sah, titatasis *fuerte**</ANNOTATION_VALUE>
