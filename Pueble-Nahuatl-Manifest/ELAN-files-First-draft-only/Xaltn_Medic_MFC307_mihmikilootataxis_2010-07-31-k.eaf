                <ANNOTATION_VALUE>wa:n ke:ní:w se: kimachilia, ka:nikahkwí:n te:kokoh oso nochi ke:meh teh tiki:xmattos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>No: toni ika se: kipahtia komohkó:n te:kwi yehwa i:n kokolis,</ANNOTATION_VALUE>
