                <ANNOTATION_VALUE>A:xka:n tiknekiskiah xite:chtapowi i:n se: kokolis tein tikto:ka:itiah mihmikilo:tataxis,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
