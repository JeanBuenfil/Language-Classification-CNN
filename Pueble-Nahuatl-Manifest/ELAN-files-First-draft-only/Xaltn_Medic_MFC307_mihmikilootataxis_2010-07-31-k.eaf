        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>'te:chtapowi nochi ta:ká:n tiki:xmati xiwtsitsi:n nochi xite:chtapowi ke:ní:w se: kichi:wa,</ANNOTATION_VALUE>
