        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243" TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>Yo:n no: kipahtia mihmikilo:tataxis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Yo:n tein ekin tine:chilih no: kipahtia mihmikilo:tataxis.</ANNOTATION_VALUE>
